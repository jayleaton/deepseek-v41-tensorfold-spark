From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Tue, 3 Nov 2026 04:13:35 +0700
Subject: [PATCH 147/207] spawn test: a /proc stat that opens but fails to read
 (ESRCH) is a task already gone; re-polling could fail for the whole deadline

---
 zig/src/core/runner_frontend_spawn.zig | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/zig/src/core/runner_frontend_spawn.zig b/zig/src/core/runner_frontend_spawn.zig
index 21cb4878ef71217e92b24a358467cf17e75f0f21..ed4137ee4046d2856283ad58c7f47a0e38ae5f75 100644
--- a/zig/src/core/runner_frontend_spawn.zig
+++ b/zig/src/core/runner_frontend_spawn.zig
@@ -236,9 +236,12 @@ fn descendantsStop() !void {
         defer file.close(t.io);
         var buffer: [4096]u8 = undefined;
         var reader = file.readerStreaming(t.io, &buffer);
-        // the worker exiting between open and read fails the read (ESRCH): poll again, the open then finds it gone
+        // a stat that opens but fails to read (ESRCH) belongs to a task already gone; the open can keep succeeding
         const stat = reader.interface.allocRemaining(t.allocator, .limited(4096)) catch |err| switch (err) {
-            error.ReadFailed => if (now() < settled_by) continue else return err,
+            error.ReadFailed => {
+                alive = false;
+                break;
+            },
             else => return err,
         };
         defer t.allocator.free(stat);
