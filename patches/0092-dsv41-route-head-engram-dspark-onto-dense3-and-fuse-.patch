+test "r1 routes head and DSpark main_proj onto dense3 and fuses DSpark boundaries, q_rope, and bf16 exchanges" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var w = try widths(a);
+    try w.dense.put(a, "dspark.main_proj", 8);
+    const cfg: Config = .{};
+    const dec = try block.emit(a, &cfg, &w, .{ .r1 = true }, &.{0}, 5, 0, true);
+    for (dec) |c| try t.expect(!std.mem.eql(u8, c.name, "tensorfold_exl3_linear_v4.linear"));
+    const ds = @import("dspark_emit.zig");
+    const pass = try ds.emitPass(a, &cfg, &w, .{ .r1 = true, .rot_fold = 1 }, cfg.dspark_block);
+    var bf16_ex: usize = 0;
+    for (pass) |c| {
+        try t.expect(!std.mem.eql(u8, c.name, "tensorfold_exl3_linear_v4.linear"));
+        try t.expect(!std.mem.eql(u8, c.name, "_rope"));
+        try t.expect(!std.mem.eql(u8, c.name, "glue.exchange_f32"));
+        if (std.mem.eql(u8, c.name, "glue.exchange")) bf16_ex += 1;
+    }
+    try t.expectEqual(@as(usize, 2 * cfg.mtp_layers), bf16_ex);
+    const ing = try ds.emitIngest(a, &cfg, &w, .{ .r1 = true }, 128, 0);
+    for (ing) |c| try t.expect(!std.mem.eql(u8, c.name, "tensorfold_exl3_linear_v4.linear"));
+}
