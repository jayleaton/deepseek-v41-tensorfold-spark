@@ -0,0 +1,117 @@
+const std = @import("std");
+pub const Invalid = error{Unsupported};
+pub const Error = Invalid || std.mem.Allocator.Error;
+pub const Tag = enum {
+    integer,
+    boolean,
+    name,
+    string,
+    format,
+    list,
+    call,
+    index,
+    all_range,
+    sum_filtered,
+    add,
+    sub,
+    mul,
+    floor,
+    modulo,
+    neg,
+    logical_not,
+    eq,
+    ne,
+    lt,
+    le,
+    gt,
+    ge,
+    logical_and,
+    logical_or,
+};
+pub const Expr = struct {
+    tag: Tag,
+    value: i64 = 0,
+    text: []const u8 = "",
+    lhs: usize = 0,
+    rhs: usize = 0,
+    filter: ?usize = null,
+    args: []const usize = &.{},
+};
+pub const Kind = enum { unknown, scalar, list };
+pub const Symbol = struct { name: []const u8, kind: Kind = .unknown };
+pub const Scope = struct {
+    symbols: std.ArrayList(Symbol) = .empty,
+    pub fn find(s: *const Scope, name: []const u8) ?usize {
+        for (s.symbols.items, 0..) |sym, i| if (std.mem.eql(u8, sym.name, name)) return i;
+        return null;
+    }
+    pub fn bind(s: *Scope, a: std.mem.Allocator, name: []const u8) Error!usize {
+        if (!validName(name)) return error.Unsupported;
+        if (s.find(name)) |id| return id;
+        if (s.symbols.items.len >= 64) return error.Unsupported;
+        try s.symbols.append(a, .{ .name = name });
+        return s.symbols.items.len - 1;
+    }
+};
+pub const StmtTag = enum { assign, append, conditional, loop, each, function, ret, print, assertion, raise, math_import };
+pub const Stmt = struct {
+    tag: StmtTag,
+    name: []const u8 = "",
+    expr: usize = 0,
+    args: []const usize = &.{},
+    body: []Stmt = &.{},
+    otherwise: []Stmt = &.{},
+    function: usize = 0,
+};
+pub const Function = struct {
+    name: []const u8,
+    params: []const []const u8,
+    scope: Scope = .{},
+    body: []Stmt = &.{},
+};
+pub const Program = struct {
+    a: std.mem.Allocator,
+    nodes: std.ArrayList(Expr) = .empty,
+    functions: std.ArrayList(Function) = .empty,
+    globals: Scope = .{},
+    body: []Stmt = &.{},
+    gcd_imported: bool = false,
+    // Admission metadata never replaces source expressions or supplies emitted answers.
+    estimated_steps: usize = 0,
+    pub fn node(p: *Program, e: Expr) Error!usize {
+        if (p.nodes.items.len >= 2048) return error.Unsupported;
+        try p.nodes.append(p.a, e);
+        return p.nodes.items.len - 1;
+    }
+    pub fn functionId(p: *const Program, name: []const u8) ?usize {
+        for (p.functions.items, 0..) |f, i| if (std.mem.eql(u8, f.name, name)) return i;
+        return null;
+    }
+};
+pub fn validName(name: []const u8) bool {
+    if (name.len == 0 or !(std.ascii.isAlphabetic(name[0]) or name[0] == '_')) return false;
+    for (name) |c| if (!(std.ascii.isAlphanumeric(c) or c == '_')) return false;
+    const reserved = [_][]const u8{
+        "print",               "len",                "sum",                 "range",                     "gcd",                "all",                    "True",                   "False",                "None",             "ValueError",
+        "and",                 "or",                 "not",                 "for",                       "while",              "if",                     "else",                   "elif",                 "return",           "def",
+        "raise",               "class",              "global",              "nonlocal",                  "import",             "from",                   "in",                     "pass",                 "break",            "continue",
+        "lambda",              "yield",              "try",                 "except",                    "finally",            "with",                   "as",                     "assert",               "del",              "is",
+        "async",               "await",              "__debug__",           "__builtins__",              "__import__",         "abs",                    "any",                    "ascii",                "bin",              "bool",
+        "breakpoint",          "bytearray",          "bytes",               "callable",                  "chr",                "classmethod",            "compile",                "complex",              "delattr",          "dict",
+        "dir",                 "divmod",             "enumerate",           "eval",                      "exec",               "filter",                 "float",                  "format",               "frozenset",        "getattr",
+        "globals",             "hasattr",            "hash",                "help",                      "hex",                "id",                     "input",                  "int",                  "isinstance",       "issubclass",
+        "iter",                "list",               "locals",              "map",                       "max",                "memoryview",             "min",                    "next",                 "object",           "oct",
+        "open",                "ord",                "pow",                 "property",                  "repr",               "reversed",               "round",                  "set",                  "setattr",          "slice",
+        "sorted",              "staticmethod",       "str",                 "super",                     "tuple",              "type",                   "vars",                   "zip",                  "aiter",            "anext",
+        "BaseException",       "BaseExceptionGroup", "Exception",           "ExceptionGroup",            "ArithmeticError",    "AssertionError",         "AttributeError",         "BufferError",          "EOFError",         "ImportError",
+        "LookupError",         "MemoryError",        "NameError",           "OSError",                   "ReferenceError",     "RuntimeError",           "StopAsyncIteration",     "StopIteration",        "SyntaxError",      "SystemError",
+        "SystemExit",          "TypeError",          "Warning",             "ZeroDivisionError",         "OverflowError",      "IndexError",             "KeyError",               "UnboundLocalError",    "NotImplemented",   "Ellipsis",
+        "KeyboardInterrupt",   "GeneratorExit",      "NotImplementedError", "UnicodeError",              "UnicodeDecodeError", "UnicodeEncodeError",     "UnicodeTranslateError",  "RecursionError",       "IndentationError", "TabError",
+        "ModuleNotFoundError", "BlockingIOError",    "BrokenPipeError",     "ChildProcessError",         "ConnectionError",    "ConnectionAbortedError", "ConnectionRefusedError", "ConnectionResetError", "FileExistsError",  "FileNotFoundError",
+        "InterruptedError",    "IsADirectoryError",  "NotADirectoryError",  "PermissionError",           "ProcessLookupError", "TimeoutError",           "EnvironmentError",       "IOError",              "EncodingWarning",  "BytesWarning",
+        "DeprecationWarning",  "FutureWarning",      "ImportWarning",       "PendingDeprecationWarning", "ResourceWarning",    "RuntimeWarning",         "SyntaxWarning",          "UnicodeWarning",       "UserWarning",      "copyright",
+        "credits",             "exit",               "license",             "quit",
+    };
+    for (reserved) |r| if (std.mem.eql(u8, r, name)) return false;
+    return true;
+}
diff --git a/zig/src/core/runner_frontend_python_blocks.zig b/zig/src/core/runner_frontend_python_blocks.zig
new file mode 100644
index 0000000000000000000000000000000000000000..545f5545b6376c93dc056f3d96d8e8d0e459f3b1
--- /dev/null
+++ b/zig/src/core/runner_frontend_python_blocks.zig
@@ -0,0 +1,343 @@
+//! Structured Python admission and source lowering; the proof never supplies the emitted program's answers.
+const std = @import("std");
+const ast = @import("runner_frontend_python_ast.zig");
+const expr = @import("runner_frontend_python_expr.zig");
+const evaluator = @import("runner_frontend_python_eval.zig");
+const emitter = @import("runner_frontend_python_emit.zig");
+const Allocator = std.mem.Allocator;
+
+pub const Lowered = struct { source: []u8, estimated_steps: usize };
+
+pub fn lowerPython(a: Allocator, source: []const u8) Allocator.Error!?[]u8 {
+    const lowered = try lowerWithCost(a, source) orelse return null;
+    return lowered.source;
+}
+
+// Cost admission belongs to the caller; disabling its budget preserves semantic proof and source lowering.
+pub fn lowerWithCost(a: Allocator, source: []const u8) Allocator.Error!?Lowered {
+    if (source.len == 0 or source.len > 4096 or std.mem.indexOfScalar(u8, source, 0) != null) return null;
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    var program: ast.Program = .{ .a = arena.allocator() };
+    parse(&program, source) catch |err| switch (err) {
+        error.Unsupported => return null,
+        error.OutOfMemory => return error.OutOfMemory,
+    };
+    evaluator.prove(&program) catch |err| switch (err) {
+        error.Unsupported => return null,
+        error.OutOfMemory => return error.OutOfMemory,
+    };
+    return .{ .source = try emitter.emit(a, &program), .estimated_steps = program.estimated_steps };
+}
+
+const Line = struct { indent: usize, text: []const u8 };
+const Parser = struct {
+    p: *ast.Program,
+    lines: []const Line,
+    pos: usize = 0,
+    count: usize = 0,
+
+    fn block(s: *Parser, indent: usize, scope: *ast.Scope, in_function: bool, depth: usize) ast.Error![]ast.Stmt {
+        if (depth > 8) return error.Unsupported;
+        var out: std.ArrayList(ast.Stmt) = .empty;
+        while (s.pos < s.lines.len) {
+            const line = s.lines[s.pos];
+            if (line.indent < indent) break;
+            if (line.indent != indent) return error.Unsupported;
+            if (std.mem.eql(u8, line.text, "else:") or std.mem.startsWith(u8, line.text, "elif ")) break;
+            s.pos += 1;
+            try out.append(s.p.a, try s.statement(line.text, indent, scope, in_function, depth));
+        }
+        if (out.items.len == 0) return error.Unsupported;
+        return out.toOwnedSlice(s.p.a);
+    }
+
+    fn suite(s: *Parser, tail: []const u8, indent: usize, scope: *ast.Scope, in_function: bool, depth: usize) ast.Error![]ast.Stmt {
+        if (depth >= 8) return error.Unsupported;
+        if (trim(tail).len != 0) {
+            var out: std.ArrayList(ast.Stmt) = .empty;
+            var rest = trim(tail);
+            while (true) {
+                const sep = topChar(rest, ';') orelse rest.len;
+                const text = trim(rest[0..sep]);
+                if (text.len == 0 or topChar(text, ':') != null) return error.Unsupported;
+                try out.append(s.p.a, try s.statement(text, indent, scope, in_function, depth + 1));
+                if (sep == rest.len) break;
+                rest = trim(rest[sep + 1 ..]);
+                if (rest.len == 0) break;
+            }
+            return out.toOwnedSlice(s.p.a);
+        }
+        if (s.pos == s.lines.len or s.lines[s.pos].indent <= indent) return error.Unsupported;
+        return s.block(s.lines[s.pos].indent, scope, in_function, depth + 1);
+    }
+
+    fn conditional(s: *Parser, text: []const u8, indent: usize, scope: *ast.Scope, in_function: bool, depth: usize) ast.Error!ast.Stmt {
+        const colon = topChar(text, ':') orelse return error.Unsupported;
+        const condition = try expr.parse(s.p, trim(text[0..colon]));
+        const body = try s.suite(text[colon + 1 ..], indent, scope, in_function, depth);
+        var otherwise: []ast.Stmt = &.{};
+        if (s.pos < s.lines.len and s.lines[s.pos].indent == indent) {
+            const next = s.lines[s.pos].text;
+            if (std.mem.startsWith(u8, next, "else:")) {
+                s.pos += 1;
+                otherwise = try s.suite(next[5..], indent, scope, in_function, depth);
+            } else if (std.mem.startsWith(u8, next, "elif ")) {
+                s.pos += 1;
+                if (depth >= 8) return error.Unsupported;
+                otherwise = try s.p.a.alloc(ast.Stmt, 1);
+                otherwise[0] = try s.conditional(next[5..], indent, scope, in_function, depth + 1);
+            }
+        }
+        return .{ .tag = .conditional, .expr = condition, .body = body, .otherwise = otherwise };
+    }
+
+    fn statement(s: *Parser, text: []const u8, indent: usize, scope: *ast.Scope, in_function: bool, depth: usize) ast.Error!ast.Stmt {
+        if (s.count >= 256) return error.Unsupported;
+        s.count += 1;
+        if (std.mem.startsWith(u8, text, "if ")) return s.conditional(text[3..], indent, scope, in_function, depth);
+        if (std.mem.startsWith(u8, text, "while ")) {
+            const colon = topChar(text, ':') orelse return error.Unsupported;
+            return .{
+                .tag = .loop,
+                .expr = try expr.parse(s.p, trim(text[6..colon])),
+                .body = try s.suite(text[colon + 1 ..], indent, scope, in_function, depth),
+            };
+        }
+        if (std.mem.startsWith(u8, text, "for ")) {
+            const colon = topChar(text, ':') orelse return error.Unsupported;
+            const head = trim(text[4..colon]);
+            const sep = std.mem.indexOf(u8, head, " in ") orelse return error.Unsupported;
+            const name = trim(head[0..sep]);
+            _ = try scope.bind(s.p.a, name);
+            const iterable = try expr.parse(s.p, trim(head[sep + 4 ..]));
+            const value = s.p.nodes.items[iterable];
+            if (value.tag != .list and !(value.tag == .call and std.mem.eql(u8, value.text, "range")))
+                return error.Unsupported;
+            return .{
+                .tag = .each,
+                .name = name,
+                .expr = iterable,
+                .body = try s.suite(text[colon + 1 ..], indent, scope, in_function, depth),
+            };
+        }
+        if (std.mem.startsWith(u8, text, "def ")) {
+            if (in_function or indent != 0 or depth != 0) return error.Unsupported;
+            const colon = topChar(text, ':') orelse return error.Unsupported;
+            const head = trim(text[4..colon]);
+            const open = std.mem.indexOfScalar(u8, head, '(') orelse return error.Unsupported;
+            if (!std.mem.endsWith(u8, head, ")")) return error.Unsupported;
+            const name = trim(head[0..open]);
+            if (!ast.validName(name) or s.p.functionId(name) != null or scope.find(name) != null)
+                return error.Unsupported;
+            var params: std.ArrayList([]const u8) = .empty;
+            var locals: ast.Scope = .{};
+            const args_text = trim(head[open + 1 .. head.len - 1]);
+            if (args_text.len > 0) {
+                var args = std.mem.splitScalar(u8, args_text, ',');
+                while (args.next()) |raw| {
+                    const arg = trim(raw);
+                    if (params.items.len >= 8 or locals.find(arg) != null) return error.Unsupported;
+                    _ = try locals.bind(s.p.a, arg);
+                    try params.append(s.p.a, arg);
+                }
+            }
+            const id = s.p.functions.items.len;
+            if (id >= 32) return error.Unsupported;
+            try s.p.functions.append(s.p.a, .{ .name = name, .params = try params.toOwnedSlice(s.p.a) });
+            const body = try s.suite(text[colon + 1 ..], indent, &locals, true, depth);
+            s.p.functions.items[id].scope = locals;
+            s.p.functions.items[id].body = body;
+            return .{ .tag = .function, .function = id };
+        }
+        if (std.mem.startsWith(u8, text, "return ")) {
+            if (!in_function) return error.Unsupported;
+            return .{ .tag = .ret, .expr = try expr.parse(s.p, trim(text[7..])) };
+        }
+        if (std.mem.startsWith(u8, text, "assert ")) {
+            return .{ .tag = .assertion, .expr = try expr.parse(s.p, trim(text[7..])) };
+        }
+        if (std.mem.startsWith(u8, text, "raise ")) {
+            const id = try expr.parse(s.p, trim(text[6..]));
+            const call = s.p.nodes.items[id];
+            if (call.tag != .call or !std.mem.eql(u8, call.text, "ValueError") or call.args.len != 1 or
+                s.p.nodes.items[call.args[0]].tag != .string) return error.Unsupported;
+            return .{ .tag = .raise };
+        }
+        if (std.mem.eql(u8, text, "from math import gcd")) {
+            if (in_function or indent != 0 or s.p.gcd_imported or scope.find("gcd") != null)
+                return error.Unsupported;
+            s.p.gcd_imported = true;
+            return .{ .tag = .math_import };
+        }
+        const equal = assignment(text);
+        if (equal) |pos| {
+            var target = trim(text[0..pos]);
+            var op: ?ast.Tag = null;
+            if (target.len > 0) {
+                op = switch (target[target.len - 1]) {
+                    '+' => .add,
+                    '-' => .sub,
+                    '*' => .mul,
+                    '%' => .modulo,
+                    else => null,
+                };
+                if (op != null) target = trim(target[0 .. target.len - 1]);
+                if (std.mem.endsWith(u8, target, "//")) {
+                    op = .floor;
+                    target = trim(target[0 .. target.len - 2]);
+                }
+            }
+            if (op != null and (pos == 0 or text[pos - 1] == ' ')) return error.Unsupported;
+            _ = try scope.bind(s.p.a, target);
+            var id = try expr.parse(s.p, trim(text[pos + 1 ..]));
+            if (op) |tag| id = try s.p.node(.{
+                .tag = tag,
+                .lhs = try s.p.node(.{ .tag = .name, .text = target }),
+                .rhs = id,
+            });
+            try expr.boundedDepth(s.p, id, 0);
+            return .{ .tag = .assign, .name = target, .expr = id };
+        }
+        if (topChar(text, '.')) |dot| {
+            if (!std.mem.startsWith(u8, text[dot..], ".append")) return error.Unsupported;
+            const name = trim(text[0..dot]);
+            if (!ast.validName(name)) return error.Unsupported;
+            const tail = trim(text[dot + 7 ..]);
+            if (tail.len < 2 or tail[0] != '(' or tail[tail.len - 1] != ')') return error.Unsupported;
+            return .{ .tag = .append, .name = name, .expr = try expr.parse(s.p, tail[1 .. tail.len - 1]) };
+        }
+        const id = try expr.parse(s.p, text);
+        const call = s.p.nodes.items[id];
+        if (call.tag != .call or !std.mem.eql(u8, call.text, "print")) return error.Unsupported;
+        return .{ .tag = .print, .args = call.args };
+    }
+};
+
+fn parse(p: *ast.Program, source: []const u8) ast.Error!void {
+    var lines: std.ArrayList(Line) = .empty;
+    var input = std.mem.splitScalar(u8, source, '\n');
+    while (input.next()) |raw| {
+        const text = std.mem.trimEnd(u8, raw, "\r ");
+        if (std.mem.indexOfScalar(u8, text, '\t') != null) return error.Unsupported;
+        var indent: usize = 0;
+        while (indent < text.len and text[indent] == ' ') indent += 1;
+        const comment = commentAt(text[indent..]) orelse text.len - indent;
+        const content = trim(text[indent .. indent + comment]);
+        if (content.len == 0) continue;
+        if (topChar(content, ';') != null and topChar(content, ':') == null) return error.Unsupported;
+        try lines.append(p.a, .{ .indent = indent, .text = content });
+    }
+    if (lines.items.len == 0 or lines.items[0].indent != 0) return error.Unsupported;
+    var parser: Parser = .{ .p = p, .lines = lines.items };
+    p.body = try parser.block(0, &p.globals, false, 0);
+    if (parser.pos != lines.items.len) return error.Unsupported;
+    for (p.functions.items) |f| {
+        if (p.globals.find(f.name) != null) return error.Unsupported;
+        for (f.scope.symbols.items) |sym| if (p.functionId(sym.name) != null) return error.Unsupported;
+    }
+}
+
+fn trim(text: []const u8) []const u8 {
+    return std.mem.trim(u8, text, " ");
+}
+
+fn assignment(text: []const u8) ?usize {
+    var quote: u8 = 0;
+    var nesting: usize = 0;
+    var escaped = false;
+    for (text, 0..) |c, i| {
+        if (quote != 0) {
+            if (escaped) escaped = false else if (c == '\\') escaped = true else if (c == quote) quote = 0;
+            continue;
+        }
+        if (c == '\'' or c == '"') {
+            quote = c;
+            continue;
+        }
+        if (c == '(' or c == '[') {
+            nesting += 1;
+            continue;
+        }
+        if (c == ')' or c == ']') {
+            nesting -|= 1;
+            continue;
+        }
+        if (nesting == 0 and c == '=' and (i + 1 == text.len or text[i + 1] != '=') and
+            (i == 0 or std.mem.indexOfScalar(u8, "=!<>", text[i - 1]) == null)) return i;
+    }
+    return null;
+}
+
+fn topChar(text: []const u8, target: u8) ?usize {
+    var quote: u8 = 0;
+    var nesting: usize = 0;
+    var escaped = false;
+    for (text, 0..) |c, i| {
+        if (quote != 0) {
+            if (escaped) escaped = false else if (c == '\\') escaped = true else if (c == quote) quote = 0;
+            continue;
+        }
+        if (c == '\'' or c == '"') {
+            quote = c;
+            continue;
+        }
+        if (c == target and nesting == 0) return i;
+        if (c == '(' or c == '[') nesting += 1;
+        if (c == ')' or c == ']') nesting -|= 1;
+    }
+    return null;
+}
+
+fn commentAt(text: []const u8) ?usize {
+    var quote: u8 = 0;
+    var escaped = false;
+    for (text, 0..) |c, i| {
+        if (quote != 0) {
+            if (escaped) escaped = false else if (c == '\\') escaped = true else if (c == quote) quote = 0;
+        } else if (c == '\'' or c == '"') {
+            quote = c;
+        } else if (c == '#') return i;
+    }
+    return null;
+}
+
+test "cost metadata preserves source lowering and counts dynamic work beyond policy" {
+    const t = std.testing;
+    const code = "x = 0\nfor i in range(300):\n    x = x + 1\nprint(x)";
+    const result = (try lowerWithCost(t.allocator, code)) orelse return error.UnexpectedAbstention;
+    defer t.allocator.free(result.source);
+    try t.expect(result.estimated_steps > 10_522);
+    const legacy = (try lowerPython(t.allocator, code)) orelse return error.UnexpectedAbstention;
+    defer t.allocator.free(legacy);
+    try t.expectEqualStrings(legacy, result.source);
+    try t.expect(std.mem.indexOf(u8, result.source, "for(") != null);
+}
+
+test "cost metadata includes printing digits and reachable function calls" {
+    const t = std.testing;
+    const cases = [_][2][]const u8{
+        .{ "print(1)", "print(1234567890)" },
+        .{ "print(\"a\")", "print(\"a longer string\")" },
+        .{
+            "def f(x):\n    return x + 1\nprint(f(0))",
+            "def f(x):\n    return x + 1\nprint(f(f(f(0))))",
+        },
+        .{
+            "from math import gcd\nprint(gcd(8, 4))",
+            "from math import gcd\nprint(gcd(89, 55))",
+        },
+        .{
+            "values = [1,2,3]\nx = sum(values)\nprint(x)",
+            "values = [1,2,3]\nx = sum(values) + sum(values)\nprint(x)",
+        },
+    };
+    for (cases) |pair| {
+        const short = (try lowerWithCost(t.allocator, pair[0])) orelse return error.UnexpectedAbstention;
+        defer t.allocator.free(short.source);
+        const long = (try lowerWithCost(t.allocator, pair[1])) orelse return error.UnexpectedAbstention;
+        defer t.allocator.free(long.source);
+        try t.expect(short.estimated_steps >= 200);
+        try t.expect(long.estimated_steps > short.estimated_steps);
+    }
+}
diff --git a/zig/src/core/runner_frontend_python_emit.zig b/zig/src/core/runner_frontend_python_emit.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8012bb6775b49deebc5ee2feeb5dcb2881cd15de
--- /dev/null
+++ b/zig/src/core/runner_frontend_python_emit.zig
@@ -0,0 +1,489 @@
+const std = @import("std");
+const ast = @import("runner_frontend_python_ast.zig");
+const Allocator = std.mem.Allocator;
+
+const runtime =
+    \\typedef struct { int n; int b; } py_value;
+    \\typedef struct { py_value items[128]; volatile int len; } py_list;
+    \\__attribute__((always_inline)) static inline py_value py_hold(py_value v) { __asm__ volatile("" : "+r"(v.n)); return v; }
+    \\__attribute__((noreturn)) static void py_assert_fail(void) {
+    \\ register int a0 __asm__("a0")=1; register int a7 __asm__("a7")=93;
+    \\ __asm__ volatile("ecall" : "+r"(a0) : "r"(a7) : "memory"); for(;;) {}
+    \\}
+    \\static py_value py_int(int n) { py_value r = {n,0}; return r; }
+    \\static py_value py_bool(int n) { py_value r = {!!n,1}; return r; }
+    \\static py_value py_add(py_value a,py_value b) { return py_int(a.n+b.n); }
+    \\static py_value py_sub(py_value a,py_value b) { return py_int(a.n-b.n); }
+    \\static py_value py_mul(py_value a,py_value b) { return py_int(a.n*b.n); }
+    \\static py_value py_neg(py_value a) { return py_int(-a.n); }
+    \\static py_value py_floor(py_value a,py_value b) {
+    \\ int q=a.n/b.n,r=a.n%b.n; if(r && ((r<0)!=(b.n<0))) --q; return py_int(q);
+    \\}
+    \\static py_value py_modulo(py_value a,py_value b) {
+    \\ int r=a.n%b.n; if(r && ((r<0)!=(b.n<0))) r+=b.n; return py_int(r);
+    \\}
+    \\static py_value py_eq(py_value a,py_value b) { return py_bool(a.n==b.n); }
+    \\static py_value py_ne(py_value a,py_value b) { return py_bool(a.n!=b.n); }
+    \\static py_value py_lt(py_value a,py_value b) { return py_bool(a.n<b.n); }
+    \\static py_value py_le(py_value a,py_value b) { return py_bool(a.n<=b.n); }
+    \\static py_value py_gt(py_value a,py_value b) { return py_bool(a.n>b.n); }
+    \\static py_value py_ge(py_value a,py_value b) { return py_bool(a.n>=b.n); }
+    \\static py_value py_gcd(py_value a,py_value b) {
+    \\ unsigned int x=a.n<0?0u-(unsigned int)a.n:(unsigned int)a.n;
+    \\ unsigned int y=b.n<0?0u-(unsigned int)b.n:(unsigned int)b.n;
+    \\ while(y) { unsigned int r=x%y; x=y; y=r; } return py_int((int)x);
+    \\}
+    \\static py_value py_len(const py_list *a) { return py_int(a->len); }
+    \\static py_value py_sum(const py_list *a) {
+    \\ __asm__ volatile("" : : "r"(a) : "memory");
+    \\ int n=0; for(int i=0;i<a->len;++i) n+=a->items[i].n; return py_int(n);
+    \\}
+    \\static py_value py_get(const py_list *a,py_value i) {
+    \\ return a->items[i.n<0?a->len+i.n:i.n];
+    \\}
+    \\static void py_append(py_list *a,py_value v) { a->items[a->len++]=v; }
+    \\static void py_text(const volatile char *s,int n) { for(int i=0;i<n;++i) printf("%c",(unsigned char)s[i]); }
+    \\static void py_print(py_value a) {
+    \\ if(a.b) printf("%s",a.n?"True":"False"); else printf("%d",a.n);
+    \\}
+;
+
+pub fn emit(a: Allocator, p: *const ast.Program) Allocator.Error![]u8 {
+    var e: Emitter = .{ .a = a, .p = p };
+    errdefer e.out.deinit(a);
+    try e.put(runtime);
+    try e.put("\n");
+    try e.put("static volatile int py_inputs[]={");
+    var inputs: usize = 0;
+    for (p.nodes.items) |node| {
+        if (node.tag == .integer or node.tag == .boolean) {
+            try e.out.print(a, "{d},", .{node.value});
+            inputs += 1;
+        }
+    }
+    if (inputs == 0) try e.put("0");
+    try e.put("};\n");
+    for (p.nodes.items, 0..) |node, id| {
+        if (node.tag == .string) {
+            try e.out.print(a, "static volatile char py_text_input{d}[]=", .{id});
+            try e.quoted(node.text);
+            try e.put(";\n");
+        }
+    }
+    for (p.globals.symbols.items, 0..) |s, i| {
+        try e.out.print(a, "static {s} py_g{d};\n", .{ typeName(s.kind), i });
+    }
+    for (p.functions.items, 0..) |f, id| {
+        try e.signature(f, id, false);
+        try e.put(";\n");
+    }
+    for (p.functions.items, 0..) |f, id| {
+        e.scope = &p.functions.items[id].scope;
+        e.params = f.params;
+        try e.signature(f, id, true);
+        try e.put(" {\n");
+        for (f.scope.symbols.items, 0..) |s, i| {
+            try e.out.print(a, "{s} py_l{d};\n", .{ if (s.kind == .list and e.isParam(s.name)) "const py_list *" else typeName(s.kind), i });
+        }
+        for (f.params, 0..) |name, i| {
+            if (f.scope.symbols.items[f.scope.find(name).?].kind == .list) {
+                try e.out.print(a, "py_l{d}", .{f.scope.find(name).?});
+            } else try e.variable(name);
+            try e.out.print(a, "=py_p{d};\n", .{i});
+        }
+        try e.statements(f.body);
+        try e.put("return py_int(0);\n}\n");
+    }
+    e.scope = null;
+    e.params = &.{};
+    try e.put("int main(void) {\n");
+    try e.statements(p.body);
+    try e.put("return 0;\n}\n");
+    return e.out.toOwnedSlice(a);
+}
+
+fn typeName(kind: ast.Kind) []const u8 {
+    return if (kind == .list) "py_list" else "py_value";
+}
+
+const Generator = struct { name: []const u8, id: usize };
+const Emitter = struct {
+    a: Allocator,
+    p: *const ast.Program,
+    out: std.ArrayList(u8) = .empty,
+    scope: ?*const ast.Scope = null,
+    params: []const []const u8 = &.{},
+    next_id: usize = 0,
+    generators: [8]Generator = undefined,
+    generators_len: usize = 0,
+
+    fn isParam(e: *const Emitter, name: []const u8) bool {
+        for (e.params) |param| if (std.mem.eql(u8, param, name)) return true;
+        return false;
+    }
+
+    fn put(e: *Emitter, s: []const u8) Allocator.Error!void {
+        try e.out.appendSlice(e.a, s);
+    }
+
+    fn fresh(e: *Emitter) usize {
+        const id = e.next_id;
+        e.next_id += 1;
+        return id;
+    }
+
+    fn signature(e: *Emitter, f: ast.Function, id: usize, names: bool) Allocator.Error!void {
+        try e.out.print(e.a, "static py_value py_f{d}(", .{id});
+        if (f.params.len == 0) try e.put("void");
+        for (f.params, 0..) |param, i| {
+            if (i != 0) try e.put(",");
+            try e.put(if (f.scope.symbols.items[f.scope.find(param).?].kind == .list) "const py_list *" else "py_value");
+            if (names) try e.out.print(e.a, " py_p{d}", .{i});
+        }
+        try e.put(")");
+    }
+
+    fn variable(e: *Emitter, name: []const u8) Allocator.Error!void {
+        var i = e.generators_len;
+        while (i > 0) {
+            i -= 1;
+            if (std.mem.eql(u8, e.generators[i].name, name)) {
+                try e.out.print(e.a, "py_gen{d}", .{e.generators[i].id});
+                return;
+            }
+        }
+        if (e.scope) |scope| {
+            if (scope.find(name)) |id| {
+                if (scope.symbols.items[id].kind == .list and e.isParam(name))
+                    try e.out.print(e.a, "(*py_l{d})", .{id})
+                else
+                    try e.out.print(e.a, "py_l{d}", .{id});
+                return;
+            }
+        }
+        try e.out.print(e.a, "py_g{d}", .{e.p.globals.find(name).?});
+    }
+
+    fn kind(e: *const Emitter, id: usize) ast.Kind {
+        const n = e.p.nodes.items[id];
+        if (n.tag == .list) return .list;
+        if (n.tag != .name) return .scalar;
+        for (e.generators[0..e.generators_len]) |g| {
+            if (std.mem.eql(u8, g.name, n.text)) return .scalar;
+        }
+        if (e.scope) |scope| {
+            if (scope.find(n.text)) |sym| return scope.symbols.items[sym].kind;
+        }
+        return e.p.globals.symbols.items[e.p.globals.find(n.text).?].kind;
+    }
+
+    fn truth(e: *Emitter, id: usize) Allocator.Error!void {
+        if (e.kind(id) == .list) {
+            try e.put("(");
+            try e.listPointer(id);
+            try e.put(")->len");
+        } else {
+            try e.put("(");
+            try e.expr(id);
+            try e.put(").n");
+        }
+    }
+
+    fn listPointer(e: *Emitter, id: usize) Allocator.Error!void {
+        const n = e.p.nodes.items[id];
+        if (n.tag == .name) {
+            try e.put("&");
+            return e.variable(n.text);
+        }
+        std.debug.assert(n.tag == .list);
+        try e.put("&(py_list){");
+        if (n.args.len != 0) {
+            try e.put(".items={");
+            for (n.args, 0..) |arg, i| {
+                if (i != 0) try e.put(",");
+                try e.expr(arg);
+            }
+            try e.put("},");
+        }
+        try e.out.print(e.a, ".len={d}}}", .{n.args.len});
+    }
+
+    fn listCall(e: *Emitter, helper: []const u8, list: usize, index: ?usize) Allocator.Error!void {
+        const n = e.p.nodes.items[list];
+        const tmp = e.fresh();
+        if (n.tag == .list) {
+            try e.out.print(e.a, "({{py_list py_literal{d};py_literal{d}.len={d};", .{ tmp, tmp, n.args.len });
+            for (n.args, 0..) |item, i| {
+                try e.out.print(e.a, "py_literal{d}.items[{d}]=", .{ tmp, i });
+                try e.expr(item);
+                try e.put(";");
+            }
+        }
+        try e.out.print(e.a, "py_{s}(", .{helper});
+        if (n.tag == .list) try e.out.print(e.a, "&py_literal{d}", .{tmp}) else try e.listPointer(list);
+        if (index) |id| {
+            try e.put(",");
+            try e.expr(id);
+        }
+        try e.put(")");
+        if (n.tag == .list) try e.put(";})");
+    }
+
+    fn expr(e: *Emitter, id: usize) Allocator.Error!void {
+        try e.put("py_hold(");
+        try e.exprBody(id);
+        try e.put(")");
+    }
+
+    fn exprBody(e: *Emitter, id: usize) Allocator.Error!void {
+        const n = e.p.nodes.items[id];
+        switch (n.tag) {
+            .integer, .boolean => {
+                var slot: usize = 0;
+                for (e.p.nodes.items[0..id]) |prior| {
+                    if (prior.tag == .integer or prior.tag == .boolean) slot += 1;
+                }
+                try e.out.print(e.a, "py_{s}(py_inputs[{d}])", .{
+                    if (n.tag == .integer) @as([]const u8, "int") else "bool", slot,
+                });
+            },
+            .name => try e.variable(n.text),
+            .neg => {
+                try e.put("py_neg(");
+                try e.expr(n.lhs);
+                try e.put(")");
+            },
+            .logical_not => {
+                try e.put("py_bool(!(");
+                try e.truth(n.lhs);
+                try e.put("))");
+            },
+            .add, .sub, .mul, .floor, .modulo, .eq, .ne, .lt, .le, .gt, .ge => {
+                try e.out.print(e.a, "py_{s}(", .{@tagName(n.tag)});
+                try e.expr(n.lhs);
+                try e.put(",");
+                try e.expr(n.rhs);
+                try e.put(")");
+            },
+            .logical_and, .logical_or => {
+                const tmp = e.fresh();
+                try e.out.print(e.a, "({{py_value py_tmp{d}=", .{tmp});
+                try e.expr(n.lhs);
+                try e.out.print(e.a, ";py_tmp{d}.n?", .{tmp});
+                if (n.tag == .logical_and) try e.expr(n.rhs) else try e.out.print(e.a, "py_tmp{d}", .{tmp});
+                try e.put(":");
+                if (n.tag == .logical_or) try e.expr(n.rhs) else try e.out.print(e.a, "py_tmp{d}", .{tmp});
+                try e.put(";})");
+            },
+            .index => try e.listCall("get", n.lhs, n.rhs),
+            .call => {
+                if (std.mem.eql(u8, n.text, "len") or std.mem.eql(u8, n.text, "sum")) {
+                    try e.listCall(n.text, n.args[0], null);
+                    return;
+                } else {
+                    if (std.mem.eql(u8, n.text, "gcd")) try e.put("py_gcd(") else try e.out.print(e.a, "py_f{d}(", .{e.p.functionId(n.text).?});
+                    for (n.args, 0..) |arg, i| {
+                        if (i != 0) try e.put(",");
+                        if (e.kind(arg) == .list) try e.listPointer(arg) else try e.expr(arg);
+                    }
+                }
+                try e.put(")");
+            },
+            .sum_filtered => try e.sumFiltered(n),
+            .all_range => try e.allRange(n),
+            .string, .format, .list => unreachable,
+        }
+    }
+
+    fn sumFiltered(e: *Emitter, n: ast.Expr) Allocator.Error!void {
+        const id = e.fresh();
+        const seq = e.p.nodes.items[n.rhs];
+        const is_range = seq.tag == .call and std.mem.eql(u8, seq.text, "range");
+        try e.out.print(e.a, "({{py_value py_sum{d}=py_int(0);", .{id});
+        if (is_range) {
+            try e.rangeParts(seq, id);
+            try e.rangeHead(id);
+            try e.out.print(e.a, "py_value py_gen{d}=py_hold(py_int((int)py_i{d}));", .{ id, id });
+        } else {
+            try e.out.print(e.a, "const py_list *py_seq{d}=", .{id});
+            try e.listPointer(n.rhs);
+            try e.out.print(e.a, ";for(int py_i{d}=0;py_i{d}<py_seq{d}->len;++py_i{d}){{", .{ id, id, id, id });
+            try e.out.print(e.a, "py_value py_gen{d}=py_hold(py_seq{d}->items[py_i{d}]);", .{ id, id, id });
+        }
+        e.generators[e.generators_len] = .{ .name = n.text, .id = id };
+        e.generators_len += 1;
+        if (n.filter) |filter| {
+            try e.put("if(");
+            try e.truth(filter);
+            try e.put("){");
+        }
+        try e.out.print(e.a, "py_sum{d}=py_hold(py_add(py_sum{d},", .{ id, id });
+        try e.expr(n.lhs);
+        e.generators_len -= 1;
+        try e.put("));");
+        if (n.filter != null) try e.put("}");
+        try e.out.print(e.a, "}}py_sum{d};}})", .{id});
+    }
+
+    fn rangeParts(e: *Emitter, n: ast.Expr, id: usize) Allocator.Error!void {
+        try e.out.print(e.a, "long long py_start{d}=", .{id});
+        if (n.args.len > 1) {
+            try e.put("(");
+            try e.expr(n.args[0]);
+            try e.put(").n");
+        } else try e.put("0");
+        try e.out.print(e.a, ",py_stop{d}=(", .{id});
+        try e.expr(n.args[if (n.args.len > 1) 1 else 0]);
+        try e.out.print(e.a, ").n,py_step{d}=", .{id});
+        if (n.args.len == 3) {
+            try e.put("(");
+            try e.expr(n.args[2]);
+            try e.put(").n");
+        } else try e.put("1");
+        try e.put(";\n");
+    }
+
+    fn rangeHead(e: *Emitter, id: usize) Allocator.Error!void {
+        try e.out.print(e.a, "for(long long py_i{d}=py_start{d};", .{ id, id });
+        try e.out.print(e.a, "py_step{d}>0?py_i{d}<py_stop{d}:py_i{d}>py_stop{d};", .{ id, id, id, id, id });
+        try e.out.print(e.a, "py_i{d}+=py_step{d}){{\n", .{ id, id });
+    }
+
+    fn allRange(e: *Emitter, n: ast.Expr) Allocator.Error!void {
+        const id = e.fresh();
+        try e.out.print(e.a, "({{int py_all{d}=1;", .{id});
+        try e.rangeParts(e.p.nodes.items[n.rhs], id);
+        try e.rangeHead(id);
+        try e.out.print(e.a, "py_value py_gen{d}=py_int((int)py_i{d});\nif(!(", .{ id, id });
+        e.generators[e.generators_len] = .{ .name = n.text, .id = id };
+        e.generators_len += 1;
+        try e.truth(n.lhs);
+        e.generators_len -= 1;
+        try e.out.print(e.a, ")){{py_all{d}=0;break;}}\n}}py_bool(py_all{d});}})", .{ id, id });
+    }
+
+    fn quoted(e: *Emitter, s: []const u8) Allocator.Error!void {
+        try e.put("\"");
+        for (s) |c| {
+            try e.out.print(e.a, "\\{o:0>3}", .{c});
+        }
+        try e.put("\"");
+    }
+
+    fn printPart(e: *Emitter, id: usize) Allocator.Error!void {
+        const n = e.p.nodes.items[id];
+        if (n.tag == .string) {
+            try e.out.print(e.a, "py_text(py_text_input{d},{d});\n", .{ id, n.text.len });
+        } else if (n.tag == .format) {
+            for (n.args) |arg| try e.printPart(arg);
+        } else {
+            try e.put("py_print(");
+            try e.expr(id);
+            try e.put(");\n");
+        }
+    }
+
+    fn statements(e: *Emitter, body: []const ast.Stmt) Allocator.Error!void {
+        for (body) |s| switch (s.tag) {
+            .assign => {
+                const n = e.p.nodes.items[s.expr];
+                if (n.tag == .list) {
+                    const id = e.fresh();
+                    try e.put("{\n");
+                    if (n.args.len != 0) {
+                        try e.out.print(e.a, "py_value py_assign{d}[{d}];\n", .{ id, n.args.len });
+                    }
+                    for (n.args, 0..) |item, i| {
+                        try e.out.print(e.a, "py_assign{d}[{d}]=", .{ id, i });
+                        try e.expr(item);
+                        try e.put(";\n");
+                    }
+                    try e.variable(s.name);
+                    try e.put(".len=0;\n");
+                    for (n.args, 0..) |_, i| {
+                        try e.put("py_append(&");
+                        try e.variable(s.name);
+                        try e.out.print(e.a, ",py_assign{d}[{d}]);\n", .{ id, i });
+                    }
+                    try e.put("}\n");
+                } else {
+                    try e.variable(s.name);
+                    try e.put("=");
+                    try e.expr(s.expr);
+                    try e.put(";\n");
+                }
+            },
+            .append => {
+                try e.put("py_append(&");
+                try e.variable(s.name);
+                try e.put(",");
+                try e.expr(s.expr);
+                try e.put(");\n");
+            },
+            .conditional => {
+                try e.put("if(");
+                try e.truth(s.expr);
+                try e.put("){\n");
+                try e.statements(s.body);
+                if (s.otherwise.len != 0) {
+                    try e.put("}else{\n");
+                    try e.statements(s.otherwise);
+                }
+                try e.put("}\n");
+            },
+            .loop => {
+                try e.put("while(");
+                try e.truth(s.expr);
+                try e.put("){\n");
+                try e.statements(s.body);
+                try e.put("}\n");
+            },
+            .each => try e.each(s),
+            .ret => {
+                try e.put("return ");
+                try e.expr(s.expr);
+                try e.put(";\n");
+            },
+            .print => {
+                for (s.args, 0..) |arg, i| {
+                    if (i != 0) try e.put("printf(\"%s\",\" \");\n");
+                    try e.printPart(arg);
+                }
+                try e.put("printf(\"%s\",\"\\n\");\n");
+            },
+            .assertion => {
+                try e.put("if(!(");
+                try e.truth(s.expr);
+                try e.put("))py_assert_fail();\n");
+            },
+            .raise => try e.put(if (e.scope == null) "return 1;\n" else "return py_int(0);\n"),
+            .function, .math_import => {},
+        };
+    }
+
+    fn each(e: *Emitter, s: ast.Stmt) Allocator.Error!void {
+        const n = e.p.nodes.items[s.expr];
+        const id = e.fresh();
+        try e.put("{\n");
+        if (n.tag == .call) {
+            try e.rangeParts(n, id);
+            try e.rangeHead(id);
+            try e.variable(s.name);
+            try e.out.print(e.a, "=py_int((int)py_i{d});\n", .{id});
+        } else {
+            try e.out.print(e.a, "struct {{ py_value items[{d}]; int len; }} py_seq{d};\npy_seq{d}.len={d};\n", .{
+                @max(n.args.len, 1), id, id, n.args.len,
+            });
+            for (n.args, 0..) |item, i| {
+                try e.out.print(e.a, "py_seq{d}.items[{d}]=", .{ id, i });
+                try e.expr(item);
+                try e.put(";\n");
+            }
+            try e.out.print(e.a, "for(int py_i{d}=0;py_i{d}<py_seq{d}.len;++py_i{d}){{\n", .{ id, id, id, id });
+            try e.variable(s.name);
+            try e.out.print(e.a, "=py_seq{d}.items[py_i{d}];\n", .{ id, id });
+        }
+        try e.statements(s.body);
+        try e.put("}\n}\n");
+    }
+};
diff --git a/zig/src/core/runner_frontend_python_eval.zig b/zig/src/core/runner_frontend_python_eval.zig
new file mode 100644
index 0000000000000000000000000000000000000000..5319d5e6b04c33160f72804712c6d9f544cf1eb8
--- /dev/null
+++ b/zig/src/core/runner_frontend_python_eval.zig
@@ -0,0 +1,556 @@
+const std = @import("std");
+const ast = @import("runner_frontend_python_ast.zig");
+const Error = ast.Error;
+const Scalar = struct { n: i64 = 0, boolean: bool = false };
+const List = struct { items: [128]Scalar = undefined, len: usize = 0 };
+const Value = union(enum) { scalar: Scalar, list: *List };
+const Frame = struct {
+    scope: *ast.Scope,
+    function: ?usize = null,
+    values: [64]Value = undefined,
+    defined: [64]bool = @splat(false),
+};
+const Binding = struct { name: []const u8, value: Scalar = .{}, parent: ?*const Binding = null };
+const Range = struct { start: i64 = 0, stop: i64, step: i64 = 1 };
+
+pub fn prove(p: *ast.Program) Error!void {
+    p.estimated_steps = 0;
+    if (p.functions.items.len > 32) return error.Unsupported;
+    try infer(p, &p.globals, p.body);
+    for (p.functions.items) |*f| {
+        if (p.globals.find(f.name) != null) return error.Unsupported;
+        for (f.params) |name| {
+            const id = f.scope.find(name) orelse return error.Unsupported;
+            f.scope.symbols.items[id].kind = .scalar;
+        }
+        try inferGeneratorParams(p, f, f.body);
+        try infer(p, &f.scope, f.body);
+        for (f.scope.symbols.items) |s| if (p.functionId(s.name) != null) return error.Unsupported;
+    }
+    var v: Validator = .{ .p = p };
+    try v.block(&p.globals, null, p.body);
+    for (p.functions.items, 0..) |*f, id| try v.block(&f.scope, id, f.body);
+    for (p.functions.items, 0..) |_, id| try v.acyclic(id, 0);
+    var globals: Frame = .{ .scope = &p.globals };
+    var r: Runtime = .{ .p = p, .globals = &globals };
+    if (try r.block(&globals, p.body) != null) return error.Unsupported;
+    p.estimated_steps = r.estimated_steps;
+}
+
+fn inferGeneratorParams(p: *ast.Program, f: *ast.Function, body: []const ast.Stmt) Error!void {
+    for (body) |s| {
+        switch (s.tag) {
+            .assign, .ret, .assertion, .conditional, .loop, .each => try generatorParams(p, f, s.expr),
+            else => {},
+        }
+        try inferGeneratorParams(p, f, s.body);
+        try inferGeneratorParams(p, f, s.otherwise);
+    }
+}
+
+fn generatorParams(p: *ast.Program, f: *ast.Function, id: usize) Error!void {
+    const e = p.nodes.items[id];
+    if (e.tag == .sum_filtered and p.nodes.items[e.rhs].tag == .name) {
+        const name = p.nodes.items[e.rhs].text;
+        for (f.params) |param| if (std.mem.eql(u8, param, name)) {
+            f.scope.symbols.items[f.scope.find(param).?].kind = .list;
+        };
+    }
+    switch (e.tag) {
+        .integer, .boolean, .name, .string => {},
+        .format, .list, .call => for (e.args) |arg| try generatorParams(p, f, arg),
+        .neg, .logical_not => try generatorParams(p, f, e.lhs),
+        else => {
+            try generatorParams(p, f, e.lhs);
+            try generatorParams(p, f, e.rhs);
+            if (e.filter) |filter| try generatorParams(p, f, filter);
+        },
+    }
+}
+
+fn infer(p: *ast.Program, scope: *ast.Scope, body: []const ast.Stmt) Error!void {
+    for (body) |s| {
+        if (s.tag == .assign or s.tag == .each) {
+            const id = scope.find(s.name) orelse return error.Unsupported;
+            const kind: ast.Kind = if (s.tag == .assign and p.nodes.items[s.expr].tag == .list) .list else .scalar;
+            const previous = scope.symbols.items[id].kind;
+            if (previous != .unknown and previous != kind) return error.Unsupported;
+            scope.symbols.items[id].kind = kind;
+        }
+        if (s.tag != .function) {
+            try infer(p, scope, s.body);
+            try infer(p, scope, s.otherwise);
+        }
+    }
+}
+
+const Validator = struct {
+    p: *ast.Program,
+    edges: [32]u32 = @splat(0),
+    checked: u32 = 0,
+    depth: usize = 0,
+
+    fn symbol(v: *Validator, scope: *ast.Scope, name: []const u8, gen: ?*const Binding) Error!ast.Kind {
+        var binding = gen;
+        while (binding) |g| : (binding = g.parent) if (std.mem.eql(u8, g.name, name)) return .scalar;
+        if (scope.find(name)) |id| {
+            const kind = scope.symbols.items[id].kind;
+            if (kind == .unknown) return error.Unsupported;
+            return kind;
+        }
+        if (scope != &v.p.globals) if (v.p.globals.find(name)) |id| {
+            const kind = v.p.globals.symbols.items[id].kind;
+            if (kind != .scalar) return error.Unsupported;
+            return kind;
+        };
+        return error.Unsupported;
+    }
+
+    fn expr(v: *Validator, scope: *ast.Scope, fun: ?usize, id: usize, gen: ?*const Binding) Error!ast.Kind {
+        if (v.depth >= 64) return error.Unsupported;
+        v.depth += 1;
+        defer v.depth -= 1;
+        const e = v.p.nodes.items[id];
+        switch (e.tag) {
+            .integer, .boolean => return .scalar,
+            .name => return v.symbol(scope, e.text, gen),
+            .string, .format => return error.Unsupported,
+            .list => {
+                if (e.args.len > 128) return error.Unsupported;
+                for (e.args) |arg| try v.scalar(scope, fun, arg, gen);
+                return .list;
+            },
+            .index => {
+                if (try v.expr(scope, fun, e.lhs, gen) != .list) return error.Unsupported;
+                try v.scalar(scope, fun, e.rhs, gen);
+                return .scalar;
+            },
+            .neg, .logical_not => try v.scalar(scope, fun, e.lhs, gen),
+            .call => {
+                if (std.mem.eql(u8, e.text, "len") or std.mem.eql(u8, e.text, "sum")) {
+                    if (e.args.len != 1 or try v.expr(scope, fun, e.args[0], gen) != .list)
+                        return error.Unsupported;
+                } else if (std.mem.eql(u8, e.text, "gcd")) {
+                    if (!v.p.gcd_imported or e.args.len != 2) return error.Unsupported;
+                    for (e.args) |arg| try v.scalar(scope, fun, arg, gen);
+                } else {
+                    const callee = v.p.functionId(e.text) orelse return error.Unsupported;
+                    if (e.args.len != v.p.functions.items[callee].params.len) return error.Unsupported;
+                    if (fun) |caller| v.edges[caller] |= @as(u32, 1) << @intCast(callee);
+                    const f = &v.p.functions.items[callee];
+                    for (e.args, f.params) |arg, param| {
+                        if (try v.expr(scope, fun, arg, gen) != f.scope.symbols.items[f.scope.find(param).?].kind)
+                            return error.Unsupported;
+                    }
+                }
+            },
+            .sum_filtered => {
+                if (!ast.validName(e.text) or v.p.functionId(e.text) != null) return error.Unsupported;
+                const seq = v.p.nodes.items[e.rhs];
+                if (seq.tag == .call and std.mem.eql(u8, seq.text, "range")) {
+                    try v.range(scope, fun, e.rhs, gen);
+                } else if (try v.expr(scope, fun, e.rhs, gen) != .list) return error.Unsupported;
+                const local: Binding = .{ .name = e.text, .parent = gen };
+                if (e.filter) |filter| try v.scalar(scope, fun, filter, &local);
+                try v.scalar(scope, fun, e.lhs, &local);
+            },
+            .all_range => {
+                if (!ast.validName(e.text) or v.p.functionId(e.text) != null) return error.Unsupported;
+                try v.range(scope, fun, e.rhs, gen);
+                const local: Binding = .{ .name = e.text, .parent = gen };
+                try v.scalar(scope, fun, e.lhs, &local);
+            },
+            else => {
+                try v.scalar(scope, fun, e.lhs, gen);
+                try v.scalar(scope, fun, e.rhs, gen);
+            },
+        }
+        return .scalar;
+    }
+
+    fn scalar(v: *Validator, scope: *ast.Scope, fun: ?usize, id: usize, gen: ?*const Binding) Error!void {
+        if (try v.expr(scope, fun, id, gen) != .scalar) return error.Unsupported;
+    }
+
+    fn range(v: *Validator, scope: *ast.Scope, fun: ?usize, id: usize, gen: ?*const Binding) Error!void {
+        const e = v.p.nodes.items[id];
+        if (e.tag != .call or !std.mem.eql(u8, e.text, "range") or e.args.len < 1 or e.args.len > 3)
+            return error.Unsupported;
+        for (e.args) |arg| try v.scalar(scope, fun, arg, gen);
+    }
+
+    fn printed(v: *Validator, scope: *ast.Scope, fun: ?usize, id: usize) Error!void {
+        const e = v.p.nodes.items[id];
+        if (e.tag == .string) return;
+        if (e.tag == .format) {
+            for (e.args) |arg| {
+                if (v.p.nodes.items[arg].tag != .string) try v.scalar(scope, fun, arg, null);
+            }
+        } else try v.scalar(scope, fun, id, null);
+    }
+
+    fn block(v: *Validator, scope: *ast.Scope, fun: ?usize, body: []const ast.Stmt) Error!void {
+        for (body) |s| {
+            switch (s.tag) {
+                .assign => {
+                    const id = scope.find(s.name) orelse return error.Unsupported;
+                    if (try v.expr(scope, fun, s.expr, null) != scope.symbols.items[id].kind)
+                        return error.Unsupported;
+                    if (scope.symbols.items[id].kind == .list and v.p.nodes.items[s.expr].tag != .list)
+                        return error.Unsupported;
+                    if (fun) |function| {
+                        if (scope.symbols.items[id].kind == .list) {
+                            for (v.p.functions.items[function].params) |param|
+                                if (std.mem.eql(u8, param, s.name)) return error.Unsupported;
+                        }
+                    }
+                },
+                .append => {
+                    if (fun != null or try v.symbol(scope, s.name, null) != .list) return error.Unsupported;
+                    try v.scalar(scope, fun, s.expr, null);
+                },
+                .conditional, .loop, .assertion => try v.scalar(scope, fun, s.expr, null),
+                .each => {
+                    const e = v.p.nodes.items[s.expr];
+                    if (e.tag == .list) {
+                        _ = try v.expr(scope, fun, s.expr, null);
+                    } else try v.range(scope, fun, s.expr, null);
+                },
+                .ret => {
+                    if (fun == null) return error.Unsupported;
+                    try v.scalar(scope, fun, s.expr, null);
+                },
+                .print => {
+                    if (fun != null) return error.Unsupported;
+                    for (s.args) |arg| try v.printed(scope, fun, arg);
+                },
+                .function => {
+                    if (fun != null) return error.Unsupported;
+                },
+                .math_import => if (fun != null) return error.Unsupported,
+                .raise => {},
+            }
+            if (s.tag != .function) {
+                try v.block(scope, fun, s.body);
+                try v.block(scope, fun, s.otherwise);
+            }
+        }
+    }
+
+    fn acyclic(v: *Validator, id: usize, active: u32) Error!void {
+        const bit = @as(u32, 1) << @intCast(id);
+        if (active & bit != 0) return error.Unsupported;
+        if (v.checked & bit != 0) return;
+        for (v.p.functions.items, 0..) |_, next| {
+            if (v.edges[id] & (@as(u32, 1) << @intCast(next)) != 0) try v.acyclic(next, active | bit);
+        }
+        v.checked |= bit;
+    }
+};
+
+const Runtime = struct {
+    p: *ast.Program,
+    globals: *Frame,
+    fuel: usize = 2_000_000,
+    iterations: usize = 0,
+    depth: usize = 0,
+    active: u32 = 0,
+    declared: [32]bool = @splat(false),
+    gcd_imported: bool = false,
+    estimated_steps: usize = 200,
+
+    // The caller applies its policy limit; existing fuel and iteration bounds still contain the proof.
+    fn charge(r: *Runtime, steps: usize) void {
+        r.estimated_steps +|= steps;
+    }
+
+    fn output(r: *Runtime, bytes: usize) void {
+        r.charge(20 +| (bytes *| 10));
+    }
+
+    fn printedScalar(r: *Runtime, value: Scalar) void {
+        if (value.boolean) {
+            r.output(if (value.n == 0) 5 else 4);
+            return;
+        }
+        var magnitude = @abs(value.n);
+        var digits: usize = 1 + @as(usize, @intFromBool(value.n < 0));
+        while (magnitude >= 10) : (magnitude /= 10) digits += 1;
+        r.charge(20);
+        r.output(digits);
+    }
+
+    fn tick(r: *Runtime) Error!void {
+        if (r.iterations >= 10_000) return error.Unsupported;
+        r.iterations += 1;
+        r.charge(20);
+    }
+
+    fn get(r: *Runtime, frame: *Frame, name: []const u8, gen: ?*const Binding) Error!Value {
+        var binding = gen;
+        while (binding) |g| : (binding = g.parent) if (std.mem.eql(u8, g.name, name))
+            return .{ .scalar = g.value };
+        if (frame.scope.find(name)) |id| {
+            if (!frame.defined[id]) return error.Unsupported;
+            return frame.values[id];
+        }
+        if (frame != r.globals) return r.get(r.globals, name, null);
+        return error.Unsupported;
+    }
+
+    fn put(frame: *Frame, name: []const u8, value: Value) Error!void {
+        const id = frame.scope.find(name) orelse return error.Unsupported;
+        frame.values[id] = value;
+        frame.defined[id] = true;
+    }
+
+    fn scalar(r: *Runtime, frame: *Frame, id: usize, gen: ?*const Binding) Error!Scalar {
+        return switch (try r.expr(frame, id, gen)) {
+            .scalar => |s| s,
+            else => error.Unsupported,
+        };
+    }
+
+    fn list(r: *Runtime, frame: *Frame, id: usize, gen: ?*const Binding) Error!*List {
+        return switch (try r.expr(frame, id, gen)) {
+            .list => |l| l,
+            else => error.Unsupported,
+        };
+    }
+
+    fn expr(r: *Runtime, frame: *Frame, id: usize, gen: ?*const Binding) Error!Value {
+        if (r.fuel == 0) return error.Unsupported;
+        r.fuel -= 1;
+        r.charge(10);
+        const e = r.p.nodes.items[id];
+        switch (e.tag) {
+            .integer, .boolean => return .{ .scalar = try number(e.value, e.tag == .boolean) },
+            .name => return r.get(frame, e.text, gen),
+            .string, .format => return error.Unsupported,
+            .list => {
+                const l = try r.p.a.create(List);
+                l.* = .{};
+                r.charge(4 + e.args.len * 6);
+                for (e.args) |arg| {
+                    if (l.len >= 128) return error.Unsupported;
+                    l.items[l.len] = try r.scalar(frame, arg, gen);
+                    l.len += 1;
+                }
+                return .{ .list = l };
+            },
+            .index => {
+                const l = try r.list(frame, e.lhs, gen);
+                var i = (try r.scalar(frame, e.rhs, gen)).n;
+                if (i < 0) i += @intCast(l.len);
+                if (i < 0 or i >= @as(i64, @intCast(l.len))) return error.Unsupported;
+                r.charge(6);
+                return .{ .scalar = l.items[@intCast(i)] };
+            },
+            .call => return .{ .scalar = try r.call(frame, e, gen) },
+            .sum_filtered => return .{ .scalar = try r.sumFiltered(frame, e, gen) },
+            .all_range => {
+                const bounds = try r.range(frame, e.rhs, gen);
+                var i = bounds.start;
+                while (if (bounds.step > 0) i < bounds.stop else i > bounds.stop) : (i += bounds.step) {
+                    try r.tick();
+                    const local: Binding = .{ .name = e.text, .value = try number(i, false), .parent = gen };
+                    if ((try r.scalar(frame, e.lhs, &local)).n == 0)
+                        return .{ .scalar = try number(0, true) };
+                }
+                return .{ .scalar = try number(1, true) };
+            },
+            else => {},
+        }
+        const x = try r.scalar(frame, e.lhs, gen);
+        if (e.tag == .neg) return .{ .scalar = try number(-x.n, false) };
+        if (e.tag == .logical_not) return .{ .scalar = try number(@intFromBool(x.n == 0), true) };
+        if (e.tag == .logical_and and x.n == 0) return .{ .scalar = x };
+        if (e.tag == .logical_or and x.n != 0) return .{ .scalar = x };
+        const y = try r.scalar(frame, e.rhs, gen);
+        const result: Scalar = switch (e.tag) {
+            .add => try number(x.n + y.n, false),
+            .sub => try number(x.n - y.n, false),
+            .mul => try number(x.n * y.n, false),
+            .floor, .modulo => blk: {
+                r.charge(8);
+                if (y.n == 0 or (x.n == std.math.minInt(i32) and y.n == -1)) return error.Unsupported;
+                const quotient = @divFloor(x.n, y.n);
+                break :blk try number(if (e.tag == .floor) quotient else x.n - quotient * y.n, false);
+            },
+            .eq => try number(@intFromBool(x.n == y.n), true),
+            .ne => try number(@intFromBool(x.n != y.n), true),
+            .lt => try number(@intFromBool(x.n < y.n), true),
+            .le => try number(@intFromBool(x.n <= y.n), true),
+            .gt => try number(@intFromBool(x.n > y.n), true),
+            .ge => try number(@intFromBool(x.n >= y.n), true),
+            .logical_and, .logical_or => y,
+            else => return error.Unsupported,
+        };
+        return .{ .scalar = result };
+    }
+
+    fn sumFiltered(r: *Runtime, frame: *Frame, e: ast.Expr, gen: ?*const Binding) Error!Scalar {
+        r.charge(20);
+        const seq = r.p.nodes.items[e.rhs];
+        const is_range = seq.tag == .call and std.mem.eql(u8, seq.text, "range");
+        const l = if (is_range) null else try r.list(frame, e.rhs, gen);
+        if (seq.tag == .list) r.charge(128 * 6);
+        const bounds = if (is_range) try r.range(frame, e.rhs, gen) else Range{ .stop = @intCast(l.?.len) };
+        var sum: i64 = 0;
+        var i = bounds.start;
+        while (if (bounds.step > 0) i < bounds.stop else i > bounds.stop) : (i += bounds.step) {
+            try r.tick();
+            const value = if (l) |items| items.items[@intCast(i)] else try number(i, false);
+            const local: Binding = .{ .name = e.text, .value = value, .parent = gen };
+            if (e.filter) |filter| if ((try r.scalar(frame, filter, &local)).n == 0) continue;
+            r.charge(12);
+            sum = (try number(sum + (try r.scalar(frame, e.lhs, &local)).n, false)).n;
+        }
+        return number(sum, false);
+    }
+
+    fn range(r: *Runtime, frame: *Frame, id: usize, gen: ?*const Binding) Error!Range {
+        r.charge(20);
+        const e = r.p.nodes.items[id];
+        if (e.tag != .call or !std.mem.eql(u8, e.text, "range") or e.args.len < 1 or e.args.len > 3)
+            return error.Unsupported;
+        var args: [3]i64 = .{ 0, 0, 1 };
+        for (e.args, 0..) |arg, i| args[i] = (try r.scalar(frame, arg, gen)).n;
+        const result: Range = if (e.args.len == 1) .{ .stop = args[0] } else .{ .start = args[0], .stop = args[1], .step = if (e.args.len == 3) args[2] else 1 };
+        if (result.step == 0) return error.Unsupported;
+        return result;
+    }
+
+    fn call(r: *Runtime, frame: *Frame, e: ast.Expr, gen: ?*const Binding) Error!Scalar {
+        r.charge(20);
+        if (std.mem.eql(u8, e.text, "len")) return number(@intCast((try r.list(frame, e.args[0], gen)).len), false);
+        if (std.mem.eql(u8, e.text, "sum")) {
+            const l = try r.list(frame, e.args[0], gen);
+            var sum: i64 = 0;
+            for (l.items[0..l.len]) |item| {
+                r.charge(12);
+                sum = (try number(sum + item.n, false)).n;
+            }
+            return number(sum, false);
+        }
+        if (std.mem.eql(u8, e.text, "gcd")) {
+            if (!r.gcd_imported) return error.Unsupported;
+            const x = (try r.scalar(frame, e.args[0], gen)).n;
+            const y = (try r.scalar(frame, e.args[1], gen)).n;
+            if (x == std.math.minInt(i32) or y == std.math.minInt(i32)) return error.Unsupported;
+            var a = if (x < 0) -x else x;
+            var b = if (y < 0) -y else y;
+            while (b != 0) {
+                try r.tick();
+                r.charge(10);
+                const rem = @mod(a, b);
+                a = b;
+                b = rem;
+            }
+            return number(a, false);
+        }
+        const id = r.p.functionId(e.text) orelse return error.Unsupported;
+        const mask = @as(u32, 1) << @intCast(id);
+        if (!r.declared[id] or r.depth >= 8 or r.active & mask != 0) return error.Unsupported;
+        const f = &r.p.functions.items[id];
+        var local: Frame = .{ .scope = &f.scope, .function = id };
+        for (f.params, e.args) |param, arg| {
+            if (r.p.nodes.items[arg].tag == .list) r.charge(128 * 6);
+            try put(&local, param, try r.expr(frame, arg, gen));
+        }
+        r.depth += 1;
+        r.active |= mask;
+        defer {
+            r.depth -= 1;
+            r.active &= ~mask;
+        }
+        return try r.block(&local, f.body) orelse error.Unsupported;
+    }
+
+    fn printed(r: *Runtime, frame: *Frame, id: usize) Error!void {
+        const e = r.p.nodes.items[id];
+        if (e.tag == .string) {
+            r.charge(10);
+            r.output(e.text.len);
+            return;
+        }
+        if (e.tag == .format) {
+            r.charge(10);
+            for (e.args) |arg| try r.printed(frame, arg);
+        } else r.printedScalar(try r.scalar(frame, id, null));
+    }
+
+    fn block(r: *Runtime, frame: *Frame, body: []const ast.Stmt) Error!?Scalar {
+        for (body) |s| {
+            if (s.tag != .function and s.tag != .math_import) r.charge(4);
+            switch (s.tag) {
+                .assign => {
+                    const value = try r.expr(frame, s.expr, null);
+                    if (value == .list) r.charge(4 + value.list.len * 10);
+                    try put(frame, s.name, value);
+                },
+                .append => {
+                    const l = switch (try r.get(frame, s.name, null)) {
+                        .list => |l| l,
+                        else => return error.Unsupported,
+                    };
+                    const value = try r.scalar(frame, s.expr, null);
+                    if (l.len >= 128) return error.Unsupported;
+                    r.charge(12);
+                    l.items[l.len] = value;
+                    l.len += 1;
+                },
+                .conditional => {
+                    const branch = if ((try r.scalar(frame, s.expr, null)).n != 0) s.body else s.otherwise;
+                    if (try r.block(frame, branch)) |value| return value;
+                },
+                .loop => {
+                    while ((try r.scalar(frame, s.expr, null)).n != 0) {
+                        try r.tick();
+                        if (try r.block(frame, s.body)) |value| return value;
+                    }
+                },
+                .each => {
+                    const e = r.p.nodes.items[s.expr];
+                    if (e.tag == .list) {
+                        const l = try r.list(frame, s.expr, null);
+                        for (l.items[0..l.len]) |item| {
+                            try r.tick();
+                            try put(frame, s.name, .{ .scalar = item });
+                            if (try r.block(frame, s.body)) |value| return value;
+                        }
+                    } else {
+                        const bounds = try r.range(frame, s.expr, null);
+                        var i = bounds.start;
+                        while (if (bounds.step > 0) i < bounds.stop else i > bounds.stop) : (i += bounds.step) {
+                            try r.tick();
+                            try put(frame, s.name, .{ .scalar = try number(i, false) });
+                            if (try r.block(frame, s.body)) |value| return value;
+                        }
+                    }
+                },
+                .function => r.declared[s.function] = true,
+                .ret => return try r.scalar(frame, s.expr, null),
+                .print => {
+                    for (s.args, 0..) |arg, i| {
+                        if (i != 0) r.output(1);
+                        try r.printed(frame, arg);
+                    }
+                    r.output(1);
+                },
+                .assertion => {
+                    r.charge(4);
+                    if ((try r.scalar(frame, s.expr, null)).n == 0) return error.Unsupported;
+                },
+                .raise => return error.Unsupported,
+                .math_import => r.gcd_imported = true,
+            }
+        }
+        return null;
+    }
+};
+
+fn number(n: i64, boolean: bool) Error!Scalar {
+    if (n < std.math.minInt(i32) or n > std.math.maxInt(i32)) return error.Unsupported;
+    return .{ .n = n, .boolean = boolean };
+}
