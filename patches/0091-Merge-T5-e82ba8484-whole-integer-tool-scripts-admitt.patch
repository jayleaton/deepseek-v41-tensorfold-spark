+        if (modulus) |signed| {
+            if (signed < 0 and result != 0) {
+                try self.charge(220);
+                result -= m;
+            }
+        }
+        return result;
+    }
+
+    fn powerProduct(self: *Counter, a: i512, b: i512, modulus: i512) Refused!i512 {
+        if (modulus == 0) {
+            try self.charge(multiplyCost(a, b));
+            return product(a, b);
+        }
+        const wide = a * b;
+        try self.charge(productCost(a, b) + 120);
+        if (words(modulus) == 1) {
+            try self.charge(smallDivisionCost(@intCast(wide), 16, @intCast(modulus)));
+        } else {
+            try self.charge(160 + bits(wide) * 224);
+        }
+        return @mod(wide, modulus);
+    }
+};
+
+fn bounded(value: i512) Refused!void {
+    if (value <= -ast.limit or value >= ast.limit) return error.Refused;
+}
+
+fn product(a: i512, b: i512) Refused!i512 {
+    const value = a * b;
+    try bounded(value);
+    return value;
+}
+
+fn positive(value: i512) i512 {
+    return if (value < 0) -value else value;
+}
+
+fn bits(value: i512) usize {
+    const magnitude: u512 = @intCast(positive(value));
+    return @intCast(512 - @clz(magnitude));
+}
+
+fn words(value: i512) usize {
+    return (bits(value) + 31) / 32;
+}
+
+fn decimalDigits(value: i512) usize {
+    var magnitude = positive(value);
+    var count: usize = 1;
+    while (magnitude >= 10) : (magnitude = @divTrunc(magnitude, 10)) count += 1;
+    return count;
+}
+
+// Charge the supplied limb span; small divisors use two native halfword divisions per limb.
+fn smallDivisionCost(value: u512, limbs: usize, divisor: u32) usize {
+    if (divisor <= 65535) return 24 + limbs * 20;
+    var cost: usize = 24;
+    var remainder: u64 = 0;
+    var index = limbs;
+    while (index != 0) {
+        index -= 1;
+        const word: u32 = @truncate(value >> @intCast(index * 32));
+        cost += if (remainder == 0) @as(usize, 14) else 32 * 16 + 20;
+        remainder = ((remainder << 32) | word) % divisor;
+    }
+    return cost;
+}
+
+fn divisionCost(a: i512, b: i512) usize {
+    const numerator = positive(a);
+    const divisor = positive(b);
+    if (numerator < divisor) return 160;
+    if (divisor <= 65535) return 120 + smallDivisionCost(@intCast(numerator), words(a), @intCast(divisor));
+    return longDivisionCost(numerator, divisor);
+}
+
+// Replay only quotient estimation for cost admission; the emitter still retains all original arithmetic nodes.
+fn longDivisionCost(a: i512, b: i512) usize {
+    const na = (bits(a) + 15) / 16;
+    const nb = (bits(b) + 15) / 16;
+    const shift: u9 = @intCast(16 * nb - bits(b));
+    const divisor = b << shift;
+    var remaining = a << shift;
+    const top_shift: u9 = @intCast(16 * (nb - 1));
+    const second_shift: u9 = @intCast(16 * (nb - 2));
+    const top = divisor >> top_shift;
+    const second = (divisor >> second_shift) & 65535;
+    var total: usize = 240 + (na + nb) * 20;
+    var position = na - nb + 1;
+    while (position != 0) {
+        position -= 1;
+        const digit_shift: u9 = @intCast(16 * position);
+        const window = remaining >> digit_shift;
+        const prefix = window >> top_shift;
+        var digit = @min(@divTrunc(prefix, top), 65535);
+        var rem = prefix - digit * top;
+        total += 112 + nb * 20;
+        while (rem < 65536 and digit * second > rem * 65536 + ((window >> second_shift) & 65535)) {
+            digit -= 1;
+            rem += top;
+            total += 24;
+        }
+        const exact = @divTrunc(window, divisor);
+        if (digit > exact) total += 24 + nb * 16;
+        remaining -= (exact * divisor) << digit_shift;
+    }
+    return total;
+}
+
+fn productCost(a: i512, b: i512) usize {
+    return 200 + words(a) * words(b) * 24 + words(a) * 10;
+}
+
+fn multiplyCost(a: i512, b: i512) usize {
+    return productCost(a, b) + 140;
+}
+
+fn formatCost(value: i512, print: bool) usize {
+    const digits = decimalDigits(value);
+    const sign: usize = @intFromBool(value < 0);
+    var magnitude = positive(value);
+    var format: usize = 64 + digits * 12 + sign * 12;
+    while (true) {
+        format += smallDivisionCost(@intCast(magnitude), words(magnitude), 10000) + 24;
+        magnitude = @divTrunc(magnitude, 10000);
+        if (magnitude == 0) break;
+    }
+    return format + (if (print) 48 + (digits + sign) * 16 else @as(usize, 0));
+}
diff --git a/zig/src/core/runner_frontend_integer_cost_test.zig b/zig/src/core/runner_frontend_integer_cost_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9529ee01e63515a796f28f2880dee632ec5038ad
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer_cost_test.zig
@@ -0,0 +1,217 @@
+const std = @import("std");
+const ast = @import("runner_frontend_integer_ast.zig");
+const cost = @import("runner_frontend_integer_cost.zig");
+const t = std.testing;
+const cap: usize = 10_522;
+const unlimited = std.math.maxInt(usize);
+
+fn measured(code: []const u8, budget: usize) !?usize {
+    var parser = ast.Parser{ .source = code };
+    const root = try parser.parse();
+    return cost.estimate(&parser, root, budget);
+}
+
+test "integer cost exact model counters and inclusive budget boundary" {
+    const cases = [_][]const u8{
+        "1",            "-1",   "1+2",                  "2*3",           "gcd(54,24)", "gcd(0,0)", "isqrt(0)",
+        "factorial(0)", "0**0", "sum(map(int,str(0)))", "314159*271828",
+    };
+    for (cases) |code| {
+        const full = (try measured(code, unlimited)).?;
+        try t.expect(full > 0);
+        try t.expectEqual(@as(?usize, full), try measured(code, full));
+        try t.expectEqual(@as(?usize, null), try measured(code, full - 1));
+        try t.expectEqual(@as(?usize, null), try measured(code, 0));
+    }
+}
+
+test "integer cost admission is monotone in budget and does not mutate proof state" {
+    var parser = ast.Parser{ .source = "pow(-2,19,-97)+isqrt(144)" };
+    const root = try parser.parse();
+    const before = parser;
+    const full = cost.estimate(&parser, root, unlimited).?;
+    for ([_]usize{ 0, 200, full / 2, full - 1, full, full + 1, unlimited }) |budget| {
+        const result = cost.estimate(&parser, root, budget);
+        if (budget < full) try t.expect(result == null) else try t.expectEqual(@as(?usize, full), result);
+    }
+    try t.expectEqual(before.count, parser.count);
+    try t.expectEqualSlices(bool, &before.proved, &parser.proved);
+    try t.expectEqualSlices(u8, before.source, parser.source);
+    for (before.nodes[0..before.count], parser.nodes[0..parser.count]) |a, b| {
+        try t.expectEqual(a.op, b.op);
+        try t.expectEqual(a.l, b.l);
+        try t.expectEqual(a.r, b.r);
+        try t.expectEqual(a.k, b.k);
+        try t.expectEqual(a.value, b.value);
+        try t.expectEqualSlices(u8, a.text, b.text);
+    }
+}
+
+test "integer cost charges shared DAG nodes once and ignores unreachable nodes" {
+    var parser = ast.Parser{ .source = "7" };
+    try parser.bind("x", try parser.parse());
+    parser.source = "x+x";
+    parser.pos = 0;
+    const root = try parser.parse();
+    const shared = cost.estimate(&parser, root, unlimited).?;
+    const separate = (try measured("7+7", unlimited)).?;
+    try t.expect(shared < separate);
+    parser.nodes[parser.count] = .{ .op = .factorial, .value = 0 };
+    parser.count += 1;
+    try t.expectEqual(@as(?usize, shared), cost.estimate(&parser, root, unlimited));
+    try t.expect((try measured("2**1000%1000", unlimited)) != null);
+}
+
+test "integer cost covers radix widths output formatting and signed divmod" {
+    const decimal = (try measured("16", unlimited)).?;
+    const hex = (try measured("0x10", unlimited)).?;
+    try t.expect(hex > decimal);
+    try t.expect((try measured("0b10000", unlimited)).? > decimal);
+    try t.expect((try measured("1000000000", unlimited)).? > (try measured("1", unlimited)).?);
+    const scalar = (try measured("4294967296//4294967295", unlimited)).?;
+    const wide = (try measured("4294967296//4294967296", unlimited)).?;
+    try t.expect(wide > 0 and scalar > 0);
+    try t.expect((try measured("4294967296//4294967296", cap)) != null);
+    try t.expect((try measured("divmod(-7,3)", unlimited)).? > (try measured("-7//3", unlimited)).?);
+    try t.expect((try measured("len(str(-12345))", unlimited)) != null);
+    try t.expect((try measured("sum(int(d) for d in str(12345))", unlimited)) != null);
+}
+
+test "integer cost follows bounded algorithm paths and declines costly wide work" {
+    for ([_][]const u8{
+        "314159*271828",     "gcd(-54,24)",           "isqrt(144)",        "factorial(5)",
+        "prod(range(0,10))", "prod(range(0,-10,-1))", "prod(range(10,0))", "sum(int(d) for d in str(12345))",
+    }) |code| try t.expect((try measured(code, cap)) != null);
+    for ([_][]const u8{
+        "factorial(48)", "isqrt(10**60)", "gcd(10**61-1,10**30-1)", "prod(range(1,21))",
+    }) |code| try t.expectEqual(@as(?usize, null), try measured(code, cap));
+    try t.expect((try measured("factorial(10)", unlimited)).? > (try measured("factorial(5)", unlimited)).?);
+    try t.expect((try measured("gcd(89,55)", unlimited)).? > (try measured("gcd(99,33)", unlimited)).?);
+    try t.expect((try measured("isqrt(144)", unlimited)).? > (try measured("isqrt(0)", unlimited)).?);
+    try t.expectEqual(try measured("pow(2,100,1)", unlimited), try measured("pow(2,999,1)", unlimited));
+    try t.expect((try measured("pow(2,15,97)", unlimited)).? > (try measured("pow(2,7,97)", unlimited)).?);
+    try t.expect((try measured("pow(10**40+1,2,10**61)", unlimited)) != null);
+}
+
+test "integer cost zero absorption preserves the full range length precheck" {
+    const shorter = (try measured("prod(range(0,1000))", unlimited)).?;
+    const longer = (try measured("prod(range(0,9999))", unlimited)).?;
+    try t.expectEqual(shorter, longer);
+    try t.expect((try measured("prod(range(0,-9999,-1))", cap)) != null);
+    var parser = ast.Parser{ .source = "prod(range(0,10000))" };
+    const root = try parser.parse();
+    const stop = parser.nodes[root].r;
+    parser.nodes[stop].value = 10001;
+    parser.nodes[stop].text = "10001";
+    try t.expectEqual(@as(?usize, null), cost.estimate(&parser, root, unlimited));
+}
+
+test "integer cost refuses unproved invalid and inconsistent graph state" {
+    var parser = ast.Parser{ .source = "isqrt(144)" };
+    const root = try parser.parse();
+    const original = parser;
+    parser.proved[root] = false;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&parser, root, unlimited));
+    parser = original;
+    parser.nodes[root].l = root;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&parser, root, unlimited));
+    parser = original;
+    parser.nodes[root].l = 64;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&parser, root, unlimited));
+    parser = original;
+    parser.nodes[root].value += 1;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&parser, root, unlimited));
+    parser = original;
+    parser.nodes[root].r = 1000;
+    parser.nodes[root].k = 1000;
+    try t.expectEqual(cost.estimate(&original, root, unlimited), cost.estimate(&parser, root, unlimited));
+    parser = original;
+    parser.count = 65;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&parser, root, unlimited));
+    parser.count = 0;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&parser, 0, unlimited));
+    try t.expectEqual(@as(?usize, null), cost.estimate(&original, original.count, unlimited));
+}
+
+test "integer cost handles the final mask bit and rejects malformed ternary and tuple children" {
+    var last = ast.Parser{ .source = "", .count = 64 };
+    last.nodes[63] = .{ .op = .literal, .value = 1, .text = "1" };
+    try t.expectEqual(try measured("1", unlimited), cost.estimate(&last, 63, unlimited));
+    var ternary = ast.Parser{ .source = "pow(2,3,5)" };
+    const power = try ternary.parse();
+    ternary.nodes[power].k = ternary.count;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&ternary, power, unlimited));
+    var tuple = ast.Parser{ .source = "7//3+1" };
+    const root = try tuple.parse();
+    const division = tuple.nodes[root].l;
+    tuple.nodes[division].op = .divmod;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&tuple, root, unlimited));
+}
+
+test "integer cost refuses forged arithmetic failures and bad literal encodings" {
+    const cases = [_]struct { code: []const u8, slot: enum { l, r, k }, value: i512, text: []const u8 }{
+        .{ .code = "factorial(0)", .slot = .l, .value = -1, .text = "1" },
+        .{ .code = "isqrt(1)", .slot = .l, .value = -1, .text = "1" },
+        .{ .code = "7//3", .slot = .r, .value = 0, .text = "0" },
+        .{ .code = "pow(2,1,3)", .slot = .r, .value = -1, .text = "1" },
+        .{ .code = "pow(2,1,3)", .slot = .k, .value = 0, .text = "0" },
+        .{ .code = "prod(range(1,5))", .slot = .k, .value = 0, .text = "0" },
+        .{ .code = "sum(map(int,str(1)))", .slot = .l, .value = -1, .text = "1" },
+    };
+    for (cases) |case| {
+        var parser = ast.Parser{ .source = case.code };
+        const root = try parser.parse();
+        const n = parser.nodes[root];
+        const index = switch (case.slot) {
+            .l => n.l,
+            .r => n.r,
+            .k => n.k,
+        };
+        parser.nodes[index].value = case.value;
+        parser.nodes[index].text = case.text;
+        try t.expectEqual(@as(?usize, null), cost.estimate(&parser, root, unlimited));
+    }
+    var literal = ast.Parser{ .source = "1" };
+    const root = try literal.parse();
+    literal.nodes[root].base = 3;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&literal, root, unlimited));
+    literal.nodes[root].base = 10;
+    literal.nodes[root].text = "2";
+    try t.expectEqual(@as(?usize, null), cost.estimate(&literal, root, unlimited));
+    literal.nodes[root].text = "g";
+    try t.expectEqual(@as(?usize, null), cost.estimate(&literal, root, unlimited));
+    literal.nodes[root].text = "";
+    try t.expectEqual(@as(?usize, null), cost.estimate(&literal, root, unlimited));
+    literal.nodes[root].text = "1";
+    literal.nodes[root].value = ast.limit;
+    try t.expectEqual(@as(?usize, null), cost.estimate(&literal, root, unlimited));
+}
+
+test "integer lowering preserves source APIs and applies optional cost admission before emission" {
+    const integer = @import("runner_frontend_integer.zig");
+    const python = @import("runner_frontend_integer_python.zig");
+    const Lower = *const fn (std.mem.Allocator, []const u8, usize) std.mem.Allocator.Error!?integer.Lowered;
+    for ([_]Lower{ integer.lowerWithCost, python.lowerWithCost }) |lowerWithCost| {
+        const admitted = (try lowerWithCost(t.allocator, "314159*271828", cap)).?;
+        defer t.allocator.free(admitted.source);
+        try t.expectEqual(try measured("314159*271828", unlimited), admitted.estimated_steps);
+        const bypass = (try lowerWithCost(t.allocator, "314159*271828", 0)).?;
+        defer t.allocator.free(bypass.source);
+        try t.expectEqual(@as(?usize, null), bypass.estimated_steps);
+        try t.expectEqualSlices(u8, admitted.source, bypass.source);
+        try t.expect((try lowerWithCost(t.allocator, "314159*271828", admitted.estimated_steps.? - 1)) == null);
+    }
+    const plain = (try integer.lower(t.allocator, "factorial(48)")).?;
+    defer t.allocator.free(plain);
+    const statement = "from math import factorial\nprint(factorial(48))";
+    const source = (try python.lower(t.allocator, statement)).?;
+    defer t.allocator.free(source);
+    try t.expectEqualSlices(u8, plain, source);
+    try t.expect((try python.lowerWithCost(t.allocator, statement, cap)) == null);
+    const bypass = (try python.lowerWithCost(t.allocator, statement, 0)).?;
+    defer t.allocator.free(bypass.source);
+    try t.expectEqual(@as(?usize, null), bypass.estimated_steps);
+    const wide = (try python.lowerWithCost(t.allocator, "a=314159\nb=271828\nprint(a*b)", cap)).?;
+    defer t.allocator.free(wide.source);
+    try t.expectEqual(try measured("314159*271828", unlimited), wide.estimated_steps);
+}
diff --git a/zig/src/core/runner_frontend_integer_python.zig b/zig/src/core/runner_frontend_integer_python.zig
new file mode 100644
index 0000000000000000000000000000000000000000..b341f3412cbf98f34cd3a45449418b0604258622
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer_python.zig
@@ -0,0 +1,195 @@
+const std = @import("std");
+const ast = @import("runner_frontend_integer_ast.zig");
+const integer = @import("runner_frontend_integer.zig");
+const compiler = @import("runner_frontend_program_compile.zig");
+const cost = @import("runner_frontend_integer_cost.zig");
+const Allocator = std.mem.Allocator;
+const Failure = Allocator.Error || ast.Invalid;
+
+// Immutable bindings retain expression nodes; proof values never replace the requested runtime arithmetic.
+pub fn lower(a: Allocator, code: []const u8) Allocator.Error!?[]u8 {
+    const result = try lowerWithCost(a, code, 0) orelse return null;
+    return result.source;
+}
+
+pub fn lowerWithCost(a: Allocator, code: []const u8, budget: usize) Allocator.Error!?integer.Lowered {
+    return checked(a, code, budget) catch |err| switch (err) {
+        error.Unsupported => null,
+        error.OutOfMemory => error.OutOfMemory,
+    };
+}
+
+fn checked(a: Allocator, code: []const u8, budget: usize) Failure!integer.Lowered {
+    var script = try parseOutputs(code, true);
+    const parser = &script.parser;
+    var steps: ?usize = null;
+    const roots = script.roots[0..script.count];
+    if (budget != 0) steps = cost.estimateMany(parser, roots, budget) orelse return error.Unsupported;
+    return .{ .source = try integer.lowerPrints(a, parser, roots, script.endings[0..script.count]), .estimated_steps = steps };
+}
+
+// Shares whole-script validation with the RV32 path, including unused assignments and import gates.
+pub fn lowerCalc(a: Allocator, code: []const u8) Allocator.Error!?[]u8 {
+    var script = parseScript(code) catch return null;
+    return @import("runner_frontend_integer_calc.zig").lower(a, &script.parser, script.root);
+}
+
+pub const Script = struct { parser: ast.Parser, root: usize };
+
+pub fn parseScript(code: []const u8) ast.Invalid!Script {
+    const script = try parseOutputs(code, false);
+    return .{ .parser = script.parser, .root = script.roots[0] };
+}
+
+const Outputs = struct {
+    parser: ast.Parser,
+    roots: [8]usize = undefined,
+    endings: [8]u8 = undefined,
+    count: usize = 0,
+};
+const statements = @import("runner_frontend_integer_statements.zig");
+
+fn parseOutputs(code: []const u8, multiple: bool) ast.Invalid!Outputs {
+    if (code.len == 0 or code.len > 4096 or std.mem.indexOfScalar(u8, code, '\r') != null)
+        return error.Unsupported;
+    var parser: ast.Parser = .{ .source = "", .require_math_import = true };
+    var lines = statements.Iterator{ .code = code };
+    var outputs = Outputs{ .parser = undefined };
+    var expression_only = false;
+    var started = false;
+    while (try lines.next()) |raw| {
+        var line = std.mem.trimEnd(u8, raw.text, " \t");
+        if (raw.after_semicolon) line = std.mem.trimStart(u8, line, " \t");
+        if (line.len == 0) continue;
+        if (((!multiple or expression_only) and outputs.count != 0) or line[0] == ' ' or line[0] == '\t')
+            return error.Unsupported;
+        if (std.mem.startsWith(u8, line, ">>> ")) line = line[4..];
+        if (std.mem.eql(u8, line, "import math")) {
+            if (started) return error.Unsupported;
+            parser.math_module = true;
+            continue;
+        }
+        if (std.mem.startsWith(u8, line, "from math import ")) {
+            if (started) return error.Unsupported;
+            var names = std.mem.splitScalar(u8, line[17..], ',');
+            while (names.next()) |part| {
+                const name = std.mem.trim(u8, part, " ");
+                parser.math_imports |= if (std.mem.eql(u8, name, "gcd")) @as(u8, 1) else if (std.mem.eql(u8, name, "isqrt"))
+                    @as(u8, 2)
+                else if (std.mem.eql(u8, name, "factorial"))
+                    @as(u8, 4)
+                else if (std.mem.eql(u8, name, "prod"))
+                    @as(u8, 8)
+                else
+                    return error.Unsupported;
+            }
+            continue;
+        }
+        started = true;
+        const printed = std.mem.startsWith(u8, line, "print") and line.len > 5 and
+            (line[5] == '(' or line[5] == ' ' or line[5] == '\t');
+        if (printed) {
+            line = std.mem.trimStart(u8, line[5..], " \t");
+            if (line.len < 3 or line[0] != '(' or line[line.len - 1] != ')') return error.Unsupported;
+            try printRoots(&parser, &outputs, line[1 .. line.len - 1], multiple);
+        } else if (statements.separator(line, '=')) |equal| {
+            try assignment(&parser, std.mem.trim(u8, line[0..equal], " \t"), line[equal + 1 ..]);
+        } else {
+            if (outputs.count != 0 or parser.binding_count != 0 or parser.math_module or parser.math_imports != 0)
+                return error.Unsupported;
+            try printRoots(&parser, &outputs, line, false);
+            expression_only = true;
+        }
+    }
+    if (outputs.count == 0) return error.Unsupported;
+    outputs.parser = parser;
+    return outputs;
+}
+
+fn expression(parser: *ast.Parser, text: []const u8) ast.Invalid!usize {
+    parser.source = std.mem.trim(u8, text, " \t");
+    parser.pos = 0;
+    return parser.parse();
+}
+
+fn assignment(parser: *ast.Parser, names: []const u8, rhs: []const u8) ast.Invalid!void {
+    if (statements.separator(names, ',')) |comma| {
+        const first = std.mem.trim(u8, names[0..comma], " \t");
+        const second = std.mem.trim(u8, names[comma + 1 ..], " \t");
+        if (!validBinding(first) or !validBinding(second)) return error.Unsupported;
+        const pair = try parser.divisionPair(try expression(parser, rhs));
+        try parser.bind(first, pair[0]);
+        try parser.bind(second, pair[1]);
+    } else {
+        if (!validBinding(names)) return error.Unsupported;
+        const root = try expression(parser, rhs);
+        if (parser.nodes[root].op == .divmod) return error.Unsupported;
