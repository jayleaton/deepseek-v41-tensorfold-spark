@@ -0,0 +1,292 @@
+const std = @import("std");
+const m = @import("runner_frontend_c_cost_model.zig");
+const V = m.V;
+const Error = m.Error;
+const Value = m.Value;
+const Range = m.Range;
+const Env = m.Env;
+
+pub fn eval(p: anytype, env: *Env, node: V) Error!Value {
+    try p.touch();
+    const c = m.children(node);
+    if (m.is(node, "IntegerLiteral") or m.is(node, "CharacterLiteral")) {
+        try p.charge(3);
+        const value = try m.integer(node);
+        const typ = m.integerType(m.typ(node)) orelse return error.Unsupported;
+        if (!typ.fits(Range.exact(value))) return error.Unsupported;
+        return Value.integer(value);
+    }
+    if (m.is(node, "StringLiteral")) {
+        const array = m.arrayType(m.typ(node)) orelse return error.Unsupported;
+        if (array.element.bits != 8) return error.Unsupported;
+        return .{ .text = try m.string(p.a, node) };
+    }
+    if (m.is(node, "ParenExpr") or m.is(node, "ConstantExpr")) {
+        if (c.len != 1) return error.Unsupported;
+        return p.eval(env, c[0]);
+    }
+    if (m.is(node, "ImplicitCastExpr") or m.is(node, "CStyleCastExpr")) {
+        if (c.len != 1) return error.Unsupported;
+        var v = try p.eval(env, c[0]);
+        if (m.integerType(m.typ(node))) |t| {
+            const r = try v.numeric();
+            if (!t.fits(r)) v.number = t.range();
+        } else {
+            const target = m.pointerType(m.typ(node)) orelse return error.Unsupported;
+            if (v.array) |array| {
+                if (target.bits != array.element_type.bits or target.signed != array.element_type.signed or
+                    target.plain_char != array.element_type.plain_char)
+                    return error.Unsupported;
+            } else if (v.text != null) {
+                if (target.bits != 8) return error.Unsupported;
+            } else return error.Unsupported;
+        }
+        return v;
+    }
+    if (m.is(node, "DeclRefExpr")) {
+        const b = env.find(m.ref(node)) orelse return error.Unsupported;
+        if (b.value.number == null and b.value.array == null and b.value.text == null) return error.Unsupported;
+        try p.charge(2);
+        return b.value;
+    }
+    if (m.is(node, "UnaryExprOrTypeTraitExpr")) {
+        if (!std.mem.eql(u8, m.text(m.field(node, "name")), "sizeof")) return error.Unsupported;
+        const raw = if (c.len == 1) m.typ(c[0]) else m.text(m.field(m.field(node, "argType"), "qualType"));
+        try p.charge(3);
+        return Value.integer(@intCast(m.size(raw) orelse return error.Unsupported));
+    }
+    if (m.is(node, "ArraySubscriptExpr")) {
+        if (c.len != 2) return error.Unsupported;
+        const base = try p.eval(env, c[0]);
+        const index = try (try p.eval(env, c[1])).numeric();
+        try p.charge(6);
+        if (base.array) |array| {
+            if (!array.readable) return error.Unsupported;
+            if (index.lo < 0 or index.hi >= array.count) return error.Unsupported;
+            if (array.text) |s| return charRange(s, index);
+            return .{ .number = array.element };
+        }
+        if (base.text) |s| {
+            if (index.lo < 0 or index.hi > s.len) return error.Unsupported;
+            return charRange(s, index);
+        }
+        return error.Unsupported;
+    }
+    if (m.is(node, "CallExpr")) return p.call(env, node);
+    if (m.is(node, "ConditionalOperator")) {
+        if (c.len != 3) return error.Unsupported;
+        return p.conditionalValue(env, c);
+    }
+    if (m.is(node, "UnaryOperator")) {
+        if (c.len != 1) return error.Unsupported;
+        const x = try (try p.eval(env, c[0])).numeric();
+        if (m.op(node, "++") or m.op(node, "--")) {
+            const delta: i128 = if (m.op(node, "++")) 1 else -1;
+            const r = try fit(node, .{ .lo = x.lo + delta, .hi = x.hi + delta });
+            try p.store(env, c[0], .{ .number = r });
+            try p.charge(3);
+            const post = m.field(node, "isPostfix");
+            return .{ .number = if (post == .bool and post.bool) x else r };
+        }
+        try p.charge(2);
+        if (m.op(node, "+")) return .{ .number = x };
+        if (m.op(node, "-")) return .{ .number = try fit(node, .{ .lo = -x.hi, .hi = -x.lo }) };
+        if (m.op(node, "!")) return .{ .number = truth(x, true) };
+        return error.Unsupported;
+    }
+    if (m.is(node, "BinaryOperator") or m.is(node, "CompoundAssignOperator")) {
+        if (c.len != 2) return error.Unsupported;
+        if (m.op(node, "=")) {
+            const v = try p.eval(env, c[1]);
+            try p.store(env, c[0], v);
+            try p.charge(2);
+            return v;
+        }
+        if (m.op(node, "&&") or m.op(node, "||") or m.op(node, ",")) return error.Unsupported;
+        const x = try (try p.eval(env, c[0])).numeric();
+        const y = try (try p.eval(env, c[1])).numeric();
+        const raw = m.text(m.field(node, "opcode"));
+        const compound = m.is(node, "CompoundAssignOperator");
+        const operator = if (compound and raw.len > 1) raw[0 .. raw.len - 1] else raw;
+        const t = m.integerType(m.typ(node)) orelse return error.Unsupported;
+        try p.charge(if (t.bits > 32) 5 else 2);
+        if (t.bits > 32 and (std.mem.eql(u8, operator, "/") or std.mem.eql(u8, operator, "%")))
+            try p.charge(2000);
+        const result: Value = .{ .number = try binary(node, operator, x, y) };
+        if (compound) {
+            try p.store(env, c[0], result);
+            try p.charge(2);
+        }
+        return result;
+    }
+    return error.Unsupported;
+}
+
+fn charRange(s: []const u8, index: Range) Value {
+    if (index.lo >= s.len) return Value.integer(0);
+    return .{ .number = .{ .lo = if (index.hi < s.len) 1 else 0, .hi = 127 } };
+}
+
+fn truth(r: Range, invert: bool) Range {
+    const yes = r.lo > 0 or r.hi < 0;
+    const no = r.lo == 0 and r.hi == 0;
+    if (yes) return Range.exact(@intFromBool(!invert));
+    if (no) return Range.exact(@intFromBool(invert));
+    return .{ .lo = 0, .hi = 1 };
+}
+
+fn fit(node: V, r: Range) Error!Range {
+    const t = m.integerType(m.typ(node)) orelse return error.Unsupported;
+    if (t.fits(r)) return r;
+    if (t.signed) return error.Unsupported;
+    return t.range();
+}
+
+fn binary(node: V, operator: []const u8, x: Range, y: Range) Error!Range {
+    if (std.mem.eql(u8, operator, "+")) return fit(node, .{ .lo = x.lo + y.lo, .hi = x.hi + y.hi });
+    if (std.mem.eql(u8, operator, "-")) return fit(node, .{ .lo = x.lo - y.hi, .hi = x.hi - y.lo });
+    if (std.mem.eql(u8, operator, "*")) {
+        const t = m.integerType(m.typ(node)) orelse return error.Unsupported;
+        const pairs = [_][2]i128{ .{ x.lo, y.lo }, .{ x.lo, y.hi }, .{ x.hi, y.lo }, .{ x.hi, y.hi } };
+        var r: Range = .{ .lo = std.math.maxInt(i128), .hi = std.math.minInt(i128) };
+        for (pairs) |pair| {
+            const n = std.math.mul(i128, pair[0], pair[1]) catch {
+                if (t.signed) return error.Unsupported;
+                return t.range();
+            };
+            r.lo = @min(r.lo, n);
+            r.hi = @max(r.hi, n);
+        }
+        return fit(node, r);
+    }
+    if (std.mem.eql(u8, operator, "/") or std.mem.eql(u8, operator, "%")) {
+        if (y.lo <= 0 and y.hi >= 0) return error.Unsupported;
+        const t = m.integerType(m.typ(node)) orelse return error.Unsupported;
+        if (x.lo == t.range().lo and t.signed and y.lo <= -1 and y.hi >= -1) return error.Unsupported;
+        if (std.mem.eql(u8, operator, "%")) {
+            const bound = @max(@abs(y.lo), @abs(y.hi)) - 1;
+            return .{ .lo = if (x.lo < 0) -@as(i128, @intCast(bound)) else 0, .hi = if (x.hi > 0) @intCast(bound) else 0 };
+        }
+        const values = [_]i128{ @divTrunc(x.lo, y.lo), @divTrunc(x.lo, y.hi), @divTrunc(x.hi, y.lo), @divTrunc(x.hi, y.hi) };
+        var r = Range.exact(values[0]);
+        for (values[1..]) |n| r = r.join(Range.exact(n));
+        return fit(node, r);
+    }
+    var yes = false;
+    var no = false;
+    if (std.mem.eql(u8, operator, "<")) {
+        yes = x.hi < y.lo;
+        no = x.lo >= y.hi;
+    } else if (std.mem.eql(u8, operator, "<=")) {
+        yes = x.hi <= y.lo;
+        no = x.lo > y.hi;
+    } else if (std.mem.eql(u8, operator, ">")) {
+        yes = x.lo > y.hi;
+        no = x.hi <= y.lo;
+    } else if (std.mem.eql(u8, operator, ">=")) {
+        yes = x.lo >= y.hi;
+        no = x.hi < y.lo;
+    } else if (std.mem.eql(u8, operator, "==") or std.mem.eql(u8, operator, "!=")) {
+        yes = x.lo == x.hi and y.lo == y.hi and x.lo == y.lo;
+        no = x.hi < y.lo or y.hi < x.lo;
+        if (std.mem.eql(u8, operator, "!=")) std.mem.swap(bool, &yes, &no);
+    } else return error.Unsupported;
+    return if (yes) Range.exact(1) else if (no) Range.exact(0) else .{ .lo = 0, .hi = 1 };
+}
+
+pub fn refine(env: *Env, condition: V, positive: bool) void {
+    const node = m.strip(condition);
+    const c = m.children(node);
+    if (m.is(node, "UnaryOperator") and m.op(node, "!") and c.len == 1) return refine(env, c[0], !positive);
+    if (m.is(node, "DeclRefExpr")) {
+        const b = env.find(safeRef(env, condition)) orelse return;
+        var r = b.value.number orelse return;
+        if (!positive and r.lo <= 0 and r.hi >= 0) r = Range.exact(0) else if (positive and r.lo == 0 and r.hi > 0) r.lo = 1;
+        b.value.number = r;
+        return;
+    }
+    if (!m.is(node, "BinaryOperator") or c.len != 2) return;
+    const left = env.find(safeRef(env, c[0]));
+    const right = env.find(safeRef(env, c[1]));
+    const x = if (left) |b| b.value.number else literal(c[0]);
+    const y = if (right) |b| b.value.number else literal(c[1]);
+    if (x == null or y == null) return;
+    var a = x.?;
+    var b = y.?;
+    var operator = m.text(m.field(node, "opcode"));
+    if (!positive) {
+        const pairs = [_][2][]const u8{ .{ "<", ">=" }, .{ "<=", ">" }, .{ ">", "<=" }, .{ ">=", "<" }, .{ "==", "!=" }, .{ "!=", "==" } };
+        for (pairs) |pair| if (std.mem.eql(u8, operator, pair[0])) {
+            operator = pair[1];
+            break;
+        };
+    }
+    if (std.mem.eql(u8, operator, ">") or std.mem.eql(u8, operator, ">=")) {
+        const delta: i128 = @intFromBool(std.mem.eql(u8, operator, ">"));
+        a.lo = @max(a.lo, b.lo + delta);
+        b.hi = @min(b.hi, a.hi - delta);
+    } else if (std.mem.eql(u8, operator, "<") or std.mem.eql(u8, operator, "<=")) {
+        const delta: i128 = @intFromBool(std.mem.eql(u8, operator, "<"));
+        a.hi = @min(a.hi, b.hi - delta);
+        b.lo = @max(b.lo, a.lo + delta);
+    } else if (std.mem.eql(u8, operator, "==")) {
+        a = .{ .lo = @max(a.lo, b.lo), .hi = @min(a.hi, b.hi) };
+        b = a;
+    } else if (std.mem.eql(u8, operator, "!=")) {
+        if (b.lo == b.hi) {
+            if (a.lo == b.lo) a.lo += 1;
+            if (a.hi == b.hi) a.hi -= 1;
+        }
+        if (x.?.lo == x.?.hi) {
+            if (b.lo == x.?.lo) b.lo += 1;
+            if (b.hi == x.?.hi) b.hi -= 1;
+        }
+    }
+    if (a.lo <= a.hi) {
+        if (left) |binding| binding.value.number = a;
+    }
+    if (b.lo <= b.hi) {
+        if (right) |binding| binding.value.number = b;
+    }
+}
+
+pub fn safeRef(env: *Env, raw: V) []const u8 {
+    const id = m.ref(raw);
+    const binding = env.find(id) orelse return "";
+    const r = binding.value.number orelse return "";
+    return transparentRef(raw, r);
+}
+
+pub fn transparentRef(raw: V, r: Range) []const u8 {
+    const id = m.ref(raw);
+    var n = raw;
+    for (0..64) |_| {
+        if (m.is(n, "DeclRefExpr")) return id;
+        const c = m.children(n);
+        if (c.len != 1) return "";
+        if (m.is(n, "ImplicitCastExpr") or m.is(n, "CStyleCastExpr")) {
+            const t = m.integerType(m.typ(n)) orelse return "";
+            if (!t.fits(r)) return "";
+        } else if (!m.is(n, "ParenExpr")) return "";
+        n = c[0];
+    }
+    return "";
+}
+
+fn literal(v: V) ?Range {
+    const n = m.strip(v);
+    if (!m.is(n, "IntegerLiteral") and !m.is(n, "CharacterLiteral")) return null;
+    const r = Range.exact(m.integer(n) catch return null);
+    var wrapper = v;
+    for (0..64) |_| {
+        if (m.is(wrapper, "IntegerLiteral") or m.is(wrapper, "CharacterLiteral")) return r;
+        const c = m.children(wrapper);
+        if (c.len != 1) return null;
+        if (m.is(wrapper, "ImplicitCastExpr") or m.is(wrapper, "CStyleCastExpr")) {
+            const t = m.integerType(m.typ(wrapper)) orelse return null;
+            if (!t.fits(r)) return null;
+        } else if (!m.is(wrapper, "ParenExpr") and !m.is(wrapper, "ConstantExpr")) return null;
+        wrapper = c[0];
+    }
+    return null;
+}
diff --git a/zig/src/core/runner_frontend_c_cost_loops.zig b/zig/src/core/runner_frontend_c_cost_loops.zig
new file mode 100644
index 0000000000000000000000000000000000000000..af26f324ccc4b63f8c5882d02f3ff451487e5419
--- /dev/null
+++ b/zig/src/core/runner_frontend_c_cost_loops.zig
@@ -0,0 +1,236 @@
+const std = @import("std");
+const m = @import("runner_frontend_c_cost_model.zig");
+const expression = @import("runner_frontend_c_cost_expr.zig");
+const Flow = @import("runner_frontend_c_cost.zig").Flow;
+const V = m.V;
+const Error = m.Error;
+const Env = m.Env;
+
+pub fn forLoop(p: anytype, env: *Env, node: V) Error!Flow {
+    const c = m.children(node);
+    if (c.len != 5 or m.field(c[1], "kind") != .null) return error.Unsupported;
+    const mark = env.bindings.items.len;
+    defer env.bindings.shrinkRetainingCapacity(mark);
+    if (m.field(c[0], "kind") != .null) {
+        const init = try p.stmt(env, c[0]);
+        if (!init.normal or init.returned != null) return error.Unsupported;
+    }
+    const step = try increment(c[3]);
+    const count = try tripCount(p, env, c[2], step);
+    return run(p, env, c[2], c[3], c[4], null, count);
+}
+
+pub fn whileLoop(p: anytype, env: *Env, node: V) Error!Flow {
+    const c = m.children(node);
+    if (c.len != 2) return error.Unsupported;
+    if (try euclid(p, env, c[0], c[1])) |flow| return flow;
+    if (!m.is(c[1], "CompoundStmt")) {
+        const step = try increment(c[1]);
+        const count = try tripCount(p, env, c[0], step);
+        return run(p, env, c[0], c[1], .null, &.{}, count);
+    }
+    const body = m.children(c[1]);
+    if (body.len == 0) return error.Unsupported;
+    const inc = body[body.len - 1];
+    const step = try increment(inc);
+    const count = try tripCount(p, env, c[0], step);
+    return run(p, env, c[0], inc, .null, body[0 .. body.len - 1], count);
+}
+
+const Step = struct { id: []const u8, delta: i128 };
+
+fn increment(raw: V) Error!Step {
+    const n = m.strip(raw);
+    const c = m.children(n);
+    if (c.len == 1 and m.is(n, "UnaryOperator") and (m.op(n, "++") or m.op(n, "--"))) {
+        const id = m.ref(c[0]);
+        if (id.len == 0) return error.Unsupported;
+        return .{ .id = id, .delta = if (m.op(n, "++")) 1 else -1 };
+    }
+    if (c.len == 2 and m.is(n, "CompoundAssignOperator") and (m.op(n, "+=") or m.op(n, "-="))) {
+        const id = m.ref(c[0]);
+        const value = m.strip(c[1]);
+        if (id.len == 0 or !m.is(value, "IntegerLiteral")) return error.Unsupported;
+        var delta = try m.integer(value);
+        if (m.op(n, "-=")) delta = -delta;
+        if (delta == 0) return error.Unsupported;
+        return .{ .id = id, .delta = delta };
+    }
+    if (c.len == 2 and m.is(n, "BinaryOperator") and m.op(n, "=")) {
+        const id = m.ref(c[0]);
+        const rhs = m.strip(c[1]);
+        const terms = m.children(rhs);
+        if (id.len == 0 or !m.is(rhs, "BinaryOperator") or terms.len != 2 or
+            !std.mem.eql(u8, id, m.ref(terms[0])) or (!m.op(rhs, "+") and !m.op(rhs, "-")))
+            return error.Unsupported;
+        const value = m.strip(terms[1]);
+        if (!m.is(value, "IntegerLiteral")) return error.Unsupported;
+        var delta = try m.integer(value);
+        if (m.op(rhs, "-")) delta = -delta;
+        if (delta == 0) return error.Unsupported;
+        return .{ .id = id, .delta = delta };
+    }
+    return error.Unsupported;
+}
+
+fn tripCount(p: anytype, env: *Env, raw: V, step: Step) Error!usize {
+    const n = m.strip(raw);
+    const c = m.children(n);
+    const binding = env.find(step.id) orelse return error.Unsupported;
+    const start = try binding.value.numeric();
+    if (start.lo != start.hi) return error.Unsupported;
+    if (m.is(n, "ArraySubscriptExpr") and c.len == 2 and step.delta == 1 and
+        std.mem.eql(u8, m.ref(c[1]), step.id))
+    {
+        const base = try p.eval(env, c[0]);
+        const text = base.text orelse if (base.array) |ar| ar.text orelse return error.Unsupported else return error.Unsupported;
+        if (start.lo < 0 or start.hi > text.len) return error.Unsupported;
+        const count = text.len - @as(usize, @intCast(start.lo));
+        if (count > p.limit) return error.Unsupported;
+        return count;
+    }
+    if (!m.is(n, "BinaryOperator") or c.len != 2 or !std.mem.eql(u8, expression.safeRef(env, c[0]), step.id))
+        return error.Unsupported;
+    try pure(p, c[1], 0);
+    const stop = try (try p.eval(env, c[1])).numeric();
+    var count: i128 = 0;
+    if (step.delta > 0 and (m.op(n, "<") or m.op(n, "<="))) {
+        const last = stop.hi - @intFromBool(m.op(n, "<"));
+        if (last >= start.lo) count = @divFloor(last - start.lo, step.delta) + 1;
+    } else if (step.delta < 0 and (m.op(n, ">") or m.op(n, ">="))) {
+        const last = stop.lo + @intFromBool(m.op(n, ">"));
+        if (start.hi >= last) count = @divFloor(start.hi - last, -step.delta) + 1;
+    } else return error.Unsupported;
+    if (count > p.limit) return error.Unsupported;
+    const t = binding.typ orelse return error.Unsupported;
+    const end = std.math.mul(i128, count, step.delta) catch return error.Unsupported;
+    const final = std.math.add(i128, start.lo, end) catch return error.Unsupported;
+    if (!t.fits(m.Range.exact(final))) return error.Unsupported;
+    return @intCast(count);
+}
+
+fn run(p: anytype, env: *Env, condition: V, inc: V, body: V, slice: ?[]const V, count: usize) Error!Flow {
+    var exits: ?Env = null;
+    var result: Flow = .{ .normal = false };
+    var iteration: usize = 0;
+    while (true) {
+        const r = try (try p.eval(env, condition)).numeric();
+        try p.charge(2);
+        const maybe_exit = r.lo <= 0 and r.hi >= 0;
+        if (maybe_exit) {
+            var exit = try p.clone(env);
+            expression.refine(&exit, condition, false);
+            if (exits) |*old| try old.merge(&exit) else exits = exit;
+        }
+        if (r.lo == 0 and r.hi == 0) break;
+        if (iteration >= count) return error.Unsupported;
+        iteration += 1;
+        expression.refine(env, condition, true);
+        const lock_mark = p.locked.items.len;
+        try protect(p, condition, 0);
+        const next = if (slice) |nodes| try p.block(env, nodes) else try p.stmt(env, body);
+        p.locked.shrinkRetainingCapacity(lock_mark);
+        try result.include(next);
+        if (!next.normal) break;
+        _ = try p.eval(env, inc);
+        try p.charge(2);
+    }
+    if (exits) |exit| {
+        env.* = exit;
+        result.normal = true;
+    }
+    return result;
+}
+
+fn protect(p: anytype, n: V, depth: usize) Error!void {
+    if (depth >= 64 or p.locked.items.len >= 256) return error.Unsupported;
+    try pure(p, n, depth);
+    const id = m.ref(n);
+    if (id.len != 0) try p.locked.append(p.a, id);
+    for (m.children(n)) |child| try protect(p, child, depth + 1);
+}
+
+fn pure(p: anytype, n: V, depth: usize) Error!void {
+    try p.touch();
+    if (depth >= 64 or m.is(n, "CallExpr") or m.is(n, "CompoundAssignOperator") or m.op(n, "=") or
+        m.op(n, "++") or m.op(n, "--") or m.op(n, ",")) return error.Unsupported;
+    for (m.children(n)) |child| try pure(p, child, depth + 1);
+}
+
+fn assignment(n: V) ?struct { id: []const u8, rhs: V } {
+    const c = m.children(n);
+    if (!m.is(n, "BinaryOperator") or !m.op(n, "=") or c.len != 2) return null;
+    const id = m.ref(c[0]);
+    if (id.len == 0) return null;
+    return .{ .id = id, .rhs = c[1] };
+}
+
+fn euclid(p: anytype, env: *Env, cond: V, body: V) Error!?Flow {
+    const nodes = m.children(body);
+    if (!m.is(body, "CompoundStmt") or nodes.len != 3 or !m.is(nodes[0], "DeclStmt")) return null;
+    const declarations = m.children(nodes[0]);
+    if (declarations.len != 1 or !m.is(declarations[0], "VarDecl")) return null;
+    const temp = declarations[0];
+    const initializers = m.children(temp);
+    if (initializers.len != 1) return null;
+    const first = assignment(nodes[1]) orelse return null;
+    const second = assignment(nodes[2]) orelse return null;
+    const delayed = m.ref(initializers[0]).len != 0;
+    const remainder_source = if (delayed) first.rhs else initializers[0];
+    const rem = m.strip(remainder_source);
+    const operands = m.children(rem);
+    if (!m.is(rem, "BinaryOperator") or !m.op(rem, "%") or operands.len != 2) return null;
+    if ((m.integerType(m.typ(rem)) orelse return error.Unsupported).bits > 32) return error.Unsupported;
+    const a_id = expression.safeRef(env, operands[0]);
+    const b_id = expression.safeRef(env, operands[1]);
+    const t_id = m.text(m.field(temp, "id"));
+    if (a_id.len == 0 or b_id.len == 0 or std.mem.eql(u8, a_id, b_id)) return null;
+    const saved_b = if (delayed) initializers[0] else first.rhs;
+    if (!std.mem.eql(u8, first.id, if (delayed) b_id else a_id) or
+        !std.mem.eql(u8, expression.safeRef(env, saved_b), b_id) or
+        !std.mem.eql(u8, second.id, if (delayed) a_id else b_id) or
+        !std.mem.eql(u8, m.ref(second.rhs), t_id)) return null;
+    const guard = m.strip(cond);
+    var guard_id = expression.safeRef(env, cond);
+    if (m.is(guard, "BinaryOperator") and m.op(guard, "!=")) {
+        const c = m.children(guard);
+        if (c.len != 2 or !m.is(m.strip(c[1]), "IntegerLiteral") or try m.integer(m.strip(c[1])) != 0)
+            return null;
+        guard_id = expression.safeRef(env, c[0]);
+    }
+    if (!std.mem.eql(u8, guard_id, b_id)) return null;
+    const a_binding = env.find(a_id) orelse return error.Unsupported;
+    const b_binding = env.find(b_id) orelse return error.Unsupported;
+    const x = try a_binding.value.numeric();
+    const y = try b_binding.value.numeric();
+    const top = @max(x.hi, y.hi);
+    if (x.lo < 0 or y.lo < 0 or top > std.math.maxInt(u32)) return error.Unsupported;
+    const bound: m.Range = .{ .lo = 0, .hi = top };
+    var wrapper = remainder_source;
+    for (0..64) |_| {
+        if (m.is(wrapper, "BinaryOperator")) break;
+        const inner = m.children(wrapper);
+        if (inner.len != 1) return error.Unsupported;
+        if (m.is(wrapper, "ImplicitCastExpr") or m.is(wrapper, "CStyleCastExpr")) {
+            if (!(m.integerType(m.typ(wrapper)) orelse return error.Unsupported).fits(bound))
+                return error.Unsupported;
+        } else if (!m.is(wrapper, "ParenExpr")) return error.Unsupported;
+        wrapper = inner[0];
+    }
+    if (!std.mem.eql(u8, expression.transparentRef(second.rhs, bound), t_id) or
+        !std.mem.eql(u8, expression.transparentRef(saved_b, bound), b_id) or
+        !std.mem.eql(u8, expression.transparentRef(operands[0], bound), a_id) or
+        !std.mem.eql(u8, expression.transparentRef(operands[1], bound), b_id)) return error.Unsupported;
+    if (!(a_binding.typ orelse return error.Unsupported).fits(bound) or
+        !(b_binding.typ orelse return error.Unsupported).fits(bound) or
+        !(m.integerType(m.typ(temp)) orelse return error.Unsupported).fits(bound)) return error.Unsupported;
+    var bits: usize = 0;
+    var n = top;
+    while (n > 0) : (n = @divTrunc(n, 2)) bits += 1;
+    const iterations = if (y.hi == 0) 0 else 2 * bits + 1;
+    if (iterations > p.limit) return error.Unsupported;
+    try p.charge(12 + iterations * 45);
+    try p.store(env, operands[0], .{ .number = bound });
+    try p.store(env, operands[1], m.Value.integer(0));
+    return Flow{};
+}
diff --git a/zig/src/core/runner_frontend_c_cost_model.zig b/zig/src/core/runner_frontend_c_cost_model.zig
new file mode 100644
