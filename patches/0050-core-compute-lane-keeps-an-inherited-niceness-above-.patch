From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Sat, 31 Oct 2026 23:22:58 +0700
Subject: [PATCH 050/207] core: compute lane keeps an inherited niceness above
 10

The sandbox set nice 10 after dropping root. When the engine already runs
above nice 10 that is a lowering, which the dropped uid may not do, so
every job came back unavailable. Keep the inherited niceness when it is
already at least 10.
---
 zig/src/core/compute_lane_test.zig | 21 +++++++++++++++++++++
 zig/src/core/compute_sandbox.zig   |  4 +++-
 2 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/zig/src/core/compute_lane_test.zig b/zig/src/core/compute_lane_test.zig
index 0949526a6dceb698c8e8d2d116a770fd34eacc40..eb2ab2cc76725c91bd3a4b13070c73f13db176c8 100644
--- a/zig/src/core/compute_lane_test.zig
+++ b/zig/src/core/compute_lane_test.zig
@@ -59,6 +59,27 @@ test "compute sandbox: self test passes (Landlock and seccomp present)" {
     try pool.selfTest(j.arena.allocator());
 }
 
+test "compute sandbox: a job from a thread at nice 19 runs and keeps that niceness" {
+    try ready();
+    const Run = struct {
+        status: lane.Status = .unavailable,
+        out: []const u8 = "",
+        fn go(r: *@This(), j: *Job) void {
+            _ = linux.syscall3(.setpriority, 0, 0, 19); // this thread only: the job inherits it
+            const o = j.expectStatus(.{}, "import os\nos.nice(0)", .ok) catch return;
+            r.status = o.status;
+            r.out = o.stdout;
+        }
+    };
+    var j: Job = .{};
+    defer j.deinit();
+    var r: Run = .{};
+    const t = try std.Thread.spawn(.{}, Run.go, .{ &r, &j });
+    t.join();
+    try expectEqual(lane.Status.ok, r.status);
+    try expectEqualStrings("19\n", r.out);
+}
+
 test "compute sandbox: final expression prints its repr" {
     try ready();
     var j: Job = .{};
diff --git a/zig/src/core/compute_sandbox.zig b/zig/src/core/compute_sandbox.zig
index af08a4a6272ccf3cf00254811a97d9870d2c5efc..a6a1061b91f77dacc937ab652acde2cb183916f1 100644
--- a/zig/src/core/compute_sandbox.zig
+++ b/zig/src/core/compute_sandbox.zig
@@ -78,7 +78,9 @@ fn confine(argv: []const [:0]const u8) noreturn {
     limit("RLIMIT_CORE", .CORE, 0);
     limit("RLIMIT_NOFILE", .NOFILE, 64);
     if (root) limit("RLIMIT_NPROC", .NPROC, 512);
-    check("setpriority", linux.syscall3(.setpriority, 0, 0, 10));
+    // nice 10 at least, never less than the engine's own: lowering it needs a privilege the job no longer has
+    const inherited = 20 - @as(isize, @bitCast(linux.syscall2(.getpriority, 0, 0)));
+    if (inherited < 10) check("setpriority", linux.syscall3(.setpriority, 0, 0, 10));
     if (job.cpus.len > 0) {
         var set: [16]u64 = undefined;
         if (!cpuList(job.cpus, &set)) die("cpu list", code(.INVAL));
