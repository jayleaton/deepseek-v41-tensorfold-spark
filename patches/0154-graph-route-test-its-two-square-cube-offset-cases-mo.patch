Subject: [PATCH 154/207] graph route test: its two square/cube offset cases
 move past 256 digits (both now fit T1's width)

---
 zig/src/core/runner_graph_program.zig | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/zig/src/core/runner_graph_program.zig b/zig/src/core/runner_graph_program.zig
index c73c893de8ba38880655a0ca9059ca9f9c8a6bea..4353cc90323aec2720c62e6eab5f7d8a87577730 100644
--- a/zig/src/core/runner_graph_program.zig
+++ b/zig/src/core/runner_graph_program.zig
@@ -385,8 +385,8 @@ test "runner graph route: decimals, true division, computed exponents or divisor
         "7//0",
         "7%(1+1)",
         "10**256", // past T1's 256-digit width (b047d48c8); a bank without it refuses at lowering
-        "(10**80+123456789)**2-10**161",
-        "(10**80+123456789)**3-10**160",
+        "(10**130+123456789)**2-10**261",
+        "(10**90+123456789)**3-10**270",
         "007+1",
         "x*2",
         "",
