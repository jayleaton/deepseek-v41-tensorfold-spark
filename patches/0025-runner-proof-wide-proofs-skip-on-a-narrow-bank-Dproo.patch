+    var cache_dir: ?[]const u8 = null;
     for (args[1..]) |arg| {
         if (std.mem.startsWith(u8, arg, "--proof-shard-index=")) {
             if (selected != null) return error.DuplicateProofShard;
@@ -46,8 +48,10 @@ fn run(init: std.process.Init.Minimal) !void {
             listen = true;
         } else if (std.mem.startsWith(u8, arg, "--seed=")) {
             testing.random_seed = try std.fmt.parseUnsigned(u32, arg["--seed=".len..], 0);
+        } else if (std.mem.eql(u8, arg, "--proof-serial")) {
+            serial = true;
         } else if (std.mem.startsWith(u8, arg, "--cache-dir=")) {
-            continue;
+            cache_dir = arg["--cache-dir=".len..];
         } else return error.UnknownProofArgument;
     }
     if (catalog) {
@@ -60,10 +64,13 @@ fn run(init: std.process.Init.Minimal) !void {
         return;
     }
     if (!listen or selected == null) return error.MissingProofShardArguments;
-    try mainServer(init, selected.?);
+    // --proof-serial (-Dproof-keep-going): shards no longer wait on each other's steps; one test runs at a time here
+    var lock_path: [std.fs.max_path_bytes]u8 = undefined;
+    const lock = if (serial) try std.fmt.bufPrint(&lock_path, "{s}/proof-shards.lock", .{cache_dir orelse return error.MissingProofCacheDir}) else null;
+    try mainServer(init, selected.?, lock);
 }
 
-fn mainServer(init: std.process.Init.Minimal, selected: usize) !void {
+fn mainServer(init: std.process.Init.Minimal, selected: usize, lock: ?[]const u8) !void {
     @disableInstrumentation();
     var in_buffer: [4096]u8 = undefined;
     var out_buffer: [4096]u8 = undefined;
@@ -98,6 +105,8 @@ fn mainServer(init: std.process.Init.Minimal, selected: usize) !void {
                 if (!metadata_sent) return error.MissingProofMetadata;
                 if (executed) return error.DuplicateProofExecution;
                 executed = true;
+                // held until exit: the kernel drops the lock when this process ends, however it ends
+                if (lock) |path| _ = try Io.Dir.cwd().createFile(runner_io, path, .{ .lock = .exclusive, .truncate = false });
                 try execute(&server, init, selected);
             },
             else => return error.UnsupportedProofMessage,
