+++ b/zig/src/core/runner_proof_wide_test.zig
@@ -12,9 +12,18 @@ const finish = pt.finish;
 
 const gpa = std.testing.allocator;
 
+/// Opens the real circuit and bank; a bank with no width-256 template (graph-v4) skips `proof`: it needs T1's wide bank
+fn openWide(both: *Both, proof: []const u8) !void {
+    try both.open();
+    for (both.bank.templates) |t| if (t.width == 256) return;
+    both.close();
+    std.debug.print("skip runner proof: {s}: the bank at TF_RUNNER_GRAPH_BANK has no width-256 template\n", .{proof});
+    return error.SkipZigTest;
+}
