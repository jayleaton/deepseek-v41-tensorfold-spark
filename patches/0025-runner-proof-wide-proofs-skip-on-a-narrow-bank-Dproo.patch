From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:38:06 +0700
Subject: [PATCH 25/72] runner proof: wide proofs skip on a narrow bank;
 -Dproof-keep-going

A whole proof-host run on the graph-v4 bank stopped at the first width-256
proof, since v4 has no width-256 template, and the serial shard chain
then skipped every later shard.

The four width-256 proofs now skip, by name, when the loaded bank has no
width-256 template; on a bank that has them (v7) they run and fail as
before.

-Dproof-keep-going makes each shard depend on the catalog only, so a
failed shard skips no later one, and the step still fails. The shards
pass --proof-serial: each takes an exclusive lock in the cache dir before
its test, so tests still run one at a time at any -j.
---
 zig/build/runner_proof_shards.zig       | 11 +++++++++--
 zig/runner_proof_shard_runner.zig       | 15 ++++++++++++---
 zig/src/core/runner_proof_wide_test.zig | 17 +++++++++++++----
 3 files changed, 34 insertions(+), 9 deletions(-)

diff --git a/zig/build/runner_proof_shards.zig b/zig/build/runner_proof_shards.zig
index 7a71738f18c2662b6fd2b7c33a1120c236302392..4101e548b04c0b4fd682fc1ae971faf407ae0012 100644
--- a/zig/build/runner_proof_shards.zig
+++ b/zig/build/runner_proof_shards.zig
@@ -7,6 +7,7 @@ pub fn steps(b: *std.Build, api_fast: *std.Build.Module) void {
         .filters = &.{"runner proof:"},
         .test_runner = .{ .path = b.path("zig/runner_proof_shard_runner.zig"), .mode = .server },
     });
+    const keep_going = b.option(bool, "proof-keep-going", "test-runner-proof-host: a failed shard skips no later one (still serial, still failing)") orelse false;
     const all = b.step("test-runner-proof-host", "Multiply and loop replies on the real frontend and CPU circuit (TF_RUNNER_CIRCUIT)");
     const catalog = b.addRunArtifact(tests);
     catalog.setName("runner proof catalog");
@@ -20,8 +21,14 @@ pub fn steps(b: *std.Build, api_fast: *std.Build.Module) void {
         run.setName(b.fmt("runner proof shard {d}", .{index}));
         run.addArg(b.fmt("--proof-shard-index={d}", .{index}));
         run.has_side_effects = true;
-        run.step.dependOn(previous);
-        previous = &run.step;
+        if (keep_going) {
+            run.addArg("--proof-serial"); // a lock in the cache dir orders the tests instead of the steps
+            run.step.dependOn(&catalog.step);
+            all.dependOn(&run.step);
+        } else {
+            run.step.dependOn(previous);
+            previous = &run.step;
+        }
     }
     all.dependOn(previous);
 }
