Subject: [PATCH 117/207] In-model runner: spec_hold_test's hook takes T5's
 think_end argument

---
 zig/src/families/deepseek_v41/draft/spec_hold_test.zig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/zig/src/families/deepseek_v41/draft/spec_hold_test.zig b/zig/src/families/deepseek_v41/draft/spec_hold_test.zig
index d3ab6a065e1d7d319aa5666bb501dc0aa795fb91..cfc2da7307fb4f552d0b833812c6d8cb25d36fd2 100644
--- a/zig/src/families/deepseek_v41/draft/spec_hold_test.zig
+++ b/zig/src/families/deepseek_v41/draft/spec_hold_test.zig
@@ -14,7 +14,7 @@ const p2 = [_]u32{ 2, 7, 1, 8, 2, 8, 1, 8, 2, 8, 4, 5, 9, 0, 4, 5 };
 /// A runner hook holding its stream at the given emitted indices.
 const Hook = struct {
     seen: usize = 0,
-    fn token(ptr: *anyopaque, _: u32, _: bool, can_hold: bool) bool {
+    fn token(ptr: *anyopaque, _: u32, _: bool, can_hold: bool, _: bool) bool {
         const h: *Hook = @ptrCast(@alignCast(ptr));
         defer h.seen += 1;
         return can_hold and std.mem.indexOfScalar(usize, &fires, h.seen) != null;
