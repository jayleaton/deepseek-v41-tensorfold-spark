diff --git a/packaging/runner/README.md b/packaging/runner/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..90d60cd6f602e73fd3c71d492151433fd5c78e59
--- /dev/null
+++ b/packaging/runner/README.md
@@ -0,0 +1,20 @@
+# Circuit frontend image layer
+
+Build `zig build runner-frontend-check` with the repository's pinned Zig. Then run:
+
+```sh
+packaging/runner/build.sh BASE_IMAGE TAG zig-out/bin/tf-runner-frontend-check
+packaging/runner/check-image.sh TAG
+```
+
+Use a derived serving base that already contains the engine and its lane Python layer. The layer adds Ubuntu 24.04's clang-18 and lld-18, with `/usr/bin/clang` and `/usr/bin/ld.lld` aliases. No cross libc, RISC-V emulator or Python dependency is added for compilation. Host Python is used only to prepare the build context and report image sizes. The builder preserves the base image's entrypoint arguments and CMD; it does not replace engine binaries. Source provenance can be set with `TF_RUNNER_FRONTEND_TREE`; `TF_RUNNER_BUILD_ID` labels task-owned build containers for the shared-node pause guard.
+
+At every container boot, `tf-runner-frontend-check` compiles a tiny freestanding C program through the production frontend and validates its RV32IM+Zba ELF. It never runs that ELF on the host. The Docker build runs the same check with `--require` so an image without a functioning RISC-V toolchain is rejected.
+
+At runtime, a missing or broken compiler/linker reports unavailable and allows ordinary boot when `TF_DSV41_RUNNER` is unset, empty, 0, false, off or no. Any other runner value requires a successful check and fails boot otherwise. `TF_RUNNER_CLANG` and `TF_RUNNER_LLD` override compiler/linker paths for deployment and diagnostics. The production frontend also independently abstains if compilation is unavailable; boot does not turn a missing optional dependency into model output.
+
+Exact decimal/fraction arithmetic is separately gated by `TF_DSV41_RUNNER_EXACT` (default off), through the engine's frontend context. Default Python output remains CPython-identical: unsupported floating, decimal and rational output abstains. Installing the toolchain does not enable either runner knob.
+
+Build on a CPU node at nice 19. On shared nodes, stop the build session and pause its labelled Docker build containers while QUIET exists; stopping only the Docker client does not stop daemon-owned build work. No GPU access is needed. `check-image.sh` uses the runc runtime, no network and no GPU mounts, and checks normal/required boot, missing clang/LLD, successful compiler without ELF, and argument preservation. It never launches the engine.
+
+The builder emits a JSON receipt with tag, immutable image/base IDs, sizes and size delta reported by `docker image inspect .Size`. Docker storage backends may report additional unpacked disk usage in `docker image ls`; record that separately when budgeting local storage. The base engine revision label is inherited; the frontend source tree is recorded separately.
diff --git a/packaging/runner/build.sh b/packaging/runner/build.sh
new file mode 100755
index 0000000000000000000000000000000000000000..da3f8b340d2f7c400d1f774e5754791f8bc990f2
--- /dev/null
+++ b/packaging/runner/build.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+set -euo pipefail
+if [[ $# != 3 ]]; then echo 'usage: build.sh BASE_IMAGE TAG BOOT_CHECK_BINARY' >&2; exit 2; fi
+base=$1 tag=$2 binary=$3
+here=$(cd -- "$(dirname -- "$0")" && pwd)
+context=$(mktemp -d -t tf-runner-image.XXXXXXXX)
+cleanup() { find "$context" -maxdepth 1 -type f -delete; rmdir "$context"; }
+trap cleanup EXIT
+cp "$here/Dockerfile" "$context/Dockerfile"
+cp "$binary" "$context/tf-runner-frontend-check"
+chmod 755 "$context/tf-runner-frontend-check"
+docker image inspect "$base" > "$context/base.json"
+base_id=$(docker image inspect -f '{{.Id}}' "$base")
+python3 - "$context" <<'PY'
+import json, pathlib, shlex, sys
+root=pathlib.Path(sys.argv[1])
+config=json.loads((root/'base.json').read_text())[0]['Config']
+entry=config.get('Entrypoint') or []
+if '/opt/tensorfold/bin/runner-entrypoint' in entry:
+    raise SystemExit('base already contains runner-entrypoint; use the original serving base')
+script='#!/bin/sh\nset -eu\n/opt/tensorfold/bin/tf-runner-frontend-check\nexec '
+script+=' '.join(shlex.quote(arg) for arg in entry)
+script+=' "$@"\n'
+(root/'runner-entrypoint').write_text(script)
+(root/'runner-entrypoint').chmod(0o755)
+with (root/'Dockerfile').open('a') as f:
+    f.write('CMD '+json.dumps(config.get('Cmd') or [])+'\n')
+PY
+DOCKER_BUILDKIT=0 nice -n 19 ionice -c3 docker build \
+    --build-arg "BASE_IMAGE=$base_id" \
+    --build-arg "FRONTEND_TREE=${TF_RUNNER_FRONTEND_TREE:-unknown}" \
+    --build-arg "RUNNER_BUILD_ID=${TF_RUNNER_BUILD_ID:-runner-frontend}" \
+    -t "$tag" "$context" >&2
+docker image inspect "$tag" > "$context/derived.json"
+python3 - "$context" "$tag" <<'PY'
+import json, pathlib, sys
+root=pathlib.Path(sys.argv[1])
+base=json.loads((root/'base.json').read_text())[0]
+image=json.loads((root/'derived.json').read_text())[0]
+assert (image['Config'].get('Cmd') or []) == (base['Config'].get('Cmd') or [])
+assert image['RootFS']['Layers'][:len(base['RootFS']['Layers'])] == base['RootFS']['Layers']
+print(json.dumps({'size_metric':'docker image inspect .Size','tag':sys.argv[2],'image_id':image['Id'],'base_id':base['Id'],
+ 'base_bytes':base['Size'],'image_bytes':image['Size'],'delta_bytes':image['Size']-base['Size'],
+ 'frontend_tree':image['Config']['Labels']['org.tensorfold.runner.frontend.tree']},sort_keys=True))
+PY
diff --git a/packaging/runner/check-image.sh b/packaging/runner/check-image.sh
new file mode 100755
index 0000000000000000000000000000000000000000..097cdfcc821d55aecf3fea6218a6dc922e20ac79
--- /dev/null
+++ b/packaging/runner/check-image.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+set -euo pipefail
+if [[ $# != 1 ]]; then echo 'usage: check-image.sh TAG' >&2; exit 2; fi
+tag=$1
+run() { docker run --rm --runtime=runc --network none -e NVIDIA_VISIBLE_DEVICES=void -e CUDA_VISIBLE_DEVICES= "$@"; }
+run "$tag" /bin/true
+run -e TF_DSV41_RUNNER=1 "$tag" /bin/true
+for dependency in TF_RUNNER_CLANG TF_RUNNER_LLD; do
+ run -e "$dependency=/nonexistent-runner-tool" -e TF_DSV41_RUNNER=0 "$tag" /bin/true
+ rc=0
+ run -e "$dependency=/nonexistent-runner-tool" -e TF_DSV41_RUNNER=1 "$tag" /bin/true || rc=$?
+ [[ $rc != 0 ]] || { echo "FAIL: missing $dependency did not fail closed" >&2; exit 1; }
+done
+rc=0
+run -e TF_RUNNER_CLANG=/bin/true -e TF_DSV41_RUNNER=1 "$tag" /bin/true || rc=$?
+[[ $rc != 0 ]] || { echo 'FAIL: compiler success without an ELF was accepted' >&2; exit 1; }
+run "$tag" /bin/sh -c 'test "$1" = "hello world"' sh 'hello world'
+echo 'RUNNER_IMAGE_CHECK: compile/ELF validation, optional fallback, required failure, and argv preservation PASS'
