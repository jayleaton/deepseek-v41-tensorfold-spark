+    /// TF_DSV41_RUNNER_STATED's line shapes: `L = R.` with L over names and literally R, or a hex literal's value.
+    fn wholeShape(t: *Tracer, clean: []const u8) Allocator.Error!?struct { found: Found, end: usize } {
