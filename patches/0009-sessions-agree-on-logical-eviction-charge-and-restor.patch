diff --git a/zig/src/families/deepseek_v41/session_protocol.zig b/zig/src/families/deepseek_v41/session_protocol.zig
new file mode 100644
index 0000000000000000000000000000000000000000..c144b94864632d55fd8a9a0b8ebd9f99e11898aa
--- /dev/null
+++ b/zig/src/families/deepseek_v41/session_protocol.zig
@@ -0,0 +1,93 @@
+//! Host control-channel preflight: every rank accepts the same session protocol before model boot plans.
+const std = @import("std");
+const tp = @import("tp");
+
+pub const identity = [2]i64{ 0x4453563431534553, 2 };
+const timeout_ns = 5 * std.time.ns_per_s;
+
+pub fn preflight(plan: *tp.planlink.PlanLink) !void {
+    try agree(plan, identity);
+}
+
+fn send(plan: *tp.planlink.PlanLink, peer: usize, words: []const i64, deadline: u64) !void {
+    try tp.sock.sendBefore(plan.fds[peer], std.mem.sliceAsBytes(words), deadline);
+}
+
+fn recv(plan: *tp.planlink.PlanLink, peer: usize, words: []i64, deadline: u64) !void {
+    try tp.sock.recvExact(plan.fds[peer], std.mem.sliceAsBytes(words), deadline);
+}
+
+fn agree(plan: *tp.planlink.PlanLink, mine: [2]i64) !void {
+    if (plan.world == 0 or plan.rank >= plan.world or plan.world > tp.planlink.max_ranks)
+        return error.BadSessionProtocolRank;
+    if (plan.world == 1) return;
+    const deadline = tp.sock.nowNs() + timeout_ns;
+    var peer: [2]i64 = undefined;
+    if (plan.rank == 0) {
+        var ok = true;
+        for (1..plan.world) |rank| {
+            try send(plan, rank, &mine, deadline);
+            try recv(plan, rank, &peer, deadline);
+            ok = ok and std.mem.eql(i64, &mine, &peer);
+        }
+        const verdict = [_]i64{@intFromBool(ok)};
+        for (1..plan.world) |rank| try send(plan, rank, &verdict, deadline);
+        if (!ok) return error.SessionProtocolMismatch;
+    } else {
+        try recv(plan, 0, &peer, deadline);
+        try send(plan, 0, &mine, deadline);
+        var verdict: [1]i64 = undefined;
+        try recv(plan, 0, &verdict, deadline);
+        if (verdict[0] != 1 or !std.mem.eql(i64, &mine, &peer)) return error.SessionProtocolMismatch;
+    }
+}
+
+fn run(plan: *tp.planlink.PlanLink, mine: [2]i64, result: *?anyerror) void {
+    agree(plan, mine) catch |err| {
+        result.* = err;
+    };
+}
+
+test "session protocol: real host plan sockets accept identical ranks and both refuse either changed identity" {
+    const t = std.testing;
+    for (0..3) |scenario| {
+        const listener = try tp.bootstrap.testListener();
+        defer tp.sock.close(listener.fd);
+        const deadline = tp.sock.nowNs() + timeout_ns;
+        const follower_fd = try tp.sock.connect("localhost", listener.port, deadline);
+        const root_fd = try tp.sock.accept(listener.fd, deadline);
+        var root_fds: [tp.planlink.max_ranks]tp.sock.Fd = @splat(-1);
+        var follower_fds = root_fds;
+        root_fds[1] = root_fd;
+        follower_fds[0] = follower_fd;
+        var root = tp.planlink.PlanLink.init(0, 2, root_fds);
+        defer root.close();
+        var follower = tp.planlink.PlanLink.init(1, 2, follower_fds);
+        defer follower.close();
+        var root_identity = identity;
+        var follower_identity = identity;
+        if (scenario == 1) root_identity[1] += 1;
+        if (scenario == 2) follower_identity[0] ^= 1;
+        var result: [2]?anyerror = .{ null, null };
+        const thread = try std.Thread.spawn(.{}, run, .{ &follower, follower_identity, &result[1] });
+        run(&root, root_identity, &result[0]);
+        thread.join();
+        const expected: ?anyerror = if (scenario == 0) null else error.SessionProtocolMismatch;
+        for (result) |err| try t.expectEqual(expected, err);
+        if (scenario == 0) {
+            try root.send(&.{99});
+            var next: [1]i64 = undefined;
+            try t.expectEqualSlices(i64, &.{99}, try follower.recv(&next));
+        }
+    }
+}
+
+test "session protocol: solo uses no sockets and invalid ranks fail before control I/O" {
+    var plan = tp.planlink.PlanLink.init(0, 1, @splat(-1));
+    try preflight(&plan);
+    plan.world = 0;
+    try std.testing.expectError(error.BadSessionProtocolRank, preflight(&plan));
+    plan.world = 2;
+    plan.rank = 2;
+    try std.testing.expectError(error.BadSessionProtocolRank, preflight(&plan));
+}
diff --git a/zig/src/families/deepseek_v41/session_restore_test.zig b/zig/src/families/deepseek_v41/session_restore_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..87ede0b0aaedea7544c7d5a592be0ee537668768
--- /dev/null
+++ b/zig/src/families/deepseek_v41/session_restore_test.zig
@@ -0,0 +1,80 @@
+//! Real prefix identities and lockstep votes: a wrong RAM entry becomes a miss on both ranks.
+const std = @import("std");
+const sessions = @import("kv").sessions;
+const lockstep = @import("lockstep.zig");
+const Index = sessions.prefix.Index(u64);
+const Want = sessions.restore.Want;
+const t = std.testing;
+
+const Pair = struct {
+    votes: [2]std.atomic.Value(u8) = .{ .init(0), .init(0) },
+    ranks: [2]Rank = undefined,
+
+    const Rank = struct {
+        pair: *Pair,
+        me: usize,
+        index: *Index,
+        id: u32,
+        want: Want,
+        accepted: bool = true,
+        err: ?anyerror = null,
+    };
+
+    fn all(ptr: *anyopaque, ok: bool) !bool {
+        const r: *Rank = @ptrCast(@alignCast(ptr));
+        r.pair.votes[r.me].store(if (ok) 1 else 2, .release);
+        var spins: usize = 0;
+        while (r.pair.votes[1 - r.me].load(.acquire) == 0) : (spins += 1) {
+            if (spins > 1 << 30) return error.Timeout;
+            std.atomic.spinLoopHint();
+        }
+        return ok and r.pair.votes[1 - r.me].load(.acquire) == 1;
+    }
+
+    fn run(r: *Rank) void {
+        r.accepted = lockstep.agreed(.{ .ctx = r, .all = all }, r.want.check(r.index, r.id), "restore identity", @intCast(r.me)) catch |err| {
+            r.err = err;
+            return;
+        };
+    }
+};
+
+test "restore identity: wrong same-id RAM key position and missing id agree a miss on both ranks" {
+    var indexes = [_]Index{ Index.init(t.allocator, 4), Index.init(t.allocator, 4) };
+    defer for (&indexes) |*x| x.deinit();
+    const ids = [_]i32{ 1, 2, 3, 4, 5, 6, 7, 8 };
+    var digests: [2]sessions.prefix.Digest = undefined;
+    sessions.prefix.chain(1, &ids, 4, &digests);
+    const leader = (try indexes[0].insert(1, &ids, &digests, true, 0)).id;
+    const follower = (try indexes[1].insert(1, &ids, &digests, true, 0)).id;
+    try t.expectEqual(leader, follower);
+    const entry = indexes[0].get(leader);
+    const want: Want = .{ .pos = entry.pos, .key = entry.key };
+    for (0..4) |scenario| {
+        const local = indexes[1].get(follower);
+        local.key = want.key;
+        local.pos = want.pos;
+        if (scenario == 0) local.key[0] ^= 1;
+        if (scenario == 1) local.pos += 1;
+        var pair: Pair = .{};
+        for (&pair.ranks, 0..) |*r, me| r.* = .{
+            .pair = &pair,
+            .me = me,
+            .index = &indexes[me],
+            .id = if (scenario == 2 and me == 1) follower + 1000 else leader,
+            .want = want,
+        };
+        const a = try std.Thread.spawn(.{}, Pair.run, .{&pair.ranks[0]});
+        const b = try std.Thread.spawn(.{}, Pair.run, .{&pair.ranks[1]});
+        a.join();
+        b.join();
+        for (pair.ranks) |r| {
+            try t.expectEqual(@as(?anyerror, null), r.err);
+            try t.expectEqual(scenario == 3, r.accepted);
+        }
+    }
+}
+
+test {
+    _ = @import("session_protocol.zig");
+}
