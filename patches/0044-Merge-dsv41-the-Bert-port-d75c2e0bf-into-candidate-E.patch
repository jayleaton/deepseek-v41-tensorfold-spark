+    Fake.pairs = &.{.{ "TF_DSV41_IDX_IOTA", "0" }};
+    try testing.expect(!try pk.idxIota(&Fake.get));
+    Fake.pairs = &.{.{ "TF_DSV41_IDX_IOTA", " 1 " }};
+    try testing.expect(try pk.idxIota(&Fake.get));
+    for ([_][]const u8{ "2", "on", "true", "yes", "-1" }) |v| {
+        Fake.pairs = &.{.{ "TF_DSV41_IDX_IOTA", v }};
