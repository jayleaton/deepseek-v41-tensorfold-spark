 .../deepseek_v41/forward_prefill_k4.zig       |  10 ++
 .../families/deepseek_v41/index_scratch.zig   |  43 ++++++
 .../deepseek_v41/index_scratch_test.zig       | 139 ++++++++++++++++++
 zig/src/families/deepseek_v41/pf4k_test.zig   |   4 +
 5 files changed, 197 insertions(+)
 create mode 100644 zig/src/families/deepseek_v41/index_scratch.zig
 create mode 100644 zig/src/families/deepseek_v41/index_scratch_test.zig

