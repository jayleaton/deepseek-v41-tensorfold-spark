+    defer env.deinit();
+    const front = f.frontend();
+    const cases = [_][2][]const u8{
+        .{ "(5*(0.125-0))", "0.625\n" },
+        .{ "0-0.125", "-0.125\n" },
+        .{ "(0.125+0)-0.25", "-0.125\n" },
+        .{ "11/18", "11/18\n" },
+        .{ "1/2", "1/2\n" },
