Subject: [PATCH 015/207] deepseek: supervise blocked KV union synchronization

Address tanchunsiong's issue #64 recovery contract through an owned KV union progress scope. Exercise the actual union/glue synchronization path with a host-only blocked driver call and verify independent failure notification and unchanged tables. Distributed kernel and transport causes still require pair traces.
---
 zig/src/families/deepseek_v41/cuda_kv.zig     |  2 +
 .../deepseek_v41/device_host_test.zig         |  4 ++
 .../deepseek_v41/union_stall_test.zig         | 62 +++++++++++++++++++
 3 files changed, 68 insertions(+)
 create mode 100644 zig/src/families/deepseek_v41/union_stall_test.zig

diff --git a/zig/src/families/deepseek_v41/cuda_kv.zig b/zig/src/families/deepseek_v41/cuda_kv.zig
index 3711ca626f32755d952fb16bab908656aaaedc40..c199adbb3725b61a0c2c901ce9576fb098137654 100644
--- a/zig/src/families/deepseek_v41/cuda_kv.zig
+++ b/zig/src/families/deepseek_v41/cuda_kv.zig
@@ -308,6 +308,8 @@ pub const Kv = struct {
 
     /// A prefill segment's union: sorted unique selected rows, padded per owner (one host sync), token owner x M + i.
     fn unionOf(k: *Kv, r: *run.Runner, c: *const calls.Call) !void {
+        var activity: @import("round_progress.zig").Progress.Scope = if (r.progress) |progress| progress.begin(.kv_union) else .{ .owner = null };
+        defer activity.end();
         const a = try args(r, c);
         const n: usize = @intCast(a.sel.shape[0]);
         const kk: u32 = @intCast(a.sel.shape[1]);
