From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Tue, 3 Nov 2026 10:01:23 +0700
Subject: [PATCH 165/207] runner tests: runner_trace_value's tests run from
 runner_trace_test.zig, keeping runner.zig at 600 lines

---
 zig/src/core/runner.zig            | 1 -
 zig/src/core/runner_trace_test.zig | 4 ++++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/zig/src/core/runner.zig b/zig/src/core/runner.zig
index af87ea3719f88f7dc3cb0506af5cef2f868160b4..bcf9a97bbc90697bf880347b6a09d61674cc2be0 100644
--- a/zig/src/core/runner.zig
+++ b/zig/src/core/runner.zig
@@ -597,5 +597,4 @@ test {
     _ = @import("runner_trace_divmod_test.zig");
     _ = @import("runner_trace_named_test.zig");
     _ = @import("runner_graph_edit.zig");
-    _ = @import("runner_trace_value.zig");
 }
diff --git a/zig/src/core/runner_trace_test.zig b/zig/src/core/runner_trace_test.zig
index 61d78a3f4a1bccdee064aa3199a1bc7534785a31..1172cbbc348b8a2834a54fda4845dd6e0c4b7a9c 100644
--- a/zig/src/core/runner_trace_test.zig
+++ b/zig/src/core/runner_trace_test.zig
@@ -484,3 +484,7 @@ test "runner trace: the reply's runtime block counts a trace cell under trace, n
     try std.testing.expect(std.mem.indexOf(u8, sums[0], "\"repl\":{\"closed\":0,\"owned\":0,") != null);
     try std.testing.expect(std.mem.indexOf(u8, sums[0], "\"trace\":{\"closed\":1,\"owned\":1,\"abstained\":0,") != null);
 }
+
+test {
+    _ = @import("runner_trace_value.zig");
+}
