From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Thu, 29 Oct 2026 12:12:16 +0700
Subject: [PATCH 027/207] server: serve DeepSeek-V4.x with its reference
 sampling defaults

Requests that omit sampling fields decoded greedily on DeepSeek-V4.x,
whose releases ship no generation_config.json. The published engine
served its reference defaults, temperature 1.0, top_k 20 and top_p 0.95,
so a request sending only temperature 0.7 also sampled with top_k 20.
Apply them under generation_config.json and the serve flags, as before.

Host test covers both DeepSeek-V4.x model types and leaves other
families without defaults.
---
 zig/src/server/family_sampling.zig | 27 +++++++++++++++++++++++++++
 zig/src/server/main.zig            |  7 ++++---
 zig/src/server/root.zig            |  1 +
 3 files changed, 32 insertions(+), 3 deletions(-)
 create mode 100644 zig/src/server/family_sampling.zig

diff --git a/zig/src/server/family_sampling.zig b/zig/src/server/family_sampling.zig
new file mode 100644
index 0000000000000000000000000000000000000000..c38407739700e82254e3e6ae7a2d1c1d869c7445
--- /dev/null
+++ b/zig/src/server/family_sampling.zig
@@ -0,0 +1,27 @@
+//! A family's own default sampling, under generation_config.json and the serve flags.
+const std = @import("std");
+const json = @import("json");
+
+/// DeepSeek-V4.x: its reference server's temperature 1.0, top_k 20 and top_p 0.95 (no generation_config).
+pub fn put(a: std.mem.Allocator, out: *json.Object, model_type: []const u8) !void {
+    if (!std.mem.eql(u8, model_type, "deepseek_v41") and !std.mem.eql(u8, model_type, "deepseek_v4")) return;
+    try out.put(a, "temperature", .{ .float = 1.0 });
+    try out.put(a, "top_k", try json.intValue(a, 20));
+    try out.put(a, "top_p", .{ .float = 0.95 });
+}
+
+test "DeepSeek-V4.x serves its reference sampling defaults; other families keep none" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_][]const u8{ "deepseek_v41", "deepseek_v4" }) |kind| {
+        const out = try json.newObject(a);
+        try put(a, out, kind);
+        try std.testing.expectEqual(@as(f64, 1.0), out.get("temperature").?.float);
+        try std.testing.expectEqual(@as(?i64, 20), out.get("top_k").?.int64());
+        try std.testing.expectEqual(@as(f64, 0.95), out.get("top_p").?.float);
+    }
+    const other = try json.newObject(a);
+    try put(a, other, "glm5_next");
+    try std.testing.expectEqual(@as(usize, 0), other.count());
+}
