+    tokens: u32 = 0, // tokens fed
+    float_at: ?u32 = null, // the token of the last float cue or closed code cell
+    tail: [16]u8 = undefined, // the last bytes fed, for cues split across tokens
+    tail_len: usize = 0,
 
