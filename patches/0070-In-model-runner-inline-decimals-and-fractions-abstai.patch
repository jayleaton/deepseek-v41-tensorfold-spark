         s.line.deinit(a);
@@ -42,11 +50,13 @@ pub const Scanner = struct {
     pub fn feed(s: *Scanner, a: Allocator, bytes: []const u8, think_open: bool) Allocator.Error!Events {
         var ev: Events = .{};
         s.armed = null;
+        s.tokens +|= 1;
