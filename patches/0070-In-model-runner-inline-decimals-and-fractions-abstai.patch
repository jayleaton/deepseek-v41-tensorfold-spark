diff --git a/zig/src/core/runner_scan.zig b/zig/src/core/runner_scan.zig
index a36e2d62fe7d5401c89109e17f6865a19bc4eeab..572b85fc96ea3502d9ef78773fa16c13ebef413b 100644
--- a/zig/src/core/runner_scan.zig
+++ b/zig/src/core/runner_scan.zig
@@ -9,10 +9,14 @@ pub const Config = struct {
     lookahead: u32 = 64, // tokens after a closed fence in which a result header counts
     reasoning_only: bool = false, // triggers only while the think block is open
