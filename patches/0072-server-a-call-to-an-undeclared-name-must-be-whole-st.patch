 /// One spelling's tags: every one ``<｜DSML｜``, its separator, then its name.
 pub const Spelling = struct {
diff --git a/zig/src/server/tool_parse.zig b/zig/src/server/tool_parse.zig
index 58f396f8a9a22216dfd9d9b438d899d42ea8f243..a5ff8b14b6ad11f7a5c6c27778a572e43ce86c4f 100644
--- a/zig/src/server/tool_parse.zig
+++ b/zig/src/server/tool_parse.zig
@@ -213,12 +213,12 @@ fn argumentsClose(a: Allocator, body: []const u8) Allocator.Error![]const u8 {
     return closed[body.len..];
 }
 
-/// The offered tool's spelling; else, as vLLM, an undeclared function name with finite object arguments; else null.
+/// The offered spelling; else, as vLLM, an undeclared function name of a whole call with finite object arguments.
 fn callName(a: Allocator, c: Call, known: *const std.StringArrayHashMapUnmanaged([]const u8)) Allocator.Error!?[]const u8 {
     const name = strip(c.name);
     if (known.get(try std.ascii.allocLowerString(a, name))) |offered| return offered;
     // the client refuses the unknown tool and the model can retry; kept as text, the call ended the client's turn
-    return if (functionName(name) and c.arguments == .object and tool_params.finite(c.arguments)) name else null;
+    return if (c.whole and functionName(name) and c.arguments == .object and tool_params.finite(c.arguments)) name else null;
 }
 
 /// 1 to 64 of ``[A-Za-z0-9_-]``: a name OpenAI's API accepts for a function.
@@ -369,14 +369,15 @@ fn functionBlock(a: Allocator, block: []const u8, schemas: ?*const tool_params.S
     } else return null;
     const body = strip(block[body_start..close]);
     const params = try parameterBlocks(a, body);
-    if (complete and !allSpace(params.residue)) return null;
+    const whole = allSpace(params.residue);
+    if (complete and !whole) return null;
     const arguments = try json.newObject(a);
     for (params.items) |p| {
         const key = strip(p.key);
         const schema: tool_params.Schema = if (schemas) |s| try tool_params.schemaOf(s, name, key, a) else try tool_params.emptySchema(a);
         try arguments.put(a, key, try tool_params.decode(a, p.value, schema, true));
     }
-    return .{ .name = name, .arguments = .{ .object = arguments } };
+    return .{ .name = name, .arguments = .{ .object = arguments }, .whole = whole };
 }
 
 const Param = struct { key: []const u8, value: []const u8 };
@@ -475,14 +476,15 @@ fn glmCall(a: Allocator, written: []const u8, schemas: ?*const tool_params.Schem
         pos = kept;
     }
     try residue.appendSlice(a, rest[kept..]);
-    if (complete and !allSpace(residue.items)) return null;
+    const whole = allSpace(residue.items);
+    if (complete and !whole) return null;
     const arguments = try json.newObject(a);
     for (pairs.items) |p| {
         const key = strip(p.key);
         const schema: tool_params.Schema = if (schemas) |s| try tool_params.schemaOf(s, name, key, a) else try tool_params.emptySchema(a);
         try arguments.put(a, key, try tool_params.decode(a, p.value, schema, false));
     }
-    return .{ .name = name, .arguments = .{ .object = arguments } };
+    return .{ .name = name, .arguments = .{ .object = arguments }, .whole = whole };
 }
 
 /// The first ``</arg_key>`` at or after `from` that an ``<arg_value>`` follows, and where that value starts.
diff --git a/zig/src/server/tool_parse_test.zig b/zig/src/server/tool_parse_test.zig
index 9cb1e28d3e06e11dc26d185c26893d309a53e099..b4e0d32ba8d9298d83594e5f76aa6ed4c2c2fd53 100644
--- a/zig/src/server/tool_parse_test.zig
+++ b/zig/src/server/tool_parse_test.zig
@@ -505,6 +505,8 @@ test "GLM pairs from the cached key and value ends are the pairs each key's own
         const block = try repairGlmKeys(a, std.mem.trim(u8, body.items, " \n"));
         const cut = std.mem.indexOf(u8, block, "<arg_key>") orelse block.len;
         if (std.mem.indexOfScalar(u8, block[0..cut], '<') != null) continue; // no name: both stay text
+        // an undeclared name (`lookupk`): its stray text keeps it as text, which the visibility tests check
+        if (!std.mem.eql(u8, std.mem.trim(u8, block[0..cut], " \t\r\n"), "lookup")) continue;
         const rest = block[cut..];
         var canon: std.ArrayList(u8) = .empty; // the reference's pairs written plainly, nothing between them
         try canon.appendSlice(a, "<tool_call>");
diff --git a/zig/src/server/tool_parse_visibility_test.zig b/zig/src/server/tool_parse_visibility_test.zig
index e519c19257baad52edaa95087de426adf933511b..f29d62fc5fd72a5e7948d0aa55d1949e802cc1a9 100644
--- a/zig/src/server/tool_parse_visibility_test.zig
+++ b/zig/src/server/tool_parse_visibility_test.zig
@@ -106,3 +106,44 @@ test "a call whose undeclared name is no function name, or whose arguments are n
     try std.testing.expectEqualStrings("lookup", offered.calls.?[0].get("function").?.get("name").?.string);
     try std.testing.expect((try parse(a, "{\"name\":\"launch\",\"arguments\":{}}", tools, null)).calls == null);
 }
+
+/// Calls to `bash` (undeclared: only `shell` is offered) whose markup holds stray text; each stays the reply's text.
+pub const malformed_undeclared = [_][]const u8{
+    "<tool_call><function=bash>junk</function></tool_call>",
+    "<tool_call><function=bash><parameter=command>ls</parameter>junk</function></tool_call>",
+    "<tool_call><function=bash>junk<parameter=command>ls</parameter></function></tool_call>",
+    "<tool_call><function=bash><parameter=command>ls</function></tool_call>",
+    "<tool_call>bash<arg_key>command</arg_key><arg_value>ls</arg_value>junk</tool_call>",
+    "<tool_call>bash<arg_key>command</arg_key><arg_value>ls</arg_value><arg_key>cwd</arg_key></tool_call>",
+};
+
+/// Near misses: whole calls to `bash` whose only extra bytes are whitespace; each is a call, with these arguments.
+pub const whole_undeclared = [_][2][]const u8{
+    .{ "<tool_call>\n<function=bash>\n<parameter=command>\nls\n</parameter>\n</function>\n</tool_call>", "{\"command\":\"ls\"}" },
+    .{ "<tool_call><function=bash> \n </function></tool_call>", "{}" },
+    .{ "<tool_call>bash\n<arg_key>command</arg_key>\n<arg_value>ls</arg_value>\n</tool_call>", "{\"command\":\"ls\"}" },
+};
+
+test "a call to an undeclared name whose XML or GLM markup holds stray text stays text in both call modes" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const tools = (try json.parse(a, "[{\"type\":\"function\",\"function\":{\"name\":\"shell\"}}]")).ok.array;
+    for (malformed_undeclared) |text| for ([_]?usize{ null, 1 }) |max_calls| {
+        const r = try parse(a, text, tools, max_calls);
+        try std.testing.expect(r.calls == null);
+        try std.testing.expectEqualStrings(text, r.content);
+        try std.testing.expectEqual(@as(usize, 1), r.rejected_envelopes);
+    };
+    for (whole_undeclared) |c| for ([_]?usize{ null, 1 }) |max_calls| {
+        const r = try parse(a, c[0], tools, max_calls);
+        try std.testing.expectEqualStrings("bash", r.calls.?[0].get("function").?.get("name").?.string);
+        try std.testing.expectEqualStrings(c[1], r.calls.?[0].get("function").?.get("arguments").?.string);
+        try std.testing.expectEqualStrings("", r.content);
+    };
+    // a declared call keeps the parallel parse's leniency (stray text dropped), and single-call mode still rejects it
+    for ([_][]const u8{ "<tool_call><function=shell>junk</function></tool_call>", "<tool_call>shell<arg_key>c</arg_key><arg_value>ls</arg_value>junk</tool_call>" }) |text| {
+        try std.testing.expectEqualStrings("shell", (try parse(a, text, tools, null)).calls.?[0].get("function").?.get("name").?.string);
+        try std.testing.expect((try parse(a, text, tools, 1)).calls == null);
+    }
+}
