From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Thu, 12 Nov 2026 06:28:32 +0700
Subject: [PATCH 205/207] deepseek_v41: checkpoint spacings below the snapshot
 minimum start at their first multiple past it

TF_DSV41_SESSION_LCP_EVERY accepts any multiple of 16, but the planner's next checkpoint was the first multiple of
the spacing past the resumed position. For 16, 32 or 48 that is below session_min (64) on a cold prompt, so the
planner went straight to the replay point and made no checkpoints at all: a rewrite at token 300 of a 1,000-token
prompt resumed from 0 (review of jayleaton/deepseek-v41-tensorfold-spark#89).

The next checkpoint is now the first multiple of the spacing at or past both the next token and session_min. Every
spacing that is a multiple of 64, the default 32768 included, plans the same snapshots as before.

Test (test-dsv41-kv): spacings 16, 32 and 48 on a cold 1,000-token prompt snapshot at every multiple from the first
one at or past 64 up to the replay point (992); before the fix the only snapshot is 992.
---
 zig/src/families/deepseek_v41/kv/lcp_test.zig | 26 +++++++++++++++++++
 zig/src/families/deepseek_v41/kv/sched.zig    |  4 +--
 2 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/zig/src/families/deepseek_v41/kv/lcp_test.zig b/zig/src/families/deepseek_v41/kv/lcp_test.zig
index 6c116f18ad780db14c1e25b89796eac94799596a..b2fda46fab7cc1c3d2538a243376d71cdcebf24d 100644
--- a/zig/src/families/deepseek_v41/kv/lcp_test.zig
+++ b/zig/src/families/deepseek_v41/kv/lcp_test.zig
@@ -93,6 +93,32 @@ test "LCP resume: the planner snapshots at each checkpoint, then at the replay p
     }
 }
 
+test "LCP resume: spacings below the snapshot minimum start at their first multiple at or past it" {
+    for ([_]u64{ 16, 32, 48 }) |every| {
+        var p = sched.Planner.init(t.allocator, .{ .rows = 128, .sessions = true, .lcp_every = every });
+        defer p.deinit();
+        var round = p.beginAdmit();
+        defer round.deinit(t.allocator);
+        _ = try p.admit(&round, .{ .key = 1, .n = 1000, .max_new = 8, .submitted = 0 }, null, 0, null);
+        var pieces: std.ArrayList(sched.Piece) = .empty;
+        defer pieces.deinit(t.allocator);
+        var finals: std.ArrayList(usize) = .empty;
+        defer finals.deinit(t.allocator);
+        var saves: std.ArrayList(u64) = .empty;
+        defer saves.deinit(t.allocator);
+        while (finals.items.len == 0) {
+            try p.plan(null, &pieces, &finals);
+            for (pieces.items) |pc| if (pc.save) try saves.append(t.allocator, pc.end);
+        }
+        var want: std.ArrayList(u64) = .empty;
+        defer want.deinit(t.allocator);
+        var c = (p.s.session_min + every - 1) / every * every;
+        while (c < 992) : (c += every) try want.append(t.allocator, c);
+        try want.append(t.allocator, 992);
+        try t.expectEqualSlices(u64, want.items, saves.items);
+    }
+}
+
 fn findStore(st: *sessions.Store, prompt: []const u32) !?sessions.store.Hit {
     var ids: [1024]i32 = undefined;
     for (ids[0..prompt.len], prompt) |*d, x| d.* = @intCast(x);
diff --git a/zig/src/families/deepseek_v41/kv/sched.zig b/zig/src/families/deepseek_v41/kv/sched.zig
index 1084afdccd308e2d9ba6f535475cb57b3fe7b060..8748d766943b0b34e2c8249753fb04aa0560c7e7 100644
--- a/zig/src/families/deepseek_v41/kv/sched.zig
+++ b/zig/src/families/deepseek_v41/kv/sched.zig
@@ -416,11 +416,11 @@ pub const Planner = struct {
         return .{ .admit = .{ .need = pp.need, .hit = hit } };
     }
 
-    /// The next snapshot past `from`: a checkpoint (a multiple of lcp_every) before the replay point, else that point.
+    /// The next snapshot past `from`: a checkpoint (an lcp_every multiple >= session_min) before replay, else replay.
     fn savePoint(p: *const Planner, n: u64, from: u64) ?u64 {
         if (!p.s.sessions) return null;
         const s = snapshotPoint(n);
-        const c = if (p.s.lcp_every > 0) (from / p.s.lcp_every + 1) * p.s.lcp_every else s;
+        const c = if (p.s.lcp_every > 0) (@max(from, p.s.session_min - 1) / p.s.lcp_every + 1) * p.s.lcp_every else s;
         return if (c < s and c >= p.s.session_min) c else if (s > from and s >= p.s.session_min) s else null;
     }
 
