diff --git a/zig/src/families/deepseek_v41/pool_growth.zig b/zig/src/families/deepseek_v41/pool_growth.zig
new file mode 100644
index 0000000000000000000000000000000000000000..cfb3db68aa9f6b41ebe6efbc769b467ceec8a63d
--- /dev/null
+++ b/zig/src/families/deepseek_v41/pool_growth.zig
@@ -0,0 +1,49 @@
+//! A pre-launch pool transaction: every rank maps its rows or every rank restores the previous page ownership.
+
+const sessions = @import("kv").sessions;
+const lockstep = @import("lockstep.zig");
+
+pub const Need = struct { slot: *sessions.Slot, end: u64 };
+
+/// No device table or model state is changed here; failed agreement retains ownership for fatal teardown.
+pub fn reserve(agree: ?lockstep.Agree, needs: []const Need) !void {
+    if (needs.len > 16) return error.Slots;
+    var before: [16]u64 = undefined;
+    var over: [16]u32 = undefined;
+    var quota: [16]?u32 = undefined;
+    var origin: [16]@TypeOf(@as(sessions.Slot, undefined).origin) = undefined;
+    for (needs, 0..) |n, i| {
+        if (n.end > @as(u64, n.slot.max_pages) * n.slot.pool.page) return error.PastCapacity;
+        before[i] = n.slot.tokens();
+        over[i] = n.slot.over;
+        quota[i] = n.slot.quota;
+        origin[i] = n.slot.origin;
+        for (needs[0..i]) |prior| if (prior.slot == n.slot) return error.Slots;
+    }
+    var ok = true;
+    for (needs) |n| {
+        // Unadmitted callers may grow only into pages that no live request reserved.
+        if (n.slot.quota == null) n.slot.reserve(n.slot.len);
+        n.slot.ensure(n.end) catch |err| switch (err) {
+            error.PoolExhausted => {
+                ok = false;
+                break;
+            },
+            else => return err,
+        };
+    }
+    if (agree) |a| ok = try a.all(a.ctx, ok);
+    if (!ok) {
+        for (needs, 0..) |n, i| {
+            _ = try n.slot.truncate(before[i]);
+            n.slot.reserve(quota[i]);
+            n.slot.over = over[i];
+            n.slot.origin = origin[i];
+        }
+        return error.PoolExhausted;
+    }
+    for (needs, 0..) |n, i| if (quota[i] == null) {
+        n.slot.reserve(null);
+        n.slot.over = over[i];
+    };
+}
diff --git a/zig/src/families/deepseek_v41/pool_growth_test.zig b/zig/src/families/deepseek_v41/pool_growth_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..41837c1ee0d493d39fa9e7dcd7343f1351fe9596
--- /dev/null
+++ b/zig/src/families/deepseek_v41/pool_growth_test.zig
@@ -0,0 +1,118 @@
+//! Real page owners under the production growth transaction with an in-process rank agreement.
+
+const std = @import("std");
+const t = std.testing;
+const sessions = @import("kv").sessions;
+const growth = @import("pool_growth.zig");
+const fams = [_]sessions.Family{.{ .name = "kv", .ratio = 1, .row_bytes = 1 }};
+
+const Pair = struct {
+    votes: [2]std.atomic.Value(u8) = .{ .init(0), .init(0) },
+    const Rank = struct {
+        pair: *Pair,
+        me: usize,
+        slot: *sessions.Slot,
+        err: ?anyerror = null,
+    };
+    fn all(ptr: *anyopaque, ok: bool) !bool {
+        const r: *Rank = @ptrCast(@alignCast(ptr));
+        r.pair.votes[r.me].store(if (ok) 1 else 2, .release);
+        var spins: u64 = 0;
+        while (r.pair.votes[1 - r.me].load(.acquire) == 0) : (spins += 1) {
+            if (spins > 1 << 32) return error.Timeout;
+            std.atomic.spinLoopHint();
+        }
+        return ok and r.pair.votes[1 - r.me].load(.acquire) == 1;
+    }
+    fn run(r: *Rank) void {
+        growth.reserve(.{ .ctx = r, .all = all }, &.{.{ .slot = r.slot, .end = 256 }}) catch |err| {
+            r.err = err;
+        };
+    }
+};
+
+test "pool growth: one rank out of pages rolls back both ranks before device table upload, then both retry" {
+    var pools: [2]sessions.Pool = undefined;
+    for (&pools, 0..) |*p, rank| p.* = try sessions.Pool.init(t.allocator, .{ .families = &fams, .page = 16 }, 512, 2, @intCast(rank));
+    defer for (&pools) |*p| p.deinit();
+    const s0 = try pools[0].newSlot(512);
+    const s1 = try pools[1].newSlot(512);
+    const occupied = try pools[1].newSlot(512);
+    try occupied.ensure(384);
+    var pair: Pair = .{};
+    var ranks = [_]Pair.Rank{ .{ .pair = &pair, .me = 0, .slot = s0 }, .{ .pair = &pair, .me = 1, .slot = s1 } };
+    const a = try std.Thread.spawn(.{}, Pair.run, .{&ranks[0]});
+    const b = try std.Thread.spawn(.{}, Pair.run, .{&ranks[1]});
+    a.join();
+    b.join();
+    for (ranks) |r| {
+        try t.expectEqual(@as(?anyerror, error.PoolExhausted), r.err);
+        try t.expectEqual(@as(u32, 0), r.slot.len);
+        try t.expectEqual(@as(u32, 0), r.slot.over);
+    }
+    try t.expectEqual(@as(u32, 32), pools[0].freePages());
+    try t.expectEqual(@as(u32, 8), pools[1].freePages());
+    _ = try occupied.releaseAll();
+    pair = .{};
+    for (&ranks) |*r| r.err = null;
+    const c = try std.Thread.spawn(.{}, Pair.run, .{&ranks[0]});
+    const d = try std.Thread.spawn(.{}, Pair.run, .{&ranks[1]});
+    c.join();
+    d.join();
+    for (ranks) |r| {
+        try t.expect(r.err == null);
+        try t.expectEqual(@as(u32, 16), r.slot.len);
+        _ = try r.slot.releaseAll();
+    }
+}
+
+test "pool growth: batch refusal restores earlier tentative maps and preserves partial prefill ownership" {
+    var pool = try sessions.Pool.init(t.allocator, .{ .families = &fams, .page = 16 }, 512, 1, 0);
+    defer pool.deinit();
+    const first = try pool.newSlot(512);
+    const second = try pool.newSlot(512);
+    try first.ensure(64);
+    try second.ensure(64);
+    const before = pool.freePages();
+    const needs = [_]growth.Need{ .{ .slot = first, .end = 256 }, .{ .slot = second, .end = 512 } };
+    try t.expectError(error.PoolExhausted, growth.reserve(null, &needs));
+    try t.expectEqual(before, pool.freePages());
+    try t.expectEqual(@as(u32, 4), first.len);
+    try t.expectEqual(@as(u32, 4), second.len);
+    _ = try first.releaseAll();
+    _ = try second.releaseAll();
+    try growth.reserve(null, &.{.{ .slot = first, .end = 512 }});
+    _ = try first.releaseAll();
+    try t.expectEqual(pool.npages, pool.available());
+}
+
+test "pool growth: a failed transport agreement propagates as fatal and retains the tentative owner" {
+    var pool = try sessions.Pool.init(t.allocator, .{ .families = &fams, .page = 16 }, 512, 1, 0);
+    defer pool.deinit();
+    const slot = try pool.newSlot(512);
+    const Fail = struct {
+        fn all(_: *anyopaque, _: bool) anyerror!bool {
+            return error.PeerFailed;
+        }
+    };
+    var context: u8 = 0;
+    try t.expectError(error.PeerFailed, growth.reserve(.{ .ctx = &context, .all = Fail.all }, &.{.{ .slot = slot, .end = 128 }}));
+    try t.expectEqual(@as(u32, 8), slot.len);
+    _ = try slot.releaseAll();
+}
+
+test "pool growth: an unadmitted caller cannot consume another active request's reservation" {
+    var pool = try sessions.Pool.init(t.allocator, .{ .families = &fams, .page = 16 }, 512, 1, 0);
+    defer pool.deinit();
+    const active = try pool.newSlot(512);
+    const other = try pool.newSlot(512);
+    active.reserve(24);
+    try t.expectError(error.PoolExhausted, growth.reserve(null, &.{.{ .slot = other, .end = 256 }}));
+    try t.expectEqual(@as(u32, 0), other.len);
+    try t.expect(other.quota == null);
+    try t.expectEqual(@as(u32, 8), pool.available());
+    try growth.reserve(null, &.{.{ .slot = active, .end = 384 }});
+    _ = try active.releaseAll();
+    try growth.reserve(null, &.{.{ .slot = other, .end = 512 }});
+    _ = try other.releaseAll();
+}
diff --git a/zig/src/families/deepseek_v41/request_admission.zig b/zig/src/families/deepseek_v41/request_admission.zig
new file mode 100644
index 0000000000000000000000000000000000000000..a5edd09bc697b2719990e93a4b86d22142ca75be
--- /dev/null
+++ b/zig/src/families/deepseek_v41/request_admission.zig
@@ -0,0 +1,36 @@
+//! Direct target admission uses the same full-request pool plan as the round planner, before restore or prefill.
+
+const std = @import("std");
+
+pub const Resumed = struct { at: u64 = 0, damaged: bool = false };
+
+/// A failed cache restore loses its shared-page credit; re-price the empty slot before any prompt row runs.
+pub fn resumeRequest(s: anytype, prompt: []const u32, max_new: u64) !Resumed {
+    const hit = try s.find(prompt);
+    const r = try apply(s, prompt, max_new, hit);
+    if (r.damaged) {
+        try afterMiss(s, prompt, max_new);
+    }
+    return r;
+}
+
+/// Called after an agreed restore miss, also by the round planner's pre-planned admission path.
+pub fn afterMiss(s: anytype, prompt: []const u32, max_new: u64) !void {
+    if (s.kx.slot.len != 0) return error.SlotNotEmpty;
+    const kv = @import("kv");
+    const covered = @as(u64, s.kx.slot.quota orelse 0) * s.kx.slot.pool.page;
+    const reply = covered -| (@as(u64, prompt.len) + kv.sess.slack);
+    s.kx.slot.reserve(null);
+    _ = try apply(s, prompt, @max(max_new, reply), @as(?kv.sessions.store.Hit, null));
+}
+
+fn apply(s: anytype, prompt: []const u32, max_new: u64, hit: anytype) !Resumed {
+    var spills: std.ArrayList(u32) = .empty;
+    defer spills.deinit(s.gpa);
+    const held: []const u32 = if (hit) |h| &.{h.id} else &.{};
+    const plan = try s.poolPlan(prompt.len, max_new, hit, held, 0, &spills);
+    // A direct target has no queue: refuse before sending operations, evicting entries or mutating the slot.
+    if (plan.wait) return error.PoolExhausted;
+    const r = try s.resumePlanned(prompt, plan.need, hit, spills.items);
+    return .{ .at = r.at, .damaged = r.damaged };
+}
diff --git a/zig/src/families/deepseek_v41/request_admission_test.zig b/zig/src/families/deepseek_v41/request_admission_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..0b478ffa15944768b9af1b9647504a948a648d4e
--- /dev/null
+++ b/zig/src/families/deepseek_v41/request_admission_test.zig
@@ -0,0 +1,190 @@
+//! Host transport adapter around the actual target admission routine, shared store and reservation owner.
+
+const std = @import("std");
+const t = std.testing;
+const kv = @import("kv");
+const sessions = kv.sessions;
+const admission = @import("request_admission.zig");
+const fams = [_]sessions.Family{.{ .name = "kv", .ratio = 1, .row_bytes = 1 }};
+
+const Bound = struct {
+    released: bool = false,
+    fn bytes(_: *anyopaque) u64 {
+        return 1;
+    }
+    fn blobs(_: *anyopaque, _: std.mem.Allocator) ![]sessions.disk.Blob {
+        return error.Unused;
+    }
+    fn release(p: *anyopaque) void {
+        @as(*Bound, @ptrCast(@alignCast(p))).released = true;
+    }
+    fn value(b: *Bound) sessions.store.Bounded {
+        return .{ .ptr = b, .vtable = &.{ .nbytes = bytes, .blobs = blobs, .release = release } };
+    }
+};
+
+const Host = struct {
+    gpa: std.mem.Allocator,
+    store: *sessions.Store,
+    kx: struct { slot: *sessions.Slot },
+    sent: usize = 0,
+    spills: usize = 0,
+    damage: bool = false,
+    fail: ?anyerror = null,
+
+    pub fn find(h: *Host, prompt: []const u32) !?sessions.store.Hit {
+        const ids = try h.gpa.alloc(i32, prompt.len);
+        defer h.gpa.free(ids);
+        for (prompt, ids) |id, *out| out.* = @intCast(id);
+        return h.store.find(41, ids);
+    }
+    pub fn poolPlan(h: *Host, n: u64, max_new: u64, hit: ?sessions.store.Hit, held: []const u32, extra: u32, spills: *std.ArrayList(u32)) !kv.sess.Plan {
+        return kv.sess.admit(h.store, hit, n, max_new, h.kx.slot.capacity, held, extra, spills);
+    }
+    pub fn resumePlanned(h: *Host, _: []const u32, need: u32, hit: ?sessions.store.Hit, spills: []const u32) !admission.Resumed {
+        h.sent += 1;
+        if (h.fail) |err| return err;
+        for (spills) |id| _ = try h.store.evict(id);
+        try h.store.settleAll();
+        h.spills += spills.len;
+        h.kx.slot.reserve(need);
+        if (hit) |entry| {
+            if (h.damage) {
+                try h.store.drop(entry.id);
+                return .{ .damaged = true };
+            }
+            _ = try h.store.restoreRam(entry.id, h.kx.slot);
+            return .{ .at = entry.pos };
+        }
+        return .{};
+    }
+};
+
+fn save(store: *sessions.Store, slot: *sessions.Slot, ids: []const i32, bound: *Bound) !u32 {
+    try slot.ensure(ids.len);
+    const id = (try store.save(slot, bound.value(), ids, 41, 0)).?;
+    _ = try slot.releaseAll();
+    return id;
+}
+
+fn stockGrowth(world: u32, rank: u32) !void {
+    const a = t.allocator;
+    var pool = try sessions.Pool.init(a, .{ .families = &fams, .page = 512 }, 2100224, world, rank);
+    defer pool.deinit();
+    var host = try sessions.HostPool.init(a, &pool);
+    defer host.deinit();
+    var store = try sessions.Store.init(a, t.io, &pool, host.store(), null, .{ .ram_bytes = 1 << 30 });
+    defer store.deinit();
+    const idle = try pool.newSlot(2100224);
+    const active = try pool.newSlot(655360);
+    const next = try pool.newSlot(655360);
+    const ids = try a.alloc(i32, 1990000);
+    defer a.free(ids);
+    @memset(ids, 7);
+    var bound: Bound = .{};
+    _ = try save(&store, idle, ids, &bound);
+    const prompt = try a.alloc(u32, 117029);
+    defer a.free(prompt);
+    @memset(prompt, 9);
+    var h: Host = .{ .gpa = a, .store = &store, .kx = .{ .slot = active } };
+    try t.expect(pool.available() > 0 and @as(u64, pool.available()) * pool.page < prompt.len);
+    _ = try admission.resumeRequest(&h, prompt, 256);
+    try t.expect(h.spills > 0 and bound.released);
+    try t.expect(active.quota.? >= (prompt.len + 256 + kv.sess.slack + 511) / 512);
+    // A concurrent request cannot consume the active request's unmapped reservation.
+    var h2: Host = .{ .gpa = a, .store = &store, .kx = .{ .slot = next } };
+    _ = try admission.resumeRequest(&h2, prompt, 256);
+    try active.ensure(65536);
+    try next.ensure(65536);
+    try active.ensure(prompt.len + 256);
+    try next.ensure(prompt.len + 256);
+    _ = try active.releaseAll();
+    _ = try next.releaseAll();
+    try t.expectEqual(pool.npages, pool.available());
+}
+
+test "pool growth: stock 117029-token admission reclaims idle ownership before the first piece on each rank" {
+    try stockGrowth(1, 0);
+    try stockGrowth(2, 0);
+    try stockGrowth(2, 1);
+}
+
+test "pool growth: active reservations refuse without mutation, partial prefill rollback permits the next request" {
+    const a = t.allocator;
+    var pool = try sessions.Pool.init(a, .{ .families = &fams, .page = 16 }, 512, 1, 0);
+    defer pool.deinit();
+    var host = try sessions.HostPool.init(a, &pool);
+    defer host.deinit();
+    var store = try sessions.Store.init(a, t.io, &pool, host.store(), null, .{});
+    defer store.deinit();
+    const active = try pool.newSlot(512);
+    const next = try pool.newSlot(512);
+    var h: Host = .{ .gpa = a, .store = &store, .kx = .{ .slot = active } };
+    const prompt: [300]u32 = @splat(4);
+    _ = try admission.resumeRequest(&h, &prompt, 64);
+    try active.ensure(128);
+    const free = pool.freePages();
+    const available = pool.available();
+    var h2: Host = .{ .gpa = a, .store = &store, .kx = .{ .slot = next } };
+    try t.expectError(error.PoolExhausted, admission.resumeRequest(&h2, &prompt, 64));
+    try t.expectEqual(@as(usize, 0), h2.sent);
+    try t.expectEqual(free, pool.freePages());
+    try t.expectEqual(available, pool.available());
+    try t.expectEqual(@as(u32, 0), next.len);
+    try t.expect(next.quota == null);
+    // A refused growth leaves the partial prompt untouched, then release returns pages and its remaining quota.
+    try t.expectError(error.PoolExhausted, next.ensure(512));
+    try t.expectEqual(@as(u32, 8), active.len);
+    _ = try active.releaseAll();
+    _ = try admission.resumeRequest(&h2, &prompt, 64);
+    try next.ensure(prompt.len + 64);
+    _ = try next.releaseAll();
+    try t.expectEqual(pool.npages, pool.available());
+}
+
+test "pool growth: a damaged RAM hit re-prices its lost shared credit, device and transport errors propagate" {
+    const a = t.allocator;
+    var pool = try sessions.Pool.init(a, .{ .families = &fams, .page = 16 }, 512, 1, 0);
+    defer pool.deinit();
+    var host = try sessions.HostPool.init(a, &pool);
+    defer host.deinit();
+    var store = try sessions.Store.init(a, t.io, &pool, host.store(), null, .{});
+    defer store.deinit();
+    const idle = try pool.newSlot(512);
+    const active = try pool.newSlot(512);
+    const ids: [128]i32 = @splat(7);
+    var bound: Bound = .{};
+    _ = try save(&store, idle, &ids, &bound);
+    const prompt: [300]u32 = @splat(7);
+    var h: Host = .{ .gpa = a, .store = &store, .kx = .{ .slot = active }, .damage = true };
+    const r = try admission.resumeRequest(&h, &prompt, 64);
+    try t.expect(r.damaged and r.at == 0 and h.sent == 2);
+    try active.ensure(prompt.len + 64);
+    _ = try active.releaseAll();
+    for ([_]anyerror{ error.CudaFailed, error.PeerFailed }) |err| {
+        h.fail = err;
+        try t.expectError(err, admission.resumeRequest(&h, &prompt, 64));
+        try t.expectEqual(@as(u32, 0), active.len);
+    }
+}
+
+test {
+    _ = @import("pool_growth_test.zig");
+}
+
+test "pool growth: a planned restore miss preserves the original reply reservation" {
+    var pool = try sessions.Pool.init(t.allocator, .{ .families = &fams, .page = 16 }, 512, 1, 0);
+    defer pool.deinit();
+    var host = try sessions.HostPool.init(t.allocator, &pool);
+    defer host.deinit();
+    var store = try sessions.Store.init(t.allocator, t.io, &pool, host.store(), null, .{});
+    defer store.deinit();
+    const slot = try pool.newSlot(512);
+    slot.reserve(24);
+    var h: Host = .{ .gpa = t.allocator, .store = &store, .kx = .{ .slot = slot } };
+    const prompt: [128]u32 = @splat(7);
+    try admission.afterMiss(&h, &prompt, 0);
+    try t.expectEqual(@as(?u32, 24), slot.quota);
+    try slot.ensure(320);
+    _ = try slot.releaseAll();
+}
