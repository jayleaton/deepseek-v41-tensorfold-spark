From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Fri, 30 Oct 2026 00:46:46 +0700
Subject: [PATCH 035/207] deepseek: hand out DSpark statics staging without a
 context drain

Dev.statics ran cuCtxSynchronize before every pass's staging, so each speculative pass waited for the forward, the pick and every side stream. All four callers upload the region with DeviceBuffer.uploadAsync, which since e9bf05ffd clones the bytes into copy_source custody before it returns (test-cuda-copy-source: public async uploader owns the caller input), so no copy reads the region after the call and a failed transfer is drained by copy_source itself. The host test hands out both regions while every synchronize fails; it replaces the test that required the drain.
---
 zig/src/families/deepseek_v41/dspark_dev.zig    |  3 +--
 .../deepseek_v41/staging_owner_test.zig         | 17 ++++++++++++-----
 2 files changed, 13 insertions(+), 7 deletions(-)

diff --git a/zig/src/families/deepseek_v41/dspark_dev.zig b/zig/src/families/deepseek_v41/dspark_dev.zig
index 1f8da959ed3b28907de3772a16c43590f00a3c5e..5d1e3ffe157cdaf690d7dfd727e44c41d49be2e9 100644
--- a/zig/src/families/deepseek_v41/dspark_dev.zig
+++ b/zig/src/families/deepseek_v41/dspark_dev.zig
@@ -129,10 +129,9 @@ pub const Dev = struct {
         return x.active != .host;
     }
 
-    /// Region `g`'s pinned staging for the statics: (int64 [n64], int32 [n32]); free once the previous round waited.
+    /// Region `g`'s statics staging (int64 [n64], int32 [n32]), no sync: uploadAsync clones it before returning.
     pub fn statics(x: *Dev, g: usize, n64: usize, n32: usize) !struct { []i64, []i32 } {
         if (g >= x.regions or 8 * n64 + 4 * n32 > x.region_bytes) return error.Statics;
-        try x.agreement.stream.d.synchronize();
         const b = x.stage.bytes[g * x.region_bytes ..][0..x.region_bytes];
         return .{ @alignCast(std.mem.bytesAsSlice(i64, b[0 .. 8 * n64])), @alignCast(std.mem.bytesAsSlice(i32, b[8 * n64 ..][0 .. 4 * n32])) };
     }
diff --git a/zig/src/families/deepseek_v41/staging_owner_test.zig b/zig/src/families/deepseek_v41/staging_owner_test.zig
index 0e028ffd234778d2ffec62470646b2a9e8ee4ae5..2875d423befdac92f385df675c42bebb57cbc0e7 100644
--- a/zig/src/families/deepseek_v41/staging_owner_test.zig
+++ b/zig/src/families/deepseek_v41/staging_owner_test.zig
@@ -37,19 +37,26 @@ test "Draft state: installed pack releases segments and removes its hook after a
     try std.testing.expectEqual(previous, cuda.memory.currentHook());
     try std.testing.expectEqual(mock.allocated, mock.freed);
 }
-test "Draft state: DSpark statics cannot be handed out before a failed prior transfer drains" {
+test "Draft state: DSpark statics hand out their own region without a context drain" {
     var d = mock.init();
-    var bytes: [32]u8 align(16) = @splat(7);
+    var bytes: [64]u8 align(16) = @splat(7);
     var dev: @import("dspark_dev.zig").Dev = undefined;
-    dev.regions = 1;
+    dev.regions = 2;
     dev.region_bytes = 32;
     dev.stage = .{ .d = &d, .bytes = &bytes };
     dev.agreement = undefined;
     dev.agreement.stream = .{ .d = &d, .handle = null };
+    // any synchronize fails: uploadAsync's copy_source custody, not a drain, frees the region for its next pass
     mock.fail_sync = true;
     defer mock.fail_sync = false;
-    try std.testing.expectError(error.NotReady, dev.statics(0, 1, 1));
-    try std.testing.expect(std.mem.allEqual(u8, &bytes, 7));
+    for (0..2) |g| {
+        const sv = try dev.statics(g, 2, 3);
+        try std.testing.expectEqual(@as([*]u8, @ptrCast(&bytes[32 * g])), @as([*]u8, @ptrCast(sv[0].ptr)));
+        try std.testing.expectEqual(@as([*]u8, @ptrCast(&bytes[32 * g + 16])), @as([*]u8, @ptrCast(sv[1].ptr)));
+        try std.testing.expectEqual(@as(usize, 3), sv[1].len);
+    }
+    try std.testing.expectError(error.Statics, dev.statics(2, 1, 1));
+    try std.testing.expectError(error.Statics, dev.statics(0, 4, 1));
 }
 test "Draft state: prefill teardown releases the second microbatch and workspace owners" {
     var d = mock.init();
