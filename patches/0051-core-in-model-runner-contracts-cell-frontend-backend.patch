---
 zig/src/core/runner_api.zig | 100 ++++++++++++++++++++++++++++++++++++
 1 file changed, 100 insertions(+)
 create mode 100644 zig/src/core/runner_api.zig

diff --git a/zig/src/core/runner_api.zig b/zig/src/core/runner_api.zig
new file mode 100644
index 0000000000000000000000000000000000000000..c2a403669c0048e045c00bb2c73f44499c3fd5ad
--- /dev/null
+++ b/zig/src/core/runner_api.zig
@@ -0,0 +1,100 @@
+//! The in-model runner's contracts: a cell the model wrote, the circuit program a frontend makes of it, the backend.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+/// How the model wrote a cell: a fenced block, a `>>> ` REPL line, or an inline `A op B =`.
+pub const Form = enum { fence, repl, inline_expr };
+
+/// A closed cell of the reply being generated (never prompt history).
+pub const Cell = struct {
+    form: Form,
+    /// The fence's language tag, lowercase and trimmed ("" when none; "python" for repl and inline_expr).
+    lang: []const u8,
+    /// The cell's source without fence lines or `>>> ` / `... ` prefixes; inline_expr: the text before `=`.
+    code: []const u8,
+    /// Sources of this reply's earlier cells whose runs ended ok, oldest first (notebook state; may be ignored).
+    prior: []const []const u8 = &.{},
+};
+
+/// What the circuit runs. calc: an ASCII expression for the calc firmware. elf: an rv32im_zba ELF image.
+pub const Program = struct {
+    kind: enum { calc, elf },
+    bytes: []const u8,
+};
+
+/// Why a frontend or backend declines; the model's own continuation then stands (nothing is owned).
+pub const Abstain = enum { language, unsupported, syntax, name, too_long, too_big };
+
+pub const Translation = union(enum) { program: Program, abstain: Abstain };
+
+/// Code text to a circuit program, or an abstain; pure and deterministic, the result allocated from `a`.
+pub const Frontend = struct {
+    ctx: ?*anyopaque = null,
+    translate: *const fn (ctx: ?*anyopaque, a: Allocator, cell: Cell) Allocator.Error!Translation,
+};
+
+pub const Status = enum {
+    /// The program halted; `out` is everything it printed.
+    ok,
+    /// The run declined (the backend's own reasons); the model's continuation stands.
+    abstain,
+    /// The step budget ran out before the halt; `out` is what was printed so far.
+    budget,
+    /// The machine faulted (illegal instruction, bad access); `out` is what was printed so far.
+    fault,
+};
+
+/// A finished run. status, out and steps are a pure function of the program; exec_ns is reporting only.
+pub const Result = struct {
+    status: Status,
+    out: []const u8 = "",
+    steps: u64 = 0,
+    exec_ns: u64 = 0,
+    abstain: ?Abstain = null,
+};
+
+pub const JobId = u64;
+pub const Poll = union(enum) { running, done: Result };
+
+/// Runs programs off the engine thread. Every call comes from the one engine host thread; none blocks on a run.
+pub const Backend = struct {
+    ctx: *anyopaque,
+    vtable: *const VTable,
+
+    pub const VTable = struct {
+        /// Starts `program` for engine stream `stream` (the backend copies it); Busy when no slot is free now.
+        start: *const fn (ctx: *anyopaque, stream: u64, program: Program, budget: u64) error{ OutOfMemory, Busy }!JobId,
+        /// .done once, then the job is gone; `out` stays valid until the next call for the same stream.
+        poll: *const fn (ctx: *anyopaque, job: JobId) Poll,
+        /// Stops a job (its result is never wanted); a later poll of it is undefined.
+        cancel: *const fn (ctx: *anyopaque, job: JobId) void,
+        /// The stream ended: drop its jobs, machines and buffers.
+        release: *const fn (ctx: *anyopaque, stream: u64) void,
+    };
+
+    pub fn start(b: Backend, stream: u64, program: Program, budget: u64) error{ OutOfMemory, Busy }!JobId {
+        return b.vtable.start(b.ctx, stream, program, budget);
+    }
+    pub fn poll(b: Backend, job: JobId) Poll {
+        return b.vtable.poll(b.ctx, job);
+    }
+    pub fn cancel(b: Backend, job: JobId) void {
+        b.vtable.cancel(b.ctx, job);
+    }
+    pub fn release(b: Backend, stream: u64) void {
+        b.vtable.release(b.ctx, stream);
+    }
+};
+
+/// How one machine run ended (the circuit evaluator's contract, CPU and CUDA alike).
+pub const RunEnd = struct {
+    end: enum { halted, budget, cancelled, fault },
+    steps: u64,
+};
+
+test "the contract types compose" {
+    const t: Translation = .{ .program = .{ .kind = .calc, .bytes = "2*3" } };
+    try std.testing.expectEqual(.calc, t.program.kind);
+    const r: Result = .{ .status = .abstain, .abstain = .syntax };
+    try std.testing.expect(r.out.len == 0 and r.abstain.? == .syntax);
+}
