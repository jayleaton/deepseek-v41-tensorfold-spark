new file mode 100644
index 0000000000000000000000000000000000000000..16b45e2bbc41eab1e063aa4bbdb4741dfdb96212
--- /dev/null
+++ b/zig/src/families/deepseek_v41/grammar_contract.zig
@@ -0,0 +1,107 @@
+//! Host registration for the JIT mask operator; device execution and compiled resource receipts remain unrun.
+const std = @import("std");
+const contract = @import("contract");
+const c = contract.spec;
+const masks = @import("grammar_rows.zig");
+
+pub const launch = contract.registry.dsv41_grammar.launch;
+
+pub const spec: c.Spec = .{
+    .name = launch.name,
+    .accum = .none,
+    .depth = depth,
+    .out = .f32,
+    .in_place = true,
+    .nan = .{ .stated = "allowed logits retain their bits including NaN; disallowed logits become negative infinity" },
+    .tiles = .{ .{ .size = 16 }, .{ .size = 32, .step = 32, .min = 32 }, .{} },
+    .served = &.{
+        .{ .rows = 1, .n = 129280, .k = 0 },
+        .{ .rows = 16, .n = 64640, .k = 0 },
+        .{ .rows = 64, .n = 32384, .k = 0 },
+    },
+    .sums = .{ .f16 = 0, .bf16 = 0, .why = "bitmask stores only; no accumulation" },
+};
+
+pub const DeviceGate = enum { unrun };
+pub const device_gate: DeviceGate = .unrun;
+pub const resource_receipt: ?contract.limits.Usage = null;
+
+fn depth(_: c.Shape) usize {
+    return 0;
+}
+
+fn reference(input: []const f32, output: []f32, idx: []const u32, bits: []const u32, width: usize, words: usize, lo: usize) void {
+    @memcpy(output, input);
+    for (idx, 0..) |row, r| for (0..width) |col| {
+        const token = lo + col;
+        if ((bits[r * words + token / 32] >> @intCast(token % 32)) & 1 == 0)
+            output[row * width + col] = -std.math.inf(f32);
+    };
+}
+
+test "grammar contract: registered launch and arithmetic contract name the production kernel" {
+    try std.testing.expectEqualStrings(masks.symbol, launch.symbol);
+    try std.testing.expectEqual(masks.threads, launch.threads);
+    var found = false;
+    for (contract.registry.all_cuda) |entry| {
+        if (std.mem.eql(u8, entry.launch.symbol, launch.symbol)) found = true;
+    }
+    try std.testing.expect(found);
+    try std.testing.expectEqual(@as(u32, 128), launch.threads);
+    try std.testing.expect(spec.in_place);
+    try std.testing.expectEqual(c.Accum.none, spec.accum);
+    try std.testing.expectEqual(@as(?contract.limits.Usage, null), resource_receipt);
+    try std.testing.expectEqual(.unrun, device_gate);
+}
+
+test "grammar contract: nonfinite, repeat, shape edges, guards and corruption control on host" {
+    const a = std.testing.allocator;
+    const shapes = try c.shapes(a, spec);
+    defer a.free(shapes);
+    for (shapes) |shape| {
+        const width: u32 = @intCast(shape.n);
+        const lo: u32 = 128;
+        const words = (lo + width + 31) / 32;
+        const count: usize = @min(shape.rows, 3);
+        const len = (count + 2) * width;
+        const input = try a.alloc(f32, len);
+        defer a.free(input);
+        const got = try a.alloc(f32, len + 2);
+        defer a.free(got);
+        const want = try a.alloc(f32, len);
+        defer a.free(want);
+        const bits = try a.alloc(u32, count * words);
+        defer a.free(bits);
+        const saved = try a.alloc(u32, bits.len);
+        defer a.free(saved);
+        for (input, 0..) |*v, i| v.* = switch (i % 5) {
+            0 => @bitCast(@as(u32, 0x7fc01234)),
+            1 => std.math.inf(f32),
+            2 => -std.math.inf(f32),
+            3 => -0.0,
+            else => @floatFromInt(i % 97),
+        };
+        for (bits, 0..) |*v, i| v.* = switch (i % 4) {
+            0 => 0,
+            1 => std.math.maxInt(u32),
+            2 => 0x55555555,
+            else => 0xaaaaaaaa,
+        };
+        @memcpy(saved, bits);
+        const indices = [_]u32{ 1, 2, 3 };
+        reference(input, want, indices[0..count], bits, width, words, lo);
+        for (0..5) |_| {
+            got[0] = 12345;
+            got[len + 1] = 54321;
+            @memcpy(got[1 .. len + 1], input);
+            masks.maskRows(got[1 .. len + 1], width, indices[0..count], bits, words, lo);
+            try std.testing.expectEqualSlices(u8, std.mem.sliceAsBytes(want), std.mem.sliceAsBytes(got[1 .. len + 1]));
+            try std.testing.expectEqualSlices(u32, saved, bits);
+            try std.testing.expectEqual(@as(f32, 12345), got[0]);
+            try std.testing.expectEqual(@as(f32, 54321), got[len + 1]);
+        }
+        const damaged = 1 + @as(usize, indices[0]) * width;
+        got[damaged] = 9;
+        try std.testing.expect(!std.mem.eql(u8, std.mem.sliceAsBytes(want), std.mem.sliceAsBytes(got[1 .. len + 1])));
+    }
+}
diff --git a/zig/src/families/deepseek_v41/grammar_gpu.zig b/zig/src/families/deepseek_v41/grammar_gpu.zig
new file mode 100644
index 0000000000000000000000000000000000000000..6401188612e2bbbe2aacd7166ab64daf50b2e317
--- /dev/null
+++ b/zig/src/families/deepseek_v41/grammar_gpu.zig
@@ -0,0 +1,154 @@
+//! Apply shared lanes' masks to each rank's fp32 logits, with no second matcher or scheduler.
+const std = @import("std");
+const cuda = @import("cuda");
+const Forward = @import("forward.zig").Forward;
+const rows = @import("grammar_rows.zig");
+const iface = @import("draft/iface.zig");
+const Allocator = std.mem.Allocator;
+pub const Row = rows.Row;
+
+pub const Masks = struct {
+    gpa: Allocator,
+    f: *Forward,
+    words: u32,
+    max_rows: u32,
+    lo: u32,
+    width: u32,
+    module: cuda.Module,
+    kernel: cuda.Function,
+    host: cuda.HostBuffer,
+    dev: cuda.DeviceBuffer,
+    count: u32 = 0,
+    message: std.ArrayList(i64) = .empty,
+
+    pub fn init(gpa: Allocator, f: *Forward, max_rows: u32) !*Masks {
+        if (f.grammar != null or max_rows == 0) return error.GrammarSetup;
+        const part = try @import("partition.zig").share(f.cfg.vocab, f.comm.rank(), f.comm.world());
+        const words = (f.cfg.vocab + 31) / 32;
+        const bytes = 4 * @as(usize, max_rows) * (words + 1);
+        var host = try cuda.HostBuffer.alloc(f.runner.d, bytes);
+        errdefer host.free();
+        var dev = try cuda.DeviceBuffer.alloc(f.runner.d, bytes);
+        errdefer dev.free();
+        var log: [4096]u8 = @splat(0);
+        var module = try cuda.Module.loadPtx(f.runner.d, @embedFile("grammar_mask_ptx"), &log);
+        errdefer module.unload();
+        const kernel = try module.function(rows.symbol);
+        const x = try gpa.create(Masks);
+        x.* = .{ .gpa = gpa, .f = f, .words = words, .max_rows = max_rows, .lo = part.lo, .width = part.len, .module = module, .kernel = kernel, .host = host, .dev = dev };
+        f.grammar = .{ .ptr = x, .follow = follow, .apply = applyFn };
+        return x;
+    }
+
+    pub fn deinit(x: *Masks) void {
+        x.f.runner.stream.synchronize() catch {};
+        x.f.grammar = null;
+        x.message.deinit(x.gpa);
+        x.module.unload();
+        x.dev.free();
+        x.host.free();
+        x.gpa.destroy(x);
+    }
+
+    fn bits(x: *Masks) []u32 {
+        return @alignCast(std.mem.bytesAsSlice(u32, x.host.bytes[0 .. 4 * @as(usize, x.max_rows) * x.words]));
+    }
+
+    fn indices(x: *Masks) []u32 {
+        const off = 4 * @as(usize, x.max_rows) * x.words;
+        return @alignCast(std.mem.bytesAsSlice(u32, x.host.bytes[off..]));
+    }
+
+    pub fn stage(x: *Masks, list: []const Row) !void {
+        try rows.validate(list, x.words, x.max_rows);
+        // The previous async upload must finish before its pinned source is reused.
+        if (x.count != 0) try x.f.runner.stream.synchronize();
+        x.count = @intCast(list.len);
+        for (list, 0..) |r, i| {
+            x.indices()[i] = r.index orelse std.math.maxInt(u32);
+            @memcpy(x.bits()[i * x.words ..][0..x.words], r.bits);
+        }
+        if (x.f.leads()) {
+            try x.message.resize(x.gpa, 3 + list.len * (x.words + 1));
+            const msg = x.message.items;
+            msg[0] = Forward.op_grammar;
+            msg[1] = x.words;
+            msg[2] = x.count;
+            for (list, 0..) |_, i| {
+                const at = 3 + i * (x.words + 1);
+                msg[at] = x.indices()[i];
+                for (x.bits()[i * x.words ..][0..x.words], msg[at + 1 ..][0..x.words]) |b, *v| v.* = b;
+            }
+            try x.f.link.?.send(msg);
+        }
+    }
+
+    fn follow(ptr: *anyopaque, msg: []const i64) anyerror!void {
+        const x: *Masks = @ptrCast(@alignCast(ptr));
+        if (msg.len < 3 or msg[1] != x.words or msg[2] < 0 or msg[2] > x.max_rows) return error.BadPlan;
+        const count: usize = @intCast(msg[2]);
+        if (msg.len != 3 + count * (x.words + 1)) return error.BadPlan;
+        var list: std.ArrayList(Row) = .empty;
+        defer list.deinit(x.gpa);
+        var arena = std.heap.ArenaAllocator.init(x.gpa);
+        defer arena.deinit();
+        for (0..count) |i| {
+            const at = 3 + i * (x.words + 1);
+            const index = std.math.cast(u32, msg[at]) orelse return error.BadPlan;
+            const b = try arena.allocator().alloc(u32, x.words);
+            for (b, msg[at + 1 ..][0..x.words]) |*v, w| v.* = std.math.cast(u32, w) orelse return error.BadPlan;
+            try list.append(x.gpa, .{ .index = if (index == std.math.maxInt(u32)) null else index, .bits = b });
+        }
+        try x.stage(list.items);
+    }
+
+    fn applyFn(ptr: *anyopaque, row0: u32, n: u32) anyerror!void {
+        const x: *Masks = @ptrCast(@alignCast(ptr));
+        if (x.count == 0) return;
+        const idx = x.indices();
+        for (idx[0..x.count]) |*i| if (i.* == std.math.maxInt(u32)) {
+            if (n == 0) return error.GrammarRows;
+            i.* = row0 + n - 1;
+        };
+        const r = x.f.runner;
+        const off = 4 * @as(usize, x.max_rows) * x.words;
+        try x.dev.uploadAsync(0, x.host.bytes[0 .. 4 * @as(usize, x.count) * x.words], r.stream.handle);
+        try x.dev.uploadAsync(off, x.host.bytes[off..][0 .. 4 * @as(usize, x.count)], r.stream.handle);
+        var args: cuda.launch.Args = .{};
+        args.add(r.addressOf("w.logits") orelse return error.Unbound);
+        args.add(@as(u64, x.width));
+        args.add(x.dev.ptr + off);
+        args.add(x.dev.ptr);
+        args.add(x.words);
+        args.add(x.lo / 32);
+        args.add(x.width / 32);
+        args.add(x.width);
+        try cuda.launch.launch(x.kernel, .{ .grid = .{ .x = (x.width / 32 + rows.threads - 1) / rows.threads, .y = x.count }, .block = .{ .x = rows.threads } }, r.stream, &args);
+        // Keep masks across the forward's greedy and separate keyed segments; they are idempotent.
+    }
+};
+
+pub fn stage(f: *Forward, list: []const Row) !void {
+    const hook = f.grammar orelse {
+        if (list.len != 0) return error.StructuresUnsupported;
+        return;
+    };
+    const x: *Masks = @ptrCast(@alignCast(hook.ptr));
+    return x.stage(list);
+}
+
+pub fn segments(f: *Forward, segs: []const iface.Segment) !void {
+    var arena = std.heap.ArenaAllocator.init(f.gpa);
+    defer arena.deinit();
+    var list: std.ArrayList(Row) = .empty;
+    var at: u32 = 0;
+    const words = (f.cfg.vocab + 31) / 32;
+    for (segs) |s| {
+        if (s.masks.len != 0) {
+            if (s.masks.len != s.tokens.len * words) return error.GrammarWords;
+            for (0..s.tokens.len) |i| try list.append(arena.allocator(), .{ .index = at + @as(u32, @intCast(i)), .bits = s.masks[i * words ..][0..words] });
+        }
+        at += @intCast(s.tokens.len);
+    }
+    return stage(f, list.items);
+}
diff --git a/zig/src/families/deepseek_v41/grammar_host_test.zig b/zig/src/families/deepseek_v41/grammar_host_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..1ede68bdc4f7465e4b22f553e32f90a2041e0a09
--- /dev/null
+++ b/zig/src/families/deepseek_v41/grammar_host_test.zig
@@ -0,0 +1,137 @@
+//! Shared grammar cuts and masks through the actual family lane backend, without a CUDA driver.
+const std = @import("std");
+const lanes = @import("lanes");
+const ln = @import("draft/lanes.zig");
+const iface = @import("draft/iface.zig");
+const mask_rows = @import("grammar_rows.zig");
+const a = std.testing.allocator;
+
+const Target = struct {
+    prompt: [2]u32 = @splat(0),
+    masked_rows: usize = 0,
+    seen_drafts: usize = 0,
+
+    fn self(p: *anyopaque) *Target {
+        return @ptrCast(@alignCast(p));
+    }
+    fn promptMask(p: *anyopaque, _: u32, mask: []const u32) anyerror!void {
+        if (mask.len != 2) return error.MissingPromptMask;
+        @memcpy(&self(p).prompt, mask);
+    }
+    fn choose(bits: []const u32) !u32 {
+        var logits: [64]f32 = @splat(1);
+        logits[0] = 100;
+        mask_rows.maskRows(&logits, 64, &.{0}, bits, 2, 0);
+        const id = @import("greedy.zig").argmax(&logits);
+        if (!std.math.isFinite(logits[id])) return error.GrammarDeadEnd;
+        return @intCast(id);
+    }
+    fn prefill(p: *anyopaque, _: u32, _: []const u32, _: ?lanes.Sampling, _: u64) anyerror!u32 {
+        return choose(&self(p).prompt);
+    }
+    fn window(p: *anyopaque, segs: []const iface.Segment, out: [][]u32) anyerror!void {
+        for (segs, out) |s, choices| {
+            if (s.masks.len != s.tokens.len * 2) return error.MissingWindowMasks;
+            self(p).seen_drafts += s.tokens.len - 1;
+            for (choices, 0..) |*choice, i| {
+                choice.* = try choose(s.masks[i * 2 ..][0..2]);
+                self(p).masked_rows += 1;
+            }
+        }
+    }
+    fn keep(_: *anyopaque, _: u32, _: []const u32) anyerror!void {}
+    fn taps(_: *anyopaque, _: u32) iface.Taps {
+        return .{ .address = 0, .rows = 1, .stride = 1 };
+    }
+    fn release(_: *anyopaque, _: u32) void {}
+    fn target(t: *Target) iface.Target {
+        return .{ .ptr = t, .vtable = &.{ .prompt_mask = promptMask, .prefill = prefill, .window = window, .keep = keep, .taps = taps, .release = release } };
+    }
+};
+
+test "grammar family: first token and drafted prefix masks reach the target" {
+    for ([_]bool{ false, true }) |drafts| {
+        var target: Target = .{};
+        var pass: @import("draft/drive.zig").Oracle = .{ .serial = &.{ 5, 6, 7, 31 }, .prompt_len = 2, .vocab = 64 };
+        var prices = try @import("draft/costs.zig").defaults(a, 64);
+        defer prices.deinit(a);
+        const x = try ln.Lanes.init(a, target.target(), pass.pass(), prices, .{
+            .shape = .{ .hidden = 1, .block = 3, .candidates = 1, .window = 1 },
+            .slots = 1,
+            .depth = .{ .mode = .static, .cap = 3, .skip = false },
+        });
+        defer x.deinit();
+        var arena = std.heap.ArenaAllocator.init(a);
+        defer arena.deinit();
+        var cfg = try lanes.Config.init(a, try x.model(arena.allocator(), 64), 16, 15);
+        defer cfg.deinit(a);
+        var clock: lanes.fake.FixedClock = .{};
+        var e = lanes.Engine.init(a, &cfg, x.backend(), clock.clock());
+        defer e.deinit();
+        x.attach(&e);
+        var sequence: lanes.grammar.Sequence = .{ .want = &.{ 5, 6, 7 }, .stop = 31, .gpa = a };
+        var grammar = lanes.grammar.Constraint.init(sequence.rules(), 2, null);
+        defer grammar.rules.vtable.free(grammar.rules.ptr);
+        var stream = try lanes.Stream.init(a, .{ .id = "grammar", .prompt = &.{ 1, 2 }, .max_new = 8, .drafts = drafts, .sampling = if (drafts) .{ .seed = 11, .temperature = 0.8, .top_k = 8, .top_p = 0.9 } else null, .eos = &.{31}, .grammar = &grammar });
+        defer stream.deinit(a);
+        try e.addStream(&stream);
+        while (e.activeCount() > 0) try e.step();
+        try std.testing.expectEqualStrings("", stream.problem);
+        try std.testing.expectEqualSlices(u32, &.{ 5, 6, 7, 31 }, stream.emitted());
+        try std.testing.expect(target.masked_rows > 0);
+        try std.testing.expect(lanes.grammar.allows(&target.prompt, 5));
+    }
+}
+
+test "grammar family: rejected draft prefix rolls back and rejects empty or malformed masks" {
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    var sequence: lanes.grammar.Sequence = .{ .want = &.{ 5, 6, 7 }, .stop = 31, .gpa = a };
+    var grammar = lanes.grammar.Constraint.init(sequence.rules(), 2, null);
+    defer grammar.rules.vtable.free(grammar.rules.ptr);
+    try std.testing.expect(try grammar.follow(5));
+    const cut = try grammar.window(arena.allocator(), &.{ 5, 6, 42, 7 }, &.{ -1, 0, 1, 2 }, false, 2);
+    try std.testing.expectEqualSlices(u32, &.{ 0, 1 }, cut.rows);
+    try std.testing.expectEqual(@as(usize, 1), sequence.at);
+    try std.testing.expect(lanes.grammar.allows(cut.masks[0..2], 6));
+    try std.testing.expect(lanes.grammar.allows(cut.masks[2..4], 7));
+    try mask_rows.validate(&.{.{ .index = 0, .bits = cut.masks[0..2] }}, 2, 64);
+    try std.testing.expectError(error.GrammarDeadEnd, mask_rows.validate(&.{.{ .index = 0, .bits = &.{ 0, 0 } }}, 2, 64));
+    try std.testing.expectError(error.GrammarWords, mask_rows.validate(&.{.{ .index = 0, .bits = &.{1} }}, 2, 64));
+}
+
+test "grammar family: masks use global tokens across uneven rank spans and retain allowed NaN" {
+    const words = 40;
+    var bits: [words]u32 = @splat(0);
+    bits[12] = 1;
+    for (0..4) |rank| {
+        const part = try @import("partition.zig").share(1280, rank, 4);
+        const logits = try a.alloc(f32, part.len * 2);
+        defer a.free(logits);
+        @memset(logits, std.math.nan(f32));
+        mask_rows.maskRows(logits, part.len, &.{1}, &bits, words, part.lo);
+        for (logits[0..part.len]) |v| try std.testing.expect(std.math.isNan(v));
+        for (logits[part.len..], 0..) |v, col| {
+            if (part.lo + col == 384) try std.testing.expect(std.math.isNan(v)) else try std.testing.expectEqual(-std.math.inf(f32), v);
+        }
+    }
+}
+
+test "grammar family: thinking prefix stays free until the close token, then draft masks start" {
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    var sequence: lanes.grammar.Sequence = .{ .want = &.{ 5, 6 }, .stop = 31, .gpa = a };
+    var grammar = lanes.grammar.Constraint.init(sequence.rules(), 2, 30);
+    defer grammar.rules.vtable.free(grammar.rules.ptr);
+    try std.testing.expect(try grammar.next(arena.allocator()) == null);
+    const window = try grammar.window(arena.allocator(), &.{ 9, 10, 30, 5, 42 }, &.{ -1, 0, 1, 2, 3 }, false, 4);
+    try std.testing.expectEqualSlices(u32, &.{ 0, 1, 2, 3 }, window.rows);
+    try std.testing.expect(std.mem.allEqual(u32, window.masks[0..4], std.math.maxInt(u32)));
+    try std.testing.expect(lanes.grammar.allows(window.masks[4..6], 5));
+    try std.testing.expect(lanes.grammar.allows(window.masks[6..8], 6));
+    try std.testing.expectEqual(@as(usize, 0), sequence.at);
+    try std.testing.expect(!grammar.active);
+    try std.testing.expect(try grammar.follow(30));
+    const next = (try grammar.next(arena.allocator())).?;
+    try std.testing.expect(lanes.grammar.allows(next, 5));
+}
diff --git a/zig/src/families/deepseek_v41/grammar_lane.zig b/zig/src/families/deepseek_v41/grammar_lane.zig
new file mode 100644
index 0000000000000000000000000000000000000000..85715e400d0143dcd7ef4af11272009db748fe76
--- /dev/null
+++ b/zig/src/families/deepseek_v41/grammar_lane.zig
@@ -0,0 +1,35 @@
+//! Shared lane grammar handoff: the matcher and draft cuts stay in core.lanes.
+const std = @import("std");
+const lanes = @import("lanes");
+const Lanes = @import("draft/lanes.zig").Lanes;
+
+pub fn prompt(x: *Lanes, s: *lanes.Stream, slot: u32) !void {
+    var arena = std.heap.ArenaAllocator.init(x.gpa);
+    defer arena.deinit();
+    const mask = if (s.grammar) |g| try g.next(arena.allocator()) else null;
+    try x.target.promptMask(slot, mask orelse &.{});
+}
+
+pub fn firstMasked(ptr: *anyopaque, s: *lanes.Stream, position: u64, mask: []const u32) anyerror!u64 {
+    const x: *Lanes = @ptrCast(@alignCast(ptr));
+    const st = x.state(s) orelse return error.UnknownStream;
+    if (position != st.len) return error.PositionMismatch;
+    if (!lanes.grammar.allows(mask, st.first)) return error.GrammarRejected;
+    try x.drawn.append(x.gpa, st.first);
+    return x.drawn.items.len - 1;
+}
+
+pub fn held(ptr: *anyopaque, s: *lanes.Stream, out: []u32) anyerror!void {
+    const x: *Lanes = @ptrCast(@alignCast(ptr));
+    const st = x.state(s) orelse return error.UnknownStream;
+    if (out.len > st.nodes()) return error.HeldMismatch;
+    const main = @min(out.len, st.n);
+    @memcpy(out[0..main], st.held[0..main]);
+    var at: usize = main;
+    for (st.sib_tokens[0..st.n_sib], st.sib_len[0..st.n_sib]) |tokens, n| {
+        const take = @min(n, out.len - at);
+        @memcpy(out[at..][0..take], tokens[0..take]);
+        at += take;
+        if (at == out.len) break;
+    }
+}
diff --git a/zig/src/families/deepseek_v41/grammar_mask_kernel.zig b/zig/src/families/deepseek_v41/grammar_mask_kernel.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e0cc787f7cd00980c7e0ff4a41f7c6f0fe589bb1
--- /dev/null
+++ b/zig/src/families/deepseek_v41/grammar_mask_kernel.zig
@@ -0,0 +1,11 @@
+//! Apply shared lane mask words to the selected rank-local logit rows.
+const rows = @import("grammar_rows.zig");
+
+export fn tf_grammar_mask(logits: [*]addrspace(.global) f32, ld: u64, idx: [*]addrspace(.global) const u32, bits: [*]addrspace(.global) const u32, words: u32, w0: u32, n: u32, width: u32) callconv(.kernel) void {
+    const r = @workGroupId(1);
+    const k = @workGroupId(0) * @workGroupSize(0) + @workItemId(0);
+    if (k >= n) return;
+    const word = bits[@as(u64, r) * words + w0 + k];
+    const base: [*]f32 = @addrSpaceCast(logits + @as(u64, idx[r]) * ld);
+    rows.maskWord(base, word, 32 * k, width);
+}
diff --git a/zig/src/families/deepseek_v41/grammar_rows.zig b/zig/src/families/deepseek_v41/grammar_rows.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ea1c758f1e566770499e1f6941d9457758519f4d
--- /dev/null
+++ b/zig/src/families/deepseek_v41/grammar_rows.zig
@@ -0,0 +1,30 @@
+//! Per-row vocabulary masks supplied by shared lanes, before either greedy or keyed selection.
+const std = @import("std");
+
+pub const threads: u32 = 128;
+pub const symbol = "tf_grammar_mask";
+
+pub inline fn maskWord(row: [*]f32, word: u32, col0: u32, width: u32) void {
+    if (word == std.math.maxInt(u32)) return;
+    for (0..32) |b| {
+        const col = col0 + @as(u32, @intCast(b));
+        if (col < width and (word >> @intCast(b)) & 1 == 0) row[col] = -std.math.inf(f32);
+    }
+}
+
+pub fn maskRows(logits: []f32, width: u32, indices: []const u32, bits: []const u32, words: u32, lo: u32) void {
+    for (indices, 0..) |row, r| {
+        for (0..width / 32) |k| maskWord(logits[@as(usize, row) * width ..].ptr, bits[r * words + lo / 32 + k], @intCast(k * 32), width);
+    }
+}
+
+pub const Row = struct { index: ?u32, bits: []const u32 };
+
+pub fn validate(rows: []const Row, words: u32, max_rows: u32) !void {
+    if (words == 0 or rows.len > max_rows) return error.GrammarRows;
+    for (rows) |r| {
+        if (r.bits.len != words) return error.GrammarWords;
+        if (r.index) |i| if (i >= max_rows) return error.GrammarRows;
+        if (std.mem.allEqual(u32, r.bits, 0)) return error.GrammarDeadEnd;
+    }
+}
