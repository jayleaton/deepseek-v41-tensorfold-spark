+test "retime: suspect rows cycled after one warm-up round, each kept the lower; the table loses the burst" {
+    const m: cm.Method = .{};
+    var p = try cm.Plan.init(gpa, 4, 64, cm.max_rows, m, false);
+    defer p.deinit(gpa);
