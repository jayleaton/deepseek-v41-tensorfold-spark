diff --git a/zig/src/fabric/tp/roce_inflight_test.zig b/zig/src/fabric/tp/roce_inflight_test.zig
index f28c18323..8684bde1d 100644
--- a/zig/src/fabric/tp/roce_inflight_test.zig
+++ b/zig/src/fabric/tp/roce_inflight_test.zig
@@ -120,3 +120,48 @@ test "the THP enabled file names the mode in force, and only never means no huge
     try std.testing.expect(!rv.thpEnabledFrom("madvise [never]"));
     try std.testing.expect(rv.thpEnabledFrom("always madvise never")); // malformed: the advice is attempted as before
 }
+
+test "proxyLoop skips CQ polling while linkIdle and drains in-flight posts before going quiet" {
+    const sock = @import("sock.zig");
+    const region = try std.testing.allocator.alignedAlloc(u8, .fromByteUnits(4096), Roce.regionBytes(slot));
+    defer std.testing.allocator.free(region);
+    @memset(region, 0);
+    Fake.region = region;
+    Fake.slot_bytes = slot;
+    Fake.reset(3);
+    var hw: fake.Hw = .{};
+    const w = hw.wire(region);
+    var r: Roce = .{ .me = 0, .slot_bytes = slot, .timeout_ns = 1, .region = region, .mapping = region, .wire = .{ .verbs = w }, .cpu = null };
+    r.running.store(true, .release);
+    const th = try std.Thread.spawn(.{}, Roce.proxyLoop, .{&r});
+    for (0..5_000) |_| {
+        if (r.idle_skips.load(.acquire) >= 4) break;
+        sock.sleepNs(100 * std.time.ns_per_us);
+    }
+    r.running.store(false, .release);
+    th.join();
+    try std.testing.expect(r.idle_skips.load(.acquire) >= 4);
+    try std.testing.expectEqual(@as(u64, 0), Fake.polls.load(.acquire));
+
+    r.idle_skips.store(0, .release);
+    r.running.store(true, .release);
+    try r.wire.verbs.post(1, 1, slot);
+    try std.testing.expect(!r.linkIdle());
+    const th2 = try std.Thread.spawn(.{}, Roce.proxyLoop, .{&r});
+    for (0..5_000) |_| {
+        if (r.idle_skips.load(.acquire) >= 4) break;
+        sock.sleepNs(100 * std.time.ns_per_us);
+    }
+    const settled = Fake.polls.load(.acquire);
+    const skips_base = r.idle_skips.load(.acquire);
+    for (0..5_000) |_| {
+        if (r.idle_skips.load(.acquire) >= skips_base + 4) break;
+        sock.sleepNs(100 * std.time.ns_per_us);
+    }
+    r.running.store(false, .release);
+    th2.join();
+    try std.testing.expect(r.linkIdle());
+    try std.testing.expect(r.idle_skips.load(.acquire) >= skips_base + 4);
+    try std.testing.expect(settled > 0);
+    try std.testing.expectEqual(settled, Fake.polls.load(.acquire));
+}
