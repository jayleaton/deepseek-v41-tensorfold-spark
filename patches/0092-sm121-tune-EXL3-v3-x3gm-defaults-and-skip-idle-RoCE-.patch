 zig/src/cuda/exl3_block_x3gm.zig             |  2 +-
 zig/src/fabric/tp/roce.zig                   | 11 ++++-
 zig/src/fabric/tp/roce_fake.zig              |  8 ++--
 zig/src/fabric/tp/roce_inflight_test.zig     | 45 ++++++++++++++++++++
 zig/src/fabric/tp/roce_legacy_posts_test.zig |  2 +-
 6 files changed, 69 insertions(+), 8 deletions(-)

