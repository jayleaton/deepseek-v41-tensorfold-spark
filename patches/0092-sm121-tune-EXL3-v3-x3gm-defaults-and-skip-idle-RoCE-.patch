+                        _ = r.idle_skips.fetchAdd(1, .release);
+                    }
+                }
                 if (idle >= idle_spins) sock.sleepNs(20 * std.time.ns_per_us) else std.atomic.spinLoopHint();
                 continue;
             }
diff --git a/zig/src/fabric/tp/roce_fake.zig b/zig/src/fabric/tp/roce_fake.zig
