     try std.testing.expectEqual([2]usize{ 3, 2 }, gmTuned(&tune_default, null, null, 4096, 6, 384, true, 6, 6));
     try std.testing.expectEqual([2]usize{ 2, 2 }, gmTuned(&tune_default, null, null, 4096, 6, 384, false, 6, 6));
     try std.testing.expectEqual([2]usize{ 5, 4 }, gmTuned(&tune_default, 5, 4, 4096, 6, 384, false, 6, 6));
+    try std.testing.expectEqual([2]usize{ 5, 3 }, v3_default.gu);
+    try std.testing.expectEqual(@as(usize, 9), v3_default.dn);
+    for ([_]usize{ v3_default.gu[0], v3_default.gu[1], v3_default.dn }) |vi| {
+        const v = @import("exl3_block_x3gm.zig").v3_variants[vi];
+        const s3 = gm2Shape(v.mats, v.xm, v.t);
+        try std.testing.expectEqual(@as(u32, 1), v.lean);
+        try std.testing.expectEqual(@as(u32, 4), v.t[2]);
+        try std.testing.expect(s3.smem + 4 * 8 * v.t[1] + 4 <= gm_smem_max);
+    }
 }
 
