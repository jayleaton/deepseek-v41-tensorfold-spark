From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Tue, 3 Nov 2026 05:45:16 +0700
Subject: [PATCH 153/207] graph route: plan widths include T1's 256 and refuse
 past the table (a 129-256 digit cell hit unreachable); pow names its 256
 width

b047d48c8 raised packet.max_digits to 256 but plan() stopped at 128, so add/sub/mul needing 129-256 digits reached
'else unreachable' (a panic in the engine, on v4 and v5 banks alike), and a 129-256 digit power named the 128 plan
(3^400 routed to pow-400-128 on v4). Plans the bank lacks refuse at lowering (bank.plan orelse null).
---
 zig/src/core/runner_graph_route.zig | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/zig/src/core/runner_graph_route.zig b/zig/src/core/runner_graph_route.zig
index 81e078045c2937fa910c1adef06a37fb935873bd..10687c66773fd934e6c0b78987f2c6d5b94b863d 100644
--- a/zig/src/core/runner_graph_route.zig
+++ b/zig/src/core/runner_graph_route.zig
@@ -161,9 +161,10 @@ fn plan(a: Allocator, f: Family, dl: u32, dr: u32) error{ Unsupported, OutOfMemo
         .pow => unreachable,
     };
     if (needed > max_digits) return error.Unsupported;
-    const width = for ([_]u8{ 1, 2, 4, 8, 16, 32, 62, 128 }) |n| {
+    // 256: T1's b047d48c8 widths; a bank without that plan (v4, or div/mod) refuses at lowering, never here
+    const width = for ([_]u16{ 1, 2, 4, 8, 16, 32, 62, 128, 256 }) |n| {
         if (n >= needed) break n;
-    } else unreachable;
+    } else return error.Unsupported;
     return std.fmt.allocPrint(a, "{t}-{d}", .{ f, width });
 }
 
@@ -244,7 +245,7 @@ pub fn shape(arena: Allocator, src: []const u8) Allocator.Error!?Shape {
             .literal => continue,
             .neg => plan(arena, .sub, 1, n.digits),
             .binary => plan(arena, n.family, nodes[n.l].digits, nodes[n.r].digits),
-            .pow => std.fmt.allocPrint(arena, "pow-{d}-{d}", .{ n.k, @as(u32, if (n.digits > 62) 128 else 62) }),
+            .pow => std.fmt.allocPrint(arena, "pow-{d}-{d}", .{ n.k, @as(u32, if (n.digits > 128) 256 else if (n.digits > 62) 128 else 62) }),
         } catch |e| return if (e == error.OutOfMemory) error.OutOfMemory else null;
     }
     return .{ .nodes = nodes, .root = root, .live = live, .plans = plans };
