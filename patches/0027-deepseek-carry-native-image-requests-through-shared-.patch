@@ -0,0 +1,226 @@
+//! libjpeg-turbo 3.1's sample side as Pillow decodes with it (JDCT_ISLOW, fancy upsampling, no merged upsampling):
+const std = @import("std");
+
+const CONST_BITS = 13;
+const PASS1_BITS = 2;
+const F0_298631336 = 2446;
+const F0_390180644 = 3196;
+const F0_541196100 = 4433;
+const F0_765366865 = 6270;
+const F0_899976223 = 7373;
+const F1_175875602 = 9633;
+const F1_501321110 = 12299;
+const F1_847759065 = 15137;
+const F1_961570560 = 16069;
+const F2_053119869 = 16819;
+const F2_562915447 = 20995;
+const F3_072711026 = 25172;
+
+fn descale(x: i64, comptime n: u6) i64 {
+    return (x + (@as(i64, 1) << (n - 1))) >> n;
+}
+
+/// The post-IDCT range limit (``IDCT_range_limit`` [x & RANGE_MASK]): the 10-bit wrapped value + 128, clamped.
+fn limit(x: i64) u8 {
+    const v: i64 = @as(i64, @as(i10, @truncate(x))) + 128;
+    return @intCast(std.math.clamp(v, 0, 255));
+}
+
+/// One 8x8 block: coefficients in natural order, the quantization table, 8 output rows of ``stride``.
+pub fn idctIslow(coef: *const [64]i16, quant: *const [64]u16, out: []u8, stride: usize) void {
+    var ws: [64]i64 = undefined;
+    for (0..8) |c| {
+        const in = struct {
+            fn at(cf: *const [64]i16, q: *const [64]u16, col: usize, r: usize) i64 {
+                return @as(i64, cf[r * 8 + col]) * q[r * 8 + col];
+            }
+        }.at;
+        if (coef[8 + c] == 0 and coef[16 + c] == 0 and coef[24 + c] == 0 and coef[32 + c] == 0 and coef[40 + c] == 0 and coef[48 + c] == 0 and coef[56 + c] == 0) {
+            const dc = in(coef, quant, c, 0) << PASS1_BITS;
+            for (0..8) |r| ws[r * 8 + c] = dc;
+            continue;
+        }
+        var z2 = in(coef, quant, c, 2);
+        var z3 = in(coef, quant, c, 6);
+        const z1 = (z2 + z3) * F0_541196100;
+        var tmp2 = z1 + z3 * -F1_847759065;
+        var tmp3 = z1 + z2 * F0_765366865;
+        z2 = in(coef, quant, c, 0);
+        z3 = in(coef, quant, c, 4);
+        var tmp0 = (z2 + z3) << CONST_BITS;
+        var tmp1 = (z2 - z3) << CONST_BITS;
+        const tmp10 = tmp0 + tmp3;
+        const tmp13 = tmp0 - tmp3;
+        const tmp11 = tmp1 + tmp2;
+        const tmp12 = tmp1 - tmp2;
+        tmp0 = in(coef, quant, c, 7);
+        tmp1 = in(coef, quant, c, 5);
+        tmp2 = in(coef, quant, c, 3);
+        tmp3 = in(coef, quant, c, 1);
+        odd(&tmp0, &tmp1, &tmp2, &tmp3);
+        const n = CONST_BITS - PASS1_BITS;
+        ws[0 * 8 + c] = descale(tmp10 + tmp3, n);
+        ws[7 * 8 + c] = descale(tmp10 - tmp3, n);
+        ws[1 * 8 + c] = descale(tmp11 + tmp2, n);
+        ws[6 * 8 + c] = descale(tmp11 - tmp2, n);
+        ws[2 * 8 + c] = descale(tmp12 + tmp1, n);
+        ws[5 * 8 + c] = descale(tmp12 - tmp1, n);
+        ws[3 * 8 + c] = descale(tmp13 + tmp0, n);
+        ws[4 * 8 + c] = descale(tmp13 - tmp0, n);
+    }
+    for (0..8) |r| {
+        const w = ws[r * 8 ..][0..8];
+        const o = out[r * stride ..][0..8];
+        const n = CONST_BITS + PASS1_BITS + 3;
+        if (w[1] == 0 and w[2] == 0 and w[3] == 0 and w[4] == 0 and w[5] == 0 and w[6] == 0 and w[7] == 0) {
+            @memset(o, limit(descale(w[0], PASS1_BITS + 3)));
+            continue;
+        }
+        const z1 = (w[2] + w[6]) * F0_541196100;
+        var tmp2 = z1 + w[6] * -F1_847759065;
+        var tmp3 = z1 + w[2] * F0_765366865;
+        var tmp0 = (w[0] + w[4]) << CONST_BITS;
+        var tmp1 = (w[0] - w[4]) << CONST_BITS;
+        const tmp10 = tmp0 + tmp3;
+        const tmp13 = tmp0 - tmp3;
+        const tmp11 = tmp1 + tmp2;
+        const tmp12 = tmp1 - tmp2;
+        tmp0 = w[7];
+        tmp1 = w[5];
+        tmp2 = w[3];
+        tmp3 = w[1];
+        odd(&tmp0, &tmp1, &tmp2, &tmp3);
+        o[0] = limit(descale(tmp10 + tmp3, n));
+        o[7] = limit(descale(tmp10 - tmp3, n));
+        o[1] = limit(descale(tmp11 + tmp2, n));
+        o[6] = limit(descale(tmp11 - tmp2, n));
+        o[2] = limit(descale(tmp12 + tmp1, n));
+        o[5] = limit(descale(tmp12 - tmp1, n));
+        o[3] = limit(descale(tmp13 + tmp0, n));
+        o[4] = limit(descale(tmp13 - tmp0, n));
+    }
+}
+
+/// The odd part (figure 8), shared by both passes: in y7, y5, y3, y1, out the four terms.
+fn odd(t0: *i64, t1: *i64, t2: *i64, t3: *i64) void {
+    const z1 = t0.* + t3.*;
+    const z2 = t1.* + t2.*;
+    var z3 = t0.* + t2.*;
+    var z4 = t1.* + t3.*;
+    const z5 = (z3 + z4) * F1_175875602;
+    const a = t0.* * F0_298631336;
+    const b = t1.* * F2_053119869;
+    const c = t2.* * F3_072711026;
+    const d = t3.* * F1_501321110;
+    const m1 = z1 * -F0_899976223;
+    const m2 = z2 * -F2_562915447;
+    z3 = z3 * -F1_961570560 + z5;
+    z4 = z4 * -F0_390180644 + z5;
+    t0.* = a + m1 + z3;
+    t1.* = b + m2 + z4;
+    t2.* = c + m2 + z3;
+    t3.* = d + m1 + z4;
+}
+
+/// A component plane after the IDCT: ``w`` x ``h`` real samples (``downsampled_width`` / ``_height``) in rows of
+pub const Plane = struct { data: []const u8, stride: usize, w: usize, h: usize };
+
+/// One output row ``y`` of a component upsampled by (hx, vy) into ``out`` (at least w * hx + 1 bytes), libjpeg's
+pub fn upsampleRow(p: Plane, hx: usize, vy: usize, fancy: bool, y: usize, out: []u8) void {
+    const r = y / vy;
+    const row = p.data[@min(r, p.h - 1) * p.stride ..][0..p.w];
+    if (hx == 1 and vy == 1) return @memcpy(out[0..p.w], row);
+    if (vy == 2 and fancy and (hx == 1 or (hx == 2 and p.w > 2))) {
+        const below = (y % 2) == 1; // v == 1: next nearest is the row below
+        const nr = if (below) @min(r + 1, p.h - 1) else (if (r == 0) 0 else r - 1);
+        const near = p.data[@min(r, p.h - 1) * p.stride ..][0..p.w];
+        const far = p.data[nr * p.stride ..][0..p.w];
+        if (hx == 1) {
+            const bias: i32 = if (below) 2 else 1;
+            for (0..p.w) |x| out[x] = @intCast((@as(i32, near[x]) * 3 + far[x] + bias) >> 2);
+            return;
+        }
+        var this: i32 = @as(i32, near[0]) * 3 + far[0];
+        var next: i32 = @as(i32, near[1]) * 3 + far[1];
+        out[0] = @intCast((this * 4 + 8) >> 4);
+        out[1] = @intCast((this * 3 + next + 7) >> 4);
+        var last = this;
+        this = next;
+        for (2..p.w) |x| {
+            next = @as(i32, near[x]) * 3 + far[x];
+            out[2 * x - 2] = @intCast((this * 3 + last + 8) >> 4);
+            out[2 * x - 1] = @intCast((this * 3 + next + 7) >> 4);
+            last = this;
+            this = next;
+        }
+        out[2 * p.w - 2] = @intCast((this * 3 + last + 8) >> 4);
+        out[2 * p.w - 1] = @intCast((this * 4 + 7) >> 4);
+        return;
+    }
+    if (hx == 2 and vy == 1 and fancy and p.w > 2) {
+        out[0] = row[0];
+        out[1] = @intCast((@as(i32, row[0]) * 3 + row[1] + 2) >> 2);
+        for (1..p.w - 1) |x| {
+            const v = @as(i32, row[x]) * 3;
+            out[2 * x] = @intCast((v + row[x - 1] + 1) >> 2);
+            out[2 * x + 1] = @intCast((v + row[x + 1] + 2) >> 2);
+        }
+        const v = @as(i32, row[p.w - 1]);
+        out[2 * p.w - 2] = @intCast((v * 3 + row[p.w - 2] + 1) >> 2);
+        out[2 * p.w - 1] = @intCast(v);
+        return;
+    }
+    for (0..p.w) |x| @memset(out[x * hx ..][0..hx], row[x]); // h2v1 / h2v2 plain, int_upsample: replicate
+}
+
+const SCALEBITS = 16;
+const ONE_HALF: i32 = 1 << (SCALEBITS - 1);
+fn fix(comptime x: f64) i32 {
+    return @intFromFloat(x * 65536.0 + 0.5);
+}
+
+/// ``build_ycc_rgb_table``, as one table of 4 x 256.
+pub const Ycc = struct {
+    cr_r: [256]i32,
+    cb_b: [256]i32,
+    cr_g: [256]i32,
+    cb_g: [256]i32,
+
+    pub fn init() Ycc {
+        var t: Ycc = undefined;
+        for (0..256) |i| {
+            const x: i32 = @as(i32, @intCast(i)) - 128;
+            t.cr_r[i] = (fix(1.40200) * x + ONE_HALF) >> SCALEBITS;
+            t.cb_b[i] = (fix(1.77200) * x + ONE_HALF) >> SCALEBITS;
+            t.cr_g[i] = -fix(0.71414) * x;
+            t.cb_g[i] = -fix(0.34414) * x + ONE_HALF;
+        }
+        return t;
+    }
+
+    /// One pixel: Y, Cb, Cr -> R, G, B.
+    pub fn rgb(t: *const Ycc, y: u8, cb: u8, cr: u8, out: *[3]u8) void {
+        const yy: i32 = y;
+        out[0] = clamp(yy + t.cr_r[cr]);
+        out[1] = clamp(yy + ((t.cb_g[cb] + t.cr_g[cr]) >> SCALEBITS));
+        out[2] = clamp(yy + t.cb_b[cb]);
+    }
+};
+
+fn clamp(v: i32) u8 {
+    return @intCast(std.math.clamp(v, 0, 255));
+}
+
+test "the islow IDCT of a DC-only block is the level shift of the DC" {
+    var coef: [64]i16 = @splat(0);
+    var q: [64]u16 = @splat(1);
+    coef[0] = 80; // 80 * 1 << 2, >> 5 ... = 10 -> 138
+    q[0] = 1;
+    var out: [64]u8 = undefined;
+    idctIslow(&coef, &q, &out, 8);
+    for (out) |v| try std.testing.expectEqual(@as(u8, 138), v);
+    const t = Ycc.init();
+    var px: [3]u8 = undefined;
+    t.rgb(128, 128, 128, &px);
+    try std.testing.expectEqualSlices(u8, &.{ 128, 128, 128 }, &px);
+}
diff --git a/zig/src/families/deepseek_v41/vision/pixels.zig b/zig/src/families/deepseek_v41/vision/pixels.zig
new file mode 100644
index 0000000000000000000000000000000000000000..198abfa4aceb9419c4dd45400d459721c4ae815f
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision/pixels.zig
@@ -0,0 +1,129 @@
+//! Decoded images and Pillow's conversions to RGB (``glm5_next/spark/vision_prep.to_rgb``: transparency composited
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+/// Pillow's mode of a decoded image. ``bilevel`` ("1") is stored as 0 / 255 bytes, ``i16`` ("I;16") as native u16.
+pub const Mode = enum { bilevel, l, la, rgb, rgba, p, i16, cmyk };
+
+pub fn channels(m: Mode) usize {
+    return switch (m) {
+        .bilevel, .l, .p => 1,
+        .la, .i16 => 2,
+        .rgb => 3,
+        .rgba, .cmyk => 4,
+    };
+}
+
+/// One decoded frame. ``palette`` is RGBA x 256 (Pillow's: unset entries (0, 0, 0, 255)); ``transparent`` is
+pub const Image = struct {
+    w: u32,
+    h: u32,
+    mode: Mode,
+    data: []u8,
+    palette: [1024]u8 = defaultPalette(),
+    transparent: bool = false,
+
+    pub fn deinit(im: *Image, gpa: Allocator) void {
+        gpa.free(im.data);
+        im.* = undefined;
+    }
+
+    pub fn pixels(im: *const Image) usize {
+        return @as(usize, im.w) * im.h;
+    }
+};
+
+pub fn defaultPalette() [1024]u8 {
+    var p: [1024]u8 = @splat(0);
+    for (0..256) |i| p[i * 4 + 3] = 255;
+    return p;
+}
+
+/// An RGB image, 3 bytes a pixel, rows top first.
+pub const Rgb = struct {
+    w: u32,
+    h: u32,
+    data: []u8,
+
+    pub fn deinit(im: *Rgb, gpa: Allocator) void {
+        gpa.free(im.data);
+        im.* = undefined;
+    }
+};
+
+/// ``to_rgb``: the image as Pillow's RGB, consuming ``im``'s buffer when it already is RGB.
+pub fn toRgb(gpa: Allocator, im: *Image) Allocator.Error!Rgb {
+    const n = im.pixels();
+    if (im.mode == .rgb) {
+        const out: Rgb = .{ .w = im.w, .h = im.h, .data = im.data };
+        im.data = &.{};
+        return out;
+    }
+    const out = try gpa.alloc(u8, n * 3);
+    errdefer gpa.free(out);
+    const src = im.data;
+    switch (im.mode) {
+        .rgb => unreachable,
+        .bilevel, .l => for (0..n) |i| {
+            @memset(out[i * 3 ..][0..3], src[i]);
+        },
+        .i16 => {
+            const v: []align(1) const u16 = std.mem.bytesAsSlice(u16, src[0 .. n * 2]);
+            for (0..n) |i| @memset(out[i * 3 ..][0..3], if (v[i] < 256) @intCast(v[i]) else 255);
+        },
+        .p => for (0..n) |i| {
+            const e = im.palette[@as(usize, src[i]) * 4 ..][0..4];
+            if (im.transparent) composite(out[i * 3 ..][0..3], e[0], e[1], e[2], e[3]) else @memcpy(out[i * 3 ..][0..3], e[0..3]);
+        },
+        .la => for (0..n) |i| composite(out[i * 3 ..][0..3], src[i * 2], src[i * 2], src[i * 2], src[i * 2 + 1]),
+        .rgba => for (0..n) |i| {
+            const s = src[i * 4 ..][0..4];
+            composite(out[i * 3 ..][0..3], s[0], s[1], s[2], s[3]);
+        },
+        .cmyk => for (0..n) |i| {
+            const s = src[i * 4 ..][0..4];
+            const nk: i32 = 255 - @as(i32, s[3]);
+            for (0..3) |c| out[i * 3 + c] = clip8(nk - mulDiv255(s[c], nk));
+        },
+    }
+    return .{ .w = im.w, .h = im.h, .data = out };
+}
+
+/// Pillow's ``MULDIV255``: round(a * b / 255) the integer way.
+fn mulDiv255(a: u8, b: i32) i32 {
+    const tmp = @as(i32, a) * b + 128;
+    return (tmp + (tmp >> 8)) >> 8;
+}
+
+fn clip8(v: i32) u8 {
+    return @intCast(std.math.clamp(v, 0, 255));
+}
+
+/// ``ImagingAlphaComposite`` of (r, g, b, a) over opaque white, then ``convert("RGB")`` (alpha dropped).
+fn composite(out: *[3]u8, r: u8, g: u8, b: u8, a: u8) void {
+    if (a == 0) {
+        out.* = .{ 255, 255, 255 };
+        return;
+    }
+    const prec = 7;
+    const blend: u32 = 255 * (255 - @as(u32, a));
+    const outa255: u32 = @as(u32, a) * 255 + blend;
+    const coef1: u32 = @as(u32, a) * 255 * 255 * (1 << prec) / outa255;
+    const coef2: u32 = 255 * (1 << prec) - coef1;
+    const src = [3]u32{ r, g, b };
+    for (0..3) |c| {
+        const t = src[c] * coef1 + 255 * coef2 + (0x80 << prec);
+        out[c] = @intCast((((t >> 8) + t) >> 8) >> prec);
+    }
+}
+
+test "alpha over white and the palette defaults read as Pillow's" {
+    var o: [3]u8 = undefined;
+    composite(&o, 0, 0, 0, 255);
+    try std.testing.expectEqualSlices(u8, &.{ 0, 0, 0 }, &o);
+    composite(&o, 10, 20, 30, 0);
+    try std.testing.expectEqualSlices(u8, &.{ 255, 255, 255 }, &o);
+    composite(&o, 0, 0, 0, 128);
+    try std.testing.expectEqual(@as(u8, 127), o[0]); // Image.alpha_composite((255,)*4, (0,0,0,128)) -> 127
+    try std.testing.expectEqual(@as(u8, 255), defaultPalette()[3]);
+}
diff --git a/zig/src/families/deepseek_v41/vision/png.zig b/zig/src/families/deepseek_v41/vision/png.zig
new file mode 100644
index 0000000000000000000000000000000000000000..fc9eacf7b154b6b7468f27f2ebcb052b50b22253
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision/png.zig
@@ -0,0 +1,253 @@
+//! PNG as Pillow 12.3 opens it (``PngImagePlugin`` + ``ZipDecode``): the mode table ``_MODES`` (16-bit samples keep
+const std = @import("std");
+const pixels = @import("pixels.zig");
+const Allocator = std.mem.Allocator;
+const Image = pixels.Image;
+
+pub const Error = error{ BadPng, UnsupportedPng, TooManyPixels } || Allocator.Error;
+
+pub const signature = "\x89PNG\r\n\x1a\n";
+
+const Header = struct {
+    w: u32,
+    h: u32,
+    depth: u8,
+    color: u8,
+    interlace: bool,
+    mode: pixels.Mode,
+
+    fn bpp(hd: Header) usize { // bytes a pixel for the filters (at least 1)
+        return @max(1, hd.bitsPerPixel() / 8);
+    }
+    fn bitsPerPixel(hd: Header) usize {
+        const n: usize = switch (hd.color) {
+            0, 3 => 1,
+            2 => 3,
+            4 => 2,
+            6 => 4,
+            else => unreachable,
+        };
+        return n * hd.depth;
+    }
+    fn rowBytes(hd: Header, w: usize) usize {
+        return (w * hd.bitsPerPixel() + 7) / 8;
+    }
+};
+
+fn modeOf(depth: u8, color: u8) ?pixels.Mode {
+    return switch (color) {
+        0 => switch (depth) {
+            1 => .bilevel,
+            2, 4, 8 => .l,
+            16 => .i16,
+            else => null,
+        },
+        2 => if (depth == 8 or depth == 16) .rgb else null,
+        3 => if (depth <= 8 and std.math.isPowerOfTwo(depth)) .p else null,
+        4 => if (depth == 8) .la else if (depth == 16) .rgba else null,
+        6 => if (depth == 8 or depth == 16) .rgba else null,
+        else => null,
+    };
+}
+
+fn be32(b: []const u8) u32 {
+    return std.mem.readInt(u32, b[0..4], .big);
+}
+
+/// Width and height from the header alone (the pixel cap is checked before decoding).
+pub fn size(raw: []const u8) Error![2]u32 {
+    if (raw.len < 33 or !std.mem.eql(u8, raw[0..8], signature) or !std.mem.eql(u8, raw[12..16], "IHDR")) return error.BadPng;
+    return .{ be32(raw[16..20]), be32(raw[20..24]) };
+}
+
+pub fn decode(gpa: Allocator, raw: []const u8, max_pixels: u64) Error!Image {
+    if (raw.len < 8 or !std.mem.eql(u8, raw[0..8], signature)) return error.BadPng;
+    var at: usize = 8;
+    var hd: ?Header = null;
+    var palette = pixels.defaultPalette();
+    var transparent = false;
+    var idat: std.ArrayList(u8) = .empty;
+    defer idat.deinit(gpa);
+    var seen_idat = false;
+    while (at + 12 <= raw.len) {
+        const len = be32(raw[at..]);
+        if (len > raw.len - at - 12) return error.BadPng;
+        const cid = raw[at + 4 .. at + 8];
+        const data = raw[at + 8 .. at + 8 + len];
+        const crc = be32(raw[at + 8 + len ..]);
+        at += 12 + len;
+        if (std.mem.eql(u8, cid, "IDAT")) {
+            if (hd == null) return error.BadPng;
+            if (seen_idat and idat.items.len == 0) return error.BadPng;
+            seen_idat = true;
+            try idat.appendSlice(gpa, data);
+            continue;
+        }
+        if (seen_idat) { // Pillow reads the image's consecutive IDAT chunks, then stops
+            if (idat.items.len > 0) break;
+            continue;
+        }
+        var c = std.hash.Crc32.init();
+        c.update(cid);
+        c.update(data);
+        if (c.final() != crc) return error.BadPng;
+        if (std.mem.eql(u8, cid, "IHDR")) {
+            if (len < 13) return error.BadPng;
+            if (data[11] != 0) return error.BadPng;
+            const mode = modeOf(data[8], data[9]) orelse return error.UnsupportedPng;
+            hd = .{ .w = be32(data[0..]), .h = be32(data[4..]), .depth = data[8], .color = data[9], .interlace = data[12] != 0, .mode = mode };
+            if (hd.?.w == 0 or hd.?.h == 0) return error.BadPng;
+            if (@as(u64, hd.?.w) * hd.?.h > max_pixels) return error.TooManyPixels;
+        } else if (std.mem.eql(u8, cid, "PLTE")) {
+            if (hd == null or hd.?.mode != .p) continue;
+            const n = @min(len / 3, 256);
+            for (0..n) |i| @memcpy(palette[i * 4 ..][0..3], data[i * 3 ..][0..3]);
+        } else if (std.mem.eql(u8, cid, "tRNS")) {
+            if (hd == null or hd.?.mode != .p) continue;
+            var simple_zero = false; // ``_simple_palette``: one 0, the rest 255
+            var zeros: usize = 0;
+            var others = false;
+            for (data) |v| {
+                if (v == 0) zeros += 1 else if (v != 255) others = true;
+            }
+            simple_zero = zeros == 1 and !others;
+            if (simple_zero) {
+                const i = std.mem.indexOfScalar(u8, data, 0).?;
+                palette[i * 4 + 3] = 0;
+                transparent = true;
+            } else if (zeros > 0 or others or data.len > 0) {
+                for (data[0..@min(data.len, 256)], 0..) |v, i| palette[i * 4 + 3] = v;
+                transparent = true;
+            }
+        } else if (std.mem.eql(u8, cid, "IEND")) break;
+    }
+    const h = hd orelse return error.BadPng;
+    if (idat.items.len < 2) return error.BadPng;
+    const rows = try inflate(gpa, h, idat.items);
+    defer gpa.free(rows);
+    var im: Image = .{ .w = h.w, .h = h.h, .mode = h.mode, .data = try gpa.alloc(u8, @as(usize, h.w) * h.h * pixels.channels(h.mode)), .palette = palette, .transparent = transparent };
+    errdefer im.deinit(gpa);
+    try unfilterAll(gpa, h, rows, &im);
+    return im;
+}
+
+const passes = [7][4]u8{ .{ 0, 0, 8, 8 }, .{ 4, 0, 8, 8 }, .{ 0, 4, 4, 8 }, .{ 2, 0, 4, 4 }, .{ 0, 2, 2, 4 }, .{ 1, 0, 2, 2 }, .{ 0, 1, 1, 2 } };
+
+fn passDims(h: Header, p: [4]u8) [2]usize {
+    if (!h.interlace) return .{ h.w, h.h };
+    const w = if (h.w > p[0]) (h.w - p[0] + p[2] - 1) / p[2] else 0;
+    const ht = if (h.h > p[1]) (h.h - p[1] + p[3] - 1) / p[3] else 0;
+    return .{ w, ht };
+}
+
+/// The filtered scanlines: IDAT's zlib stream (header skipped, the checksum not required, as ZipDecode stops once
+fn inflate(gpa: Allocator, h: Header, z: []const u8) Error![]u8 {
+    var total: usize = 0;
+    const n_pass: usize = if (h.interlace) 7 else 1;
+    for (passes[0..n_pass]) |p| {
+        const d = passDims(h, if (h.interlace) p else .{ 0, 0, 1, 1 });
+        if (d[0] > 0 and d[1] > 0) total += d[1] * (1 + h.rowBytes(d[0]));
+    }
+    if ((z[0] & 0x0f) != 8 or (z[1] & 0x20) != 0 or ((@as(u16, z[0]) << 8) | z[1]) % 31 != 0) return error.BadPng;
+    const out = try gpa.alloc(u8, total);
+    errdefer gpa.free(out);
+    var in: std.Io.Reader = .fixed(z[2..]);
+    var window: [std.compress.flate.max_window_len]u8 = undefined;
+    var dec: std.compress.flate.Decompress = .init(&in, .raw, &window);
+    dec.reader.readSliceAll(out) catch return error.BadPng;
+    return out;
+}
+
+fn paeth(a: u8, b: u8, c: u8) u8 {
+    const p = @as(i16, a) + b - c;
+    const pa = @abs(p - a);
+    const pb = @abs(p - b);
+    const pc = @abs(p - c);
+    if (pa <= pb and pa <= pc) return a;
+    if (pb <= pc) return b;
+    return c;
+}
+
+/// Undo one row's filter in place against the previous (unfiltered) row.
+fn unfilter(kind: u8, row: []u8, prev: []const u8, bpp: usize) Error!void {
+    switch (kind) {
+        0 => {},
+        1 => for (bpp..row.len) |i| {
+            row[i] +%= row[i - bpp];
+        },
+        2 => for (row, prev) |*x, b| {
+            x.* +%= b;
+        },
+        3 => for (row, 0..) |*x, i| {
+            const a: u16 = if (i >= bpp) row[i - bpp] else 0;
+            x.* +%= @intCast((a + prev[i]) >> 1);
+        },
+        4 => for (row, 0..) |*x, i| {
+            const a = if (i >= bpp) row[i - bpp] else 0;
+            const c = if (i >= bpp) prev[i - bpp] else 0;
+            x.* +%= paeth(a, prev[i], c);
+        },
+        else => return error.BadPng,
+    }
+}
+
+fn unfilterAll(gpa: Allocator, h: Header, rows: []u8, im: *Image) Error!void {
+    const bpp = h.bpp();
+    const zero = try gpa.alloc(u8, h.rowBytes(h.w));
+    defer gpa.free(zero);
+    @memset(zero, 0);
+    var at: usize = 0;
+    const n_pass: usize = if (h.interlace) 7 else 1;
+    for (0..n_pass) |pi| {
+        const p = if (h.interlace) passes[pi] else [4]u8{ 0, 0, 1, 1 };
+        const d = passDims(h, p);
+        if (d[0] == 0 or d[1] == 0) continue;
+        const rb = h.rowBytes(d[0]);
+        var prev: []const u8 = zero[0..rb];
+        for (0..d[1]) |y| {
+            const kind = rows[at];
+            const row = rows[at + 1 .. at + 1 + rb];
+            try unfilter(kind, row, prev, bpp);
+            store(h, im, row, p[1] + y * p[3], p[0], p[2], d[0]);
+            prev = row;
+            at += 1 + rb;
+        }
+    }
+}
+
+/// One unfiltered row into the image at row ``y``, pixels ``x0 + i dx``, in Pillow's mode.
+fn store(h: Header, im: *Image, row: []const u8, y: usize, x0: usize, dx: usize, n: usize) void {
+    const ch = pixels.channels(h.mode);
+    const line = im.data[y * @as(usize, h.w) * ch ..][0 .. @as(usize, h.w) * ch];
+    for (0..n) |i| {
+        const x = x0 + i * dx;
+        const o = line[x * ch ..][0..ch];
+        switch (h.depth) {
+            1, 2, 4 => {
+                const bits = i * h.depth;
+                const v = (row[bits / 8] >> @intCast(8 - h.depth - bits % 8)) & ((@as(u8, 1) << @intCast(h.depth)) - 1);
+                o[0] = if (h.mode == .p) v else switch (h.depth) {
+                    1 => if (v != 0) 255 else 0,
+                    2 => v * 0x55,
+                    else => v * 0x11,
+                };
+            },
+            8 => if (h.color == 4 and h.mode == .la) @memcpy(o, row[i * 2 ..][0..2]) else @memcpy(o, row[i * ch ..][0..ch]),
+            16 => switch (h.color) {
+                0 => std.mem.writeInt(u16, o[0..2], std.mem.readInt(u16, row[i * 2 ..][0..2], .big), .native),
+                2 => for (0..3) |c| {
+                    o[c] = row[i * 6 + c * 2];
+                },
+                4 => { // "LA;16B" -> RGBA: L's high byte thrice, A's high byte
+                    @memset(o[0..3], row[i * 4]);
+                    o[3] = row[i * 4 + 2];
+                },
+                6 => for (0..4) |c| {
+                    o[c] = row[i * 8 + c * 2];
+                },
+                else => unreachable,
+            },
+            else => unreachable,
+        }
+    }
+}
diff --git a/zig/src/families/deepseek_v41/vision/prep.zig b/zig/src/families/deepseek_v41/vision/prep.zig
new file mode 100644
index 0000000000000000000000000000000000000000..32b5c7a4d4d7e7d154d97b26225d5435c96bd14a
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision/prep.zig
@@ -0,0 +1,281 @@
+//! Image grid selection, BF16 patch preprocessing and marker span geometry.
+const std = @import("std");
+const pixels = @import("pixels.zig");
+const resample = @import("resample.zig");
+const pyjson = @import("pyjson.zig");
+const Allocator = std.mem.Allocator;
+
+pub const VERSION = "tensorfold-dsv41-vision/1";
+pub const IMAGE_TOKEN: u32 = 129264;
+
+pub const Type = enum(i8) { text = -1, start = 0, image = 1, newline = 2, end = 3 };
+
+pub const Error = error{ NoGrid, BadSettings } || Allocator.Error;
+
+extern "c" fn pow(x: f64, y: f64) f64; // Python's float ** (libm), not a Zig reimplementation
+
+/// ``config.json``'s ``vision_config`` / ``image_token_id`` and the server's limits (``TF_DSV41_VISION_*``).
+pub const Settings = struct {
+    patch: u32 = 14,
+    downsample: u32 = 3,
+    max_tokens: u32 = 1024,
+    min_pixels: u64 = 544 * 544,
+    max_wh_ratio: ?f64 = null,
+    image_token: u32 = IMAGE_TOKEN,
+    vision_config: std.json.Value = .{ .object = .empty },
+    bias_vl: bool = false,
+    max_images: u32 = 8,
+    cap_tokens: u32 = 0,
+    fetch: bool = true,
+    fetch_timeout_s: f64 = 10,
+    fetch_total_s: f64 = 30,
+    max_bytes: usize = 20 * 1024 * 1024,
+    max_pixels: u64 = 64 * 1024 * 1024,
+    fetch_http: bool = false,
+    fetch_private: bool = false,
+    prep_slots: u32 = 8,
+    prep_mb: u64 = 256,
+
+    /// ``Settings.read``: ``config`` is config.json's text (null: the defaults), ``env`` the process environment.
+    pub fn read(arena: Allocator, config: ?[]const u8, env: ?*const std.process.Environ.Map, problem: *[]const u8) Error!Settings {
+        var s: Settings = .{};
+        if (config) |text| {
+            const root = std.json.parseFromSliceLeaky(std.json.Value, arena, text, .{}) catch return bad(problem, "config.json is not JSON");
+            if (root == .object) {
+                if (root.object.get("vision_config")) |vc| if (vc == .object) {
+                    s.vision_config = vc;
+                    s.patch = intOf(vc.object.get("patch_size"), s.patch);
+                    s.downsample = intOf(vc.object.get("downsample_ratio"), s.downsample);
+                    s.max_tokens = intOf(vc.object.get("max_image_tokens"), s.max_tokens);
+                    s.min_pixels = intOf(vc.object.get("min_pixels"), s.min_pixels);
+                    if (vc.object.get("max_wh_ratio")) |r| s.max_wh_ratio = switch (r) {
+                        .integer => |i| @floatFromInt(i),
+                        .float => |f| f,
+                        else => null,
+                    };
+                };
+                s.image_token = intOf(root.object.get("image_token_id"), s.image_token);
+            }
+        }
+        const m = env orelse return s;
+        s.bias_vl = std.mem.trim(u8, m.get("TF_DSV41_BIAS_VL") orelse "", " \t\r\n").len > 0;
+        s.max_images = try envInt(m, "TF_DSV41_VISION_MAX_IMAGES", s.max_images, problem);
+        s.cap_tokens = try envInt(m, "TF_DSV41_VISION_MAX_TOKENS", @as(u32, 0), problem);
+        s.fetch = try envFlag(m, "TF_DSV41_VISION_FETCH", true, problem);
+        s.fetch_timeout_s = try envFloat(m, "TF_DSV41_VISION_FETCH_TIMEOUT", 10, problem);
+        s.fetch_total_s = try envFloat(m, "TF_DSV41_VISION_FETCH_TOTAL_S", 30, problem);
+        s.max_bytes = try envInt(m, "TF_DSV41_VISION_MAX_BYTES", s.max_bytes, problem);
+        s.max_pixels = try envInt(m, "TF_DSV41_VISION_MAX_PIXELS", s.max_pixels, problem);
+        s.fetch_http = try envFlag(m, "TF_DSV41_VISION_FETCH_HTTP", false, problem);
+        s.fetch_private = try envFlag(m, "TF_DSV41_VISION_FETCH_PRIVATE", false, problem);
+        s.prep_slots = try envInt(m, "TF_DSV41_VISION_PREP_SLOTS", s.prep_slots, problem);
+        s.prep_mb = try envInt(m, "TF_DSV41_VISION_PREP_MB", s.prep_mb, problem);
+        if (s.max_images < 1 or s.prep_slots < 1) return bad(problem, "TF_DSV41_VISION_MAX_IMAGES >= 1, _MAX_TOKENS >= 0, _PREP_SLOTS >= 1");
+        if (s.cap_tokens != 0 and s.cap_tokens < 5) return bad(problem, "TF_DSV41_VISION_MAX_TOKENS: at least 5 (one row of one cell)");
+        return s;
+    }
+
+    pub fn budget(s: *const Settings) u32 {
+        return if (s.cap_tokens != 0) @min(s.max_tokens, s.cap_tokens) else s.max_tokens;
+    }
+
+    /// ``Settings.key``: what an image's rows depend on besides its patches.
+    pub fn key(s: *const Settings, w: *std.Io.Writer) std.Io.Writer.Error!void {
+        try w.writeAll("{\"bias_vl\": ");
+        try w.writeAll(if (s.bias_vl) "true" else "false");
+        try w.print(", \"downsample\": {d}, \"max_wh_ratio\": ", .{s.downsample});
+        if (s.max_wh_ratio) |r| try pyjson.float(w, r) else try w.writeAll("null");
+        try w.print(", \"min_pixels\": {d}, \"patch\": {d}, \"vision\": ", .{ s.min_pixels, s.patch });
+        try pyjson.dump(w, s.vision_config);
+        try w.writeByte('}');
+    }
+};
+
+fn bad(problem: *[]const u8, msg: []const u8) error{BadSettings} {
+    problem.* = msg;
+    return error.BadSettings;
+}
+
+fn intOf(v: ?std.json.Value, default: anytype) @TypeOf(default) {
+    const x = v orelse return default;
+    return switch (x) {
+        .integer => |i| std.math.cast(@TypeOf(default), i) orelse default,
+        .float => |f| if (f >= 0 and f < 1e15) @intFromFloat(f) else default,
+        else => default,
+    };
+}
+
+/// ``_env_int``: int(float(raw)).
+fn envInt(m: *const std.process.Environ.Map, name: []const u8, default: anytype, problem: *[]const u8) error{BadSettings}!@TypeOf(default) {
+    const raw = std.mem.trim(u8, m.get(name) orelse "", " \t\r\n");
+    if (raw.len == 0) return default;
+    const f = std.fmt.parseFloat(f64, raw) catch return bad(problem, name);
+    if (!(f >= 0) or f > 1e15) return bad(problem, name);
+    return std.math.cast(@TypeOf(default), @as(u64, @intFromFloat(@trunc(f)))) orelse bad(problem, name);
+}
+
+fn envFloat(m: *const std.process.Environ.Map, name: []const u8, default: f64, problem: *[]const u8) error{BadSettings}!f64 {
+    const raw = std.mem.trim(u8, m.get(name) orelse "", " \t\r\n");
+    if (raw.len == 0) return default;
+    return std.fmt.parseFloat(f64, raw) catch bad(problem, name);
+}
+
+fn envFlag(m: *const std.process.Environ.Map, name: []const u8, default: bool, problem: *[]const u8) error{BadSettings}!bool {
+    const raw = std.mem.trim(u8, m.get(name) orelse "", " \t\r\n");
+    if (raw.len == 0) return default;
+    if (std.mem.eql(u8, raw, "1")) return true;
+    if (std.mem.eql(u8, raw, "0")) return false;
+    return bad(problem, name);
+}
+
+pub fn spanLen(h: u32, w: u32) u32 {
+    return h * (w + 1) + 2;
+}
+
+/// ``llm_grid``: the aligner's grid of a pixel size.
+fn llmGrid(height: f64, width: f64, patch: u32, ratio: u32) [2]u32 {
+    const p: f64 = @floatFromInt(patch);
+    const r: f64 = @floatFromInt(ratio);
+    return .{ @intFromFloat(@ceil(@floor(height / p) / r)), @intFromFloat(@ceil(@floor(width / p) / r)) };
+}
+
+fn solve(height: f64, width: f64, patch: u32, ratio: u32, most: u32) [2]f64 {
+    const r = height / width;
+    const mostf: f64 = @floatFromInt(most);
+    const max_w = @sqrt((mostf - 2) / r + 0.25) - 0.5;
+    const max_h = max_w * r;
+    const cell: f64 = @floatFromInt(patch * ratio);
+    const p: f64 = @floatFromInt(patch);
+    if (max_w < 1.0) return .{ @as(f64, @floatFromInt((most - 2) / 2)) * cell, cell };
+    if (max_h < 1.0) return .{ cell, @as(f64, @floatFromInt(most - 3)) * cell };
+    const beta = @min(@floor(max_w) * cell / width, @floor(max_h) * cell / height);
+    return .{ @floor(height * beta / p) * p, @floor(width * beta / p) * p };
+}
+
+/// ``plan_grid``: (n_llm_h, n_llm_w, pixel height, pixel width) for an image of this size.
+pub fn plan(width0: u32, height0: u32, s: *const Settings) Error![4]u32 {
+    const most = s.budget();
+    if (width0 == 0 or height0 == 0 or s.patch == 0 or s.patch > 256 or
+        s.downsample == 0 or s.downsample > 16 or most < 5 or most > (1 << 16)) return error.BadSettings;
+    if (s.max_wh_ratio) |r| if (!std.math.isFinite(r) or r <= 0) return error.BadSettings;
+    var width: f64 = @floatFromInt(width0);
+    var height: f64 = @floatFromInt(height0);
+    const p: f64 = @floatFromInt(s.patch);
+    if (s.max_wh_ratio) |ratio| if (width > height * ratio) {
+        width = height * ratio;
+    };
+    const area = width * height;
+    const minp: f64 = @floatFromInt(s.min_pixels);
+    if (area > 0 and area < minp) {
+        const k = pow(minp / area, 0.5);
+        width = @trunc(width * k);
+        height = @trunc(height * k);
+    }
+    var bw = @ceil(width / p) * p;
+    var bh = @ceil(height / p) * p;
+    var g = llmGrid(bh, bw, s.patch, s.downsample);
+    if (spanLen(g[0], g[1]) > most) {
+        const hw = solve(height, width, s.patch, s.downsample, most);
+        bh = hw[0];
+        bw = hw[1];
+        g = llmGrid(bh, bw, s.patch, s.downsample);
+        if (spanLen(g[0], g[1]) > most) return error.NoGrid;
+    }
+    return .{ g[0], g[1], @intFromFloat(bh), @intFromFloat(bw) };
+}
+
+/// One preprocessed image: patches bf16 [vh vw, 3, 14, 14], the grids, its digest and virtual ids.
+pub const Prepared = struct {
+    patches: []u16,
+    vit_h: u32,
+    vit_w: u32,
+    llm_h: u32,
+    llm_w: u32,
+    digest: [32]u8,
+    size: [2]u32, // the original (width, height)
+    vids: []u32 = &.{},
+
+    pub fn tokens(p: *const Prepared) u32 {
+        return spanLen(p.llm_h, p.llm_w);
+    }
+
+    /// Span position ``i``'s type (``span_types``).
+    pub fn typeAt(p: *const Prepared, i: u32) Type {
+        if (i == 0) return .start;
+        if (i == p.tokens() - 1) return .end;
+        return if ((i - 1) % (p.llm_w + 1) == p.llm_w) .newline else .image;
+    }
+
+    pub fn deinit(p: *Prepared, gpa: Allocator) void {
+        gpa.free(p.patches);
+        gpa.free(p.vids);
+    }
+};
+
+/// ``(x / 255 - 0.5) / 0.5`` in float32, to bf16 round-to-nearest-even, for every byte value.
+pub const norm_table: [256]u16 = blk: {
+    var t: [256]u16 = undefined;
+    for (0..256) |i| {
+        const x: f32 = @as(f32, @floatFromInt(i)) / 255.0;
+        t[i] = bf16((x - 0.5) / 0.5);
+    }
+    break :blk t;
+};
+
+pub fn bf16(x: f32) u16 {
+    const b: u32 = @bitCast(x);
+    if (std.math.isNan(x)) return @intCast((b >> 16) | 0x40);
+    return @intCast((b + 0x7fff + ((b >> 16) & 1)) >> 16);
+}
+
+/// ``preprocess``: an RGB image -> its patches and digest (the virtual ids come from the registry).
+pub fn preprocess(gpa: Allocator, image: pixels.Rgb, s: *const Settings) Error!Prepared {
+    const g = try plan(image.w, image.h, s);
+    const bh = g[2];
+    const bw = g[3];
+    const p = s.patch;
+    const vh = bh / p;
+    const vw = bw / p;
+    var canvas = if (s.max_wh_ratio != null and @as(f64, @floatFromInt(image.w)) >= s.max_wh_ratio.? * @as(f64, @floatFromInt(image.h)))
+        try resample.resize(gpa, image, bw, bh)
+    else
+        try resample.pad(gpa, image, bw, bh, 127);
+    defer canvas.deinit(gpa);
+    const patches = try gpa.alloc(u16, @as(usize, vh) * vw * 3 * p * p);
+    errdefer gpa.free(patches);
+    // [vh, vw, 3, p, p] from the [h, w, 3] canvas: one patch row (p bytes) at a time per channel
+    const pp = @as(usize, p) * p;
+    for (0..vh) |py| for (0..vw) |px| {
+        const base = (py * vw + px) * 3 * pp;
+        for (0..p) |r| {
+            const src = canvas.data[((py * p + r) * @as(usize, bw) + px * p) * 3 ..][0 .. @as(usize, p) * 3];
+            for (0..p) |c| inline for (0..3) |ch| {
+                patches[base + ch * pp + r * p + c] = norm_table[src[c * 3 + ch]];
+            };
+        }
+    };
+    var h = std.crypto.hash.sha2.Sha256.init(.{});
+    h.update(VERSION);
+    var kbuf: [4096]u8 = undefined;
+    var kw: std.Io.Writer = .fixed(&kbuf);
+    s.key(&kw) catch return error.BadSettings;
+    h.update(kw.buffered());
+    var gbuf: [64]u8 = undefined;
+    h.update(std.fmt.bufPrint(&gbuf, "[{d}, {d}, {d}, {d}]", .{ vh, vw, g[0], g[1] }) catch unreachable);
+    h.update(std.mem.sliceAsBytes(patches)); // little-endian int16 view, as torch's numpy bytes
+    var digest: [32]u8 = undefined;
+    h.final(&digest);
+    return .{ .patches = patches, .vit_h = vh, .vit_w = vw, .llm_h = g[0], .llm_w = g[1], .digest = digest, .size = .{ image.w, image.h } };
+}
+
+test "span types and the planned grid of a small image" {
+    const s: Settings = .{};
+    const g = try plan(100, 50, &s); // scaled up to 544^2 area: 769 x 384 -> 770 x 392 -> grid 10 x 19 (h 392/14=28)
+    try std.testing.expect(spanLen(g[0], g[1]) <= 1024);
+    var pr: Prepared = .{ .patches = &.{}, .vit_h = 0, .vit_w = 0, .llm_h = 2, .llm_w = 3, .digest = undefined, .size = .{ 0, 0 } };
+    const want = [_]Type{ .start, .image, .image, .image, .newline, .image, .image, .image, .newline, .end };
+    try std.testing.expectEqual(@as(u32, 10), pr.tokens());
+    for (want, 0..) |t, i| try std.testing.expectEqual(t, pr.typeAt(@intCast(i)));
+    try std.testing.expectEqual(@as(u16, 0xbf80), norm_table[0]); // -1.0
+    try std.testing.expectEqual(@as(u16, 0x3f80), norm_table[255]); // 1.0
+}
diff --git a/zig/src/families/deepseek_v41/vision/pyjson.zig b/zig/src/families/deepseek_v41/vision/pyjson.zig
new file mode 100644
index 0000000000000000000000000000000000000000..92cbaa4f24ddcb20c1194669767fe9c57df3cf3b
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision/pyjson.zig
@@ -0,0 +1,123 @@
+//! Python's ``json.dumps(v, sort_keys=True)`` (separators ", " / ": ", ensure_ascii, float ``repr``) of a parsed
+const std = @import("std");
+const Writer = std.Io.Writer;
+
+pub fn dump(w: *Writer, v: std.json.Value) Writer.Error!void {
+    switch (v) {
+        .null => try w.writeAll("null"),
+        .bool => |b| try w.writeAll(if (b) "true" else "false"),
+        .integer => |i| try w.print("{d}", .{i}),
+        .number_string => |s| try w.writeAll(s),
+        .float => |f| try float(w, f),
+        .string => |s| try string(w, s),
+        .array => |a| {
+            try w.writeByte('[');
+            for (a.items, 0..) |x, i| {
+                if (i > 0) try w.writeAll(", ");
+                try dump(w, x);
+            }
+            try w.writeByte(']');
+        },
+        .object => |o| {
+            var keys_buf: [256][]const u8 = undefined;
+            const n = @min(o.count(), keys_buf.len);
+            for (o.keys()[0..n], 0..) |k, i| keys_buf[i] = k;
+            const keys = keys_buf[0..n];
+            std.mem.sort([]const u8, keys, {}, struct {
+                fn lt(_: void, a: []const u8, b: []const u8) bool {
+                    return lessUtf16(a, b);
+                }
+            }.lt);
+            try w.writeByte('{');
+            for (keys, 0..) |k, i| {
+                if (i > 0) try w.writeAll(", ");
+                try string(w, k);
+                try w.writeAll(": ");
+                try dump(w, o.get(k).?);
+            }
+            try w.writeByte('}');
+        },
+    }
+}
+
+/// Python sorts str keys by code point; for UTF-8 that is byte order.
+fn lessUtf16(a: []const u8, b: []const u8) bool {
+    return std.mem.order(u8, a, b) == .lt;
+}
+
+pub fn string(w: *Writer, s: []const u8) Writer.Error!void {
+    try w.writeByte('"');
+    var it = std.unicode.Utf8View.initUnchecked(s).iterator();
+    while (it.nextCodepoint()) |c| switch (c) {
+        '"' => try w.writeAll("\\\""),
+        '\\' => try w.writeAll("\\\\"),
+        '\n' => try w.writeAll("\\n"),
+        '\r' => try w.writeAll("\\r"),
+        '\t' => try w.writeAll("\\t"),
+        0x08 => try w.writeAll("\\b"),
+        0x0c => try w.writeAll("\\f"),
+        0x20...0x21, 0x23...0x5b, 0x5d...0x7e => try w.writeByte(@intCast(c)),
+        else => if (c >= 0x10000) {
+            const v = c - 0x10000;
+            try w.print("\\u{x:0>4}\\u{x:0>4}", .{ 0xD800 + (v >> 10), 0xDC00 + (v & 0x3ff) });
+        } else try w.print("\\u{x:0>4}", .{c}),
+    };
+    try w.writeByte('"');
+}
+
+/// ``float.__repr__``: the shortest round-trip digits, scientific when the exponent is < -4 or >= 16.
+pub fn float(w: *Writer, f: f64) Writer.Error!void {
+    if (std.math.isNan(f)) return w.writeAll("NaN");
+    if (std.math.isInf(f)) return w.writeAll(if (f > 0) "Infinity" else "-Infinity");
+    var buf: [64]u8 = undefined;
+    const e = std.fmt.bufPrint(&buf, "{e}", .{f}) catch unreachable; // d.ddde[-]x, shortest
+    var neg = false;
+    var s = e;
+    if (s[0] == '-') {
+        neg = true;
+        s = s[1..];
+    }
+    const epos = std.mem.indexOfScalar(u8, s, 'e').?;
+    const exp = std.fmt.parseInt(i32, s[epos + 1 ..], 10) catch unreachable;
+    var digits: [32]u8 = undefined;
+    var nd: usize = 0;
+    for (s[0..epos]) |c| if (c != '.') {
+        digits[nd] = c;
+        nd += 1;
+    };
+    while (nd > 1 and digits[nd - 1] == '0') nd -= 1;
+    if (neg) try w.writeByte('-');
+    if (exp < -4 or exp >= 16) {
+        try w.writeByte(digits[0]);
+        if (nd > 1) {
+            try w.writeByte('.');
+            try w.writeAll(digits[1..nd]);
+        }
+        try w.print("e{c}{d:0>2}", .{ @as(u8, if (exp < 0) '-' else '+'), @abs(exp) });
+    } else if (exp < 0) {
+        try w.writeAll("0.");
+        for (0..@intCast(-exp - 1)) |_| try w.writeByte('0');
+        try w.writeAll(digits[0..nd]);
+    } else {
+        const ip: usize = @intCast(exp + 1);
+        for (0..ip) |i| try w.writeByte(if (i < nd) digits[i] else '0');
+        try w.writeByte('.');
+        if (nd > ip) try w.writeAll(digits[ip..nd]) else try w.writeByte('0');
+    }
+}
+
+test "floats and objects as Python's json.dumps" {
+    var buf: [256]u8 = undefined;
+    var w: Writer = .fixed(&buf);
+    for ([_]f64{ 1.0, 0.1, 1e-5, 1e16, 123.456, 0.0001, 2.5e20, -3.0 }) |f| {
+        try float(&w, f);
+        try w.writeByte(' ');
+    }
+    try std.testing.expectEqualStrings("1.0 0.1 1e-05 1e+16 123.456 0.0001 2.5e+20 -3.0 ", w.buffered());
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const v = try std.json.parseFromSliceLeaky(std.json.Value, arena.allocator(), "{\"b\": [1, null], \"a\": \"\\u00e9x\", \"c\": true}", .{});
+    var w2: Writer = .fixed(&buf);
+    try dump(&w2, v);
+    try std.testing.expectEqualStrings("{\"a\": \"\\u00e9x\", \"b\": [1, null], \"c\": true}", w2.buffered());
+}
diff --git a/zig/src/families/deepseek_v41/vision/resample.zig b/zig/src/families/deepseek_v41/vision/resample.zig
new file mode 100644
index 0000000000000000000000000000000000000000..a26cc0592d67cc2cfd7a6034216220075b380585
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision/resample.zig
@@ -0,0 +1,173 @@
+//! Pillow 12.3's ``Image.resize(size, BICUBIC)`` of an RGB image (``Resample.c``: double coefficients per output
+const std = @import("std");
+const pixels = @import("pixels.zig");
+const Allocator = std.mem.Allocator;
+const Rgb = pixels.Rgb;
+
+const PRECISION_BITS = 32 - 8 - 2;
+
+fn bicubic(x0: f64) f64 {
+    const a = -0.5;
+    const x = @abs(x0);
+    if (x < 1.0) return ((a + 2.0) * x - (a + 3.0)) * x * x + 1;
+    if (x < 2.0) return (((x - 5) * x + 8) * x - 4) * a;
+    return 0.0;
+}
+
+/// One axis's coefficients (``precompute_coeffs`` + ``normalize_coeffs_8bpc``): bounds (xmin, count) and ksize
+const Coeffs = struct {
+    ksize: usize,
+    bounds: []i32,
+    k: []i32,
+
+    fn init(gpa: Allocator, in_size: usize, out_size: usize) Allocator.Error!Coeffs {
+        const in0: f32 = 0;
+        const in1: f32 = @floatFromInt(in_size);
+        const scale: f64 = @as(f64, in1 - in0) / @as(f64, @floatFromInt(out_size));
+        const filterscale: f64 = @max(scale, 1.0);
+        const support = 2.0 * filterscale;
+        const ksize: usize = @as(usize, @intFromFloat(@ceil(support))) * 2 + 1;
+        const bounds = try gpa.alloc(i32, out_size * 2);
+        errdefer gpa.free(bounds);
+        const k = try gpa.alloc(i32, out_size * ksize);
+        errdefer gpa.free(k);
+        const pre = try gpa.alloc(f64, ksize);
+        defer gpa.free(pre);
+        const inv = 1.0 / filterscale;
+        for (0..out_size) |xx| {
+            const center = @as(f64, in0) + (@as(f64, @floatFromInt(xx)) + 0.5) * scale;
+            var ww: f64 = 0.0;
+            var xmin: i32 = @intFromFloat(center - support + 0.5);
+            if (xmin < 0) xmin = 0;
+            var xmax: i32 = @intFromFloat(center + support + 0.5);
+            if (xmax > @as(i32, @intCast(in_size))) xmax = @intCast(in_size);
+            xmax -= xmin;
+            const n: usize = @intCast(@max(xmax, 0));
+            for (0..n) |x| {
+                const w = bicubic((@as(f64, @floatFromInt(@as(i32, @intCast(x)) + xmin)) - center + 0.5) * inv);
+                pre[x] = w;
+                ww += w;
+            }
+            if (ww != 0.0) for (pre[0..n]) |*w| {
+                w.* /= ww;
+            };
+            const row = k[xx * ksize ..][0..ksize];
+            for (row, 0..) |*q, x| {
+                const v = if (x < n) pre[x] else 0.0;
+                const s = v * @as(f64, 1 << PRECISION_BITS);
+                q.* = if (v < 0) @intFromFloat(-0.5 + s) else @intFromFloat(0.5 + s);
+            }
+            bounds[xx * 2] = xmin;
+            bounds[xx * 2 + 1] = xmax;
+        }
+        return .{ .ksize = ksize, .bounds = bounds, .k = k };
+    }
+
+    fn deinit(c: *Coeffs, gpa: Allocator) void {
+        gpa.free(c.bounds);
+        gpa.free(c.k);
+    }
+};
+
+/// ``clip8``: the sum (with its half added) >> 22, clamped to 0..255 (the lookup's range is -640..639).
+fn clip8(ss: i32) u8 {
+    return @intCast(std.math.clamp(ss >> PRECISION_BITS, 0, 255));
+}
+
+/// ``ImagingResample(im, w, h, BICUBIC, (0, 0, W, H))`` of an RGB image.
+pub fn resize(gpa: Allocator, src: Rgb, w: u32, h: u32) Allocator.Error!Rgb {
+    const need_h = w != src.w;
+    const need_v = h != src.h;
+    var vert = try Coeffs.init(gpa, src.h, h);
+    defer vert.deinit(gpa);
+    const first: usize = @intCast(vert.bounds[0]);
+    const last: usize = @intCast(vert.bounds[(h - 1) * 2] + vert.bounds[(h - 1) * 2 + 1]);
+    var cur = src;
+    var tmp: ?[]u8 = null;
+    defer if (tmp) |t| gpa.free(t);
+    if (need_h) {
+        var hor = try Coeffs.init(gpa, src.w, w);
+        defer hor.deinit(gpa);
+        const rows = last - first;
+        const out = try gpa.alloc(u8, rows * @as(usize, w) * 3);
+        tmp = out;
+        for (0..rows) |yy| {
+            const in = src.data[(yy + first) * @as(usize, src.w) * 3 ..][0 .. @as(usize, src.w) * 3];
+            const o = out[yy * @as(usize, w) * 3 ..][0 .. @as(usize, w) * 3];
+            for (0..w) |xx| {
+                const xmin: usize = @intCast(hor.bounds[xx * 2]);
+                const n: usize = @intCast(hor.bounds[xx * 2 + 1]);
+                const k = hor.k[xx * hor.ksize ..][0..n];
+                var ss = [3]i32{ 1 << (PRECISION_BITS - 1), 1 << (PRECISION_BITS - 1), 1 << (PRECISION_BITS - 1) };
+                for (k, 0..) |kk, x| {
+                    const p = in[(x + xmin) * 3 ..][0..3];
+                    inline for (0..3) |c| ss[c] +%= @as(i32, p[c]) * kk;
+                }
+                inline for (0..3) |c| o[xx * 3 + c] = clip8(ss[c]);
+            }
+        }
+        cur = .{ .w = w, .h = @intCast(rows), .data = out };
+    }
+    const out = try gpa.alloc(u8, @as(usize, w) * h * 3);
+    errdefer gpa.free(out);
+    if (!need_v) {
+        @memcpy(out, cur.data[0..out.len]);
+        return .{ .w = w, .h = h, .data = out };
+    }
+    const off: usize = if (need_h) first else 0;
+    const stride = @as(usize, cur.w) * 3;
+    for (0..h) |yy| {
+        const ymin: usize = @as(usize, @intCast(vert.bounds[yy * 2])) - off;
+        const n: usize = @intCast(vert.bounds[yy * 2 + 1]);
+        const k = vert.k[yy * vert.ksize ..][0..n];
+        const o = out[yy * stride ..][0..stride];
+        for (0..stride) |xc| {
+            var ss: i32 = 1 << (PRECISION_BITS - 1);
+            for (k, 0..) |kk, y| ss +%= @as(i32, cur.data[(y + ymin) * stride + xc]) * kk;
+            o[xc] = clip8(ss);
+        }
+    }
+    return .{ .w = w, .h = h, .data = out };
+}
+
+/// Python's ``round`` of a non-negative double to an int (half to even).
+pub fn roundHalfEven(x: f64) i64 {
+    const f = @floor(x);
+    const d = x - f;
+    var r: i64 = @intFromFloat(f);
+    if (d > 0.5 or (d == 0.5 and @mod(r, 2) == 1)) r += 1;
+    return r;
+}
+
+/// ``ImageOps.pad(image, (bw, bh), color=(127, 127, 127))``: ``contain`` (aspect kept, BICUBIC), centred.
+pub fn pad(gpa: Allocator, src: Rgb, bw: u32, bh: u32, fill: u8) Allocator.Error!Rgb {
+    const im_ratio = @as(f64, @floatFromInt(src.w)) / @as(f64, @floatFromInt(src.h));
+    const dest_ratio = @as(f64, @floatFromInt(bw)) / @as(f64, @floatFromInt(bh));
+    var sw = bw;
+    var sh = bh;
+    if (im_ratio != dest_ratio) {
+        if (im_ratio > dest_ratio) {
+            const nh = roundHalfEven(@as(f64, @floatFromInt(src.h)) / @as(f64, @floatFromInt(src.w)) * @as(f64, @floatFromInt(bw)));
+            if (nh != bh) sh = @intCast(nh);
+        } else {
+            const nw = roundHalfEven(@as(f64, @floatFromInt(src.w)) / @as(f64, @floatFromInt(src.h)) * @as(f64, @floatFromInt(bh)));
+            if (nw != bw) sw = @intCast(nw);
+        }
+    }
+    var resized: Rgb = if (sw == src.w and sh == src.h) .{ .w = sw, .h = sh, .data = try gpa.dupe(u8, src.data) } else try resize(gpa, src, sw, sh);
+    if (sw == bw and sh == bh) return resized;
+    defer resized.deinit(gpa);
+    const out = try gpa.alloc(u8, @as(usize, bw) * bh * 3);
+    @memset(out, fill);
+    var x0: usize = 0;
+    var y0: usize = 0;
+    if (sw != bw) x0 = @intCast(roundHalfEven(@as(f64, @floatFromInt(@as(i64, bw) - sw)) * 0.5)) else y0 = @intCast(roundHalfEven(@as(f64, @floatFromInt(@as(i64, bh) - sh)) * 0.5));
+    for (0..sh) |y| @memcpy(out[((y + y0) * bw + x0) * 3 ..][0 .. @as(usize, sw) * 3], resized.data[y * @as(usize, sw) * 3 ..][0 .. @as(usize, sw) * 3]);
+    return .{ .w = bw, .h = bh, .data = out };
+}
+
+test "round half to even, as Python's round" {
+    try std.testing.expectEqual(@as(i64, 2), roundHalfEven(2.5));
+    try std.testing.expectEqual(@as(i64, 4), roundHalfEven(3.5));
+    try std.testing.expectEqual(@as(i64, 3), roundHalfEven(2.51));
+}
diff --git a/zig/src/families/deepseek_v41/vision/store.zig b/zig/src/families/deepseek_v41/vision/store.zig
new file mode 100644
index 0000000000000000000000000000000000000000..4396d5001d19036e0ded544d581c673c4d434d5b
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision/store.zig
@@ -0,0 +1,123 @@
+//! Owned image inputs until a request finishes; admission is atomic even when allocation fails.
+const std = @import("std");
+const held = @import("held.zig");
+const prep = @import("prep.zig");
+const Allocator = std.mem.Allocator;
+const Churn = @import("../map_churn.zig").Churn;
+pub const Loc = struct { img: *const held.HeldImage, idx: u32, refs: u32 };
+
+pub const Store = struct {
+    gpa: Allocator,
+    where: std.AutoHashMapUnmanaged(u32, Loc) = .empty,
+    holds: std.AutoHashMapUnmanaged(u64, *const held.Held) = .empty,
+    where_churn: Churn = .{},
+    holds_churn: Churn = .{},
+
+    pub fn deinit(s: *Store) void {
+        var it = s.holds.valueIterator();
+        while (it.next()) |h| s.free(h.*);
+        s.holds.deinit(s.gpa);
+        s.where.deinit(s.gpa);
+    }
+
+    pub fn hold(s: *Store, id: u64, src: *const held.Held) !void {
+        if (s.holds.contains(id)) return error.DuplicateRequest;
+        const h = try s.copy(src);
+        errdefer s.free(h);
+        var pending: std.AutoHashMapUnmanaged(u32, Loc) = .empty;
+        defer pending.deinit(s.gpa);
+        for (h.slice(), 0..) |*im, k| {
+            if (seen(h, k)) continue;
+            for (im.vids[0..im.n_vids], 0..) |v, i| {
+                if (v < (1 << 24) or v >= (1 << 31)) return error.InvalidImageId;
+                if (pending.contains(v)) return error.ImageIdCollision;
+                if (s.where.get(v)) |loc| {
+                    if (loc.idx != i or !std.mem.eql(u8, &loc.img.digest, &im.digest))
+                        return error.ImageIdCollision;
+                    if (loc.refs == std.math.maxInt(u32)) return error.TooManyHolders;
+                }
+                try pending.put(s.gpa, v, .{ .img = im, .idx = @intCast(i), .refs = 1 });
+            }
+        }
+        try s.holds.ensureUnusedCapacity(s.gpa, 1);
+        try s.where.ensureUnusedCapacity(s.gpa, pending.count());
+        s.holds.putAssumeCapacity(id, h);
+        var it = pending.iterator();
+        while (it.next()) |e| {
+            const loc = s.where.getOrPutAssumeCapacity(e.key_ptr.*);
+            if (loc.found_existing) loc.value_ptr.refs += 1 else loc.value_ptr.* = e.value_ptr.*;
+        }
+    }
+
+    pub fn release(s: *Store, id: u64) void {
+        const h = (s.holds.fetchRemove(id) orelse return).value;
+        s.holds_churn.dropped(u64, &s.holds);
+        defer s.free(h);
+        for (h.slice(), 0..) |*im, k| {
+            if (seen(h, k)) continue;
+            for (im.vids[0..im.n_vids]) |v| {
+                const loc = s.where.getPtr(v) orelse unreachable;
+                loc.refs -= 1;
+                if (loc.refs == 0) {
+                    _ = s.where.remove(v);
+                    s.where_churn.dropped(u32, &s.where);
+                } else if (loc.img == im) {
+                    loc.img = s.other(im.digest) orelse unreachable;
+                }
+            }
+        }
+    }
+
+    fn other(s: *Store, digest: [32]u8) ?*const held.HeldImage {
+        var it = s.holds.valueIterator();
+        while (it.next()) |h| for (h.*.slice()) |*im| {
+            if (std.mem.eql(u8, &im.digest, &digest)) return im;
+        };
+        return null;
+    }
+
+    fn seen(h: *const held.Held, k: usize) bool {
+        for (h.slice()[0..k]) |*im| if (std.mem.eql(u8, &im.digest, &h.slice()[k].digest)) return true;
+        return false;
+    }
+
+    fn copy(s: *Store, src: *const held.Held) !*const held.Held {
+        const imgs = try s.gpa.alloc(held.HeldImage, src.n);
+        var done: usize = 0;
+        errdefer {
+            for (imgs[0..done]) |*im| s.freeImage(im);
+            s.gpa.free(imgs);
+        }
+        for (src.slice(), imgs) |*im, *out| {
+            if (im.vit_h == 0 or im.vit_w == 0 or im.vit_h > 4096 or im.vit_w > 4096)
+                return error.VisionGrid;
+            const lh = (im.vit_h + 2) / 3;
+            const lw = (im.vit_w + 2) / 3;
+            if (im.llm_h != lh or im.llm_w != lw or im.n_vids != prep.spanLen(lh, lw))
+                return error.VisionGrid;
+            out.* = im.*;
+            const np = @as(usize, im.vit_h) * im.vit_w * 3 * 14 * 14;
+            const patches = try s.gpa.dupe(u16, im.patches[0..np]);
+            out.vids = (s.gpa.dupe(u32, im.vids[0..im.n_vids]) catch |e| {
+                s.gpa.free(patches);
+                return e;
+            }).ptr;
+            out.patches = patches.ptr;
+            done += 1;
+        }
+        const h = try s.gpa.create(held.Held);
+        h.* = .{ .images = imgs.ptr, .n = imgs.len };
+        return h;
+    }
+
+    fn freeImage(s: *Store, im: *const held.HeldImage) void {
+        s.gpa.free(im.patches[0 .. @as(usize, im.vit_h) * im.vit_w * 3 * 14 * 14]);
+        s.gpa.free(im.vids[0..im.n_vids]);
+    }
+
+    fn free(s: *Store, h: *const held.Held) void {
+        for (h.slice()) |*im| s.freeImage(im);
+        s.gpa.free(h.images[0..h.n]);
+        s.gpa.destroy(h);
+    }
+};
diff --git a/zig/src/families/deepseek_v41/vision/vids.zig b/zig/src/families/deepseek_v41/vision/vids.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9834890e0f730f372ae7085a9349f5e5362ed518
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision/vids.zig
@@ -0,0 +1,127 @@
+//! Stable virtual image token ids and bounded collision tracking.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+pub const VBASE: u32 = 1 << 24;
+pub const VLIMIT: u32 = (1 << 31) - 1;
+pub const VSPAN: u64 = VLIMIT - VBASE;
+
+pub fn isVid(t: u32) bool {
+    return t >= VBASE and t <= VLIMIT;
+}
+
+/// ``derive(digest, n, salt)`` into ``out``.
+pub fn derive(digest: *const [32]u8, salt: u32, out: []u32) void {
+    var base: [32]u8 = undefined;
+    var h = std.crypto.hash.sha2.Sha256.init(.{});
+    h.update(digest);
+    var sb: [4]u8 = undefined;
+    std.mem.writeInt(u32, &sb, salt, .little);
+    h.update(&sb);
+    h.final(&base);
+    for (out, 0..) |*v, k| {
+        var b = std.crypto.hash.blake2.Blake2b(64).init(.{});
+        b.update(&base);
+        var kb: [4]u8 = undefined;
+        std.mem.writeInt(u32, &kb, @intCast(k), .little);
+        b.update(&kb);
+        var d: [8]u8 = undefined;
+        b.final(&d);
+        v.* = @intCast(VBASE + std.mem.readInt(u64, &d, .little) % VSPAN);
+    }
+}
+
+/// Rank 0's recent ids -> the image digest they went to, at most ``cap`` ids (oldest first out), and each digest's
+pub const Registry = struct {
+    gpa: Allocator,
+    cap: usize = 1 << 18,
+    mutex: std.Io.Mutex = .init,
+    owner: std.AutoHashMapUnmanaged(u32, [32]u8) = .empty,
+    order: std.ArrayList(u32) = .empty, // insertion order of ``owner`` (a ring once full)
+    head: usize = 0,
+    salts: std.AutoHashMapUnmanaged([32]u8, u32) = .empty,
+    /// ids dropped from ``owner`` since it was last rehashed
+    dead: u32 = 0,
+
+    pub fn deinit(r: *Registry) void {
+        r.owner.deinit(r.gpa);
+        r.order.deinit(r.gpa);
+        r.salts.deinit(r.gpa);
+    }
+
+    /// The image's ids: ``n`` of them, derived with the first salt that clashes with no other image's.
+    pub fn vids(r: *Registry, io: std.Io, digest: *const [32]u8, n: usize) Allocator.Error![]u32 {
+        const out = try r.gpa.alloc(u32, n);
+        errdefer r.gpa.free(out);
+        r.mutex.lockUncancelable(io);
+        defer r.mutex.unlock(io);
+        var salt: u32 = r.salts.get(digest.*) orelse 0;
+        var seen: std.AutoHashMapUnmanaged(u32, void) = .empty;
+        defer seen.deinit(r.gpa);
+        while (true) : (salt += 1) {
+            derive(digest, salt, out);
+            seen.clearRetainingCapacity();
+            var clash = false;
+            for (out) |v| {
+                if ((try seen.fetchPut(r.gpa, v, {})) != null) clash = true;
+                if (r.owner.get(v)) |d| if (!std.mem.eql(u8, &d, digest)) {
+                    clash = true;
+                };
+                if (clash) break;
+            }
+            if (!clash) break;
+        }
+        if (r.salts.count() >= r.cap / 16 and !r.salts.contains(digest.*)) r.salts.clearRetainingCapacity();
+        try r.salts.put(r.gpa, digest.*, salt);
+        for (out) |v| {
+            const got = try r.owner.getOrPut(r.gpa, v);
+            got.value_ptr.* = digest.*;
+            if (got.found_existing) continue;
+            if (r.order.items.len < r.cap) {
+                try r.order.append(r.gpa, v);
+            } else {
+                if (r.owner.remove(r.order.items[r.head])) r.dropped();
+                r.order.items[r.head] = v;
+                r.head = (r.head + 1) % r.cap;
+            }
+        }
+        return out;
+    }
+
+    /// std's tombstones never clear and keys fill 80 %: rehash at a tenth, so a tenth of the map always stays free.
+    fn dropped(r: *Registry) void {
+        r.dead += 1;
+        if (@as(u64, r.dead) * 10 < r.owner.capacity()) return;
+        r.owner.rehash(std.hash_map.AutoContext(u32){});
+        r.dead = 0;
+    }
+};
+
+test "virtual ids are past the vocabulary, stable, and distinct per salt" {
+    var d: [32]u8 = undefined;
+    @memset(&d, 7);
+    var a: [5]u32 = undefined;
+    var b: [5]u32 = undefined;
+    derive(&d, 0, &a);
+    derive(&d, 0, &b);
+    try std.testing.expectEqualSlices(u32, &a, &b);
+    for (a) |v| try std.testing.expect(isVid(v));
+    derive(&d, 1, &b);
+    try std.testing.expect(!std.mem.eql(u32, &a, &b));
+}
+
+test "a full registry's id churn leaves its owner map free slots" {
+    const t = std.testing;
+    var r: Registry = .{ .gpa = t.allocator, .cap = 4096 };
+    defer r.deinit();
+    for (0..400) |i| {
+        // a new image's ids each evict the oldest once the ring is full
+        var digest: [32]u8 = @splat(0);
+        std.mem.writeInt(u64, digest[0..8], i, .little);
+        t.allocator.free(try r.vids(t.io, &digest, 64));
+        const meta = r.owner.metadata.?;
+        var free: usize = 0;
+        for (meta[0..r.owner.capacity()]) |x| free += @intFromBool(x.isFree());
+        try t.expect(free * 10 >= r.owner.capacity());
+    }
+}
diff --git a/zig/src/families/deepseek_v41/vision/webp.zig b/zig/src/families/deepseek_v41/vision/webp.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ec4f8988409d548cdc4903df04b7ac46081a01a5
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision/webp.zig
@@ -0,0 +1,119 @@
+//! WebP's first frame as Pillow 12.3 loads it: libwebp 1.6.0's WebPAnimDecoder (MODE_RGBA) over a demuxed file.
+const std = @import("std");
+const pixels = @import("pixels.zig");
+const vp8l = @import("webp_vp8l.zig");
+const vp8 = @import("webp_vp8.zig");
+const yuv = @import("webp_yuv.zig");
+const alpha = @import("webp_alpha.zig");
+const demux = @import("webp_demux.zig");
+const Allocator = std.mem.Allocator;
+
+pub const Error = error{ BadWebp, TooManyPixels, TooLarge } || Allocator.Error;
+
+pub const max_table_bytes = vp8l.max_table_bytes;
+
+/// Pillow's ``_accept``: RIFF, WEBP, then a VP8, VP8L or VP8X chunk.
+pub fn isWebp(raw: []const u8) bool {
+    if (raw.len < 16 or !std.mem.eql(u8, raw[0..4], "RIFF") or !std.mem.eql(u8, raw[8..12], "WEBP")) return false;
+    const t = raw[12..16];
+    return std.mem.eql(u8, t, "VP8 ") or std.mem.eql(u8, t, "VP8L") or std.mem.eql(u8, t, "VP8X");
+}
+
+/// The first frame's bitstreams: ``image`` the VP8 or VP8L payload with its pad, ``alph`` the ALPH payload.
+const Frame = struct {
+    x: u32,
+    y: u32,
+    w: u32,
+    h: u32,
+    lossless: bool,
+    image: []const u8,
+    alph: ?[]const u8,
+};
+
+/// The demuxed first frame as ``SynthesizeFrame`` hands it to ``WebPDecode``.
+fn firstFrame(raw: []const u8, f: demux.Frame) Frame {
+    const img = raw[f.image.at..][0..f.image.len];
+    var alph: ?[]const u8 = null;
+    if (f.alpha.len > 0) {
+        const a = raw[f.alpha.at..][0..f.alpha.len];
+        const size = std.mem.readInt(u32, a[4..8], .little);
+        alph = a[8..][0..@min(size, a.len - 8)];
+    }
+    const lossless = std.mem.eql(u8, img[0..4], "VP8L");
+    return .{ .x = f.x, .y = f.y, .w = f.w, .h = f.h, .lossless = lossless, .image = img[8..], .alph = alph };
+}
+
+/// The first frame's RGBA in ``canvas`` (stride ``cw``) at its offset; a full-canvas lossy frame decodes straight in.
+fn decodeFrame(gpa: Allocator, f: Frame, canvas: []u8, cw: u32, max_pixels: u64) Error!void {
+    const stride = @as(usize, cw) * 4;
+    const at = @as(usize, f.y) * stride + @as(usize, f.x) * 4;
+    if (f.lossless) {
+        var im = try vp8l.decode(gpa, f.image, max_pixels);
+        defer im.deinit(gpa);
+        if (im.w != f.w or im.h != f.h) return error.BadWebp;
+        for (0..f.h) |y| {
+            const row = canvas[at + y * stride ..][0 .. @as(usize, f.w) * 4];
+            for (0..f.w) |x| {
+                const p = im.px[y * f.w + x];
+                row[x * 4 ..][0..4].* = .{ @truncate(p >> 16), @truncate(p >> 8), @truncate(p), @truncate(p >> 24) };
+            }
+        }
+        return;
+    }
+    const n = @as(usize, f.w) * f.h;
+    const full = f.x == 0 and f.y == 0 and f.w == cw and n * 4 == canvas.len;
+    const rgba = if (full) canvas else try gpa.alloc(u8, n * 4);
+    defer if (!full) gpa.free(rgba);
+    {
+        var planes = try vp8.decode(gpa, f.image, max_pixels);
+        defer planes.deinit(gpa);
+        if (planes.w != f.w or planes.h != f.h) return error.BadWebp;
+        @memset(rgba, 255);
+        yuv.toRgba(&planes, rgba);
+    }
+    if (f.alph) |a| {
+        const plane = try gpa.alloc(u8, n);
+        defer gpa.free(plane);
+        try alpha.decode(gpa, a, f.w, f.h, plane);
+        for (plane, 0..) |v, i| rgba[i * 4 + 3] = v;
+    }
+    if (full) return;
+    const rs = @as(usize, f.w) * 4;
+    for (0..f.h) |y| @memcpy(canvas[at + y * stride ..][0..rs], rgba[y * rs ..][0..rs]);
+}
+
+/// Pillow's mode is RGBA when ``WebPGetFeatures`` reports alpha, which ``WebPAnimDecoderNew`` also requires to pass.
+pub fn decode(gpa: Allocator, raw: []const u8, max_pixels: u64) Error!pixels.Image {
+    if (!isWebp(raw)) return error.BadWebp;
+    const feat = demux.features(raw) orelse return error.BadWebp;
+    const d = try demux.demux(raw);
+    const f = firstFrame(raw, d.first);
+    const n = @as(u64, d.canvas_w) * d.canvas_h;
+    if (n > max_pixels or @as(u64, f.w) * f.h > max_pixels) return error.TooManyPixels;
+    const np: usize = @intCast(n);
+    const canvas = try gpa.alloc(u8, np * 4);
+    errdefer gpa.free(canvas);
+    @memset(canvas, 0);
+    try decodeFrame(gpa, f, canvas, d.canvas_w, max_pixels);
+    if (feat.has_alpha) return .{ .w = d.canvas_w, .h = d.canvas_h, .mode = .rgba, .data = canvas };
+    // RGB in place: pixel i's three bytes move down to i * 3, which never passes pixel i's own bytes at i * 4
+    for (0..np) |i| std.mem.copyForwards(u8, canvas[i * 3 ..][0..3], canvas[i * 4 ..][0..3]);
+    return .{ .w = d.canvas_w, .h = d.canvas_h, .mode = .rgb, .data = try gpa.realloc(canvas, np * 3) };
+}
+
+test {
+    _ = alpha;
+    _ = vp8l;
+    _ = vp8;
+    _ = yuv;
+    _ = demux;
+}
+
+test "the container is refused when truncated or inconsistent" {
+    const a = std.testing.allocator;
+    try std.testing.expect(!isWebp("RIFF\x10\x00\x00\x00WEBPVP8Z"));
+    // RIFF size beyond the bytes present
+    try std.testing.expectError(error.BadWebp, decode(a, "RIFF\xff\x00\x00\x00WEBPVP8L\x05\x00\x00\x00\x2f\x00\x00\x00\x00", 1 << 20));
+    // a VP8L chunk whose version bits are not zero
+    try std.testing.expectError(error.BadWebp, decode(a, "RIFF\x12\x00\x00\x00WEBPVP8L\x05\x00\x00\x00\x2f\x00\x00\x00\x20\x00", 1 << 20));
+}
diff --git a/zig/src/families/deepseek_v41/vision/webp_alpha.zig b/zig/src/families/deepseek_v41/vision/webp_alpha.zig
new file mode 100644
index 0000000000000000000000000000000000000000..a42f8079d33598af37a34a467a55cdb2fc1f97dc
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision/webp_alpha.zig
@@ -0,0 +1,90 @@
+//! A WebP ALPH chunk as libwebp 1.6.0 decodes it (``alpha_dec.c``, ``filters.c``): raw or VP8L, then unfiltered.
+const std = @import("std");
+const vp8l = @import("webp_vp8l.zig");
+const Allocator = std.mem.Allocator;
+
+pub const Error = error{ BadWebp, TooManyPixels, TooLarge } || Allocator.Error;
+
+const Filter = enum(u2) { none, horizontal, vertical, gradient };
+
+/// The w x h alpha plane of ``chunk`` (the ALPH payload) into ``out`` (len w * h).
+pub fn decode(gpa: Allocator, chunk: []const u8, w: u32, h: u32, out: []u8) Error!void {
+    const n = @as(usize, w) * h;
+    if (chunk.len <= 1 or out.len != n) return error.BadWebp;
+    const method = chunk[0] & 3;
+    const filter: Filter = @fromBackingInt(@intCast((chunk[0] >> 2) & 3));
+    const pre = (chunk[0] >> 4) & 3;
+    if (method > 1 or pre > 1 or chunk[0] >> 6 != 0) return error.BadWebp;
+    const body = chunk[1..];
+    if (method == 0) {
+        if (body.len < n) return error.BadWebp;
+        unfilterPlane(filter, body[0..n], out, w);
+        return;
+    }
+    const deltas = try gpa.alloc(u8, n);
+    defer gpa.free(deltas);
+    try vp8l.decodeAlpha(gpa, body, w, h, deltas);
+    unfilterPlane(filter, deltas, out, w);
+}
+
+/// ``WebPUnfilters[filter]`` row by row, each row predicted from the previous output row (none for the first).
+fn unfilterPlane(filter: Filter, in: []const u8, out: []u8, w: u32) void {
+    var y: usize = 0;
+    while (y * w < in.len) : (y += 1) {
+        const row = in[y * w ..][0..w];
+        const dst = out[y * w ..][0..w];
+        const prev: ?[]const u8 = if (y == 0) null else out[(y - 1) * w ..][0..w];
+        switch (filter) {
+            .none => @memcpy(dst, row),
+            .horizontal => horizontal(prev, row, dst),
+            .vertical => if (prev) |p| {
+                for (dst, row, p) |*o, d, t| o.* = d +% t;
+            } else horizontal(null, row, dst),
+            .gradient => if (prev) |p| gradient(p, row, dst) else horizontal(null, row, dst),
+        }
+    }
+}
+
+/// ``HorizontalUnfilter_C``: the first pixel predicted from the row above (0 on the first row), then from the left.
+fn horizontal(prev: ?[]const u8, in: []const u8, out: []u8) void {
+    var pred: u8 = if (prev) |p| p[0] else 0;
+    for (in, out) |d, *o| {
+        o.* = pred +% d;
+        pred = o.*;
+    }
+}
+
+/// ``GradientUnfilter_C`` below the first row: left + top - top-left, clipped to 8 bits.
+fn gradient(prev: []const u8, in: []const u8, out: []u8) void {
+    var top: u8 = prev[0];
+    var top_left = top;
+    var left = top;
+    for (in, out, prev) |d, *o, t| {
+        top = t;
+        const g = @as(i32, left) + top - top_left;
+        left = d +% @as(u8, @intCast(std.math.clamp(g, 0, 255)));
+        top_left = top;
+        o.* = left;
+    }
+}
+
+test "the three unfilters rebuild their filtered rows" {
+    // a 3 x 2 plane: rows [10, 20, 30] and [15, 5, 255]
+    var out: [6]u8 = undefined;
+    unfilterPlane(.horizontal, &.{ 10, 10, 10, 5, 246, 250 }, &out, 3);
+    try std.testing.expectEqualSlices(u8, &.{ 10, 20, 30, 15, 5, 255 }, &out);
+    unfilterPlane(.vertical, &.{ 10, 10, 10, 5, 241, 225 }, &out, 3);
+    try std.testing.expectEqualSlices(u8, &.{ 10, 20, 30, 15, 5, 255 }, &out);
+    // gradient row 1: preds clip(10 + 10 - 10) = 10, clip(15 + 20 - 10) = 25, clip(5 + 30 - 20) = 15
+    unfilterPlane(.gradient, &.{ 10, 10, 10, 5, 236, 240 }, &out, 3);
+    try std.testing.expectEqualSlices(u8, &.{ 10, 20, 30, 15, 5, 255 }, &out);
+}
+
+test "a raw plane decodes and a bad header is refused" {
+    var out: [4]u8 = undefined;
+    try decode(std.testing.allocator, &.{ 0, 1, 2, 3, 4 }, 2, 2, &out);
+    try std.testing.expectEqualSlices(u8, &.{ 1, 2, 3, 4 }, &out);
+    try std.testing.expectError(error.BadWebp, decode(std.testing.allocator, &.{ 0, 1, 2, 3 }, 2, 2, &out));
+    try std.testing.expectError(error.BadWebp, decode(std.testing.allocator, &.{ 2, 1, 2, 3, 4 }, 2, 2, &out));
+    try std.testing.expectError(error.BadWebp, decode(std.testing.allocator, &.{ 0x40, 1, 2, 3, 4 }, 2, 2, &out));
+}
diff --git a/zig/src/families/deepseek_v41/vision/webp_demux.zig b/zig/src/families/deepseek_v41/vision/webp_demux.zig
new file mode 100644
index 0000000000000000000000000000000000000000..006c951c2f6b4b0c3bb0bd3089db5285e7532263
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision/webp_demux.zig
@@ -0,0 +1,363 @@
+//! A RIFF WEBP file as libwebp 1.6.0 accepts it: ``WebPGetFeatures`` (``webp_dec.c``) and ``WebPDemux`` (``demux.c``).
+const std = @import("std");
+
+pub const Error = error{BadWebp};
+
+const max_payload: u64 = std.math.maxInt(u32) - 8 - 1;
+const max_area: u64 = 1 << 32;
+const flag_animation: u32 = 0x02;
+const flag_alpha: u32 = 0x10;
+const valid_flags: u32 = 0x3e;
+
+fn le16(b: []const u8) u32 {
+    return std.mem.readInt(u16, b[0..2], .little);
+}
+
+fn le24(b: []const u8) u32 {
+    return std.mem.readInt(u24, b[0..3], .little);
+}
+
+fn le32(b: []const u8) u32 {
+    return std.mem.readInt(u32, b[0..4], .little);
+}
+
+fn tagIs(b: []const u8, t: *const [4]u8) bool {
+    return b.len >= 4 and std.mem.eql(u8, b[0..4], t);
+}
+
+/// ``VP8GetInfo``: the start code, a visible profile 0-3 key frame, the first partition inside, nonzero sizes.
+pub fn vp8Info(b: []const u8, chunk_size: u64) ?[2]u32 {
+    if (b.len < 10 or !std.mem.eql(u8, b[3..6], "\x9d\x01\x2a")) return null;
+    const bits = le24(b);
+    if (bits & 1 != 0 or (bits >> 1) & 7 > 3 or (bits >> 4) & 1 == 0 or bits >> 5 >= chunk_size) return null;
+    const w = le16(b[6..]) & 0x3fff;
+    const h = le16(b[8..]) & 0x3fff;
+    if (w == 0 or h == 0) return null;
+    return .{ w, h };
+}
+
+/// ``VP8LCheckSignature``: the 0x2f byte and a zero version in the header's last byte.
+fn vp8lSignature(b: []const u8) bool {
+    return b.len >= 5 and b[0] == 0x2f and b[4] >> 5 == 0;
+}
+
+/// ``VP8LGetInfo``: width, height and the alpha hint of a VP8L header.
+pub fn vp8lInfo(b: []const u8) ?struct { w: u32, h: u32, alpha: bool } {
+    if (!vp8lSignature(b)) return null;
+    const bits = le32(b[1..]);
+    return .{ .w = (bits & 0x3fff) + 1, .h = ((bits >> 14) & 0x3fff) + 1, .alpha = (bits >> 28) & 1 != 0 };
+}
+
+pub const Features = struct { w: u32, h: u32, has_alpha: bool };
+const Status = enum { ok, short, bad };
+
+/// ``WebPGetFeatures`` (``ParseHeadersInternal`` without headers): null where libwebp's status is not OK.
+pub fn features(data: []const u8) ?Features {
+    var f: Features = .{ .w = 0, .h = 0, .has_alpha = false };
+    var vp8x = false;
+    const st = parseFeatures(data, &f, &vp8x);
+    if (st == .ok or (st == .short and vp8x)) return f;
+    return null;
+}
+
+fn parseFeatures(data0: []const u8, f: *Features, vp8x: *bool) Status {
+    var d = data0;
+    if (d.len < 12) return .short;
+    var riff: u64 = 0;
+    if (tagIs(d, "RIFF")) {
+        if (!std.mem.eql(u8, d[8..12], "WEBP")) return .bad;
+        const size = le32(d[4..]);
+        if (size < 12 or size > max_payload) return .bad;
+        riff = size;
+        d = d[12..];
+    }
+    if (d.len < 8) return .short;
+    var animation = false;
+    if (tagIs(d, "VP8X")) {
+        if (le32(d[4..]) != 10) return .bad;
+        if (d.len < 18) return .short;
+        const flags = le32(d[8..]);
+        f.w = 1 + le24(d[12..]);
+        f.h = 1 + le24(d[15..]);
+        if (@as(u64, f.w) * f.h >= max_area) return .bad;
+        d = d[18..];
+        vp8x.* = true;
+        animation = flags & flag_animation != 0;
+        f.has_alpha = flags & flag_alpha != 0;
+    }
+    if (riff == 0 and vp8x.*) return .bad;
+    if (vp8x.* and animation) return .ok;
+    if (d.len < 4) return .short;
+    var alph = false;
+    if ((riff > 0 and vp8x.*) or (riff == 0 and !vp8x.* and tagIs(d, "ALPH"))) {
+        var total: u64 = 4 + 8 + 10;
+        while (true) {
+            if (d.len < 8) return .short;
+            const size = le32(d[4..]);
+            if (size > max_payload) return .bad;
+            const disk = (8 + @as(u64, size) + 1) & ~@as(u64, 1);
+            total += disk;
+            if (riff > 0 and total > riff) return .bad;
+            if (tagIs(d, "VP8 ") or tagIs(d, "VP8L")) break;
+            if (d.len < disk) return .short;
+            if (tagIs(d, "ALPH")) alph = true;
+            d = d[@intCast(disk)..];
+        }
+    }
+    if (d.len < 8) return finish(.short, f, alph);
+    var lossless: bool = undefined;
+    var compressed: u64 = undefined;
+    if (tagIs(d, "VP8 ") or tagIs(d, "VP8L")) {
+        const size = le32(d[4..]);
+        if (riff >= 12 and size > riff - 12) return .bad;
+        compressed = size;
+        lossless = tagIs(d, "VP8L");
+        d = d[8..];
+    } else {
+        lossless = vp8lSignature(d);
+        compressed = d.len;
+    }
+    if (compressed > max_payload) return .bad;
+    var w: u32 = undefined;
+    var h: u32 = undefined;
+    if (!lossless) {
+        if (d.len < 10) return finish(.short, f, alph);
+        const s = vp8Info(d, compressed) orelse return .bad;
+        w = s[0];
+        h = s[1];
+    } else {
+        if (d.len < 5) return finish(.short, f, alph);
+        const s = vp8lInfo(d) orelse return .bad;
+        w = s.w;
+        h = s.h;
+        f.has_alpha = s.alpha;
+    }
+    if (vp8x.* and (f.w != w or f.h != h)) return .bad;
+    f.w = w;
+    f.h = h;
+    return finish(.ok, f, alph);
+}
+
+fn finish(st: Status, f: *Features, alph: bool) Status {
+    f.has_alpha = f.has_alpha or alph;
+    return st;
+}
+
+/// A chunk's offset and length (header and padded payload) in the file.
+pub const Span = struct { at: usize = 0, len: usize = 0 };
+
+pub const Frame = struct {
+    num: u32 = 0,
+    x: u32 = 0,
+    y: u32 = 0,
+    w: u32 = 0,
+    h: u32 = 0,
+    complete: bool = false,
+    image: Span = .{},
+    alpha: Span = .{},
+};
+
+/// What the first frame's decode needs from a demuxed file.
+pub const Demuxed = struct { canvas_w: u32, canvas_h: u32, first: Frame };
+
+const Parse = enum { ok, more, bad };
+
+const Mem = struct {
+    buf: []const u8,
+    start: usize,
+    end: usize,
+
+    fn left(m: *const Mem) usize {
+        return m.end - m.start;
+    }
+    fn invalid(m: *const Mem, size: u64) bool {
+        return size > m.end - m.start;
+    }
+    fn read32(m: *Mem) u32 {
+        defer m.start += 4;
+        return le32(m.buf[m.start..]);
+    }
+    fn read24(m: *Mem) u32 {
+        defer m.start += 3;
+        return le24(m.buf[m.start..]);
+    }
+};
+
+const Demux = struct {
+    mem: Mem,
+    ext: bool = false,
+    flags: u32 = 0,
+    canvas_w: u32 = 0,
+    canvas_h: u32 = 0,
+    frames: u32 = 0,
+    first: Frame = .{},
+    last_complete: bool = true,
+    bad_frame: bool = false,
+
+    /// ``AddFrame`` (refused after an incomplete frame) and ``IsValid*Format``'s per-frame rules (ALPH before image).
+    fn add(d: *Demux, f: Frame) bool {
+        if (!d.last_complete) return false;
+        d.last_complete = f.complete;
+        if (d.frames == 0) d.first = f;
+        d.frames += 1;
+        if (!f.complete or f.w == 0 or f.h == 0 or (f.alpha.len > 0 and f.alpha.at > f.image.at)) d.bad_frame = true;
+        if (d.ext and !boundsOk(d, f, d.flags & flag_animation == 0)) d.bad_frame = true;
+        return true;
+    }
+};
+
+/// ``StoreFrame``: an optional ALPH, then one VP8 or VP8L chunk (VP8L after ALPH is an error), up to another chunk.
+fn storeFrame(num: u32, min_size: u64, m: *Mem, f: *Frame) Parse {
+    if (m.left() < 8 or m.left() < min_size) return .more;
+    var alpha_chunks: u32 = 0;
+    var image_chunks: u32 = 0;
+    var status: Parse = .ok;
+    while (true) {
+        const at = m.start;
+        const tag = m.buf[at..][0..4];
+        m.start += 4;
+        const size = m.read32();
+        if (size > max_payload) return .bad;
+        const padded = @as(u64, size) + (size & 1);
+        if (m.invalid(padded)) return .bad;
+        const avail: usize = @intCast(padded);
+        const is_alph = std.mem.eql(u8, tag, "ALPH");
+        const is_vp8l = std.mem.eql(u8, tag, "VP8L");
+        const is_image = is_vp8l or std.mem.eql(u8, tag, "VP8 ");
+        if (is_alph and alpha_chunks == 0) {
+            alpha_chunks += 1;
+            f.alpha = .{ .at = at, .len = 8 + avail };
+            f.num = num;
+            m.start += avail;
+        } else if (is_image and is_vp8l and alpha_chunks > 0) {
+            return .bad;
+        } else if (is_image and image_chunks == 0) {
+            const feat = features(m.buf[at .. at + 8 + avail]) orelse return .bad;
+            image_chunks += 1;
+            f.image = .{ .at = at, .len = 8 + avail };
+            f.w = feat.w;
+            f.h = feat.h;
+            f.num = num;
+            f.complete = status == .ok;
+            m.start += avail;
+        } else {
+            m.start -= 8;
+            return status;
+        }
+        if (m.start == m.end) return status;
+        if (m.left() < 8) status = .more;
+        if (status != .ok) return status;
+    }
+}
+
+/// ``ParseSingleImage``: one frame; without the VP8X alpha flag its ALPH chunk is dropped.
+fn singleImage(d: *Demux) Parse {
+    if (d.frames != 0 or d.mem.invalid(8)) return .bad;
+    var f: Frame = .{};
+    const status = storeFrame(1, 0, &d.mem, &f);
+    if (status == .bad) return .bad;
+    if (d.flags & flag_alpha == 0) f.alpha = .{};
+    if (!d.ext and f.w > 0 and f.h > 0) {
+        d.canvas_w = f.w;
+        d.canvas_h = f.h;
+    }
+    if (!d.add(f)) return .bad;
+    return status;
+}
+
+/// ``ParseAnimationFrame``: the ANMF header, then the frame's chunks, which may not run past its payload.
+fn animationFrame(d: *Demux, chunk_size: u64) Parse {
+    if (d.mem.invalid(16) or chunk_size < 16) return .bad;
+    var f: Frame = .{};
+    f.x = 2 * d.mem.read24();
+    f.y = 2 * d.mem.read24();
+    const w = 1 + @as(u64, d.mem.read24());
+    const h = 1 + @as(u64, d.mem.read24());
+    d.mem.start += 4;
+    if (w * h >= max_area) return .bad;
+    const start = d.mem.start;
+    var status = storeFrame(d.frames + 1, chunk_size - 16, &d.mem, &f);
+    if (status != .bad and d.mem.start - start > chunk_size - 16) status = .bad;
+    if (status != .bad and d.flags & flag_animation != 0 and f.num > 0) {
+        if (!d.add(f)) status = .bad;
+    }
+    return status;
+}
+
+fn vp8xChunks(d: *Demux) Parse {
+    const animation = d.flags & flag_animation != 0;
+    var anim_chunks: u32 = 0;
+    var status: Parse = .ok;
+    while (status == .ok) {
+        const tag = d.mem.buf[d.mem.start..][0..4];
+        d.mem.start += 4;
+        const size = d.mem.read32();
+        if (size > max_payload) return .bad;
+        const padded = @as(u64, size) + (size & 1);
+        if (d.mem.invalid(padded)) return .bad;
+        if (std.mem.eql(u8, tag, "VP8X")) {
+            return .bad;
+        } else if (std.mem.eql(u8, tag, "ALPH") or std.mem.eql(u8, tag, "VP8 ") or std.mem.eql(u8, tag, "VP8L")) {
+            if (anim_chunks > 0 or animation) return .bad;
+            d.mem.start -= 8;
+            status = singleImage(d);
+        } else if (std.mem.eql(u8, tag, "ANIM")) {
+            if (padded < 6) return .bad;
+            anim_chunks += 1;
+            d.mem.start += @intCast(padded);
+        } else if (std.mem.eql(u8, tag, "ANMF")) {
+            if (anim_chunks == 0) return .bad;
+            status = animationFrame(d, padded);
+        } else {
+            d.mem.start += @intCast(padded);
+        }
+        if (d.mem.start == d.mem.end) break;
+        if (d.mem.left() < 8) status = .more;
+    }
+    return status;
+}
+
+/// ``ParseVP8X``: flags from the first payload byte, the canvas, any trailing VP8X payload skipped.
+fn vp8xHeader(d: *Demux) Parse {
+    if (d.mem.left() < 8) return .more;
+    d.ext = true;
+    d.mem.start += 4;
+    const size = d.mem.read32();
+    if (size > max_payload or size < 10) return .bad;
+    const padded = @as(u64, size) + (size & 1);
+    if (d.mem.invalid(padded)) return .bad;
+    d.flags = d.mem.buf[d.mem.start];
+    d.mem.start += 4;
+    d.canvas_w = 1 + d.mem.read24();
+    d.canvas_h = 1 + d.mem.read24();
+    if (@as(u64, d.canvas_w) * d.canvas_h >= max_area) return .bad;
+    d.mem.start += @intCast(padded - 10);
+    if (d.mem.invalid(8)) return .bad;
+    return vp8xChunks(d);
+}
+
+/// ``WebPDemux`` of a complete file (no partial data) with ``IsValidSimpleFormat`` / ``IsValidExtendedFormat``.
+pub fn demux(raw: []const u8) Error!Demuxed {
+    if (raw.len < 20 or !tagIs(raw, "RIFF") or !std.mem.eql(u8, raw[8..12], "WEBP")) return error.BadWebp;
+    const riff = le32(raw[4..]);
+    if (riff < 8 or riff > max_payload) return error.BadWebp;
+    const end = @as(u64, riff) + 8;
+    if (raw.len < end) return error.BadWebp;
+    var d: Demux = .{ .mem = .{ .buf = raw[0..@intCast(end)], .start = 12, .end = @intCast(end) } };
+    const tag = raw[12..16];
+    const status: Parse = if (std.mem.eql(u8, tag, "VP8 ") or std.mem.eql(u8, tag, "VP8L"))
+        singleImage(&d)
+    else if (std.mem.eql(u8, tag, "VP8X"))
+        vp8xHeader(&d)
+    else
+        .bad;
+    if (status != .ok or d.frames == 0 or d.bad_frame or d.canvas_w == 0 or d.canvas_h == 0) return error.BadWebp;
+    if (d.ext and d.flags & ~valid_flags != 0) return error.BadWebp;
+    return .{ .canvas_w = d.canvas_w, .canvas_h = d.canvas_h, .first = d.first };
+}
+
+/// ``CheckFrameBounds``: a still image fills the canvas exactly; a frame lies inside it.
+fn boundsOk(d: *const Demux, f: Frame, exact: bool) bool {
+    if (exact) return f.x == 0 and f.y == 0 and f.w == d.canvas_w and f.h == d.canvas_h;
+    return @as(u64, f.x) + f.w <= d.canvas_w and @as(u64, f.y) + f.h <= d.canvas_h;
+}
diff --git a/zig/src/families/deepseek_v41/vision/webp_golden_test.zig b/zig/src/families/deepseek_v41/vision/webp_golden_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..6ba60ec94342ed89b154f3a234f3c173a54b8cd7
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision/webp_golden_test.zig
@@ -0,0 +1,67 @@
+//! WebP files decoded to Pillow 12.3's RGB (tools/zig/dsv41_vision/gen_webp_golden.py); TF_DSV41_WEBP_GOLDEN: more.
+const std = @import("std");
+const testing = std.testing;
+const decode = @import("decode.zig");
+
+const fixtures = "zig/src/families/deepseek_v41/vision/fixtures/golden-webp";
+
+/// The first record: the Pillow and libwebp versions the goldens came from.
+const Generator = struct { pillow: []const u8, libwebp: []const u8 };
+
+/// A file Pillow decodes (``size``, ``rgb_sha256``) or refuses (``refused``); or the ``generator`` record.
+const Rec = struct { name: []const u8 = "", size: [2]u32 = .{ 0, 0 }, rgb_sha256: []const u8 = "", refused: bool = false, generator: ?Generator = null };
+
+/// Every record of ``dir``/golden.jsonl; returns (equal, total).
+fn run(dir: []const u8) ![2]usize {
+    const a = testing.allocator;
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    const ar = arena.allocator();
+    const cwd = std.Io.Dir.cwd();
+    const lines = try cwd.readFileAlloc(testing.io, try std.fmt.allocPrint(ar, "{s}/golden.jsonl", .{dir}), ar, .limited(1 << 26));
+    var ok: usize = 0;
+    var total: usize = 0;
+    var it = std.mem.tokenizeScalar(u8, lines, '\n');
+    while (it.next()) |line| {
+        const r = try std.json.parseFromSliceLeaky(Rec, ar, line, .{});
+        if (r.generator) |g| {
+            std.debug.print("webp golden {s}: Pillow {s}, libwebp {s}\n", .{ dir, g.pillow, g.libwebp });
+            continue;
+        }
+        total += 1;
+        const raw = try cwd.readFileAlloc(testing.io, try std.fmt.allocPrint(ar, "{s}/{s}", .{ dir, r.name }), ar, .limited(1 << 28));
+        var which: []const u8 = "";
+        var rgb = decode.rgb(a, raw, 1 << 32, &which) catch |e| {
+            if (r.refused and e == error.Undecodable) ok += 1 else std.debug.print("webp golden {s}: decode failed ({t})\n", .{ r.name, e });
+            continue;
+        };
+        if (r.refused) {
+            std.debug.print("webp golden {s}: decoded, Pillow refuses it\n", .{r.name});
+            rgb.deinit(a);
+            continue;
+        }
+        defer rgb.deinit(a);
+        var d: [32]u8 = undefined;
+        std.crypto.hash.sha2.Sha256.hash(rgb.data, &d, .{});
+        var hb: [64]u8 = undefined;
+        const got = std.fmt.bufPrint(&hb, "{x}", .{d}) catch unreachable;
+        if (rgb.w != r.size[0] or rgb.h != r.size[1] or !std.mem.eql(u8, got, r.rgb_sha256)) {
+            std.debug.print("webp golden {s}: RGB differs from Pillow's\n", .{r.name});
+        } else ok += 1;
+    }
+    return .{ ok, total };
+}
+
+test "WebP files decode to Pillow's RGB (committed set)" {
+    const got = try run(fixtures);
+    std.debug.print("webp golden {s}: {d}/{d} images equal\n", .{ fixtures, got[0], got[1] });
+    try testing.expect(got[1] > 0);
+    try testing.expectEqual(got[1], got[0]);
+}
+
+test "WebP files decode to Pillow's RGB (TF_DSV41_WEBP_GOLDEN)" {
+    const dir = testing.environ.getPosix("TF_DSV41_WEBP_GOLDEN") orelse return error.SkipZigTest;
+    const got = try run(dir);
+    std.debug.print("webp golden {s}: {d}/{d} images equal\n", .{ dir, got[0], got[1] });
+    try testing.expectEqual(got[1], got[0]);
+}
diff --git a/zig/src/families/deepseek_v41/vision/webp_vp8.zig b/zig/src/families/deepseek_v41/vision/webp_vp8.zig
new file mode 100644
index 0000000000000000000000000000000000000000..4ef26d9a0b08324e3a73ebee22a98e110ee3c0a9
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision/webp_vp8.zig
@@ -0,0 +1,502 @@
+//! Lossy WebP (VP8 key frame) as libwebp 1.6.0 decodes it (``vp8_dec.c``, ``quant_dec.c``, ``frame_dec.c``) to Y, U, V.
+const std = @import("std");
+const BitReader = @import("webp_vp8_bits.zig").BitReader;
+const tree = @import("webp_vp8_tree.zig");
+const tables = @import("webp_vp8_tables.zig");
+const dsp = @import("webp_vp8_dsp.zig");
+const Allocator = std.mem.Allocator;
+
+pub const Error = error{ BadWebp, TooManyPixels } || Allocator.Error;
+
+/// The planes ``WebPDecodeYUV`` returns: Y with stride ``w``, U and V with stride ``uv_w`` and ``(h + 1) / 2`` rows.
+pub const Yuv = struct {
+    w: u32,
+    h: u32,
+    y: []u8,
+    u: []u8,
+    v: []u8,
+    uv_w: u32,
+
+    pub fn deinit(self: *Yuv, gpa: Allocator) void {
+        gpa.free(self.y);
+        gpa.free(self.u);
+        gpa.free(self.v);
+        self.* = undefined;
+    }
+};
+
+const bps = dsp.bps;
+const y_off = bps + 8; // ``Y_OFF`` .. ``V_OFF``: the blocks in the work buffer, a row and a column of context each
+const u_off = y_off + bps * 16 + bps;
+const v_off = u_off + 16;
+
+/// ``VP8FInfo``: one macroblock's loop filter limits.
+const FInfo = struct { limit: u8 = 0, ilevel: u8 = 0, inner: bool = false, hev_thresh: u8 = 0 };
+
+/// ``VP8SegmentHeader`` and ``VP8FilterHeader``, the parts of the frame header read in partition 0.
+const Header = struct {
+    use_segment: bool = false,
+    absolute_delta: bool = true,
+    quantizer: [4]i32 = @splat(0),
+    filter_strength: [4]i32 = @splat(0),
+    simple: bool = false,
+    level: i32 = 0,
+    sharpness: i32 = 0,
+    use_lf_delta: bool = false,
+    ref_lf_delta: [4]i32 = @splat(0),
+    mode_lf_delta: [4]i32 = @splat(0),
+    filter_type: u2 = 0, // 0 off, 1 simple, 2 complex
+};
+
+const TopSamples = struct { y: [16]u8, u: [8]u8, v: [8]u8 };
+
+/// ``kScan``: each 4x4 luma block's offset in the work buffer.
+const scan = blk: {
+    var s: [16]usize = undefined;
+    for (0..16) |n| s[n] = (n & 3) * 4 + (n >> 2) * 4 * bps;
+    break :blk s;
+};
+
+/// Decode a VP8 chunk payload as the demuxer hands it on (an odd size keeps its pad byte) to cropped Y, U, V planes.
+pub fn decode(gpa: Allocator, data: []const u8, max_pixels: u64) Error!Yuv {
+    // ``VP8GetInfo`` (from ``ParseHeadersInternal``), the chunk being the whole of ``data``
+    if (data.len < 10) return error.BadWebp;
+    if (data[3] != 0x9d or data[4] != 0x01 or data[5] != 0x2a) return error.BadWebp;
+    const tag = @as(u32, data[0]) | @as(u32, data[1]) << 8 | @as(u32, data[2]) << 16;
+    if (tag & 1 != 0 or (tag >> 1) & 7 > 3 or (tag >> 4) & 1 == 0) return error.BadWebp;
+    const part0_len: usize = tag >> 5;
+    if (part0_len >= data.len) return error.BadWebp;
+    const w: u32 = (@as(u32, data[7]) << 8 | data[6]) & 0x3fff;
+    const h: u32 = (@as(u32, data[9]) << 8 | data[8]) & 0x3fff;
+    if (w == 0 or h == 0) return error.BadWebp;
+    // ``VP8GetHeaders``
+    const buf = data[10..];
+    if (part0_len > buf.len) return error.BadWebp;
+    var br = BitReader.init(buf[0..part0_len]);
+    const rest = buf[part0_len..];
+    _ = br.getBit(0x80); // colorspace
+    _ = br.getBit(0x80); // clamp type
+    var hdr: Header = .{};
+    var ps: tree.Parser = .{ .intra_t = &.{}, .nz_info = &.{} };
+    parseSegmentHeader(&br, &hdr, &ps);
+    if (br.eof) return error.BadWebp;
+    parseFilterHeader(&br, &hdr);
+    if (br.eof) return error.BadWebp;
+    var parts: [8]BitReader = undefined;
+    const last_part: usize = (@as(usize, 1) << @intCast(br.getValue(2))) - 1;
+    if (rest.len < 3 * last_part) return error.BadWebp;
+    var part_start = 3 * last_part;
+    for (0..last_part) |p| {
+        const sz = rest[3 * p ..][0..3];
+        const psize = @min(@as(usize, sz[0]) | @as(usize, sz[1]) << 8 | @as(usize, sz[2]) << 16, rest.len - part_start);
+        parts[p] = BitReader.init(rest[part_start..][0..psize]);
+        part_start += psize;
+    }
+    parts[last_part] = BitReader.init(rest[part_start..]);
+    if (part_start >= rest.len) return error.BadWebp;
+    parseQuant(&br, &hdr, &ps.dqm);
+    _ = br.getBit(0x80); // update_proba, ignored
+    ps.parseProba(&br);
+
+    if (@as(u64, w) * h > max_pixels) return error.TooManyPixels;
+    var fr = try Frame.init(gpa, w, h, hdr);
+    defer fr.deinitScratch(gpa);
+    errdefer fr.deinitPlanes(gpa);
+    ps.intra_t = fr.intra_t;
+    ps.nz_info = fr.nz_info;
+    for (0..fr.mb_h) |mb_y| {
+        const token_br = &parts[mb_y & last_part];
+        for (0..fr.mb_w) |mb_x| ps.parseIntraMode(&br, &fr.mb_data[mb_x], mb_x);
+        if (br.eof) return error.BadWebp;
+        for (0..fr.mb_w) |mb_x| {
+            fr.decodeMb(&ps, token_br, mb_x);
+            if (token_br.eof) return error.BadWebp;
+        }
+        ps.initScanline();
+        fr.reconstructRow(mb_y);
+        if (hdr.filter_type > 0) fr.filterRow(mb_y);
+    }
+    return fr.crop(gpa);
+}
+
+/// ``ParseSegmentHeader`` (RFC 6386 section 9.3).
+fn parseSegmentHeader(br: *BitReader, hdr: *Header, ps: *tree.Parser) void {
+    hdr.use_segment = br.getBit(0x80) == 1;
+    if (!hdr.use_segment) return;
+    ps.update_map = br.getBit(0x80) == 1;
+    if (br.getBit(0x80) == 1) {
+        hdr.absolute_delta = br.getBit(0x80) == 1;
+        for (&hdr.quantizer) |*q| q.* = if (br.getBit(0x80) == 1) br.getSignedValue(7) else 0;
+        for (&hdr.filter_strength) |*f| f.* = if (br.getBit(0x80) == 1) br.getSignedValue(6) else 0;
+    }
+    if (ps.update_map) {
+        for (&ps.segments) |*s| s.* = if (br.getBit(0x80) == 1) @intCast(br.getValue(8)) else 255;
+    }
+}
+
+/// ``ParseFilterHeader`` (RFC 6386 section 9.4).
+fn parseFilterHeader(br: *BitReader, hdr: *Header) void {
+    hdr.simple = br.getBit(0x80) == 1;
+    hdr.level = @intCast(br.getValue(6));
+    hdr.sharpness = @intCast(br.getValue(3));
+    hdr.use_lf_delta = br.getBit(0x80) == 1;
+    if (hdr.use_lf_delta and br.getBit(0x80) == 1) {
+        for (&hdr.ref_lf_delta) |*d| {
+            if (br.getBit(0x80) == 1) d.* = br.getSignedValue(6);
+        }
+        for (&hdr.mode_lf_delta) |*d| {
+            if (br.getBit(0x80) == 1) d.* = br.getSignedValue(6);
+        }
+    }
+    hdr.filter_type = if (hdr.level == 0) 0 else if (hdr.simple) 1 else 2;
+}
+
+fn qclip(v: i32, m: i32) usize {
+    return @intCast(std.math.clamp(v, 0, m));
+}
+
+/// ``VP8ParseQuant`` (RFC 6386 section 9.6): each segment's dequantization factors.
+fn parseQuant(br: *BitReader, hdr: *const Header, dqm: *[4]tree.Quant) void {
+    const base_q0: i32 = @intCast(br.getValue(7));
+    var dq: [5]i32 = undefined; // y1 dc, y2 dc, y2 ac, uv dc, uv ac
+    for (&dq) |*d| d.* = if (br.getBit(0x80) == 1) br.getSignedValue(4) else 0;
+    for (0..4) |i| {
+        var q: i32 = undefined;
+        if (hdr.use_segment) {
+            q = hdr.quantizer[i];
+            if (!hdr.absolute_delta) q += base_q0;
+        } else if (i > 0) {
+            dqm[i] = dqm[0];
+            continue;
+        } else q = base_q0;
+        const m = &dqm[i];
+        m.y1 = .{ tables.dc_table[qclip(q + dq[0], 127)], tables.ac_table[qclip(q, 127)] };
+        m.y2[0] = @as(i32, tables.dc_table[qclip(q + dq[1], 127)]) * 2;
+        m.y2[1] = @max(8, (@as(i32, tables.ac_table[qclip(q + dq[2], 127)]) * 101581) >> 16);
+        m.uv = .{ tables.dc_table[qclip(q + dq[3], 117)], tables.ac_table[qclip(q + dq[4], 127)] };
+    }
+}
+
+/// ``PrecomputeFilterStrengths``: the filter limits for each segment, without and with 4x4 prediction.
+fn filterStrengths(hdr: *const Header) [4][2]FInfo {
+    var out: [4][2]FInfo = @splat(@splat(.{}));
+    if (hdr.filter_type == 0) return out;
+    for (0..4) |s| {
+        var base_level = hdr.level;
+        if (hdr.use_segment) {
+            base_level = hdr.filter_strength[s];
+            if (!hdr.absolute_delta) base_level += hdr.level;
+        }
+        for (0..2) |i4x4| {
+            const info = &out[s][i4x4];
+            var level = base_level;
+            if (hdr.use_lf_delta) {
+                level += hdr.ref_lf_delta[0];
+                if (i4x4 == 1) level += hdr.mode_lf_delta[0];
+            }
+            level = std.math.clamp(level, 0, 63);
+            if (level > 0) {
+                var ilevel = level;
+                if (hdr.sharpness > 0) {
+                    ilevel >>= if (hdr.sharpness > 4) 2 else 1;
+                    ilevel = @min(ilevel, 9 - hdr.sharpness);
+                }
+                ilevel = @max(ilevel, 1);
+                info.ilevel = @intCast(ilevel);
+                info.limit = @intCast(2 * level + ilevel);
+                info.hev_thresh = if (level >= 40) 2 else if (level >= 15) 1 else 0;
+            } else info.limit = 0;
+            info.inner = i4x4 == 1;
+        }
+    }
+    return out;
+}
+
+/// ``CheckMode``: DC prediction without the missing top or left samples on the frame's edges.
+fn checkMode(mb_x: usize, mb_y: usize, mode: u8) u8 {
+    if (mode != 0) return mode;
+    if (mb_x == 0) return if (mb_y == 0) 6 else 5;
+    return if (mb_y == 0) 4 else 0;
+}
+
+fn doTransform(bits: u32, src: []const i16, b: []u8, d: usize) void {
+    switch (bits >> 30) {
+        3 => dsp.transform(src, b, d),
+        2 => dsp.transformAc3(src, b, d),
+        1 => dsp.transformDc(src, b, d),
+        else => {},
+    }
+}
+
+fn doUvTransform(bits: u32, src: []const i16, b: []u8, d: usize) void {
+    if (bits & 0xff == 0) return;
+    if (bits & 0xaa != 0) dsp.transformUv(src, b, d) else dsp.transformDcUv(src, b, d);
+}
+
+/// The whole frame at macroblock size, reconstructed and filtered a macroblock row at a time as libwebp's cache is.
+const Frame = struct {
+    w: u32,
+    h: u32,
+    mb_w: usize,
+    mb_h: usize,
+    hdr: Header,
+    fstrengths: [4][2]FInfo,
+    y: []u8,
+    u: []u8,
+    v: []u8,
+    intra_t: []u8,
+    nz_info: []tree.Nz,
+    mb_data: []tree.MbData,
+    f_info: []FInfo,
+    yuv_t: []TopSamples,
+    yuv_b: [bps * 17 + bps * 9]u8 = @splat(0),
+
+    fn init(gpa: Allocator, w: u32, h: u32, hdr: Header) Error!Frame {
+        const mb_w = (@as(usize, w) + 15) >> 4;
+        const mb_h = (@as(usize, h) + 15) >> 4;
+        var fr: Frame = .{
+            .w = w,
+            .h = h,
+            .mb_w = mb_w,
+            .mb_h = mb_h,
+            .hdr = hdr,
+            .fstrengths = filterStrengths(&hdr),
+            .y = &.{},
+            .u = &.{},
+            .v = &.{},
+            .intra_t = &.{},
+            .nz_info = &.{},
+            .mb_data = &.{},
+            .f_info = &.{},
+            .yuv_t = &.{},
+        };
+        errdefer fr.deinitScratch(gpa);
+        errdefer fr.deinitPlanes(gpa);
+        fr.y = try gpa.alloc(u8, mb_w * 16 * mb_h * 16);
+        fr.u = try gpa.alloc(u8, mb_w * 8 * mb_h * 8);
+        fr.v = try gpa.alloc(u8, mb_w * 8 * mb_h * 8);
+        fr.intra_t = try gpa.alloc(u8, 4 * mb_w);
+        @memset(fr.intra_t, 0);
+        fr.nz_info = try gpa.alloc(tree.Nz, mb_w + 1);
+        @memset(fr.nz_info, .{});
+        fr.mb_data = try gpa.alloc(tree.MbData, mb_w);
+        @memset(fr.mb_data, .{});
+        fr.f_info = try gpa.alloc(FInfo, mb_w);
+        @memset(fr.f_info, .{});
+        fr.yuv_t = try gpa.alloc(TopSamples, mb_w);
+        return fr;
+    }
+
+    fn deinitScratch(fr: *Frame, gpa: Allocator) void {
+        gpa.free(fr.intra_t);
+        gpa.free(fr.nz_info);
+        gpa.free(fr.mb_data);
+        gpa.free(fr.f_info);
+        gpa.free(fr.yuv_t);
+        fr.intra_t = &.{};
+        fr.nz_info = &.{};
+        fr.mb_data = &.{};
+        fr.f_info = &.{};
+        fr.yuv_t = &.{};
+    }
+
+    fn deinitPlanes(fr: *Frame, gpa: Allocator) void {
+        gpa.free(fr.y);
+        gpa.free(fr.u);
+        gpa.free(fr.v);
+        fr.y = &.{};
+        fr.u = &.{};
+        fr.v = &.{};
+    }
+
+    /// ``VP8DecodeMB``: the residuals (unless skipped) and the macroblock's filter limits.
+    fn decodeMb(fr: *Frame, ps: *tree.Parser, token_br: *BitReader, mb_x: usize) void {
+        const block = &fr.mb_data[mb_x];
+        var skip = ps.use_skip_proba and block.skip;
+        if (!skip) {
+            skip = ps.parseResiduals(token_br, block, mb_x);
+        } else {
+            const left = &ps.nz_info[0];
+            const mb = &ps.nz_info[1 + mb_x];
+            left.nz = 0;
+            mb.nz = 0;
+            if (!block.is_i4x4) {
+                left.nz_dc = 0;
+                mb.nz_dc = 0;
+            }
+            block.non_zero_y = 0;
+            block.non_zero_uv = 0;
+        }
+        if (fr.hdr.filter_type > 0) {
+            fr.f_info[mb_x] = fr.fstrengths[block.segment][@intFromBool(block.is_i4x4)];
+            fr.f_info[mb_x].inner = fr.f_info[mb_x].inner or !skip;
+        }
+    }
+
+    /// ``ReconstructRow``: predict and add residuals for macroblock row ``mb_y`` into the frame.
+    fn reconstructRow(fr: *Frame, mb_y: usize) void {
+        const b = &fr.yuv_b;
+        for (0..16) |j| b[y_off + j * bps - 1] = 129;
+        for (0..8) |j| {
+            b[u_off + j * bps - 1] = 129;
+            b[v_off + j * bps - 1] = 129;
+        }
+        if (mb_y > 0) {
+            b[y_off - 1 - bps] = 129;
+            b[u_off - 1 - bps] = 129;
+            b[v_off - 1 - bps] = 129;
+        } else {
+            @memset(b[y_off - bps - 1 ..][0 .. 16 + 4 + 1], 127);
+            @memset(b[u_off - bps - 1 ..][0 .. 8 + 1], 127);
+            @memset(b[v_off - bps - 1 ..][0 .. 8 + 1], 127);
+        }
+        for (0..fr.mb_w) |mb_x| {
+            const block = &fr.mb_data[mb_x];
+            if (mb_x > 0) { // rotate in the left samples, four at a time, from row -1
+                for (0..17) |r| {
+                    const at = y_off + r * bps - bps;
+                    @memcpy(b[at - 4 ..][0..4], b[at + 12 ..][0..4]);
+                }
+                for (0..9) |r| {
+                    for ([2]usize{ u_off, v_off }) |o| {
+                        const at = o + r * bps - bps;
+                        @memcpy(b[at - 4 ..][0..4], b[at + 4 ..][0..4]);
+                    }
+                }
+            }
+            const top = &fr.yuv_t[mb_x];
+            const coeffs = &block.coeffs;
+            var bits = block.non_zero_y;
+            if (mb_y > 0) {
+                @memcpy(b[y_off - bps ..][0..16], &top.y);
+                @memcpy(b[u_off - bps ..][0..8], &top.u);
+                @memcpy(b[v_off - bps ..][0..8], &top.v);
+            }
+            if (block.is_i4x4) {
+                const tr = y_off - bps + 16;
+                if (mb_y > 0) {
+                    if (mb_x >= fr.mb_w - 1) {
+                        @memset(b[tr..][0..4], top.y[15]);
+                    } else @memcpy(b[tr..][0..4], fr.yuv_t[mb_x + 1].y[0..4]);
+                }
+                for (1..4) |k| @memcpy(b[tr + 4 * k * bps ..][0..4], b[tr..][0..4]);
+                for (0..16) |n| {
+                    const dst = y_off + scan[n];
+                    dsp.predLuma4(block.imodes[n], b, dst);
+                    doTransform(bits, coeffs[n * 16 ..][0..16], b, dst);
+                    bits <<= 2;
+                }
+            } else {
+                dsp.predLuma16(checkMode(mb_x, mb_y, block.imodes[0]), b, y_off);
+                if (bits != 0) {
+                    for (0..16) |n| {
+                        doTransform(bits, coeffs[n * 16 ..][0..16], b, y_off + scan[n]);
+                        bits <<= 2;
+                    }
+                }
+            }
+            const uv_mode = checkMode(mb_x, mb_y, block.uvmode);
+            dsp.predChroma8(uv_mode, b, u_off);
+            dsp.predChroma8(uv_mode, b, v_off);
+            doUvTransform(block.non_zero_uv, coeffs[16 * 16 ..][0..64], b, u_off);
+            doUvTransform(block.non_zero_uv >> 8, coeffs[20 * 16 ..][0..64], b, v_off);
+            if (mb_y < fr.mb_h - 1) {
+                @memcpy(&top.y, b[y_off + 15 * bps ..][0..16]);
+                @memcpy(&top.u, b[u_off + 7 * bps ..][0..8]);
+                @memcpy(&top.v, b[v_off + 7 * bps ..][0..8]);
+            }
+            const ys = fr.mb_w * 16;
+            const uvs = fr.mb_w * 8;
+            for (0..16) |j| @memcpy(fr.y[(mb_y * 16 + j) * ys + mb_x * 16 ..][0..16], b[y_off + j * bps ..][0..16]);
+            for (0..8) |j| {
+                @memcpy(fr.u[(mb_y * 8 + j) * uvs + mb_x * 8 ..][0..8], b[u_off + j * bps ..][0..8]);
+                @memcpy(fr.v[(mb_y * 8 + j) * uvs + mb_x * 8 ..][0..8], b[v_off + j * bps ..][0..8]);
+            }
+        }
+    }
+
+    /// ``FilterRow`` / ``DoFilter``: the loop filter over macroblock row ``mb_y``, left to right.
+    fn filterRow(fr: *Frame, mb_y: usize) void {
+        const ys = fr.mb_w * 16;
+        const uvs = fr.mb_w * 8;
+        for (0..fr.mb_w) |mb_x| {
+            const f = fr.f_info[mb_x];
+            if (f.limit == 0) continue;
+            const limit: i32 = f.limit;
+            const il: i32 = f.ilevel;
+            const hv: i32 = f.hev_thresh;
+            const yd = mb_y * 16 * ys + mb_x * 16;
+            if (fr.hdr.filter_type == 1) {
+                if (mb_x > 0) dsp.simpleFilter16(fr.y, yd, ys, limit + 4, false);
+                if (f.inner) dsp.simpleFilter16i(fr.y, yd, ys, limit, false);
+                if (mb_y > 0) dsp.simpleFilter16(fr.y, yd, ys, limit + 4, true);
+                if (f.inner) dsp.simpleFilter16i(fr.y, yd, ys, limit, true);
+                continue;
+            }
+            const ud = mb_y * 8 * uvs + mb_x * 8;
+            if (mb_x > 0) {
+                dsp.filterLoop(fr.y, yd, 1, ys, 16, limit + 4, il, hv, true);
+                for ([2][]u8{ fr.u, fr.v }) |p| dsp.filterLoop(p, ud, 1, uvs, 8, limit + 4, il, hv, true);
+            }
+            if (f.inner) {
+                for (1..4) |k| dsp.filterLoop(fr.y, yd + 4 * k, 1, ys, 16, limit, il, hv, false);
+                for ([2][]u8{ fr.u, fr.v }) |p| dsp.filterLoop(p, ud + 4, 1, uvs, 8, limit, il, hv, false);
+            }
+            if (mb_y > 0) {
+                dsp.filterLoop(fr.y, yd, ys, 1, 16, limit + 4, il, hv, true);
+                for ([2][]u8{ fr.u, fr.v }) |p| dsp.filterLoop(p, ud, uvs, 1, 8, limit + 4, il, hv, true);
+            }
+            if (f.inner) {
+                for (1..4) |k| dsp.filterLoop(fr.y, yd + 4 * k * ys, ys, 1, 16, limit, il, hv, false);
+                for ([2][]u8{ fr.u, fr.v }) |p| dsp.filterLoop(p, ud + 4 * uvs, uvs, 1, 8, limit, il, hv, false);
+            }
+        }
+    }
+
+    /// The planes cropped to the frame size in place (rows move down to the narrower stride), then shrunk.
+    fn crop(fr: *Frame, gpa: Allocator) Error!Yuv {
+        const w: usize = fr.w;
+        const uv_w = (w + 1) / 2;
+        const uv_h = (@as(usize, fr.h) + 1) / 2;
+        for (0..fr.h) |r| std.mem.copyForwards(u8, fr.y[r * w ..][0..w], fr.y[r * fr.mb_w * 16 ..][0..w]);
+        for (0..uv_h) |r| {
+            std.mem.copyForwards(u8, fr.u[r * uv_w ..][0..uv_w], fr.u[r * fr.mb_w * 8 ..][0..uv_w]);
+            std.mem.copyForwards(u8, fr.v[r * uv_w ..][0..uv_w], fr.v[r * fr.mb_w * 8 ..][0..uv_w]);
+        }
+        fr.y = try gpa.realloc(fr.y, w * fr.h);
+        fr.u = try gpa.realloc(fr.u, uv_w * uv_h);
+        fr.v = try gpa.realloc(fr.v, uv_w * uv_h);
+        const out: Yuv = .{ .w = fr.w, .h = fr.h, .y = fr.y, .u = fr.u, .v = fr.v, .uv_w = @intCast(uv_w) };
+        fr.y = &.{};
+        fr.u = &.{};
+        fr.v = &.{};
+        return out;
+    }
+};
+
+/// A 1x1 key frame: q 0, no filter, one partition of zero tokens.
+const tiny = [_]u8{ 0x50, 0x01, 0x00, 0x9d, 0x01, 0x2a, 0x01, 0x00, 0x01, 0x00 } ++ @as([14]u8, @splat(0));
+
+test "a 1x1 frame of zero tokens decodes to the DC predictors' 128 grey" {
+    var yuv = try decode(std.testing.allocator, &tiny, 1 << 20);
+    defer yuv.deinit(std.testing.allocator);
+    try std.testing.expectEqual(@as(u32, 1), yuv.uv_w);
+    try std.testing.expectEqual(@as(usize, 1), yuv.y.len);
+    try std.testing.expectEqual(@as(u8, 128), yuv.u[0]);
+}
+
+test "malformed and oversized frames are refused" {
+    const gpa = std.testing.allocator;
+    try std.testing.expectError(error.BadWebp, decode(gpa, tiny[0..9], 1 << 20));
+    var bad = tiny;
+    bad[3] = 0;
+    try std.testing.expectError(error.BadWebp, decode(gpa, &bad, 1 << 20));
+    try std.testing.expectError(error.BadWebp, decode(gpa, tiny[0..20], 1 << 20)); // no token partition
+    try std.testing.expectError(error.TooManyPixels, decode(gpa, &tiny, 0));
+    for (0..tiny.len) |n| {
+        if (decode(gpa, tiny[0..n], 1 << 20)) |y| {
+            var yy = y;
+            yy.deinit(gpa);
+        } else |_| {}
+    }
+}
diff --git a/zig/src/families/deepseek_v41/vision/webp_vp8_bits.zig b/zig/src/families/deepseek_v41/vision/webp_vp8_bits.zig
new file mode 100644
index 0000000000000000000000000000000000000000..6743b5fc8888805ea0cb287a92274c0cb9950473
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision/webp_vp8_bits.zig
@@ -0,0 +1,110 @@
+//! VP8's boolean decoder as libwebp 1.6.0 reads it (``utils/bit_reader_utils.c``, ``bit_reader_inl_utils.h``).
+const std = @import("std");
+
+/// One partition's reader: past its end one zero byte is shifted in and ``eof`` raised, then nothing more is loaded.
+pub const BitReader = struct {
+    value: u64 = 0,
+    range: u32 = 255 - 1, // the range minus 1, in [127, 254]
+    bits: i32 = -8, // valid bits left in ``value``
+    buf: []const u8,
+    pos: usize = 0,
+    eof: bool = false,
+
+    /// ``VP8InitBitReader``: the first bytes are loaded at once.
+    pub fn init(data: []const u8) BitReader {
+        var br: BitReader = .{ .buf = data };
+        br.loadNewBytes();
+        return br;
+    }
+
+    fn loadNewBytes(br: *BitReader) void {
+        if (br.buf.len >= 8 and br.pos < br.buf.len - 7) { // ``buf < buf_max``: 7 bytes from one 8-byte load
+            const in = std.mem.readInt(u64, br.buf[br.pos..][0..8], .big);
+            br.pos += 7;
+            br.value = (in >> 8) | (br.value << 56);
+            br.bits += 56;
+        } else br.loadFinalBytes();
+    }
+
+    fn loadFinalBytes(br: *BitReader) void {
+        if (br.pos < br.buf.len) {
+            br.bits += 8;
+            br.value = br.buf[br.pos] | (br.value << 8);
+            br.pos += 1;
+        } else if (!br.eof) {
+            br.value <<= 8;
+            br.bits += 8;
+            br.eof = true;
+        } else br.bits = 0;
+    }
+
+    /// ``VP8GetBit``: one bit of probability ``prob`` / 256 of being 0.
+    pub fn getBit(br: *BitReader, prob: u32) u1 {
+        var range = br.range;
+        if (br.bits < 0) br.loadNewBytes();
+        const pos: u6 = @intCast(br.bits);
+        const split = (range * prob) >> 8;
+        const value: u32 = @truncate(br.value >> pos);
+        const bit = value > split;
+        if (bit) {
+            range -= split;
+            br.value -%= @as(u64, split + 1) << pos;
+        } else range = split + 1;
+        const shift: u5 = @intCast(7 ^ std.math.log2_int(u32, range));
+        range <<= shift;
+        br.bits -= shift;
+        br.range = range - 1;
+        return @intFromBool(bit);
+    }
+
+    /// ``VP8GetSigned``: ``v`` or ``-v`` on one even-probability bit.
+    pub fn getSigned(br: *BitReader, v: i32) i32 {
+        if (br.bits < 0) br.loadNewBytes();
+        const pos: u6 = @intCast(br.bits);
+        const split = br.range >> 1;
+        const value: u32 = @truncate(br.value >> pos);
+        const mask: i32 = @as(i32, @bitCast(split -% value)) >> 31;
+        br.bits -= 1;
+        br.range +%= @bitCast(mask);
+        br.range |= 1;
+        br.value -%= @as(u64, (split + 1) & @as(u32, @bitCast(mask))) << pos;
+        return (v ^ mask) -% mask;
+    }
+
+    /// ``VP8GetValue``: ``n`` even-probability bits, most significant first.
+    pub fn getValue(br: *BitReader, n: u5) u32 {
+        var v: u32 = 0;
+        var k = n;
+        while (k > 0) {
+            k -= 1;
+            v |= @as(u32, br.getBit(0x80)) << k;
+        }
+        return v;
+    }
+
+    /// ``VP8GetSignedValue``: ``n`` bits of magnitude, then the sign.
+    pub fn getSignedValue(br: *BitReader, n: u5) i32 {
+        const v: i32 = @intCast(br.getValue(n));
+        return if (br.getBit(0x80) == 1) -v else v;
+    }
+};
+
+test "an all-zero partition reads zeros, and eof rises one byte past its end" {
+    var br = BitReader.init(&.{ 0, 0 });
+    try std.testing.expectEqual(@as(u32, 0), br.getValue(8));
+    try std.testing.expect(!br.eof);
+    _ = br.getValue(16);
+    try std.testing.expect(br.eof);
+    const zeros: [20]u8 = @splat(0);
+    var big = BitReader.init(&zeros);
+    for (0..100) |_| try std.testing.expectEqual(@as(u1, 0), big.getBit(200));
+    try std.testing.expect(!big.eof);
+}
+
+test "a 0xff stream reads ones, and the signed value takes its sign bit" {
+    const ones: [16]u8 = @splat(0xff);
+    var br = BitReader.init(&ones);
+    try std.testing.expectEqual(@as(u32, 0x7f), br.getValue(7));
+    try std.testing.expectEqual(@as(i32, -3), br.getSignedValue(2));
+    try std.testing.expectEqual(@as(i32, -5), br.getSigned(5));
+}
diff --git a/zig/src/families/deepseek_v41/vision/webp_vp8_dsp.zig b/zig/src/families/deepseek_v41/vision/webp_vp8_dsp.zig
new file mode 100644
index 0000000000000000000000000000000000000000..97059561fabaaa26f3caef61486f665d99b4300b
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision/webp_vp8_dsp.zig
@@ -0,0 +1,406 @@
+//! VP8 reconstruction as libwebp 1.6.0 runs it (``dsp/dec.c``, the IDCT as ``dsp/dec_sse2.c``).
+const std = @import("std");
+
+/// The work buffer's stride (``BPS``).
+pub const bps = 32;
+
+fn clip8(v: i32) u8 {
+    return if (v & ~@as(i32, 0xff) == 0) @intCast(v) else if (v < 0) 0 else 255;
+}
+
+fn clip1(v: i32) u8 { // ``VP8kclip1``
+    return @intCast(std.math.clamp(v, 0, 255));
+}
+
+fn sclip1(v: i32) i32 { // ``VP8ksclip1``
+    return std.math.clamp(v, -128, 127);
+}
+
+fn sclip2(v: i32) i32 { // ``VP8ksclip2``
+    return std.math.clamp(v, -16, 15);
+}
+
+fn abs0(v: i32) i32 { // ``VP8kabs0``
+    return @intCast(@abs(v));
+}
+
+fn mul1(a: i32) i32 { // ``WEBP_TRANSFORM_AC3_MUL1``
+    return ((a *% 20091) >> 16) +% a;
+}
+
+fn mul2(a: i32) i32 { // ``WEBP_TRANSFORM_AC3_MUL2``
+    return (a *% 35468) >> 16;
+}
+
+fn store(b: []u8, at: usize, v: i32) void {
+    b[at] = clip8(@as(i32, b[at]) +% (v >> 3));
+}
+
+fn mulHi(a: i16, k: i32) i16 { // ``_mm_mulhi_epi16``
+    return @truncate((@as(i32, a) * k) >> 16);
+}
+
+/// One pass of ``Transform_SSE2`` on a column: ``x * K >> 16`` as ``mulhi(x, K - 65536) + x``, 16-bit wrapping sums.
+fn pass(x0: i16, x1: i16, x2: i16, x3: i16) [4]i16 {
+    const a = x0 +% x2;
+    const b = x0 -% x2;
+    const c = (x1 -% x3) +% (mulHi(x1, -30068) -% mulHi(x3, 20091));
+    const d = (x1 +% x3) +% (mulHi(x1, 20091) +% mulHi(x3, -30068));
+    return .{ a +% d, b +% c, b -% c, a -% d };
+}
+
+/// ``VP8Transform``: the 4x4 inverse DCT of ``in`` added to the block at ``d``, in ``Transform_SSE2``'s 16-bit lanes.
+pub fn transform(in: []const i16, b: []u8, d: usize) void {
+    var t: [4][4]i16 = undefined; // t[i] = column i after the vertical pass, then read across for the horizontal one
+    for (0..4) |i| t[i] = pass(in[i], in[4 + i], in[8 + i], in[12 + i]);
+    for (0..4) |i| {
+        const r = pass(t[0][i] +% 4, t[1][i], t[2][i], t[3][i]);
+        for (0..4) |x| {
+            const v = @as(i16, b[d + i * bps + x]) +% (r[x] >> 3);
+            b[d + i * bps + x] = @intCast(std.math.clamp(v, 0, 255));
+        }
+    }
+}
+
+/// ``TransformAC3_C``: the inverse DCT when only ``in[0]``, ``in[1]`` and ``in[4]`` are non-zero.
+pub fn transformAc3(in: []const i16, b: []u8, d: usize) void {
+    const a = @as(i32, in[0]) + 4;
+    const c4 = mul2(in[4]);
+    const d4 = mul1(in[4]);
+    const c1 = mul2(in[1]);
+    const d1 = mul1(in[1]);
+    const dcs = [4]i32{ a + d4, a + c4, a - c4, a - d4 };
+    for (dcs, 0..) |dc, y| {
+        const row = d + y * bps;
+        store(b, row + 0, dc + d1);
+        store(b, row + 1, dc + c1);
+        store(b, row + 2, dc - c1);
+        store(b, row + 3, dc - d1);
+    }
+}
+
+/// ``TransformDC_C``: the inverse DCT of a DC-only block.
+pub fn transformDc(in: []const i16, b: []u8, d: usize) void {
+    const dc = @as(i32, in[0]) + 4;
+    for (0..4) |y| {
+        for (0..4) |x| store(b, d + x + y * bps, dc);
+    }
+}
+
+/// ``TransformUV_C``: the four 4x4 blocks of an 8x8 chroma block.
+pub fn transformUv(in: []const i16, b: []u8, d: usize) void {
+    transform(in[0..], b, d);
+    transform(in[16..], b, d + 4);
+    transform(in[32..], b, d + 4 * bps);
+    transform(in[48..], b, d + 4 * bps + 4);
+}
+
+/// ``TransformDCUV_C``: the DC-only transform of each chroma block with a non-zero DC.
+pub fn transformDcUv(in: []const i16, b: []u8, d: usize) void {
+    const offs = [4]usize{ 0, 4, 4 * bps, 4 * bps + 4 };
+    for (offs, 0..) |o, k| {
+        if (in[k * 16] != 0) transformDc(in[k * 16 ..], b, d + o);
+    }
+}
+
+/// ``TransformWHT_C``: the inverse Walsh-Hadamard transform of the 16 luma DCs into ``out[16 k]``.
+pub fn transformWht(in: *const [16]i16, out: []i16) void {
+    var tmp: [16]i32 = undefined;
+    for (0..4) |i| {
+        const a0 = @as(i32, in[0 + i]) + in[12 + i];
+        const a1 = @as(i32, in[4 + i]) + in[8 + i];
+        const a2 = @as(i32, in[4 + i]) - in[8 + i];
+        const a3 = @as(i32, in[0 + i]) - in[12 + i];
+        tmp[0 + i] = a0 + a1;
+        tmp[8 + i] = a0 - a1;
+        tmp[4 + i] = a3 + a2;
+        tmp[12 + i] = a3 - a2;
+    }
+    for (0..4) |i| {
+        const dc = tmp[0 + i * 4] + 3;
+        const a0 = dc + tmp[3 + i * 4];
+        const a1 = tmp[1 + i * 4] + tmp[2 + i * 4];
+        const a2 = tmp[1 + i * 4] - tmp[2 + i * 4];
+        const a3 = dc - tmp[3 + i * 4];
+        out[64 * i + 0] = @truncate((a0 + a1) >> 3);
+        out[64 * i + 16] = @truncate((a3 + a2) >> 3);
+        out[64 * i + 32] = @truncate((a0 - a1) >> 3);
+        out[64 * i + 48] = @truncate((a3 - a2) >> 3);
+    }
+}
+
+fn trueMotion(b: []u8, d0: usize, size: usize) void {
+    const top = d0 - bps;
+    const tl: i32 = b[top - 1];
+    var d = d0;
+    for (0..size) |_| {
+        const left: i32 = b[d - 1];
+        for (0..size) |x| b[d + x] = clip1(left + b[top + x] - tl);
+        d += bps;
+    }
+}
+
+fn fill(b: []u8, d: usize, size: usize, v: u8) void {
+    for (0..size) |j| @memset(b[d + j * bps ..][0..size], v);
+}
+
+/// ``VP8PredLuma16``: modes DC, TM, VE, HE, DC without top, DC without left, DC without either.
+pub fn predLuma16(mode: u8, b: []u8, d: usize) void {
+    switch (mode) {
+        0 => {
+            var dc: u32 = 16;
+            for (0..16) |j| dc += @as(u32, b[d - 1 + j * bps]) + b[d + j - bps];
+            fill(b, d, 16, @intCast(dc >> 5));
+        },
+        1 => trueMotion(b, d, 16),
+        2 => for (0..16) |j| @memcpy(b[d + j * bps ..][0..16], b[d - bps ..][0..16]),
+        3 => for (0..16) |j| @memset(b[d + j * bps ..][0..16], b[d + j * bps - 1]),
+        4 => {
+            var dc: u32 = 8;
+            for (0..16) |j| dc += b[d - 1 + j * bps];
+            fill(b, d, 16, @intCast(dc >> 4));
+        },
+        5 => {
+            var dc: u32 = 8;
+            for (0..16) |i| dc += b[d + i - bps];
+            fill(b, d, 16, @intCast(dc >> 4));
+        },
+        else => fill(b, d, 16, 0x80),
+    }
+}
+
+/// ``VP8PredChroma8``: the same seven modes on an 8x8 chroma block.
+pub fn predChroma8(mode: u8, b: []u8, d: usize) void {
+    switch (mode) {
+        0 => {
+            var dc: u32 = 8;
+            for (0..8) |i| dc += @as(u32, b[d + i - bps]) + b[d - 1 + i * bps];
+            fill(b, d, 8, @intCast(dc >> 4));
+        },
+        1 => trueMotion(b, d, 8),
+        2 => for (0..8) |j| @memcpy(b[d + j * bps ..][0..8], b[d - bps ..][0..8]),
+        3 => for (0..8) |j| @memset(b[d + j * bps ..][0..8], b[d + j * bps - 1]),
+        4 => {
+            var dc: u32 = 4;
+            for (0..8) |i| dc += b[d - 1 + i * bps];
+            fill(b, d, 8, @intCast(dc >> 3));
+        },
+        5 => {
+            var dc: u32 = 4;
+            for (0..8) |i| dc += b[d + i - bps];
+            fill(b, d, 8, @intCast(dc >> 3));
+        },
+        else => fill(b, d, 8, 0x80),
+    }
+}
+
+fn avg3(a: u32, b: u32, c: u32) u8 {
+    return @intCast((a + 2 * b + c + 2) >> 2);
+}
+
+fn avg2(a: u32, b: u32) u8 {
+    return @intCast((a + b + 1) >> 1);
+}
+
+/// ``VP8PredLuma4``: the ten 4x4 modes (DC, TM, VE, HE, RD, VR, LD, VL, HD, HU) at ``d``.
+pub fn predLuma4(mode: u8, b: []u8, d: usize) void {
+    const t = d - bps; // top row; t - 1 is the top-left sample
+    const i_: u32 = b[d - 1];
+    const j_: u32 = b[d - 1 + bps];
+    const k_: u32 = b[d - 1 + 2 * bps];
+    const l_: u32 = b[d - 1 + 3 * bps];
+    const x_: u32 = b[t - 1];
+    var top: [8]u32 = undefined;
+    for (&top, 0..) |*v, n| v.* = b[t + n];
+    const a, const b_, const c, const d_, const e, const f, const g, const h = top;
+    var o: [4][4]u8 = undefined; // o[y][x]
+    switch (mode) {
+        0 => {
+            var dc: u32 = 4;
+            for (0..4) |n| dc += @as(u32, b[t + n]) + b[d - 1 + n * bps];
+            o = @splat(@splat(@intCast(dc >> 3)));
+        },
+        1 => return trueMotion(b, d, 4),
+        2 => {
+            const r = [4]u8{ avg3(x_, a, b_), avg3(a, b_, c), avg3(b_, c, d_), avg3(c, d_, e) };
+            o = .{ r, r, r, r };
+        },
+        3 => {
+            const r = [4]u8{ avg3(x_, i_, j_), avg3(i_, j_, k_), avg3(j_, k_, l_), avg3(k_, l_, l_) };
+            for (0..4) |y| o[y] = @splat(r[y]);
+        },
+        4 => { // down-right: constant along each diagonal x - y
+            const v = [7]u8{ avg3(j_, k_, l_), avg3(i_, j_, k_), avg3(x_, i_, j_), avg3(a, x_, i_), avg3(b_, a, x_), avg3(c, b_, a), avg3(d_, c, b_) };
+            for (0..4) |y| for (0..4) |x| {
+                o[y][x] = v[3 + x - y];
+            };
+        },
+        5 => o = .{
+            .{ avg2(x_, a), avg2(a, b_), avg2(b_, c), avg2(c, d_) },
+            .{ avg3(i_, x_, a), avg3(x_, a, b_), avg3(a, b_, c), avg3(b_, c, d_) },
+            .{ avg3(j_, i_, x_), avg2(x_, a), avg2(a, b_), avg2(b_, c) },
+            .{ avg3(k_, j_, i_), avg3(i_, x_, a), avg3(x_, a, b_), avg3(a, b_, c) },
+        },
+        6 => { // down-left: constant along each anti-diagonal x + y
+            const v = [7]u8{ avg3(a, b_, c), avg3(b_, c, d_), avg3(c, d_, e), avg3(d_, e, f), avg3(e, f, g), avg3(f, g, h), avg3(g, h, h) };
+            for (0..4) |y| for (0..4) |x| {
+                o[y][x] = v[x + y];
+            };
+        },
+        7 => o = .{
+            .{ avg2(a, b_), avg2(b_, c), avg2(c, d_), avg2(d_, e) },
+            .{ avg3(a, b_, c), avg3(b_, c, d_), avg3(c, d_, e), avg3(d_, e, f) },
+            .{ avg2(b_, c), avg2(c, d_), avg2(d_, e), avg3(e, f, g) },
+            .{ avg3(b_, c, d_), avg3(c, d_, e), avg3(d_, e, f), avg3(f, g, h) },
+        },
+        8 => o = .{
+            .{ avg2(i_, x_), avg3(i_, x_, a), avg3(x_, a, b_), avg3(a, b_, c) },
+            .{ avg2(j_, i_), avg3(j_, i_, x_), avg2(i_, x_), avg3(i_, x_, a) },
+            .{ avg2(k_, j_), avg3(k_, j_, i_), avg2(j_, i_), avg3(j_, i_, x_) },
+            .{ avg2(l_, k_), avg3(l_, k_, j_), avg2(k_, j_), avg3(k_, j_, i_) },
+        },
+        else => {
+            const l8: u8 = @intCast(l_);
+            o = .{
+                .{ avg2(i_, j_), avg3(i_, j_, k_), avg2(j_, k_), avg3(j_, k_, l_) },
+                .{ avg2(j_, k_), avg3(j_, k_, l_), avg2(k_, l_), avg3(k_, l_, l_) },
+                .{ avg2(k_, l_), avg3(k_, l_, l_), l8, l8 },
+                .{ l8, l8, l8, l8 },
+            };
+        },
+    }
+    for (0..4) |y| @memcpy(b[d + y * bps ..][0..4], &o[y]);
+}
+
+fn doFilter2(b: []u8, p: usize, s: usize) void {
+    const p1: i32 = b[p - 2 * s];
+    const p0: i32 = b[p - s];
+    const q0: i32 = b[p];
+    const q1: i32 = b[p + s];
+    const a = 3 * (q0 - p0) + sclip1(p1 - q1);
+    const a1 = sclip2((a + 4) >> 3);
+    const a2 = sclip2((a + 3) >> 3);
+    b[p - s] = clip1(p0 + a2);
+    b[p] = clip1(q0 - a1);
+}
+
+fn doFilter4(b: []u8, p: usize, s: usize) void {
+    const p1: i32 = b[p - 2 * s];
+    const p0: i32 = b[p - s];
+    const q0: i32 = b[p];
+    const q1: i32 = b[p + s];
+    const a = 3 * (q0 - p0);
+    const a1 = sclip2((a + 4) >> 3);
+    const a2 = sclip2((a + 3) >> 3);
+    const a3 = (a1 + 1) >> 1;
+    b[p - 2 * s] = clip1(p1 + a3);
+    b[p - s] = clip1(p0 + a2);
+    b[p] = clip1(q0 - a1);
+    b[p + s] = clip1(q1 - a3);
+}
+
+fn doFilter6(b: []u8, p: usize, s: usize) void {
+    const p2: i32 = b[p - 3 * s];
+    const p1: i32 = b[p - 2 * s];
+    const p0: i32 = b[p - s];
+    const q0: i32 = b[p];
+    const q1: i32 = b[p + s];
+    const q2: i32 = b[p + 2 * s];
+    const a = sclip1(3 * (q0 - p0) + sclip1(p1 - q1));
+    const a1 = (27 * a + 63) >> 7;
+    const a2 = (18 * a + 63) >> 7;
+    const a3 = (9 * a + 63) >> 7;
+    b[p - 3 * s] = clip1(p2 + a3);
+    b[p - 2 * s] = clip1(p1 + a2);
+    b[p - s] = clip1(p0 + a1);
+    b[p] = clip1(q0 - a1);
+    b[p + s] = clip1(q1 - a2);
+    b[p + 2 * s] = clip1(q2 - a3);
+}
+
+fn px(b: []const u8, p: usize, s: usize, k: i32) i32 {
+    return b[if (k < 0) p - @as(usize, @intCast(-k)) * s else p + @as(usize, @intCast(k)) * s];
+}
+
+fn hev(b: []const u8, p: usize, s: usize, thresh: i32) bool {
+    return abs0(px(b, p, s, -2) - px(b, p, s, -1)) > thresh or abs0(px(b, p, s, 1) - px(b, p, s, 0)) > thresh;
+}
+
+fn needsFilter(b: []const u8, p: usize, s: usize, t: i32) bool {
+    return 4 * abs0(px(b, p, s, -1) - px(b, p, s, 0)) + abs0(px(b, p, s, -2) - px(b, p, s, 1)) <= t;
+}
+
+fn needsFilter2(b: []const u8, p: usize, s: usize, t: i32, it: i32) bool {
+    var v: [8]i32 = undefined; // p3 p2 p1 p0 q0 q1 q2 q3
+    for (&v, 0..) |*x, k| x.* = px(b, p, s, @as(i32, @intCast(k)) - 4);
+    if (4 * abs0(v[3] - v[4]) + abs0(v[2] - v[5]) > t) return false;
+    return abs0(v[0] - v[1]) <= it and abs0(v[1] - v[2]) <= it and abs0(v[2] - v[3]) <= it and
+        abs0(v[7] - v[6]) <= it and abs0(v[6] - v[5]) <= it and abs0(v[5] - v[4]) <= it;
+}
+
+/// ``SimpleVFilter16_C`` (``vertical``) / ``SimpleHFilter16_C``: the simple filter across one 16-sample edge.
+pub fn simpleFilter16(b: []u8, p: usize, stride: usize, thresh: i32, vertical: bool) void {
+    const thresh2 = 2 * thresh + 1;
+    for (0..16) |i| {
+        const q = if (vertical) p + i else p + i * stride;
+        const s = if (vertical) stride else 1;
+        if (needsFilter(b, q, s, thresh2)) doFilter2(b, q, s);
+    }
+}
+
+/// ``SimpleVFilter16i_C`` / ``SimpleHFilter16i_C``: the simple filter across the three inner edges.
+pub fn simpleFilter16i(b: []u8, p: usize, stride: usize, thresh: i32, vertical: bool) void {
+    for (1..4) |k| simpleFilter16(b, if (vertical) p + 4 * k * stride else p + 4 * k, stride, thresh, vertical);
+}
+
+/// ``FilterLoop26_C`` (``six``) / ``FilterLoop24_C``: the complex filter along ``size`` samples.
+pub fn filterLoop(b: []u8, p0: usize, hstride: usize, vstride: usize, size: usize, thresh: i32, ithresh: i32, hev_t: i32, six: bool) void {
+    const thresh2 = 2 * thresh + 1;
+    var p = p0;
+    for (0..size) |_| {
+        if (needsFilter2(b, p, hstride, thresh2, ithresh)) {
+            if (hev(b, p, hstride, hev_t)) {
+                doFilter2(b, p, hstride);
+            } else if (six) doFilter6(b, p, hstride) else doFilter4(b, p, hstride);
+        }
+        p += vstride;
+    }
+}
+
+test "the inverse DCT of a DC-only block adds (dc + 4) >> 3 everywhere" {
+    var b: [4 * bps]u8 = @splat(100);
+    var in: [16]i16 = @splat(0);
+    in[0] = 80;
+    var b2 = b;
+    transform(&in, &b, 0);
+    transformDc(&in, &b2, 0);
+    try std.testing.expectEqual(@as(u8, 110), b[0]);
+    try std.testing.expectEqualSlices(u8, &b2, &b);
+    transformAc3(&in, &b2, 0);
+    try std.testing.expectEqual(@as(u8, 120), b2[3 * bps + 3]);
+}
+
+test "the WHT of a lone DC spreads (dc + 3) >> 3 to all sixteen blocks" {
+    var in: [16]i16 = @splat(0);
+    in[0] = 85;
+    var out: [256]i16 = @splat(0);
+    transformWht(&in, &out);
+    for (0..16) |k| try std.testing.expectEqual(@as(i16, 11), out[k * 16]);
+}
+
+test "4x4 DC and TM predictions, and the simple filter smoothing a step" {
+    var b: [6 * bps]u8 = @splat(0);
+    const d = bps + 1;
+    for (0..5) |x| b[d - bps - 1 + x] = 40;
+    for (0..4) |y| b[d - 1 + y * bps] = 80;
+    predLuma4(0, &b, d);
+    try std.testing.expectEqual(@as(u8, 60), b[d + 3 * bps + 3]);
+    predLuma4(1, &b, d);
+    try std.testing.expectEqual(@as(u8, 80), b[d]);
+    var e: [16 * 8]u8 = undefined;
+    for (0..8) |y| for (0..16) |x| {
+        e[y * 16 + x] = if (y < 4) 100 else 110;
+    };
+    simpleFilter16(&e, 4 * 16, 16, 30, true);
+    try std.testing.expectEqualSlices(u8, &.{ 100, 102, 107, 110 }, &.{ e[2 * 16], e[3 * 16], e[4 * 16], e[5 * 16] });
+}
