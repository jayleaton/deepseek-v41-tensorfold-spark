+    defer arena.deinit();
+    var n = try native.Native.init(t.allocator, t.io, .{}, .{ .image_tokens = 5 });
+    defer n.deinit();
+    const pixels: [3 * 6 * 588]f32 = @splat(1);
+    const small: api.Image = .{ .pixels = pixels[0 .. 3 * 3 * 588], .gh = 3, .gw = 3, .tokens = 4, .at = 0 };
