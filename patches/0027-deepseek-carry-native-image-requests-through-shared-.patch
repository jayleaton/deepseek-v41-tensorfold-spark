diff --git a/zig/src/families/deepseek_v41/vision_kernels.zig b/zig/src/families/deepseek_v41/vision_kernels.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9fffd5d58bf181bc2df7fda615c19eb6ca5f4e18
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision_kernels.zig
@@ -0,0 +1,141 @@
+//! CUDA vision tower glue, attention and image-span launches on one stream.
+const std = @import("std");
+const cuda = @import("cuda");
+
+const Blob = struct {
+    pub const bytes align(16) = @embedFile("dsv41_fatbin_dsv41_vision").*;
+};
+const image: []const u8 = &Blob.bytes;
+
+/// The build embedded the kernels (-Dnvcc, or -Dfatbins with dsv41_vision.fatbin).
+pub const available = image.len > 0;
+
+const names = .{
+    .rms = "dsv41_vision_rms",
+    .rope = "dsv41_vision_rope",
+    .attn = "dsv41_vision_attn",
+    .silu = "dsv41_vision_silu_mul",
+    .gelu = "dsv41_vision_gelu",
+    .add = "dsv41_vision_add",
+    .unfold = "dsv41_vision_unfold",
+    .span = "dsv41_vision_span",
+};
+
+pub const Functions = struct {
+    module: cuda.Module,
+    rms: cuda.Function,
+    rope: cuda.Function,
+    attn: cuda.Function,
+    silu: cuda.Function,
+    gelu: cuda.Function,
+    add: cuda.Function,
+    unfold: cuda.Function,
+    span: cuda.Function,
+
+    pub fn load(d: *const cuda.Driver) !Functions {
+        if (!available) return error.VisionKernelNotBuilt;
+        var m = try cuda.Module.load(d, image);
+        errdefer m.unload();
+        var f: Functions = undefined;
+        f.module = m;
+        inline for (@typeInfo(@TypeOf(names)).@"struct".field_names) |name| @field(f, name) = try m.function(@field(names, name));
+        return f;
+    }
+
+    pub fn unload(f: *Functions) void {
+        f.module.unload();
+    }
+
+    pub fn ops(f: *const Functions, s: cuda.Stream) Ops {
+        return .{ .f = f, .s = s };
+    }
+};
+
+fn dims(x: usize, y: usize, z: usize) cuda.launch.Dim3 {
+    return .{ .x = @intCast(x), .y = @intCast(y), .z = @intCast(z) };
+}
+
+fn blocks(n: usize, per: usize) usize {
+    return (n + per - 1) / per;
+}
+
+/// The tower's launches on one stream.
+pub const Ops = struct {
+    f: *const Functions,
+    s: cuda.Stream,
+
+    fn go(o: Ops, func: cuda.Function, grid: cuda.launch.Dim3, block: cuda.launch.Dim3, args: *cuda.Args) !void {
+        try cuda.launch.launch(func, .{ .grid = grid, .block = block }, o.s, args);
+    }
+
+    /// _rms over [n, D] (n >= 16: torch's reduce config is then one warp a row; D a multiple of 128)
+    pub fn rms(o: Ops, x: u64, w: u64, out: u64, n: usize, D: usize, eps: f32) !void {
+        if (n < 16 or D % 128 != 0) return error.Shape;
+        var a: cuda.Args = .{};
+        a.add(x);
+        a.add(w);
+        a.add(out);
+        a.add(@as(c_int, @intCast(n)));
+        a.add(@as(c_int, @intCast(D)));
+        a.add(eps);
+        try o.go(o.f.rms, dims(blocks(n, 16), 1, 1), dims(32, 16, 1), &a);
+    }
+
+    pub fn rope(o: Ops, qkv: u64, q: u64, k: u64, v: u64, n: usize, nw: usize, heads: usize, theta: f32) !void {
+        var a: cuda.Args = .{};
+        inline for (.{ qkv, q, k, v }) |p| a.add(p);
+        a.add(@as(c_int, @intCast(n)));
+        a.add(@as(c_int, @intCast(nw)));
+        a.add(@as(c_int, @intCast(heads)));
+        a.add(theta);
+        try o.go(o.f.rope, dims(n, 1, 1), dims(heads * 32, 1, 1), &a);
+    }
+
+    pub fn attn(o: Ops, q: u64, k: u64, v: u64, out: u64, n: usize, heads: usize, scale_log2: f32) !void {
+        var a: cuda.Args = .{};
+        inline for (.{ q, k, v, out }) |p| a.add(p);
+        a.add(@as(c_int, @intCast(n)));
+        a.add(@as(c_int, @intCast(heads)));
+        a.add(scale_log2);
+        try o.go(o.f.attn, dims(blocks(n, 128), heads, 1), dims(128, 1, 1), &a);
+    }
+
+    pub fn siluMul(o: Ops, h: u64, out: u64, n: usize, I: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(h);
+        a.add(out);
+        a.add(@as(i64, @intCast(n)));
+        a.add(@as(c_int, @intCast(I)));
+        try o.go(o.f.silu, dims(blocks(n * I, 256), 1, 1), dims(256, 1, 1), &a);
+    }
+
+    pub fn gelu(o: Ops, x: u64, n: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(x);
+        a.add(@as(i64, @intCast(n)));
+        try o.go(o.f.gelu, dims(blocks(n, 256), 1, 1), dims(256, 1, 1), &a);
+    }
+
+    pub fn add(o: Ops, x: u64, y: u64, n: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(x);
+        a.add(y);
+        a.add(@as(i64, @intCast(n)));
+        try o.go(o.f.add, dims(blocks(n, 256), 1, 1), dims(256, 1, 1), &a);
+    }
+
+    pub fn unfold(o: Ops, x: u64, out: u64, h: usize, w: usize, C: usize, r: usize, L: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(x);
+        a.add(out);
+        inline for (.{ h, w, C, r }) |v| a.add(@as(c_int, @intCast(v)));
+        try o.go(o.f.unfold, dims(L, 1, 1), dims(256, 1, 1), &a);
+    }
+
+    pub fn span(o: Ops, feats: u64, start: u64, newline: u64, end: u64, out: u64, lh: usize, lw: usize, D: usize) !void {
+        var a: cuda.Args = .{};
+        inline for (.{ feats, start, newline, end, out }) |p| a.add(p);
+        inline for (.{ lh, lw, D }) |v| a.add(@as(c_int, @intCast(v)));
+        try o.go(o.f.span, dims(lh * (lw + 1) + 2, 1, 1), dims(256, 1, 1), &a);
+    }
+};
diff --git a/zig/src/families/deepseek_v41/vision_map_churn_test.zig b/zig/src/families/deepseek_v41/vision_map_churn_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d6e3b96b0103d14a36a44b353b5744f7c8691588
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision_map_churn_test.zig
@@ -0,0 +1,165 @@
+//! Churn the actual image owners while a retained request and bounded span resources stay live.
+const std = @import("std");
+const t = std.testing;
+const api = @import("engine_api");
+const held = @import("vision/held.zig");
+const Store = @import("vision/store.zig").Store;
+const Native = @import("vision_native.zig").Native;
+const Wrapper = @import("vision_engine.zig").Wrapper(Store);
+const Churn = @import("map_churn.zig").Churn;
+
+fn freeBuckets(map: anytype) !void {
+    const capacity = map.capacity();
+    try t.expect(capacity > 0);
+    var free: usize = 0;
+    for (map.metadata.?[0..capacity]) |bucket| free += @intFromBool(bucket.isFree());
+    try t.expect(free * 10 >= capacity);
+}
+
+const patches: [3 * 3 * 588]u16 = @splat(0x3f80);
+
+test "vision churn: actual Store retains image inputs while both indexes reclaim deleted buckets" {
+    var store: Store = .{ .gpa = t.allocator };
+    defer store.deinit();
+    var ids = [_]u32{ (1 << 24) + 1, (1 << 24) + 2, (1 << 24) + 3, (1 << 24) + 4 };
+    var image: held.HeldImage = .{ .patches = &patches, .vit_h = 3, .vit_w = 3, .llm_h = 1, .llm_w = 1, .digest = @splat(0), .vids = &ids, .n_vids = 4 };
+    const src: held.Held = .{ .images = @ptrCast(&image), .n = 1 };
+    try store.hold(1, &src);
+    const retained = store.holds.get(1).?;
+    const retained_id = ids[0];
+    for (0..2048) |i| {
+        std.mem.writeInt(u64, image.digest[0..8], i + 1, .little);
+        for (&ids, 0..) |*id, j| id.* = @intCast((1 << 24) + 5 + i * 4 + j);
+        try store.hold(i + 2, &src);
+        store.release(i + 2);
+        try t.expectEqual(@as(u32, 1), store.holds.count());
+        try t.expectEqual(@as(u32, 4), store.where.count());
+        try t.expect(store.holds.get(1).? == retained);
+        const loc = store.where.get(retained_id).?;
+        try t.expect(loc.img == &retained.slice()[0]);
+        try t.expectEqual(@as(u32, 1), loc.refs);
+        try t.expectEqual(retained_id, loc.img.vids[0]);
+        try t.expectEqualSlices(u16, &patches, loc.img.patches[0..patches.len]);
+        try freeBuckets(store.where);
+        try freeBuckets(store.holds);
+        try t.expect(store.where.capacity() <= 32 and store.holds.capacity() <= 16);
+    }
+    store.release(1);
+    try t.expectEqual(@as(u32, 0), store.where.count());
+    try t.expectEqual(@as(u32, 0), store.holds.count());
+}
+
+const Inner = struct {
+    retained: ?*const api.Request = null,
+    sink: ?api.Sink = null,
+
+    fn engine(f: *Inner) api.Engine {
+        return .{ .ctx = f, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+    fn info(_: *anyopaque) api.Info {
+        return .{};
+    }
+    fn submit(ctx: *anyopaque, id: api.Id, request: *const api.Request, sink: api.Sink) api.SubmitError!void {
+        const f: *Inner = @ptrCast(@alignCast(ctx));
+        if (id == 1) {
+            f.retained = request;
+            f.sink = sink;
+        } else {
+            sink.event(sink.ctx, id, &.{ .tokens = request.prompt[0..1] });
+            sink.event(sink.ctx, id, &.{ .finished = .{ .reason = .stop } });
+        }
+    }
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+const Result = struct {
+    token: ?u32 = null,
+    finished: bool = false,
+    transients: usize = 0,
+
+    fn event(ctx: *anyopaque, id: api.Id, ev: *const api.Event) void {
+        const r: *Result = @ptrCast(@alignCast(ctx));
+        if (id != 1) {
+            if (ev.* == .finished) r.transients += 1;
+            return;
+        }
+        switch (ev.*) {
+            .tokens => |tokens| r.token = tokens[0],
+            .finished => r.finished = true,
+            else => {},
+        }
+    }
+};
+
+test "vision churn: actual Wrapper keeps a retained request and its result through transient completions" {
+    var native = try Native.init(t.allocator, t.io, .{}, .{});
+    defer native.deinit();
+    var store: Store = .{ .gpa = t.allocator };
+    defer store.deinit();
+    var inner: Inner = .{};
+    var wrapper: Wrapper = .{ .gpa = t.allocator, .io = t.io, .inner = inner.engine(), .native = &native, .rows = &store };
+    defer wrapper.deinit();
+    var pixels: [3 * 6 * 588]f32 = @splat(1);
+    const image: api.Image = .{ .pixels = &pixels, .gh = 3, .gw = 6, .tokens = 5, .at = 0 };
+    const request: api.Request = .{ .prompt = &.{ 129264, 129264, 129264, 129264, 129264 }, .images = &.{image}, .max_tokens = 1 };
+    var result: Result = .{};
+    const sink: api.Sink = .{ .ctx = &result, .event = Result.event };
+    const engine = wrapper.engine();
+    try engine.submit(1, &request, sink);
+    const retained = inner.retained.?;
+    const first = retained.prompt[0];
+    var retained_ids: [5]u32 = undefined;
+    @memcpy(&retained_ids, retained.prompt);
+    for (0..1024) |i| {
+        pixels[0] = @floatFromInt(i + 2);
+        try engine.submit(i + 2, &request, sink);
+        try t.expectEqual(@as(u32, 1), wrapper.active.count());
+        try t.expectEqual(@as(u32, 1), store.holds.count());
+        try t.expectEqual(@as(u32, 5), store.where.count());
+        try t.expectEqualSlices(u32, &retained_ids, retained.prompt);
+        try t.expectEqual(@as(u16, 0x3f80), store.where.get(first).?.img.patches[0]);
+        try freeBuckets(wrapper.active);
+        try freeBuckets(store.holds);
+        try freeBuckets(store.where);
+        try t.expect(wrapper.active.capacity() <= 16);
+    }
+    try t.expectEqual(@as(usize, 1024), result.transients);
+    inner.sink.?.event(inner.sink.?.ctx, 1, &.{ .tokens = retained.prompt[0..1] });
+    try t.expectEqual(@as(?u32, first), result.token);
+    inner.sink.?.event(inner.sink.?.ctx, 1, &.{ .finished = .{ .reason = .stop } });
+    try t.expect(result.finished);
+    try t.expectEqual(@as(u32, 0), wrapper.active.count());
+    try t.expectEqual(@as(u32, 0), store.where.count());
+}
+
+test "vision churn: production span helper preserves a retained resource and bounded resource indices" {
+    var map: std.AutoHashMapUnmanaged([32]u8, usize) = .empty;
+    defer map.deinit(t.allocator);
+    var churn: Churn = .{};
+    const retained: [32]u8 = @splat(0);
+    var resources = [_]bool{ true, false };
+    try map.put(t.allocator, retained, 0);
+    const capacity = map.capacity();
+    for (0..4096) |i| {
+        var digest: [32]u8 = @splat(0);
+        std.mem.writeInt(u64, digest[0..8], i + 1, .little);
+        try t.expect(!resources[1]);
+        resources[1] = true;
+        try map.put(t.allocator, digest, 1);
+        const resource = map.fetchRemove(digest).?.value;
+        churn.dropped([32]u8, &map);
+        try t.expectEqual(@as(usize, 1), resource);
+        resources[resource] = false;
+        try t.expect(resources[map.get(retained).?]);
+        try t.expect(!resources[1]);
+        try t.expectEqual(@as(u32, 1), map.count());
+        try t.expectEqual(capacity, map.capacity());
+        try freeBuckets(map);
+    }
+}
diff --git a/zig/src/families/deepseek_v41/vision_native.zig b/zig/src/families/deepseek_v41/vision_native.zig
new file mode 100644
index 0000000000000000000000000000000000000000..87d6ccb489306326145a023151dffd146d107e9a
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision_native.zig
@@ -0,0 +1,114 @@
+//! The shared native vision contract: encoded bytes to patches, typed request images to owned virtual prompt ids.
+const std = @import("std");
+const api = @import("engine_api");
+const prep = @import("vision/prep.zig");
+const decode = @import("vision/decode.zig");
+const held = @import("vision/held.zig");
+const vids = @import("vision/vids.zig");
+const Allocator = std.mem.Allocator;
+
+pub const Native = struct {
+    gpa: Allocator,
+    io: std.Io,
+    settings: prep.Settings,
+    limits: api.VisionOpen,
+    registry: vids.Registry,
+
+    pub fn init(gpa: Allocator, io: std.Io, settings: prep.Settings, limits: api.VisionOpen) !Native {
+        if (settings.patch != 14 or settings.downsample != 3) return error.UnsupportedVisionGeometry;
+        if (limits.image_tokens < 5 or limits.image_tokens > (1 << 16) or limits.max_images == 0)
+            return error.BadVisionLimits;
+        return .{ .gpa = gpa, .io = io, .settings = settings, .limits = limits, .registry = .{ .gpa = gpa } };
+    }
+
+    pub fn deinit(n: *Native) void {
+        n.registry.deinit();
+    }
+
+    pub fn offer(n: *Native) api.Vision {
+        return .{ .ctx = n, .prepare = prepare, .image_token = n.settings.image_token, .image_tokens = n.limits.image_tokens, .max_images = n.limits.max_images };
+    }
+
+    fn prepare(ctx: *anyopaque, a: Allocator, bytes: []const u8, max_tokens: u32) !api.PreparedImage {
+        const n: *Native = @ptrCast(@alignCast(ctx));
+        if (bytes.len > n.settings.max_bytes) return error.TooLarge;
+        var settings = n.settings;
+        settings.cap_tokens = @min(@min(settings.budget(), n.limits.image_tokens), max_tokens);
+        if (settings.cap_tokens < 5) return error.NoGrid;
+        var which: []const u8 = "";
+        var rgb = try decode.rgb(a, bytes, settings.max_pixels, &which);
+        defer rgb.deinit(a);
+        var p = try prep.preprocess(a, rgb, &settings);
+        defer p.deinit(a);
+        if (@as(u64, p.vit_h) * p.vit_w < 16) return error.UnsupportedVisionGeometry;
+        const pixels = try a.alloc(f32, p.patches.len);
+        errdefer a.free(pixels);
+        for (p.patches, pixels) |b, *f| f.* = @bitCast(@as(u32, b) << 16);
+        return .{ .pixels = pixels, .gh = p.vit_h, .gw = p.vit_w, .tokens = p.tokens(), .hash = std.mem.readInt(u64, p.digest[0..8], .little) };
+    }
+
+    /// Allocate in a request arena and retain until its finished event, including cancellation.
+    pub fn request(n: *Native, a: Allocator, src: *const api.Request) !Owned {
+        if (src.images.len > n.limits.max_images) return error.TooManyImages;
+        for (src.images) |im| {
+            if (im.gh == 0 or im.gw == 0 or im.gh > 4096 or im.gw > 4096) return error.VisionGrid;
+            if (@as(u64, im.gh) * im.gw < 16) return error.UnsupportedVisionGeometry;
+        }
+        var req = src.*;
+        const prompt = try a.dupe(u32, src.prompt);
+        errdefer a.free(prompt);
+        for (prompt) |id| if (id >= vids.VBASE) return error.InvalidImageId;
+        const images = try a.alloc(held.HeldImage, src.images.len);
+        var done: usize = 0;
+        errdefer {
+            for (images[0..done]) |im| {
+                a.free(im.patches[0 .. @as(usize, im.vit_h) * im.vit_w * 588]);
+                a.free(im.vids[0..im.n_vids]);
+            }
+            a.free(images);
+        }
+        var end: usize = 0;
+        var total: u64 = 0;
+        for (src.images, images) |im, *out| {
+            const lh = (im.gh + 2) / 3;
+            const lw = (im.gw + 2) / 3;
+            if (im.tokens != prep.spanLen(lh, lw)) return error.VisionGrid;
+            total += im.tokens;
+            if (total > n.limits.image_tokens) return error.TooManyImageTokens;
+            const stop = std.math.add(usize, im.at, im.tokens) catch return error.VisionGrid;
+            if (im.at < end or stop > prompt.len) return error.VisionGrid;
+            end = stop;
+            for (prompt[im.at..stop]) |id| if (id != n.settings.image_token) return error.ImagePlaceholder;
+            const np = @as(usize, im.gh) * im.gw * 588;
+            if (im.pixels.len != np) return error.VisionGrid;
+            const patches = try a.alloc(u16, np);
+            errdefer a.free(patches);
+            for (im.pixels, patches) |f, *b| {
+                if (!std.math.isFinite(f)) return error.InvalidImagePixel;
+                b.* = prep.bf16(f);
+            }
+            var h = std.crypto.hash.sha2.Sha256.init(.{});
+            h.update(prep.VERSION);
+            var grid: [8]u8 = undefined;
+            std.mem.writeInt(u32, grid[0..4], im.gh, .little);
+            std.mem.writeInt(u32, grid[4..8], im.gw, .little);
+            h.update(&grid);
+            h.update(std.mem.sliceAsBytes(patches));
+            var digest: [32]u8 = undefined;
+            h.final(&digest);
+            const registered = try n.registry.vids(n.io, &digest, im.tokens);
+            defer n.gpa.free(registered);
+            const ids = try a.dupe(u32, registered);
+            @memcpy(prompt[im.at..stop], ids);
+            out.* = .{ .patches = patches.ptr, .vit_h = im.gh, .vit_w = im.gw, .llm_h = lh, .llm_w = lw, .digest = digest, .vids = ids.ptr, .n_vids = ids.len };
+            done += 1;
+        }
+        req.prompt = prompt;
+        req.images = &.{};
+        // Cache identity follows the ids the forward actually consumed, including registry collision salts.
+        req.cache_key = prompt;
+        return .{ .request = req, .images = .{ .images = images.ptr, .n = images.len } };
+    }
+};
+
+pub const Owned = struct { request: api.Request, images: held.Held };
diff --git a/zig/src/families/deepseek_v41/vision_native_test.zig b/zig/src/families/deepseek_v41/vision_native_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..1385d008f5fcff190625b60b681d2fea9269afa1
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision_native_test.zig
@@ -0,0 +1,129 @@
+//! Shared API preparation, real decoding, request validation and image ownership without a device.
+const std = @import("std");
+const t = std.testing;
+const api = @import("engine_api");
+const native = @import("vision_native.zig");
+const prep = @import("vision/prep.zig");
+const held = @import("vision/held.zig");
+const Store = @import("vision/store.zig").Store;
+const assets = @import("vision_assets.zig");
+const Pack = @import("pack.zig").Pack;
+
+fn fixture() held.HeldImage {
+    return .{ .patches = &patches, .vit_h = 3, .vit_w = 3, .llm_h = 1, .llm_w = 1, .digest = @splat(3), .vids = &ids, .n_vids = 4 };
+}
+const patches: [3 * 3 * 588]u16 = @splat(0x3f80);
+const ids = [_]u32{ (1 << 24) + 1, (1 << 24) + 2, (1 << 24) + 3, (1 << 24) + 4 };
+
+fn admitAndRelease(a: std.mem.Allocator) !void {
+    var store: Store = .{ .gpa = a };
+    defer store.deinit();
+    var im = fixture();
+    const h: held.Held = .{ .images = @ptrCast(&im), .n = 1 };
+    store.hold(1, &h) catch |err| {
+        try t.expectEqual(@as(u32, 0), store.where.count());
+        try t.expectEqual(@as(u32, 0), store.holds.count());
+        return err;
+    };
+    try t.expect(store.where.get(ids[0]).?.img.patches != im.patches);
+    try store.hold(2, &h);
+    try t.expectEqual(@as(u32, 2), store.where.get(ids[0]).?.refs);
+    store.release(1);
+    try t.expectEqual(@as(u32, 1), store.where.get(ids[0]).?.refs);
+    try t.expectEqual(@as(u16, 0x3f80), store.where.get(ids[0]).?.img.patches[0]);
+    store.release(2);
+    store.release(2);
+    try t.expectEqual(@as(u32, 0), store.where.count());
+}
+
+test "image ownership: live requests survive another holder releasing, with all allocation failures" {
+    try t.checkAllAllocationFailures(t.allocator, admitAndRelease, .{});
+}
+
+test "image ownership: duplicate request and colliding ids leave the first request intact" {
+    var store: Store = .{ .gpa = t.allocator };
+    defer store.deinit();
+    var im = fixture();
+    const h: held.Held = .{ .images = @ptrCast(&im), .n = 1 };
+    try store.hold(1, &h);
+    try t.expectError(error.DuplicateRequest, store.hold(1, &h));
+    im.digest = @splat(8);
+    try t.expectError(error.ImageIdCollision, store.hold(2, &h));
+    try t.expectEqual(@as(u32, 1), store.holds.count());
+    try t.expectEqual(@as(u32, 1), store.where.get(ids[0]).?.refs);
+    im.vit_h = 0;
+    try t.expectError(error.VisionGrid, store.hold(3, &h));
+}
+
+test "native offer decodes actual PNG, caps geometry and preserves BF16 patches through the shared API" {
+    var arena: std.heap.ArenaAllocator = .init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var n = try native.Native.init(t.allocator, t.io, .{}, .{});
+    defer n.deinit();
+    const offer = n.offer();
+    const raw = @embedFile("vision/fixtures/golden/rgb8.png");
+    const p = try offer.prepare(offer.ctx, a, raw, 128);
+    try t.expect(p.tokens <= 128);
+    try t.expectEqual(prep.spanLen((p.gh + 2) / 3, (p.gw + 2) / 3), p.tokens);
+    try t.expectEqual(@as(usize, p.gh) * p.gw * 588, p.pixels.len);
+    const prompt = try a.alloc(u32, p.tokens + 2);
+    @memset(prompt, prep.IMAGE_TOKEN);
+    prompt[0] = 1;
+    prompt[prompt.len - 1] = 2;
+    const images = [_]api.Image{.{ .pixels = p.pixels, .gh = p.gh, .gw = p.gw, .at = 1, .tokens = p.tokens }};
+    const req: api.Request = .{ .prompt = prompt, .images = &images, .max_tokens = 1 };
+    const owned = try n.request(a, &req);
+    try t.expectEqual(@as(usize, 0), owned.request.images.len);
+    try t.expectEqual(@as(u32, 1), owned.request.prompt[0]);
+    try t.expectEqual(@as(u32, 2), owned.request.prompt[prompt.len - 1]);
+    try t.expect(owned.request.prompt[1] >= (1 << 24));
+    try t.expectEqualSlices(u32, owned.request.prompt, owned.request.cacheKey());
+    for (p.pixels, 0..) |f, i| try t.expectEqual(prep.bf16(f), owned.images.slice()[0].patches[i]);
+    const again = try n.request(a, &req);
+    try t.expectEqualSlices(u32, owned.request.prompt, again.request.prompt);
+    var bad_images = images;
+    bad_images[0].tokens -= 1;
+    var bad = req;
+    bad.images = &bad_images;
+    try t.expectError(error.VisionGrid, n.request(a, &bad));
+    prompt[1] = 17;
+    try t.expectError(error.ImagePlaceholder, n.request(a, &req));
+    try t.expectError(error.Unsupported, offer.prepare(offer.ctx, a, "not an image", 128));
+    try t.expectError(error.NoGrid, offer.prepare(offer.ctx, a, raw, 4));
+    try t.expectError(error.UnsupportedVisionGeometry, offer.prepare(offer.ctx, a, raw, 5));
+}
+
+test "missing vision assets and unsupported geometry refuse before touching CUDA" {
+    var p = Pack.init(t.allocator);
+    defer p.deinit();
+    try t.expectError(error.MissingVisionWeight, assets.validate(&p, .{}));
+    try t.expectError(error.UnsupportedVisionGeometry, assets.validate(&p, .{ .heads = 0 }));
+    try t.expectError(error.UnsupportedVisionGeometry, native.Native.init(t.allocator, t.io, .{ .patch = 16 }, .{}));
+    try t.expectError(error.BadVisionLimits, native.Native.init(t.allocator, t.io, .{}, .{ .image_tokens = 4 }));
+    try t.expectError(error.BadSettings, prep.plan(0, 1, &.{}));
+    try t.expectError(error.BadSettings, prep.plan(1, 1, &.{ .downsample = 0 }));
+}
+
+test "native admission refuses nine patches before allocation and accepts eighteen patches unchanged" {
