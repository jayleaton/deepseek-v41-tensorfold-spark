+++ b/zig/src/families/deepseek_v41/vision/webp_vp8l_xform.zig
@@ -0,0 +1,248 @@
+//! Lossless WebP's inverse transforms, ported from libwebp 1.6.0 ``src/dsp/lossless.c`` (C versions, same arithmetic).
+const std = @import("std");
+
+pub const Kind = enum(u2) { predictor = 0, cross_color = 1, subtract_green = 2, color_indexing = 3 };
+
+/// ``VP8LTransform``: ``xsize`` is the width the transform's output has; ``data`` its sub-image or colour map.
+pub const Transform = struct {
+    kind: Kind = .subtract_green,
+    bits: u5 = 0,
+    xsize: u32 = 0,
+    ysize: u32 = 0,
+    data: []u32 = &.{},
+};
+
+pub const argb_black: u32 = 0xff000000;
+
+pub fn subSample(size: u32, bits: u5) u32 {
+    return (size + (@as(u32, 1) << bits) - 1) >> bits;
+}
+
+/// ``VP8LAddPixels``: per-channel sum modulo 256.
+pub fn addPixels(a: u32, b: u32) u32 {
+    const ag = (a & 0xff00ff00) +% (b & 0xff00ff00);
+    const rb = (a & 0x00ff00ff) +% (b & 0x00ff00ff);
+    return (ag & 0xff00ff00) | (rb & 0x00ff00ff);
+}
+
+fn average2(a0: u32, a1: u32) u32 {
+    return (((a0 ^ a1) & 0xfefefefe) >> 1) + (a0 & a1);
+}
+
+fn average3(a0: u32, a1: u32, a2: u32) u32 {
+    return average2(average2(a0, a2), a1);
+}
+
+fn average4(a0: u32, a1: u32, a2: u32, a3: u32) u32 {
+    return average2(average2(a0, a1), average2(a2, a3));
+}
+
+fn clip255(a: u32) u32 {
+    if (a < 256) return a;
+    return ~a >> 24;
+}
+
+fn ch(c: u32, shift: u5) u32 {
+    return (c >> shift) & 0xff;
+}
+
+fn clampedAddSubtractFull(c0: u32, c1: u32, c2: u32) u32 {
+    var out: u32 = 0;
+    inline for (.{ 24, 16, 8, 0 }) |s| out |= clip255(ch(c0, s) +% ch(c1, s) -% ch(c2, s)) << s;
+    return out;
+}
+
+fn clampedAddSubtractHalf(c0: u32, c1: u32, c2: u32) u32 {
+    const ave = average2(c0, c1);
+    var out: u32 = 0;
+    inline for (.{ 24, 16, 8, 0 }) |s| {
+        const a: i32 = @intCast(ch(ave, s));
+        const b: i32 = @intCast(ch(c2, s));
+        out |= clip255(@bitCast(a + @divTrunc(a - b, 2))) << s;
+    }
+    return out;
+}
+
+fn sub3(a: u32, b: u32, c: u32) i32 {
+    const pb = @as(i32, @intCast(b)) - @as(i32, @intCast(c));
+    const pa = @as(i32, @intCast(a)) - @as(i32, @intCast(c));
+    return @as(i32, @intCast(@abs(pb))) - @as(i32, @intCast(@abs(pa)));
+}
+
+fn select(a: u32, b: u32, c: u32) u32 {
+    var pa_minus_pb: i32 = 0;
+    inline for (.{ 24, 16, 8, 0 }) |s| pa_minus_pb += sub3(ch(a, s), ch(b, s), ch(c, s));
+    return if (pa_minus_pb <= 0) a else b;
+}
+
+/// ``VP8LPredictor{mode}_C`` for modes 2..13 (left = out[x - 1], top = the row above at x); 14 and 15 are black.
+fn predict(mode: u32, left: u32, tl: u32, t: u32, tr: u32) u32 {
+    return switch (mode) {
+        2 => t,
+        3 => tr,
+        4 => tl,
+        5 => average3(left, t, tr),
+        6 => average2(left, tl),
+        7 => average2(left, t),
+        8 => average2(tl, t),
+        9 => average2(t, tr),
+        10 => average4(left, tl, t, tr),
+        11 => select(t, left, tl),
+        12 => clampedAddSubtractFull(left, t, tl),
+        13 => clampedAddSubtractHalf(left, t, tl),
+        else => argb_black,
+    };
+}
+
+/// ``PredictorInverseTransform_C`` over the whole image, in place (``px`` is ``xsize * ysize``).
+pub fn predictorInverse(t: *const Transform, px: []u32) void {
+    const w: usize = t.xsize;
+    if (w == 0 or t.ysize == 0) return;
+    px[0] = addPixels(px[0], argb_black);
+    for (1..w) |x| px[x] = addPixels(px[x], px[x - 1]);
+    const tile_w = @as(usize, 1) << t.bits;
+    const tiles_per_row: usize = subSample(t.xsize, t.bits);
+    for (1..t.ysize) |y| {
+        const row = y * w;
+        const up = row - w;
+        const modes = t.data[(y >> t.bits) * tiles_per_row ..][0..tiles_per_row];
+        px[row] = addPixels(px[row], px[up]);
+        var x: usize = 1;
+        while (x < w) {
+            const mode = (modes[x >> t.bits] >> 8) & 0xf;
+            const x_end = @min((x & ~(tile_w - 1)) + tile_w, w);
+            while (x < x_end) : (x += 1) {
+                const i = row + x;
+                if (mode == 1) {
+                    px[i] = addPixels(px[i], px[i - 1]);
+                    continue;
+                }
+                // the row above, read as one buffer: top-right of the last pixel is this row's first
+                const pred = predict(mode, px[i - 1], px[up + x - 1], px[up + x], px[up + x + 1]);
+                px[i] = addPixels(px[i], pred);
+            }
+        }
+    }
+}
+
+/// ``VP8LAddGreenToBlueAndRed_C``, in place.
+pub fn addGreen(px: []u32) void {
+    for (px) |*p| {
+        const argb = p.*;
+        const green = (argb >> 8) & 0xff;
+        var red_blue = argb & 0x00ff00ff;
+        red_blue +%= (green << 16) | green;
+        red_blue &= 0x00ff00ff;
+        p.* = (argb & 0xff00ff00) | red_blue;
+    }
+}
+
+fn delta(pred: u8, color: u8) i32 {
+    return (@as(i32, @as(i8, @bitCast(pred))) * @as(i8, @bitCast(color))) >> 5;
+}
+
+/// ``ColorSpaceInverseTransform_C`` (``VP8LTransformColorInverse_C`` per tile), in place.
+pub fn crossColorInverse(t: *const Transform, px: []u32) void {
+    const w: usize = t.xsize;
+    const tiles_per_row: usize = subSample(t.xsize, t.bits);
+    for (0..t.ysize) |y| {
+        const codes = t.data[(y >> t.bits) * tiles_per_row ..][0..tiles_per_row];
+        for (px[y * w ..][0..w], 0..) |*p, x| {
+            const code = codes[x >> t.bits];
+            const g2r: u8 = @truncate(code);
+            const g2b: u8 = @truncate(code >> 8);
+            const r2b: u8 = @truncate(code >> 16);
+            const argb = p.*;
+            const green: u8 = @truncate(argb >> 8);
+            var new_red: i32 = @intCast((argb >> 16) & 0xff);
+            var new_blue: i32 = @intCast(argb & 0xff);
+            new_red += delta(g2r, green);
+            new_red &= 0xff;
+            new_blue += delta(g2b, green);
+            new_blue += delta(r2b, @intCast(new_red));
+            new_blue &= 0xff;
+            p.* = (argb & 0xff00ff00) | (@as(u32, @intCast(new_red)) << 16) | @as(u32, @intCast(new_blue));
+        }
+    }
+}
+
+/// ``ColorIndexInverseTransform_C``: ``src`` rows of ``subSample(xsize, bits)`` bundled indices (in green) to ``dst``.
+pub fn colorIndexInverse(t: *const Transform, src: []const u32, dst: []u32) void {
+    const w: usize = t.xsize;
+    const map = t.data;
+    if (t.bits == 0) {
+        for (src[0 .. w * t.ysize], dst[0 .. w * t.ysize]) |s, *d| d.* = map[(s >> 8) & 0xff];
+        return;
+    }
+    const bpp: u5 = @as(u5, 8) >> @intCast(t.bits);
+    const count_mask = (@as(usize, 1) << t.bits) - 1;
+    const bit_mask = (@as(u32, 1) << bpp) - 1;
+    var si: usize = 0;
+    var di: usize = 0;
+    for (0..t.ysize) |_| {
+        var packed_px: u32 = 0;
+        for (0..w) |x| {
+            if (x & count_mask == 0) {
+                packed_px = (src[si] >> 8) & 0xff;
+                si += 1;
+            }
+            dst[di] = map[packed_px & bit_mask];
+            di += 1;
+            packed_px >>= bpp;
+        }
+    }
+}
+
+/// ``VP8LColorIndexInverseTransformAlpha``: byte indices to the colour map's green, bundled as above.
+pub fn colorIndexAlpha(t: *const Transform, src: []const u8, dst: []u8) void {
+    const w: usize = t.xsize;
+    const map = t.data;
+    if (t.bits == 0) {
+        for (src[0 .. w * t.ysize], dst[0 .. w * t.ysize]) |s, *d| d.* = @truncate(map[s] >> 8);
+        return;
+    }
+    const bpp: u5 = @as(u5, 8) >> @intCast(t.bits);
+    const count_mask = (@as(usize, 1) << t.bits) - 1;
+    const bit_mask = (@as(u32, 1) << bpp) - 1;
+    var si: usize = 0;
+    var di: usize = 0;
+    for (0..t.ysize) |_| {
+        var packed_px: u32 = 0;
+        for (0..w) |x| {
+            if (x & count_mask == 0) {
+                packed_px = src[si];
+                si += 1;
+            }
+            dst[di] = @truncate(map[packed_px & bit_mask] >> 8);
+            di += 1;
+            packed_px >>= bpp;
+        }
+    }
+}
+
+test "predictors 11-13 and the averages" {
+    try std.testing.expectEqual(@as(u32, 0x7f7f7f7f), average2(0xffffffff, 0x00000000));
+    try std.testing.expectEqual(@as(u32, 0xff00ff00), clampedAddSubtractFull(0xff00ff00, 0xffff0000, 0x00ff0000));
+    // (a + (a - b) / 2) truncates toward zero, clamps at 0 and 255
+    try std.testing.expectEqual(@as(u32, 0x00ff0002), clampedAddSubtractHalf(0x00c00002, 0x00c00002, 0x00010003));
+    try std.testing.expectEqual(@as(u32, 0x05060708), select(0x01020304, 0x05060708, 0x01020304));
+    try std.testing.expectEqual(@as(u32, 0x01020304), select(0x01020304, 0x05060708, 0x05060708));
+}
+
+test "cross-colour multipliers are signed" {
+    var px = [_]u32{0xff10f020};
+    const codes = [_]u32{0x00000080}; // green_to_red -128: red += (-128 * -16) >> 5 = 64
+    const t: Transform = .{ .kind = .cross_color, .bits = 2, .xsize = 1, .ysize = 1, .data = @constCast(&codes) };
+    crossColorInverse(&t, &px);
+    try std.testing.expectEqual(@as(u32, 0xff50f020), px[0]);
+}
+
+test "bundled indices: 2 colours, 8 a byte" {
+    var map = [_]u32{ 0xff000000, 0xffffffff };
+    const t: Transform = .{ .kind = .color_indexing, .bits = 3, .xsize = 9, .ysize = 1, .data = &map };
+    const src = [_]u32{ 0x0000a500, 0x00000100 };
+    var dst: [9]u32 = undefined;
+    colorIndexInverse(&t, &src, &dst);
+    const want = [_]u32{ 1, 0, 1, 0, 0, 1, 0, 1, 1 };
+    for (dst, want) |d, b| try std.testing.expectEqual(map[b], d);
+}
diff --git a/zig/src/families/deepseek_v41/vision/webp_yuv.zig b/zig/src/families/deepseek_v41/vision/webp_yuv.zig
new file mode 100644
index 0000000000000000000000000000000000000000..25c9c7fb9ce51efc7ee7abe8b505bffd6f12fc30
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision/webp_yuv.zig
@@ -0,0 +1,115 @@
+//! Lossy WebP's YUV 4:2:0 to RGB as libwebp 1.6.0 outputs it (``dsp/upsampling.c``, ``dsp/yuv.h``).
+const std = @import("std");
+const Yuv = @import("webp_vp8.zig").Yuv;
+
+const yuv_fix2 = 6;
+const yuv_mask2 = (256 << yuv_fix2) - 1;
+
+fn multHi(v: i32, coeff: i32) i32 { // ``_mm_mulhi_epu16`` emulation
+    return (v * coeff) >> 8;
+}
+
+fn clip8(v: i32) u8 { // ``VP8Clip8``
+    return if (v & ~@as(i32, yuv_mask2) == 0) @intCast(v >> yuv_fix2) else if (v < 0) 0 else 255;
+}
+
+/// ``VP8YuvToRgb``: one pixel's R, G, B (the alpha byte is left as it is).
+fn yuvToRgb(y: u8, u: u8, v: u8, dst: []u8) void {
+    const yy = multHi(y, 19077);
+    dst[0] = clip8(yy + multHi(v, 26149) - 14234);
+    dst[1] = clip8(yy - multHi(u, 6419) - multHi(v, 13320) + 8708);
+    dst[2] = clip8(yy + multHi(u, 33050) - 17685);
+}
+
+fn loadUv(u: u8, v: u8) u32 {
+    return @as(u32, u) | @as(u32, v) << 16;
+}
+
+fn put(y: u8, uv: u32, dst: []u8) void {
+    yuvToRgb(y, @truncate(uv), @truncate(uv >> 16), dst);
+}
+
+/// ``UpsampleRgbaLinePair_C``: one or two luma rows between chroma rows ``top`` and ``cur`` (U, V packed in 16 bits).
+fn upsamplePair(top_y: []const u8, bottom_y: ?[]const u8, top_u: []const u8, top_v: []const u8, cur_u: []const u8, cur_v: []const u8, top_dst: []u8, bottom_dst: []u8, len: usize) void {
+    const last_pixel_pair = (len - 1) >> 1;
+    var tl_uv = loadUv(top_u[0], top_v[0]);
+    var l_uv = loadUv(cur_u[0], cur_v[0]);
+    put(top_y[0], (3 * tl_uv + l_uv + 0x00020002) >> 2, top_dst[0..]);
+    if (bottom_y) |by| put(by[0], (3 * l_uv + tl_uv + 0x00020002) >> 2, bottom_dst[0..]);
+    for (1..last_pixel_pair + 1) |x| {
+        const t_uv = loadUv(top_u[x], top_v[x]);
+        const uv = loadUv(cur_u[x], cur_v[x]);
+        const avg = tl_uv +% t_uv +% l_uv +% uv +% 0x00080008;
+        const diag_12 = (avg +% 2 *% (t_uv +% l_uv)) >> 3;
+        const diag_03 = (avg +% 2 *% (tl_uv +% uv)) >> 3;
+        put(top_y[2 * x - 1], (diag_12 +% tl_uv) >> 1, top_dst[(2 * x - 1) * 4 ..]);
+        put(top_y[2 * x], (diag_03 +% t_uv) >> 1, top_dst[(2 * x) * 4 ..]);
+        if (bottom_y) |by| {
+            put(by[2 * x - 1], (diag_03 +% l_uv) >> 1, bottom_dst[(2 * x - 1) * 4 ..]);
+            put(by[2 * x], (diag_12 +% uv) >> 1, bottom_dst[(2 * x) * 4 ..]);
+        }
+        tl_uv = t_uv;
+        l_uv = uv;
+    }
+    if (len & 1 == 0) {
+        put(top_y[len - 1], (3 * tl_uv + l_uv + 0x00020002) >> 2, top_dst[(len - 1) * 4 ..]);
+        if (bottom_y) |by| put(by[len - 1], (3 * l_uv + tl_uv + 0x00020002) >> 2, bottom_dst[(len - 1) * 4 ..]);
+    }
+}
+
+/// RGBA rows (stride ``w * 4``) from ``yuv`` as ``EmitFancyRGB`` drives the upsampler; the A bytes are untouched.
+pub fn toRgba(yuv: *const Yuv, out: []u8) void {
+    const w: usize = yuv.w;
+    const h: usize = yuv.h;
+    const uw: usize = yuv.uv_w;
+    std.debug.assert(out.len >= w * h * 4);
+    const yrow = struct {
+        fn f(p: []const u8, stride: usize, r: usize, n: usize) []const u8 {
+            return p[r * stride ..][0..n];
+        }
+    }.f;
+    const orow = out[0 .. w * 4];
+    upsamplePair(yrow(yuv.y, w, 0, w), null, yuv.u[0..uw], yuv.v[0..uw], yuv.u[0..uw], yuv.v[0..uw], orow, orow, w);
+    var y: usize = 0;
+    while (y + 2 < h) : (y += 2) { // rows y + 1 and y + 2, between chroma rows y / 2 and y / 2 + 1
+        const k = y / 2;
+        upsamplePair(yrow(yuv.y, w, y + 1, w), yrow(yuv.y, w, y + 2, w), yrow(yuv.u, uw, k, uw), yrow(yuv.v, uw, k, uw), yrow(yuv.u, uw, k + 1, uw), yrow(yuv.v, uw, k + 1, uw), out[(y + 1) * w * 4 ..][0 .. w * 4], out[(y + 2) * w * 4 ..][0 .. w * 4], w);
+    }
+    if (h & 1 == 0) { // the last row of an even height mirrors its chroma row
+        const k = h / 2 - 1;
+        const last = out[(h - 1) * w * 4 ..][0 .. w * 4];
+        upsamplePair(yrow(yuv.y, w, h - 1, w), null, yrow(yuv.u, uw, k, uw), yrow(yuv.v, uw, k, uw), yrow(yuv.u, uw, k, uw), yrow(yuv.v, uw, k, uw), last, last, w);
+    }
+}
+
+test "grey stays grey, and the fixed-point constants match libwebp's corners" {
+    var y = [_]u8{ 128, 128, 128, 128, 128, 128 };
+    var u = [_]u8{ 128, 128 };
+    var v = [_]u8{ 128, 128 };
+    const yuv: Yuv = .{ .w = 3, .h = 2, .y = &y, .u = &u, .v = &v, .uv_w = 2 };
+    var out: [24]u8 = @splat(7);
+    toRgba(&yuv, &out);
+    for (0..6) |i| {
+        try std.testing.expectEqualSlices(u8, &.{ 130, 130, 130 }, out[i * 4 ..][0..3]); // VP8YuvToRgb(128, 128, 128)
+        try std.testing.expectEqual(@as(u8, 7), out[i * 4 + 3]);
+    }
+    var px: [3]u8 = undefined;
+    yuvToRgb(16, 128, 128, &px);
+    try std.testing.expectEqualSlices(u8, &.{ 0, 0, 0 }, &px);
+    yuvToRgb(235, 128, 128, &px);
+    try std.testing.expectEqualSlices(u8, &.{ 255, 255, 255 }, &px);
+}
+
+test "a single column and a single row upsample without reading past the planes" {
+    var y = [_]u8{ 10, 200, 90 };
+    var u = [_]u8{ 50, 200 };
+    var v = [_]u8{ 220, 30 };
+    var out: [12]u8 = undefined;
+    const col: Yuv = .{ .w = 1, .h = 3, .y = &y, .u = &u, .v = &v, .uv_w = 1 };
+    toRgba(&col, &out);
+    const row: Yuv = .{ .w = 3, .h = 1, .y = &y, .u = &u, .v = &v, .uv_w = 2 };
+    toRgba(&row, &out);
+    var px: [3]u8 = undefined;
+    yuvToRgb(10, 50, 220, &px);
+    try std.testing.expectEqualSlices(u8, &px, out[0..3]);
+}
diff --git a/zig/src/families/deepseek_v41/vision_assets.zig b/zig/src/families/deepseek_v41/vision_assets.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8252a261146dc0f220d9e3b09a9eceb79967df44
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision_assets.zig
@@ -0,0 +1,55 @@
+//! Validate every required tower tensor before opening libraries or allocating device buffers.
+const std = @import("std");
+const Pack = @import("pack.zig").Pack;
+
+pub const Shape = struct {
+    layers: u32 = 32,
+    heads: u32 = 16,
+    dim: u32 = 1024,
+    inter: u32 = 2816,
+    patch: u32 = 14,
+    ratio: u32 = 3,
+    theta: f32 = 10000,
+    out: u32 = 5120,
+
+    pub fn validate(s: Shape) !void {
+        if (s.layers == 0 or s.layers > 128 or s.heads == 0 or s.heads > 32 or s.dim != s.heads * 64 or
+            s.dim % 128 != 0 or s.inter == 0 or s.inter > 65536 or s.patch != 14 or s.ratio != 3 or
+            s.out == 0 or s.out > 65536 or !std.math.isFinite(s.theta) or s.theta <= 0)
+            return error.UnsupportedVisionGeometry;
+    }
+};
+
+pub fn validate(pack: *const Pack, s: Shape) !void {
+    try s.validate();
+    try tensor(pack, "vision.patch_embed.proj.weight", &.{ s.dim, 3 * s.patch * s.patch }, true);
+    try tensor(pack, "vision.patch_embed.proj.bias", &.{s.dim}, false);
+    var name: [128]u8 = undefined;
+    for (0..s.layers) |i| {
+        inline for (.{ "norm1", "norm2" }) |norm|
+            try tensor(pack, try std.fmt.bufPrint(&name, "vision.blocks.{d}." ++ norm ++ ".weight", .{i}), &.{s.dim}, true);
+        inline for (.{ .{ "attn.wqkv", 3 * s.dim, s.dim }, .{ "attn.wo", s.dim, s.dim }, .{ "mlp.w1", 2 * s.inter, s.dim }, .{ "mlp.w2", s.dim, s.inter } }) |p| {
+            try tensor(pack, try std.fmt.bufPrint(&name, "vision.blocks.{d}." ++ p[0] ++ ".weight", .{i}), &.{ p[1], p[2] }, true);
+            try tensor(pack, try std.fmt.bufPrint(&name, "vision.blocks.{d}." ++ p[0] ++ ".bias", .{i}), &.{p[1]}, false);
+        }
+    }
+    try tensor(pack, "vision.norm.weight", &.{s.dim}, true);
+    try tensor(pack, "aligner.w1.weight", &.{ s.out, s.ratio * s.ratio * s.dim }, true);
+    try tensor(pack, "aligner.w1.bias", &.{s.out}, false);
+    try tensor(pack, "aligner.w2.weight", &.{ s.out, s.out }, true);
+    try tensor(pack, "aligner.w2.bias", &.{s.out}, false);
+    inline for (.{ "image_start", "image_end", "image_newline" }) |name_|
+        try tensor(pack, name_, &.{s.out}, true);
+}
+
+fn tensor(pack: *const Pack, name: []const u8, shape: []const usize, required: bool) !void {
+    const info = pack.get(name) orelse {
+        if (required) return error.MissingVisionWeight;
+        return;
+    };
+    if (info.dtype != .bf16) return error.VisionDtype;
+    if (!std.mem.eql(usize, info.dims(), shape)) return error.VisionWeightShape;
+    var bytes: u64 = 2;
+    for (shape) |d| bytes = std.math.mul(u64, bytes, d) catch return error.VisionWeightShape;
+    if (bytes != info.nbytes) return error.VisionWeightShape;
+}
diff --git a/zig/src/families/deepseek_v41/vision_blas.zig b/zig/src/families/deepseek_v41/vision_blas.zig
new file mode 100644
index 0000000000000000000000000000000000000000..5cec6446e98ee71d36c7f69949eb8d2fae62a188
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision_blas.zig
@@ -0,0 +1,92 @@
+//! Plain cuBLAS (libcublas, opened at run time) for the vision tower's unbiased linears: torch's ``F.linear`` withou
+const std = @import("std");
+
+pub const Status = c_int;
+pub const Handle = ?*opaque {};
+
+const op_n: c_int = 0;
+const op_t: c_int = 1;
+const r_16bf: c_int = 14; // CUDA_R_16BF
+const compute_32f: c_int = 68; // CUBLAS_COMPUTE_32F (what CUDA_R_32F migrates to under DEFAULT_MATH)
+const default_math: c_int = 0; // CUBLAS_DEFAULT_MATH
+const gemm_default_tensor_op: c_int = 99; // CUBLAS_GEMM_DEFAULT_TENSOR_OP
+
+/// torch's cuBLAS workspace on major 9 / 10 / 12 (``parseChosenWorkspaceSize``: 4096 * 8 KiB).
+pub const workspace_bytes: usize = 32 << 20;
+
+const S = Status;
+const CPtr = ?*const anyopaque;
+
+pub const Api = struct {
+    cublasCreate_v2: *const fn (*Handle) callconv(.c) S,
+    cublasDestroy_v2: *const fn (Handle) callconv(.c) S,
+    cublasSetStream_v2: *const fn (Handle, ?*anyopaque) callconv(.c) S,
+    cublasSetWorkspace_v2: *const fn (Handle, u64, usize) callconv(.c) S,
+    cublasSetMathMode: *const fn (Handle, c_int) callconv(.c) S,
+    cublasGetStatusName: *const fn (S) callconv(.c) ?[*:0]const u8,
+    cublasGemmEx: *const fn (Handle, c_int, c_int, c_int, c_int, c_int, CPtr, u64, c_int, c_int, u64, c_int, c_int, CPtr, u64, c_int, c_int, c_int, c_int) callconv(.c) S,
+};
+
+pub const Blas = struct {
+    lib: std.DynLib,
+    api: Api,
+    handle: Handle = null,
+
+    pub fn open() !Blas {
+        for ([_][]const u8{ "libcublas.so.13", "libcublas.so" }) |path| {
+            var lib = std.DynLib.open(path) catch continue;
+            errdefer lib.close();
+            var b: Blas = .{ .lib = lib, .api = undefined };
+            const info = @typeInfo(Api).@"struct";
+            inline for (info.field_names, info.field_types) |name, T| {
+                @field(b.api, name) = lib.lookup(T, name) orelse {
+                    std.log.err("{s} has no {s}", .{ path, name });
+                    return error.MissingSymbol;
+                };
+            }
+            try b.check(b.api.cublasCreate_v2(&b.handle), "cublasCreate");
+            return b;
+        }
+        return error.LibraryUnavailable;
+    }
+
+    pub fn close(b: *Blas) void {
+        _ = b.api.cublasDestroy_v2(b.handle);
+        b.lib.close();
+    }
+
+    fn check(b: *const Blas, s: Status, what: []const u8) !void {
+        if (s == 0) return;
+        const n = b.api.cublasGetStatusName(s);
+        std.log.err("{s}: {s} ({d})", .{ what, if (n) |p| std.mem.span(p) else "?", s });
+        return error.CublasFailed;
+    }
+
+    /// ``F.linear(x [m, k], W [n, k])`` -> y [m, n] bf16: column-major y^T [n, m] = W^T' x^T (opT on W, lda = ldb = k).
+    pub fn linear(b: *const Blas, stream: ?*anyopaque, workspace: u64, x: u64, xt: bool, m: usize, k: usize, w: u64, n: usize, y: u64) !void {
+        const api = b.api;
+        try b.check(api.cublasSetStream_v2(b.handle, stream), "cublasSetStream");
+        try b.check(api.cublasSetWorkspace_v2(b.handle, workspace, workspace_bytes), "cublasSetWorkspace");
+        try b.check(api.cublasSetMathMode(b.handle, default_math), "cublasSetMathMode");
+        const one: f32 = 1;
+        const zero: f32 = 0;
+        const ki: c_int = @intCast(k);
+        const ni: c_int = @intCast(n);
+        // `xt`: x a [k, m] buffer read as [m, k] (strides 1, m), as torch passes such a view: opT on x, ldb = m
+        const opx = if (xt) op_t else op_n;
+        const ldx: c_int = @intCast(if (xt) m else k);
+        try b.check(api.cublasGemmEx(b.handle, op_t, opx, ni, @intCast(m), ki, &one, w, r_16bf, ki, x, r_16bf, ldx, &zero, y, r_16bf, ni, compute_32f, gemm_default_tensor_op), "cublasGemmEx");
+    }
+};
+
+/// torch's ``_getAlignment`` (the cuBLASLt preference's MIN_ALIGNMENT_*): the largest power of two up to 256 dividin
+pub fn alignment(p: u64) u32 {
+    return @intCast(@min(@as(u64, 256), p & (~p +% 1)));
+}
+
+test alignment {
+    try std.testing.expectEqual(@as(u32, 256), alignment(0x7f0000001000));
+    try std.testing.expectEqual(@as(u32, 128), alignment(0x7f0000001080));
+    try std.testing.expectEqual(@as(u32, 2), alignment(0x7f0000001082));
+    try std.testing.expectEqual(@as(u32, 1), alignment(0x7f0000001081));
+}
diff --git a/zig/src/families/deepseek_v41/vision_boot.zig b/zig/src/families/deepseek_v41/vision_boot.zig
new file mode 100644
index 0000000000000000000000000000000000000000..5cc665766b9d6479114cc735b3fc58546060bdca
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision_boot.zig
@@ -0,0 +1,51 @@
+//! Root-selected image boot settings over the existing host plan link, before model planning or admission.
+const std = @import("std");
+const VisionOpen = @import("engine_api").VisionOpen;
+
+pub const tag: i64 = 0x54465642;
+pub const version: i64 = 1;
+pub const frame_words = 6;
+
+/// Link has rank/world, send([]const i64) and recv([]i64), as the existing PlanLink does.
+pub fn select(link: anytype, requested: ?VisionOpen) !?VisionOpen {
+    if (link.world == 0 or link.rank >= link.world) return error.BadVisionBootRank;
+    if (link.rank == 0) {
+        const frame = try encode(requested);
+        if (link.world > 1) try link.send(&frame);
+        return decode(&frame);
+    }
+    var frame: [frame_words]i64 = undefined;
+    return decode(try link.recv(&frame));
+}
+
+fn encode(requested: ?VisionOpen) ![frame_words]i64 {
+    const limits = requested orelse return .{ tag, version, 0, 0, 0, 0 };
+    if (limits.image_tokens < 5 or limits.image_tokens > (1 << 16) or limits.max_images == 0)
+        return error.BadVisionBootSettings;
+    return .{ tag, version, 1, limits.image_tokens, @intFromBool(limits.image_tokens_set), limits.max_images };
+}
+
+fn decode(frame: []const i64) !?VisionOpen {
+    if (frame.len != frame_words or frame[0] != tag or frame[1] != version) return error.BadVisionBootFrame;
+    if (frame[2] == 0) {
+        for (frame[3..]) |word| if (word != 0) return error.BadVisionBootFrame;
+        return null;
+    }
+    if (frame[2] != 1 or (frame[4] != 0 and frame[4] != 1)) return error.BadVisionBootFrame;
+    if (frame[3] < 5 or frame[3] > (1 << 16) or frame[5] < 1 or frame[5] > std.math.maxInt(u32))
+        return error.BadVisionBootSettings;
+    return .{ .image_tokens = @intCast(frame[3]), .image_tokens_set = frame[4] == 1, .max_images = @intCast(frame[5]) };
+}
+
+/// Only rank zero calls this reader; explicit API options override the legacy environment setting.
+pub fn fromEnv(explicit: ?VisionOpen) !?VisionOpen {
+    if (explicit != null) return explicit;
+    const raw: ?[]const u8 = if (std.c.getenv("TF_DSV41_IMAGES")) |value| std.mem.span(value) else null;
+    return legacy(null, raw);
+}
+
+/// The old placeholder/reject choices leave native images disabled; only native enables the tower.
+pub fn legacy(explicit: ?VisionOpen, raw: ?[]const u8) !?VisionOpen {
+    if (explicit != null) return explicit;
+    return if (try @import("image_mode.zig").enabled(raw)) @as(VisionOpen, .{}) else null;
+}
diff --git a/zig/src/families/deepseek_v41/vision_boot_test.zig b/zig/src/families/deepseek_v41/vision_boot_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..811e402fef8d3b472a2614125553baf6a8c4f5da
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision_boot_test.zig
@@ -0,0 +1,120 @@
+//! Boot selection uses the actual integer wire frame and a host-only fake of the existing PlanLink interface.
+const std = @import("std");
+const t = std.testing;
+const boot = @import("vision_boot.zig");
+const VisionOpen = @import("engine_api").VisionOpen;
+
+const Link = struct {
+    rank: u32 = 0,
+    world: u32 = 2,
+    frame: [boot.frame_words]i64 = @splat(0),
+    len: usize = boot.frame_words,
+    sends: u32 = 0,
+    receives: u32 = 0,
+    fail: bool = false,
+
+    pub fn send(l: *Link, words: []const i64) !void {
+        l.sends += 1;
+        if (l.fail) return error.PeerClosed;
+        try t.expectEqual(boot.frame_words, words.len);
+        @memcpy(&l.frame, words);
+    }
+    pub fn recv(l: *Link, out: []i64) ![]i64 {
+        l.receives += 1;
+        if (l.fail) return error.PeerClosed;
+        @memcpy(out[0..l.len], l.frame[0..l.len]);
+        return out[0..l.len];
+    }
+};
+
+test "vision boot root selects limits and follower ignores conflicting local settings" {
+    var root: Link = .{};
+    const limits: VisionOpen = .{ .image_tokens = 128, .image_tokens_set = true, .max_images = 3 };
+    const selected = (try boot.select(&root, limits)).?;
+    try t.expectEqual(@as(u32, 1), root.sends);
+    try t.expectEqual(@as(u32, 0), root.receives);
+    try t.expectEqualSlices(i64, &.{ boot.tag, boot.version, 1, 128, 1, 3 }, &root.frame);
+    var follower: Link = .{ .rank = 1, .frame = root.frame };
+    const received = (try boot.select(&follower, .{ .image_tokens = 0, .max_images = 0 })).?;
+    try t.expectEqualDeep(selected, received);
+    try t.expectEqualDeep(limits, received);
+    try t.expectEqual(@as(u32, 0), follower.sends);
+    try t.expectEqual(@as(u32, 1), follower.receives);
+}
+
+test "vision boot disabled root overrides follower enable and implicit token default survives" {
+    var root: Link = .{};
+    try t.expect(try boot.select(&root, null) == null);
+    try t.expectEqualSlices(i64, &.{ boot.tag, boot.version, 0, 0, 0, 0 }, &root.frame);
+    var follower: Link = .{ .rank = 1, .frame = root.frame };
+    try t.expect(try boot.select(&follower, .{}) == null);
+    _ = try boot.select(&root, .{});
+    follower.frame = root.frame;
+    const limits = (try boot.select(&follower, null)).?;
+    try t.expect(!limits.image_tokens_set);
+    try t.expectEqual(@as(u32, 4096), limits.image_tokens);
+}
+
+test "vision boot single rank performs no transport calls" {
+    var solo: Link = .{ .world = 1, .fail = true };
+    try t.expect(try boot.select(&solo, null) == null);
+    const limits = (try boot.select(&solo, .{ .image_tokens = 512, .image_tokens_set = true })).?;
+    try t.expectEqual(@as(u32, 512), limits.image_tokens);
+    try t.expectEqual(@as(u32, 0), solo.sends);
+    try t.expectEqual(@as(u32, 0), solo.receives);
+}
+
+test "vision boot refuses malformed frame tags versions flags lengths and limits" {
+    var root: Link = .{};
+    _ = try boot.select(&root, .{});
+    const good = root.frame;
+    const bad_frames = [_][boot.frame_words]i64{
+        .{ 0, boot.version, 1, 128, 1, 3 },
+        .{ boot.tag, 2, 1, 128, 1, 3 },
+        .{ boot.tag, boot.version, 2, 128, 1, 3 },
+        .{ boot.tag, boot.version, 1, 128, -1, 3 },
+        .{ boot.tag, boot.version, 1, 128, 2, 3 },
+        .{ boot.tag, boot.version, 0, 128, 0, 0 },
+    };
+    for (bad_frames) |frame| {
+        var link: Link = .{ .rank = 1, .frame = frame };
+        try t.expectError(error.BadVisionBootFrame, boot.select(&link, null));
+    }
+    const bad_limits = [_][boot.frame_words]i64{
+        .{ boot.tag, boot.version, 1, -1, 1, 3 },
+        .{ boot.tag, boot.version, 1, 4, 1, 3 },
+        .{ boot.tag, boot.version, 1, 65537, 1, 3 },
+        .{ boot.tag, boot.version, 1, 128, 1, 0 },
+        .{ boot.tag, boot.version, 1, 128, 1, -1 },
+        .{ boot.tag, boot.version, 1, 128, 1, @as(i64, std.math.maxInt(u32)) + 1 },
+    };
+    for (bad_limits) |frame| {
+        var link: Link = .{ .rank = 1, .frame = frame };
+        try t.expectError(error.BadVisionBootSettings, boot.select(&link, null));
+    }
+    for ([_]usize{ 0, 1, 5 }) |len| {
+        var link: Link = .{ .rank = 1, .frame = good, .len = len };
+        try t.expectError(error.BadVisionBootFrame, boot.select(&link, null));
+    }
+    try t.expectError(error.BadVisionBootSettings, boot.select(&root, .{ .image_tokens = 0 }));
+    try t.expectError(error.BadVisionBootSettings, boot.select(&root, .{ .max_images = 0 }));
+    var invalid: Link = .{ .world = 0 };
+    try t.expectError(error.BadVisionBootRank, boot.select(&invalid, null));
+    invalid = .{ .world = 1, .rank = 1 };
+    try t.expectError(error.BadVisionBootRank, boot.select(&invalid, null));
+}
+
+test "vision boot propagates link failures and legacy native is root-selectable" {
+    var failed: Link = .{ .fail = true };
+    try t.expectError(error.PeerClosed, boot.select(&failed, null));
+    failed.rank = 1;
+    try t.expectError(error.PeerClosed, boot.select(&failed, null));
+    const native = (try boot.legacy(null, " Native \n")).?;
+    try t.expect(!native.image_tokens_set);
+    try t.expect(try boot.legacy(null, null) == null);
+    try t.expect(try boot.legacy(null, "reject") == null);
+    try t.expect(try boot.legacy(null, "placeholder") == null);
+    try t.expectError(error.BadImagesMode, boot.legacy(null, "on"));
+    const explicit = (try boot.legacy(.{ .image_tokens = 256 }, "bad setting")).?;
+    try t.expectEqual(@as(u32, 256), explicit.image_tokens);
+}
diff --git a/zig/src/families/deepseek_v41/vision_engine.zig b/zig/src/families/deepseek_v41/vision_engine.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d6b027039b7c9003a27bfc0cd5f4bb4f7909c6f3
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision_engine.zig
@@ -0,0 +1,116 @@
+//! Translate shared image requests and retain inputs through terminal callbacks; cancellation alone never frees them.
+const std = @import("std");
+const api = @import("engine_api");
+const Native = @import("vision_native.zig").Native;
+pub const Engine = Wrapper(@import("vision_rows.zig").Rows);
+
+/// The ownership seam also runs against the actual host Store, without a CUDA driver.
+pub fn Wrapper(comptime Rows: type) type {
+    return struct {
+        const Self = @This();
+        const Owner = struct {
+            arena: std.heap.ArenaAllocator,
+            request: api.Request,
+            sink: api.Sink,
+        };
+        gpa: std.mem.Allocator,
+        io: std.Io,
+        inner: api.Engine,
+        native: *Native,
+        rows: *Rows,
+        mutex: std.Io.Mutex = .init,
+        active: std.AutoHashMapUnmanaged(api.Id, *Owner) = .empty,
+        active_churn: @import("map_churn.zig").Churn = .{},
+
+        /// Call only after the inner engine and GPU have drained successfully.
+        pub fn deinit(e: *Self) void {
+            var it = e.active.iterator();
+            while (it.next()) |entry| {
+                e.rows.release(entry.key_ptr.*);
+                e.free(entry.value_ptr.*);
+            }
+            e.active.deinit(e.gpa);
+        }
+
+        pub fn engine(e: *Self) api.Engine {
+            return .{ .ctx = e, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+        }
+
+        fn self(ctx: *anyopaque) *Self {
+            return @ptrCast(@alignCast(ctx));
+        }
+        fn info(ctx: *anyopaque) api.Info {
+            const e = self(ctx);
+            var i = e.inner.info();
+            i.vision = e.native.offer();
+            return i;
+        }
+        fn cancel(ctx: *anyopaque, id: api.Id) void {
+            self(ctx).inner.cancel(id);
+        }
+        fn status(ctx: *anyopaque, out: *api.Status, tokens: []u32) void {
+            self(ctx).inner.status(out, tokens);
+        }
+        fn memory(ctx: *anyopaque, reset: bool) ?api.Memory {
+            return self(ctx).inner.memory(reset);
+        }
+
+        fn submit(ctx: *anyopaque, id: api.Id, src: *const api.Request, sink: api.Sink) api.SubmitError!void {
+            const e = self(ctx);
+            if (src.images.len == 0) {
+                for (src.prompt) |t| if (t >= (1 << 24)) return error.InvalidRequest;
+                return e.inner.submit(id, src, sink);
+            }
+            const owner = e.gpa.create(Owner) catch return error.Busy;
+            owner.* = .{ .arena = .init(e.gpa), .request = undefined, .sink = sink };
+            var admitted = false;
+            errdefer if (!admitted) e.free(owner);
+            const translated = e.native.request(owner.arena.allocator(), src) catch |err| return switch (err) {
+                error.OutOfMemory => error.Busy,
+                else => error.InvalidRequest,
+            };
+            owner.request = translated.request;
+            {
+                e.mutex.lockUncancelable(e.io);
+                defer e.mutex.unlock(e.io);
+                if (e.active.contains(id)) return error.InvalidRequest;
+                e.active.ensureUnusedCapacity(e.gpa, 1) catch return error.Busy;
+                e.rows.hold(id, &translated.images) catch |err| return switch (err) {
+                    error.OutOfMemory => error.Busy,
+                    else => error.InvalidRequest,
+                };
+                e.active.putAssumeCapacity(id, owner);
+                admitted = true;
+            }
+            e.inner.submit(id, &owner.request, .{ .ctx = e, .event = onEvent }) catch |err| {
+                e.drop(id);
+                return err;
+            };
+        }
+
+        fn free(e: *Self, owner: *Owner) void {
+            owner.arena.deinit();
+            e.gpa.destroy(owner);
+        }
+        fn drop(e: *Self, id: api.Id) void {
+            e.mutex.lockUncancelable(e.io);
+            defer e.mutex.unlock(e.io);
+            const owner = (e.active.fetchRemove(id) orelse return).value;
+            e.active_churn.dropped(api.Id, &e.active);
+            e.rows.release(id);
+            e.free(owner);
+        }
+        fn onEvent(ctx: *anyopaque, id: api.Id, ev: *const api.Event) void {
+            const e = self(ctx);
+            e.mutex.lockUncancelable(e.io);
+            const owner = e.active.get(id) orelse {
+                e.mutex.unlock(e.io);
+                return;
+            };
+            const sink = owner.sink;
+            e.mutex.unlock(e.io);
+            if (ev.* == .finished) e.drop(id);
+            sink.event(sink.ctx, id, ev);
+        }
+    };
+}
diff --git a/zig/src/families/deepseek_v41/vision_engine_test.zig b/zig/src/families/deepseek_v41/vision_engine_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9e450a6d3f58f080f1d41f3f2c917410793df151
--- /dev/null
+++ b/zig/src/families/deepseek_v41/vision_engine_test.zig
@@ -0,0 +1,84 @@
+//! Exercise the production wrapper with actual host image ownership and a scripted lane engine.
+const std = @import("std");
+const t = std.testing;
+const api = @import("engine_api");
+const Native = @import("vision_native.zig").Native;
+const Store = @import("vision/store.zig").Store;
+const Wrapper = @import("vision_engine.zig").Wrapper(Store);
+
+const Fake = struct {
+    sink: ?api.Sink = null,
+    fail: bool = false,
+    synchronous: bool = false,
+    cancelled: bool = false,
+    events: u32 = 0,
+    fn engine(f: *Fake) api.Engine {
+        return .{ .ctx = f, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+    fn info(_: *anyopaque) api.Info {
+        return .{};
+    }
+    fn submit(ctx: *anyopaque, id: api.Id, req: *const api.Request, sink: api.Sink) api.SubmitError!void {
+        const f: *Fake = @ptrCast(@alignCast(ctx));
+        if (f.fail) return error.Busy;
+        if (req.images.len != 0 or req.prompt[0] < (1 << 24)) return error.InvalidRequest;
+        f.sink = sink;
+        if (f.synchronous) sink.event(sink.ctx, id, &.{ .finished = .{ .reason = .stop } });
+    }
+    fn cancel(ctx: *anyopaque, _: api.Id) void {
+        const f: *Fake = @ptrCast(@alignCast(ctx));
+        f.cancelled = true;
+    }
+    fn status(_: *anyopaque, _: *api.Status, _: []u32) void {}
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+    fn event(ctx: *anyopaque, _: api.Id, _: *const api.Event) void {
+        const f: *Fake = @ptrCast(@alignCast(ctx));
+        f.events += 1;
+    }
+};
+
+fn lifecycle(a: std.mem.Allocator) !void {
+    var n = try Native.init(a, t.io, .{}, .{});
+    defer n.deinit();
+    var store: Store = .{ .gpa = a };
+    defer store.deinit();
+    var fake: Fake = .{};
+    var wrapper: Wrapper = .{ .gpa = a, .io = t.io, .inner = fake.engine(), .native = &n, .rows = &store };
+    defer wrapper.deinit();
+    const image: api.Image = .{ .pixels = &pixels, .gh = 3, .gw = 6, .tokens = 5, .at = 0 };
+    const req: api.Request = .{ .prompt = &.{ 129264, 129264, 129264, 129264, 129264 }, .images = &.{image}, .max_tokens = 1 };
+    const engine = wrapper.engine();
+    const sink: api.Sink = .{ .ctx = &fake, .event = Fake.event };
+    const small: api.Image = .{ .pixels = pixels[0 .. 3 * 3 * 588], .gh = 3, .gw = 3, .tokens = 4, .at = 0 };
+    const rejected: api.Request = .{ .prompt = &.{ 129264, 129264, 129264, 129264 }, .images = &.{small}, .max_tokens = 1 };
+    try t.expectError(error.InvalidRequest, engine.submit(9, &rejected, sink));
+    try t.expect(fake.sink == null);
+    try t.expectEqual(@as(u32, 0), store.holds.count());
+    try t.expectEqual(@as(u32, 0), store.where.count());
+    try t.expectEqual(@as(u32, 0), wrapper.active.count());
+    try engine.submit(1, &req, sink);
+    try t.expectEqual(@as(u32, 1), store.holds.count());
+    engine.cancel(1);
+    try t.expect(fake.cancelled);
+    try t.expectEqual(@as(u32, 1), store.holds.count());
+    fake.sink.?.event(fake.sink.?.ctx, 1, &.{ .finished = .{ .reason = .cancelled } });
+    try t.expectEqual(@as(u32, 0), store.holds.count());
+    try t.expectEqual(@as(u32, 0), wrapper.active.count());
+    try t.expectEqual(@as(u32, 1), fake.events);
+    fake.fail = true;
+    try t.expectError(error.Busy, engine.submit(2, &req, sink));
+    try t.expectEqual(@as(u32, 0), store.holds.count());
+    try t.expectEqual(@as(u32, 0), wrapper.active.count());
+    fake.fail = false;
+    fake.synchronous = true;
+    try engine.submit(3, &req, sink);
+    try t.expectEqual(@as(u32, 0), wrapper.active.count());
+    try t.expectEqual(@as(u32, 0), store.holds.count());
+}
+const pixels: [3 * 6 * 588]f32 = @splat(1.0);
+
+test "image wrapper cancellation, submit rejection and synchronous completion release actual inputs" {
+    try lifecycle(t.allocator);
+}
