+test "runner: an abstained cell, a cell with no header, and the runner off all keep the model's own text" {
+    const pseudo = "```python\nprint(undefined_total)\n```\nResult:\n";
+    const a = try one(pseudo, .{});
+    defer gpa.free(a);
