From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Wed, 4 Nov 2026 00:05:25 +0700
Subject: [PATCH 192/207] server tests: deadline_s that the reply ends before
 is the largest, so a pause never reaches it

The "without deadline_s, or with one the reply ends before" tests used deadline_s 100,
while the scripted engine ends by itself at the 40th check (~2 s of wall time). A SIGSTOP
(a QUIET pause) of 100 s or more mid-test let that deadline fire first, so the reply was
cancelled and the test failed (T3: 12:17Z and 15:08Z). Use 1000000 s, the largest
deadline_s the server takes; the reply still ends on the check count.

(cherry picked from commit 644ec6bd8165f5889556235eb9c766e7fdf9b03a)
---
 zig/src/server/request_deadline_http_test.zig | 3 ++-
 zig/src/server/request_deadline_test.zig      | 3 ++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/zig/src/server/request_deadline_http_test.zig b/zig/src/server/request_deadline_http_test.zig
index fd48a12c2c5020c474491d34f5521bb3af024a7d..14b8c2f1bce115b751fd6e20b8ea40b8ed90fbc4 100644
--- a/zig/src/server/request_deadline_http_test.zig
+++ b/zig/src/server/request_deadline_http_test.zig
@@ -190,7 +190,8 @@ test "request deadline: HTTP without deadline_s, or with one the reply never mee
         var s_off: Script = .{ .hangs = false };
         var s_late: Script = .{ .hangs = false };
         const off = try post(a, &s_off, c, 100, "");
-        const late = try post(a, &s_late, c, 100, ",\"deadline_s\":100");
+        // the largest deadline_s (11.6 days): no SIGSTOP or QUIET pause reaches it before the script ends by itself
+        const late = try post(a, &s_late, c, 100, ",\"deadline_s\":1000000");
         for ([_]Got{ off, late }, [_]*Script{ &s_off, &s_late }) |g, s| {
             try std.testing.expect(!s.cancelled);
             try std.testing.expectEqualStrings("stop", g.finish);
diff --git a/zig/src/server/request_deadline_test.zig b/zig/src/server/request_deadline_test.zig
index d33357670382636ec17466e109c89ce793f698fb..0f6ba7761ee754c946f30edc3b0e23ebe4689757 100644
--- a/zig/src/server/request_deadline_test.zig
+++ b/zig/src/server/request_deadline_test.zig
@@ -145,7 +145,8 @@ test "request deadline: without deadline_s, or with one the reply ends before, t
     defer arena.deinit();
     const a = arena.allocator();
     const off = try run(a, null);
-    const late = try run(a, .{ .int = "100" });
+    // the largest deadline_s (11.6 days): no SIGSTOP or QUIET pause reaches it; the engine ends at the 40th check
+    const late = try run(a, .{ .int = "1000000" });
     for ([_]Run{ off, late }) |r| {
         try std.testing.expect(!r.cancelled);
         try std.testing.expectEqualStrings("stop", r.reply.finish_reason);
