From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Mon, 2 Nov 2026 05:54:40 +0700
Subject: [PATCH 090/207] In-model runner: route plan-name tests beside the
 program lowering (route under 600 lines)

---
 zig/src/core/lane_host_tests.zig      |  1 +
 zig/src/core/runner_graph_program.zig | 67 +++++++++++++++++++++++++++
 zig/src/core/runner_graph_route.zig   | 67 ---------------------------
 3 files changed, 68 insertions(+), 67 deletions(-)

diff --git a/zig/src/core/lane_host_tests.zig b/zig/src/core/lane_host_tests.zig
index 08f25ba0dc36ec66531670af5ac9a0ad71daeee4..d3f7efaad84b5e5fe1443852da26b9f81111a102 100644
--- a/zig/src/core/lane_host_tests.zig
+++ b/zig/src/core/lane_host_tests.zig
@@ -34,4 +34,5 @@ test {
     _ = @import("runner_proof_test.zig");
     _ = @import("runner_place_test.zig");
     _ = @import("runner_graph_route.zig");
+    _ = @import("runner_graph_program.zig");
 }
diff --git a/zig/src/core/runner_graph_program.zig b/zig/src/core/runner_graph_program.zig
index 99f87ba1db08bcbf6fed61391f381670d32182d1..a265ebbd0c2234b93599dde8fdd3cd128b485105 100644
--- a/zig/src/core/runner_graph_program.zig
+++ b/zig/src/core/runner_graph_program.zig
@@ -250,3 +250,70 @@ pub fn direct(a: Allocator, bank: *const graph.Bank, cell: api.Cell, why: api.Ab
     }
     return route.lower(a, bank, out.items);
 }
+
+fn planNames(a: Allocator, src: []const u8) !?[]u8 {
+    var arena_state = std.heap.ArenaAllocator.init(a);
+    defer arena_state.deinit();
+    const sh = try route.shape(arena_state.allocator(), src) orelse return null;
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(a);
+    for (sh.nodes, sh.live, sh.plans) |n, on, name| if (on and n.kind != .literal) {
+        if (out.items.len != 0) try out.append(a, ' ');
+        try out.appendSlice(a, name);
+    };
+    return try out.toOwnedSlice(a);
+}
+
+test "runner graph route: pure-integer calc programs become bank plans sized from their syntax" {
+    const a = std.testing.allocator;
+    for ([_][2][]const u8{
+        .{ "2**100-3**50", "pow-100-62 pow-50-62 sub-32" },
+        .{ "47*83", "mul-4" },
+        .{ "-7//2", "div-1" },
+        .{ "1071%462", "mod-4" },
+        .{ "-(2+3)", "add-2 sub-4" },
+        .{ "(-3)**5", "pow-5-62" },
+        .{ "10**61", "pow-61-62" },
+        .{ "(2+3)*4-1", "add-2 mul-4 sub-4" },
+        .{ "42", "" },
+        .{ "10**62", "pow-62-128" },
+        .{ "1000000000000000000000000000000000000000*100000000000000000000000000000", "mul-128" },
+        // big-number-020: (Y+B)**2 - Y**2 as B*(Y+(Y+B)), so no value passes 128 digits
+        .{ "(10**80+123456789)**2-10**160", "pow-80-128 add-128 add-128 mul-128" },
+    }) |c| {
+        const got = (try planNames(a, c[0])) orelse {
+            std.debug.print("not routed: {s}\n", .{c[0]});
+            return error.TestExpectedRoute;
+        };
+        defer a.free(got);
+        try std.testing.expectEqualStrings(c[1], got);
+    }
+}
+
+test "runner graph route: decimals, true division, computed exponents or divisors and values past 128 digits stay on calc" {
+    const a = std.testing.allocator;
+    for ([_][]const u8{
+        "1/2",
+        "1.5*2",
+        "2**-1",
+        "2**3**2",
+        "2**(3)",
+        "7//0",
+        "7%(1+1)",
+        "10**128",
+        "(10**80+123456789)**2-10**161",
+        "(10**80+123456789)**3-10**160",
+        "007+1",
+        "x*2",
+        "",
+        "(1+2",
+        "2**1000",
+        "3^2",
+    }) |src| {
+        if (try planNames(a, src)) |got| {
+            defer a.free(got);
+            std.debug.print("routed: {s}\n", .{src});
+            return error.TestUnexpectedRoute;
+        }
+    }
+}
