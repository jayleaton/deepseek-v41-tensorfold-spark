From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Mon, 2 Nov 2026 06:26:29 +0700
Subject: [PATCH 092/207] In-model runner: plan-name capture no longer shadows
 name(); one-line direct() comment

---
 zig/src/core/runner_graph_program.zig | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/zig/src/core/runner_graph_program.zig b/zig/src/core/runner_graph_program.zig
index a265ebbd0c2234b93599dde8fdd3cd128b485105..75896d596cf920fe811987db824632f83b02df62 100644
--- a/zig/src/core/runner_graph_program.zig
+++ b/zig/src/core/runner_graph_program.zig
@@ -220,8 +220,7 @@ pub fn shadowed(prior: []const []const u8) bool {
     return false;
 }
 
-/// An inline or REPL expression the frontend refused past its 62 digits, straight onto the bank's 128-digit plans;
-/// inline `^` × − are math, `%` (percent) and REPL `^` (XOR) refuse.
+/// An inline or REPL expression the frontend refused, onto 128-digit plans; `%` and REPL `^` (XOR) refuse.
 pub fn direct(a: Allocator, bank: *const graph.Bank, cell: api.Cell, why: api.Abstain) Allocator.Error!?[]u8 {
     if ((why != .unsupported and why != .too_big) or cell.form == .fence or !std.mem.eql(u8, cell.lang, "python")) return null;
     var src = std.mem.trim(u8, cell.code, " \t\n");
@@ -257,9 +256,9 @@ fn planNames(a: Allocator, src: []const u8) !?[]u8 {
     const sh = try route.shape(arena_state.allocator(), src) orelse return null;
     var out: std.ArrayList(u8) = .empty;
     errdefer out.deinit(a);
-    for (sh.nodes, sh.live, sh.plans) |n, on, name| if (on and n.kind != .literal) {
+    for (sh.nodes, sh.live, sh.plans) |n, on, plan_name| if (on and n.kind != .literal) {
         if (out.items.len != 0) try out.append(a, ' ');
-        try out.appendSlice(a, name);
+        try out.appendSlice(a, plan_name);
     };
     return try out.toOwnedSlice(a);
 }
