@@ -0,0 +1,273 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The decode-speed paths of the V4.1 serving layer on the CPU (G4's changes; the GPU side is
+``tests/cuda/test_dsv41_m2_gpu.py``):
+
+- a round over several decoding slots is one DSpark pass and one verify forward over every slot's window (one
+  expert pass, one set of exchanges), never a window a slot;
+- the buffers a CUDA graph captures keep their addresses: every slot's ratio-2 carries through prefill, verify,
+  commit, snapshot / restore and reset; the graphs' fingerprint sees a moved buffer and drops the graphs; the memory
+  floor stops captures (both ranks), keeping the held graphs; the warm-up sets;
+- the Engram prefetch: row-level reads (parallel extents, cache, in flight) give the shard's rows bit for bit; the
+  pending row issued at commit is not read again; the hasher is called once a window; the lazy per-layer inputs
+  equal the eager ones;
+- the phase timers.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_dspark_fakes as DF
+import dsv41_fakes as FK
+
+from tensorfold.engine.exact_sampling import Sampling
+from tensorfold.families.deepseek_v41.cuda import graphs as G
+from tensorfold.families.deepseek_v41.cuda import phases
+from tensorfold.families.deepseek_v41.cuda import prefetch as PF
+from tensorfold.families.deepseek_v41.cuda.batch import Job
+from tensorfold.families.deepseek_v41.cuda.forward import Forward, Seg
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+
+PROMPTS = [[int(t) for t in np.random.default_rng(60 + i).integers(3, 250, size=40 + 7 * i)] for i in range(4)]
+SAMPLINGS = [None, Sampling(seed=3, temperature=0.8, top_k=20, top_p=0.95), None,
+             Sampling(seed=9, temperature=0.7, top_k=0, top_p=0.9)]
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41perf"))
+
+
+# -- one window a round ------------------------------------------------------------------------------------------
+def test_one_verify_window_and_one_draft_pass_per_round(ck):
+    fw = DF.forward(ck, slots=4)
+    calls = []
+    for name in ("window", "draft"):
+        real = getattr(fw, name)
+
+        def rec(*a, real=real, name=name, **k):
+            calls.append((name, a))
+            return real(*a, **k)
+
+        setattr(fw, name, rec)
+    b = DF.batcher(ck, fw, n=4)
+    for p, s in zip(PROMPTS, SAMPLINGS):
+        b.submit(Job(list(p), 10, s))
+    rounds = []
+    while True:
+        calls.clear()
+        if not b.step():
+            break
+        rounds.append([(n, len(a[0])) for n, a in calls])
+    decoding = [r for r in rounds if any(n == "window" for n, _ in r)]
+    assert decoding and all(sum(1 for n, _ in r if n == "window") == 1 for r in decoding)
+    assert all(sum(1 for n, _ in r if n == "draft") <= 1 for r in rounds)
+    assert max(w for r in decoding for n, w in r if n == "window") == 4      # every slot's window in one forward
+    assert max(w for r in rounds for n, w in r if n == "draft") == 4         # every slot's drafts in one pass
+
+
+# -- addresses a graph captures ------------------------------------------------------------------------------------
+def _carry_ptrs(fw):
+    return [(i, L, c.data_ptr()) for i, s in enumerate(fw.slots) for L, c in sorted(s.carry.items())]
+
+
+def test_carries_keep_their_addresses(ck):
+    fw = DF.forward(ck, slots=2, dspark=False)
+    b = DF.batcher(ck, fw, n=2)
+    ptrs = _carry_ptrs(fw)
+    assert ptrs
+    for s in range(2):
+        b.ex.slots[s].ensure(64)
+        fw.reset(s)
+        fw.prefill([Piece(s, 0, tuple(PROMPTS[s][:33]))], mode="full")
+    assert _carry_ptrs(fw) == ptrs
+    from tensorfold.families.deepseek_v41.cuda.protocol import Rows
+
+    fw.window([Rows(0, 33, (5, 6, 7)), Rows(1, 33, (9,))], count=4)
+    fw.commit(0, 1)
+    fw.commit(1, 0)
+    assert _carry_ptrs(fw) == ptrs
+    snap = fw.snapshot(0)
+    want = {L: c.clone() for L, c in fw.slots[0].carry.items()}
+    fw.reset(0)
+    fw.restore(0, snap)
+    assert _carry_ptrs(fw) == ptrs
+    assert all(torch.equal(fw.slots[0].carry[L], t) for L, t in want.items())
+
+
+def test_graph_fingerprint_sees_a_moved_buffer(ck):
+    fw = DF.forward(ck, slots=2, dspark=False)
+    cg = object.__new__(G.CudaGraphs)
+    cg.fw = fw
+    fp = cg.fingerprint()
+    assert cg.fingerprint() == fp
+    L = next(iter(fw.slots[1].carry))
+    fw.slots[1].carry[L] = fw.slots[1].carry[L].clone()              # what keep() did before G4
+    assert cg.fingerprint() != fp
+    gc = G.GraphCache(lambda key: {"key": key})
+    gc.warmup(G.warmup_keys(1, warm="decode"))
+    assert len(gc.graphs) == 6
+    gc.drop()
+    assert not gc.graphs and gc.stats["dropped"] == 6 and gc.on
+
+
+def test_graph_memory_floor_stops_captures_and_keeps_graphs():
+    free = {"MemAvailable": 9 << 30}
+    room = G.room_for(5.0, meminfo=lambda: free)
+    gc = G.GraphCache(lambda key: {"key": key}, room=room)
+    assert gc.warmup(G.warmup_keys(1, warm="decode")[:3]) == 3
+    free["MemAvailable"] = 4 << 30
+    k = gc.key([(0, 0, 8)], 8192)
+    gc.lazy(k)
+    assert gc.full and len(gc.graphs) == 3 and gc.on and not gc.wants(gc.key([(0, 0, 12)], 8192))
+    assert gc.get(gc.key([(0, 0, 2)], 8192)) is not None                   # the held graphs still replay
+    # past MIN_KEEP held: under the floor the least recent quarter is evicted and the cap lowered, not frozen
+    free["MemAvailable"] = 9 << 30
+    gone = []
+    big = G.GraphCache(lambda key: {"key": key}, room=room, forget=gone.append)
+    for t in range(16):
+        big.lazy(big.key([(0, t * 2048, 1)], 1 << 20))
+    big.get(big.key([(0, 0, 1)], 1 << 20))                                 # bucket 0 replayed: most recent
+    free["MemAvailable"] = 4 << 30
+    big.lazy(big.key([(0, 0, 2)], 1 << 20))
+    assert not big.full and big.max_graphs == 12 and len(big.graphs) == 12 and big.stats["evicted"] == 4
+    assert gone == [big.key([(0, t * 2048, 1)], 1 << 20) for t in range(1, 5)]
+    assert big.key([(0, 0, 1)], 1 << 20) in big.graphs and big.key([(0, 0, 2)], 1 << 20) not in big.graphs
+    assert big.pause == G.PAUSE
+    for _ in range(G.PAUSE):                                                 # paused: no cascade, nothing evicted
+        big.lazy(big.key([(0, 0, 2)], 1 << 20))
+    assert len(big.graphs) == 12 and big.pause == 0 and big.stats["evicted"] == 4
+    for _ in range(2):                                                       # 12 -> 9 -> 8 (a pause after each)
+        big.lazy(big.key([(0, 0, 2)], 1 << 20))
+        big.pause = 0
+    big.lazy(big.key([(0, 0, 2)], 1 << 20))                                 # then full
+    assert big.full and len(big.graphs) == G.MIN_KEEP
+    # the other rank is under the floor: neither captures
+    other = G.GraphCache(lambda key: {"key": key}, agree_any=lambda flag: True)
+    assert other.warmup(G.warmup_keys(1)) == 0
+    assert G.room_for(5.0, meminfo=lambda: {})()                            # no meminfo: no limit
+
+
+def test_graph_settings(monkeypatch):
+    st = G.env_settings()
+    assert st["warm"] == "decode" and st["slots"] == 1 and st["floor_gib"] == 5.0
+    assert G.warmup_keys(4, 4, "decode") == [(((0, w),), 0) for w in (1, 2, 3, 4, 5, 6)]
+    assert G.warmup_keys(4, 4, "none") == [] and len(G.warmup_keys(4, 4, "all")) == 15
+    monkeypatch.setenv("TF_DSV41_GRAPH_WARM", "sometimes")
+    with pytest.raises(ValueError):
+        G.env_settings()
+
+
+# -- Engram reads --------------------------------------------------------------------------------------------------
+@pytest.fixture(scope="module")
+def shards(ck, tmp_path_factory):
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+
+    root = tmp_path_factory.mktemp("dsv41perfeng")
+    cfg, table = ck[1], ck[2]
+    FK.write_engram(root, cfg, table, 1)
+    return lambda: EH.open_shards(root, 0, 1, cfg.engram_layer_ids, dim=cfg.engram_head_dim)
+
+
+def test_row_reads_are_the_shards_rows(shards):
+    src = shards()
+    pf = PF.Prefetcher(src, workers=4, cache=64)
+    rng = np.random.default_rng(1)
+    for L, s in src.items():
+        h = s.header
+        for _ in range(4):
+            idx = torch.from_numpy(rng.integers(h.lo, h.hi, size=37)).long()
+            idx[5] = idx[0]                                                  # duplicates
+            assert torch.equal(pf.rows(L, idx), s.rows(idx))
+        idx = torch.from_numpy(rng.integers(h.lo, h.hi, size=20)).long()
+        pf.layers[L].issue(idx.numpy())
+        miss = pf.stats["misses"]
+        assert torch.equal(pf.rows(L, idx), s.rows(idx)) and pf.stats["misses"] == miss
+        assert torch.equal(pf.rows(L, idx), s.rows(idx)) and pf.stats["cached"] >= 20
+    assert len(pf.layers[L].cache) <= 64
+
+
+def test_pending_row_issued_at_commit_and_hashed_once(ck, shards):
+    fw = DF.forward(ck, slots=2, prefetch=True, rows=shards())
+    assert isinstance(fw.hasher, PF.CachedHasher)
+    b = DF.batcher(ck, fw, n=2)
+    issued = []
+    real = fw.prefetcher.issue_pending
+
+    def rec(f, slot, token):
+        issued.append((slot, token))
+        return real(f, slot, token)
+
+    fw.prefetcher.issue_pending = rec
+    got = DF.run(b, [Job(list(PROMPTS[0]), 10, None), Job(list(PROMPTS[1]), 10, SAMPLINGS[3])])
+    st = fw.prefetcher.stats
+    assert issued and st["misses"] == 0 and st["hits"] > 0
+    assert fw.hasher.stats["hits"] > 0                                       # the forward reused the issue's hashes
+    plain = DF.run(DF.batcher(ck, DF.forward(ck, slots=2), n=2),
+                   [Job(list(PROMPTS[0]), 10, None), Job(list(PROMPTS[1]), 10, SAMPLINGS[3])])
+    assert got == plain
+
+
+def test_lazy_engram_inputs_equal_eager(ck):
+    fw = DF.forward(ck, slots=2, dspark=False)
+    b = DF.batcher(ck, fw, n=2)
+    b.ex.slots[0].ensure(64)
+    fw.reset(0)
+    fw.prefill([Piece(0, 0, tuple(PROMPTS[2][:20]))], mode="full")
+    segs = [Seg(0, 20, (4, 5, 6, 7))]
+    lazy = fw.engram_inputs_eager(segs)
+    plain = Forward._engram_inputs(fw, segs)
+    assert sorted(plain) == lazy.keys() and all(torch.equal(lazy[L], plain[L]) for L in plain)
+    assert [L for L, _ in lazy.items()] == sorted(plain)
+
+
+# -- timers --------------------------------------------------------------------------------------------------------
+def test_phase_timers(ck, monkeypatch):
+    with pytest.raises(ValueError):
+        phases.Phases("maybe")
+    off = phases.Phases("0")
+    assert off("x").__enter__() is None and off.report()["mode"] == "0"
+    monkeypatch.setenv(phases.ENV, "sync")
+    ph = phases.reload()
+    try:
+        fw = DF.forward(ck, slots=2)
+        b = DF.batcher(ck, fw, n=2)
+        DF.run(b, [Job(list(PROMPTS[0]), 6, None), Job(list(PROMPTS[3]), 6, SAMPLINGS[3])])
+        r = ph.report()
+        for name in ("round", "plan", "execute", "commit", "prefill", "draft", "window", "forward", "candidates",
+                     "sample", "draft.pass"):
+            assert r[name]["n"] > 0, name
+        assert r["round"]["ms"] >= r["execute"]["ms"] and "phases (sync" in ph.describe()
+    finally:
+        monkeypatch.setenv(phases.ENV, "0")
+        phases.reload()
+
+
+def test_alloc_ceiling_caps_reserved_plus_headroom(monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda import memory as M
+
+    class _Cuda:
+        frac = None
+
+        def current_device(self):
+            return 0
+
+        def get_device_properties(self, i):
+            return type("P", (), {"total_memory": 128 << 30})()
+
+        def memory_reserved(self):
+            return 100 << 30
+
+        def set_per_process_memory_fraction(self, f):
+            _Cuda.frac = f
+
+    torch = type("T", (), {"cuda": _Cuda()})()
+    monkeypatch.delenv("TF_DSV41_ALLOC_CEIL_GIB", raising=False)
+    assert M.alloc_ceiling(torch) is None and _Cuda.frac is None                 # off by default
+    monkeypatch.setenv("TF_DSV41_ALLOC_CEIL_GIB", "1.5")
+    assert M.alloc_ceiling(torch) == 101.5 and _Cuda.frac == 101.5 / 128
