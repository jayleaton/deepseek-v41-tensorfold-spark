@@ -0,0 +1,188 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""moe_fused (TF_DSV41_MOE_FUSED) on the CPU, through the numpy emulator (tests/dsv41_moe_fused_emu.py):
+
+- the tail's selection + pruning + kit rounding == the production sequence's references (router_gemv.model_select,
+  prune.reference, pick.kit_weights) bit for bit, both geometries, every rule shape, rows with tied weights;
+- the routed grouping (ids < E) == upstream's grouping of the whole table minus the shared entry;
+- rot_in: only routed pairs, close to float64, and the contracted form == the plain one (bf16 x fp16 products are\n  exact in fp32, so nvcc's contraction choice cannot change a bit);
+- combine2 on (routed Z, compact shared Z) == upstream's down_combine on the merged Z, out and y bit for bit;
+- the counter protocol: no deadlock for any dispatch order at capacity >= help + 1, every rot_in task once,
+  counters back to 0; help >= capacity can deadlock (the bound is needed);
+- knobs, help_count bounds, and the dispatch off / on CPU.
+"""
+
+from __future__ import annotations
+
+from dsv41_interp import interpret
+
+interpret()                                 # prune.py imports triton: the interpreter suites need it set first
+
+import dsv41_moe_fused_emu as EM
+import numpy as np
+import pytest
+import torch
+
+from tensorfold.families.deepseek_v41.cuda import moe_fused as MF
+from tensorfold.families.deepseek_v41.cuda import prune as PR
+from tensorfold.families.deepseek_v41.cuda import router_gemv as RG
+
+RULES = [None, PR.Rule(topp=0.85, min_k=3, renorm="kept"), PR.Rule(topp=0.85, min_k=3),
+         PR.Rule(min_w=0.1, min_k=4, renorm="kept"), PR.Rule(min_w=0.05, topp=0.9, min_k=2)]
+
+
+def _logits(R, E, seed, ties=False):
+    rng = np.random.default_rng(seed)
+    lg = (rng.standard_normal((R, E)) * 2.0).astype(np.float32)
+    for r in range(0, R, 2):                    # peaked rows: a few experts carry the mass (the rules drop slots)
+        lg[r] -= 8.0
+        lg[r, rng.permutation(E)[:6]] = np.array([9.0, 2.0, -1.0, -2.5, -4.0, -5.5], np.float32)
+    if ties:                                    # equal scores -> equal weights inside the top-k
+        for r in range(R):
+            lg[r, rng.integers(0, E, 4)] = lg[r, rng.integers(0, E)]
+            lg[r, :8] = 3.0
+    bias = (rng.standard_normal(E) * 0.01).astype(np.float32)
+    if ties:
+        bias[:8] = 0.0
+    return lg, bias
+
+
+def _reference(lg, bias, K, scale, rule, drop):
+    p, w = RG.model_select(lg, bias, K, True, scale, kit=False)
+    p, w = torch.from_numpy(p), torch.from_numpy(w)
+    if rule is not None:
+        p, w = PR.reference(p, w, K, rule, scale, drop)
+    return p.numpy(), w.to(torch.float16).to(torch.float32).numpy()        # pick.kit_weights
+
+
+@pytest.mark.parametrize("rule", RULES, ids=["off", "p85k", "p85", "w10k", "w05p90"])
+@pytest.mark.parametrize("E,K", [(384, 6), (128, 3)])
+@pytest.mark.parametrize("ties", [False, True])
+def test_tail_equals_router_prune_kit(rule, E, K, ties):
+    if rule is not None and rule.min_k >= K:
+        rule = PR.Rule(rule.min_w, rule.topp, K - 1, rule.renorm)
+    lg, bias = _logits(40, E, 3 + K, ties)
+    p, w, pr = EM.select(lg, bias, K, 1.5, True, rule, E + 1)
+    rp, rw = _reference(lg, bias, K, 1.5, rule, E + 1)
+    assert np.array_equal(p, rp) and np.array_equal(w.view(np.int32), rw.view(np.int32))
+    assert np.array_equal(pr[:, :K], p[:, :K]) and (pr[:, K] == -1).all() and (p[:, K] == E).all()
+    if rule is not None and 0 < rule.topp <= 0.85 and not ties:
+        assert (p[:, :K] == E + 1).any()                                     # the rule dropped something
+
+
+def test_tail_rows_are_their_own():
+    lg, bias = _logits(16, 384, 9)
+    rule = RULES[1]
+    full = EM.select(lg, bias, 6, 1.5, True, rule, 385)
+    for r in (0, 7, 15):
+        one = EM.select(lg[r:r + 1], bias, 6, 1.5, True, rule, 385)
+        assert all(np.array_equal(a[r], b[0]) for a, b in zip(full, one))
+
+
+def test_group_is_upstreams_without_the_shared_entry():
+    lg, bias = _logits(12, 384, 5)
+    for rule in RULES[:2]:
+        p, _, _ = EM.select(lg, bias, 6, 1.5, True, rule, 385)
+        ids_r, n_r, mem_r = RG.model_group(p, 384, 12)                     # the fused kernel's: ids < E
+        ids_t, n_t, mem_t = RG.model_group(p, 385, 12)                     # today's: the whole table
+        assert n_t == n_r + 1 and ids_t[-1] == 384 and np.array_equal(ids_t[:-1], ids_r)
+        assert np.array_equal(mem_t[:-1], mem_r)
+        assert list(mem_t[-1]) == [r * 32 + 6 for r in range(12)]           # the shared members: every row, slot 6
+        assert 385 not in set(ids_r.tolist())                                # dropped slots group to nothing
+
+
+def test_rot_in_routed_pairs_only_and_close_to_float64():
+    rng = np.random.default_rng(1)
+    R, Dm, E = 3, 5120, 16
+    x = rng.standard_normal((R, Dm)).astype(np.float32)
+    x = torch.from_numpy(x).to(torch.bfloat16).float().numpy()
+    sg = torch.from_numpy(((rng.random((E + 1, Dm)) + 0.5) * 0.02).astype(np.float32)).half().float().numpy()
+    su = torch.from_numpy(((rng.random((E + 1, Dm)) + 0.5) * 0.02).astype(np.float32)).half().float().numpy()
+    pick = np.array([[1, 5, 17, 3, E], [0, 2, 4, 6, E], [7, 7, 9, 17, E]], np.int64)    # 17: dropped; E: shared
+    out = EM.rot_in(x, sg, su, pick, E)
+    want = {r * 5 + k for r in range(R) for k in range(5) if 0 <= pick[r, k] < E}
+    assert set(out) == want
+    H = np.array([[1.0]])
+    while H.shape[0] < 128:
+        H = np.block([[H, H], [H, -H]])
+    for p, (g, _) in out.items():
+        r, k = divmod(p, 5)
+        ref = ((x[r].astype(np.float64) * sg[pick[r, k]]).reshape(-1, 128) @ H.T / np.sqrt(128)).reshape(-1)
+        assert np.max(np.abs(g.astype(np.float64) - ref)) <= 1e-3 * max(1.0, np.max(np.abs(ref)))
+    # bf16 x fp16 products have <= 19 significant bits: exact in fp32, so nvcc's FFMA contraction of the first
+    # butterfly stage cannot change a bit (normal-range inputs); the kernel spells upstream's form out anyway
+    plain = EM.rot_in(x, sg, su, pick, E, contracted=False)
+    assert all(np.array_equal(out[p][0], plain[p][0]) and np.array_equal(out[p][1], plain[p][1]) for p in out)
+
+
+def test_combine2_equals_down_combine_on_the_merged_partials():
+    rng = np.random.default_rng(2)
+    R, slots, K, E, Dm, SK = 4, 7, 6, 64, 256, 1
+    P = R * slots
+    pick = np.stack([np.concatenate([rng.permutation(E)[:K], [E]]) for _ in range(R)]).astype(np.int64)
+    pick[1, 3] = E + 1                                                      # a pruned slot: reads stale y
+    wts = rng.random((R, slots)).astype(np.float32)
+    wts[:, K] = 1.0
+    wts[1, 3] = 0.0
+    svh = (rng.random((E + 1, Dm)) + 0.5).astype(np.float16).astype(np.float32)
+    Z = rng.standard_normal(SK * P * Dm).astype(np.float32)
+    Zs = rng.standard_normal(SK * R * Dm).astype(np.float32)
+    merged = Z.reshape(SK, P, Dm).copy()
+    for r in range(R):
+        merged[:, r * slots + K] = Zs.reshape(SK, R, Dm)[:, r]
+    y0 = rng.standard_normal((P, Dm)).astype(np.float32)
+    y_a, y_b = y0.copy(), y0.copy()
+    a = EM.down_combine(merged.reshape(-1), pick, svh, y_a, wts, R, P, Dm, SK, slots, E + 1)
+    b = EM.combine2(Z, Zs, pick, svh, y_b, wts, R, P, R, Dm, SK, slots, E + 1, K)
+    assert np.array_equal(a.view(np.int32), b.view(np.int32)) and np.array_equal(y_a.view(np.int32),
+                                                                                 y_b.view(np.int32))
+
+
+@pytest.mark.parametrize("E,nw", [(384, 2), (384, 1), (128, 2), (384, 8)])
+@pytest.mark.parametrize("R", [1, 2, 5, 16])
+def test_protocol_never_deadlocks_and_covers_every_task(E, nw, R):
+    nprod = -(-E // nw)
+    rng = np.random.default_rng(E * 31 + R * 7 + nw)
+    for sms in (48, 8):
+        hp = MF.help_count(R, E, nw, sms)
+        assert 0 <= hp <= sms - 1 and hp < nprod
+        for capacity in (hp + 1, sms, 4 * sms):
+            for ordered in (True, False):
+                res = EM.protocol(nprod, hp, R, capacity, nw, rng, ordered)
+                assert not res["deadlock"], (capacity, ordered)
+                assert (res["done"] == 1).all() and res["cnt"] == [0, 0, 0, 0]
+                assert sum(1 for v in res["roles"].values() if v == 2) == 1
+                assert sum(1 for v in res["roles"].values() if v == 1) == hp
+
+
+def test_protocol_bound_is_needed():
+    rng = np.random.default_rng(0)
+    hits = sum(EM.protocol(16, 4, 1, 4, 2, rng)["deadlock"] for _ in range(200))
+    assert hits > 0                                                          # help == capacity: it can hang
+
+
+def test_knobs_and_help():
+    assert MF.parse({}) == {"on": False, "help": None, "sdn": "late", "shared": "side", "tail": "serial", "min_rows": 1}
+    assert MF.parse({"TF_DSV41_MOE_FUSED": "1", "TF_DSV41_MOE_FUSED_HELP": "8", "TF_DSV41_MOE_FUSED_SDN": "early"}) \
+        == {"on": True, "help": 8, "sdn": "early", "shared": "side", "tail": "serial", "min_rows": 1}
+    for bad in ({"TF_DSV41_MOE_FUSED_HELP": "x"}, {"TF_DSV41_MOE_FUSED_HELP": "-1"},
+                {"TF_DSV41_MOE_FUSED_SDN": "mid"}):
+        with pytest.raises(ValueError):
+            MF.parse(bad)
+    assert MF.help_count(1, 384, 2, 48) == 19                               # 40 tasks, one a warp
+    assert MF.help_count(16, 384, 2, 48) == 47 and MF.help_count(16, 384, 2, 48, want=100) == 47
+    assert MF.help_count(1, 4, 2, 48) == 1                                   # fewer than the producers
+    assert MF.help_count(4, 384, 2, 48, want=0) == 0
+
+
+def test_not_taken_off_or_on_cpu(monkeypatch):
+    class Stand:
+        gate = torch.zeros((384, 5120), dtype=torch.bfloat16)
+        topk = 6
+
+    x = torch.zeros((2, 5120), dtype=torch.bfloat16)
+    monkeypatch.setattr(MF, "CFG", MF.parse({}))
+    assert not MF.eligible(Stand(), x, None)
+    monkeypatch.setattr(MF, "CFG", MF.parse({"TF_DSV41_MOE_FUSED": "1"}))
+    assert not MF.eligible(Stand(), x, None)                                # CPU tensors: the old sequence
+    assert "off" not in MF.describe() or not MF.CFG["on"]
