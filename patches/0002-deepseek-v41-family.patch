+++ b/src/tensorfold/families/deepseek_v41/cuda/dsparktrain.py
@@ -0,0 +1,540 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Self-distillation of the whole DSpark drafter on our target (one GB10, the engine stopped), from ``dsparkdata``.
+
+The drafter in PyTorch, block-parallel as DSpark drafts (engine/reference/model.py ``DSpark.draft``, the engine's
+``drafter.py``): main_x = rms(main_proj(taps)); per block the 128 context rows rope(rms(wkv(main_x))) and the block
+rows [anchor, noise x 4] at P .. P + 4 attending to all of them (non-causal, sink softmax, V = K); mHC hyper-
+connections (delayed pre-mix, Sinkhorn); the 128-expert top-3 MoE + shared expert; the final collapse, norm and the
+target's head; the Markov head biases row i by the serial token before it (teacher forced, as trained).
+
+Weights come from the pack itself (``weights.Loader``, world 1), EXL3 decoded once to frozen bf16 (on CUDA: upstream's
+kernel applied to the identity, exact; ~29 GB for the 3 blocks' 128 x 3 experts + head + embedding). Only deltas
+train:
+
+- stage ``A`` (heads): the Markov head (w1' = (w1 + w1 M) a, w2' = w2 + w2 Q), the confidence head, main_norm and
+  the final norm (deltas), a LoRA on main_proj;
+- stage ``B``: A + LoRA (rank ``--rank``) on every block's wq_a, wkv, wq_b, the 8 wo_a groups and wo_b, and the
+  blocks' norm vectors (attn / ffn / q / kv). Routed and shared experts stay frozen: on the GPU the shared expert rides
+  in the routed launch, so a delta there would need kernel work.
+
+Loss: forward KL from the target's top-K distribution (T = 1, renormalized over its K) to the draft's full softmax,
+a weight ``gamma^i`` a draft position (later positions only count when the earlier ones are kept); the confidence
+head: BCE against "the row's argmax is the serial token" (inputs detached).
+
+Evaluation (held-out sessions): teacher-forced top-1 a position, and the engine's chain at T = 0 (argmax over each
+row's top-128 base candidates + the Markov bias of the previous draft): conditional acceptance a position and tokens
+a round over all 5; plus ``agree``: the base model's drafts == the engine's logged drafts (the port's fidelity).
+
+Export (``export_delta``): a safetensors file for ``dsparkdelta`` (TF_DSV41_DSPARK_DELTA): replacement vectors and
+tables (norms, Markov, confidence) and LoRA pairs ``<linear>.lora_A`` [r, K] / ``.lora_B`` [N, r] (scale folded).
+The pack is never modified.
+
+CLI: python -m tensorfold.families.deepseek_v41.cuda.dsparktrain --model M --data D --stage A|B --out F
+     [--init F] [--minutes 20] [--rank 32] [--lr ..] [--seg 96] [--eval-only]
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import time
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+F32, BF16, F16 = torch.float32, torch.bfloat16, torch.float16
+LORA_ATTN = ("wq_a", "wkv", "wq_b", "wo_b")
+
+
+def bf(x: torch.Tensor) -> torch.Tensor:
+    return x.to(BF16).to(F32)
+
+
+def rms(x: torch.Tensor, w: torch.Tensor | None, eps: float) -> torch.Tensor:
+    x = x.to(F32)
+    y = x * torch.rsqrt(x.square().mean(-1, keepdim=True) + eps)
+    return y if w is None else y * w.to(F32)
+
+
+def dense(x3, device, dtype=BF16) -> torch.Tensor:
+    """An EXL3 matrix as W [K, N] (y = x @ W): on CUDA the engine's kernel on the identity (exact), else the float64
+    oracle."""
+
+    from . import linear as LN
+
+    if torch.device(device).type == "cuda":
+        lin = LN.exl3_from(x3.trellis, x3.suh, x3.svh, x3.codebook, device)
+        K = lin.k
+        out = torch.empty((K, lin.n), dtype=dtype, device=device)
+        for a in range(0, K, 512):
+            b = min(K, a + 512)
+            eye = torch.zeros((b - a, K), dtype=F16, device=device)
+            eye[:, a:b] = torch.eye(b - a, dtype=F16, device=device)
+            out[a:b] = lin(eye, F32).to(dtype)
+        return out
+    return LN.dense_from(x3.trellis, x3.suh, x3.svh, x3.codebook).w.to(dtype)
+
+
+class Lora(torch.nn.Module):
+    def __init__(self, W: torch.Tensor, r: int, alpha: float = 1.0) -> None:
+        super().__init__()
+        self.W = W                                          # frozen [K, N] bf16 (not a parameter)
+        self.r = int(r)
+        if r:
+            K, N = W.shape
+            self.A = torch.nn.Parameter(torch.randn(r, K, device=W.device) / math.sqrt(K))
+            self.B = torch.nn.Parameter(torch.zeros(N, r, device=W.device))
+            self.scale = alpha
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        y = (x.to(BF16) @ self.W).to(F32)
+        if self.r:
+            y = y + ((x.to(F32) @ self.A.t()) @ self.B.t()) * self.scale
+        return bf(y)
+
+
+def _vec(t: torch.Tensor, train: bool) -> tuple[torch.Tensor, torch.nn.Parameter | None]:
+    t = t.to(F32)
+    return t, (torch.nn.Parameter(torch.zeros_like(t)) if train else None)
+
+
+class Drafter(torch.nn.Module):
+    """The DSpark drafter with trainable deltas (module docstring)."""
+
+    def __init__(self, cfg, model_dir: str, device, *, stage: str = "A", rank: int = 32, src=None) -> None:
+        super().__init__()
+        from . import weights as W
+
+        self.cfg, self.dev, self.stage = cfg, torch.device(device), stage
+        src = src or W.Shards(model_dir)
+        ld = W.Loader(cfg, src, 0, 1, device)
+        nh, nb = cfg.num_hidden_layers, cfg.num_nextn_predict_layers
+        f = lambda s: next(n for i in reversed(range(nb)) for n in [f"mtp.{i}.{s}"]
+                           if n in src or f"{n}.trellis" in src or f"{n}.weight" in src)
+        self.names = {"main_proj": f("main_proj"), "main_norm": f("main_norm"), "norm": f("norm"),
+                      "embed": f("markov_head.embed"), "head": f("markov_head.head"),
+                      "conf": f("confidence_head.proj")}
+        r_b = rank if stage == "B" else 0
+        self.main_proj = Lora(dense(ld.x3(self.names["main_proj"]), device), rank)
+        self.main_norm, self.d_main_norm = _vec(ld.native(f"{self.names['main_norm']}.weight"), True)
+        self.norm, self.d_norm = _vec(ld.native(f"{self.names['norm']}.weight"), True)
+        self.w1 = ld.native(f"{self.names['embed']}.weight", BF16, bf16_param=True)
+        self.w2 = ld.native(f"{self.names['head']}.weight", BF16, bf16_param=True)
+        r = self.w1.shape[1]
+        self.M = torch.nn.Parameter(torch.zeros(r, r, device=self.dev))
+        self.Q = torch.nn.Parameter(torch.zeros(r, r, device=self.dev))
+        self.log_alpha = torch.nn.Parameter(torch.zeros((), device=self.dev))
+        self.cw = torch.nn.Parameter(ld.native(f"{self.names['conf']}.weight").reshape(-1).to(F32))
+        self.embed = src.tensor("embed.weight").to(BF16).to(self.dev)
+        self.head = dense(ld.x3("head"), device)
+        self.blocks = torch.nn.ModuleList()
+        self.bw = []
+        for i in range(nb):
+            lw = ld.layer(nh + i)
+            a, m = lw.attn, lw.moe
+            mod = torch.nn.Module()
+            for nm in LORA_ATTN:
+                setattr(mod, nm, Lora(dense(getattr(a, nm), device), r_b))
+            mod.wo_a = torch.nn.ModuleList([Lora(dense(x, device), r_b) for x in a.wo_a])
+            vecs = {"attn_norm": lw.attn_norm, "ffn_norm": lw.ffn_norm, "q_norm": a.q_norm, "kv_norm": a.kv_norm}
+            d = {}
+            for k, v in vecs.items():
+                base, delta = _vec(v, stage == "B")
+                d[k] = base
+                if delta is not None:
+                    mod.register_parameter(f"d_{k}", delta)
+            E = m.w1.trellis.shape[0]
+            ex = {w: torch.stack([dense(getattr(m, w).item(e), device) for e in range(E)]) for w in ("w1", "w2", "w3")}
+            sh = [tuple(dense(x, device) for x in t) for t in m.shared]
+            self.bw.append({"vec": d, "hc_attn": lw.hc_attn, "hc_ffn": lw.hc_ffn, "sink": a.sink.to(F32),
+                            "gate": m.gate.to(F32), "bias": m.bias.to(F32), "ex": ex, "shared": sh, "E": E})
+            self.blocks.append(mod)
+            lw.attn = lw.moe = None
+        self.inv_freq = 1.0 / (cfg.rope.rope_theta ** (torch.arange(0, cfg.qk_rope_head_dim, 2, dtype=F32,
+                                                                       device=self.dev) / cfg.qk_rope_head_dim))
+        for p in self.parameters():
+            p.requires_grad_(False)
+        for p in self.trainable():
+            p.requires_grad_(True)
+
+    # -- parameters ----------------------------------------------------------------------------------------------------
+    def trainable(self) -> list:
+        out = [self.M, self.Q, self.log_alpha, self.cw, self.d_main_norm, self.d_norm,
+               self.main_proj.A, self.main_proj.B] if self.main_proj.r else [self.M, self.Q, self.log_alpha, self.cw,
+                                                                           self.d_main_norm, self.d_norm]
+        if self.stage == "B":
+            for mod in self.blocks:
+                for n, p in mod.named_parameters():
+                    out.append(p)
+        return out
+
+    def vec(self, b: int, k: str) -> torch.Tensor:
+        base = self.bw[b]["vec"][k]
+        d = getattr(self.blocks[b], f"d_{k}", None)
+        return base if d is None else base + d
+
+    # -- pieces --------------------------------------------------------------------------------------------------------
+    def rope(self, x: torch.Tensor, pos: torch.Tensor, inverse: bool = False) -> torch.Tensor:
+        rd = self.cfg.qk_rope_head_dim
+        fr = pos.to(F32)[:, None] * self.inv_freq[None, :]
+        cos, sin = torch.cos(fr), torch.sin(fr)
+        if inverse:
+            sin = -sin
+        shape = (cos.shape[0],) + (1,) * (x.dim() - 2) + (cos.shape[1],)
+        cos, sin = cos.reshape(shape), sin.reshape(shape)
+        rot = x[..., -rd:].to(F32)
+        ev, od = rot[..., 0::2], rot[..., 1::2]
+        out = torch.stack((ev * cos - od * sin, od * cos + ev * sin), -1).flatten(-2)
+        return torch.cat((x[..., :-rd].to(F32), out), -1)
+
+    def hc_pre(self, streams, hc, pre_in, norm_w):
+        c = self.cfg
+        t, h, _ = streams.shape
+        x = streams.reshape(t, -1)
+        mixes = (x @ hc.fn.to(F32).t()) * torch.rsqrt(x.square().mean(-1, keepdim=True) + c.rms_norm_eps)
+        sc, base = hc.scale.to(F32), hc.base.to(F32)
+        pre = torch.sigmoid(mixes[:, :h] * sc[0] + base[:h]) + c.hc_eps
+        post = torch.sigmoid(mixes[:, h:2 * h] * sc[1] + base[h:2 * h]) * c.hc_post_alpha
+        comb = mixes[:, 2 * h:].reshape(t, h, h) * sc[2] + base[2 * h:].reshape(1, h, h)
+        comb = torch.softmax(comb, -1) + c.hc_eps
+        comb = comb / (comb.sum(-2, keepdim=True) + c.hc_eps)
+        for _ in range(c.hc_sinkhorn_iters - 1):
+            comb = comb / (comb.sum(-1, keepdim=True) + c.hc_eps)
+            comb = comb / (comb.sum(-2, keepdim=True) + c.hc_eps)
+        xin = self.collapse(streams, pre_in)
+        return post, comb, bf(rms(xin, norm_w, c.rms_norm_eps)), pre
+
+    @staticmethod
+    def collapse(streams, pre):
+        if pre is None:
+            return bf(streams[:, 0])
+        return bf((pre.unsqueeze(-1) * streams).sum(1))
+
+    @staticmethod
+    def hc_post(out, streams, post, comb):
+        return bf(torch.einsum("tij,tid->tjd", comb, streams) + post.unsqueeze(-1) * out.unsqueeze(1))
+
+    def kv(self, b: int, x: torch.Tensor, pos: torch.Tensor) -> torch.Tensor:
+        mod = self.blocks[b]
+        k = bf(rms(mod.wkv(x), self.vec(b, "kv_norm"), self.cfg.rms_norm_eps))
+        return bf(self.rope(k, pos))
+
+    def attention(self, b: int, x, qpos, ctx_k, ctx_ok, n: int):
+        c, mod = self.cfg, self.blocks[b]
+        R = x.shape[0]
+        B = R // n
+        qr = bf(rms(mod.wq_a(x), self.vec(b, "q_norm"), c.rms_norm_eps))
+        q = mod.wq_b(qr).view(R, c.num_attention_heads, c.head_dim)
+        q = bf(self.rope(q, qpos))
+        kq = self.kv(b, x, qpos).view(B, n, -1)
+        keys = torch.cat([ctx_k, kq], 1)                                     # [B, W + n, hd]
+        ok = torch.cat([ctx_ok, torch.ones((B, n), dtype=torch.bool, device=x.device)], 1)
+        s = torch.einsum("bnhd,bsd->bnhs", q.view(B, n, c.num_attention_heads, -1), keys) / math.sqrt(c.head_dim)
+        s = s.masked_fill(~ok[:, None, None, :], float("-inf"))
+        sink = self.bw[b]["sink"]
+        m = torch.maximum(s.amax(-1), sink[None, None, :])
+        e = torch.exp(s - m[..., None])
+        den = e.sum(-1) + torch.exp(sink[None, None, :] - m)
+        o = torch.einsum("bnhs,bsd->bnhd", e / den[..., None], keys).reshape(R, c.num_attention_heads, -1)
+        o = bf(self.rope(bf(o), qpos, inverse=True))
+        g = c.o_groups
+        og = o.reshape(R, g, -1)
+        z = torch.cat([mod.wo_a[i](og[:, i]) for i in range(g)], -1)
+        return mod.wo_b(z)
+
+    def moe(self, b: int, x: torch.Tensor) -> torch.Tensor:
+        c, w = self.cfg, self.bw[b]
+        _, topk = c.experts_of(c.num_hidden_layers + b)
+        logits = x @ w["gate"].t()
+        sc = torch.sqrt(F.softplus(logits))
+        ids = (sc + w["bias"][None, :]).topk(topk, -1).indices
+        wt = sc.gather(1, ids)
+        if c.norm_topk_prob:
+            wt = wt / wt.sum(-1, keepdim=True)
+        wt = (wt * c.routed_scaling_factor).to(F16).to(F32)
+        out = torch.zeros_like(x)
+        lim = c.swiglu_limit
+        xb = x.to(BF16)
+        for e in torch.unique(ids).tolist():
+            tok, slot = (ids == e).nonzero(as_tuple=True)
+            h = xb.index_select(0, tok)
+            g1 = (h @ w["ex"]["w1"][e]).to(F32).clamp(max=lim)
+            u = (h @ w["ex"]["w3"][e]).to(F32).clamp(-lim, lim)
+            down = ((F.silu(g1) * u).to(BF16) @ w["ex"]["w2"][e]).to(F32)
+            out = out.index_add(0, tok, down * wt[tok, slot].unsqueeze(-1))
+        for w1, w2, w3 in w["shared"]:
+            g1 = (xb @ w1).to(F32).clamp(max=lim)
+            u = (xb @ w3).to(F32).clamp(-lim, lim)
+            out = out + ((F.silu(g1) * u).to(BF16) @ w2).to(F32)
+        return bf(out)
+
+    # -- a batch of passes -----------------------------------------------------------------------------------------------
+    def forward(self, bt: dict):
+        """bt (``dsparkdata.Data.batch``, as tensors on the device) -> (base logits [B, n, V] fp32, Markov me [B, n, r],
+        hidden [B, n, D])."""
+
+        c, dev = self.cfg, self.dev
+        n = bt["serial"].shape[1]
+        Wn = c.sliding_window
+        taps = bt["taps"].view(BF16).to(dev)
+        mx = bf(rms(self.main_proj(taps), self.main_norm + self.d_main_norm, c.rms_norm_eps))
+        P = bt["P"].to(dev)
+        B = P.shape[0]
+        idx = P[:, None] - Wn + torch.arange(Wn, device=dev)[None, :]          # [B, W] rows of the segment
+        ok = (idx >= 0) & bt["has_taps"].to(dev)[idx.clamp(min=0)]
+        idx = idx.clamp(min=0)
+        pos_rows = bt["pos"].to(dev)
+        ids = torch.full((B, n), int(c.dspark_noise_token_id), dtype=torch.long, device=dev)
+        ids[:, 0] = bt["anchor"].to(dev)
+        qpos = (bt["Pabs"].to(dev)[:, None] + torch.arange(n, device=dev)[None, :]).reshape(-1)
+        x = self.embed[ids.reshape(-1)].to(F32)
+        streams = x.unsqueeze(1).expand(-1, c.hc_mult, -1).contiguous()
+        pre = None
+        for b in range(len(self.blocks)):
+            ctx_k = self.kv(b, mx, pos_rows)[idx]                                   # [B, W, hd]
+            post, comb, xin, pre_a = self.hc_pre(streams, self.bw[b]["hc_attn"], pre, self.vec(b, "attn_norm"))
+            streams = self.hc_post(self.attention(b, xin, qpos, ctx_k, ok, n), streams, post, comb)
+            post, comb, xin, pre = self.hc_pre(streams, self.bw[b]["hc_ffn"], pre_a, self.vec(b, "ffn_norm"))
+            streams = self.hc_post(self.moe(b, xin), streams, post, comb)
+        hidden = self.collapse(streams, pre)
+        hn = bf(rms(hidden, self.norm + self.d_norm, c.rms_norm_eps))
+        logits = (hn.to(BF16) @ self.head).to(F32)
+        prev = torch.cat([bt["anchor"].to(dev)[:, None], bt["serial"].to(dev)[:, :n - 1]], 1)
+        me = self.me(prev.reshape(-1))
+        V = logits.shape[-1]
+        return logits.view(B, n, V), me.view(B, n, -1), hidden.view(B, n, -1)
+
+    def me(self, prev: torch.Tensor) -> torch.Tensor:
+        e = self.w1[prev].to(F32)
+        return (e + e @ self.M) * self.log_alpha.exp()
+
+    def w2p(self) -> torch.Tensor:
+        w = self.w2.to(F32)
+        return w + w @ self.Q
+
+    def bias(self, me: torch.Tensor) -> torch.Tensor:
+        return me @ self.w2p().t()
+
+    def conf_logit(self, hidden: torch.Tensor, me: torch.Tensor) -> torch.Tensor:
+        return torch.cat([hidden.detach(), me.detach()], -1) @ self.cw
+
+
+def _to(bt: dict, dev) -> dict:
+    return {k: (torch.from_numpy(np.ascontiguousarray(v).copy()) if isinstance(v, np.ndarray) else v)
+            for k, v in bt.items()}
+
+
+def losses(model: Drafter, bt: dict, gamma: float = 0.8) -> tuple[torch.Tensor, dict]:
+    base, me, hid = model(bt)
+    dev = base.device
+    B, n, V = base.shape
+    z = base + model.bias(me.reshape(B * n, -1)).view(B, n, V)
+    lab, val = bt["lab_ids"].to(dev), bt["lab_val"].to(dev)
+    live = lab >= 0
+    pt = torch.softmax(val.masked_fill(~live, float("-inf")), -1)
+    logq = torch.log_softmax(z, -1).gather(-1, lab.clamp(min=0))
+    kl = -(pt * logq).masked_fill(~live, 0.0).sum(-1)                                   # [B, n] (+ const)
+    wpos = gamma ** torch.arange(n, device=dev, dtype=F32)
+    loss_kl = (kl * wpos).sum() / (B * wpos.sum())
+    serial = bt["serial"].to(dev)
+    hit = (z.argmax(-1) == serial).to(F32)
+    cl = model.conf_logit(hid.reshape(B * n, -1), me.reshape(B * n, -1)).view(B, n)
+    loss_c = F.binary_cross_entropy_with_logits(cl, hit)
+    return loss_kl + 0.1 * loss_c, {"kl": float(loss_kl.detach()), "conf": float(loss_c.detach()),
+                                    "top1": hit.mean(0).tolist()}
+
+
+@torch.no_grad()
+def evaluate(model: Drafter, data, sessions, *, seg: int = 96, max_segments: int = 0, cands: int = 128) -> dict:
+    """Held-out: teacher-forced top-1, the engine's T = 0 chain (top-``cands`` base candidates + Markov), agreement of
+    the chain with the logged drafts."""
+
+    n = data.n
+    tf = np.zeros(n)
+    reach, kept = np.zeros(n), np.zeros(n)
+    lens, agree, agree1, agree_n, rows = [], 0, 0, 0, 0
+    segs = data.segments(sessions, seg)
+    if max_segments:
+        segs = segs[:max_segments]
+    w2p = model.w2p()
+    for s, Ps in segs:
+        bt = _to(data.batch(s, Ps), model.dev)
+        base, me, _ = model(bt)
+        B = base.shape[0]
+        serial = bt["serial"].to(model.dev)
+        z = base + (me.reshape(B * n, -1) @ w2p.t()).view(B, n, -1)
+        tf += (z.argmax(-1) == serial).float().sum(0).cpu().numpy()
+        top = base.topk(cands, -1).indices                                     # [B, n, C]
+        prev = bt["anchor"].to(model.dev)
+        d = []
+        for i in range(n):
+            zc = base[:, i].gather(-1, top[:, i]) + torch.einsum("br,bcr->bc", model.me(prev), w2p[top[:, i]])
+            tok = top[:, i].gather(-1, zc.argmax(-1, keepdim=True)).squeeze(-1)
+            d.append(tok)
+            prev = tok
+        d = torch.stack(d, 1)
+        eq = (d == serial).cpu().numpy()
+        for row in eq:
+            a = 0
+            while a < n and row[a]:
+                a += 1
+            lens.append(a)
+            for i in range(min(a + 1, n)):
+                reach[i] += 1
+                kept[i] += int(i < a)
+        lg = bt["drafts"].numpy()[:, :n]
+        dn = d.cpu().numpy()
+        m = lg[:, 0] >= 0
+        agree += int(((lg[m] == dn[m]) | (lg[m] < 0)).all(1).sum())
+        agree1 += int((lg[m, 0] == dn[m, 0]).sum())
+        agree_n += int(m.sum())
+        rows += B
+    return {"rows": rows, "teacher_forced_top1": (tf / max(rows, 1)).round(4).tolist(),
+            "conditional": (kept / np.maximum(reach, 1)).round(4).tolist(),
+            "tokens_per_round_all5": round(1 + float(np.mean(lens)), 4) if lens else None,
+            "agree_logged_drafts": round(agree / agree_n, 4) if agree_n else None,
+            "agree_logged_first": round(agree1 / agree_n, 4) if agree_n else None, "logged_passes": agree_n}
+
+
+def train(model: Drafter, data, sessions, *, minutes: float, lr: float, seg: int = 96, gamma: float = 0.8,
+          seed: int = 0, log=print) -> dict:
+    rng = np.random.default_rng(seed)
+    params = model.trainable()
+    opt = torch.optim.AdamW(params, lr=lr, weight_decay=0.0)
+    t0, step, hist = time.time(), 0, []
+    budget = minutes * 60.0
+    segs = data.segments(sessions, seg, rng)
+    total = max(1, len(segs))
+    while time.time() - t0 < budget:
+        for s, Ps in segs:
+            if time.time() - t0 >= budget:
+                break
+            frac = min(1.0, (time.time() - t0) / budget)
+            for g in opt.param_groups:
+                g["lr"] = lr * (min(1.0, (step + 1) / 50) * 0.5 * (1 + math.cos(math.pi * frac)))
+            loss, info = losses(model, _to(data.batch(s, Ps), model.dev), gamma)
+            opt.zero_grad(set_to_none=True)
+            loss.backward()
+            torch.nn.utils.clip_grad_norm_(params, 1.0)
+            opt.step()
+            step += 1
+            hist.append(info["kl"])
+            if step % 50 == 0:
+                log(f"[dsparktrain] step {step} ({step / total:.2f} epochs, {time.time() - t0:.0f} s): kl "
+                    f"{np.mean(hist[-50:]):.4f}, top1 {[round(x, 3) for x in info['top1']]}")
+        segs = data.segments(sessions, seg, rng)
+    return {"steps": step, "epochs": round(step / total, 3), "kl_last": float(np.mean(hist[-50:])) if hist else None,
+            "seconds": round(time.time() - t0, 1)}
+
+
+@torch.no_grad()
+def export_delta(model: Drafter, path: str) -> dict:
+    """The trained deltas as the engine applies them (``dsparkdelta``)."""
+
+    from safetensors.torch import save_file
+
+    nm = model.names
+    t = {f"{nm['main_norm']}.weight": (model.main_norm + model.d_main_norm).float(),
+         f"{nm['norm']}.weight": (model.norm + model.d_norm).float(),
+         f"{nm['embed']}.weight": model.me(torch.arange(model.w1.shape[0], device=model.dev)).to(BF16),
+         f"{nm['head']}.weight": model.w2p().to(BF16), f"{nm['conf']}.weight": model.cw.float().reshape(1, -1)}
+
+    def lora(prefix, mod):
+        if mod.r and float(mod.B.abs().max()) > 0:
+            t[f"{prefix}.lora_A"] = mod.A.float().contiguous()
+            t[f"{prefix}.lora_B"] = (mod.B * mod.scale).float().contiguous()
+    lora(nm["main_proj"], model.main_proj)
+    for b, mod in enumerate(model.blocks):
+        p = f"mtp.{b}"
+        for k in ("attn_norm", "ffn_norm"):
+            if getattr(mod, f"d_{k}", None) is not None:
+                t[f"{p}.{k}.weight"] = model.vec(b, k).float()
+        for k in ("q_norm", "kv_norm"):
+            if getattr(mod, f"d_{k}", None) is not None:
+                t[f"{p}.attn.{k}.weight"] = model.vec(b, k).float()
+        for k in LORA_ATTN:
+            lora(f"{p}.attn.{k}", getattr(mod, k))
+        for g, lin in enumerate(mod.wo_a):
+            lora(f"{p}.attn.wo_a.slice.{g}", lin)
+    t = {k: v.detach().cpu().contiguous() for k, v in t.items()}
+    save_file(t, path, metadata={"source": "dsparktrain", "stage": model.stage})
+    return {"tensors": len(t), "lora": sum(1 for k in t if k.endswith("lora_A"))}
+
+
+@torch.no_grad()
+def load_delta(model: Drafter, path: str) -> None:
+    """A stage-A export into a fresh model (stage B starts from it): vectors and tables as bases, LoRA A / B."""
+
+    from safetensors import safe_open
+
+    nm = model.names
+    with safe_open(path, "pt") as fh:
+        keys = set(fh.keys())
+        g = lambda k: fh.get_tensor(k).to(model.dev)
+        model.main_norm = g(f"{nm['main_norm']}.weight").float()
+        model.norm = g(f"{nm['norm']}.weight").float()
+        model.w1 = g(f"{nm['embed']}.weight").to(BF16)
+        model.w2 = g(f"{nm['head']}.weight").to(BF16)
+        model.cw.copy_(g(f"{nm['conf']}.weight").reshape(-1).float())
+        p = nm["main_proj"]
+        if f"{p}.lora_A" in keys and model.main_proj.r:
+            A, Bm = g(f"{p}.lora_A"), g(f"{p}.lora_B")
+            if A.shape[0] == model.main_proj.r:
+                model.main_proj.A.copy_(A)
+                model.main_proj.B.copy_(Bm / model.main_proj.scale)
+            else:                                   # another rank: fold it into the frozen base
+                model.main_proj.W = (model.main_proj.W.float() + (Bm @ A).t()).to(BF16)
+
+
+def main(argv=None) -> int:
+    from .config import Config
+    from .dsparkdata import Data
+
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--data", required=True)
+    ap.add_argument("--stage", choices=("A", "B"), default="A")
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--init", default="", help="a stage-A delta to start from")
+    ap.add_argument("--minutes", type=float, default=20.0)
+    ap.add_argument("--rank", type=int, default=32)
+    ap.add_argument("--lr", type=float, default=0.0)
+    ap.add_argument("--seg", type=int, default=96)
+    ap.add_argument("--gamma", type=float, default=0.8)
+    ap.add_argument("--holdout", type=float, default=0.1)
+    ap.add_argument("--eval-segments", type=int, default=400)
+    ap.add_argument("--report", default="")
+    a = ap.parse_args(argv)
+    dev = "cuda" if torch.cuda.is_available() else "cpu"
+    from pathlib import Path
+
+    cfg = Config.from_file(Path(a.model) / "config.json")
+    data = Data(a.data, n=int(cfg.dspark_block_size), window=int(cfg.sliding_window))
+    tr, te = data.split(a.holdout)
+    t0 = time.time()
+    model = Drafter(cfg, a.model, dev, stage=a.stage, rank=a.rank)
+    print(f"[dsparktrain] stage {a.stage}: weights in {time.time() - t0:.0f} s, "
+          f"{sum(p.numel() for p in model.trainable()) / 1e6:.2f} M trainable, sessions {len(tr)} / {len(te)}", flush=True)
+    rep = {"stage": a.stage, "rank": a.rank}
+    rep["eval_base"] = evaluate(model, data, te, seg=a.seg, max_segments=a.eval_segments)
+    print(f"[dsparktrain] base: {json.dumps(rep['eval_base'])}", flush=True)
+    if a.init:
+        load_delta(model, a.init)
+        rep["eval_init"] = evaluate(model, data, te, seg=a.seg, max_segments=a.eval_segments)
+        print(f"[dsparktrain] init: {json.dumps(rep['eval_init'])}", flush=True)
+    lr = a.lr or (2e-3 if a.stage == "A" else 3e-4)
+    rep["train"] = train(model, data, tr, minutes=a.minutes, lr=lr, seg=a.seg, gamma=a.gamma)
+    rep["eval_after"] = evaluate(model, data, te, seg=a.seg, max_segments=a.eval_segments)
+    print(f"[dsparktrain] after: {json.dumps(rep['eval_after'])}", flush=True)
+    rep["export"] = export_delta(model, a.out)
+    if a.report:
+        Path(a.report).write_text(json.dumps(rep, indent=1))
+    print(json.dumps(rep), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
