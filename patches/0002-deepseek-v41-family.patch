+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Fail fast on both ranks: a failure inside one rank's round ends the pair in about a second, not minutes.
+
+Why (G16, 2026-10-04): an exception raised on ONE rank inside a round desyncs the TP=2 pair. The first G16 soak's
+``KeyError: 5`` (``vision.Store.gather``, inside rank 0's prefill forward) and d5ceil's ``torch.OutOfMemoryError``
+(rank 0, a 299K prefill at ``TF_DSV41_ALLOC_CEIL_GIB=1.0``) both went the same way: rank 0 left the round, rank 1
+waited in the forward's exchange (RoCE: ``GLM53_TF_ROCE_TIMEOUT_S`` = 120 s; NCCL, which carries every prefill
+exchange over 256 KiB: forever), rank 0's next plan then waited ``TF_DSV41_PLAN_TIMEOUT`` (300 s) for rank 1's
+mailbox credits, and the watchdog needed 3 bad ticks to heal. Every in-flight request was lost either way.
+
+Design: **fail-stop the pair**, not recovery. Once a rank leaves a forward between two exchanges, its peer is inside
+an exchange that only the same calls on this rank could complete: NCCL has no timeout or abort here (ctypes, no
+``ncclCommAbort``), the RoCE runtime poisons itself for good on a timeout, and the forward's device state (graphs,
+the Engram gate, the prefetcher, a half-written pool page) after a partial round is unknown. A process restart is
+the one state both ranks can agree on, so the rank that fails, and the rank whose peer failed, each:
+
+1. poison their RoCE runtime from the host (``roce.Runtime.abort``: the failure word, and the peer flags of the
+   newest sequence written so a spinning wait returns now: pending and later exchanges end at once with
+   ``RoceError``, no marker file);
+2. fail every in-flight and queued request (rank 0): ``RuntimeError`` -> HTTP 500 with the reason ("rank 1 failed
+   in prefill: OutOfMemoryError ...; both ranks are restarting"); a request arriving afterwards gets a 503
+   (``CapacityError``: retry shortly);
+3. tell the peer over the **fate channel** (below), wait ``TF_DSV41_FAILFAST_GRACE_S`` (1.0 s: the HTTP threads write
+   their 500s; the RoCE flags keep being released) and exit with code **70** (``os._exit``: no atexit, no NCCL
+   destructor that could hang), the code ``stall.py``'s exit already uses: ``serve.sh watch`` sees a rank gone.
+
+What is NOT fatal (rank 0 only, nothing shared or the peer already done): an exception while planning (before the
+plan is sent; the round's requests fail, their slots are finished in the next plan as before) or while sampling a
+slot's candidates after the round (that slot's request alone fails, its slot is finished in the next plan: rank 1
+never learns a sample, so both ranks stay identical). Per-request failures the executor already isolates on both
+ranks (grammar, a damaged NVMe entry) stay per-request. Everything raised inside ``rounds.Executor.run`` (rank 0's
+"execute", any of rank 1's) and a failed plan send / receive is fatal. An OOM inside a prefill is fatal for the
+same reason as any other mid-forward error; the per-request answer to it is not to admit what does not fit:
+``memory.Floor`` prices a prompt's prefill transient against the tighter rank before admission (``batch.py``).
+
+The fate channel is the plan link's own TCP connection (``planlink``: under ``tcp`` it carries the plans rank 0 ->
+rank 1; under ``rdma`` only the handshake, then rank 1 polls it for liveness). Its rank 1 -> rank 0 direction was
+unused, so it now carries small frames (``<IIq``: magic, kind, value): ``MEM`` (rank 1's usable memory in bytes,
+every ``TF_DSV41_PEER_MEM_S`` = 0.5 s, from rank 1's fate thread: nothing on either round thread, no collective, no
+GPU) and ``FAIL`` (rank 1's reason, then it closes). Rank 0's fate thread reads them; end of stream without a
+``FAIL`` = rank 1 is gone (killed, crashed: the kernel closes the socket). Rank 0 -> rank 1 carries no new bytes:
+rank 0 failing shuts the socket down and rank 1's fate thread sees the hang-up (``poll`` for POLLRDHUP / POLLHUP,
+which consumes no plan bytes, so the follower's reads are untouched). Under ``TF_DSV41_PLAN_LINK=nccl`` (no TCP) the
+engine opens one TCP connection for the channel alone (``TF_DSV41_FATE_PORT``, default the rendezvous port + 8).
+Exchanges with the RoCE mailbox's credits were considered and not used: they live in C++ (``roce_msg.h``), a payload
+there changes the latency-critical path, and they flow only while plans do (an idle rank 0 would see no report).
+
+Knobs: ``TF_DSV41_FAILFAST`` (1; 0: the old behaviour: rank 0 fails the round's requests and carries on, rank 1's
+exception leaves ``follow``), ``TF_DSV41_FAILFAST_GRACE_S`` (1.0), ``TF_DSV41_PEER_MEM_S`` (0.5),
+``TF_DSV41_FATE_PORT``, and the test hook ``TF_DSV41_FAILFAST_INJECT=rank:round:phase[:kind]`` (raise once on that
+rank in the first round >= ``round`` at ``phase``: plan | commit | admit | prefill | saves | finals | window | sample;
+kind ``error`` (default), ``oom`` (``torch.OutOfMemoryError``), ``key`` (``KeyError``)) for the GPU test plan.
+Log lines: ``[tensorfold] dsv41 fail-fast: ...``.
+"""
+
+from __future__ import annotations
+
+import os
+import select
+import socket
+import struct
+import sys
+import threading
+import time
+import traceback
+from collections.abc import Callable
+
+ENV = "TF_DSV41_FAILFAST"
+EXIT_CODE = 70
+MAGIC = 0x46463431                      # "14FF"
+MEM, FAIL = 1, 2
+_FRAME = struct.Struct("<IIq")
+PHASES = ("plan", "commit", "admit", "prefill", "saves", "finals", "window", "sample")
+
+
+def enabled(raw: str | None = None) -> bool:
+    v = (os.environ.get(ENV, "1") if raw is None else raw).strip().lower() or "1"
+    if v not in ("0", "1", "on", "off"):
+        raise ValueError(f"{ENV}={v!r}: expected 1 or 0")
+    return v in ("1", "on")
+
+
+def _f(name: str, default: float, lo: float, hi: float) -> float:
+    raw = os.environ.get(name, "").strip()
+    v = float(raw) if raw else default
+    if not lo <= v <= hi:
+        raise ValueError(f"{name}={v}: expected {lo}..{hi}")
+    return v
+
+
+def _log(msg: str, out=None) -> None:
+    print(f"[tensorfold] dsv41 fail-fast: {msg}", file=out or sys.stderr, flush=True)
+
+
+# -- the test hook ----------------------------------------------------------------------------------------------------
+class Injected(RuntimeError):
+    """``TF_DSV41_FAILFAST_INJECT``'s error."""
+
+
+class Inject:
+    """Raise once on this rank in the first round >= ``round`` at ``phase`` (``TF_DSV41_FAILFAST_INJECT``)."""
+
+    def __init__(self, rank: int, round_no: int, phase: str, kind: str = "error") -> None:
+        if phase not in PHASES or kind not in ("error", "oom", "key"):
+            raise ValueError(f"TF_DSV41_FAILFAST_INJECT: phase {phase!r} (one of {', '.join(PHASES)}), kind {kind!r} "
+                             "(error | oom | key)")
+        self.rank, self.round, self.phase, self.kind = int(rank), int(round_no), phase, kind
+        self.fired = False
+
+    @classmethod
+    def from_env(cls, rank: int, raw: str | None = None) -> Inject | None:
+        v = (os.environ.get("TF_DSV41_FAILFAST_INJECT", "") if raw is None else raw).strip()
+        if not v:
+            return None
+        parts = v.split(":")
+        if len(parts) not in (3, 4):
+            raise ValueError(f"TF_DSV41_FAILFAST_INJECT={v!r}: expected rank:round:phase[:kind]")
+        inj = cls(int(parts[0]), int(parts[1]), parts[2], parts[3] if len(parts) == 4 else "error")
+        if inj.rank != int(rank):
+            return None
+        _log(f"rank {rank}: TF_DSV41_FAILFAST_INJECT armed ({inj.kind} at {inj.phase}, round >= {inj.round})")
+        return inj
+
+    def __call__(self, round_no: int, phase: str) -> None:
+        if self.fired or phase != self.phase or int(round_no) < self.round:
+            return
+        self.fired = True
+        what = f"TF_DSV41_FAILFAST_INJECT: rank {self.rank} round {round_no} phase {phase}"
+        if self.kind == "oom":
+            import torch
+
+            cls = getattr(torch, "OutOfMemoryError", None) or getattr(torch.cuda, "OutOfMemoryError", MemoryError)
+            raise cls(f"CUDA out of memory ({what})")
+        if self.kind == "key":
+            raise KeyError(what)
+        raise Injected(what)
+
+
+# -- the channel ------------------------------------------------------------------------------------------------------
+def conn_of(link) -> socket.socket | None:
+    """The TCP socket behind a plan link (``planlink.TcpLink`` / ``RoceLink``, under ``Pinned``), or None (nccl)."""
+
+    for _ in range(4):
+        conn = getattr(link, "conn", None)
+        if isinstance(conn, socket.socket):
+            return conn
+        inner = getattr(link, "tcp", None) or getattr(link, "link", None)
+        if inner is None:
+            return None
+        link = inner
+    return None
+
+
+class Channel:
+    """The fate channel over one stream socket: rank 1 writes ``MEM`` / ``FAIL`` frames, rank 0 reads them; either
+    side's hang-up is the other's signal."""
+
+    def __init__(self, rank: int, conn: socket.socket) -> None:
+        self.rank, self.conn = int(rank), conn
+        self.lock = threading.Lock()
+        self.sent = 0
+
+    def report(self, usable: int) -> bool:
+        """Rank 1: one MEM frame, never blocking (a full buffer drops it: the next one comes in 0.5 s)."""
+
+        try:
+            with self.lock:
+                self.conn.send(_FRAME.pack(MAGIC, MEM, int(usable)), socket.MSG_DONTWAIT)
+            self.sent += 1
+            return True
+        except (BlockingIOError, InterruptedError):
+            return False
+        except OSError:
+            return False
+
+    def fail(self, msg: str) -> None:
+        """Rank 1: the reason (best effort, at most ~1 s), then the hang-up."""
+
+        data = msg.encode("utf-8", "replace")[:4000]
+        try:
+            with self.lock:
+                self.conn.settimeout(1.0)
+                self.conn.sendall(_FRAME.pack(MAGIC, FAIL, len(data)) + data)
+        except OSError:
+            pass
+        self.hangup()
+
+    def hangup(self) -> None:
+        try:
+            self.conn.shutdown(socket.SHUT_RDWR)
+        except OSError:
+            pass
+
+    def _exact(self, n: int) -> bytes | None:
+        buf = b""
+        while len(buf) < n:
+            try:
+                got = self.conn.recv(n - len(buf))
+            except OSError:
+                return None
+            if not got:
+                return None
+            buf += got
+        return buf
+
+    def read(self) -> tuple[int, int, str] | None:
+        """Rank 0: the next frame (kind, value, text), or None at the end of the stream (rank 1 gone)."""
+
+        head = self._exact(_FRAME.size)
+        if head is None:
+            return None
+        magic, kind, value = _FRAME.unpack(head)
+        if magic != MAGIC:
+            return FAIL, 0, f"rank 1 sent a frame that is not the fate channel's (magic {magic:#x})"
+        text = ""
+        if kind == FAIL and value > 0:
+            body = self._exact(min(int(value), 4000))
+            text = body.decode("utf-8", "replace") if body is not None else ""
+        return kind, int(value), text
+
+    def hung_up(self, timeout_s: float) -> bool:
+        """Rank 1: True when rank 0 shut the socket down or it failed (poll; no plan byte is consumed)."""
+
+        p = select.poll()
+        try:
+            p.register(self.conn.fileno(), getattr(select, "POLLRDHUP", 0x2000) | select.POLLHUP | select.POLLERR)
+            return bool(p.poll(max(0, int(timeout_s * 1000))))
+        except (OSError, ValueError):           # closed here (a stop): the caller decides
+            return True
+
+
+def local_usable() -> int:
+    """This rank's usable memory in bytes, ``memory.Floor``'s measure (``memsafe.view``: MemFree + the allocator's
+    unused cache + the reclaimable page cache)."""
+
+    from tensorfold.families.glm5_next.spark import memsafe
+
+    from . import memory
+
+    mi = memsafe.read_meminfo()
+    return int(memsafe.view(mi.get("MemFree", 0), memory.allocator_cached(), "available", mi).usable)
+
+
+# -- the pair's fate --------------------------------------------------------------------------------------------------
+class Fate:
+    """One rank's side: ``fatal`` (this rank failed), the fate thread (the peer failed or left), ``peer_mem`` (rank 0:
+    rank 1's last report). ``on_fail``: callbacks given the reason (rank 0's batcher fails its requests)."""
+
+    def __init__(self, rank: int, chan: Channel | None, *, rt=None, exit_fn: Callable[[int], None] | None = None,
+                 grace_s: float | None = None, report_s: float | None = None,
+                 usable: Callable[[], int] | None = None, out=None) -> None:
+        self.rank, self.chan, self.rt = int(rank), chan, rt
+        self.exit_fn = exit_fn or os._exit
+        self.grace_s = _f("TF_DSV41_FAILFAST_GRACE_S", 1.0, 0.0, 60.0) if grace_s is None else float(grace_s)
+        self.report_s = _f("TF_DSV41_PEER_MEM_S", 0.5, 0.01, 60.0) if report_s is None else float(report_s)
+        self.usable = usable or local_usable
+        self.out = out
+        self.on_fail: list[Callable[[str], None]] = []
+        self.dead: str | None = None             # the reason, once the pair is going down
+        self.code: int | None = None             # the exit code asked for (tests: exit_fn returns)
+        self.peer: tuple[int, float] | None = None    # rank 1's usable bytes, monotonic time of the report
+        self.reports = 0
+        self.closing = False                     # a normal stop: the peer's hang-up is not a failure
+        self.done = threading.Event()            # set once ``_die`` asked for the exit
+        self._lock = threading.Lock()
+        self._thread: threading.Thread | None = None
+
+    def start(self) -> Fate:
+        if self.chan is not None and self._thread is None:
+            target = self._watch0 if self.rank == 0 else self._watch1
+            self._thread = threading.Thread(target=target, name=f"dsv41-fate-r{self.rank}", daemon=True)
+            self._thread.start()
+        return self
+
+    def peer_mem(self) -> tuple[int, float] | None:
+        """(rank 1's usable bytes, seconds since its report), or None before the first report."""
+
+        p = self.peer
+        return None if p is None else (p[0], time.monotonic() - p[1])
+
+    # -- failures ------------------------------------------------------------------------------------------------
+    def fatal(self, exc: BaseException, where: str) -> None:
+        """This rank failed inside a round (``where``: its phase): the pair goes down (see the module doc)."""
+
+        if self.dead is None:
+            traceback.print_exception(type(exc), exc, exc.__traceback__, file=self.out or sys.stderr)
+        self._die(f"rank {self.rank} failed in {where}: {type(exc).__name__}: {exc}", own=True)
+
+    def peer_failed(self, reason: str) -> None:
+        self._die(reason, own=False)
+
+    def close(self) -> None:
+        """A normal stop (rank 0's stop plan / rank 1 received it): the hang-up that follows is expected."""
+
+        self.closing = True
+
+    def _die(self, reason: str, *, own: bool) -> None:
+        with self._lock:
+            first = self.dead is None
+            if first:
+                self.dead = reason
+        if not first:
+            self.done.wait(self.grace_s + 5.0)  # the first caller exits the process; a second one waits for it
+            return
+        _log(f"rank {self.rank}: {reason}; failing every request, exiting ({EXIT_CODE}) in {self.grace_s:g} s so the "
+             f"pair restarts", self.out)
+        hold = None
+        if self.rt is not None:                 # pending and later RoCE exchanges end now (a RoceError each)
+            try:
+                self.rt.abort(reason)
+                hold = threading.Thread(target=self.rt.abort, args=(reason, self.grace_s), daemon=True,
+                                        name="dsv41-fate-roce")
+                hold.start()
+            except Exception as exc:            # noqa: BLE001  exiting matters more
+                _log(f"rank {self.rank}: RoCE abort failed: {exc!r}", self.out)
+        for cb in list(self.on_fail):
+            try:
+                cb(f"{reason}; both ranks are restarting")
+            except Exception as exc:            # noqa: BLE001
+                _log(f"rank {self.rank}: failing the requests raised {exc!r}", self.out)
+        if self.chan is not None:
+            if self.rank == 1 and own:
+                self.chan.fail(reason)
+            else:
+                self.chan.hangup()
+        if self.grace_s > 0:
+            time.sleep(self.grace_s)
+        self.code = EXIT_CODE
+        self.done.set()
+        self.exit_fn(EXIT_CODE)
+
+    # -- the fate threads ----------------------------------------------------------------------------------------
+    def _watch0(self) -> None:
+        while self.dead is None:
+            got = self.chan.read()
+            if got is None:
+                if self.closing or self.dead is not None:
+                    return
+                self.peer_failed("rank 1 closed the fate channel (the process exited or was killed)")
+                return
+            kind, value, text = got
+            if kind == MEM:
+                self.peer = (value, time.monotonic())
+                self.reports += 1
+            elif kind == FAIL:
+                self.peer_failed(text or "rank 1 failed")
+                return
+
+    def _watch1(self) -> None:
+        while self.dead is None:
+            if self.chan.hung_up(self.report_s):
+                if self.closing or self.dead is not None:
+                    return
+                self.peer_failed("rank 0 closed the fate channel (it failed, exited or was killed)")
+                return
+            try:
+                self.chan.report(self.usable())
+            except Exception:                   # noqa: BLE001  a report must never end the rank
+                pass
+
+
+def attach(batch, link, *, rank: int, master: str, port: int, rt=None, out=None) -> Fate | None:
+    """The engine's wiring (``engine._serve``): a ``Fate`` on the plan link's socket (or a TCP connection of its own
+    under ``TF_DSV41_PLAN_LINK=nccl``), started, given to the batcher; rank 0's floor reads rank 1's reports.
+    None with ``TF_DSV41_FAILFAST=0`` (the old behaviour)."""
+
+    if not enabled():
+        return None
+    conn = conn_of(link)
+    if conn is None:
+        from .planlink import TcpLink, port_for
+
+        raw = os.environ.get("TF_DSV41_FATE_PORT", "").strip()
+        conn = TcpLink(rank, master, int(raw) if raw else port_for(port) + 1).conn
+    fate = Fate(rank, Channel(rank, conn), rt=rt, out=out)
+    batch.fate = fate
+    if rank == 0:
+        fate.on_fail.append(batch.fail_everything)
+        if getattr(batch, "floor", None) is not None:
+            batch.floor.peer = fate.peer_mem
+    fate.start()
+    _log(f"rank {rank}: on (fate channel {'the plan link' if conn_of(link) is not None else 'its own TCP'}; exit "
+         f"{EXIT_CODE} after {fate.grace_s:g} s; rank 1 reports memory every {fate.report_s:g} s)", out)
+    return fate
+
+
+__all__ = ["Channel", "EXIT_CODE", "Fate", "Inject", "Injected", "attach", "conn_of", "enabled", "local_usable"]
