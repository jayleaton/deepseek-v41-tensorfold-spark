+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G19: adaptive prefill rows and the graph caches' prefill-dip rule, on the CPU.
+
+- ``memory.Adapt``: the steps (full, half, quarter, ... >= the minimum), the choice from the tighter rank's usable
+  memory less the round's priced transient (``memory.round_need``), the hysteresis on the way up;
+- the batcher on the real CPU forward (the fake checkpoint), full (with and without TF_DSV41_FULL_CONE) and replay: rounds whose rows follow a
+  scripted memory (64 / 32 / 16 a round, ``plan.release`` on each step down) give the same replies (greedy and
+  sampled) and the same stored snapshots (every array, bit for bit) as fixed 64-row rounds: prefill is
+  segmentation-invariant, so the rows a round never change the logits;
+- admission prices a prompt at the smallest step; ``TF_DSV41_PREFILL_ADAPT=0`` is the fixed rows of before;
+- ``graphs.GraphCache``: a capture refused for memory within ``TF_DSV41_GRAPH_DIP_ROUNDS`` rounds of a prefill
+  evicts nothing (deferred), a dip in a decode-only stretch evicts a quarter as before; ``graphs.Recent`` counts the
+  plans' rounds the same way on both ranks.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+
+import dsv41_fakes as FK  # noqa: E402
+
