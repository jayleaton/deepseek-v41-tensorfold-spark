+# -- decode == upstream unpack -----------------------------------------------------------------------------------------
+@pytest.mark.parametrize("bits", [4, 5, 6, 8])
+@pytest.mark.parametrize("layout", ["strips", "stored", "lanes"])
+def test_kernel_decode_equals_unpack_random(bits, layout):
+    if layout == "lanes" and bits == 8:
+        pytest.skip("no lanes kernels at 8 bits (dense3 leaves the indexer wk in strips)")
+    tr, _, _ = _case(256, 512, 1, bits, layout, seed=bits)
+    words, sk, snb = E.words_of_trellis(tr, layout)
+    assert np.array_equal(E.kernel_wq(words, 2 * bits, 256, 512, sk, snb, layout == "lanes"), E.fmt_unpack_bits(tr))
