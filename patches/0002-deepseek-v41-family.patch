@@ -0,0 +1,187 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16 prefill levers on the CPU (no GPU):
+
+- ``TF_DSV41_PF_COPIES``: the fast prefill run's copies trimmed (the core's output taken as is, ``wo_a`` writing
+  ``z`` in place, bf16 partials stored by their producers when the prefill exchange is bf16): TP=2 logits and both
+  ranks' states equal the untrimmed run's bit for bit, chunked and unchunked; one rank alike; the producers really
+  hand bf16 to the exchange;
+- ``FastLinear(out=)`` and ``prefill_mm.matmul(out=)``: the same values written into a strided view;
+- the MoE's ``torch.add(routed, shared, out=bf16)`` == ``(routed + shared).to(bf16)`` bit for bit (ties included);
+- ``TF_DSV41_PREFILL_TILES``: parsing and refusals (its bits are a GPU test: tests/cuda/test_dsv41_pf16_gpu.py).
+
+Run: python -m pytest -q tests/test_dsv41_pf16.py
+"""
+
+from __future__ import annotations
+
+import json
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import prefill_mm as PM  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.slots import SlotsForward  # noqa: E402
+
+IDS = torch.randint(0, 256, (37,), generator=torch.Generator().manual_seed(29)).tolist()
+
+
+@pytest.fixture(scope="module")
+def ckpt(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41pf16"))
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg)
+
+
+def state(fw) -> dict:
+    s = fw.slots[0]
+    snap = fw.snapshot(0)
+    out = {f"snap.{k}": torch.from_numpy(np.asarray(v)) for k, v in snap.arrays.items()}
+    for L, st in s.comp.items():
+        n = s.pos // next(b.ratio for b in fw.blocks if b.index == L)
+        out[f"comp.{L}"] = st.read(torch.arange(n))
+        out[f"keys.{L}"] = s.ikeys[L].read(torch.arange(n))
+    return out
+
+
+def make(ckpt, rank: int, world: int, comm=None, pchunk: int = 36):
+    root, cfg, table = ckpt
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), rank, world).load(token_map=tmap)
+    rows = {L: EH.MemoryRows(a, b) for L, (a, b) in table.items()}
+    fw = SlotsForward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), comm=comm, limit=96,
+                      chunk=4, pchunk=pchunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap))
+    fw.gather_bf16 = True               # prod's TF_DSV41_PREFILL_GATHER=bf16: the path the bf16 producers serve
+    fw.decode_bf16 = False              # verify rows: the fp32 path (the decode bf16 lever has its own tests)
+    return fw
+
+
+def pair_run(ckpt, copies: bool, monkeypatch, pchunk: int = 36):
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")      # the fast tag (tests/conftest.py defaults to exact)
+    monkeypatch.setenv("TF_DSV41_PF_COPIES", "1" if copies else "0")
+    pair = FK.ThreadPair()
+    comms = pair.comms()
+    fws = [make(ckpt, r, 2, comms[r], pchunk) for r in range(2)]
+    seen: list = []
+    real = fws[0].gather_partials
+
+    def spy(partial, wide=False):
+        if not wide:                    # the embedding's allsum is wide fp32 by design
+            seen.append((partial.shape[0], partial.dtype))
+        return real(partial, wide)
+
+    fws[0].gather_partials = spy
+
+    def go(fw):
+        fw.prefill([Piece(0, 0, tuple(IDS[:-1]))])
+        return fw.step([IDS[-1]]), state(fw)
+
+    return pair.run([lambda f=f: go(f) for f in fws]), seen
+
+
+@pytest.mark.parametrize("pchunk", [36, 8])
+def test_copies_tp2_same_bits(ckpt, monkeypatch, pchunk):
+    """TP=2, bf16 prefill exchanges: TF_DSV41_PF_COPIES=1 == 0 (logits of the verify row after the prompt, every
+    stored state of both ranks), one 36-row segment and 8-row segments; with it on, the prefill segments' partials
+    reach the exchange as bf16 (wo_b's store, the MoE's add), and verify rows keep fp32."""
+
+    got, seen = pair_run(ckpt, True, monkeypatch, pchunk)
+    want, seen0 = pair_run(ckpt, False, monkeypatch, 36)
+    pf = [d for n, d in seen if n > 4]
+    assert pf and all(d == torch.bfloat16 for d in pf)
+    assert all(d == torch.float32 for n, d in seen0 if n > 4)
+    assert all(d == torch.float32 for n, d in seen if n <= 4)
+    for (lg, st), (lw, sw) in zip(got, want):
+        assert torch.equal(lg, lw)
+        for k in sw:
+            assert torch.equal(st[k], sw[k]), k
+
+
+def test_copies_one_rank_same_bits(ckpt, monkeypatch):
+    """World 1 (no exchange, so only the copy trims apply): copies on == off, bit for bit."""
+
+    from tensorfold.families.deepseek_v41.cuda import blocks as B
+
+    out, calls = {}, []
+    real = B._out_pf
+    monkeypatch.setattr(B, "_out_pf", lambda *a: calls.append(a[2]) or real(*a))
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    for copies in (False, True):
+        monkeypatch.setenv("TF_DSV41_PF_COPIES", "1" if copies else "0")
+        fw = make(ckpt, 0, 1)
+        fw.prefill([Piece(0, 0, tuple(IDS[:-1]))])
+        out[copies] = (fw.step([IDS[-1]]), state(fw))
+        assert bool(calls) is copies and all(n == len(IDS) - 1 for n in calls)     # prefill rows only
+    assert torch.equal(out[True][0], out[False][0])
+    for k, v in out[False][1].items():
+        assert torch.equal(out[True][1][k], v), k
+
+
+def test_copies_knob(monkeypatch):
+    monkeypatch.delenv("TF_DSV41_PF_COPIES", raising=False)
+    assert not PM.copies()
+    for v, want in (("1", True), ("0", False), ("off", False), ("on", True)):
+        monkeypatch.setenv("TF_DSV41_PF_COPIES", v)
+        assert PM.copies() is want
+
+
+def test_fastlinear_out_view():
+    """FastLinear(out=) writes the very values of the plain call into a strided view, fast and decode modes."""
+
+    from tensorfold.families.deepseek_v41.cuda import linear as LN
+
+    g = torch.Generator().manual_seed(3)
+    lin = PM.FastLinear(LN.Dense(torch.randn((24, 16), generator=g, dtype=torch.float64)))
+    x = torch.randn((5, 24), generator=g).to(torch.bfloat16)
+    for on in (False, True):
+        with PM.fast(on):
+            want = lin(x, torch.bfloat16)
+            z = torch.full((5, 40), 7.0, dtype=torch.bfloat16)
+            got = lin(x, torch.bfloat16, out=z[:, 8:24])
+            assert got.data_ptr() == z[:, 8:24].data_ptr()
+            assert torch.equal(z[:, 8:24], want)
+            assert torch.equal(z[:, :8], torch.full((5, 8), 7.0, dtype=torch.bfloat16))
+            assert torch.equal(z[:, 24:], torch.full((5, 16), 7.0, dtype=torch.bfloat16))
+
+
+def test_add_out_bf16_equals_add_then_cast():
+    """The MoE partial under TF_DSV41_PF_COPIES: torch.add(a, b, out=bf16) == (a + b).to(bf16) bit for bit, ties to
+    even included (values built so a + b lands exactly halfway between two bf16 values)."""
+
+    g = torch.Generator().manual_seed(11)
+    a = torch.randn(4096, generator=g) * 3
+    b = torch.randn(4096, generator=g)
+    hb = a.to(torch.bfloat16).float()
+    half = (hb.view(torch.int32) | 0x8000).view(torch.float32)        # exactly between two bf16 neighbours
+    a = torch.cat([a, half, -half, torch.tensor([0.0, -0.0, 1e-40, float("inf")])])
+    b = torch.cat([b, torch.zeros(4096), torch.zeros(4096), torch.tensor([-0.0, -0.0, 0.0, 1.0])])
+    out = torch.empty(a.shape, dtype=torch.bfloat16)
+    torch.add(a, b, out=out)
+    want = (a + b).to(torch.bfloat16)
+    assert torch.equal(out.view(torch.int16), want.view(torch.int16))
+
+
+def test_prefill_tiles_knob(monkeypatch):
+    from tensorfold.cuda.exl3 import prefill as P
+
+    monkeypatch.delenv("TF_DSV41_PREFILL_TILES", raising=False)
+    assert PM.gemm_tiles(5120, 1280) == P.tiles(5120, 1280)
+    monkeypatch.setenv("TF_DSV41_PREFILL_TILES", "128,64,8,3,8")
+    assert PM.gemm_tiles(5120, 1280) == (128, 64, 8, 3, 8)
+    for bad in ("128,64,8,3", "96,32,8,4,8", "128,48,8,4,8", "128,32,2,4,8", "128,32,8,9,8", "a,b,c,d,e"):
+        monkeypatch.setenv("TF_DSV41_PREFILL_TILES", bad)
+        with pytest.raises(ValueError):
+            PM.gemm_tiles(5120, 1280)
+    monkeypatch.setenv("TF_DSV41_PREFILL_TILES", "128,64,8,3,8")
+    with pytest.raises(ValueError):
+        PM.gemm_tiles(1056, 1280)                       # BK must divide K
