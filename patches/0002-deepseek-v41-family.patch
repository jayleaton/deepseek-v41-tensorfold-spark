+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""``x3tc``'s kernels compile for sm_121a without a GPU at the model's shapes (3- and 2-bit experts, with and
+without the inline-PTX byte sum) at the default ``TF_DSV41_TC_CFG``: no register spills, shared memory within the
+GB10's 99 KiB a block, tensor-core mma in both, dp4a only where asked."""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+if os.environ.get("TRITON_INTERPRET") == "1":
+    pytest.skip("compiles need Triton's compiler (unset TRITON_INTERPRET)", allow_module_level=True)
+pytest.importorskip("triton")
+try:
+    import dsv41_x3tc_ptx as P
+    P.ptxas  # noqa: B018
+    from triton.backends.nvidia import compiler as _nvc  # noqa: F401
+except Exception as exc:                                   # noqa: BLE001
+    pytest.skip(f"no Triton CUDA backend: {exc}", allow_module_level=True)
+
+
+def test_x3tc_compiles_for_sm121():
+    got = P.run()
+    assert len(got) == 8
+    for name, v in got.items():
+        assert v["spill"] == 0, (name, v)
+        assert v["smem"] <= P.SMEM, (name, v)
+        assert v["mma"], name
+        assert v["dp4a"] == name.endswith("_asm"), name
