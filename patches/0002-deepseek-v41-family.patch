+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16 4K on the GPU (collected only where PyTorch sees an NVIDIA GPU; scripts/windows/g16chunk4k.sh runs it):
+
+- x3gm's 4K tiles (128-member passes, deeper rings: ``x3gm.GU_TILES`` / ``DN_TILES`` 2..) == the G6 tiles bit for bit
+  at 4,096-row blocks, with the target's widths (D 5,120, I 1,152 a rank) and with 384 experts (~64 members each),
+  one or two rotated inputs, 2- and 3-bit; a 4,096-row block == two 2,048-row blocks == 64-row blocks;
+- the 4,096-row block in the scratch arena (``moe.arena_scratch``'s layout at 1,024 rows x 7 slots): one block, the
+  fresh buffers' bits;
+- the router (split, gemv: 2,048-row launches) on a 4,096-row window == its two halves;
+- the whole forward on the synthetic checkpoint with the compiled kernels: 4,096-row segments == 2,048-row ones
+  (full and replay, the fast kernels with gm, TF_DSV41_PF_4K=1 acknowledged: the stash trim and the Engram sub-reads
+  on) == 1,024-row ones, logits and replies bit for bit;
+- the tile timing of every configuration at 4,096 rows (printed ``[G16 4K]``; ``gmbench --sweep`` writes the table).
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_chunk4k_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.families.deepseek_v41.cuda import x3gm
+from tensorfold.families.deepseek_v41.cuda.weights import X3Stack
+
+DEV = "cuda"
+S = 6
+
+
+def _stack(E, k, n, bits, seed, suh=None):
+    g = np.random.default_rng(seed)
+    t = torch.from_numpy(g.integers(-32768, 32768, size=(E, k // 16, n // 16, 16 * bits), dtype=np.int64)
+                         .astype(np.int16)).contiguous()
+    if suh is None:
+        suh = torch.from_numpy((g.choice([-1.0, 1.0], size=(E, k)) * g.uniform(0.5, 1.5, (E, k))).astype(np.float16))
+    svh = torch.from_numpy((g.choice([-1.0, 1.0], size=(E, n)) * g.uniform(0.002, 0.004, (E, n))).astype(np.float16))
+    return X3Stack(t.to(DEV), suh.to(DEV), svh.to(DEV), "mul1")
+
+
+def _layer(E, D, I, bits_gu=3, bits_d=3, shx=False):
+    gate = _stack(E, D, I, bits_gu, 1)
+    up = _stack(E, D, I, bits_gu, 2, suh=gate.suh.cpu() if shx else None)
+    return gate, up, _stack(E, I, D, bits_d, 3)
+
+
+def _inputs(R, E, D, seed, popular=True):
+    gen = torch.Generator().manual_seed(seed)
+    x = (torch.randn(R, D, generator=gen) * 0.5).to(torch.bfloat16)
+    pick = torch.stack([torch.randperm(E, generator=gen)[:S] for _ in range(R)]).to(torch.int32)
+    if popular:                                             # expert 2 in every row (distinct experts a row)
+        rest = torch.tensor([e for e in range(E) if e != 2], dtype=torch.int32)
+        pick = torch.stack([torch.cat([torch.tensor([2], dtype=torch.int32),
+                                       rest[torch.randperm(E - 1, generator=gen)[:S - 1]]]) for _ in range(R)])
+    w = (torch.rand(R, S, generator=gen) + 0.2).to(torch.float16).to(torch.float32)
+    return x.to(DEV), pick.to(DEV), w.to(DEV)
+
+
+def _cfg(**kw):
+    c = x3gm.config({})
+    c.update(kw)
+    return c
+
+
+SHAPES = [  # (E, D, I, bits gate/up, bits down, shx): the target's widths; 384 experts (~64 members at 4,096 rows)
+    (48, 5120, 1152, 3, 3, False),
+    (48, 5120, 1152, 2, 3, True),
+    (384, 1024, 384, 3, 3, False),
+]
+
+
+@pytest.mark.parametrize("E,D,I,bgu,bd,shx", SHAPES)
+def test_4k_tiles_same_bits_as_g6(E, D, I, bgu, bd, shx):
+    layer = _layer(E, D, I, bgu, bd, shx)
+    x, pick, w = _inputs(4096, E, D, 11, popular=E < 100)
+    g6 = (0 if shx else 1, 0)
+    want = x3gm.run(x, pick, w, *layer, 10.0, cfg=_cfg(gu=g6[0], dn=g6[1], rows=4096))
+    assert torch.isfinite(want).all()
+    k2 = 2 * bgu
+    for gu in x3gm.GU_TILES:
+        if not x3gm.fits("gu", gu, k2, 1 if shx else 2):
+            continue
+        got = x3gm.run(x, pick, w, *layer, 10.0, cfg=_cfg(gu=gu, dn=g6[1], rows=4096))
+        assert torch.equal(got, want), ("gu", gu)
+    for dn in x3gm.DN_TILES:
+        got = x3gm.run(x, pick, w, *layer, 10.0, cfg=_cfg(gu=g6[0], dn=dn, rows=4096))
+        assert torch.equal(got, want), ("dn", dn)
+    tuned = x3gm.run(x, pick, w, *layer, 10.0, cfg=_cfg(rows=4096))           # the tuning table's 4K pair
+    assert torch.equal(tuned, want)
+    for rows in (2048, 64):                                                     # blocks: the rows' bits only
+        assert torch.equal(x3gm.run(x, pick, w, *layer, 10.0, cfg=_cfg(rows=rows)), want), rows
+    sub = [0, 5, 2047, 2048, 4095]
+    assert torch.equal(x3gm.run(x[sub], pick[sub], w[sub], *layer, 10.0, cfg=_cfg(rows=4096)), want[sub])
+
+
+class _Arena:
+    def __init__(self, nbytes):
+        self.arena = torch.empty((nbytes,), dtype=torch.uint8, device=DEV)
+
+
+def test_arena_4096_block_same_bits():
+    from tensorfold.families.deepseek_v41.cuda import moe
+
+    E, D, I = 48, 5120, 1152
+    layer = _layer(E, D, I)
+    x, pick, w = _inputs(4096, E, D, 13)
+    s = _Arena(moe.arena_bytes(1024, S + 1, D, I))
+    s.arena.fill_(0xFF)                                                        # NaN garbage: every read is written
+    b = x3gm.Buffers(s, 4096, 4096, S, D, I, 2, DEV)
+    assert b.aliased and b.rows == 4096
+    want = x3gm.run(x, pick, w, *layer, 10.0, cfg=_cfg(rows=4096))
+    got = x3gm.run(x, pick, w, *layer, 10.0, cfg=_cfg(rows=4096), scratch=s)
+    assert torch.equal(got, want)
+
