@@ -0,0 +1,252 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DeepSeek-V4.1-Flash's engine contract on two CPU ranks (threads; the torch twins of the kernels): rank 0's
+``generate`` and rank 1's ``follow`` agree through the shared header and prompt, greedy replies equal the forward's
+serial argmax decode, keyed sampling repeats per seed, EOS / max_tokens / a client stop end both ranks at the same
+token, and the family's ``check`` / ``cuda_engine`` refuse what they do not serve."""
+
+from __future__ import annotations
+
+import json
+import threading
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.engine.exact_sampling import Sampling  # noqa: E402
+from tensorfold.families import deepseek_v41 as family  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import engine as E  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import numerics as N  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+
+PROMPT = torch.randint(3, 256, (19,), generator=torch.Generator().manual_seed(5)).tolist()
+
+
+@pytest.fixture(scope="module")
+def model(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41e"))
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    eng = FK.write_engram(root / "engram", cfg, FK.engram_table(cfg), world=2)
+    tm = root / "token_map.json"
+    tm.write_text(json.dumps(FK.token_map(cfg)))
+    return root, cfg, eng, tm
+
+
+@pytest.fixture
+def pair(model, monkeypatch):
+    """Two engines on threads; rank 1 follows until the pair is closed."""
+
+    root, cfg, eng, tm = model
+    monkeypatch.setenv("TF_DSV41_ENGRAM_DIR", str(eng))
+    monkeypatch.setenv("TF_DSV41_TOKEN_MAP", str(tm))
+    monkeypatch.setenv("TF_DSV41_CHUNK", "8")
+    monkeypatch.delenv("TF_DSV41_PREPARED", raising=False)
+    tp = FK.ThreadPair()
+    comms = tp.comms()
+    made = tp.run([lambda r=r: E.Dsv41Engine(root, rank=r, master="", port=0, context=64, comm=comms[r],
+                                             device="cpu", serving=False) for r in range(2)])
+    t = threading.Thread(target=lambda: _quiet(made[1].follow), daemon=True)
+    t.start()
+    yield made[0]
+    tp.bar.abort()
+    t.join(timeout=10)
+
+
+def _quiet(fn):
+    try:
+        fn()
+    except threading.BrokenBarrierError:
+        pass
+
+
+def serial_greedy(model, n: int) -> list[int]:
+    root, cfg, eng, tm = model
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+    from tensorfold.families.deepseek_v41.cuda import forward as FW
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+    from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin
+
+    tp = FK.ThreadPair()
+    comms = tp.comms()
+    tmap = FK.token_map(cfg)
+
+    def one(r):
+        tree = W.Loader(cfg, W.Shards(root), r, 2).load(token_map=tmap)
+        rows = EH.open_shards(eng, r, 2, cfg.engram_layer_ids, dim=cfg.engram_head_dim)
+        fw = FW.Forward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), comm=comms[r], limit=64,
+                        chunk=8, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap))
+        lg = fw.prompt(PROMPT)
+        out = []
+        for _ in range(n):
+            out.append(int(FW.greedy(fw, lg)[0]))
+            lg = fw.step([out[-1]])
+        return out
+
+    a, b = tp.run([lambda r=r: one(r) for r in range(2)])
+    assert a == b
+    return a
+
+
+def test_greedy_reply_is_the_serial_argmax_decode(pair, model):
+    got = []
+    stats = pair.generate(PROMPT, 7, None, lambda new: got.extend(new) and False, stop_eos=False)
+    assert got == serial_greedy(model, 7)
+    assert stats["completion_tokens"] == 7 and stats["finish_reason"] == "length"
+    again = []
+    pair.generate(PROMPT, 7, None, lambda new: again.extend(new) and False, stop_eos=False)
+    assert again == got                     # a fresh prefill: no state carried between requests
+
+
+def test_sampling_is_keyed(pair):
+    def reply(seed):
+        out = []
+        pair.generate(PROMPT, 6, Sampling(seed, 0.9, 20, 0.95), lambda new: out.extend(new) and False,
+                      stop_eos=False)
+        return out
+
+    a, b, c = reply(1), reply(1), reply(2)
+    assert a == b and len(a) == 6
+    assert a != c or len(set(a)) == 1        # another seed draws differently (overwhelmingly)
+
+
+def test_client_stop_ends_both_ranks(pair):
+    out = []
+    stats = pair.generate(PROMPT, 20, None, lambda new: out.extend(new) or len(out) >= 3, stop_eos=False)
+    assert stats["finish_reason"] == "client" and len(out) == 3
+    after = []
+    pair.generate(PROMPT, 2, None, lambda new: after.extend(new) and False, stop_eos=False)
+    assert len(after) == 2                   # rank 1 is still in step
+
+
+def test_eos_and_limits(pair):
+    first = []
+    pair.generate(PROMPT, 1, None, lambda new: first.extend(new) and False, stop_eos=False)
+    pair.eos = (first[0],)                   # make the first token an end of sequence
+    out = []
+    stats = pair.generate(PROMPT, 5, None, lambda new: out.extend(new) and False, stop_eos=True)
+    assert out == first and stats["finish_reason"] == "stop"
+    with pytest.raises(ValueError):
+        pair.generate(list(range(64)), 1, None, lambda new: False)
+
+
+def test_family_check_and_engine_factory(model, tmp_path):
+    root = model[0]
+    assert family.check(root) is None
+    bad = tmp_path / "m"
+    bad.mkdir()
+    cfg = json.loads((root / "config.json").read_text())
+    (bad / "config.json").write_text(json.dumps({**cfg, "quantization_config": {"quant_method": "fp8"}}))
+    with pytest.raises(ValueError, match="EXL3"):
+        family.check(bad)
+    (bad / "config.json").write_text(json.dumps({**cfg, "model_type": "deepseek_v4"}))
+    with pytest.raises(ValueError, match="deepseek_v41"):
+        family.check(bad)
+    with pytest.raises(ValueError, match="two ranks"):
+        family.cuda_engine(root, tp=1)
+    assert "TF_DSV41_ENGRAM_DIR" in family.KNOBS and family.CUDA_KV_DTYPES == ("fp8",)
+
+
+def test_exact_mode_is_scoped():
+    before = (N.ACT, N.ACC, N.QUANT)
+    with N.exact():
+        assert N.ACT == torch.float64 and not N.QUANT
+    assert (N.ACT, N.ACC, N.QUANT) == before
+
+
+def test_m1_gate_harness(model, monkeypatch, tmp_path):
+    """The M1 gate script end to end on two CPU ranks against an oracle made of our own one-rank argmax: 100% top-1,
+    the first copy found, rows invariant, a report written."""
+
+    from types import SimpleNamespace
+
+    from tensorfold.families.deepseek_v41.cuda import gate
+
+    root, cfg, eng, tm = model
+    monkeypatch.setenv("TF_DSV41_ENGRAM_DIR", str(eng))
+    monkeypatch.setenv("TF_DSV41_TOKEN_MAP", str(tm))
+    monkeypatch.setenv("TF_DSV41_CHUNK", "8")
+    text = [9, 40, 77, 120, 33, 18, 250, 64, 5]
+    ids = ([0] + text * 4)[:30]
+    want = serial_greedy_rows(model, ids)
+    capture = {"prompts": [{"ids": ids, "positions": [None] + [{"token": ids[i], "top": [[want[i - 1], -0.5]]}
+                                                              for i in range(1, len(ids))]}]}
+    cap = tmp_path / "cap.json"
+    cap.write_text(json.dumps(capture))
+    tp = FK.ThreadPair()
+    comms = tp.comms()
+    args = [SimpleNamespace(model=str(root), rank=r, master="", port=0, capture=str(cap), out=str(tmp_path / "r.json"),
+                            decode=4, prompts=8, context=64) for r in range(2)]
+    tp.run([lambda r=r: gate.run(args[r], comm=comms[r], device="cpu") for r in range(2)])
+    rep = json.loads((tmp_path / "r.json").read_text())
+    assert rep["top1_agreement"] == 1.0 and rep["kit_top1_in_our_top5"] == 1.0
+    assert rep["prompts"][0]["first_copy"] == len(text) and rep["prompts"][0]["top1_first_copy"] == 1.0
+    assert rep["row_invariance"] == {"windows_of_8": True, "one_row": True, "rows": 19}
+    assert len(rep["prompts"][0]["greedy_reply"]) == 4 and rep["gates"]["row_invariance"]
+
+
+def serial_greedy_rows(model, ids) -> list[int]:
+    """The two-rank argmax after every position of ``ids`` (one prefill window)."""
+
+    root, cfg, eng, tm = model
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+    from tensorfold.families.deepseek_v41.cuda import forward as FW
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+    from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin
+
+    tp = FK.ThreadPair()
+    comms = tp.comms()
+    tmap = FK.token_map(cfg)
+
+    def one(r):
+        tree = W.Loader(cfg, W.Shards(root), r, 2).load(token_map=tmap)
+        rows = EH.open_shards(eng, r, 2, cfg.engram_layer_ids, dim=cfg.engram_head_dim)
+        fw = FW.Forward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), comm=comms[r], limit=64,
+                        chunk=len(ids), engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap))
+        return FW.greedy(fw, fw.step(ids)).tolist()
+
+    a, b = tp.run([lambda r=r: one(r) for r in range(2)])
+    return a
+
+
+def test_serving_engine_two_ranks(tmp_path, monkeypatch):
+    """The default engine: SlotsForward on the KV pool behind stack.build's batcher, rank 0's generate through
+    batch.generate_request, rank 1 in batch.follow; the greedy reply == the one-slot serial path's."""
+
+    shapes = dict(num_attention_heads=16, head_dim=512, qk_rope_head_dim=64, o_groups=2, o_lora_rank=128,
+                  index_n_heads=32, index_head_dim=128, sliding_window=128, rms_norm_eps=1e-20)
+    root = FK.write_checkpoint(tmp_path / "m", **shapes)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    eng = FK.write_engram(root / "engram", cfg, FK.engram_table(cfg), world=2)
+    tm = root / "token_map.json"
+    tm.write_text(json.dumps(FK.token_map(cfg)))
+    for k, v in {"TF_DSV41_ENGRAM_DIR": str(eng), "TF_DSV41_TOKEN_MAP": str(tm), "TF_DSV41_CHUNK": "32",
+                 "TF_DSV41_GRAMMAR": "0", "TF_DSV41_PACK": "none", "TF_DSV41_POOL_TOKENS": "1024"}.items():
+        monkeypatch.setenv(k, v)
+    monkeypatch.delenv("TF_DSV41_PREPARED", raising=False)
+    monkeypatch.delenv("TF_DSV41_SESSION_DISK", raising=False)
+
+    def pair_of(serving):
+        tp = FK.ThreadPair()
+        comms = tp.comms()
+        made = tp.run([lambda r=r: E.Dsv41Engine(root, rank=r, master="", port=0, context=256, comm=comms[r],
+                                                 device="cpu", serving=serving) for r in range(2)])
+        t = threading.Thread(target=lambda: _quiet(made[1].follow), daemon=True)
+        t.start()
+        return tp, made, t
+
+    tp, made, t = pair_of(True)
+    assert made[0].batch is not None and made[1].batch is not None
+    got: list[int] = []
+    made[0].generate(PROMPT[:15], 5, None, lambda new: got.extend(new) or False, stop_eos=False)
+    made[0].batch.stop()                  # the round thread first: it shares the communicator
+    made[0].batch.send_stop()
+    t.join(timeout=60)
+    tp2, ref, t2 = pair_of(False)
+    want: list[int] = []
+    ref[0].generate(PROMPT[:15], 5, None, lambda new: want.extend(new) or False, stop_eos=False)
+    tp2.bar.abort()
+    assert got == want and len(got) == 5
diff --git a/tests/test_dsv41_engram_gate.py b/tests/test_dsv41_engram_gate.py
