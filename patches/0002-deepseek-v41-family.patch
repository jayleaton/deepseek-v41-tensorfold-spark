+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G14: the calibration's cache key and its timing method (``calib.py``), on the CPU.
+
+- every ``TF_DSV41_*`` / ``GLM53_TF_ROCE_*`` name the DeepSeek-V4.1 family, the RoCE transport or the communicator
+  reads is either a cache-key knob (``calib.KNOBS``: it changes a window's or the DSpark pass's time, so a table
+  measured under another value is not reused) or exempt with a reason (``calib.NOT_KNOBS``). A new knob in neither
+  list fails here until it is placed;
+- ``method``'s knobs parse, and the G14 (``TF_DSV41_CALIB_SHAPE=fit``) and G13 rules are still reachable;
+- ``measure`` against a fake forward on a virtual clock: a transient at the sweep's start (the first windows timed
+  after the prefill run slow, as G14a measured on every config) no longer sets the 1-row entry, where the G13 rule
+  (best of 3 after 1 warm-up) took it; the recheck after the sweep covers a transient longer than the warm-ups;
+- G15 (VERSION 4): every row's table entry is its own measured window. A fake forward with G14's measured curve
+  (concave over 1-8 rows, steps at 9 and 13) shows VERSION 3's fitted 2-row entry +1.2 ms high where VERSION 4 reads
+  it exactly. A forward whose light windows run slow for 7 windows after heavier work (the decay G14's samples show)
+  defeats G14's method at 1 row and not G15's warmed, interleaved cycles; with G14's measured rates (a slow mode of
+  +0.8 ms, ~60% likely right after load, ~18% settled) G15 reads 1 row high far less often than G14.
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+from tensorfold.families.deepseek_v41.cuda import calib
+
+SRC = Path(calib.__file__).resolve().parents[3]          # src/tensorfold
+LIT = re.compile(r'"((?:TF_DSV41|GLM53_TF_ROCE)_[A-Z0-9_]*)"')
+ENVDEF = re.compile(r'^(\w*ENV\w*)\s*=\s*"((?:TF_DSV41|GLM53_TF_ROCE)_[A-Z0-9_]+)"', re.M)
+COMP = re.compile(r'(\w*ENV\w*)\s*\+\s*"(_[A-Z0-9_]+)"|\{(\w*ENV\w*)\}(_[A-Z0-9_]+)')
+PRUNE = ("TF_DSV41_EXPERT_", "TF_DSV41_DRAFT_EXPERT_")       # prune.py's rule prefixes (+ MIN_K / MIN_W / TOPP)
+BENCH = re.compile(r"(bench|probe)\.py$")                   # A/B tools: their knobs never reach a serving window
+
+
+def names() -> dict:
+    """Every knob name the sources read -> the first file that reads it: string literals, and ``ENV + "_X"`` /
+    ``f"{ENV}_X"`` composites of a module's ``*ENV* = "..."`` constants."""
+
+    files = sorted((SRC / "families" / "deepseek_v41").rglob("*.py"))
+    files += [SRC / "families" / "glm5_next" / "spark" / "roce.py", SRC / "cuda" / "comm.py"]
+    out: dict = {}
+    for f in files:
+        if BENCH.search(f.name):
+            continue
+        t = f.read_text(errors="replace")
+        envs = dict(ENVDEF.findall(t))
+        found = set()
+        for n in LIT.findall(t):
+            if n.endswith("_"):
+                if n in PRUNE:
+                    found |= {n + s for s in ("MIN_K", "MIN_W", "TOPP")}
+                continue                                    # a prefix test (startswith), not a knob
+            found.add(n)
+        for a, b, c, d in COMP.findall(t):
+            v, suffix = (a, b) if a else (c, d)
+            if v in envs:
+                found.add(envs[v] + suffix)
+        for n in found:
+            out.setdefault(n, str(f.relative_to(SRC)))
+    return out
+
+
+def test_every_timing_knob_is_keyed_or_exempt():
+    got = names()
+    assert len(got) > 150                                   # the scan sees the family (a broken regex finds nothing)
+    loose = {n: f for n, f in got.items() if n not in calib.KNOBS and n not in calib.NOT_KNOBS}
+    assert not loose, f"place in calib.KNOBS (a window's time changes) or calib.NOT_KNOBS (with a reason): {loose}"
+    assert not set(calib.KNOBS) & set(calib.NOT_KNOBS)
+    assert len(calib.KNOBS) == len(set(calib.KNOBS))
+    assert all(isinstance(r, str) and r for r in calib.NOT_KNOBS.values())
+
+
+@pytest.mark.parametrize("knob", [
+    "TF_DSV41_MOE_FUSED", "TF_DSV41_MOE_FUSED_SHARED", "TF_DSV41_MOE_FUSED_TAIL",       # the G14 MoE variants
+    "GLM53_TF_ROCE_FAST", "GLM53_TF_ROCE_LEAN", "GLM53_TF_ROCE_POLLERS",               # the G14 exchange levers
+    "TF_DSV41_L2PF", "TF_DSV41_L2PF_MB", "TF_DSV41_L2PF_SITES", "TF_DSV41_L2PF_ROWS",  # L2 prefetch placement
+    "TF_DSV41_L2PF_AT", "TF_DSV41_L2PF_DELAY_US", "TF_DSV41_L2PF_PACE_GBPS",
+    "TF_DSV41_BRANCHES", "TF_DSV41_BRANCHES_PRIO", "TF_DSV41_BRANCHES_ROWS",           # G14 branches
+    "TF_DSV41_MHC_CUDA", "TF_DSV41_ATTN_CUDA", "TF_DSV41_DENSE_V3",                    # prod's levers
+    "TF_DSV41_CALIB_REPS", "TF_DSV41_CALIB_WARM", "TF_DSV41_CALIB_STAT", "TF_DSV41_CALIB_RECHECK",
+    "TF_DSV41_CALIB_SHAPE", "TF_DSV41_CALIB_CYCLE", "TF_DSV41_CALIB_DEEP_REPS",          # G15
+])
+def test_named_knobs_change_the_key(knob):
+    assert knob in calib.KNOBS
+    a = calib.cache_key("img", {"slots": 4}, env={})
+    assert calib.cache_key("img", {"slots": 4}, env={knob: "1"}) != a
+
+
+def test_method():
+    assert calib.method({}) == {"reps": 5, "warm": 3, "stat": "median", "recheck": 4, "shape": "raw", "cycle": 4,
+                                "deep": 5}
+    g14 = calib.method({"TF_DSV41_CALIB_SHAPE": "fit"})
+    assert g14 == {"reps": 5, "warm": 2, "stat": "median", "recheck": 2, "shape": "fit", "cycle": 0, "deep": 3}
+    g13 = {"TF_DSV41_CALIB_SHAPE": "fit", "TF_DSV41_CALIB_REPS": "3", "TF_DSV41_CALIB_WARM": "1",
+           "TF_DSV41_CALIB_STAT": "min", "TF_DSV41_CALIB_RECHECK": "0"}
+    assert calib.method(g13) == {"reps": 3, "warm": 1, "stat": "min", "recheck": 0, "shape": "fit", "cycle": 0,
+                                 "deep": 3}
+    assert calib.method({"TF_DSV41_CALIB_CYCLE": "0", "TF_DSV41_CALIB_DEEP_REPS": "3"})["cycle"] == 0
+    for bad in ({"TF_DSV41_CALIB_STAT": "mean"}, {"TF_DSV41_CALIB_REPS": "0"}, {"TF_DSV41_CALIB_RECHECK": "9"},
+                {"TF_DSV41_CALIB_SHAPE": "line"}, {"TF_DSV41_CALIB_CYCLE": "9"}, {"TF_DSV41_CALIB_DEEP_REPS": "0"}):
+        with pytest.raises(ValueError):
+            calib.method(bad)
+
+
+def test_version_4_keys_apart_from_version_3():
+    assert calib.VERSION == 4                           # G15: every cached VERSION 3 table (fitted) is measured again
+    assert calib.cache_key("img", {"slots": 4}, env={}) != \
+        calib.cache_key("img", {"slots": 4}, env={"TF_DSV41_CALIB_SHAPE": "fit"})
+
+
+def test_statistic():
+    assert calib.statistic([5, 1, 3], "median") == 3 and calib.statistic([4, 1, 3, 2], "median") == 2.5
+    assert calib.statistic([5, 1, 3], "min") == 1
+    with pytest.raises(ValueError):
+        calib.statistic([], "median")
+
+
+def test_monotone_keeps_a_rising_curve_and_pools_dips():
+    assert calib.monotone([23.4, 28.0, 33.3]) == [23.4, 28.0, 33.3]
+    assert calib.monotone([10.0, 12.0, 11.0, 15.0]) == pytest.approx([10.0, 11.5, 11.5, 15.0])
+    assert calib.monotone([5.0, 4.0, 3.0]) == pytest.approx([4.0, 4.0, 4.0])
+    assert calib.monotone([]) == [] and calib.table_of([1.0, 2.0], "raw") == [1.0, 2.0]
+    with pytest.raises(ValueError):
+        calib.table_of([1.0, 2.0, 3.0], "line")
+
+
+# -- measure on a virtual clock ------------------------------------------------------------------------------------
+class Clock:
+    def __init__(self):
+        self.t = 0.0
+
+    def __call__(self):
+        return self.t
+
+
+# G14's measured 1-16 row windows (off, the median of 3 boots' pass medians, slower rank: g14-window.json)
+G14_OFF = [23.43, 28.03, 33.32, 37.52, 42.30, 46.08, 48.62, 52.45, 58.53, 60.62, 62.10, 63.60, 68.49, 70.34, 72.58,
+           73.18]
+
+
+class FakeFw:
+    """A forward whose windows take ``curve[rows - 1]`` ms (default ``20 + 5 x rows``), + ``slow`` ms for:
+
+    - the first ``n_slow`` windows after the second prefill (the calibration's sweep starts there);
+    - with ``decay`` > 0: the ``decay`` windows after the second prefill or after any window of more than 8 rows
+      (light windows after heavier work, as G14's samples show);
+    - with ``rng``: each such window only with probability ``p_hot`` (and any other window with ``p_settled``)."""
+
+    def __init__(self, clock, slow=3.0, n_slow=0, n_late=0, curve=None, decay=0, rng=None, p_hot=1.0,
+                 p_settled=0.0):
+        self.clock, self.slow, self.n_slow, self.n_late = clock, slow, n_slow, n_late
+        self.curve, self.decay, self.rng, self.p_hot, self.p_settled = curve, decay, rng, p_hot, p_settled
+        self.prefills, self.after, self.since, self.drafter = 0, 0, 10 ** 9, None
+        self.calls: list = []
+
+    def reset(self, slot):
+        pass
+
+    def commit(self, slot, n):
+        pass
+
+    def prefill(self, pieces, mode="full"):
+        self.prefills += 1
+        self.since = 0
+
+    def base(self, rows):
+        return self.curve[rows - 1] if self.curve else 20.0 + 5.0 * rows
+
+    def window(self, windows, count=1):
+        rows = sum(len(w.tokens) for w in windows)
+        ms = self.base(rows)
+        if self.prefills >= 2:
+            self.after += 1
+            hot = self.after <= self.n_slow or (self.decay and self.since < self.decay)
+            if self.rng is not None:
+                hot = self.rng.random() < (self.p_hot if hot else self.p_settled)
+            if hot:
+                ms += self.slow
+            self.since = 0 if rows > 8 else self.since + 1
+        self.calls.append(rows)
+        self.clock.t += ms / 1e3
+
+        class C:
+            ids = np.array([[7]])
+
+        return C()
+
+
+def _measure(monkeypatch, fw, how, rows=8):
+    monkeypatch.setattr(calib.time, "perf_counter", fw.clock)
+    rep: dict = {}
+    c = calib.measure(fw, list(range(3, 60)), ensure=lambda s, e: None, gather_max=lambda v: list(v),
+                      sync=lambda: None, rows=rows, how=how, report=rep)
+    return c, rep
+
+
+G13 = {"shape": "fit", "reps": 3, "warm": 1, "stat": "min", "recheck": 0}
+G14 = {"shape": "fit", "reps": 5, "warm": 2, "stat": "median", "recheck": 2}
+G15 = calib.method({})
+
+
+def test_steady_windows_read_the_same_either_way(monkeypatch):
+    for how in (G13, G14, G15):
+        c, rep = _measure(monkeypatch, FakeFw(Clock()), how)
+        assert c.verify[0] == pytest.approx(25.0) and rep["kept"][0] == pytest.approx(25.0)
+
+
+def test_a_start_transient_no_longer_sets_the_1row_entry(monkeypatch):
+    # the first 4 windows of the sweep run 3 ms slow (G14a: 0.5-2.5 ms over the first runs; G13's 31.5 boot)
+    c, _ = _measure(monkeypatch, FakeFw(Clock(), n_slow=4), G13)
+    assert c.verify[0] == pytest.approx(28.0)           # G13's rule: every timed run of row 1 was slow
+    c, rep = _measure(monkeypatch, FakeFw(Clock(), n_slow=4), G14)
+    assert c.verify[0] == pytest.approx(25.0)           # 2 warm-ups, then the median of 5 (2 slow, 3 settled)
+    assert len(rep["samples"][1]) == 5 and len(rep["recheck"][1]) == 5
+    c, rep = _measure(monkeypatch, FakeFw(Clock(), n_slow=4), G15)
+    assert c.verify[:4] == pytest.approx([25.0, 30.0, 35.0, 40.0])  # the 4 slow windows are the 1st warm cycle
+    assert all(len(rep["samples"][r]) == len(rep["recheck"][r]) == 5 for r in range(1, 5))
+
+
+def test_the_recheck_covers_a_longer_transient(monkeypatch):
+    # 8 slow windows: G14's 2 warm-ups and 6 timed ones (all 5 of row 1, the first of row 2): the median is slow
+    c, rep = _measure(monkeypatch, FakeFw(Clock(), n_slow=8), dict(G14, recheck=0))
+    assert c.verify[0] == pytest.approx(28.0)
+    c, rep = _measure(monkeypatch, FakeFw(Clock(), n_slow=8), G14)
+    assert c.verify[0] == pytest.approx(25.0)           # the recheck after the sweep is settled: the lower wins
+    assert rep["samples"][1] == [28.0] * 5 and rep["recheck"][1] == [25.0] * 5
+    # G15: 20 slow windows outlast the 3 warm cycles (12) and 2 timed cycles: every row's median is slow in the
+    # sweep (3 of 5); the recheck block after it is settled and each row keeps it
+    c, rep = _measure(monkeypatch, FakeFw(Clock(), n_slow=20), G15)
+    assert rep["samples"][1] == [28.0, 28.0, 25.0, 25.0, 25.0] and c.verify[:4] == pytest.approx([25, 30, 35, 40])
+    c, rep = _measure(monkeypatch, FakeFw(Clock(), n_slow=24), dict(G15, recheck=0))
+    assert c.verify[0] == pytest.approx(28.0)           # without the recheck, the sweep's slow median stays
+
+
+def test_g14_method_counts(monkeypatch):
+    fw = FakeFw(Clock())
+    _measure(monkeypatch, fw, G14, rows=16)
+    sweep = fw.calls[15:]                               # after the 15 continuation windows (2nd prefill onwards)
+    per = {r: sweep.count(r) for r in range(1, 17)}
+    assert per[1] == per[2] == 2 * 7                    # sweep + recheck, 2 warm-ups + 5 each
+    assert all(per[r] == 7 for r in range(3, 9)) and all(per[r] == 4 for r in range(9, 17))   # 1 + 3 beyond 8
+
+
+def test_g15_method_counts_and_order(monkeypatch):
+    fw = FakeFw(Clock())
+    _measure(monkeypatch, fw, G15, rows=16)
+    sweep = fw.calls[15:]
+    per = {r: sweep.count(r) for r in range(1, 17)}
+    assert all(per[r] == 2 * 8 for r in range(1, 5))    # sweep + recheck, 3 warm cycles + 5 timed each
+    assert all(per[r] == 8 for r in range(5, 9)) and all(per[r] == 6 for r in range(9, 17))   # 3 + 5, 1 + 5
+    assert sweep[:12] == [1, 2, 3, 4] * 3               # interleaved from the start
+    assert sweep[-32:] == [1, 2, 3, 4] * 8              # the recheck: the same cycles, last
+
+
+def test_g15_boot_cost_on_g14s_curve(monkeypatch):
+    """The windows' time (G14's off curve, 1 slot, no DSpark pass): ~2 s more than VERSION 3, under 7 s."""
+
+    def cost(how):
+        fw = FakeFw(Clock(), curve=G14_OFF)
+        monkeypatch.setattr(calib.time, "perf_counter", fw.clock)
+        calib.measure(fw, list(range(3, 60)), ensure=lambda s, e: None, gather_max=lambda v: list(v),
+                      sync=lambda: None, rows=16, how=how)
+        return sum(G14_OFF[r - 1] for r in fw.calls[15:]) / 1e3
+
+    old, new = cost(G14), cost(G15)
+    assert 4.5 < old < 4.9 and 6.4 < new < 7.0 and new - old < 2.5
+
+
+def test_a_fitted_2row_entry_would_be_wrong(monkeypatch):
+    """G14's measured curve is concave over 1-8 rows and steps at 9 and 13: VERSION 3's fitted 2-row entry reads it
+    +1.2 ms high (G14: +1.1-1.4 ms in every config), and rows 7-8 / 9-14 off by +1 / -2 ms. VERSION 4 reads every
+    row as measured."""
+
+    old, _ = _measure(monkeypatch, FakeFw(Clock(), curve=G14_OFF), G14, rows=16)
+    new, _ = _measure(monkeypatch, FakeFw(Clock(), curve=G14_OFF), G15, rows=16)
+    assert old.verify[0] == pytest.approx(G14_OFF[0]) and new.verify[0] == pytest.approx(G14_OFF[0])
+    assert old.verify[1] - G14_OFF[1] == pytest.approx(1.2, abs=0.15)                 # the bias G14 found
+    assert old.verify[7] - G14_OFF[7] > 0.9 and old.verify[8] - G14_OFF[8] < -1.5    # 8 rows high, 9 rows low
+    assert new.verify[:16] == pytest.approx(G14_OFF)                                  # every row as measured
+    # what the depth policy sees: the second row's price (2-row window - 1-row window)
+    assert new.window_ms(2) - new.window_ms(1) == pytest.approx(4.60, abs=0.01)
+    assert old.window_ms(2) - old.window_ms(1) > 5.7
+
+
+def test_a_measured_dip_stays_monotone(monkeypatch):
+    curve = list(G14_OFF)
+    curve[5] = curve[4] - 0.4                           # 6 rows timed below 5 (noise): the two share their mean
+    c, _ = _measure(monkeypatch, FakeFw(Clock(), curve=curve), G15, rows=16)
+    assert c.verify[4] == c.verify[5] == pytest.approx(curve[4] - 0.2)
+    assert all(b >= a for a, b in zip(c.verify, c.verify[1:]))
+
+
+def test_slow_after_heavy_work_defeats_g14_not_g15(monkeypatch):
+    """Light windows run 0.8 ms slow for 7 windows after the prefill or any window of 9+ rows. G14 times row 1 right
+    after the prefill (2 warm-ups + 5) and again right after the 16-row window (the recheck): both blocks slow. G15's
+    3 warm cycles (12 windows) run the decay out before any timed one."""
+
+    c, _ = _measure(monkeypatch, FakeFw(Clock(), slow=0.8, decay=7, curve=G14_OFF), G14, rows=16)
+    assert c.verify[0] == pytest.approx(G14_OFF[0] + 0.8)
+    c, _ = _measure(monkeypatch, FakeFw(Clock(), slow=0.8, decay=7, curve=G14_OFF), G15, rows=16)
+    assert c.verify[:4] == pytest.approx(G14_OFF[:4])
+
+
+def test_g14s_measured_rates_g15_reads_high_far_less(monkeypatch):
+    """G14's samples, as rates: after load a window is slow (+0.8 ms) ~60% of the time for ~4 windows (the 1st and
+    2nd timed runs after G14's 2 warm-ups were high 58-67% / 38-40%), settled ~18%. 400 seeded boots each: how often
+    the 1-row entry reads >= 0.5 ms high. This model gives G14 ~4% (G14 saw 2 of 39 boots) and G15 ~0.1%."""
+
+    def high(how, seed):
+        fw = FakeFw(Clock(), slow=0.8, decay=4, curve=G14_OFF, rng=np.random.default_rng(seed), p_hot=0.6,
+                    p_settled=0.18)
+        c, _ = _measure(monkeypatch, fw, how, rows=16)
+        return c.verify[0] - G14_OFF[0] >= 0.5
+
+    old = sum(high(G14, s) for s in range(400))
+    new = sum(high(G15, s) for s in range(400))
+    assert old >= 8 and new <= 2, (old, new)
+
+
+def test_reps_override_keeps_the_tests_fast(monkeypatch):
+    fw = FakeFw(Clock())
+    monkeypatch.setattr(calib.time, "perf_counter", fw.clock)
+    c = calib.measure(fw, list(range(3, 60)), ensure=lambda s, e: None, gather_max=lambda v: list(v),
+                      sync=lambda: None, rows=4, reps=1, how=G15)
+    assert c.verify[0] == pytest.approx(25.0) and len(c.verify) == 4
