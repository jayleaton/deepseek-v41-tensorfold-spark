@@ -0,0 +1,362 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The gemv router (families/deepseek_v41/cuda/router_gemv.cu, TF_DSV41_ROUTER=gemv) on the CPU: its numpy model is
+the kernel's summation order bit for bit (checked against a scalar loop written from the .cu's description), the
+kernel's lane / ring / staging schedule covers every k of every chain in order (the constants read from the .cu), the
+logits are closer to float64 than split's 5,120-long chain, picks agree with float64 off near-ties, rows are invariant,
+ties go to the lower id, the safe softplus holds at its edges, and E = 128 / top-3 (DSpark). tests/cuda has the
+kernel == model check on the GPU."""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+import pytest
+
+np = pytest.importorskip("numpy")
+torch = pytest.importorskip("torch")
+
+from tensorfold.families.deepseek_v41.cuda import router_gemv as RG
+
+CU = Path(RG.__file__).with_name("router_gemv.cu")
+SMALL = 1024      # statistical tests: the model takes any D % 256 == 0 (the kernel instance is 5,120)
+
+
+def _inputs(R, E, seed, D=RG.D, wscale=0.02):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn((R, D), generator=g).to(torch.bfloat16)
+    w = (torch.randn((E, D), generator=g) * wscale).to(torch.bfloat16).contiguous()
+    b = torch.randn(E, generator=g) * 0.01
+    return x, w, b
+
+
+def _f64_route(x, w, b, topk, scale=1.5):
+    lg = x.double() @ w.double().T
+    s = torch.nn.functional.softplus(lg).sqrt()
+    ch = s + b.double()
+    picks, ws, margins = [], [], []
+    for r in range(x.shape[0]):
+        order = sorted(range(w.shape[0]), key=lambda e: (-float(ch[r, e]), e))
+        c = [float(ch[r, e]) for e in order[:topk + 1]]
+        margins.append(min(c[i] - c[i + 1] for i in range(topk)))
+        sv = s[r, order[:topk]]
+        picks.append(order[:topk])
+        ws.append((scale * sv / sv.sum()).tolist())
+    return np.array(picks), np.array(ws), np.array(margins)
+
+
+def test_constants_match_the_kernel():
+    src = CU.read_text()
+
+    def const(name):
+        return int(re.search(rf"constexpr int {name} = (\d+);", src).group(1))
+
+    assert (const("NV"), const("JC"), const("EPL"), const("KMAX")) == (RG.NV, RG.JC, RG.EPL, RG.KMAX)
+    assert "constexpr int PD = 8 / EW;" in src and RG.ring_depth(1) == 8 and RG.ring_depth(2) == 4
+    assert "for (int o = 16; o > 0; o >>= 1) v = __fadd_rn(v, __shfl_xor_sync(0xffffffffu, v, o));" in src
+    assert "acc[e][r] = __fmaf_rn(xf[i], wf[e][i], acc[e][r]);" in src
+
+
+def test_model_is_the_scalar_chain_bit_for_bit():
+    """Lane l: acc = fma(x_k, w_k, acc) from +0.0 for k = 8 (l + 32 j) + i, j then i ascending; then the butterfly
+    v_l = v_l + v_(l xor o), o = 16 .. 1. bf16 x bf16 products are exact in fp32, so fma == fp32(product) + acc here."""
+
+    x, w, _ = _inputs(2, 3, 1)
+    got = RG.model_logits(x, w)
+    xf, wf = x.float().numpy(), w.float().numpy()
+    for r in range(2):
+        for e in range(3):
+            vals = []
+            for lane in range(32):
+                acc = np.float32(0.0)
+                for j in range(RG.NV):
+                    for i in range(8):
+                        k = 8 * (lane + 32 * j) + i
+                        p = np.float32(xf[r, k]) * np.float32(wf[e, k])
+                        assert float(p) == float(xf[r, k]) * float(wf[e, k])        # exact product
+                        acc = np.float32(acc + p)
+                vals.append(acc)
+            for o in (16, 8, 4, 2, 1):
+                vals = [np.float32(vals[lane] + vals[lane ^ o]) for lane in range(32)]
+            assert len({v.view(np.int32).item() for v in vals}) == 1                  # every lane the same bits
+            assert vals[0].view(np.int32) == got[r, e].view(np.int32), (r, e)
+
+
+def test_lane_order_is_a_permutation_ascending_a_lane():
+    order = RG.lane_order()
+    assert sorted(order.ravel().tolist()) == list(range(RG.D))
+    assert all((np.diff(order[lane]) > 0).all() for lane in range(32))
+
+
+@pytest.mark.parametrize("rt", RG.TILES)
+@pytest.mark.parametrize("nw,ew", RG.CFGS)
+def test_kernel_schedule(rt, nw, ew):
+    """The lane emulator of router_gemv.cu's indices: step j's ring slot holds step j's vector (loaded PD steps
+    before, never overwritten first), lane l consumes vector l + 32 j at shared column 8 (jj 32 + l) of chunk j / JC
+    (= k 8 v exactly), the buffer it reads is the chunk's (c & 1), the one staged at its end is the other, and the
+    staging threads write every (row, column) of a chunk exactly once from global k = c CK + column."""
+
+    sch = RG.schedule(rt, nw, ew)
+    assert 2 * rt * RG.CK * 2 + 4 <= 48 * 1024                       # static shared memory
+    order = RG.lane_order()
+    for st in sch["steps"]:
+        j, c = st["j"], st["chunk"]
+        assert st["slot_holds"] == j
+        assert st["buf"] == c & 1
+        for lane in range(32):
+            v = st["vec"][lane]
+            assert v == lane + 32 * j
+            assert c * RG.CK + st["col"][lane] == 8 * v
+            assert order[lane, 8 * j] == 8 * v                        # the chain's next 8 k
+        if j % RG.JC == RG.JC - 1 and c + 1 < sch["nc"]:
+            assert ((c + 1) & 1) != st["buf"]
+    for c, cells in enumerate(sch["stage"]):
+        seen = {(row, col) for _, row, col, _ in cells}
+        assert len(seen) == len(cells) == rt * RG.CK // 8
+        assert seen == {(row, col) for row in range(rt) for col in range(0, RG.CK, 8)}
+        assert all(k == c * RG.CK + col for _, _, col, k in cells)
+        assert max(t for t, *_ in cells) < nw * 32
+
+
+def test_more_accurate_than_the_long_chain():
+    """160-term chains + a 5-level tree vs split's one 5,120-term chain (k ascending FMA), against float64."""
+
+    x, w, _ = _inputs(8, 64, 2)
+    exact = x.double().numpy() @ w.double().numpy().T
+    new = np.abs(RG.model_logits(x, w).astype(np.float64) - exact)
+    xf, wf = x.float().numpy(), w.float().numpy()
+    acc = np.zeros((8, 64), np.float32)
+    for k in range(RG.D):
+        acc = RG.fma32(xf[:, k:k + 1], wf[None, :, k], acc)
+    old = np.abs(acc.astype(np.float64) - exact)
+    assert new.max() <= old.max() and new.mean() < 0.5 * old.mean()
+
+
+@pytest.mark.parametrize("E,topk", [(384, 6), (128, 3)])
+def test_picks_agree_with_float64(E, topk):
+    x, w, b = _inputs(96, E, 3 + E, D=SMALL, wscale=0.05)
+    pick, wts = RG.emulate(x, w, b, topk, True, 1.5)
+    rp, rw, margin = _f64_route(x, w, b, topk)
+    same = (pick[:, :topk].numpy() == rp).all(1)
+    print(f"[G7] gemv model vs float64 picks (E {E}): {same.mean():.4f} of 96 rows; min margin of a differing row "
+          f"{margin[~same].min() if (~same).any() else '-'}")
+    assert same.mean() >= 0.98
+    assert (margin[~same] < 1e-5).all()                              # only float64 near-ties may differ
+    np.testing.assert_allclose(wts[same, :topk].numpy(), rw[same], rtol=2e-5, atol=0)
+    assert (pick[:, topk] == E).all() and (wts[:, topk] == 1.0).all()
+
+
+@pytest.mark.parametrize("E,topk", [(128, 3), (384, 6)])
+def test_rows_invariant(E, topk):
+    N = 24
+    x, w, b = _inputs(N, E, 5, D=SMALL)
+    alone = [RG.emulate(x[r:r + 1], w, b, topk, True, 1.5) for r in range(N)]
+    for R in range(1, 17):
+        for off in sorted({0, min(7, N - R), N - R}):
+            p, q = RG.emulate(x[off:off + R], w, b, topk, True, 1.5)
+            for i in range(R):
+                assert torch.equal(p[i], alone[off + i][0][0])
+                assert torch.equal(q[i].view(torch.int32), alone[off + i][1][0].view(torch.int32))
+
+
+def test_ties_go_to_the_lower_id():
+    E, topk = 128, 3
+    x, w, _ = _inputs(4, E, 7, D=SMALL)
+    w[40] = w[90]
+    w[77] = w[90]
+    b = torch.zeros(E)
+    b[[40, 77, 90]] = 5.0                                            # the three twins lead every row
+    pick, wts = RG.emulate(x, w, b, topk, True, 1.5)
+    assert pick[:, :3].tolist() == [[40, 77, 90]] * 4
+    assert torch.equal(wts[:, 0], wts[:, 1]) and torch.equal(wts[:, 1], wts[:, 2])
+    zero = torch.zeros((2, SMALL), dtype=torch.bfloat16)               # every logit 0, every choice equal
+    p, q = RG.emulate(zero, w, torch.zeros(E), 6, False, 1.5)
+    assert p.tolist() == [list(range(6))] * 2
+    np.testing.assert_allclose(q.numpy(), 0.25, rtol=1e-6)
+
+
+def test_softplus_edges():
+    z = np.array([-100.0, -87.0, -30.0, -16.7, -16.5, -10.5, -10.0, -9.5, 0.0, 5.0, 19.9, 20.0, 20.5, 60.0],
+                 np.float32)
+    got = RG.softplus32(z).astype(np.float64)
+    ref = torch.nn.functional.softplus(torch.from_numpy(z.astype(np.float64))).numpy()
+    assert (got > 0).all()                                           # never 0: the G4 NaN fix (s = 0 for all)
+    tight = (z >= -87) & ((z < -10) | (z > -7)) & (z <= 20)          # -100: e^z is an fp32 subnormal
+    np.testing.assert_allclose(got[tight], ref[tight], rtol=2e-6, atol=0)
+    mid = (z >= -10) & (z <= -7)                                     # log(1 + e^z): router.py's arithmetic kept
+    np.testing.assert_allclose(got[mid], ref[mid], rtol=5e-3, atol=0)
+    assert got[-1] == 60.0 and got[-2] == np.float32(20.5)            # z above 20: z
+
+
+@pytest.mark.parametrize("E,topk", [(384, 6), (128, 3)])
+def test_sink_rows_all_logits_below_underflow(E, topk):
+    """router.py's G4 case: a row reduced to one massive channel, every logit in [-60, -34] (below -16.6, where
+    log(1 + e^z) is 0 in fp32): finite weights, float64's picks and weights."""
+
+    C = 2455
+    g = torch.Generator().manual_seed(0)
+    x = torch.zeros((3, RG.D))
+    x[:, C] = torch.tensor([64.0, 48.0, 32.0])
+    x = x.to(torch.bfloat16)
+    w = torch.randn((E, RG.D), generator=g) * 1e-3
+    w[:, C] = torch.linspace(-60.0, -34.0, E)[torch.randperm(E, generator=g)] / 64.0
+    w = w.to(torch.bfloat16).contiguous()
+    b = torch.randperm(E, generator=g) * 1e-3
+    pick, wts = RG.emulate(x, w, b, topk, True, 1.5)
+    assert bool(torch.isfinite(wts).all())
+    rp, rw, _ = _f64_route(x, w, b, topk)
+    assert (pick[:, :topk].numpy() == rp).all()
+    np.testing.assert_allclose(wts[:, :topk].numpy(), rw, rtol=1e-4, atol=0)
+    np.testing.assert_allclose(wts[:, :topk].double().sum(1).numpy(), 1.5, rtol=1e-6)
+
+
+def test_config_knob():
+    assert RG.parse_cfg("") == (None, None)
+    assert RG.parse_cfg("4,1") == ((4, 1), (4, 1))
+    assert RG.parse_cfg("8,1/8,2") == ((8, 1), (8, 2))
+    for bad in ("3,1", "8", "8,1/8,2/4,1", "x"):
+        with pytest.raises(ValueError):
+            RG.parse_cfg(bad)
+    assert RG.config(384, 3, (None, None)) == (8, 1) and RG.config(128, 3, (None, None)) == (4, 1)
+    assert RG.config(384, 17, (None, None)) == (8, 2)
+    assert [RG.row_tile(r) for r in (1, 2, 3, 5, 9, 16, 17, 2048)] == [1, 2, 4, 8, 16, 16, 16, 16]
+
+
+# -- the narrow kernel and the folded tail (TF_DSV41_RG_NARROW / TF_DSV41_RG_TAIL) ------------------------------------
+def _narrow_src() -> str:
+    src = CU.read_text()
+    return src[src.index("__global__ void __launch_bounds__(NW * 32) narrow_kernel"):src.index("cudaError_t launch_narrow")]
+
+
+def test_narrow_kernel_runs_the_same_chains():
+    """narrow_kernel's arithmetic is gemv_kernel's chain (read from the .cu): lane l pairs gate vector j * 32 + l with
+    x at k = (j * 32 + l) * 8, j ascending over all NV steps, i = 0..7 ascending, one __fmaf_rn chain from 0.0 a row,
+    then the same butterfly; so its logits are model_logits' bits (tests/cuda checks it on the GPU)."""
+
+    src = _narrow_src()
+    assert "acc[r] = __fmaf_rn(xf[i], wf[i], acc[r]);" in src
+    assert "for (int r = 0; r < RT; ++r) acc[r] = 0.0f;" in src
+    assert "for (int o = 16; o > 0; o >>= 1) v = __fadd_rn(v, __shfl_xor_sync(0xffffffffu, v, o));" in src
+    assert "for (int j = 0; j < NV; ++j) {" in src and "for (int i = 0; i < 8; ++i)" in src
+    assert "a.w + (size_t)(live ? e : 0) * D + (size_t)lane * 8" in src and "wrow + (size_t)j * 256" in src
+    assert "(size_t)(j * 32 + lane) * 8" in src                     # x: the same k as the gate vector
+    assert "widen8(wsh[warp][j % PD][lane], wf);" in src            # gate vector j from its slot
+    assert "if (lane == r && r < nr && live) a.lg[(size_t)(r0 + r) * a.E + e] = v;" in src
+    order = RG.lane_order()
+    for j in range(RG.NV):
+        for lane in (0, 5, 31):
+            v = j * 32 + lane                                        # the vector both loads address
+            assert order[lane, 8 * j] == 8 * v and (j * 32 + lane) * 8 == 8 * v
+
+
+@pytest.mark.parametrize("rt", RG.TILES)
+@pytest.mark.parametrize("nw", RG.NARROW_NW)
+def test_narrow_pipeline(rt, nw):
+    """The cp.async pipeline: one group a vector in vector order; wait_group n before step j leaves group j complete
+    (committed - n >= j + 1); the slot read holds vector j; a refill goes to the slot just read, after its read; smem
+    <= 48 KiB and >= the tail's ints."""
+
+    src = CU.read_text()
+    assert "constexpr int PD = NW <= 4 && RT <= 4 ? NV : NV / 2;" in src
+    assert "cp_wait_n(min(NV - j - 1, PD - 1));" in src
+    body = src[src.index("void cp_wait_n(int n)"):src.index("#undef DSV41_RG_W")]
+    cases = {int(k) for k in re.findall(r"DSV41_RG_W\((\d+)\)", body)}
+    pd = RG.narrow_depth(rt, nw)
+    for st in RG.narrow_schedule(rt, nw):
+        j = st["j"]
+        assert st["committed"] - st["wait"] >= j + 1
+        assert st["wait"] in cases                                  # a case of cp_wait_n, not its wait-all default
+        assert st["slot_holds"] == j
+        if st["refill"] is not None:
+            assert st["refill"] % pd == st["slot"] and st["refill"] == j + pd
+    group_ints = 16 * (RG.KMAX + 1) * 2 + 2 * RG.GE_MAX + 8
+    slots = max(pd, -(-group_ints * 4 // (nw * 512)))
+    assert group_ints * 4 <= nw * slots * 512 <= 48 * 1024 - 64
+
+
+def _upstream_group(pick, GE, maxm):
+    """tensorfold/cuda/exl3/experts.cu's group_kernel, transliterated (1,024 threads x 4 experts, scan over threads)."""
+
+    flat = pick.reshape(-1)
+    n, slots = flat.size, pick.shape[1]
+    ids, mem = [], {}
+    for t in range(1024):
+        for q in range(4):
+            e = t * 4 + q
+            if e < GE and (flat == e).any():
+                ids.append(e)
+                js = [(i // slots) * 32 + i % slots for i in range(n) if flat[i] == e][:maxm]
+                mem[e] = js + [-1] * (maxm - len(js))
+    return ids, mem
+
+
+def _group_rows(pick, GE, maxm, T):
+    """router_gemv.cu's group_rows with T threads, transliterated: counts, each thread a contiguous chunk of ids,
+    an exclusive scan of the used flags, ranks in pick order, -1 padding of every used place."""
+
+    psh = pick.reshape(-1)
+    n, slots = psh.size, pick.shape[1]
+    gc = np.zeros(GE, np.int64)
+    for e in psh:
+        if 0 <= e < GE:
+            gc[e] += 1
+    per = -(-GE // T)
+    used = [sum(gc[e] > 0 for e in range(min(GE, t * per), min(GE, min(GE, t * per) + per))) for t in range(T)]
+    gid, gpl, cpl = {}, {}, {}
+    for t in range(T):
+        place = sum(used[:t])
+        lo = min(GE, t * per)
+        for e in range(lo, min(GE, lo + per)):
+            if gc[e] > 0:
+                gid[place], gpl[e], cpl[place] = e, place, gc[e]
+                place += 1
+    total = sum(used)
+    gmem = np.full((total, maxm), 7777, np.int64)
+    for i in range(n):
+        e = psh[i]
+        if 0 <= e < GE:
+            rank = int((psh[:i] == e).sum())
+            if rank < maxm:
+                gmem[gpl[e], rank] = (i // slots) * 32 + i % slots
+    for q in range(total * maxm):
+        if q % maxm >= cpl[q // maxm]:
+            gmem[q // maxm, q % maxm] = -1
+    return [gid[p] for p in range(total)], gmem
+
+
+@pytest.mark.parametrize("T", [32, 64, 128, 256])
+def test_folded_grouping_is_upstreams(T):
+    rng = np.random.default_rng(T)
+    for E, topk, R in ((384, 6, 1), (384, 6, 3), (384, 6, 16), (128, 3, 9), (128, 3, 16)):
+        GE = E + 1
+        pick = np.stack([np.concatenate([rng.choice(E, topk, replace=False), [E]]) for _ in range(R)])
+        if R > 2:
+            pick[1, :topk] = pick[0, :topk]                         # shared ids across rows
+        uid, umem = _upstream_group(pick, GE, R)
+        gid, gmem = _group_rows(pick, GE, R, T)
+        mid, mcount, mmem = RG.model_group(pick, GE, R)
+        assert gid == uid == mid.tolist() and len(gid) == mcount
+        assert all(gmem[p].tolist() == umem[e] == mmem[p].tolist() for p, e in enumerate(gid))
+        assert gid[-1] == E and gmem[-1].tolist() == [r * 32 + topk for r in range(R)]   # the shared entry
+
+
+def test_kit_rounding_model():
+    x, w, b = _inputs(6, 128, 11, D=SMALL)
+    p0, w0 = RG.emulate(x, w, b, 3, True, 1.5)
+    p1, w1 = RG.emulate(x, w, b, 3, True, 1.5, kit=True)
+    assert torch.equal(p0, p1)
+    assert torch.equal(w1, w0.to(torch.float16).to(torch.float32))  # pick.kit_weights of the fp32 weights
+    assert (w1[:, 3] == 1.0).all()
+
+
+def test_narrow_and_tail_knobs():
+    assert RG.parse_narrow("") == 0 and RG.parse_narrow("0") == 0 and RG.parse_narrow("off") == 0
+    assert [RG.parse_narrow(str(n)) for n in (1, 2, 4, 8)] == [1, 2, 4, 8]
+    for bad in ("3", "16", "x"):
+        with pytest.raises(ValueError):
+            RG.parse_narrow(bad)
+    assert RG.parse_tail("1") and not RG.parse_tail("") and not RG.parse_tail("0")
+    src = CU.read_text()
+    assert "TORCH_CHECK(!group || (select && narrow && R <= rt" in src  # grouping: the narrow kernel, one row tile
+    assert "if (kit) w = __half2float(__float2half_rn(w));" in src
