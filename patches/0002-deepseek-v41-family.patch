+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G12 bug 3: a RoPE table's entries do not depend on the table's length (CPU).
+
+On the Sparks' aarch64 CPU, one torch cos / sin call over [max_pos, 32] angles gave other bits at hundreds of
+positions for lengths 4,224 / 4,608 / 6,144 than for 8,192 (``results/G12-*/segdiag-tables.txt``); the forward's
+table length is ``limit + pchunk``, so the fast tag's prefill depended on the segment size (G7's 1-ulp rows, layer 3's
+``cs`` the first differing step). ``Table.build`` now computes fixed blocks; these checks hold on any CPU.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from tensorfold.families.deepseek_v41.cuda import rope as RP
+
+
+def _freqs():
+    return {"plain": RP.inv_freq(64, 10000.0), "yarn": RP.inv_freq(64, 160000.0, 16.0)}
+
+
+def test_entries_independent_of_length():
+    for name, f in _freqs().items():
+        ref = RP.Table.build(f, 8192).cs
+        for n in (1, 255, 256, 257, 4224, 4352, 4608, 5120, 6144, 9001):
+            cs = RP.Table.build(f, n).cs
+            m = min(n, 8192)
+            assert cs.shape == (n, 64) and cs.dtype == torch.float32
+            assert torch.equal(cs[:m], ref[:m]), (name, n)
+
+
+def test_entries_independent_of_threads():
+    f = _freqs()["yarn"]
+    old = torch.get_num_threads()
+    try:
+        torch.set_num_threads(1)
+        one = RP.Table.build(f, 20000).cs
+        torch.set_num_threads(max(2, old))
+        many = RP.Table.build(f, 20000).cs
+    finally:
+        torch.set_num_threads(old)
+    assert torch.equal(one, many)
+
+
+def test_values_are_the_rope_angles():
+    f = _freqs()["yarn"]
+    cs = RP.Table.build(f, 3000).cs.double()
+    ang = torch.arange(3000, dtype=torch.float32)[:, None] * f[None, :]        # fp32 angles, as before
+    want = torch.cat([torch.cos(ang.double()), torch.sin(ang.double())], 1)
+    assert (cs - want).abs().max().item() < 1e-6                              # fp32 cos / sin of those angles
+    assert RP.Table.build(f, 0).cs.shape == (0, 64)
+
+
+def test_small_table_unchanged():
+    """A table of at most one block is the old single call (the kernels' unit tests build 256-position tables)."""
+
+    f = _freqs()["yarn"]
+    ang = torch.arange(256, dtype=torch.float32)[:, None] * f[None, :]
+    assert torch.equal(RP.Table.build(f, 256).cs, torch.cat([torch.cos(ang), torch.sin(ang)], 1))
diff --git a/tests/test_dsv41_router_fused_interp.py b/tests/test_dsv41_router_fused_interp.py
