@@ -0,0 +1,432 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DeepSeek-V4.1 image input, engine pieces on the CPU (TF_DSV41_IMAGES=native):
+
+- the processor (``vision_prep``) == DeepSeek's ``inference/image_processor.py`` (vendored in tests/fixtures): resize
+  plans over many sizes and aspect ratios, the patches bit for bit, the span layout and length;
+- the tower (``vision.Tower``) == DeepSeek's ``inference/vision.py`` ViT + aligner on random small weights, and the
+  span rows placed as ``merge_image_embeddings`` places them; its attention under CUDA's fused-kernel rules (flash /
+  memory-efficient only, 4-D q / k / v: ``fused_only``), which the CPU's own SDPA does not enforce;
+- digests / virtual ids: the same pixels -> the same ids, any other image or setting -> others;
+- ``vision.Store`` (hold / release / gather), ``window`` / ``fill`` (rank 0 only), ``moe`` (image rows with
+  ``bias_vl``, the rest with the bias, == the per-row ``torch.where`` of the reference's ``Gate``);
+- Engram: every id past the vocabulary is DEAD in the hasher and the round tables (== an explicit image mask).
+
+The forward with image positions against engine/reference (exact, TP=2, cut spans, CED replay) lives in the development
+tree (unpublished) (tests/family/test_vision_reference.py), next to the reference.
+"""
+
+from __future__ import annotations
+
+import base64
+import importlib.util
+import io
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+torch = pytest.importorskip("torch")
+PIL = pytest.importorskip("PIL")
+pytestmark = pytest.mark.torch
+
+from PIL import Image
+
+from tensorfold.families.deepseek_v41.cuda import vision as V
+from tensorfold.families.deepseek_v41.cuda import vision_prep as VP
+
+FIX = Path(__file__).parent / "fixtures"
+VISION_CONFIG = {"model_type": "deepseek_v41_vision", "num_hidden_layers": 32, "hidden_size": 1024,
+                 "num_attention_heads": 16, "intermediate_size": 2816, "patch_size": 14, "rope_theta": 10000,
+                 "downsample_ratio": 3, "max_image_tokens": 1024, "min_pixels": 295936, "max_wh_ratio": None}
+
+
+def _load(name: str):
+    spec = importlib.util.spec_from_file_location(name, FIX / f"{name}.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+@pytest.fixture(scope="module")
+def ref_proc():
+    return _load("dsv41_image_processor_ref")
+
+
+@pytest.fixture(scope="module")
+def ref_vit():
+    return _load("dsv41_vision_ref")
+
+
+def settings(tmp_path=None, **env) -> VP.Settings:
+    d = None
+    if tmp_path is not None:
+        (tmp_path / "config.json").write_text(json.dumps({"image_token_id": 129264, "vision_config": VISION_CONFIG}))
+        d = tmp_path
+    return VP.Settings.read(d, env)
+
+
+def ref_args(s: VP.Settings, **over):
+    a = {"vision_patch_size": s.patch, "vision_downsample_ratio": s.downsample, "vision_max_n_token": s.max_tokens,
+         "vision_min_pixels": s.min_pixels, "vision_max_wh_ratio": s.max_wh_ratio}
+    a.update(over)
+    return SimpleNamespace(**a)
+
+
+def png(w: int, h: int, seed: int = 0, mode: str = "RGB") -> bytes:
+    g = torch.Generator().manual_seed(seed)
+    arr = (torch.rand(h, w, 3, generator=g) * 255).to(torch.uint8).numpy()
+    buf = io.BytesIO()
+    Image.fromarray(arr, "RGB").convert(mode).save(buf, format="PNG")
+    return buf.getvalue()
+
+
+def data_url(raw: bytes) -> str:
+    return "data:image/png;base64," + base64.b64encode(raw).decode()
+
+
+# -- the processor -------------------------------------------------------------------------------------------------
+SIZES = [(1, 1), (14, 14), (100, 30), (30, 100), (544, 544), (640, 480), (1920, 1080), (1080, 1920), (3000, 200),
+         (200, 3000), (8000, 20), (20, 8000), (1279, 719), (4032, 3024), (777, 1001)]
+
+
+@pytest.mark.parametrize("most", [1024, 300, 40])
+def test_plans_match_reference(tmp_path, ref_proc, most):
+    s = settings(tmp_path)
+    args = ref_args(s, vision_max_n_token=most)
+    for w, h in SIZES:
+        got = VP.plan_grid(w, h, s, most)
+        want = ref_proc.plan_image_grid(w, h, args)
+        assert got == tuple(want), (w, h)
+        assert VP.span_len(got[0], got[1]) == ref_proc.num_image_tokens(got[0], got[1]) <= most
+
+
+@pytest.mark.parametrize("size", [(640, 480), (300, 1200), (2000, 300), (31, 17)])
+def test_patches_and_span_match_reference(tmp_path, ref_proc, size):
+    s = settings(tmp_path)
+    raw = png(*size, seed=size[0])
+    patches, vh, vw, lh, lw = ref_proc.load_image({"data": raw}, ref_args(s))
+    prep = VP.preprocess(VP.decode(raw, s), s)
+    assert (prep.n_vit_h, prep.n_vit_w, prep.n_llm_h, prep.n_llm_w) == (vh, vw, lh, lw)
+    assert prep.patches.dtype == torch.bfloat16 and torch.equal(prep.patches.view(torch.int16),
+                                                                 patches.view(torch.int16))
+    assert prep.types == ref_proc.image_token_types(lh, lw).tolist()
+    assert prep.tokens == len(prep.types) == ref_proc.num_image_tokens(lh, lw)
+    assert prep.size == size
+
+
+def test_digests_and_virtual_ids(tmp_path):
+    s = settings(tmp_path)
+    host = VP.Host(tmp_path, {})
+    a1 = host.prepare(data_url(png(200, 150, 1)))
+    a2 = host.images([data_url(png(200, 150, 1))])[0]            # the same pixels, another request
+    b = host.prepare(data_url(png(200, 150, 2)))
+    assert a1.vids == a2.vids and len(a1.vids) == a1.tokens and len(set(a1.vids)) == a1.tokens
+    assert not set(a1.vids) & set(b.vids)
+    assert all(VP.is_vid(v) for v in a1.vids)
+    other = VP.Host(tmp_path, {"TF_DSV41_BIAS_VL": "/x"})          # the routing bias changes the span's state
+    assert other.prepare(data_url(png(200, 150, 1))).vids != a1.vids
+    assert VP.preprocess(VP.decode(png(200, 150, 1), s), s).digest == a1.digest
+
+
+def test_expand_and_refusals(tmp_path):
+    s = settings(tmp_path)
+    host = VP.Host(tmp_path, {})
+    imgs = host.images([data_url(png(64, 64, 3)), data_url(png(90, 40, 4))])
+    ids = [0, 5, s.image_token, 6, s.image_token, 7]
+    out = VP.expand(ids, imgs, s)
+    assert out == [0, 5, *imgs[0].vids, 6, *imgs[1].vids, 7]
+    assert VP.expand(ids, imgs, s, virtual=False) == [0, 5] + [s.image_token] * imgs[0].tokens + [6] + \
+        [s.image_token] * imgs[1].tokens + [7]
+    with pytest.raises(VP.VisionError):
+        VP.expand(ids, imgs[:1], s)                 # a placeholder with no image part
+    with pytest.raises(VP.VisionError):
+        VP.expand([0, s.image_token], imgs, s)      # an image the prompt does not place
+    with pytest.raises(VP.VisionError):
+        host.images([data_url(png(8, 8))] * 9)      # TF_DSV41_VISION_MAX_IMAGES (8)
+    with pytest.raises(VP.VisionError):
+        host.prepare("file:///etc/passwd")
+    with pytest.raises(VP.VisionError, match="FETCH"):
+        VP.Host(tmp_path, {"TF_DSV41_VISION_FETCH": "0"}).prepare("https://example.com/x.png")
+
+
+def test_part_shapes():
+    url = "data:image/png;base64,AAAA"
+    assert VP.part_url({"type": "image_url", "image_url": {"url": url}}) == url
+    assert VP.part_url({"type": "image_url", "image_url": url}) == url
+    assert VP.part_url({"type": "input_image", "image_url": url}) == url
+    assert VP.part_url({"type": "image", "image": url}) == url
