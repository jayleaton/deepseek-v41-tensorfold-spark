+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G8 multi-stream decode on the GPU (collected only where PyTorch sees an NVIDIA GPU), on the synthetic DSpark
+checkpoint with the Triton CSA2 / DSpark kernels and upstream's EXL3:
+
+- slot-agnostic verify graphs (``rowgraphs.RowGraphs``): a replayed window's logits == the eager per-segment
+  window's, bit for bit, for mixes of 1-4 slots x 1-16 rows (padded to 1-8, 12, 16, 24, 32, 48, 64 rows), before
+  and after a context bucket boundary; the commits keep the same carries, positions and pool bytes; one graph a
+  (rows bucket, context bucket) whatever the slots;
+- replies with row graphs (4 slots, DSpark, lookup) == serial replies;
+- the DSpark pass in row mode with its padded-slot graphs: replay == eager over any slot subsets, keys
+  (1 / 2 / 4 slots, rows, variant) only;
+- the host time of a 4-slot round, replayed vs eager (``[G8]`` lines: the forward's launch cost G7 measured at
+  23-34 ms a round).
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_multistream_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import time
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+import dsv41_dspark_fakes as DF
+
+from tensorfold.engine.exact_sampling import Sampling
+from tensorfold.families.deepseek_v41.cuda import draft_graphs as DG
+from tensorfold.families.deepseek_v41.cuda import rowgraphs as RG
+from tensorfold.families.deepseek_v41.cuda import rowmode
+from tensorfold.families.deepseek_v41.cuda import rowtab as RT
+from tensorfold.families.deepseek_v41.cuda.batch import Job
+from tensorfold.families.deepseek_v41.cuda.forward import Seg
+from tensorfold.families.deepseek_v41.cuda.lookup import noise_of
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+
+DEV = "cuda"
+LONG = 4096
+SAMPLINGS = [None, Sampling(seed=7, temperature=0.8, top_k=20, top_p=0.95), None,
+             Sampling(seed=11, temperature=1.1, top_k=0, top_p=0.9, min_p=0.02)]
+PROMPTS = [[int(t) for t in np.random.default_rng(80 + i).integers(3, 250, size=2040 + 3 * i)] for i in range(4)]
+N = 40
+SETTINGS = {"on": True, "budget_s": 300.0, "max_graphs": 128, "bucket": 2048, "slots": 4, "warm": "decode",
+            "floor_gib": 0.0}
+
+
+@pytest.fixture(autouse=True)
+def _torch_seams(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")       # the mHC / Engram kernels are laid out for D = 5,120
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41ms"))
+
+
+def _fw(ck, slots=4, dspark=True):
+    return DF.forward(ck, slots=slots, limit=LONG, dspark=dspark, device=DEV, chunk=128)
+
+
+def _prefill(fw, slot, ids):
+    fw.reset(slot)
+    fw.prefill([Piece(slot, 0, tuple(ids))], mode="full")
+
+
+def _pair(ck):
+    """Two 4-slot forwards on their own pools, prompts prefilled: g with row graphs (boot warm-up), e eager."""
+
+    g, e = _fw(ck), _fw(ck)
+    bg = DF.batcher(ck, g, n=4, capacity=LONG, pool_tokens=5 * LONG)
+    be = DF.batcher(ck, e, n=4, capacity=LONG, pool_tokens=5 * LONG)
+    assert rowmode.ready(g)
+    g.graphs = RG.make(g, settings=SETTINGS)
+    assert isinstance(g.graphs, RG.RowGraphs)
+    n = g.graphs.warmup(4, lambda s, end: bg.ex.slots[s].ensure(end))
+    assert n == len(RT.warm_buckets("decode")) and g.graphs.cache.on
+    for f, b in ((g, bg), (e, be)):
+        for s in range(4):
+            b.ex.slots[s].ensure(LONG)
+            _prefill(f, s, PROMPTS[s])
+    return g, e, bg, be
+
+
+def _mixes(rng, steps):
+    """Slot subsets of 1-4 slots, 1-16 rows each (every bucket up to 64 is met), in random plan order."""
+
+    for step in range(steps):
+        k = 1 + step % 4
+        live = [int(s) for s in rng.permutation(4)[:k]]
+        rows = [int(r) for r in rng.integers(1, 17, size=k)] if step % 5 else [16] * k
+        yield live, rows
+
+
+def test_row_graph_replay_equals_eager(ck):
+    g, e, bg, be = _pair(ck)
+    pre = set(g.graphs.cache.graphs)                # captured at bind (context bucket 0): not this loop's
+    rng = np.random.default_rng(5)
+    buckets = set()
+    for step, (live, rows) in enumerate(_mixes(rng, 24)):    # crosses position 2,048: bucket 1 captured lazily
+        segs = [Seg(s, g.slots[s].pos, tuple(int(t) for t in rng.integers(3, 250, size=n)))
+                for s, n in zip(live, rows)]
+        buckets.add(g.graphs.key(segs))
+        lg = g.graphs.run(segs).clone()
+        le = e.run(segs)
+        assert torch.equal(lg, le), (step, [(sg.slot, len(sg.ids)) for sg in segs])
+        for sg in segs:
+            pg, pe = g.slots[sg.slot].pending, e.slots[sg.slot].pending
+            for L in pe.proj:
+                assert torch.equal(pg.proj[L], pe.proj[L]), (step, L)
+            for L in pe.taps:
+                assert torch.equal(pg.taps[L], pe.taps[L]), (step, L)
+            keep = int(rng.integers(0, len(sg.ids)))
+            g.keep(sg.slot, keep)
+            e.keep(sg.slot, keep)
+            assert g.slots[sg.slot].pos == e.slots[sg.slot].pos
+            for L, t in e.slots[sg.slot].carry.items():
+                assert torch.equal(g.slots[sg.slot].carry[L], t)
+    st = g.graphs.cache.stats
+    assert st["replays"] > 0 and st["lazy"] > 0 and st["failed"] == 0, st
+    held = set(g.graphs.cache.graphs)
+    assert any(k[1] == 1 for k in held) and any(k[0] > 16 for k in held)
+    assert len(held - pre) <= len({k for k in buckets if k is not None})    # one graph a key, whatever the slots
+    print(f"[G8] row graphs: {g.graphs.cache.describe()}; keys {sorted(held)}")
+
+
+def test_one_graph_serves_every_slot(ck):
+    g, e, _, _ = _pair(ck)
+    held = set(g.graphs.cache.graphs)
+    keys = []
+    for live in ([0, 1], [2, 3], [3, 0], [1, 2], [0, 1], [2, 3]):
+        segs = [Seg(s, g.slots[s].pos, (5, 6, 7)) for s in live]
+        keys.append(g.graphs.key(segs))
+        assert torch.equal(g.graphs.run(segs), e.run(segs))
+        for sg in segs:
+            g.keep(sg.slot, 0)
+            e.keep(sg.slot, 0)
+    assert all(k is not None and k[0] == 6 for k in keys)
+    new = set(g.graphs.cache.graphs) - held
+    assert new <= set(keys) - held and len(new) <= 1        # 6 rows: one graph a context bucket, any pair of slots
+    assert g.graphs.cache.stats["replays"] >= len(keys) - 2
+
+
+def test_row_graphs_replies_equal_serial(ck):
+    with pytest.MonkeyPatch.context() as mp:
+        mp.setenv("TF_DSV41_SEAMS", "torch")
+        bs = DF.batcher(ck, _fw(ck, slots=1, dspark=False), capacity=LONG, pool_tokens=2 * LONG, depth=0)
+        serial = DF.run(bs, [Job(p, N, s) for p, s in zip(PROMPTS, SAMPLINGS)])
+    fw = _fw(ck)
+    b = DF.batcher(ck, fw, n=4, capacity=LONG, pool_tokens=5 * LONG, lookup=True)
+    fw.graphs = RG.make(fw, settings=SETTINGS)
+    fw.graphs.warmup(4, lambda s, end: b.ex.slots[s].ensure(end))
+    fw.drafter.graphs = DG.DraftGraphs(fw.drafter, settings=SETTINGS)
+    fw.drafter.graphs.warmup()
+    for s in b.ex.slots:
+        s.release()
+    jobs = [Job(p, N, s) for p, s in zip(PROMPTS, SAMPLINGS)]
+    assert DF.run(b, jobs) == serial
+    assert fw.graphs.cache.stats["replays"] > 0 and fw.drafter.graphs.cache.stats["replays"] > 0
+    print(f"[G8] replies == serial: {fw.describe()}")
+
+
+def test_draft_graphs_any_slots(ck):
+    g, e = _fw(ck), _fw(ck)
+    bg = DF.batcher(ck, g, n=4, capacity=LONG, pool_tokens=5 * LONG)
+    be = DF.batcher(ck, e, n=4, capacity=LONG, pool_tokens=5 * LONG)
+    g.drafter.graphs = DG.DraftGraphs(g.drafter, settings=SETTINGS)
+    n = g.drafter.graphs.warmup()
+    assert n == 3 * len(g.drafter.head.variants())
+    for f, b in ((g, bg), (e, be)):
+        for s in range(4):
+            b.ex.slots[s].ensure(LONG)
+            _prefill(f, s, PROMPTS[s][:200 + 50 * s])
+    rng = np.random.default_rng(9)
+    for step in range(12):
+        live = [int(s) for s in rng.permutation(4)[:1 + step % 4]]
+        anchors = [int(rng.integers(3, 250)) for _ in live]
+        starts = [g.slots[s].pos for s in live]
+        noises = [noise_of(SAMPLINGS[s]) if SAMPLINGS[s] else None for s in live]
+        dg, cg = g.drafter.propose(live, anchors, starts, noises)
+        de, ce = e.drafter.propose(live, anchors, starts, noises)
+        assert dg == de and cg == ce, (step, live)
+        for s in live:
+            for rg, re_ in zip(g.drafter.rings[s], e.drafter.rings[s]):
+                assert all(torch.equal(a, b) for a, b in zip(rg.kernel(), re_.kernel())), (step, s)
+    st = g.drafter.graphs.cache.stats
+    assert st["replays"] > 0 and st["failed"] == 0 and st["lazy"] == 0, st      # 1-4 slots: all warm keys
+    assert {k[0] for k in g.drafter.graphs.cache.graphs} <= {1, 2, 4}
+
+
+def test_host_time_of_a_four_slot_round(ck):
+    """The forward's host time (staging + launches) of a 4-slot 16-row round, replayed vs eager."""
+
+    g, e, _, _ = _pair(ck)
+
+    def host_ms(fw, run, reps=5):
+        out = []
+        for _ in range(reps):
+            segs = [Seg(s, fw.slots[s].pos, (5, 6, 7, 8)) for s in range(4)]
+            torch.cuda.synchronize()
+            t0 = time.perf_counter()
+            run(segs)
+            out.append((time.perf_counter() - t0) * 1e3)
+            torch.cuda.synchronize()
+            for s in range(4):
+                fw.keep(s, 0)
+        return float(np.median(out))
+
+    host_ms(g, g.graphs.run, reps=1)                        # the 16-row key: captured on first use
+    rep, eag = host_ms(g, g.graphs.run), host_ms(e, e.run)
+    print(f"[G8] 4 slots x 4 rows, host ms a forward: replay {rep:.2f}, eager {eag:.2f}")
+    assert rep < eag
