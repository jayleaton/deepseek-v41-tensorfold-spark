+++ b/src/tensorfold/families/deepseek_v41/cuda/rowmode.py
@@ -0,0 +1,158 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Row mode's stacked slot state (G8): every slot's SWA ring of a layer, ratio-2 carry and KV-pool page table live in
+one tensor each, so a row's slot id (``rowtab``) is an offset and one launch serves rows of any slots.
+
+- ``stack(fw, pool_slots)`` (``slots.SlotsForward.bind``): a layer's rings become one store of S x ring rows (a
+  slot's ring is the view of rows [s ring, (s + 1) ring)), a ratio-2 layer's carries one fp32 [S, 2 D] tensor (a
+  slot's carry is row s), and the pool slots' page tables one int32 [S, pages] tensor (a pool slot's ``table`` is its
+  row: the pool writes it in place). The one-slot paths keep using the views, so nothing else changes; the contents
+  are copied, so a bind after use keeps every slot's state.
+- ``RowSlot``: the stores a row-mode window reads and writes (``blocks.Context.slot``): the stacked rings, the pool's
+  physical rows through the stacked page tables, the stacked carries.
+- ``fingerprint(fw)``: the addresses a captured row-mode graph holds.
+
+``ring_view`` / ``stack_rings`` serve the DSpark rings too (``drafter.Drafter``).
+"""
+
+from __future__ import annotations
+
+import torch
+
+from .csa2.stores import Floats, Keys, Records
+
+
+def ring_view(store, a: int, b: int):
+    """Rows [a, b) of a ring store as a store of their own (a view: writes land in the stacked tensor)."""
+
+    if isinstance(store, Records):
+        return Records(store.values[a:b], store.scales[a:b])
+    if isinstance(store, Keys):
+        return Keys(store.data[a:b])
+    return Floats(store.data[a:b])
+
+
+def stack_rings(csa2, rings: list, ring: int, dim: int, device, slots: int):
+    """One store of ``slots`` x ``ring`` rows holding ``rings`` (each slot's ring store, copied as stored bytes),
+    and the per-slot views replacing them (slots past ``rings`` start empty)."""
+
+    big = csa2.rows(slots * ring, dim, device)
+    views = []
+    for s in range(slots):
+        v = ring_view(big, s * ring, (s + 1) * ring)
+        if s < len(rings) and rings[s] is not None:
+            old = rings[s]
+            if isinstance(v, Records):
+                v.values.copy_(old.values)
+                v.scales.copy_(old.scales)
+            else:
+                v.data.copy_(old.data)
+        views.append(v)
+    return big, views
+
+
+class RowSlot:
+    """The stores of a row-mode window (``blocks.Context.slot``): ``swa`` {layer: stacked ring}, ``comp`` /
+    ``ikeys`` {kv source: the pool's rows through the stacked page tables}, ``carry`` {ratio-2 layer: fp32 [S, 2D]}."""
+
+    def __init__(self) -> None:
+        self.swa: dict = {}
+        self.comp: dict = {}
+        self.ikeys: dict = {}
+        self.carry: dict = {}
+        self.ptab = None
+
+
+def stack(fw, pool_slots=None) -> RowSlot:
+    """Stack ``fw``'s slots' rings, carries and (``pool_slots``: ``pool.Slot`` of each forward slot) page tables;
+    the result is ``fw.rowslot``. Row mode needs the pool (compressed rows and index keys through page tables)."""
+
+    S, cs, dev = len(fw.slots), fw.csa2, fw.device
+    rs = RowSlot()
+    for blk in fw.blocks:
+        L = blk.index
+        big, views = stack_rings(cs, [s.swa.get(L) for s in fw.slots], fw.ring, fw.cfg.head_dim, dev, S)
+        rs.swa[L] = big
+        for s, v in zip(fw.slots, views):
+            s.swa[L] = v
+        if any(L in s.carry for s in fw.slots):
+            first = next(s.carry[L] for s in fw.slots if L in s.carry)
+            allc = torch.zeros((S, first.numel()), dtype=first.dtype, device=first.device)
+            for i, s in enumerate(fw.slots):
+                if L in s.carry:
+                    allc[i].copy_(s.carry[L].reshape(-1))
+                s.carry[L] = allc[i]
+            rs.carry[L] = allc
+    if pool_slots:
+        pool = pool_slots[0].pool
+        tabs = [ps.table for ps in pool_slots]
+        if all(t is not None for t in tabs):
+            mp = max(int(t.numel()) for t in tabs)
+            ptab = torch.full((len(tabs), mp), int(pool.null), dtype=torch.int32, device=tabs[0].device)
+            for i, (ps, t) in enumerate(zip(pool_slots, tabs)):
+                ptab[i, :t.numel()].copy_(t)
+                ps.table = ptab[i, :t.numel()]          # the pool writes the slot's pages in place, into ptab
+            rs.ptab = ptab
+            for blk in fw.blocks:
+                if blk.mode != "full":
+                    continue
+                L = blk.index
+                comp, keys = pool.phys[f"comp.{L}"], pool.phys[f"index_k.{L}"]
+                shift = pool.family(f"comp.{L}").page_rows(pool.page).bit_length() - 1
+                rs.comp[L] = Records.packed(comp, ptab, shift)
+                rs.ikeys[L] = Keys(keys, ptab, shift)
+    fw.rowslot = rs
+    return rs
+
+
+class Mirrored:
+    """A row-mode window's Engram inputs: layer L's rows of the real rows (staged, or ``engram_gate``'s over the
+    graph's rows) taken through ``src`` (each row's source row: a padding row takes the last real row's), so every
+    row of the padded run has its mirror's inputs. One gather a layer, inside the graph."""
+
+    def __init__(self, inner, n: int, src) -> None:
+        view = getattr(inner, "view", None)
+        self.inner = view(n) if callable(view) and not isinstance(inner, dict) else inner
+        self.n, self.src = n, src
+
+    def __getitem__(self, L: int):
+        return self.inner[L][:self.n].index_select(0, self.src)
+
+    def __contains__(self, L) -> bool:
+        return L in self.inner
+
+    def keys(self):
+        return self.inner.keys()
+
+    def items(self):
+        return [(L, self[L]) for L in sorted(self.keys())]
+
+    def __len__(self) -> int:
+        return len(self.inner)
+
+
+def mirrored(rows, n: int, src) -> Mirrored:
+    return Mirrored(rows, n, src)
+
+
+def ready(fw) -> bool:
+    """Row mode is possible: the stacked state exists, with page tables for every slot (the pool is bound)."""
+
+    rs = getattr(fw, "rowslot", None)
+    return rs is not None and rs.ptab is not None and rs.ptab.shape[0] == len(fw.slots) and \
+        getattr(fw.csa2, "name", "") == "triton"
+
+
+def fingerprint(fw) -> tuple:
+    """The stacked buffers' addresses (a re-stack moves them: captured row-mode graphs must go)."""
+
+    rs = getattr(fw, "rowslot", None)
+    if rs is None:
+        return ()
+    parts = [rs.ptab.data_ptr() if rs.ptab is not None else 0]
+    parts += [st.values.data_ptr() if isinstance(st, Records) else st.data.data_ptr() for st in rs.swa.values()]
+    parts += [c.data_ptr() for c in rs.carry.values()]
+    return tuple(parts)
+
+
+__all__ = ["Mirrored", "RowSlot", "mirrored", "fingerprint", "ready", "ring_view", "stack", "stack_rings"]
