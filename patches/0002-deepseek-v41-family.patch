index 0000000..10cd142
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/pick.py
@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Logits as the kit sees them, and a top-k whose ties go to the lower token id.
+
+The kit's head (an EXL3 linear) returns bf16 logits, and vLLM's greedy sampler takes their ``argmax``: the first
+(lowest) id among equal values. Its ``prompt_logprobs`` show it: every top-1 / top-2 margin is a multiple of 1/16
+(G2: 0, 0.125, 0.25, ... 1.5625), and at all 8 exact ties among G2's first-copy misses the kit took the lower id while
+our fp32 logits took the higher one. So the forward rounds the head's output to bf16 (``numerics.LOGITS``) and every
+choice uses ``top``: value descending, then id ascending, whatever the kernel's own tie order.
+
+``keys`` maps bf16-valued fp32 logits to int32 keys that sort the same way: the float's order-preserving integer image
+with its low 16 bits (zero for bf16 values) replaced by ``65535 - column``. A rank's vocabulary half (64,640 columns)
+fits; wider rows (one-rank tests with a large vocabulary, or float64 logits of the exact twins) take a stable sort.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from . import numerics as N
+
+COLS = 1 << 16
+
+
+def kit_logits(x: torch.Tensor) -> torch.Tensor:
+    """The head's fp32 output rounded through ``numerics.LOGITS`` (bf16; float64 = unchanged in ``exact()``)."""
+
+    if N.LOGITS == x.dtype or N.LOGITS == N.ACC:
+        return x
+    return x.to(N.LOGITS).to(x.dtype)
+
+
+def keys(lg: torch.Tensor) -> torch.Tensor:
+    """int32 [R, C] keys of bf16-valued fp32 logits [R, C]: larger key = larger value, then lower column."""
+
+    bits = (lg + 0.0).contiguous().view(torch.int32)          # -0.0 + 0.0 = +0.0: equal values, equal keys
+    mono = torch.where(bits >= 0, bits, bits ^ 0x7FFFFFFF)
+    col = torch.arange(lg.shape[-1], device=lg.device, dtype=torch.int32)
+    return (mono & -COLS) | (COLS - 1 - col)
+
+
+def _bf16_valued(lg: torch.Tensor) -> bool:
+    """fp32 logits the forward rounded (``kit_logits`` with LOGITS = bf16), on 16-bit columns (no device sync)."""
+
+    return lg.dtype == torch.float32 and N.LOGITS == torch.bfloat16 and lg.shape[-1] <= COLS
+
+
+def top(lg: torch.Tensor, k: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """(values, columns) of each row's best ``k``: value descending, ties by the lower column. ``lg`` must come from
+    ``kit_logits`` (or be any float tensor when LOGITS is not bf16: a stable sort then)."""
+
+    k = min(int(k), lg.shape[-1])
+    if _bf16_valued(lg):
+        _, cols = torch.topk(keys(lg), k, dim=-1)
+    else:
+        _, cols = torch.sort(lg, dim=-1, descending=True, stable=True)
+        cols = cols[..., :k]
+    return torch.gather(lg, -1, cols), cols
+
+
+def argmax(lg: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """(value, column) of each row's maximum, the lowest column among equal values."""
+
+    v, c = top(lg, 1)
+    return v[..., 0], c[..., 0]
+
+
+def kit_partial(x: torch.Tensor) -> torch.Tensor:
+    """A rank's fp32 partial (attention ``wo_b``, the MoE) as the kit exchanges it: bf16 (vLLM's row-parallel output
+    before its bf16 all-reduce; the mHC boundary then rounds the sum to bf16 as the all-reduce does). Unchanged when
+    ``numerics.KIT_ROUNDING`` is off (and in ``exact()``)."""
+
+    if not N.KIT_ROUNDING or x.dtype != torch.float32:
+        return x
+    return x.to(torch.bfloat16).to(torch.float32)
+
+
+def kit_weights(w: torch.Tensor) -> torch.Tensor:
+    """Routed expert weights (renormalized x 1.5) as the kit's EXL3 expert kernels take them: fp16."""
+
+    if not N.KIT_ROUNDING or w.dtype not in (torch.float32, torch.float64):
+        return w
+    return w.to(torch.float16).to(w.dtype)
+
+
+__all__ = ["argmax", "keys", "kit_logits", "kit_partial", "kit_weights", "top"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/plain_fp64.py b/src/tensorfold/families/deepseek_v41/cuda/plain_fp64.py
new file mode 100644
index 0000000..4d6dfeb
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/plain_fp64.py
@@ -0,0 +1,84 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""``linear.Plain`` (the indexer's ``weights_proj``, [32, 5,120] bf16) in float64 sums as one Triton launch (G4).
+
+The torch form ``x.double() @ w.double().t()`` runs cuBLAS's DGEMM: at decode widths (1-16 rows) it launches a
+split-K kernel with 5 thread blocks, ~275 us a call on sm_121 (the GPU's float64 rate is low), plus a 320-block
+conversion of the weight: G4's nsys put ~2.2 ms of every verify window there (8 calls). Here one program a (row,
+output) loads the row and the weight row, multiplies in float64 (bf16 / fp32 values widen exactly, so every product
+is exact) and adds them in a fixed order: ``BK`` lanes accumulate k ascending in steps of ``BK``, then the lanes are
+summed by ``tl.sum``'s fixed tree. That order depends on K alone, never on the number of rows, so a row's value is
+the same alone, in a verify window or in a prefill chunk (cuBLAS's split-K choice depends on M).
+
+The sums are float64 like the torch form's; they may differ from cuBLAS's in the last float64 bits (another
+order), which the caller's rounding to fp32 / bf16 hides except at a rounding tie of probability ~2^-29 a value.
+``TF_DSV41_PLAIN_TRITON`` (1 = on) selects it on CUDA; the CPU twin and every other device keep the torch form.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from . import pdl as P
+from .pdl import gdc_launch_dependents, gdc_wait
+
+BK = 256
+
+
+def enabled() -> bool:
+    return (os.environ.get("TF_DSV41_PLAIN_TRITON", "1").strip() or "1") != "0"
+
+
+@triton.jit
+def _plain(X, x_rs, W, w_rs, OUT, K, N, BK: tl.constexpr, PDL: tl.constexpr = False, BF16: tl.constexpr = False):
+    if PDL:                                   # G10 (pdl.py, TF_DSV41_PDL): wait for the kernels before, then
+        gdc_wait()                            # let the next launch start its prologue
+        gdc_launch_dependents()
+    r = tl.program_id(0)
+    n = tl.program_id(1)
+    k = tl.arange(0, BK)
+    acc = tl.zeros((BK,), dtype=tl.float64)
+    xr = X + r.to(tl.int64) * x_rs
+    wr = W + n.to(tl.int64) * w_rs
+    for c in range(0, K, BK):
+        m = (c + k) < K
+        xv = tl.load(xr + c + k, mask=m, other=0.0).to(tl.float64)
+        wv = tl.load(wr + c + k, mask=m, other=0.0).to(tl.float64)
+        acc += xv * wv
+    v = tl.sum(acc, axis=0)
+    if BF16:                                  # ``.to(fp32).to(bf16)`` of the float64 sum, both roundings nearest-even
+        v = v.to(tl.float32).to(tl.bfloat16)
+    tl.store(OUT + r.to(tl.int64) * N + n, v)
+
+
+def matmul_t(x: torch.Tensor, w: torch.Tensor, out_dtype: torch.dtype = torch.float64) -> torch.Tensor:
+    """x [M, K] (any float dtype), w [N, K] -> float64 [M, N] = x @ w.T in float64 sums, row-invariant.
+    ``out_dtype`` bf16 (``branches``, TF_DSV41_BRANCHES): the sums rounded to fp32 and then to bf16 as they are
+    stored, the bits of ``.to(fp32).to(bf16)`` after the float64 result without the two cast launches."""
+
+    if out_dtype not in (torch.float64, torch.bfloat16):
+        raise ValueError(f"matmul_t: float64 or bf16 output, not {out_dtype}")
+
+    if x.stride(-1) != 1:
+        x = x.contiguous()
+    if w.stride(-1) != 1:
+        w = w.contiguous()
+    M, K = x.shape
+    N = w.shape[0]
+    out = torch.empty((M, N), dtype=out_dtype, device=x.device)
+    if M:
+        _plain[(M, N)](x, x.stride(0), w, w.stride(0), out, K, N, BK=BK, num_warps=2,
+                       BF16=out_dtype == torch.bfloat16, **P.triton_kw())
+    return out
+
+
+def eligible(x: torch.Tensor, w: torch.Tensor) -> bool:
+    return (x.is_cuda and x.dim() == 2 and w.dim() == 2 and w.device == x.device and x.shape[1] == w.shape[1]
+            and enabled())
+
+
+__all__ = ["BK", "eligible", "enabled", "matmul_t"]
