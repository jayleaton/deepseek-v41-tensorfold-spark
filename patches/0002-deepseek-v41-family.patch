@@ -0,0 +1,214 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G9 ``dense``: GB/s a matrix shape, upstream / x3seg against x3dn (``dense``, TF_DSV41_DENSE), with x3ld's GB/s
+on a real expert layer as the bandwidth reference (``kbench``). ``projbench --gbps`` runs it.
+
+Shapes (one rank, the real weights of ``--layers``): x (wq_a + wkv, + the compressor on kv sources), q (wq_b, +
+the indexer's wq_b on index sources), o (wo_a's 4 groups), wo_b, and with ``--head`` the head. Each is timed as the
+decode runs it, COLD: a CUDA graph of 10 x (a 256 MB scratch write that evicts L2, the call) minus a graph of the
+writes alone (``cold_us``; the warm back-to-back replay is printed apart, L2-hot below ~20 MB, which misled v1's
+design), at the verify widths R; GB/s = trellis bytes / time. Also checks
+x3dn's bits: a row alone == in the window, and the drift from upstream (max |diff| / max |value|).
+
+    python -m tensorfold.families.deepseek_v41.cuda.projbench --gbps --model DIR [--layers 1,2,20] [--rows 1,4,8,16]
+           [--x3ld-layer 3] [--head] [--out densebench.json]
+"""
+
+from __future__ import annotations
+
+import os
+import time
+from contextlib import contextmanager
+from pathlib import Path
+
+
+@contextmanager
+def _env(**kv):
+    old = {k: os.environ.get(k) for k in kv}
+    os.environ.update({k: str(v) for k, v in kv.items()})
+    try:
+        yield
+    finally:
+        for k, v in old.items():
+            if v is None:
+                os.environ.pop(k, None)
+            else:
+                os.environ[k] = v
+
+
+FLUSH_MB = int(os.environ.get("TF_DSV41_DENSE_FLUSH_MB", "") or 256)
+_SCRATCH: dict = {}
+
+
+def _flush():
+    """Evict L2 (24 MB on GB10): a FLUSH_MB write, as the engine's expert streams do between two dense calls."""
+
+    import torch
+
+    t = _SCRATCH.get("t")
+    if t is None:
+        t = _SCRATCH["t"] = torch.empty((FLUSH_MB << 18,), dtype=torch.float32, device="cuda")
+    t.fill_(1.0)
+
+
+def _replay_us(g, iters: int) -> float:
+    import torch
+
+    g.replay()
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(iters):
+        g.replay()
+    b.record()
+    torch.cuda.synchronize()
+    return a.elapsed_time(b) * 1e3 / iters
+
+
+def _capture(body):
+    import torch
+
+    s = torch.cuda.Stream()
+    s.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(s):
+        body()
+    torch.cuda.current_stream().wait_stream(s)
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        body()
+    return g
+
+
+def cold_us(fn, iters: int, reps: int = 10) -> float:
+    """us of one ``fn`` call with a cold L2: a graph of reps x (flush, fn) minus a graph of reps flushes."""
+
+    def both():
+        for _ in range(reps):
+            _flush()
+            fn()
+
+    def flush_only():
+        for _ in range(reps):
+            _flush()
+
+    g1, g0 = _capture(both), _capture(flush_only)
+    t = (_replay_us(g1, iters) - _replay_us(g0, iters)) / reps
+    del g1, g0
+    return t
+
+
+def warm_us(fn, iters: int, reps: int = 10) -> float:
+    """us of one ``fn`` call replayed back to back (L2-hot for matrices under ~20 MB: NOT the engine's case)."""
+
+    def body():
+        for _ in range(reps):
+            fn()
+
+    g = _capture(body)
+    t = _replay_us(g, iters) / reps
+    del g
+    return t
+
+
+def shapes(A, G, x, qr, o) -> dict:
+    """{shape name: (callable, matrices)} of one layer, as ``blocks.attention`` calls them."""
+
+    from . import fused_proj as FP
+    from . import numerics as N
+
+    comp, ix = A.comp_wkv is not None, A.ix_wq_b is not None
+    lin = FP.lin_of
+    out = {}
+    xs = [A.wq_a, A.wkv] + ([A.comp_wkv] + ([A.comp_wgate] if A.comp_wgate is not None else []) if comp else [])
+    if G is not None and (G.x4 is not None or not comp):
+        out["x4" if comp else "x"] = (lambda: G.x(x, comp), [lin(m) for m in xs])
+    if G is not None and G.q is not None and ix:
+        out["q+ix"] = (lambda: G.qproj(qr), [lin(A.wq_b), lin(A.ix_wq_b)])
+    else:
+        out["q"] = (lambda: A.wq_b(qr, N.ACT), [lin(A.wq_b)])
+    if G is not None and G.o is not None:
+        out["o"] = (lambda: G.oproj(o), [lin(m) for m in A.wo_a])
+    z = o[:, :A.wo_b.k].contiguous() if A.wo_b.k <= o.shape[1] else None
+    if z is not None:
+        out["wo_b"] = (lambda: A.wo_b(z, N.ACC), [lin(A.wo_b)])
+    return out
+
+
+def bench(model: str, rank: int, layers, rows, iters: int, x3ld_layer: int | None = 3, head: bool = False) -> dict:
+    import torch
+
+    from . import dense as D
+    from . import projbench as PB
+    from . import weights as W
+    from .config import Config
+
+    torch.cuda.set_device(0)
+    cfg = Config.from_file(Path(model) / "config.json")
+    ld = W.Loader(cfg, W.Shards(model), rank, 2, "cuda")
+    t0 = time.time()
+    attns = [(L, PB.attn_of(cfg, ld, L, "cuda")) for L in layers]
+    rep: dict = {"rank": rank, "layers": list(layers), "load_s": round(time.time() - t0, 1), "shapes": {},
+                 "row_invariant": True, "drift": 0.0}
+    gen = torch.Generator(device="cuda").manual_seed(rank)
+    bf = torch.bfloat16
+    hd = None
+    if head:
+        from .blocks import materialize
+
+        hd = materialize(ld.x3("head", "col"), "cuda")
+    for R in rows:
+        x = torch.randn((R, cfg.hidden_size), generator=gen, device="cuda").to(bf)
+        qr = torch.randn((R, cfg.q_lora_rank), generator=gen, device="cuda").to(bf)
+        o = (torch.randn((R, (cfg.num_attention_heads // 2) * cfg.head_dim), generator=gen, device="cuda") * 0.3).to(bf)
+        for L, A in attns:
+            res = {}
+            for mode, scope in (("upstream", "0"), ("x3dn", "attn")):
+                with _env(**{D.ENV: scope}):
+                    (_, _, G), = PB.set_plan([(L, A)], "upstream")
+                    for name, (fn, lins) in shapes(A, G, x, qr, o).items():
+                        mb = sum(lin.words.numel() * 4 for lin in lins) / 1e6
+                        us = cold_us(fn, iters)
+                        hot = warm_us(fn, iters)
+                        res.setdefault(name, {"mb": round(mb, 2)})[mode] = {"us": round(us, 1),
+                                                                            "gbps": round(mb / us * 1e3, 1),
+                                                                            "warm_us": round(hot, 1)}
+                        outs = fn()
+                        outs = list(outs) if isinstance(outs, (tuple, list)) else [outs]
+                        res[name].setdefault("_outs", {})[mode] = [t for t in outs if t is not None]
+                        if mode == "x3dn" and R > 1:              # row 0 alone == in the window
+                            one = shapes(A, G, x[:1], qr[:1], o[:1])[name][0]()
+                            one = list(one) if isinstance(one, (tuple, list)) else [one]
+                            ok = all(torch.equal(a[:1], b) for a, b in zip(res[name]["_outs"][mode], one)
+                                     if b is not None)
+                            rep["row_invariant"] &= ok
+            for name, r in res.items():
+                outs = r.pop("_outs")
+                for a, b in zip(outs["x3dn"], outs["upstream"]):
+                    d = ((a.float() - b.float()).abs().max() / b.float().abs().max().clamp_min(1e-30)).item()
+                    rep["drift"] = max(rep["drift"], d)
+                rep["shapes"].setdefault(f"L{L} {name}", {})[R] = r
+                print(f"[G9] dense L{L} {name} ({r['mb']} MB) R={R} cold L2: upstream {r['upstream']['us']} us "
+                      f"{r['upstream']['gbps']} GB/s -> x3dn {r['x3dn']['us']} us {r['x3dn']['gbps']} GB/s (warm "
+                      f"{r['upstream']['warm_us']} -> {r['x3dn']['warm_us']} us)", flush=True)
+        if hd is not None:
+            lin = hd.lin
+            mb = lin.words.numel() * 4 / 1e6
+            r = {"mb": round(mb, 2)}
+            for mode, scope in (("upstream", "0"), ("x3dn", "all")):
+                with _env(**{D.ENV: scope}):
+                    us = cold_us(lambda: hd(x, torch.float32), iters, reps=3)
+                r[mode] = {"us": round(us, 1), "gbps": round(mb / us * 1e3, 1)}
+            rep["shapes"].setdefault("head", {})[R] = r
+            print(f"[G9] dense head ({r['mb']} MB) R={R}: upstream {r['upstream']['gbps']} GB/s -> x3dn "
+                  f"{r['x3dn']['gbps']} GB/s", flush=True)
+    if x3ld_layer is not None:                                    # the bandwidth reference: x3ld on real experts
+        from . import kbench
+
+        kb = kbench.bench(model, x3ld_layer, rank, iters, rows=tuple(rows))
+        rep["x3ld_gbps"] = {R: max(v["gbps"] for v in row["x3ld"].values()) for R, row in kb["rows"].items()}
+        for R, g in rep["x3ld_gbps"].items():
+            ours = [s[R]["x3dn"]["gbps"] for s in rep["shapes"].values() if R in s]
+            print(f"[G9] dense R={R}: x3ld (layer {x3ld_layer} experts) {g} GB/s; x3dn shapes "
+                  f"{min(ours):.0f}-{max(ours):.0f} GB/s ({min(ours) / g:.0%}-{max(ours) / g:.0%} of x3ld)", flush=True)
+    print(f"[G9] dense: row invariant {rep['row_invariant']}; drift vs upstream {rep['drift']:.2e}", flush=True)
+    return rep
