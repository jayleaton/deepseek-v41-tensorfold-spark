+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G10: programmatic dependent launch (``pdl.py``, TF_DSV41_PDL) and the L2 prefetch (``l2pf.py``, TF_DSV41_L2PF) on
+the GPU. PDL and L2 residency only move time, so everything here is bit for bit:
+
+- ``single``: upstream's ``Exl3Linear`` as a 1-segment x3seg launch == upstream's launch, R 1..16 / 130, PDL on and
+  off, every plan shape (SK > 1 with 4 warps, wq_b's 8 warps, K2 10 and 12);
+- a chain of the window's kernels (x group -> rms_pair -> q group -> single wo-like -> rms -> plain fp64 ->
+  rope) captured in a CUDA graph with PDL on == the same graph with PDL off == eager, replayed on new inputs;
+- the late writer: a producer that triggers its dependents at once and writes x ~0.1-0.2 ms later; every PDL consumer
+  (seg_rot_in / seg_linear, single, the Triton rms) must still read the final x. A no-wait PDL consumer beside it
+  shows the early start is real on this GPU (printed, not asserted);
+- the engine: the synthetic checkpoint's windows through ``CudaGraphs`` with TF_DSV41_PDL=1 and TF_DSV41_L2PF=1 ==
+  the same windows with both off, logits bit for bit (x3ld included: TF_DSV41_EXPERT_LOADS=1 on both). Under
+  TF_DSV41_DENSE_V3=1 (prod's lever, exported by the window harness) PDL stays 0 and only L2PF is compared: PDL with
+  DENSE_V3 is not bit-exact (G14) and the boot refuses the pair (``pdl.check``), which the test also asserts;
+- the L2 probe (``l2probe.py``): cold / hot / prefetched read of 6 and 12 MB, the persistence window ([G10] lines).
+"""
+
+from __future__ import annotations
+
+import os
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available() or torch.cuda.get_device_capability()[0] < 9:
+    pytest.skip("needs an sm_90+ NVIDIA GPU", allow_module_level=True)
+
+import triton
+import triton.language as tl
+
+from tensorfold.families.deepseek_v41.cuda import fused_proj as FP
+from tensorfold.families.deepseek_v41.cuda.pdl import gdc_launch_dependents
+
+BF, F32 = torch.bfloat16, torch.float32
+KNOBS = ("TF_DSV41_PDL", "TF_DSV41_L2PF")
+
+
+@pytest.fixture(autouse=True)
+def _knobs_off(monkeypatch):
+    for k in KNOBS:
+        monkeypatch.delenv(k, raising=False)
+
+
+def _lin(k: int, n: int, bits: int, seed: int):
+    from tensorfold.cuda.exl3.linear import Exl3Linear
+
+    g = torch.Generator().manual_seed(seed)
+    tr = torch.randint(-32768, 32767, (k // 16, n // 16, 16 * bits), generator=g, dtype=torch.int32).to(torch.int16)
+    suh = torch.where(torch.rand(k, generator=g) < 0.5, -1.0, 1.0).to(torch.float16)
+    svh = (torch.rand(n, generator=g) * 0.02 + 0.01).to(torch.float16)
+    return Exl3Linear.from_tensors(tr, suh, svh, "mul1", device="cuda")
+
+
+def _up(lin, x, dtype):
+    y = torch.empty((x.shape[0], lin.n), dtype=dtype, device="cuda")
+    for a in range(0, x.shape[0], 128):
+        lin(x[a:a + 128].contiguous(), out=y[a:a + 128])
+    return y
+
+
+SINGLE = [(8192, 4096, 5), (1280, 16384, 5), (4096, 2048, 6), (5120, 1024, 5)]
+
+
+@pytest.mark.parametrize("shape", SINGLE)
+def test_single_equals_upstream(monkeypatch, shape):
+    k, n, bits = shape
+    lin = _lin(k, n, bits, sum(shape))
+    f = FP.single(lin)
+    assert f is not None and f.part == "single" and FP.single(lin) is f
+    gen = torch.Generator(device="cuda").manual_seed(1)
+    for pdl in ("0", "single"):
+        monkeypatch.setenv("TF_DSV41_PDL", pdl)
+        for R in [*range(1, 17), 130]:
+            x = torch.randn((R, k), generator=gen, device="cuda").to(BF)
+            for dtype in (BF, F32) if R in (1, 7, 130) else (BF,):
+                assert torch.equal(f(x, dtype)[0], _up(lin, x, dtype)), (shape, pdl, R, dtype)
+        assert not (f.counters != 0).any()
+
+
+class _Chain:
+    """x [R, 5120] -> x2 group (wq_a 1280, wkv 512) -> rms_pair -> q group (16384, 4096) -> single (16384 -> 1024)
+    -> rms -> plain fp64 (1024 -> 64) and RoPE on the q output: the window's kernel kinds back to back."""
+
+    def __init__(self):
+        from tensorfold.families.deepseek_v41.cuda import linear as LN
+
+        self.x2 = FP.Fused([_lin(5120, 1280, 5, 1), _lin(5120, 512, 5, 2)])
+        self.q = FP.Fused([_lin(1280, 16384, 5, 3), _lin(1280, 4096, 5, 4)])
+        self.wo = LN.Exl3(_lin(16384, 1024, 5, 5))
+        g = torch.Generator(device="cuda").manual_seed(9)
+        self.wq = (torch.rand(1280, generator=g, device="cuda") + 0.5).to(BF)
+        self.wk = (torch.rand(512, generator=g, device="cuda") + 0.5).to(BF)
+        self.wn = (torch.rand(1024, generator=g, device="cuda") + 0.5).to(BF)
+        self.plain = LN.Plain((torch.randn((64, 1024), generator=g, device="cuda") * 0.05).to(BF))
+        self.cs = torch.randn((4096, 64), generator=g, device="cuda").float()
+
+    def __call__(self, x, pos):
+        from tensorfold.families.deepseek_v41.cuda import rmsnorm as RN
+        from tensorfold.families.deepseek_v41.cuda import rope_fused as RF
+
+        qa, kva = self.x2(x, BF)
+        qr, kv = RN.rms_pair(qa, self.wq, kva, self.wk, 1e-6, BF)
+        q, qi = self.q(qr, BF)
+        z = self.wo(q, BF)
+        zn = RN.rms(z, self.wn, 1e-6, BF)
+        w = self.plain(zn, F32)
+        r = RF.apply(q.view(x.shape[0], 128, 128), self.cs, pos, 64)       # RoPE on wq_b's heads (a copy)
+        return [qr, kv, q, qi, z, zn, w, r]
+
+
+def _capture(fn, *args):
+    s = torch.cuda.Stream()
+    s.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(s):
+        fn(*args)
+    torch.cuda.current_stream().wait_stream(s)
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        out = fn(*args)
+    return g, out
+
+
+@pytest.mark.parametrize("R", [1, 2, 5, 16])
+def test_chain_graph_pdl_on_equals_off(monkeypatch, R):
+    ch = _Chain()
+    gen = torch.Generator(device="cuda").manual_seed(R)
+    x = torch.randn((R, 5120), generator=gen, device="cuda").to(BF)
+    pos = torch.arange(100, 100 + R, device="cuda")
+    graphs = {}
+    for v in ("0", "1"):
+        monkeypatch.setenv("TF_DSV41_PDL", v)
+        graphs[v] = _capture(ch, x, pos)
+    monkeypatch.setenv("TF_DSV41_PDL", "0")
+    for step in range(4):
+        x.copy_(torch.randn((R, 5120), generator=gen, device="cuda").to(BF))
+        want = [t.clone() for t in ch(x, pos)]
+        for v, (g, outs) in graphs.items():
+            g.replay()
+            torch.cuda.synchronize()
+            assert all(torch.equal(a, b) for a, b in zip(outs, want)), (R, v, step)
+    assert not (ch.x2.counters != 0).any() and not (ch.q.counters != 0).any()
+
+
+@triton.jit
+def _late(X, SRC, n, SPIN: tl.constexpr, BLOCK: tl.constexpr):
+    gdc_launch_dependents()                     # dependents may launch now: they must wait for our completion
+    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    m = offs < n
+    acc = tl.zeros((BLOCK,), dtype=tl.float32) + 1.0
+    for _ in range(SPIN):
+        acc = acc * 0.999 + 0.001
+    v = tl.load(SRC + offs, mask=m, other=0.0)
+    tl.store(X + offs, tl.where(acc < 0.0, acc, v.to(tl.float32)).to(X.dtype.element_ty), mask=m)
+
+
+@triton.jit
+def _nowait_copy(X, OUT, n, BLOCK: tl.constexpr):  # a PDL launch WITHOUT gdc_wait: deliberately racy (diagnostic)
+    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    m = offs < n
+    tl.store(OUT + offs, tl.load(X + offs, mask=m, other=0.0), mask=m)
+
+
+def test_late_writer_every_consumer_waits(monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda import rmsnorm as RN
+
+    monkeypatch.setenv("TF_DSV41_PDL", "1")
+    fz = FP.Fused([_lin(5120, 1280, 5, 11), _lin(5120, 512, 5, 12)])
+    wo = _lin(5120, 1024, 5, 13)
+    single = FP.single(wo)
+    w = (torch.rand(5120, device="cuda") + 0.5).to(BF)
+    gen = torch.Generator(device="cuda").manual_seed(7)
+    R, n = 4, 4 * 5120
+    raced = 0
+    for trial in range(20):
+        src = torch.randn((R, 5120), generator=gen, device="cuda").to(BF)
+        ref = [*(y.clone() for y in fz(src, BF)), _up(wo, src, BF), RN.rms(src, w, 1e-6, BF)]
+        x = torch.zeros_like(src)
+        outs = []
+        for consumer in ("fz", "single", "rms", "nowait"):
+            x.zero_()
+            _late[(triton.cdiv(n, 1024),)](x, src, n, SPIN=100000, BLOCK=1024)  # plain launch, triggers at once
+            if consumer == "fz":
+                outs += [y.clone() for y in fz(x, BF)]
+            elif consumer == "single":
+                outs.append(single(x, BF)[0].clone())
+            elif consumer == "rms":
+                outs.append(RN.rms(x, w, 1e-6, BF).clone())
+            else:
+                o = torch.empty_like(x)
+                _nowait_copy[(triton.cdiv(n, 1024),)](x, o, n, BLOCK=1024, launch_pdl=True)
+                torch.cuda.synchronize()
+                raced += int(not torch.equal(o, src))
+        torch.cuda.synchronize()
+        assert all(torch.equal(a, b) for a, b in zip(outs, ref)), trial
+    print(f"[G10] PDL late writer: every waiting consumer read the final x in 20 / 20 trials; a no-wait PDL consumer "
+          f"read stale x in {raced} / 20 (early starts {'seen' if raced else 'not seen'} on this GPU)")
+
+
+def test_engine_windows_pdl_l2pf_on_equals_off(monkeypatch, tmp_path):
+    import dsv41_dspark_fakes as DF
+
+    from tensorfold.families.deepseek_v41.cuda import graphs as G
+    from tensorfold.families.deepseek_v41.cuda.forward import Seg
+    from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+
+    from tensorfold.families.deepseek_v41.cuda import dense3 as D3
+    from tensorfold.families.deepseek_v41.cuda import pdl as PD
+
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")
+    monkeypatch.setenv("TF_DSV41_EXPERT_LOADS", "1")
+    # G14: TF_DSV41_PDL=1 is NOT bit-exact with TF_DSV41_DENSE_V3=1 (this test failed with PDL alone + DENSE_V3, also
+    # on prod's 767ad9f; L2PF alone with all of prod's levers passes). Prod runs PDL=0, and the boot refuses the pair.
+    # So with DENSE_V3 on, the "on" side is prod's: PDL=0, L2PF=1; PDL is compared on the strips layout only.
+    dense3_on = D3.enabled()
+    levers = (("TF_DSV41_L2PF", "1"),) if dense3_on else (("TF_DSV41_PDL", "1"), ("TF_DSV41_L2PF", "1"))
+    if dense3_on:
+        monkeypatch.setenv("TF_DSV41_PDL", "1")
+        with pytest.raises(ValueError, match="not bit-exact"):
+            PD.check()
+        monkeypatch.delenv("TF_DSV41_PDL")
+    ck = DF.ckpt(tmp_path / "ck")
+    settings = {"on": True, "budget_s": 120.0, "max_graphs": 64, "bucket": 2048, "slots": 2}
+    prompts = [[int(t) for t in np.random.default_rng(40 + i).integers(3, 250, size=300 + 17 * i)] for i in range(2)]
+
+    def build(on: bool):
+        for k, v in levers:
+            monkeypatch.setenv(k, v) if on else monkeypatch.delenv(k, raising=False)
+        fw = DF.forward(ck, slots=2, limit=4096, dspark=False, device="cuda", chunk=128)
+        b = DF.batcher(ck, fw, n=2, capacity=4096, pool_tokens=3 * 4096)
+        fw.graphs = G.CudaGraphs(fw, settings=settings)
+        fw.graphs.warmup(2, lambda s, end: b.ex.slots[s].ensure(end))
+        for s in range(2):
+            b.ex.slots[s].ensure(4096)
+            fw.reset(s)
+            fw.prefill([Piece(s, 0, tuple(prompts[s]))], mode="full")
+        return fw
+
+    on, off = build(True), build(False)
+    assert any(getattr(blk, "l2pf", None) is not None for blk in on.blocks)
+    rng = np.random.default_rng(3)
+    for step in range(10):
+        widths = [int(rng.choice(G.WIDTHS)) for _ in range(2)]
+        segs = [Seg(s, off.slots[s].pos, tuple(int(t) for t in rng.integers(3, 250, size=widths[s])))
+                for s in range(2) if step % 3 or s == 0]
+        out = {}
+        for name, fw, knob in (("on", on, "1"), ("off", off, None)):
+            for k, _ in levers:
+                monkeypatch.setenv(k, knob) if knob else monkeypatch.delenv(k, raising=False)
+            assert not (dense3_on and PD.parts())           # never PDL with DENSE_V3 (see above)
+            out[name] = fw.graphs.run(segs).clone()
+        assert torch.equal(out["on"], out["off"]), (step, widths)
+        for sg in segs:
+            for fw in (on, off):
+                fw.keep(sg.slot, len(sg.ids) // 2)
+    assert on.graphs.cache.stats["failed"] == 0 and on.graphs.cache.stats["replays"] > 0
+
+
+def test_l2_probe():
+    from tensorfold.families.deepseek_v41.cuda import l2probe
+
+    r = l2probe.probe((6.0, 12.0), 40.0, reps=11)
+    print(f"[G10] l2probe {r['device']}: attrs {r['attrs']}")
+    for row in r["rows"]:
+        print(f"[G10] l2probe {row['mb']} MB: cold {row['cold_us']} us ({row['cold_gbps']} GB/s), hot "
+              f"{row['hot_us']} ({row['hot_gbps']}), l2pf {row['l2pf_us']} ({row['l2pf_gbps']}), persist "
+              f"{row['persist']}")
+        assert row["cold_us"] > 0 and row["hot_us"] > 0
+    assert os.environ.get("TF_DSV41_PDL") is None
