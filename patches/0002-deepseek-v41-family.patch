+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Stall deadlines and diagnostics (G12, bug 2), on the CPU:
+
+- ``stall.Watch``: a round past ``TF_DSV41_STALL_S`` is reported once (rank, round, phase, the batcher's and the
+  forward's state, every thread's stack), again every 4x that, and past ``TF_DSV41_STALL_EXIT_S`` the process exits
+  (70); idle (between rounds, rank 1 waiting for a plan) is never a stall; off when both are 0;
+- the batcher arms it on both ranks and the executor names its phases (rank 0's plan / share / execute; prefill,
+  window, ...), and the report carries the round's plan;
+- the waits that had no deadline: a prefetched Engram read (``prefetch.wait``, ``TF_DSV41_ENGRAM_WAIT_S``) raises,
+  the plan link's socket has TCP keepalive (a dead peer ends rank 1's ``recv``).
+"""
+
+from __future__ import annotations
+
+import io
+import socket
+from concurrent.futures import Future
+
+import pytest
+
+pytest.importorskip("torch")
+
+from test_dsv41_long_prefill_memory import HostForward, QueueLink, _Pool  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import planlink  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import prefetch as PF  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import stall  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.batch import Batcher, Job  # noqa: E402
+
+
+def test_watch_reports_then_exits():
+    out, exits = io.StringIO(), []
+    w = stall.Watch(1, limit_s=10, exit_s=60, out=out, exit_fn=exits.append, info=lambda: ["state: x"])
+    w._thread = object()                        # no thread: the test ticks by hand
+    assert not w.tick(1e9)                      # idle: never a stall
+    w.begin(7, "execute")
+    t0 = w.t_round
+    w.phase("prefill")
+    assert not w.tick(t0 + 9)
+    assert w.tick(t0 + 11) and w.reports == 1
+    text = out.getvalue()
+    assert "r1: round 7 has run 11.0 s" in text and "'prefill'" in text and "state: x" in text
+    assert "test_watch_reports_then_exits" in text          # every thread's stack
+    assert not w.tick(t0 + 30)                  # the next report at 4x the limit
+    assert w.tick(t0 + 52) and w.reports == 2
+    assert not exits
+    assert w.tick(t0 + 61) and exits == [70] and "exiting (70)" in out.getvalue()
+    w.end()
+    assert not w.tick(t0 + 1000)
+
+
+def test_watch_off_and_info_errors():
+    w = stall.Watch(0, limit_s=0, exit_s=0)
+    w.begin(1)
+    assert not w.armed and w._thread is None and not w.tick(1e12)
+    out = io.StringIO()
+
+    def bad():
+        raise RuntimeError("boom")
+
+    w = stall.Watch(0, limit_s=1, exit_s=0, out=out, info=bad)
+    w._thread = object()
+    w.begin(3)
+    assert w.tick(w.t_round + 2) and "state not readable: RuntimeError('boom')" in out.getvalue()
+
+
+def test_watch_thread_fires_on_its_own():
+    out = io.StringIO()
+    w = stall.Watch(0, limit_s=0.05, exit_s=0, out=out, poll_s=0.01)
+    w.begin(1, "window")
+    import time
+
+    deadline = time.monotonic() + 5
+    while not w.reports and time.monotonic() < deadline:
+        time.sleep(0.01)
+    w.end()
+    w.close()
+    assert w.reports >= 1 and "'window'" in out.getvalue()
+
+
+def test_batcher_arms_the_watch_on_both_ranks(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_STALL_S", "300")
+    seen = []
+
+    class Spy(HostForward):
+        def __init__(self, rank):
+            super().__init__()
+            self.rank = rank
+
+        def prefill(self, pieces, *, mode="full"):
+            w = self.batcher.watch
+            seen.append((self.rank, w.armed, w.name, "pieces [(0, 0, 64)]" in "\n".join(self.batcher._stall_info())))
+            super().prefill(pieces, mode=mode)
+
+    import queue
+    import threading
+
+    q: queue.Queue = queue.Queue()
+    f0, f1 = Spy(0), Spy(1)
+    b0 = Batcher(f0, _Pool(), link=QueueLink(q), rank=0, n_slots=1, capacity=1024, depth=0, start=False)
+    b1 = Batcher(f1, _Pool(), link=QueueLink(q), rank=1, n_slots=1, capacity=1024, depth=0, start=False)
+    f0.batcher, f1.batcher = b0, b1
+    th = threading.Thread(target=b1.follow, daemon=True)
+    th.start()
+    b0.submit(Job(list(range(3, 68)), 2))
+    while b0.step():
+        assert not b0.watch.armed               # disarmed between rounds
+    b0.send_stop()
+    th.join(timeout=30)
+    assert sorted(seen) == [(0, True, "prefill", True), (1, True, "prefill", True)]
+    assert not b1.watch.armed
+    b0.stop()
+
+
+def test_engram_wait_deadline(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_ENGRAM_WAIT_S", "0.05")
+    with pytest.raises(TimeoutError, match="TF_DSV41_ENGRAM_WAIT_S"):
+        PF.wait(Future())
+    f = Future()
+    f.set_result(3)
+    assert PF.wait(f) == 3
+
+
+def test_plan_link_keepalive():
+    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    srv.bind(("127.0.0.1", 0))
+    srv.listen(1)
+    a = socket.create_connection(srv.getsockname())
+    b, _ = srv.accept()
+    srv.close()
+    try:
+        planlink.keepalive(a, idle=11, interval=3, count=4)
+        assert a.getsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE) == 1
+        if hasattr(socket, "TCP_KEEPIDLE"):
+            assert a.getsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPIDLE) == 11
+            assert a.getsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPCNT) == 4
+    finally:
+        a.close()
+        b.close()
+
+
+def test_forward_info_without_cuda():
+    class Comm:
+        pass
+
+    class Fw:
+        device = None
+        comm = Comm()
+
+    lines = stall.forward_info(Fw())
+    assert lines == ["NCCL async error: n/a"]
