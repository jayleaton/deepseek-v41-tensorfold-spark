+# -- the real pack's layer 1, when cached --------------------------------------------------------------------------
+def _pack() -> Path | None:
+    p = os.environ.get("TF_DSV41_PACK_CACHE", "").strip()
+    return Path(p) if p and (Path(p) / "headers.json").is_file() else None
+
+
+def _tensor(root: Path, wm: dict, info: dict, name: str) -> np.ndarray:
+    key = hashlib.sha1(f"{wm[name]}:{name}".encode()).hexdigest()[:16]
+    dt, shape = info[name]
+    raw = (root / "tensors" / f"{key}.bin").read_bytes()
+    return np.frombuffer(raw, dtype={"I16": np.int16, "F16": np.float16}[dt]).reshape(shape)
+
+
+@pytest.mark.skipif(_pack() is None, reason="TF_DSV41_PACK_CACHE: the real pack's cached layer-1 tensors")
+@pytest.mark.parametrize("group", ["x", "wo_a"])
+def test_real_layer1_bitwise(group):
+    from tensorfold.cuda.exl3 import format as fmt
+
+    root = _pack()
+    m = json.loads((root / "headers.json").read_text())
+    wm = m["index"].get("weight_map", m["index"])
+    info = {n: (e["dtype"], tuple(e["shape"])) for v in m["headers"].values() for n, e in v["header"].items()
+            if n != "__metadata__"}
+    names = ["wq_a", "wkv"] if group == "x" else [f"wo_a.slice.{g}" for g in range(4)]
+    segs, suh, W, svh = [], [], [], []
+    col = 0
+    for i, nm in enumerate(names):
+        p = f"layers.1.attn.{nm}"
+        tr = _tensor(root, wm, info, f"{p}.trellis")
+        bits = fmt.bits_of(tr.shape)
+        k, n = 16 * tr.shape[0], 16 * tr.shape[1]
+        out = i if group == "x" else 0
+        segs.append(seg(k, n, k2=int(2 * bits), out=out, col=0 if group == "x" else col))
+        col += n
+        W.append(fmt.unpack(tr, bits, "mul1").astype(np.float64))
+        suh.append(_tensor(root, wm, info, f"{p}.suh"))
+        svh.append(_tensor(root, wm, info, f"{p}.svh").astype(np.float32))
+    rng = np.random.default_rng(1)
+    for rows in (1, 3):
+        if group == "x":
+            x = (rng.standard_normal((rows, 5120)) * 0.7).astype(np.float32)
+            xs = [x, x]
+        else:
+            o = (rng.standard_normal((rows, 4 * 4096)) * 0.3).astype(np.float32)
+            xs = [o[:, g * 4096:(g + 1) * 4096] for g in range(4)]       # column slices of o, as blocks passes
+        _compare(segs, xs, suh, W, svh, rows, seeds=(0,))
+
+
+# -- TF_DSV41_PROJ_PLAN=long: other bits than upstream, the same structure -----------------------------------------
+def _long(k: int, n: int, group: str, k2: int = 10, out: int = 0, col: int = 0) -> FP.Seg:
+    sk, wk = FP.PLANS["long"][group]
+    return FP.Seg(k, n, k2, sk, wk, out, col)
+
+
+def test_long_plan_is_valid_on_every_real_shape():
+    groups = {"x": [WQ_A, WKV, COMP], "q": [WQ_B, IX_WQ_B], "o": [WO_A], "wob": [WO_B]}
+    for g, shapes in groups.items():
+        sk, wk = FP.PLANS["long"][g]
+        for k, n in shapes:
+            assert (k // 16) % (sk * wk) == 0 and (k // 16) // (sk * wk) >= 20, (g, k, n)
+    x4 = [_long(*WQ_A, "x", out=0), _long(*WKV, "x", out=1), _long(*COMP, "x", out=2),
+          _long(*COMP, "x", out=2, col=512)]
+    for m in (1, 16, 128):
+        lay = FP.layout(x4, m)
+        assert len(lay.launches) == 1 and lay.launches[0][4] == 4 * (10 + 4 + 4 + 4)
+        check_tiling(lay, x4)
+
