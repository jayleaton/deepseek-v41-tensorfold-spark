+    assert len(t) == 64 and t[15] == 16.0 and t[19] == pytest.approx(16.0 + 14.0 * 4 / 8) and t[23] == 30.0
+    assert t[47] == pytest.approx(56.0) and t[63] == 72.0 and all(b >= a for a, b in itertools.pairwise(t))
+    assert calib.split(24, 2) == [12, 12] and calib.split(48, 3) == [16, 16, 16] and calib.split(7, 2) == [4, 3]
+    assert calib.wide_buckets(4, 64) == [24, 32, 48, 64] and calib.wide_buckets(2, 64) == [24, 32]
