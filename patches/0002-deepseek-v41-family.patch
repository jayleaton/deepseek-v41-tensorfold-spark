+# ---- [G13] timings -------------------------------------------------------------------------------------------------
+
+def _graph_us(fn, reps: int = 20) -> float:
+    fn()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        fn()
+    graph.replay()
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(reps):
+        graph.replay()
+    b.record()
+    torch.cuda.synchronize()
+    return 1000.0 * a.elapsed_time(b) / reps
+
+
+def test_g13_attention_us_a_layer():
+    """40 layers, each with its own 16K compressed rows (9.6 MB) and ring: ~400 MB per pass (> L2), as in a window."""
+
+    L = 40
+    for R in (1, 2, 4, 8, 16):
+        cases = [Case(R, [512, 512, 300, 512], seed=100 + i, n_comp=16384, packed=True, paged=True)
+                 for i in range(L)]
+        sc, tk = attn.Scratch(64, DEV), AC.Ticket(64, H, DEV)
+        outs = [torch.empty_like(c.q) for c in cases]
+        us = {}
+        for cuda in (False, True):
+            us[cuda] = _graph_us(lambda: [c.run(cuda, sc, tk, o) for c, o in zip(cases, outs)]) / L
+        print(f"\n[G13] attn layer R={R}: triton {us[False]:.1f} us, cuda {us[True]:.1f} us "
+              f"({us[True] / us[False]:.2f}x; saved {us[False] - us[True]:.1f} us a layer)")
+        del cases
+
+
+def test_g13_topk_us_a_selection():
+    for n in (2048, 16384, 32768, 75000):
+        for R in (1, 4, 16):
+            ratio = 4
+            P = n * ratio - R
+            s = _scores(R, n, P, ratio, 9)
+            win = Win.make(P, R, DEV)
+            old = _graph_us(lambda: DT.select(s, win.t, ratio, 512))
+            new = _graph_us(lambda: AC.select(s, win.t, ratio, 512))
+            oc = _graph_us(lambda: (DT.select(s, win.t, ratio, 512), DT.blocks(s, win.t, ratio, 2048)))
+            nc = _graph_us(lambda: AC.select_blocks(s, win.t, ratio, 512, 2048))
+            cand = DT.blocks(s, win.t, ratio, 2048)
+            s2 = torch.randn((R, 2048 * 8), device=DEV)
+            og = _graph_us(lambda: DT.gather_cand(s2, cand, win.t, ratio, 512))
+            ng = _graph_us(lambda: AC.gather_cand(s2, cand, win.t, ratio, 512))
+            print(f"\n[G13] topk n={n} R={R}: select dtopk {old:.1f} -> cuda {new:.1f} us; select+blocks "
+                  f"{oc:.1f} -> {nc:.1f}; reindex top-k (16,384) {og:.1f} -> {ng:.1f}")
