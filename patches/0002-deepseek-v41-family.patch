index 0000000..5d9e473
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/csa2/attn_cuda.cpp
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+// Bindings of attn_cuda.cu + topk_cuda.cu (TF_DSV41_ATTN_CUDA; attn_cuda.py checks shapes, strides and alignment).
+#include <torch/extension.h>
+#include <c10/cuda/CUDAGuard.h>
+
+void dsv41_attn_run_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                         const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                         const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                         const at::Tensor&, const at::Tensor&, at::Tensor&, at::Tensor&, at::Tensor&, at::Tensor&,
+                         at::Tensor&, int64_t, int64_t, int64_t, int64_t);
+std::vector<int64_t> dsv41_attn_info_cuda(int64_t);
+void dsv41_topk_run_cuda(const at::Tensor&, const at::Tensor&, at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t,
+                         int64_t, const at::Tensor&, const at::Tensor&, at::Tensor&, at::Tensor&, int64_t, int64_t,
+                         int64_t, int64_t, int64_t, const at::Tensor&, int64_t, int64_t, int64_t, int64_t);
+
+static void dev(const at::Tensor& t, const char* name) {
+    TORCH_CHECK(!t.numel() || t.is_cuda(), "attn_cuda: ", name, " is not on the GPU");
+}
+
+void attn(const at::Tensor& q, const at::Tensor& cv, const at::Tensor& csc, const at::Tensor& tok,
+          const at::Tensor& cnt, const at::Tensor& sv, const at::Tensor& ssc, const at::Tensor& lo,
+          const at::Tensor& hi, const at::Tensor& pos, const at::Tensor& sl, const at::Tensor& pt,
+          const at::Tensor& sink, const at::Tensor& cs, at::Tensor po, at::Tensor pm, at::Tensor pl, at::Tensor out,
+          at::Tensor ticket, int64_t ring, int64_t psh, int64_t pts, int64_t kw) {
+    for (auto* p : {&q, &cv, &csc, &tok, &cnt, &sv, &ssc, &lo, &hi, &pos, &sl, &pt, &sink, &cs}) dev(*p, "an input");
+    TORCH_CHECK(q.scalar_type() == at::kBFloat16 && q.dim() == 3 && q.size(2) == 512 && q.is_contiguous(),
+                "attn_cuda: q bf16 [R, H, 512] contiguous");
+    TORCH_CHECK(out.scalar_type() == at::kBFloat16 && out.is_contiguous() && out.sizes() == q.sizes(),
+                "attn_cuda: out like q");
+    TORCH_CHECK(po.scalar_type() == at::kFloat && pm.scalar_type() == at::kFloat && pl.scalar_type() == at::kFloat &&
+                po.numel() >= 5 * q.size(0) * q.size(1) * 512 && ticket.scalar_type() == at::kInt &&
+                ticket.numel() >= q.size(0) * q.size(1) / 16, "attn_cuda: scratch and ticket sized");
+    c10::cuda::CUDAGuard guard(q.device());
+    dsv41_attn_run_cuda(q, cv, csc, tok, cnt, sv, ssc, lo, hi, pos, sl, pt, sink, cs, po, pm, pl, out, ticket, ring,
+                        psh, pts, kw);
+}
+
+void topk(const at::Tensor& s0, const at::Tensor& c0, at::Tensor o0, at::Tensor n0, int64_t nk0, int64_t k0,
+          int64_t m0, int64_t e0, const at::Tensor& s1, const at::Tensor& c1, at::Tensor o1, at::Tensor n1,
+          int64_t nk1, int64_t k1, int64_t m1, int64_t e1, int64_t jobs, const at::Tensor& pos, int64_t ratio,
+          int64_t bs, int64_t R, int64_t CL) {
+    TORCH_CHECK(s0.is_cuda() && s0.scalar_type() == at::kFloat && s0.stride(1) == 1 &&
+                o0.scalar_type() == at::kInt && o0.stride(1) == 1, "attn_cuda.topk: fp32 scores, int32 out");
+    c10::cuda::CUDAGuard guard(s0.device());
+    dsv41_topk_run_cuda(s0, c0, o0, n0, nk0, k0, m0, e0, s1, c1, o1, n1, nk1, k1, m1, e1, jobs, pos, ratio, bs, R,
+                        CL);
+}
+
+std::vector<int64_t> info(int64_t device) { return dsv41_attn_info_cuda(device); }
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("attn", &attn);
+    m.def("topk", &topk);
+    m.def("info", &info);
+}
