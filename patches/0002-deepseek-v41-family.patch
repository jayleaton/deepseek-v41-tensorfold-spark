+++ b/tests/cuda/test_dsv41_router_gemv_narrow_gpu.py
@@ -0,0 +1,244 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The narrow router kernel and the folded tail on the GPU (TF_DSV41_RG_NARROW / TF_DSV41_RG_TAIL; router_gemv.cu's
+narrow_kernel), at the real geometry (D 5,120; E 384 top-6, E 128 top-3), collected only where PyTorch sees a GPU:
+
+- narrow logits == gemv_kernel's == the numpy model, bit for bit, every NW (1, 2, 4, 8) and R = 1..16;
+- narrow picks / weights == gemv_kernel's bit for bit at R = 1..16 (offsets 0 / 7 / N - R), batched == alone;
+- inside one CUDA graph (R = 1..16, one call each): replays == the old kernel's eager bits, counters back to 0,
+  new inputs replay right;
+- kit: the folded fp16 rounding == pick.kit_weights' two casts of the old weights, bit for bit;
+- group: the folded grouping == upstream's group_kernel (ids, count, members) on the same picks, and router.route_fold;
+- microbench (printed): us a call, old vs narrow (each NW) at R = 1, 2, 4, 8, 16, 40 distinct gates in a CUDA graph;
+  and old + kit casts + group vs the narrow kernel with the folded tail.
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_router_gemv_narrow_gpu.py
+"""
+
+from __future__ import annotations
+
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+import numpy as np
+
+from tensorfold.families.deepseek_v41.cuda import router
+from tensorfold.families.deepseek_v41.cuda import router_gemv as RG
+
+DEV = "cuda"
+D = 5120
+GEOMS = [(384, 6), (128, 3)]
+
+
+def _inputs(R, E, seed, wscale=0.02):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn((R, D), generator=g).to(torch.bfloat16)
+    w = (torch.randn((E, D), generator=g) * wscale).to(torch.bfloat16).contiguous()
+    b = torch.randn(E, generator=g) * 0.01
+    return x.to(DEV), w.to(DEV), b.to(DEV)
+
+
+def _route(x, w, b, topk, narrow, kit=False, group=None, pick=None, wts=None):
+    R = x.shape[0]
+    pick = torch.empty((R, topk + 1), dtype=torch.int32, device=DEV) if pick is None else pick
+    wts = torch.empty((R, topk + 1), dtype=torch.float32, device=DEV) if wts is None else wts
+    done = RG.route(x, w, b, topk, topk + 1, 1.5, pick, wts, narrow=narrow, kit=kit, group=group)
+    return pick, wts, done
+
+
+def _bits(p, w, *_):
+    return p.clone(), w.view(torch.int32).clone()
+
+
+def _eq(a, c):
+    return torch.equal(a[0], c[0]) and torch.equal(a[1], c[1])
+
+
+@pytest.mark.parametrize("E", [384, 128])
+def test_narrow_logits_equal_old_and_model(E):
+    for R in range(1, 17):
+        x, w, _ = _inputs(R, E, 500 + R)
+        old = RG.logits(x, w, narrow=0)
+        for nw in RG.NARROW_NW:
+            new = RG.logits(x, w, narrow=nw)
+            assert torch.equal(new.view(torch.int32), old.view(torch.int32)), (E, R, nw, int((new != old).sum()))
+        if R in (1, 4, 16):
+            want = RG.model_logits(x.cpu(), w.cpu())
+            assert np.array_equal(old.cpu().numpy().view(np.int32), want.view(np.int32)), (E, R)
+
+
+@pytest.mark.parametrize("nw", RG.NARROW_NW)
+@pytest.mark.parametrize("E,topk", GEOMS)
+def test_narrow_route_bits_equal_old_r1_to_16(E, topk, nw):
+    N = 40
+    x, w, b = _inputs(N, E, E + nw)
+    alone = [_bits(*_route(x[r:r + 1].contiguous(), w, b, topk, nw)) for r in range(N)]
+    for R in range(1, 17):
+        for off in sorted({0, 7, N - R}):
+            xs = x[off:off + R].contiguous()
+            old = _bits(*_route(xs, w, b, topk, 0))
+            new = _bits(*_route(xs, w, b, topk, nw))
+            assert _eq(new, old), (R, off)
+            for i in range(R):
+                assert torch.equal(new[0][i], alone[off + i][0][0]) and torch.equal(new[1][i], alone[off + i][1][0])
+
+
+@pytest.mark.parametrize("nw", RG.NARROW_NW)
+def test_narrow_inside_a_cuda_graph(nw):
+    E, topk = 384, 6
+    x, w, b = _inputs(16, E, 77)
+    bufs = [(torch.empty((R, topk + 1), dtype=torch.int32, device=DEV),
+             torch.empty((R, topk + 1), dtype=torch.float32, device=DEV)) for R in range(1, 17)]
+    RG._counters(x.device)
+    st = torch.cuda.Stream()
+    st.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(st):                                      # warm: the extension and counters exist
+        _route(x[:1], w, b, topk, nw)
+    torch.cuda.current_stream().wait_stream(st)
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        for R, (p, q) in zip(range(1, 17), bufs):
+            _route(x[:R], w, b, topk, nw, pick=p, wts=q)
+    cnt = RG._counters(x.device)
+    for step in range(3):
+        if step == 2:
+            x.copy_(_inputs(16, E, 78)[0])
+        g.replay()
+        torch.cuda.synchronize()
+        assert int(cnt.abs().sum()) == 0
+        for R, (p, q) in zip(range(1, 17), bufs):
+            want = _bits(*_route(x[:R].contiguous(), w, b, topk, 0))
+            assert _eq(_bits(p, q), want), (step, R)
+
+
+@pytest.mark.parametrize("narrow", [0, 2])
+@pytest.mark.parametrize("E,topk", GEOMS)
+def test_kit_rounding_folded(E, topk, narrow):
+    x, w, b = _inputs(16, E, 31)
+    for R in (1, 3, 16):
+        p0, w0, _ = _route(x[:R], w, b, topk, 0)
+        p1, w1, _ = _route(x[:R], w, b, topk, narrow, kit=True)
+        assert torch.equal(p0, p1)
+        assert torch.equal(w1.view(torch.int32), w0.to(torch.float16).to(torch.float32).view(torch.int32))
+        assert (w1[:, topk] == 1.0).all()
+
+
+def _group_bufs(R, slots, GE):
+    maxu = min(R * slots, GE)
+    return (torch.full((maxu,), -5, dtype=torch.int32, device=DEV), torch.full((1,), -9, dtype=torch.int32, device=DEV),
+            torch.full((maxu, R), -7, dtype=torch.int32, device=DEV))
+
+
+@pytest.mark.parametrize("nw", [1, 2, 8])
+@pytest.mark.parametrize("E,topk", GEOMS)
+def test_group_folded_equals_upstream(E, topk, nw):
+    from tensorfold.cuda.exl3 import experts as x3
+
+    ext = x3._ext()
+    GE, slots = E + 1, topk + 1
+    x, w, b = _inputs(16, E, 41)
+    x[5] = x[4]                                                      # two rows with the same picks
+    for R in (1, 2, 3, 4, 8, 16):
+        ids, cnt, mem = _group_bufs(R, slots, GE)
+        pick, _, done = _route(x[:R].contiguous(), w, b, topk, nw, kit=True, group=(ids, cnt, mem, GE))
+        assert done
+        uid, ucnt, umem = _group_bufs(R, slots, GE)
+        ext.group(pick, uid, ucnt, umem, R, slots, GE)
+        torch.cuda.synchronize()
+        n = int(ucnt[0])
+        assert int(cnt[0]) == n
+        assert torch.equal(ids[:n], uid[:n]) and torch.equal(mem[:n], umem[:n]), (R, nw)
+        mid, mcount, mmem = RG.model_group(pick.cpu().numpy(), GE, R)
+        assert mcount == n and np.array_equal(ids[:n].cpu().numpy(), mid) and np.array_equal(mem[:n].cpu().numpy(), mmem)
+    ids, cnt, mem = _group_bufs(17, slots, GE)                       # 17 rows: not folded (the caller groups)
+    assert not _route(_inputs(17, E, 3)[0], w, b, topk, nw, group=(ids, cnt, mem, GE))[2]
+    assert not _route(x[:4].contiguous(), w, b, topk, 0, group=_group_bufs(4, slots, GE) + (GE,))[2]
+
+
+def test_route_fold_api(monkeypatch):
+    from tensorfold.cuda.exl3 import experts as x3
+
+    E, topk = 384, 6
+    GE, slots = E + 1, topk + 1
+    x, w, b = _inputs(3, E, 12)
+    monkeypatch.setattr(RG, "NARROW", 2)
+    ids, cnt, mem = _group_bufs(3, slots, GE)
+    p, q, kit_done, grouped = router.route_fold(x, w, b, topk=topk, scale=1.5, kit=True, group=(ids, cnt, mem, GE),
+                                                mode="gemv", fold=True)
+    assert kit_done and grouped
+    p0, w0 = router.route(x, w, b, topk=topk, scale=1.5, mode="gemv")
+    assert torch.equal(p, p0) and torch.equal(q, w0.to(torch.float16).to(torch.float32))
+    uid, ucnt, umem = _group_bufs(3, slots, GE)
+    x3._ext().group(p0, uid, ucnt, umem, 3, slots, GE)
+    n = int(ucnt[0])
+    assert int(cnt[0]) == n and torch.equal(ids[:n], uid[:n]) and torch.equal(mem[:n], umem[:n])
+    p, q, kit_done, grouped = router.route_fold(x, w, b, topk=topk, scale=1.5, kit=True, group=(ids, cnt, mem, GE),
+                                                mode="gemv", fold=False)
+    assert not kit_done and not grouped and torch.equal(q, w0)
+
+
+def _graph_us(calls, reps=20):
+    st = torch.cuda.Stream()
+    st.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(st):
+        for c in calls:
+            c()
+    torch.cuda.current_stream().wait_stream(st)
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        for c in calls:
+            c()
+    g.replay()
+    torch.cuda.synchronize()
+    a, z = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(reps):
+        g.replay()
+    z.record()
+    torch.cuda.synchronize()
+    return a.elapsed_time(z) * 1000 / (reps * len(calls))
+
+
+def _today(ext, x, w, b, topk, pick, wts, grp):
+    """The router + pick.kit_weights' two cast kernels + upstream's group (moe.py / experts.routed today)."""
+
+    ids, cnt, mem, GE = grp
+    RG.route(x, w, b, topk, topk + 1, 1.5, pick, wts, narrow=0)
+    wts.to(torch.float16).to(torch.float32)
+    ext.group(pick, ids, cnt, mem, x.shape[0], topk + 1, GE)
+
+
+def test_time_old_vs_narrow():
+    """Informational: us a call in a CUDA graph of 40 routers (40 distinct gates: no L2 reuse), old gemv_kernel vs the
+    narrow kernel at each NW; then the router + kit casts + upstream group (today) vs narrow with the folded tail."""
+
+    from functools import partial
+
+    from tensorfold.cuda.exl3 import experts as x3
+
+    ext = x3._ext()
+    RG._counters(torch.device(DEV))
+    for E, topk in GEOMS:
+        gates = [_inputs(1, E, 900 + i)[1:] for i in range(40)]
+        for R in (1, 2, 4, 8, 16):
+            x = _inputs(R, E, 950 + R)[0]
+            pick = torch.empty((R, topk + 1), dtype=torch.int32, device=DEV)
+            wts = torch.empty((R, topk + 1), dtype=torch.float32, device=DEV)
+            row = {nw: _graph_us([partial(RG.route, x, w, b, topk, topk + 1, 1.5, pick, wts, narrow=nw)
+                                  for w, b in gates]) for nw in (0, *RG.NARROW_NW)}
+            best = min(RG.NARROW_NW, key=row.get)
+            print(f"[G10] router E {E} R {R}: old {row[0]:.1f} us | narrow " +
+                  " ".join(f"nw{nw} {row[nw]:.1f}" for nw in RG.NARROW_NW) +
+                  f" | best nw{best} {row[0] / row[best]:.2f}x | 40 a window: old {row[0] * 0.04:.2f} ms, "
+                  f"best {row[best] * 0.04:.2f} ms")
+            if E != 384 or R > 4:
+                continue
+            grp = (*_group_bufs(R, topk + 1, E + 1), E + 1)
+            t0 = _graph_us([partial(_today, ext, x, w, b, topk, pick, wts, grp) for w, b in gates])
+            t1 = _graph_us([partial(RG.route, x, w, b, topk, topk + 1, 1.5, pick, wts, narrow=best, kit=True,
+                                    group=grp) for w, b in gates])
+            print(f"[G10] router + kit casts + group, E {E} R {R}: today {t0:.1f} us, narrow nw{best} + folded tail "
+                  f"{t1:.1f} us a layer ({(t0 - t1) * 0.04:.2f} ms a 40-layer window)")
