@@ -0,0 +1,477 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Window G3's M2 measurements on the real checkpoint, both ranks (``python -m ...cuda.m2bench`` on each; rank 1
+follows rank 0's round plans):
+
+- **exact**: per workload, the reply with drafts (DSpark + lookup) == the reply without (``draft=False``, serial
+  rounds), at T = 0 and at T = 0.7 (keyed), past 2,048 tokens of context for the ``long`` prompt;
+- **acceptance**: DSpark tokens a round per workload (``Job.stats["drafting"]``), against the kit's (BASELINE-
+  RESULTS: mixed 2.27; MMLU 1.46, multiturn 1.83, tf 1.78, kit 2.17, tweet 3.08, edit 3.84). Like for like with the
+  kit: TF_DSV41_DEPTH=static TF_DSV41_DRAFT_DEPTH=3 TF_DSV41_LOOKUP=0 (G3's ``kit`` mode);
+- **speed**: single-stream decode tok/s per workload (first to last token), code and prose against section 1.3
+  (code >= 52, prose >= 38) and the kit (36.4 / 25.1); the 4-stream aggregate (4 concurrent requests, wall clock
+  from the first submit, completion tokens) against the kit's C4 37.6;
+- the M2 state (``DecodeForward.describe``: graphs held / replays, Engram prefetch hits, the cost table);
+- per workload and sampling, the last run's DSpark evidence (``depth.Stats``: drafts verified / kept per position,
+  rounds and first drafts kept per bin of the calibrated q_1, zero-depth rounds) and the pass skips
+  (``drafting.skip_rounds``); A/B with TF_DSV41_DRAFT_SKIP=0 (G6);
+- G4: ``--streams 1,2,4`` measures C1 / C2 / C4 (``concurrent``; ``c4`` stays the 4-stream entry), ``--c-sampling``
+  greedy | mixed (G3's: every other stream T = 0.7, top_k 0); the ``structured`` workload (count 1-200, the kit's
+  structured cell); with TF_DSV41_PHASES=1 / sync each workload's T = 0 run reports its per-phase ms (``phases``);
+  the RoCE exchange counts (fast / on NCCL).
+- G15b: every concurrent cell also reports the **steady aggregate** (``steady_tok_s``: tokens per second while all N
+  streams are live, from the last stream's first token to the first stream's last; ``per_stream_steady_tok_s``,
+  ``all_live_s``, ``all_live_frac``). The mixed cells (code + prose + tweet + edit) end with their slowest stream, so
+  their wall-clock aggregate is mostly one stream alone (G13's C2: code done in 100 rounds, prose 128 more alone).
+  ``--c-same code,prose`` adds same-workload cells beside the mixed ones (``C2-code``, ``C2-prose``, ``C4-code``,
+  ...: N streams of one workload, sampling as ``--c-sampling``); ``--c-reps`` runs each cell R times (the headline
+  numbers are the medians, ``reps`` holds each run's). Each stream's reply digest is ``reply_sha``; ``--c-exact``
+  checks every concurrent stream against its request run alone and serial (``draft=False``, one run per distinct
+  workload / sampling): ``exact`` per stream, ``concurrent_exact_all``, and ``exact_all`` includes it.
+
+Graphs on / off is two runs of this module (TF_DSV41_GRAPHS=1 / 0, G3's ``fast`` / ``eager`` modes): their
+reports' replies must be equal token for token and their speeds are the A/B.
+Output: ``--out`` JSON (rank 0).
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import statistics
+import sys
+import time
+from pathlib import Path
+
+KIT = {"mixed": 2.27, "mmlu": 1.46, "multiturn": 1.83, "tf": 1.78, "kit": 2.17, "tweet": 3.08, "edit": 3.84,
+       "c4_tok_s": 37.6, "code_tok_s": 36.4, "prose_tok_s": 25.1}
+TARGET = {"code_tok_s": 52.0, "prose_tok_s": 38.0, "tokens_per_round_k3": 3.1}
+
+CODE = """Write a Python class `LRUCache` with `get(key)` and `put(key, value)` in O(1) using a dict and a doubly linked
+list, with docstrings and type hints, then three unit tests with pytest."""
+PROSE = """Write a 400-word essay on why lighthouses were built where they were, how their keepers lived, and what
+replaced them. Plain prose, no lists or headings."""
+TWEET = """List the first 40 prime numbers as a JSON array, then write a Python one-liner that checks the list, then
+a JSON object {"count": ..., "largest": ..., "sum": ...} for it."""
+MMLU = """Answer with the letter only.
+Which gas makes up most of Earth's atmosphere?
+A. Oxygen
+B. Nitrogen
+C. Argon
+D. Carbon dioxide"""
+EDIT_SRC = "\n".join(
+    f"def handler_{i}(request, session):\n    value = session.get('item_{i}', {i})\n"
+    f"    if value > {i * 3}:\n        return request.respond(value - {i})\n    return request.respond(value)\n"
+    for i in range(24))
+EDIT = "Rename the parameter `session` to `ctx` everywhere in this code and return the whole file, nothing else:\n\n" \
+    + EDIT_SRC
+
+
+STRUCTURED = "Count from 1 to 200, separated by commas, nothing else."
+
+# G17 ``--c-distinct``: the same-workload cells with a different prompt a stream. Without it C4-code runs one prompt
+# 4 times and the T = 0 / T = 0.7 pairs are identical streams (2 distinct sequences, half the distinct experts of 4).
+CODE_MORE = (
+    """Write a Python class `Trie` with `insert(word)`, `search(word)` and `starts_with(prefix)`, with docstrings and
+type hints, then three unit tests with pytest.""",
+    """Write a Python class `TokenBucket` rate limiter with `allow(now: float) -> bool`, refill rate and burst size,
+with docstrings and type hints, then three unit tests with pytest.""",
+    """Write a Python function `merge_intervals(intervals)` that merges overlapping [start, end] pairs in
+O(n log n), with a docstring and type hints, then three unit tests with pytest.""")
+PROSE_MORE = (
+    """Write a 400-word essay on why canals were dug where they were, how the people who worked them lived, and what
+replaced them. Plain prose, no lists or headings.""",
+    """Write a 400-word essay on why early observatories were built where they were, how their astronomers lived, and
+what replaced them. Plain prose, no lists or headings.""",
+    """Write a 400-word essay on why windmills were built where they were, how their millers lived, and what replaced
+them. Plain prose, no lists or headings.""")
+
+
+def workloads(long_text: str) -> dict[str, tuple[str, int]]:
+    """{name: (user message, max tokens)}."""
+
+    out = {"code": (CODE, 384), "prose": (PROSE, 384), "structured": (STRUCTURED, 384), "tweet": (TWEET, 384),
+           "mmlu": (MMLU, 8), "edit": (EDIT, 1024),
+           "long": (long_text + "\n\nSummarize the text above in five sentences.", 192)}
+    for name, more in (("code", CODE_MORE), ("prose", PROSE_MORE)):      # ``--c-distinct`` (not timed alone)
+        for i, msg in enumerate(more, 2):
+            out[f"{name}{i}"] = (msg, 384)
+    return out
+
+
+EXTRA = tuple(f"{w}{i}" for w, more in (("code", CODE_MORE), ("prose", PROSE_MORE)) for i in range(2, len(more) + 2))
+
+
+def distinct(w: str) -> tuple[str, ...]:
+    """``--c-distinct``: a same-workload cell's stream order, one prompt a stream (``code``, ``code2``, ...)."""
+
+    more = {"code": CODE_MORE, "prose": PROSE_MORE}.get(w)
+    return (w,) if more is None else (w, *[f"{w}{i}" for i in range(2, len(more) + 2)])
+
+
+MIXED = ("code", "prose", "tweet", "edit")
+
+
+def steady(clocks) -> dict:
+    """The all-streams-live span (the last stream's first token to the first stream's last) and the tokens each
+    stream committed inside it: the multi-stream rate without the tail where the slowest stream runs alone."""
+
+    live = [c for c in clocks if c.times]
+    if len(live) < 2:
+        return {"steady_tok_s": None, "per_stream_steady_tok_s": [], "all_live_s": 0.0}
+    lo, hi = max(c.times[0] for c in live), min(c.times[-1] for c in live)
+    if hi <= lo:
+        return {"steady_tok_s": None, "per_stream_steady_tok_s": [], "all_live_s": 0.0}
+    per = [sum(1 for t in c.times if lo < t <= hi) for c in clocks]
+    return {"steady_tok_s": round(sum(per) / (hi - lo), 2),
+            "per_stream_steady_tok_s": [round(p / (hi - lo), 2) for p in per], "all_live_s": round(hi - lo, 3)}
+
+
+def concurrent(b, ids, wl, streams: int, hot, mode: str, most: int = 384, order=MIXED) -> dict:
+    """``streams`` requests at once (``order`` cycled: code, prose, tweet, edit; or one workload): aggregate tok/s
+    from the first submit, decode tok/s from the first token to the last, the steady aggregate while every stream is
+    live (``steady``), per stream, drafting stats. ``mode`` mixed: every other stream T = 0.7."""
+
+    import threading
+
+    from .batch import Job
+
+    jobs, clocks, keys = [], [], []
+    t0 = time.perf_counter()
+    order = list(order)
+    for i in range(streams):
+        msg, n = wl[order[i % len(order)]]
+        smp = hot if (mode == "mixed" and i % 2) else None
+        keys.append([order[i % len(order)], "t07" if smp is not None else "t0", min(n, most)])
+        jobs.append(b.submit(Job(ids(msg), min(n, most), smp)))
+    ths = []
+    for j in jobs:
+        c = Clock()
+        clocks.append(c)
+        th = threading.Thread(target=b.collect, args=(j, c))
+        th.start()
+        ths.append(th)
+    for th in ths:
+        th.join()
+    wall = time.perf_counter() - t0
+    total = sum(len(c.toks) for c in clocks)
+    first = min(c.times[0] for c in clocks if c.times)
+    last = max(c.times[-1] for c in clocks if c.times)
+    st = steady(clocks)
+    return {"streams": streams, "sampling": mode, "workloads": [order[i % len(order)] for i in range(streams)],
+            "tokens": total, "wall_s": round(wall, 2),
+            "aggregate_tok_s": round(total / wall, 2), "decode_aggregate_tok_s": round(total / (last - first), 2),
+            **st, "all_live_frac": round(st["all_live_s"] / max(last - first, 1e-9), 3),
+            "per_stream_tok_s": [c.tok_s() for c in clocks], "kit_c4": KIT["c4_tok_s"],
+            "drafting": [j.stats.get("drafting") for j in jobs], "keys": keys,
+            "reply_sha": [sha(c.toks) for c in clocks]}
+
+
+def sha(toks) -> str:
+    return hashlib.sha256(",".join(str(int(t)) for t in toks).encode()).hexdigest()[:16]
+
+
+def serial_check(b, ids, wl, hot, cells: dict) -> bool:
+    """``--c-exact``: each distinct (workload, sampling, tokens) of the concurrent cells run alone and serial
+    (``draft=False``); every stream's ``reply_sha`` against it -> ``exact`` per stream (every run of the cell)."""
+
+    ref: dict = {}
+    ok = True
+    for c in cells.values():
+        shas = [c["reply_sha"]] + [r["reply_sha"] for r in c.get("reps", [])]
+        for key in c["keys"]:
+            k = tuple(key)
+            if k not in ref:
+                s = Clock()
+                b.generate(ids(wl[k[0]][0]), k[2], hot if k[1] == "t07" else None, s, draft=False)
+                ref[k] = sha(s.toks)
+        c["exact"] = [all(run[i] == ref[tuple(key)] for run in shas) for i, key in enumerate(c["keys"])]
+        ok = ok and all(c["exact"])
+    return ok
+
+
+HEAD = ("aggregate_tok_s", "decode_aggregate_tok_s", "steady_tok_s")
+
+
+def cell(b, ids, wl, n: int, hot, mode: str, reps: int, order=MIXED) -> dict:
+    """``concurrent`` ``reps`` times: the last run's report with the headline rates replaced by the medians (each
+    run's in ``reps``)."""
+
+    from .phases import PH
+
+    runs = []
+    for _ in range(max(1, int(reps))):
+        PH.reset()
+        runs.append(concurrent(b, ids, wl, n, hot, mode, order=order))
+    c = dict(runs[-1])
+    if PH.on:
+        c["phases"] = PH.report()
+    if len(runs) > 1:
+        c["reps"] = [{k: r[k] for k in (*HEAD, "per_stream_steady_tok_s", "per_stream_tok_s", "reply_sha")}
+                     for r in runs]
+        for k in HEAD:
+            vals = [r[k] for r in runs if r[k] is not None]
+            c[k] = round(statistics.median(vals), 2) if vals else None
+    return c
+
+
+def long_text() -> str:
+    """~3K tokens of varied text (the context of the ``long`` prompt: past 2,048 tokens)."""
+
+    parts = []
+    for i in range(60):
+        parts.append(f"Section {i + 1}. The survey team reached waypoint {i * 7 % 23} after {3 + i % 5} hours; the "
+                     f"river was {'high' if i % 3 else 'low'}, the camp at {100 + 13 * i} metres, and the log notes "
+                     f"{['rain', 'wind', 'clear skies', 'fog'][i % 4]} with {i % 6 + 1} instruments recalibrated.")
+    return "\n".join(parts)
+
+
+class Clock:
+    """``on_tokens`` that records when tokens arrive (decode speed = first to last token)."""
+
+    def __init__(self) -> None:
+        self.times: list[float] = []
+        self.toks: list[int] = []
+
+    def __call__(self, new: list[int]) -> bool:
+        now = time.perf_counter()
+        self.times += [now] * len(new)
+        self.toks += list(new)
+        return False
+
+    def tok_s(self) -> float | None:
+        if len(self.times) < 8:
+            return None
+        return round((len(self.times) - 1) / max(self.times[-1] - self.times[0], 1e-9), 2)
+
+
+def run_rank0(eng, a) -> dict:
+    from tokenizers import Tokenizer
+
+    from tensorfold.engine.exact_sampling import Sampling
+
+    from .encoding import encode
+    from .phases import PH
+
+    tok = Tokenizer.from_file(str(Path(a.model) / "tokenizer.json"))
+
+    def ids(msg: str) -> list[int]:
+        return list(tok.encode(encode([{"role": "user", "content": msg}], thinking=False),
+                                add_special_tokens=False).ids)
+
+    b = eng.batch
+    hot = Sampling(seed=1234, temperature=0.7, top_k=0, top_p=0.95)
+    rep: dict = {"knobs": {k: v for k, v in sorted(os.environ.items()) if k.startswith(("TF_DSV41_", "GLM53_TF_"))},
+                 "m2": eng.fw.describe() if hasattr(eng.fw, "describe") else "", "workloads": {}, "kit": KIT,
+                 "targets": TARGET}
+    wl = workloads(long_text())
+    if a.nsys == "prefill" or (a.prefill and not a.nsys):
+        return prefill(b, a, rep)
+    if a.nsys:
+        return profile(b, ids, wl, hot, a, rep)
+    names = [n for n in wl if (not a.only and n not in EXTRA) or n in a.only.split(",")]
+    for name in names:
+        msg, n = wl[name]
+        p = ids(msg)
+        row: dict = {"prompt_tokens": len(p)}
+        for tag, smp in (("t0", None), ("t07", hot)):
+            runs = []
+            dstats = getattr(getattr(eng.fw, "depth", None), "stats", None)
+            for _ in range(a.reps):
+                c = Clock()
+                PH.reset()
+                if dstats is not None:
+                    dstats.reset()
+                st = b.generate(p, n, smp, c, draft=True)
+                runs.append((c, st))
+            c, st = runs[-1]
+            dr = st.get("drafting", {})
+            row[tag] = {"tok_s": statistics.median([r[0].tok_s() or 0.0 for r in runs]),
+                        "completion": len(c.toks), "drafting": dr, "reply": c.toks}
+            if dstats is not None:          # the last run's acceptance per position and per q_1 bin (depth.Stats)
+                row[tag]["depth"] = dstats.report()
+            if PH.on:
+                row[tag]["phases"] = PH.report()
+            if a.exact:
+                s = Clock()
+                b.generate(p, n, smp, s, draft=False)
+                row[tag]["serial_tok_s"] = s.tok_s()
+                row[tag]["exact"] = s.toks == c.toks
+        rep["workloads"][name] = row
+        print(f"[m2bench] {name}: T0 {row['t0']['tok_s']} tok/s, {row['t0']['drafting'].get('tokens_per_round')} "
+              f"tok/round (DSpark {row['t0']['drafting'].get('dspark_tokens_per_round')}), exact "
+              f"{row['t0'].get('exact')}/{row['t07'].get('exact')}", flush=True)
+    rep["concurrent"] = {}
+    same = [w for w in str(a.c_same).split(",") if w.strip()]
+    for w in same:
+        if w not in wl:
+            raise ValueError(f"--c-same {w!r}: not a workload ({', '.join(wl)})")
+    for n in [int(v) for v in str(a.streams).split(",") if v.strip()]:
+        if n < 1:
+            continue
+        cells = [(f"C{n}", MIXED)] + ([(f"C{n}-{w}", distinct(w) if a.c_distinct else (w,)) for w in same]
+                                      if n > 1 else [])
+        for name, order in cells:
+            c = cell(b, ids, wl, n, hot, a.c_sampling, a.c_reps, order)
+            rep["concurrent"][name] = c
+            if name == "C4":
+                rep["c4"] = c
+            print(f"[m2bench] {name}: {c['aggregate_tok_s']} tok/s aggregate, {c['decode_aggregate_tok_s']} decode, "
+                  f"{c['steady_tok_s']} steady (all live {c['all_live_frac']:.0%}; {a.c_sampling}; kit C1 / C2 / C4 "
+                  f"32.2 / 46.7 / 37.6)", flush=True)
+    dsp = [w["t0"]["drafting"] for w in rep["workloads"].values() if w["t0"]["drafting"].get("dspark_rounds")]
+    if dsp:
+        rounds = sum(d["dspark_rounds"] for d in dsp)
+        rep["dspark_tokens_per_round_mixed"] = round(1 + sum(d["dspark_kept"] for d in dsp) / rounds, 3)
+    rep["exact_all"] = all(w[t].get("exact", True) for w in rep["workloads"].values() for t in ("t0", "t07"))
+    if a.c_exact and rep["concurrent"]:
+        rep["concurrent_exact_all"] = serial_check(b, ids, wl, hot, rep["concurrent"])
+        rep["exact_all"] = rep["exact_all"] and rep["concurrent_exact_all"]
+        per = ", ".join(f"{k} {v['exact']}" for k, v in rep["concurrent"].items())
+        print(f"[m2bench] concurrent == serial: {rep['concurrent_exact_all']} ({per})", flush=True)
+    rep["m2_after"] = eng.fw.describe() if hasattr(eng.fw, "describe") else ""
+    comm = getattr(eng.fw, "comm", None)
+    rep["comm"] = {"backend": type(comm).__name__, "fast_ops": getattr(comm, "fast_ops", None),
+                   "slow_ops": getattr(comm, "slow_ops", None)}
+    return rep
+
+
+def profile(b, ids, wl, hot, a, rep: dict) -> dict:
+    """``--nsys single | c4``: one warm request, then ``cudaProfilerStart`` (nsys ``--capture-range=cudaProfilerApi``),
+    the decode under capture (single: code then prose, T = 0, 160 tokens each; c4: 4 concurrent streams of 160 tokens,
+    ``--c-sampling``), ``cudaProfilerStop``. Phases as NVTX ranges with TF_DSV41_PHASES=nvtx."""
+
+    import torch
+
+    from .phases import PH
+
+    b.generate(ids(wl["code"][0]), 24, None, Clock(), draft=True)          # Triton / graphs warm
+    PH.reset()
+    torch.cuda.synchronize()
+    torch.cuda.profiler.start()
+    t0 = time.perf_counter()
+    if a.nsys in ("single", "prose", "code"):
+        out = {}
+        for name in (("code", "prose") if a.nsys == "single" else (a.nsys,)):
+            c = Clock()
+            st = b.generate(ids(wl[name][0]), 160, None, c, draft=True)
+            out[name] = {"tok_s": c.tok_s(), "drafting": st.get("drafting", {})}
+    else:
+        n = 2 if a.nsys == "c2" else 4                  # c2: code + prose at once
+        out = {f"C{n}": concurrent(b, ids, wl, n, hot, a.c_sampling, most=160)}
+    torch.cuda.synchronize()
+    torch.cuda.profiler.stop()
+    rep["profile"] = {"mode": a.nsys, "wall_s": round(time.perf_counter() - t0, 2), "runs": out,
+                      "phases": PH.report() if PH.on else None}
+    rep["exact_all"] = True
+    print(f"[m2bench] nsys {a.nsys}: {json.dumps(out)[:300]}", flush=True)
+    return rep
+
+
+def prefill_ids(n: int, seed: int) -> list[int]:
+    """``n`` prompt ids: BOS + random text-range ids (a different seed a size: no prefix is shared)."""
+
+    import random
+
+    rng = random.Random(seed)
+    return [0] + [rng.randrange(1000, 120_000) for _ in range(n - 1)]
+
+
+def prefill(b, a, rep: dict) -> dict:
+    """``--prefill 8192,32768,...``: cold prefill speed (G4). A 2,048-token warm-up, then each size once: a fresh
+    random prompt (no shared prefix), one greedy token, no drafting; ``ttft_s`` from the batcher (submit -> first
+    token) and prompt tok/s. With ``--nsys prefill`` only the first size runs, under cudaProfilerStart / Stop."""
+
+    import torch
+
+    from .phases import PH
+
+    sizes = [int(v) for v in str(a.prefill or "32768").split(",") if v.strip()]
+    reply = max(1, int(getattr(a, "prefill_reply", 1) or 1))
+    b.generate(prefill_ids(2048, 1), 1, None, Clock(), draft=False)       # Triton / extensions warm
+    out = []
+    for i, n in enumerate(sizes[:1] if a.nsys else sizes):
+        p = prefill_ids(n, 100 + i)
+        PH.reset()
+        torch.cuda.synchronize()
+        if a.nsys:
+            torch.cuda.profiler.start()
+        t0 = time.perf_counter()
+        clock = Clock()
+        st = b.generate(p, reply, None, clock, draft=False, stop_eos=False) if reply > 1 else \
+            b.generate(p, 1, None, clock, draft=False)
+        wall = time.perf_counter() - t0
+        torch.cuda.synchronize()
+        if a.nsys:
+            torch.cuda.profiler.stop()
+        ttft = st.get("ttft_s") or wall
+        row = {"tokens": n, "ttft_s": round(ttft, 2), "wall_s": round(wall, 2), "tok_s": round(n / ttft, 1)}
+        if reply > 1:       # G16 --prefill-reply: the greedy reply after the cold prompt (its state) as a digest
+            row.update(first=int(clock.toks[0]) if clock.toks else None, reply_n=len(clock.toks),
+                       reply_sha=sha(clock.toks))
+        if PH.on:
+            row["phases"] = PH.report()
+        out.append(row)
+        print(f"[m2bench] prefill {n}: {row['ttft_s']} s to the first token, {row['tok_s']} tok/s", flush=True)
+    rep["prefill"] = out
+    rep["exact_all"] = True
+    return rep
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--rank", type=int, required=True)
+    ap.add_argument("--master", required=True)
+    ap.add_argument("--port", type=int, default=29561)
+    ap.add_argument("--out", default="m2-report.json")
+    ap.add_argument("--context", type=int, default=16384)
+    ap.add_argument("--parallel", type=int, default=4)
+    ap.add_argument("--streams", default="4", help="concurrent request counts, e.g. 1,2,4 (C1 / C2 / C4)")
+    ap.add_argument("--c-sampling", default="mixed", choices=("mixed", "greedy"),
+                    help="mixed: every other concurrent stream at T = 0.7 (G3's); greedy: all T = 0")
+    ap.add_argument("--c-same", default="", help="same-workload concurrent cells beside the mixed ones, e.g. "
+                    "code,prose (C2-code, C2-prose, C4-code, ...; G15b)")
+    ap.add_argument("--c-reps", type=int, default=1, help="runs of each concurrent cell (headline = median)")
+    ap.add_argument("--c-distinct", action="store_true", help="G17: the --c-same cells with a different prompt a "
+                    "stream (code, code2, code3, code4; prose likewise), not one prompt N times")
+    ap.add_argument("--c-exact", action="store_true", help="every concurrent stream == its request alone, serial")
+    ap.add_argument("--reps", type=int, default=2)
+    ap.add_argument("--only", default="", help="comma-separated workloads (default all)")
+    ap.add_argument("--no-exact", dest="exact", action="store_false")
+    ap.add_argument("--prefill", default="", help="cold prefill sizes, e.g. 8192,32768,65536 (no decode measurement)")
+    ap.add_argument("--prefill-reply", type=int, default=1, help="G16: greedy tokens after each cold prompt (> 1: "
+                    "the first token and a SHA-256 of the reply in the row, for exactness across configs)")
+    ap.add_argument("--nsys", default="", choices=("", "single", "code", "prose", "c2", "c4", "prefill"),
+                    help="profile mode: decode under cudaProfilerStart/Stop for nsys (no other measurement)")
+    a = ap.parse_args(argv)
+    from .engine import Dsv41Engine
+
+    t0 = time.time()
+    eng = Dsv41Engine(Path(a.model), rank=a.rank, master=a.master, port=a.port, context=a.context,
+                      parallel=a.parallel, serving=True)
+    boot = round(time.time() - t0, 1)
+    if a.rank != 0:
+        eng.follow()
+        return 0
+    rc = 0
+    try:
+        rep = run_rank0(eng, a)
+        rep["boot_s"] = boot
+        Path(a.out).write_text(json.dumps(rep, indent=1))
+        rc = 0 if rep["exact_all"] else 3
+        print(f"[m2bench] report {a.out}: exact {rep['exact_all']}, DSpark mixed "
+              f"{rep.get('dspark_tokens_per_round_mixed')} tok/round", flush=True)
+    except Exception as exc:          # noqa: BLE001 - rank 1 must still be told to stop
+        print(f"[m2bench] failed: {type(exc).__name__}: {exc}", file=sys.stderr, flush=True)
+        rc = 1
+    finally:
+        eng.batch.stop()
+        eng.batch.send_stop()
+    return rc
+
+
+if __name__ == "__main__":
+    sys.exit(main())
