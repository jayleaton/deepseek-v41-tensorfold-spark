index 0000000..9fab28e
--- /dev/null
+++ b/tests/test_dsv41_x3tc_interp.py
@@ -0,0 +1,116 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The fast prefill experts' Triton kernels (``x3tc``) in Triton's CPU interpreter:
+
+- the in-kernel mul1 decode == upstream's ``exl3.format.unpack`` bit for bit (2, 3, 4, 5 bits; random trellises);
+- the routed experts == the float64 math of the dequantized experts (fp16 rotated inputs: rounding-level);
+- row independence, bit for bit: rows alone == in the block, any row blocks, an expert with more members than one
+  program holds (several member blocks)."""
+
+from __future__ import annotations
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401  (fixture)
+
+interpret()
+
+import numpy as np  # noqa: E402
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+pytestmark = [pytest.mark.torch, pytest.mark.usefixtures("gpu_like")]
+
+from tensorfold.cuda.exl3 import format as fmt  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import x3tc  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.weights import X3Stack  # noqa: E402
+
+if type(x3tc._decode_kernel).__name__ != "InterpretedFunction":
+    pytest.skip("Triton's CPU interpreter (a GPU runs the compiled kernels: tests/cuda)", allow_module_level=True)
+
+D, I, E, S = 256, 256, 6, 2
+LIMIT = 10.0
+
+
+def trellis(k: int, n: int, bits: int, seed: int, e: int | None = None) -> torch.Tensor:
+    g = np.random.default_rng(seed)
+    shape = (k // 16, n // 16, 16 * bits) if e is None else (e, k // 16, n // 16, 16 * bits)
+    return torch.from_numpy(g.integers(-32768, 32768, size=shape, dtype=np.int64).astype(np.int16))
+
+
+@pytest.mark.parametrize("bits", [2, 3, 4, 5])
+def test_decode_is_upstreams_unpack(bits):
+    t = trellis(256, 256, bits, bits)
+    got = x3tc.decode(t, asm=False)
+    want = torch.from_numpy(fmt.unpack(t.numpy(), bits, "mul1"))
+    assert torch.equal(got.view(torch.int16), want.view(torch.int16))
+
+
+def stack(k: int, n: int, bits: int, seed: int) -> X3Stack:
+    g = np.random.default_rng(seed + 100)
+    suh = torch.from_numpy((g.choice([-1.0, 1.0], size=(E, k)) * g.uniform(0.5, 1.5, size=(E, k))).astype(np.float16))
+    svh = torch.from_numpy((g.choice([-1.0, 1.0], size=(E, n)) * g.uniform(0.002, 0.004, size=(E, n)))
+                           .astype(np.float16))
+    return X3Stack(trellis(k, n, bits, seed, E).contiguous(), suh, svh, "mul1")
+
+
+@pytest.fixture(scope="module")
+def layer():
+    return stack(D, I, 3, 1), stack(D, I, 3, 2), stack(I, D, 3, 3)
+
+
+def inputs(R: int, seed: int, skew: bool = False):
+    g = torch.Generator().manual_seed(seed)
+    x = (torch.randn(R, D, generator=g) * 0.5).to(torch.bfloat16)
+    pick = torch.stack([torch.randperm(E, generator=g)[:S] for _ in range(R)]).to(torch.int32)
+    if skew:
+        pick[:, 0] = 2                                  # expert 2: every row (more than one member block)
+        pick[:, 1] = torch.where(pick[:, 1] == 2, torch.full_like(pick[:, 1], 3), pick[:, 1])
+    w = (torch.rand(R, S, generator=g) + 0.2).to(torch.float16).to(torch.float32)
+    return x, pick, w
+
+
+def reference(x, pick, w, layer) -> torch.Tensor:
+    gate, up, down = layer
+    W = [[torch.from_numpy(fmt.dequantize(m.trellis[e].numpy(), m.suh[e].numpy(), m.svh[e].numpy(), 3, "mul1"))
+          for e in range(E)] for m in (gate, up, down)]
+    out = torch.zeros(x.shape[0], D, dtype=torch.float64)
+    xf = x.double()
+    for r in range(x.shape[0]):
+        for k in range(S):
+            e = int(pick[r, k])
+            gg = (xf[r] @ W[0][e]).clamp(max=LIMIT)
+            uu = (xf[r] @ W[1][e]).clamp(-LIMIT, LIMIT)
+            out[r] += float(w[r, k]) * ((torch.nn.functional.silu(gg) * uu) @ W[2][e])
+    return out
+
+
+def test_routed_matches_float64(layer):
+    x, pick, w = inputs(40, 7, skew=True)
+    got = x3tc.run(x, pick, w, *layer, LIMIT, rows=64, asm=False)
+    want = reference(x, pick, w, layer)
+    err = (got.double() - want).abs().max() / want.abs().max()
+    assert float(err) < 2e-3                            # fp16 inputs: ~3e-4 measured
+
+
+def test_routed_rows_are_independent(layer):
+    x, pick, w = inputs(40, 8, skew=True)
+    whole = x3tc.run(x, pick, w, *layer, LIMIT, rows=64, asm=False)
+    blocks = x3tc.run(x, pick, w, *layer, LIMIT, rows=16, asm=False)
+    assert torch.equal(whole, blocks)
+    sub = [3, 17, 18, 39]
+    alone = x3tc.run(x[sub], pick[sub], w[sub], *layer, LIMIT, rows=64, asm=False)
+    assert torch.equal(alone, whole[sub])
+
+
+def test_items_cover_every_pair():
+    pick = torch.tensor([[2, 0], [2, 1], [2, 0], [5, 2]], dtype=torch.int32)
+    ie, im, cnt, off, order, n = x3tc.items(pick, E)
+    assert cnt.tolist() == [2, 1, 4, 0, 0, 1]
+    pairs = []
+    for i in range(n):
+        e = int(ie[i])
+        if e >= E:
+            continue
+        m = int(im[i])
+        pairs += order[int(off[e]) + m * x3tc.BM: int(off[e]) + min(int(cnt[e]), (m + 1) * x3tc.BM)].tolist()
+    assert sorted(pairs) == list(range(8))
diff --git a/tests/test_dsv41_xovl.py b/tests/test_dsv41_xovl.py
new file mode 100644
index 0000000..7c907a0
--- /dev/null
+++ b/tests/test_dsv41_xovl.py
@@ -0,0 +1,123 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16 ``TF_DSV41_PF_XOVL`` on the CPU (no GPU): a prefill segment's exchanges by row halves.
+
+- TP=2 (two ranks on threads): XOVL on == off bit for bit (the verify row's logits after the prompt and every stored
+  state of both ranks), with fp32 and bf16 prefill exchanges, with and without ``TF_DSV41_PF_COPIES``, one segment
+  and several; every prefill exchange really went in two halves (both ranks issue the same gathers in order), the
+  Engram posts and the final post took the halves, and verify rows never split;
+- the gate: off by default, the row floor, prefill runs only; the halves (the first a multiple of 16 rows); the row
+  views of the coefficients / scratch write the caller's rows.
+
+Run: python -m pytest -q tests/test_dsv41_xovl.py
+"""
+
+from __future__ import annotations
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import json  # noqa: E402
+
+import dsv41_fakes as FK  # noqa: E402
+from test_dsv41_pf16 import IDS, make, state  # noqa: E402  (the builders)
+
+from tensorfold.families.deepseek_v41.cuda import xovl as XO  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece  # noqa: E402
+
+
+@pytest.fixture(scope="module")
+def ckpt(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41xovl"))
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg)
+
+
+def pair(ckpt, monkeypatch, *, xovl: bool, bf16: bool, copies: bool, pchunk: int = 36):
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    monkeypatch.setenv("TF_DSV41_PF_XOVL", "1" if xovl else "0")
+    monkeypatch.setenv("TF_DSV41_PF_XOVL_ROWS", "32")
+    monkeypatch.setenv("TF_DSV41_PF_COPIES", "1" if copies else "0")
+    p = FK.ThreadPair()
+    comms = p.comms()
+    fws = [make(ckpt, r, 2, comms[r], pchunk) for r in range(2)]
+    seen: list[list] = [[], []]
+    for r, fw in enumerate(fws):
+        fw.gather_bf16 = bf16
+        real = fw.gather_partials
+
+        def spy(partial, wide=False, real=real, r=r):
+            if not wide:
+                seen[r].append(int(partial.shape[0]))
+            return real(partial, wide)
+
+        fw.gather_partials = spy
+
+    def go(fw):
+        fw.prefill([Piece(0, 0, tuple(IDS[:-1]))])
+        return fw.step([IDS[-1]]), state(fw)
+
+    return p.run([lambda f=f: go(f) for f in fws]), seen
+
+
+@pytest.mark.parametrize("bf16,copies", [(False, False), (True, False), (True, True)])
+def test_xovl_tp2_same_bits(ckpt, monkeypatch, bf16, copies):
+    got, seen = pair(ckpt, monkeypatch, xovl=True, bf16=bf16, copies=copies)
+    want, seen0 = pair(ckpt, monkeypatch, xovl=False, bf16=bf16, copies=copies)
+    assert seen[0] == seen[1]                               # both ranks: the same gathers in the same order
+    assert 36 not in seen[0] and seen[0].count(16) == seen[0].count(20) > 0     # every prefill exchange in halves
+    assert 36 in seen0[0] and 16 not in seen0[0]
+    assert all(n <= 4 for n in seen[0] if n not in (16, 20))                     # verify rows never split
+    for (lg, st), (lw, sw) in zip(got, want):
+        assert torch.equal(lg, lw)
+        for k in sw:
+            assert torch.equal(st[k], sw[k]), k
+
+
+def test_xovl_chunked_same_bits(ckpt, monkeypatch):
+    """8-row segments sit under the row floor (no split) and give the same bits as one split 36-row segment."""
+
+    got, seen = pair(ckpt, monkeypatch, xovl=True, bf16=True, copies=True, pchunk=8)
+    one, _ = pair(ckpt, monkeypatch, xovl=True, bf16=True, copies=True, pchunk=36)
+    assert 16 not in seen[0]
+    for (lg, st), (lw, sw) in zip(got, one):
+        assert torch.equal(lg, lw)
+        for k in sw:
+            assert torch.equal(st[k], sw[k]), k
+
+
+def test_gate_and_halves(monkeypatch):
+    from types import SimpleNamespace
+
+    from tensorfold.families.deepseek_v41.cuda import prefill_mm as PM
+
+    fw = SimpleNamespace(world=2, chunk=128)
+    monkeypatch.delenv("TF_DSV41_PF_XOVL", raising=False)
+    with PM.fast(True):
+        assert not XO.active(fw, 2048)
+        monkeypatch.setenv("TF_DSV41_PF_XOVL", "1")
+        assert XO.active(fw, 2048) and not XO.active(fw, 511)
+        assert not XO.active(SimpleNamespace(world=1, chunk=128), 2048)
+    assert not XO.active(fw, 2048)                          # not a fast prefill run
+    assert XO.spans(2048) == [(0, 1024), (1024, 2048)]
+    assert XO.spans(2047) == [(0, 1008), (1008, 2047)]
+    monkeypatch.setenv("TF_DSV41_PF_XOVL_ROWS", "8")
+    with pytest.raises(ValueError):
+        XO.min_rows()
+
+
+def test_views_write_the_callers_rows():
+    from tensorfold.families.deepseek_v41.cuda import mhc
+
+    c = mhc.Coefs(10, "cpu")
+    v = XO.coefs_view(c, 4, 7)
+    v.pre[:] = 1.0
+    v.comb[:] = 2.0
+    assert c.pre[4:7].eq(1).all() and c.pre[:4].eq(0).all() and c.comb[4:7].eq(2).all()
+    s = mhc.Scratch(10, "cpu", 640)
+    w = XO.scratch_view(s, 2, 9)
+    assert w.rows == 7 and w.part.data_ptr() == s.part[2].data_ptr() and w.c.data_ptr() == s.c[2].data_ptr()
+    assert s.rows == 10
diff --git a/tests/test_roce_g14_compile.py b/tests/test_roce_g14_compile.py
new file mode 100644
index 0000000..6967d3d
--- /dev/null
+++ b/tests/test_roce_g14_compile.py
@@ -0,0 +1,155 @@
+"""G14 (GLM53_TF_ROCE_FAST): ``glm5_next/spark/roce.cu`` builds for sm_121 (GB10) without a GPU, and the PTX holds what
+the fast path's claims rest on. Needs an nvcc that knows compute_121 (TF_NVCC, PATH or CUDA_HOME).
+
+- both kernels (``gather_kernel``, unchanged, and ``gather_fast_kernel``): <= 64 registers (``__launch_bounds__(1024)``),
+  no spills, the 8-byte stack frame the classic kernel already had (the failed wait's ``seen`` word);
+- the classic kernel keeps 0350's ``fence.sc.sys`` pairs and the 64-bit ``atomicMax`` trace stamp (now only for a
+  device ring), and its tail's system-scope read of the host failure word;
+- the fast kernel: the lean doorbell (byte counts stored before the ``st.release.sys`` of the sequence), the local
+  shard copied AFTER that release and BEFORE the first poll (the copy runs in the wait's shadow), ``nanosleep`` for the
+  poller stagger, ``fence.sc.sys`` only in the failure record (2), no ``fence.sc.gpu`` at all, no 64-bit atomic, and
+  the peer slot read with two 16-byte system loads in flight before their stores;
+- ``roce.cpp`` passes ``g++ -fsyntax-only`` when ``TF_CXX_INC`` names a directory with c10/cuda and infiniband headers.
+
+    TF_NVCC=<nvcc> [TF_CXX_INC=<dir>] pytest -q tests/test_roce_g14_compile.py
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+import subprocess
+import sysconfig
+from pathlib import Path
+
+import pytest
+
+SRC = Path(__file__).resolve().parents[1] / "src/tensorfold/families/glm5_next/spark"
+FLAGS = ["-arch=sm_121", "-O3", "-include", "cstdint"]
+
+
+def _nvcc() -> str | None:
+    for cand in (os.environ.get("TF_NVCC"), shutil.which("nvcc"),
+                 os.path.join(os.environ.get("CUDA_HOME", "/usr/local/cuda"), "bin", "nvcc")):
+        if cand and os.path.exists(cand):
+            try:
+                archs = subprocess.run([cand, "--list-gpu-arch"], capture_output=True, text=True, timeout=60,
+                                       check=False).stdout
+            except (OSError, subprocess.SubprocessError):
+                continue
+            if "compute_121" in archs:
+                return cand
+    return None
+
+
+NVCC = _nvcc()
+needs_nvcc = pytest.mark.skipif(NVCC is None, reason="no nvcc with compute_121 (TF_NVCC)")
+
+
+@pytest.fixture(scope="module")
+def built(tmp_path_factory):
+    if NVCC is None:
+        pytest.skip("no nvcc with compute_121 (TF_NVCC)")
+    td = tmp_path_factory.mktemp("roce_g14")
+    r = subprocess.run([NVCC, *FLAGS, "-cubin", "-Xptxas", "-v", "-o", str(td / "k.cubin"), str(SRC / "roce.cu")],
+                       capture_output=True, text=True, timeout=900)
+    assert r.returncode == 0, r.stderr[-3000:]
+    p = subprocess.run([NVCC, *FLAGS, "-ptx", "-o", str(td / "k.ptx"), str(SRC / "roce.cu")], capture_output=True,
+                       text=True, timeout=900)
+    assert p.returncode == 0, p.stderr[-3000:]
+    return r.stderr, (td / "k.ptx").read_text()
+
+
+def _entries(ptxas: str) -> dict:
+    out, cur = {}, None
+    for line in ptxas.splitlines():
+        m = re.search(r"Compiling entry function '(\S+)'", line)
+        if m:
+            cur = m.group(1)
+            out[cur] = {}
+            continue
+        m = re.search(r"Function properties for (\S+)", line)
+        if m:
+            cur = m.group(1) if m.group(1) in out else None
+            continue
+        m = re.search(r"Used (\d+) registers", line)
+        if m and cur:
+            out[cur]["regs"] = int(m.group(1))
+        m = re.search(r"(\d+) bytes stack frame, (\d+) bytes spill stores, (\d+) bytes spill loads", line)
+        if m and cur:
+            out[cur]["stack"], out[cur]["spill"] = int(m.group(1)), int(m.group(2)) + int(m.group(3))
+    return out
+
+
+def _bodies(ptx: str) -> dict:
+    return {m.group(1): m.group(2) for m in re.finditer(r"\.entry\s+(\S+)\s*\((.*?)\n\}", ptx, re.S)}
+
+
+def _one(d: dict, key: str) -> tuple[str, object]:
+    found = [(k, v) for k, v in d.items() if key in k]
+    assert len(found) == 1, (key, list(d))
+    return found[0]
+
+
+@needs_nvcc
+def test_both_kernels_build_without_spills(built):
+    ents = _entries(built[0])
+    assert len(ents) == 2, ents
+    for name, e in ents.items():
+        assert e.get("regs", 0) <= 64 and e.get("spill") == 0 and e.get("stack", 0) <= 8, (name, e)
+    print(f"[G14] roce.cu sm_121: " + ", ".join(f"{k[-24:]} {v['regs']} regs, stack {v['stack']}" for k, v in ents.items()))
+
+
+@needs_nvcc
+def test_classic_kernel_keeps_its_orderings(built):
+    _, body = _one(_bodies(built[1]), "13gather_kernel")
+    assert body.count("fence.sc.sys") >= 3                    # per-block + doorbell + failure record (0350)
+    assert "st.release.sys.global.u32" in body                # 0460's lean doorbell
+    assert re.search(r"atom\.global\.max\.u64|red\.global\.max\.u64|atom\.max\.u64", body)   # device-ring stamp
+    assert "ld.relaxed.sys.global.u32" in body
+
+
+@needs_nvcc
+def test_fast_kernel_order(built):
+    _, body = _one(_bodies(built[1]), "gather_fast_kernel")
+    assert body.count("fence.sc.sys") == 2, body.count("fence.sc.sys")   # the failure record only
+    assert "fence.sc.gpu" not in body
+    assert not re.search(r"\b(atom|red)\.[a-z.]*max\.u64", body)
+    assert "nanosleep" in body
+    assert "atom.acq_rel.sys.global.add.u32" in body and "atom.acq_rel.gpu.global.add.u32" in body
+    rel = body.index("st.release.sys.global.u32")
+    assert body[:rel].count("st.relaxed.sys.global.u32") >= 2            # byte counts before the doorbell
+    call = body.index("wait_flag_shared")
+    between = body[rel:call]
+    # the local shard: plain global loads and stores between the doorbell and the first poll
+    assert re.search(r"\bld(\.global)?\.(v4\.)?[bu](8|32)\b", between), "no local copy before the wait"
+    assert re.search(r"\bst\.global\.(v4\.)?[bu](8|32)\b", between)
+    assert not re.search(r"ld\.(relaxed|acquire)\.sys", between)        # nothing read from the peer slot yet
+    # g. the peer slot: a thread's two 16-byte system-scope loads are issued before its stores (one round trip)
+    seq = "".join("L" if o.startswith("ld") else "S" for o in
+                  re.findall(r"\bld\.relaxed\.sys\.global\.v4|\bst\.global\.v4", body[call:]))
+    assert "LLSS" in seq, seq
+
+
+def _cxx_inc() -> str | None:
+    for c in (os.environ.get("TF_CXX_INC"), str(Path.home() / ".cache/roce-inc")):
+        if c and Path(c, "infiniband").is_dir():
+            return c
+    return None
+
+
+def test_bindings_syntax():
+    torch = pytest.importorskip("torch")
+    inc = _cxx_inc()
+    cxx = shutil.which("g++")
+    if inc is None or cxx is None or NVCC is None:
+        pytest.skip("set TF_CXX_INC (c10/cuda + infiniband headers), g++ and TF_NVCC")
+    tinc = Path(torch.__file__).parent / "include"
+    cuda_inc = Path(NVCC).parent.parent / "include"
+    r = subprocess.run([cxx, "-std=c++20", "-fsyntax-only", "-DTORCH_EXTENSION_NAME=x", "-DTORCH_API_INCLUDE_EXTENSION_H",
+                        f"-I{inc}", f"-I{tinc}", f"-I{tinc / 'torch/csrc/api/include'}", f"-I{cuda_inc}",
+                        f"-I{sysconfig.get_paths()['include']}", str(SRC / "roce.cpp")], capture_output=True, text=True,
+                       timeout=600)
+    errors = [ln for ln in r.stderr.splitlines() if " error" in ln or ln.startswith("error")]
+    assert r.returncode == 0 and not errors, "\n".join(errors[:20])
diff --git a/tests/test_roce_g14_msg.py b/tests/test_roce_g14_msg.py
new file mode 100644
index 0000000..2179358
--- /dev/null
+++ b/tests/test_roce_g14_msg.py
@@ -0,0 +1,154 @@
+"""G14: the RoCE host mailbox's protocol (``glm5_next/spark/roce_msg.h``, TF_DSV41_PLAN_LINK=rdma) on the CPU. A
+plain C++ harness gives two ranks their own region, a sender thread on rank 0, a receiver on rank 1 and a "proxy"
+thread that does what the two proxies do over RDMA (a chunk, then its flag; the receiver's ack back), at its own
+pace. No CUDA, torch or verbs.
+
+- 400 messages of 0 bytes .. 300 KiB (up to 5 chunks; > MSG_SLOTS chunks in flight forces the credit wait), random
+  bytes: rank 1 receives every one, byte for byte, in order;
+- a slow proxy (deliveries delayed) and a slow receiver: still exact; the sender blocks on credits, never overwrites
+  a slot a receiver has not consumed (the harness checks every delivered chunk's sequence against its slot);
+- the credit timeout: no receiver -> send returns false after the timeout;
+- liveness: the receiver naps with a socket to the sender polled; closing the socket ends recv with "closed the
+  connection" (rank 1 must not hang when rank 0 is gone);
+- the region layout: every part 64-byte aligned, inside the region, no overlaps.
+
+    pytest -q tests/test_roce_g14_msg.py
+"""
+
+from __future__ import annotations
+
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+HDR = Path(__file__).resolve().parents[1] / "src/tensorfold/families/glm5_next/spark/roce_msg.h"
+
+HARNESS = r'''
+#include "roce_msg.h"
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <random>
+#include <thread>
+#include <unistd.h>
+#include <sys/socket.h>
+using namespace tfroce;
+
+static uint32_t ld(const uint8_t *p) { return __atomic_load_n(reinterpret_cast<const uint32_t *>(p), __ATOMIC_ACQUIRE); }
+static void st(uint8_t *p, uint32_t v) { __atomic_store_n(reinterpret_cast<uint32_t *>(p), v, __ATOMIC_RELEASE); }
+
+int main(int argc, char **argv) {
+    const std::string mode = argv[1];
+    const int world = 2;
+    const uint64_t ctrl_off = 4096, base = ctrl_off + 128;
+    const MsgLayout L = msg_layout(base, world);
+    // layout checks
+    if (L.send_off % 64 || L.recv_off % 64 || L.flag_off % 64 || L.ack_off % 64 || L.send_off < base ||
+        L.recv_off < L.send_off + MSG_SLOTS * MSG_SLOT_BYTES || L.flag_off < L.recv_off + world * MSG_SLOTS * MSG_SLOT_BYTES ||
+        L.ack_off < L.flag_off + world * MSG_SLOTS * MSG_STRIDE || L.end < L.ack_off + world * MSG_STRIDE) {
+        printf("LAYOUT BAD\n"); return 2;
+    }
+    std::vector<uint8_t> A(L.end, 0), B(L.end, 0);          // rank 0's and rank 1's regions
+    MsgHost s0(A.data(), ctrl_off, base, world, 0), r1(B.data(), ctrl_off, base, world, 1);
+    std::atomic<int> stop{0}, bad{0};
+    const int slow_proxy = mode == "slow" ? 1 : 0;
+    // the proxies: rank 0's posts chunks (data, then flag) into B; rank 1's posts its ack into A
+    std::thread proxy([&] {
+        uint32_t posted = 0, acked = 0;
+        std::mt19937 rng(7);
+        while (!stop.load()) {
+            const uint32_t ms = ld(A.data() + ctrl_off + 4 * CTRL_MSG_SEQ);
+            while (posted != ms) {
+                const uint32_t m = posted + 1;
+                const uint64_t slot = m % MSG_SLOTS;
+                // the slot on the receiver must be consumed: it last held m - MSG_SLOTS (credits)
+                if (m > uint32_t(MSG_SLOTS) && ld(B.data() + ctrl_off + 4 * CTRL_MSG_ACK) < m - MSG_SLOTS) bad++;
+                MsgHeader h; memcpy(&h, A.data() + L.send_off + slot * MSG_SLOT_BYTES, sizeof(h));
+                const uint64_t bytes = MSG_HDR + ((uint64_t(h.bytes) + 15) & ~uint64_t(15));
+                if (slow_proxy && rng() % 4 == 0) usleep(200);
+                memcpy(B.data() + L.recv_off + (0 * MSG_SLOTS + slot) * MSG_SLOT_BYTES, A.data() + L.send_off + slot * MSG_SLOT_BYTES, bytes);
+                std::atomic_thread_fence(std::memory_order_seq_cst);
+                st(B.data() + L.flag_off + (0 * MSG_SLOTS + slot) * MSG_STRIDE, m);
+                posted = m;
+            }
+            const uint32_t a = ld(B.data() + ctrl_off + 4 * CTRL_MSG_ACK);
+            if (a != acked) { st(A.data() + L.ack_off + 1 * MSG_STRIDE, a); acked = a; }
+        }
+    });
+    int rc = 0;
+    if (mode == "exact" || mode == "slow") {
+        const int N = 400;
+        std::vector<std::vector<uint8_t>> msgs(N);
+        std::mt19937 rng(11);
+        for (int i = 0; i < N; i++) {
+            const uint64_t n = (i % 7 == 0) ? 0 : (i % 5 == 0 ? (rng() % (300 * 1024)) : rng() % 4000);
+            msgs[i].resize(n);
+            for (auto &b : msgs[i]) b = uint8_t(rng());
+        }
+        std::thread sender([&] {
+            for (int i = 0; i < N; i++)
+                if (!s0.send(msgs[i].data(), msgs[i].size(), 30.0)) { printf("SEND TIMEOUT %d\n", i); bad++; return; }
+        });
+        int ok = 0;
+        for (int i = 0; i < N; i++) {
+            if (mode == "slow" && i % 9 == 0) usleep(300);
+            auto got = r1.recv(0, 1000, 20000, -1, 30.0);
+            ok += got == msgs[i];
+        }
+        sender.join();
+        printf("RECEIVED %d OF %d, VIOLATIONS %d, CHUNKS %u\n", ok, N, bad.load(), s0.sent());
+        rc = (ok == N && bad.load() == 0) ? 0 : 1;
+    } else if (mode == "credit") {
+        std::vector<uint8_t> big((MSG_SLOTS + 3) * (MSG_SLOT_BYTES - MSG_HDR), 1);
+        const bool sent = s0.send(big.data(), big.size(), 0.3);
+        printf("CREDIT TIMEOUT %s\n", sent ? "NO" : "YES");
+        rc = sent ? 1 : 0;
+    } else if (mode == "hangup") {
+        int sv[2];
+        socketpair(AF_UNIX, SOCK_STREAM, 0, sv);
+        std::thread closer([&] { usleep(50000); close(sv[0]); });
+        try {
+            r1.recv(0, 1000, 20000, sv[1], 10.0);
+            printf("NO THROW\n"); rc = 1;
+        } catch (const std::exception &e) {
+            printf("THROW %s\n", e.what());
+            rc = std::string(e.what()).find("closed the connection") != std::string::npos ? 0 : 1;
+        }
+        closer.join();
+    }
+    stop.store(1);
+    proxy.join();
+    return rc;
+}
+'''
+
+
+@pytest.fixture(scope="module")
+def exe(tmp_path_factory):
+    cxx = shutil.which("g++") or shutil.which("clang++")
+    if cxx is None:
+        pytest.skip("no C++ compiler")
+    d = tmp_path_factory.mktemp("msg")
+    (d / "h.cpp").write_text(HARNESS)
+    r = subprocess.run([cxx, "-std=c++17", "-O2", "-pthread", f"-I{HDR.parent}", str(d / "h.cpp"), "-o", str(d / "h")],
+                       capture_output=True, text=True, timeout=300)
+    assert r.returncode == 0, r.stderr[-3000:]
+    return str(d / "h")
+
+
+@pytest.mark.parametrize("mode", ["exact", "slow"])
+def test_messages_arrive_exact_with_credits(exe, mode):
+    r = subprocess.run([exe, mode], capture_output=True, text=True, timeout=120)
+    assert r.returncode == 0 and "RECEIVED 400 OF 400, VIOLATIONS 0" in r.stdout, r.stdout + r.stderr
+
+
+def test_credit_timeout(exe):
