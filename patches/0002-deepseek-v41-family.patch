@@ -0,0 +1,187 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G7 decode exchanges on the CPU (torch twins; two ranks on threads with the real split weights and exchanges):
+
+- ``kit_partial``'s values are bf16 values: rounding them to bf16 is the identity, and bf16(p) == bf16(kit_partial(p))
+  for every fp32 p (specials included), so a decode partial can travel as bf16 and be widened exactly;
+- TP=2 with ``TF_DSV41_DECODE_EXCHANGE=bf16`` (the default: bf16 partials on the wire and into the mHC boundary) ==
+  ``fp32`` bit for bit: every rank's logits and the streams after every block, verify windows and 1-row windows;
+- persistent receive buffers (``TF_DSV41_XCHG_BUFS``): two a dtype, alternating, grown by powers of two with the
+  outgrown pair kept alive; on == off bit for bit;
+- boundaries out of place (``Streams.alt``, what the per-stream mHC programs need) == in place, bit for bit; row
+  invariance under the new defaults.
+
+Run: python -m pytest -q tests/test_dsv41_decode_xchg.py
+"""
+
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import forward as FW  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import pick as P  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+
+IDS = torch.randint(0, 256, (21,), generator=torch.Generator().manual_seed(5)).tolist()
+
+
+@pytest.fixture(scope="module")
+def ckpt(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41x"))
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg)
+
+
+def build(ckpt, rank=0, world=1, comm=None, chunk=8) -> FW.Forward:
+    root, cfg, table = ckpt
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), rank, world).load(token_map=tmap)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    return FW.Forward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), comm=comm, limit=96,
+                      chunk=chunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap))
+
+
+def run(fw, windows):
+    fw.trace = {}
+    out, a, traces = [], 0, []
+    for n in windows:
+        out.append(fw.step(IDS[a:a + n]))
+        traces.append({k: v.clone() for k, v in fw.trace.items()})
+        a += n
+    return torch.cat(out), traces
+
+
+def tp2(ckpt, fn, **kw):
+    pair = FK.ThreadPair()
+    comms = pair.comms()
+    fws = [build(ckpt, r, 2, comms[r], **kw) for r in range(2)]
+    return fws, pair.run([lambda f=f: fn(f) for f in fws])
+
+
+def _bits(t):
+    return t.reshape(-1).contiguous().view(torch.uint8)
+
+
+def test_kit_partial_values_are_bf16_values():
+    g = torch.Generator().manual_seed(0)
+    p = torch.randn(4096, generator=g) * torch.logspace(-40, 38, 4096)
+    special = torch.tensor([0.0, -0.0, float("inf"), -float("inf"), 3.4e38, -3.4e38, 1e-40, -1e-44, 1.0 + 2 ** -8,
+                            1.0 + 2 ** -9, 1.0 + 3 * 2 ** -9, 65504.0, 2.0 ** -126, 2.0 ** -133])
+    p = torch.cat([p, special, (torch.rand(4096, generator=g).view(torch.int32) | 0x3F000000).view(torch.float32)])
+    k = P.kit_partial(p)
+    assert torch.equal(_bits(k.to(torch.bfloat16).to(torch.float32)), _bits(k))       # bf16-valued: exact round trip
+    assert torch.equal(_bits(p.to(torch.bfloat16)), _bits(k.to(torch.bfloat16)))       # one rounding == two
+    nan = P.kit_partial(torch.tensor([float("nan")]))
+    assert nan.isnan().all() and nan.to(torch.bfloat16).float().isnan().all()
+
+
+def _gathered_dtypes(fw):
+    seen = []
+    inner = fw.gather_partials
+
+    def spy(partial, wide=False):
+        got = inner(partial, wide)
+        if not wide:                                    # allsum (the embedding) widens: fp32 by request
+            seen.append(got.dtype)
+        return got
+
+    fw.gather_partials = spy
+    return seen
+
+
+@pytest.mark.parametrize("windows", [[8, 8, 5], [1] * 6])
+def test_tp2_bf16_exchange_equals_fp32(ckpt, monkeypatch, windows):
+    monkeypatch.setenv("TF_DSV41_DECODE_EXCHANGE", "fp32")
+    _, old = tp2(ckpt, lambda f: run(f, windows))
+    monkeypatch.setenv("TF_DSV41_DECODE_EXCHANGE", "bf16")
+    seen = {}
+
+    def go(f):
+        seen[f.rank] = _gathered_dtypes(f)
+        return run(f, windows)
+
+    fws, new = tp2(ckpt, go)
+    assert all(f.decode_bf16 for f in fws)
+    assert set(seen[0]) == {torch.bfloat16} and set(seen[1]) == {torch.bfloat16}
+    for r in range(2):
+        assert torch.equal(_bits(new[r][0]), _bits(old[r][0])), r                         # logits
+        for tn, to in zip(new[r][1], old[r][1]):
+            for L in to:
+                assert torch.equal(_bits(tn[L]), _bits(to[L])), (r, L)                    # streams after each block
+    assert torch.equal(_bits(new[0][1][-1][0]), _bits(new[1][1][-1][0]))                 # the ranks agree
+
+
+def test_tp2_receive_buffers_on_equals_off(ckpt, monkeypatch):
+    monkeypatch.setenv("TF_DSV41_XCHG_BUFS", "0")
+    _, off = tp2(ckpt, lambda f: run(f, [3, 8, 1]))
+    monkeypatch.setenv("TF_DSV41_XCHG_BUFS", "1")
+    fws, on = tp2(ckpt, lambda f: run(f, [3, 8, 1]))
+    assert fws[0]._recv                                                                 # the buffers were used
+    for r in range(2):
+        assert torch.equal(_bits(on[r][0]), _bits(off[r][0]))
+
+
+def test_receive_buffers_alternate_and_grow():
+    fw = SimpleNamespace(xbufs=True, _recv={}, _retired=[])
+    rb = lambda n: FW.Forward.recv_buffer(fw, torch.bfloat16, n, "cpu")        # noqa: E731
+    a, b, c = rb(10), rb(10), rb(7)
+    assert a.data_ptr() != b.data_ptr() and c.data_ptr() == a.data_ptr() and c.numel() == 7
+    assert fw._recv[(torch.bfloat16, "cpu")][0] == 16
+    keep = rb(16)
+    assert not fw._retired
+    big = rb(40)                                        # outgrown: a new pair, the old one kept alive
+    assert big.numel() == 40 and fw._recv[(torch.bfloat16, "cpu")][0] == 64 and len(fw._retired) == 1
+    assert keep.data_ptr() in {t.data_ptr() for t in fw._retired[0]}
+    assert FW.Forward.recv_buffer(fw, torch.float32, 5, "cpu").dtype == torch.float32    # a pair a dtype
+    fw.xbufs = False
+    assert FW.Forward.recv_buffer(fw, torch.bfloat16, 5, "cpu").data_ptr() not in (a.data_ptr(), b.data_ptr())
+
+
+def _out_of_place(fw):
+    """The torch seam with ``out_of_place`` (the CUDA module's hook): every boundary writes ``Streams.alt``."""
+
+    fw.hc.out_of_place = lambda n: True
+    calls = []
+    inner = fw.hc.boundary
+
+    def boundary(x, xout, *a, **k):
+        calls.append(xout is not x)
+        return inner(x, xout, *a, **k)
+
+    fw.hc.boundary = boundary
+    return calls
+
+
+def test_out_of_place_boundaries_equal_in_place(ckpt):
+    want = run(build(ckpt), [8, 1, 8, 4])
+    fw = build(ckpt)
+    calls = _out_of_place(fw)
+    got = run(fw, [8, 1, 8, 4])
+    assert calls and all(calls)
+    assert torch.equal(_bits(got[0]), _bits(want[0]))
+    for tg, tw in zip(got[1], want[1]):
+        for L in tw:
+            assert torch.equal(_bits(tg[L]), _bits(tw[L])), L
+
+
+def test_tp2_out_of_place_row_invariance(ckpt):
+    def go(windows):
+        def fn(f):
+            _out_of_place(f)
+            return run(f, windows)[0]
+        return fn
+
+    _, a = tp2(ckpt, go([1] * 21), chunk=21)
+    _, b = tp2(ckpt, go([21]), chunk=21)
+    assert torch.equal(a[0], b[0]) and torch.equal(a[1], b[1])
