@@ -0,0 +1,412 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Image input for DeepSeek-V4.1-Flash, engine side (``TF_DSV41_IMAGES=native``): DeepSeek's ViT + aligner on rank 0,
+the image rows into the embedding, and the two places the language model treats image positions differently.
+
+Math reference: DeepSeek's ``inference/vision.py`` and ``model.py`` (MIT; ``Transformer.merge_image_embeddings``,
+``Gate``, ``NgramHashState``, ``Engram``). What an image position does in V4.1, and where this engine does it:
+
+1. **Embedding.** The span's IMAGE positions take the aligner's rows in reading order, IMAGE_START / IMAGE_NEW_LINE /
+   IMAGE_END the learned ``image_start`` / ``image_newline`` / ``image_end`` rows (bf16, as the reference's ``h``).
+   Prompt ids carry one virtual id (>= ``VBASE``) a span position (``vision_prep``); ``Forward.embed_rows`` reads
+   none for them (past every rank's vocabulary range: zero), and rank 0 writes the row into its partial before the
+   embedding's all-sum, so rank 1 receives it through the exchange it already does (row + 0 is the row: exact).
+   Rank 0 holds a request's rows in ``STORE`` from before the job is queued until it ends.
+2. **Engram.** An image position takes no part in an n-gram (look-back stops at it: ``NgramHasher`` treats every id
+   past the vocabulary as DEAD) and gets no Engram contribution (its gate is 0: ``keep``).
+3. **Routing.** Image positions select experts with ``gate.bias_vl`` instead of ``gate.bias`` (training's
+   ``noaux_tc_for_vl``). Both EXL3 packs dropped the 43 tensors; ``TF_DSV41_BIAS_VL`` names a folder holding them
+   (``bias_vl_fetch.py`` writes it from the release, 63 KB), loaded on both ranks (the router is replicated). A
+   window's image rows run the MoE as their own call with the bias swapped: every MoE path computes a row from that
+   row alone, so this is the reference's per-row ``torch.where`` bit for bit. Without the folder the image rows
+   route with the text bias (what the vLLM kit does); the boot log says so.
+
+Attention is causal over image positions, as the reference's ``inference/model.py`` (the kit's in-image
+bidirectional window is off on SM12x too). DSpark reads the target's taps, never the ids; the lookup drafter never
+proposes a virtual id (GLM's ``SuffixIndex``). The DSpark blocks' own ``bias_vl`` is unused, as in the reference
+(``forward_spec`` passes no image mask).
+
+**The tower** (``Tower``, BF16, 0.97 GB on rank 0 only): patch embedding (a 588 -> 1,024 linear over 14 x 14 RGB
+patches), 32 pre-norm blocks (RMSNorm in fp32, qkv with bias, a 2D RoPE over half of each 64-wide head: h then w
+positions, base 10,000; full bidirectional attention within the image through ``scaled_dot_product_attention``
+on [1, heads, n, 64], flash / memory-efficient only: no N^2 buffer at 9k patches), SwiGLU 1,024 -> 2,816, a final
+RMSNorm, then the aligner: 3 x 3 unfold (zero padding at the right / bottom edge), 9,216 -> 5,120, GELU, 5,120 -> 5,120.
+``Encoder`` caches recent images' rows by digest (TF_DSV41_VISION_CACHE_MB, default 64).
+"""
+
+from __future__ import annotations
+
+import os
+import threading
+from collections import OrderedDict
+from collections.abc import Sequence
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+import torch
+import torch.nn.functional as F
+
+from .vision_prep import IMAGE, IMAGE_END, IMAGE_NEW_LINE, IMAGE_START, VBASE, Prepared
+
+BF16, F32 = torch.bfloat16, torch.float32
+MODES = ("reject", "placeholder", "native")
+DEFAULT_MODE = "placeholder"
+ENV_MODE = "TF_DSV41_IMAGES"
+
+
+def mode(env=os.environ) -> str:
+    """``TF_DSV41_IMAGES``: reject (HTTP 400, the old behaviour) | placeholder (default: each image becomes a short
+    text notice, the turn goes on) | native (the vision tower on rank 0)."""
+
+    v = (env.get(ENV_MODE, "") or DEFAULT_MODE).strip().lower()
+    if v not in MODES:
+        raise ValueError(f"{ENV_MODE}={v!r}: expected one of {', '.join(MODES)}")
+    return v
+
+
+# -- the tower -----------------------------------------------------------------------------------------------------
+def _rms(x: torch.Tensor, w: torch.Tensor, eps: float = 1e-6) -> torch.Tensor:
+    dt = x.dtype
+    x = x.float()
+    x = x * torch.rsqrt(x.square().mean(-1, keepdim=True) + eps)
+    return (w.float() * x).to(dt)
+
+
+def _rope(n_h: int, n_w: int, dim: int, theta: float, device) -> tuple[torch.Tensor, torch.Tensor]:
+    inv = 1.0 / (theta ** (torch.arange(0, dim, 2, dtype=F32, device=device) / dim))
+    hp = torch.arange(n_h, device=device).unsqueeze(1).expand(n_h, n_w)
+    wp = torch.arange(n_w, device=device).unsqueeze(0).expand(n_h, n_w)
+    f = torch.stack([hp, wp], dim=-1).reshape(-1, 2, 1).float() * inv
+    f = f.flatten(1)
+    return f.cos().unsqueeze(1), f.sin().unsqueeze(1)
+
+
+def _rotate(x: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor) -> torch.Tensor:
+    dt = x.dtype
+    a, b = x.float().chunk(2, dim=-1)
+    return torch.cat([a * cos - b * sin, b * cos + a * sin], dim=-1).to(dt)
+
+
+SDPA_BACKENDS = ("FLASH_ATTENTION", "EFFICIENT_ATTENTION")     # the fused kernels only: no N^2 buffer, no math path
+
+
+def _sdpa(q: torch.Tensor, k: torch.Tensor, v: torch.Tensor) -> torch.Tensor:
+    """Full attention within one image: q / k / v [heads, n, hd] -> [heads, n, hd].
+
+    Only ``SDPA_BACKENDS`` may run it, on every device (the CPU tests take the same call as the GPU). The fused kernels
+    take [batch, heads, n, hd] and nothing else: given 3-D q / k / v with the math path excluded, CUDA has "No
+    available kernel" (G15a: HTTP 500 on every image on 7954c1d). So a batch of one goes on here and comes off after.
+    """
+
+    from torch.nn.attention import SDPBackend, sdpa_kernel
+
+    if q.dim() != 3 or k.dim() != 3 or v.dim() != 3:
+        raise ValueError(f"vision attention takes [heads, n, hd]: q {tuple(q.shape)} k {tuple(k.shape)} "
+                         f"v {tuple(v.shape)}")
+    with sdpa_kernel([getattr(SDPBackend, b) for b in SDPA_BACKENDS]):
+        return F.scaled_dot_product_attention(q.unsqueeze(0), k.unsqueeze(0), v.unsqueeze(0)).squeeze(0)
+
+
+@dataclass
+class Tower:
+    """The ViT, the aligner and the span delimiters: ``t`` {checkpoint name: tensor} on one device."""
+
+    t: dict
+    layers: int = 32
+    heads: int = 16
+    ratio: int = 3
+    theta: float = 10000.0
+
+    PREFIXES = ("vision.", "aligner.", "image_start", "image_end", "image_newline")
+
+    @classmethod
+    def load(cls, shards, vision_config: dict, device, dtype=BF16) -> Tower:
+        names = [n for n in shards.weight_map if n.startswith(cls.PREFIXES)]
+        if not names:
+            raise ValueError("the checkpoint holds no vision tower (vision.* / aligner.* / image_*)")
+        t = {n: shards.tensor(n).to(device=device, dtype=dtype) for n in names}
+        return cls(t, int(vision_config.get("num_hidden_layers", 32)), int(vision_config.get("num_attention_heads", 16)),
+                   int(vision_config.get("downsample_ratio", 3)), float(vision_config.get("rope_theta", 10000.0)))
+
+    @property
+    def nbytes(self) -> int:
+        return sum(v.numel() * v.element_size() for v in self.t.values())
+
+    @property
+    def device(self):
+        return self.t["image_start"].device
+
+    def lin(self, x: torch.Tensor, name: str) -> torch.Tensor:
+        return F.linear(x, self.t[f"{name}.weight"], self.t.get(f"{name}.bias"))
+
+    @torch.inference_mode()
+    def vit(self, patches: torch.Tensor, n_h: int, n_w: int) -> torch.Tensor:
+        t = self.t
+        dt = t["vision.patch_embed.proj.weight"].dtype
+        x = self.lin(patches.to(self.device, dt).flatten(1), "vision.patch_embed.proj")
+        n, dim = x.shape
+        hd = dim // self.heads
+        cos, sin = _rope(n_h, n_w, hd // 2, self.theta, x.device)
+        for i in range(self.layers):
+            p = f"vision.blocks.{i}"
+            h = _rms(x, t[f"{p}.norm1.weight"])
+            q, k, v = (a.view(n, self.heads, hd) for a in self.lin(h, f"{p}.attn.wqkv").chunk(3, dim=-1))
+            q, k = _rotate(q, cos, sin), _rotate(k, cos, sin)
+            o = _sdpa(q.transpose(0, 1), k.transpose(0, 1), v.transpose(0, 1))
+            x = x + self.lin(o.transpose(0, 1).reshape(n, -1), f"{p}.attn.wo")
+            h = _rms(x, t[f"{p}.norm2.weight"])
+            g, u = self.lin(h, f"{p}.mlp.w1").chunk(2, dim=-1)
+            x = x + self.lin(F.silu(g) * u, f"{p}.mlp.w2")
+        return _rms(x, t["vision.norm.weight"])
+
+    @torch.inference_mode()
+    def align(self, x: torch.Tensor, n_h: int, n_w: int) -> torch.Tensor:
+        r = self.ratio
+        x = x.view(n_h, n_w, -1).permute(2, 0, 1)
+        x = F.pad(x, (0, -n_w % r, 0, -n_h % r))
+        x = F.unfold(x.unsqueeze(0), r, stride=r).squeeze(0).transpose(0, 1)
+        return self.lin(F.gelu(self.lin(x, "aligner.w1")), "aligner.w2")
+
+    @torch.inference_mode()
+    def span(self, img: Prepared) -> torch.Tensor:
+        """The image's span rows bf16 [h (w + 1) + 2, D], in prompt order."""
+
+        feats = self.align(self.vit(img.patches, img.n_vit_h, img.n_vit_w), img.n_vit_h, img.n_vit_w)
+        if feats.shape[0] != img.n_llm_h * img.n_llm_w:
+            raise RuntimeError(f"aligner rows {feats.shape[0]} != grid {img.n_llm_h} x {img.n_llm_w}")
+        types = torch.tensor(img.types, device=feats.device)
+        out = torch.empty((types.numel(), feats.shape[1]), dtype=BF16, device=feats.device)
+        out[types == IMAGE_START] = self.t["image_start"].to(BF16)
+        out[types == IMAGE_END] = self.t["image_end"].to(BF16)
+        out[types == IMAGE_NEW_LINE] = self.t["image_newline"].to(BF16)
+        out[types == IMAGE] = feats.to(BF16)
+        return out
+
+
+class Encoder:
+    """Rank 0: the tower and a cache of recent images' span rows by digest."""
+
+    def __init__(self, tower: Tower, cache_mb: int | None = None) -> None:
+        self.tower = tower
+        self.cap = (int(os.environ.get("TF_DSV41_VISION_CACHE_MB", "") or 64) if cache_mb is None else cache_mb) << 20
+        self.cache: OrderedDict[bytes, torch.Tensor] = OrderedDict()
+        self.bytes = 0
+        self.lock = threading.Lock()
+        self._mine = threading.local()
+
+    @property
+    def last(self) -> dict:
+        """The stats of this thread's last ``table`` (the request's: ``engine.generate`` encodes and reports on the
+        request's own HTTP thread; one shared dict made concurrent image requests all report the last encode, G15a)."""
+
+        return getattr(self._mine, "last", {})
+
+    @classmethod
+    def load(cls, model_dir: Path, device) -> Encoder:
+        import json
+
+        from .weights import Shards
+
+        cfg = json.loads((Path(model_dir) / "config.json").read_text())
+        return cls(Tower.load(Shards(model_dir), cfg.get("vision_config") or {}, device))
+
+    def rows(self, img: Prepared) -> torch.Tensor:
+        with self.lock:
+            hit = self.cache.get(img.digest)
+            if hit is not None:
+                self.cache.move_to_end(img.digest)
+                return hit
+            got = self.tower.span(img)              # one image at a time on the tower (the lock)
+            self.cache[img.digest] = got
+            self.bytes += got.numel() * got.element_size()
+            while self.bytes > self.cap and len(self.cache) > 1:
+                _, old = self.cache.popitem(last=False)
+                self.bytes -= old.numel() * old.element_size()
+            return got
+
+    def table(self, images: Sequence[Prepared]) -> Table | None:
+        if not images:
+            return None
+        import time
+
+        t0 = time.perf_counter()
+        rows = [self.rows(img) for img in images]
+        keys = [v for img in images for v in img.vids]
+        self._mine.last = {"images": len(images), "rows": len(keys), "encode_s": round(time.perf_counter() - t0, 4)}
+        return Table(keys, torch.cat(rows))
+
+
+# -- rank 0's rows for the forward ---------------------------------------------------------------------------------
+@dataclass
+class Table:
+    keys: list            # virtual ids, one a row
+    rows: torch.Tensor    # bf16 [K, D]
+
+
+class Store:
+    """Virtual id -> its row, for every queued or running request (rank 0); ``hold`` before the job is queued,
+    ``release`` when it ends."""
+
+    def __init__(self) -> None:
+        self.lock = threading.Lock()
+        self.tables: dict[int, Table] = {}
+        self.where: dict[int, tuple[int, int]] = {}
+        self.refs: dict[int, int] = {}
+        self.next = 1
+
+    def hold(self, table: Table | None) -> int | None:
+        if table is None or not table.keys:
+            return None
+        with self.lock:
+            tok = self.next
+            self.next += 1
+            self.tables[tok] = table
+            seen: set[int] = set()
+            for i, v in enumerate(table.keys):
+                if v in seen:                   # the same image twice in one request (an agent's history): one ref
+                    continue
+                seen.add(v)
+                if v not in self.where:
+                    self.where[v] = (tok, i)
+                self.refs[v] = self.refs.get(v, 0) + 1          # refs = the tables that hold v
+            return tok
+
+    def release(self, tok: int | None) -> None:
+        if tok is None:
+            return
+        with self.lock:
+            table = self.tables.pop(tok, None)
+            if table is None:
+                return
+            for v in dict.fromkeys(table.keys):     # each id once (G16: duplicates raised StopIteration here)
+                n = self.refs.get(v, 0) - 1
+                other = None
+                if self.where.get(v, (None,))[0] == tok or n > 0:
+                    other = next(((t, i) for t, tb in self.tables.items() for i, k in enumerate(tb.keys)
+                                  if k == v), None)
+                if n > 0 and other is not None:
+                    self.refs[v] = n
+                    if self.where.get(v, (None,))[0] == tok:          # another holder's table has the same row
+                        self.where[v] = other
+                else:                                                  # no live table holds v: forget it
+                    self.refs.pop(v, None)
+                    self.where.pop(v, None)
+
+    def __len__(self) -> int:
+        return len(self.where)
+
+    def gather(self, vids: Sequence[int], device) -> torch.Tensor:
+        """The rows of ``vids`` bf16 [n, D]; KeyError for one no request holds."""
+
+        with self.lock:
+            missing = [v for v in vids if v not in self.where]
+            if missing:
+                raise KeyError(f"image rows not held for {len(missing)} virtual ids (first {missing[0]})")
+            by: dict[int, list[tuple[int, int]]] = {}
+            for j, v in enumerate(vids):
+                tok, i = self.where[v]
+                by.setdefault(tok, []).append((j, i))
+            D = next(iter(self.tables.values())).rows.shape[1]
+            out = torch.empty((len(vids), D), dtype=BF16, device=device)
+            for tok, pairs in by.items():
+                dst = torch.tensor([j for j, _ in pairs], device=device)
+                src = torch.tensor([i for _, i in pairs], device=self.tables[tok].rows.device)
+                out[dst] = self.tables[tok].rows.index_select(0, src).to(device=device, dtype=BF16)
+            return out
+
+
+STORE = Store()
+
+
+# -- the forward's hooks -------------------------------------------------------------------------------------------
+@dataclass
+class Window:
+    """A window's image positions: ``pos`` (row indices, device), ``vids`` (their ids, host), ``keep`` fp32 [n]
+    (0 at image rows: Engram's gate)."""
+
+    pos: torch.Tensor
+    vids: list
+    keep: torch.Tensor
+
+
+def window(ids: Sequence[int], device) -> Window | None:
+    """None for a window without image positions (every text window: nothing changes)."""
+
+    pos = [i for i, t in enumerate(ids) if t >= VBASE]
+    if not pos:
+        return None
+    keep = torch.ones((len(ids),), dtype=F32)
+    keep[pos] = 0.0
+    return Window(torch.tensor(pos, dtype=torch.long, device=device), [int(ids[i]) for i in pos],
+                  keep.to(device))
+
+
+def fill(rows: torch.Tensor, win: Window | None, rank: int, store: Store = STORE) -> torch.Tensor:
+    """Rank 0 writes the image rows into its embedding partial (zero there: no rank's vocabulary holds a virtual
+    id); the other ranks add nothing."""
+
+    if win is not None and rank == 0:
+        rows[win.pos] = store.gather(win.vids, rows.device).to(rows.dtype)
+    return rows
+
+
+def moe(m: Any, x: torch.Tensor, win: Window | None) -> torch.Tensor:
+    """The MoE over a window's rows, image rows routed with ``bias_vl`` (``m.bias_vl``; None: the text bias)."""
+
+    bias_vl = getattr(m, "bias_vl", None)
+    if win is None or bias_vl is None:
+        return m(x)
+    n = x.shape[0]
+    img = win.pos.to(x.device)
+    txt_mask = torch.ones((n,), dtype=torch.bool, device=x.device)
+    txt_mask[img] = False
+    txt = txt_mask.nonzero().squeeze(1)
+    saved = m.bias
+    m.bias = bias_vl
+    try:
+        part_i = m(x.index_select(0, img).contiguous())
+    finally:
+        m.bias = saved
+    out = torch.empty((n, *part_i.shape[1:]), dtype=part_i.dtype, device=part_i.device)
+    out[img] = part_i
+    if txt.numel():
+        out[txt] = m(x.index_select(0, txt).contiguous()).to(part_i.dtype)
+    return out
+
+
+def attach_bias_vl(blocks, folder: str | Path | None, prefix: str = "layers") -> int:
+    """``*.ffn.gate.bias_vl`` from ``folder`` (``TF_DSV41_BIAS_VL``) onto every block's MoE; the count attached."""
+
+    if not folder:
+        return 0
+    from .weights import Shards
+
+    src = Shards(folder)
+    n = 0
+    for blk in blocks:
+        name = f"{prefix}.{blk.index}.ffn.gate.bias_vl"
+        if name not in src:
+            raise ValueError(f"{folder}: no {name} (bias_vl_fetch.py writes all 43)")
+        b = src.tensor(name).to(device=blk.moe.bias.device, dtype=F32)
+        if b.shape != blk.moe.bias.shape:
+            raise ValueError(f"{name}: shape {tuple(b.shape)}, the router's bias is {tuple(blk.moe.bias.shape)}")
+        blk.moe.bias_vl = b.contiguous()
+        n += 1
+    return n
+
+
+__all__ = [
+    "MODES",
+    "STORE",
+    "Encoder",
+    "Store",
+    "Table",
+    "Tower",
+    "Window",
+    "attach_bias_vl",
+    "fill",
+    "mode",
+    "moe",
+    "window",
+]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/vision_prep.py b/src/tensorfold/families/deepseek_v41/cuda/vision_prep.py
