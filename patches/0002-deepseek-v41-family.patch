+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Round-level simulation of DSpark drafting policies with the engine's own planners (``depth.best_k``,
+``pctree.grow`` / ``select``, ``depth.Calibration`` / ``confcal``, ``pctree.Cal``) and a verify cost table.
+
+- ``replay``: over a drafting log's passes (``draftsim.load``): every policy sees the logged pass (drafts, raw
+  confidences, candidates and base logits) and is scored exactly against the serial tokens (the accepted length of a
+  tree = its longest chain's), with the online calibrations and the running rate the engine keeps;
+- ``synth``: the same loop over synthetic passes (``SynthExpander``) whose draft distributions match the measured
+  prose statistics (G8: q_1 bins, conditional acceptance by position) and whose serial token follows the draft
+  distribution (calibrated): an expectation before a log exists, swept over the unknown that decides trees,
+  ``s2`` = P(the serial token is the draft's 2nd | not its 1st).
+
+A round costs ``verify`` (the plan's modelled ms: unique rows on the table, duplicated rows ``dup_ms``, extra chains
+``slot_ms``) + ``fixed`` (the DSpark pass and the round's GPU idle: G9 prose 3.5 + 2.4 ms). Single stream: a lone
+window may verify no draft (zero depth), as in the engine.
+"""
+
+from __future__ import annotations
+
+from collections import deque
+from dataclasses import dataclass
+
+import numpy as np
+
+from . import pctree as PC
+
+G9_VERIFY = [29.5, 36.3, 40.25, 44.2, 48.15, 52.1, 56.1, 60.1] + [60.1 + 3.76 * i for i in range(1, 9)]
+FIXED_MS = 5.9
+RATE_WINDOW = 16
+
+
+def _kept(drafts, serial) -> int:
+    a = 0
+    for d, s in zip(drafts, serial):
+        if int(d) != int(s):
+            break
+        a += 1
+    return a
+
+
+class _Ident:
+    """A calibration that trusts the probabilities (synthetic passes are calibrated by construction)."""
+
+    def q(self, j, p):
+        return min(max(float(p), 0.0), PC.Q_MAX)
+
+    def record(self, probs, keep):
+        pass
+
+
+@dataclass
+class Policy:
+    name: str
+    tree: bool = False
+    depths: int = 1
+    width: int = 2
+    chains: int = 3
+    cal: str = "factor"                     # factor | temp | ident
+
+
+def policies() -> list[Policy]:
+    return [Policy("chain"), Policy("chain+temp", cal="temp"),
+            Policy("tree d1 w2 B3", True, 1, 2, 3), Policy("pctree d2 w2 B3", True, 2, 2, 3),
+            Policy("pctree d3 w2 B4", True, 3, 2, 4), Policy("pctree d2 w3 B4", True, 2, 3, 4)]
+
+
+def _cal(kind: str, n: int):
+    if kind == "ident":
+        return _Ident()
+    if kind == "temp":
+        from .confcal import TempCal
+
+        return TempCal(n, "temp")
+    from .depth import Calibration
+
+    return Calibration(n)
+
+
+def run(passes, exp_of, pol: Policy, *, verify=None, fixed: float = FIXED_MS, dup_ms: float = 0.4,
+        slot_ms: float = 0.5, sib_expert: float = 1.0, alone: bool = True, n: int = 5, ident: bool = False) -> dict:
+    """One policy over ``passes`` (in order); ``exp_of(pass)`` -> its ``pctree.Expander`` (or synthetic)."""
+
+    from tensorfold.families.glm5_next.spark.depth import best_k
+
+    verify = list(verify or G9_VERIFY)
+    rows_ms = lambda r: verify[r - 1] if r <= len(verify) else verify[-1] + (verify[-1] - verify[-2]) * (r - len(verify))
+    cal = _cal("ident" if ident else pol.cal, n)
+    pcal = PC.Cal(max(pol.depths, 1), pol.width)
+    rounds: deque = deque(maxlen=RATE_WINDOW)
+    tok = ms = rows = wins = 0.0
+    m = 0
+    for p in passes:
+        if p.cand is None or len(p.serial) < n:
+            continue
+        m += 1
+        rate = sum(t for t, _ in rounds) / sum(x for _, x in rounds) if rounds else 2.0 / (verify[1] + fixed)
+        conf, d, serial = list(p.conf[:n]), [int(t) for t in p.drafts[:n]], list(p.serial[:n])
+        least = 0 if alone else 1
+        plan = None
+        if pol.tree:
+            exp = exp_of(p)
+
+            def qsib(dd, r, pp, pcal=pcal):
+                return pp if ident else pcal.q(dd, r, pp)
+            order = PC.grow(exp, p.cand, p.base, int(p.pending), int(p.start), p.sampling, d, conf, cal.q, qsib,
+                            depths=pol.depths, width=pol.width, rows=15, chains=pol.chains)
+            plan = PC.select(order, rows_ms, rate, least=least, dup_ms=dup_ms, slot_ms=slot_ms,
+                             sib_expert=sib_expert, max_rows=16)
+            k, w_ms = plan.k, plan.ms
+        else:
+            qs = [cal.q(j, c) for j, c in enumerate(conf)]
+            k, _ = best_k(qs, verify, rate, least=least)
+            w_ms = verify[k]
+        a_main = min(k, _kept(d, serial))
+        a = a_main
+        if plan is not None and plan.chains and k >= 1:
+            for toks, _ in plan.chains:
+                a = max(a, _kept(toks, serial))
+            if not ident:
+                PC.learn(pcal, plan.nodes, serial[:a + 1])
+            wins += int(a > a_main)
+        if k == 0:
+            cal.record([conf[0]], 2 if d[0] == serial[0] else 1)    # the bonus counterfactual
+        else:
+            cal.record(conf[:k], a_main + 1)
+        t, x = a + 1, w_ms + fixed
+        rows += 1 + (len(plan.nodes) if plan is not None and plan.chains and k >= 1 else k)
+        rounds.append((t, x))
+        tok += t
+        ms += x
+    if not m:
+        return {"policy": pol.name, "rounds": 0}
+    return {"policy": pol.name, "rounds": m, "tokens_per_round": round(tok / m, 4), "ms_per_round": round(ms / m, 3),
+            "tok_s": round(1000.0 * tok / ms, 2), "unique_rows_per_round": round(rows / m, 3),
+            "tree_wins": int(wins)}
+
+
+def replay_all(passes, w1, w2, cw=None, *, verify=None, **kw) -> list[dict]:
+    exp = PC.Expander(w1, w2, cw)
+    return [run(passes, lambda p: exp, pol, verify=verify, **kw) for pol in policies()]
+
+
+# -- synthetic passes --------------------------------------------------------------------------------------------------
+Q1_BINS_PROSE = [36, 614, 1073, 1285, 886, 698, 566, 471, 457, 516]     # G8 prose runs, q_1 rounds a bin
+Q1_KEPT_PROSE = [6, 100, 193, 384, 454, 376, 397, 410, 401, 482]
+COND_PROSE = [0.45, 0.40, 0.35, 0.30]       # positions 2-5 given a serial prefix (G8 measured 0.45 at 2; native-
+#                                             weight prose 0.52 / 0.45 / 0.40 / 0.33, LANDSCAPE section 4, ours lower)
+
+
+class SynthPass:
+    """A synthetic pass: node distributions drawn lazily per (depth, parent); the serial path follows them."""
+
+    def __init__(self, rng: np.random.Generator, ix: int, s2: float, rho: float, width: int = 6, n: int = 5,
+                 q1=None, cond=None) -> None:
+        self.rng, self.ix, self.s2, self.rho, self.M, self.N = rng, ix, s2, rho, width, n
+        self.start, self.pending, self.sampling, self.noise = 1000 * ix, -1, None, []
+        self.cand = np.zeros((n, 1), dtype=np.int32)
+        self.base = np.zeros((n, 1), dtype=np.float32)
+        self.q1 = q1
+        self.cond = cond or COND_PROSE
+        self.kids: dict = {}
+        self.next_tok = 1
+        d, conf, t = [], [], self.pending
+        for i in range(n):
+            (tok, p) = self.children(None, None, i, t, 0, None, 1)[0]
+            d.append(tok)
+            conf.append(p)
+            t = tok
+        self.drafts, self.conf = d, conf
+        self.serial, t = [], self.pending
+        for i in range(n):
+            ks = self._dist(i, t)
+            r = rng.choice(len(ks) + 1, p=np.append([p for _, p in ks], max(0.0, 1.0 - sum(p for _, p in ks))))
+            if r == len(ks):
+                tok = -(10 + i)                     # outside the draft's top M: no node matches
+                self.serial.append(tok)
+                for j in range(i + 1, n):
+                    self.serial.append(-(10 + j))
+                break
+            tok = ks[r][0]
+            self.serial.append(tok)
+            t = tok
+
+    def _top(self, i: int) -> float:
+        if i == 0:
+            if self.q1 is not None:
+                b = self.rng.choice(len(self.q1[0]), p=np.asarray(self.q1[0]) / np.sum(self.q1[0]))
+                return float(np.clip(self.q1[1][b] / max(self.q1[0][b], 1) + self.rng.normal(0, 0.05), 0.02, 0.98))
+            return float(self.rng.beta(2.2, 1.9))
+        c = self.cond[min(i - 1, len(self.cond) - 1)]
+        return float(self.rng.beta(2.0 * c / (1 - c), 2.0))
+
+    def _dist(self, i: int, parent: int) -> list:
+        key = (i, parent)
+        got = self.kids.get(key)
+        if got is None:
+            p1 = self._top(i)
+            ps, rest, share, left = [p1], 1.0 - p1, self.s2, 1.0 - p1
+            for _ in range(self.M - 1):
+                q = min(rest * share, left * 0.999)
+                ps.append(q)
+                left -= q
+                share *= self.rho
+            got = []
+            for p in ps:
+                got.append((self.next_tok, float(p)))
+                self.next_tok += 1
+            self.kids[key] = got
+        return got
+
+    def children(self, cand, base, i, prev, position, sampling, m, exclude=()):
+        ex = {int(t) for t in exclude}
+        return [(t, p) for t, p in self._dist(i, int(prev)) if t not in ex][:m]
+
+    def hparts(self, conf, pending, main):
+        return None
+
+
+def synth(n_rounds: int = 4000, s2: float = 0.3, rho: float = 0.6, seed: int = 0, q1: str = "prose",
+          cond=None, **kw) -> list[dict]:
+    """Every policy over the same synthetic passes (perfect calibration: the planners know each node's chance)."""
+
+    rng = np.random.default_rng(seed)
+    q = (Q1_BINS_PROSE, Q1_KEPT_PROSE) if q1 == "prose" else None
+    passes = [SynthPass(rng, i, s2, rho, q1=q, cond=cond) for i in range(n_rounds)]
+    return [run(passes, lambda p: p, pol, ident=True, **kw) for pol in policies()]
+
+
+__all__ = ["G9_VERIFY", "Policy", "SynthPass", "policies", "replay_all", "run", "synth"]
