diff --git a/tests/cuda/test_dsv41_attn_cuda_gpu.py b/tests/cuda/test_dsv41_attn_cuda_gpu.py
new file mode 100644
index 0000000..6fbfeb9
--- /dev/null
+++ b/tests/cuda/test_dsv41_attn_cuda_gpu.py
@@ -0,0 +1,348 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""REWRITE-PLAN 5 (``csa2/attn_cuda``, TF_DSV41_ATTN_CUDA=1) on the GPU (collected only where PyTorch sees an NVIDIA
+GPU), against the Triton paths it replaces:
+
+- attention: CUDA == ``attn.attention`` (_chunks + _merge) bit for bit at 1-64 rows: compressed lists with -1 holes
+  and every count class (0, < 128, 128, 129, 300, 512), no compressed rows (layers 0-1), bounded replay (lo), DSpark
+  block ends (hi), contiguous rows and the pool's packed 584-byte rows behind a page table, row mode (slots, stacked
+  rings, stacked page tables), sinks at -inf; a row alone == in a window; batched == alone; a graph of several
+  layers replayed over new inputs (the merge ticket resets itself); the emulator vs the GPU (fp32 noise);
+- top-k: select / blocks / gather_cand / select_blocks == dtopk bit for bit (ties straddling the cut, +0 / -0, NaN,
+  +inf, -inf rows, short rows, n < k), 1-64 rows, row mode; inside a graph; too many entries -> None (dtopk runs);
+- ``backend.Triton`` with the knob on == off for select_cand / reindex / attention;
+- [G13] lines: the device (SMs, shared memory, clusters), and in-graph us a layer (attention, DRAM-cold: 40 layers'
+  own rows, > L2) and a selection (top-k), Triton vs CUDA, at 1 / 2 / 4 / 8 / 16 rows.
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_attn_cuda_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.families.deepseek_v41.cuda.csa2 import attn  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import attn_cuda as AC  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import attn_cuda_emu as E  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import dtopk as DT  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import ref  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.backend import Win  # noqa: E402
+
+DEV = "cuda"
+H, RING, PSH = 32, 256, 4
+NINF = float("-inf")
+
+
+@pytest.fixture(autouse=True)
+def _on(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_ATTN_CUDA", "1")
+
+
+def _bits(t):
+    return t.contiguous().view(torch.int16 if t.element_size() == 2 else torch.int32)
+
+
+def _rows(n: int, g, packed: bool = False):
+    v, s = ref.quantize_rows(torch.randn((n, 512), generator=g) * 2)
+    if packed:                                                   # the pool's record: one 584-byte row
+        rec = torch.cat([v, s], 1).to(DEV)
+        return rec[:, :576], rec[:, 576:]
+    return v.to(DEV), s.to(DEV)
+
+
+class Case:
+    """One attention call's inputs (``rows``: row mode with ``S`` slots, stacked rings and page tables)."""
+
+    def __init__(self, R: int, counts, *, seed: int = 0, comp: bool = True, packed: bool = False, paged: bool = False,
+                 rows: bool = False, hi: bool = False, lo=None, n_comp: int = 4096, S: int = 3) -> None:
+        g = torch.Generator().manual_seed(seed)
+        self.R = R
+        self.q = (torch.randn((R, H, 512), generator=g) * 0.5).to(torch.bfloat16).to(DEV)
+        self.comp = _rows(n_comp * (S if rows else 1), g, packed) if comp else None
+        self.swa = _rows(RING * (S if rows else 1), g)
+        self.cs = torch.randn((8192, 64), generator=g).to(DEV)
+        self.sink = torch.randn((H,), generator=g).to(DEV)
+        self.sink[5] = NINF
+        rng = np.random.default_rng(seed)
+        tok = np.full((R, 512), -1, np.int32)
+        for r in range(R):
+            c = int(counts[r % len(counts)])
+            tok[r, :c] = np.sort(rng.choice(n_comp, c, replace=False))
+            if c > 40:
+                tok[r, 17] = -1
+        self.tok = torch.from_numpy(tok).to(DEV)
+        self.cnt = torch.tensor([int(counts[r % len(counts)]) for r in range(R)], dtype=torch.int32, device=DEV)
+        base = 3000
+        self.pos_host = [base + r for r in range(R)]
+        self.lo = torch.tensor(lo if lo is not None else [0] * R, dtype=torch.int32, device=DEV)
+        self.hi = torch.tensor([base + R + 2] * R, dtype=torch.int32, device=DEV) if hi else None
+        self.pg = {}
+        if paged:
+            pages = n_comp >> PSH
+            if rows:
+                pt = torch.stack([torch.randperm(pages, generator=g) + s * pages for s in range(S)]).to(torch.int32)
+            else:
+                pt = torch.randperm(pages, generator=g).to(torch.int32)
+            self.pg = {"page_table": pt.to(DEV), "page_shift": PSH}
+        if rows:
+            self.slots = torch.tensor([(r * 2 + 1) % S for r in range(R)], dtype=torch.int64, device=DEV)
+            self.pos = torch.tensor(self.pos_host, dtype=torch.int64, device=DEV)
+        else:
+            self.slots = None
+            self.pos = torch.tensor([base], dtype=torch.int32, device=DEV)
+
+    def run(self, cuda: bool, scratch, ticket, out=None):
+        out = torch.empty_like(self.q) if out is None else out
+        kw = dict(ring=RING, hi=self.hi, **self.pg)
+        if self.slots is not None:
+            kw["slots"] = self.slots
+        tok, cnt = (self.tok, self.cnt) if self.comp is not None else (None, None)
+        if cuda:
+            got = AC.attention(self.q, self.comp, tok, cnt, self.swa, self.lo, self.pos, self.sink, self.cs, out,
+                               scratch, ticket, **kw)
+            assert got is not None, AC.why_not_attn(self.q, self.comp, tok, cnt, self.swa, self.lo, scratch,
+                                                    ticket, RING, self.pg.get("page_table"), self.slots)
+            return out
+        return attn.attention(self.q, self.comp, tok, cnt, self.swa, self.lo, self.pos, self.sink, self.cs, out,
+                              scratch, **kw)
+
+
+def _pair(case: Case):
+    sc, tk = attn.Scratch(64, DEV), AC.Ticket(64, H, DEV)
+    want = case.run(False, sc, tk).clone()
+    got = case.run(True, sc, tk).clone()
+    return got, want
+
+
+COUNTS = [[512, 300, 0, 129], [128, 1, 77, 511]]
+
+
+@pytest.mark.parametrize("R", [1, 2, 3, 4, 8, 16, 64])
+@pytest.mark.parametrize("variant", ["plain", "packed_paged", "rows_paged", "swa_only", "hi_lo"])
+def test_attention_equals_triton(R, variant):
+    kw = {"plain": {}, "packed_paged": dict(packed=True, paged=True), "rows_paged": dict(rows=True, paged=True,
+          packed=True), "swa_only": dict(comp=False), "hi_lo": dict(hi=True, lo=[2950 + r for r in range(R)])}
+    for counts in COUNTS:
+        got, want = _pair(Case(R, counts, seed=R * 31 + len(variant), **kw[variant]))
+        assert torch.equal(_bits(got), _bits(want)), (variant, R, counts)
+
+
+def test_kwidth_is_read_from_triton():
+    assert AC.kwidth() in (2, 4)
+    print(f"\n[G13] attn_cuda: Triton's _chunks kWidth on this GPU {AC.kwidth()}; device {AC.info()}")
+
+
+def test_row_alone_equals_window_and_batched():
+    R = 6
+    case = Case(R, [512, 300, 0, 129, 64, 200], seed=4, rows=True, paged=True, packed=True)
+    sc, tk = attn.Scratch(64, DEV), AC.Ticket(64, H, DEV)
+    win = case.run(True, sc, tk).clone()
+    for r in range(R):
+        one = Case(R, [512, 300, 0, 129, 64, 200], seed=4, rows=True, paged=True, packed=True)
+        for name in ("q", "tok", "cnt", "lo", "slots", "pos"):
+            setattr(one, name, getattr(one, name)[r:r + 1].contiguous())
+        assert torch.equal(_bits(one.run(True, sc, tk)), _bits(win[r:r + 1])), r
+
+
+def test_graph_replay_of_layers():
+    cases = [Case(4, COUNTS[i % 2], seed=50 + i, packed=True, paged=True) for i in range(3)]
+    sc, tk = attn.Scratch(64, DEV), AC.Ticket(64, H, DEV)
+    outs = [torch.empty_like(c.q) for c in cases]
+    for c, o in zip(cases, outs):
+        c.run(True, sc, tk, o)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        for c, o in zip(cases, outs):
+            c.run(True, sc, tk, o)
+    for seed in (1, 2, 3):
+        g = torch.Generator().manual_seed(seed)
+        for c in cases:
+            c.q.copy_((torch.randn(c.q.shape, generator=g) * 0.5).to(torch.bfloat16))
+        graph.replay()
+        torch.cuda.synchronize()
+        for c, o in zip(cases, outs):
+            assert torch.equal(_bits(o), _bits(c.run(False, attn.Scratch(64, DEV), tk)))
+    assert int(tk.t.abs().sum()) == 0                            # every ticket back at 0
+
+
+def test_emulator_matches_gpu():
+    R = 2
+    case = Case(R, [512, 260], seed=8, n_comp=2048)
+    sc, tk = attn.Scratch(64, DEV), AC.Ticket(64, H, DEV)
+    got = case.run(True, sc, tk).float().cpu().numpy()
+    comp = ref.dequantize_rows(case.comp[0].cpu(), case.comp[1].cpu()).float().numpy()
+    swa = ref.dequantize_rows(case.swa[0].cpu(), case.swa[1].cpu()).float().numpy()
+    emu = E.attention(case.q.float().cpu().numpy(), comp, case.tok.cpu().numpy(), case.cnt.cpu().numpy(), swa,
+                      case.lo.cpu().numpy(), case.pos_host, case.sink.cpu().numpy(), case.cs.cpu().numpy(),
+                      ring=RING, kw=AC.kwidth())
+    err = np.abs(got - emu)
+    tol = 8e-3 * np.maximum(1.0, np.abs(emu))
+    print(f"\n[G13] attn_cuda emulator vs GPU: max |d| {err.max():.3g}, {np.mean(err == 0) * 100:.1f}% identical")
+    assert (err <= tol).all()
+
+
+# ---- top-k ---------------------------------------------------------------------------------------------------------
+
+def _scores(R: int, n: int, P: int, ratio: int, seed: int) -> torch.Tensor:
+    g = torch.Generator().manual_seed(seed)
+    s = torch.randn((R, n), generator=g)
+    if n > 1000:
+        s[:, 10:60] = 0.0
+        s[:, 61:70] = -0.0
+        s[:, 100:n:7] = 1.5
+        s[:, n // 2] = float("nan")
+        s[:, 5] = float("inf")
+    for r in range(R):
+        s[r, (P + r + 1) // ratio:] = NINF
+    return s.to(DEV).contiguous()
+
+
+@pytest.mark.parametrize("R", [1, 2, 4, 16, 64])
+@pytest.mark.parametrize("n", [300, 700, 2048, 16384, 32768, 75000])
+def test_select_equals_dtopk(R, n):
+    ratio = 4
+    P = n * ratio - R
+    s = _scores(R, n, P, ratio, R * 7 + n)
+    win = Win.make(P, R, DEV)
+    want = DT.select(s, win.t, ratio, 512)
+    for pos in (win.t, win.positions):
+        got = AC.select(s, pos, ratio, 512)
+        assert torch.equal(got[0], want[0]) and torch.equal(got[1], want[1])
+    if R > 1:
+        one = AC.select(s[R - 1:].contiguous(), win.positions[R - 1:], ratio, 512)
+        assert torch.equal(one[0][0], want[0][R - 1]) and int(one[1][0]) == int(want[1][R - 1])
+
+
+@pytest.mark.parametrize("R", [1, 4, 16])
+@pytest.mark.parametrize("n", [3000, 32768, 75000])
+def test_blocks_gather_and_fused_equal_dtopk(R, n):
+    P = n - R
+    s = _scores(R, n, P, 1, n + R)
+    win = Win.make(P, R, DEV)
+    cand = DT.blocks(s, win.t, 1, 2048)
+    assert torch.equal(AC.blocks(s, win.t, 1, 2048), cand)
+    sel, cnt, blk = AC.select_blocks(s, win.t, 1, 512, 2048)
+    ws, wc = DT.select(s, win.t, 1, 512)
+    assert torch.equal(blk, cand) and torch.equal(sel, ws) and torch.equal(cnt, wc)
+    g = torch.Generator().manual_seed(n)
+    s2 = torch.randn((R, 2048 * 8), generator=g).to(DEV)
+    s2[:, 50:3000:5] = 0.25
+    keys = (cand.to(torch.int64)[:, :, None] * 8 + torch.arange(8, device=DEV)).reshape(R, -1)
+    s2 = torch.where((cand[:, :, None] >= 0).expand(R, 2048, 8).reshape(R, -1), s2, torch.full_like(s2, NINF))
+    s2 = torch.where(keys < (win.positions[:, None] + 1), s2, torch.full_like(s2, NINF)).contiguous()
+    want = DT.gather_cand(s2, cand, win.t, 1, 512)
+    got = AC.gather_cand(s2, cand, win.t, 1, 512)
+    assert torch.equal(got[0], want[0]) and torch.equal(got[1], want[1])
+
+
+def test_topk_graph_replay_and_limits():
+    R, n, ratio = 4, 16384, 4
+    P = n * ratio - R
+    win = Win.make(P, R, DEV)
+    cs = torch.empty((R, n), device=DEV)
+    cs.copy_(_scores(R, n, P, ratio, 1))
+    AC.select_blocks(cs, win.t, ratio, 512, 2048)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        sel, cnt, blk = AC.select_blocks(cs, win.t, ratio, 512, 2048)
+    for seed in (2, 3, 4):
+        cs.copy_(_scores(R, n, P, ratio, seed))
+        graph.replay()
+        torch.cuda.synchronize()
+        ws, wc = DT.select(cs, win.t, ratio, 512)
+        assert torch.equal(sel, ws) and torch.equal(cnt, wc) and torch.equal(blk, DT.blocks(cs, win.t, ratio, 2048))
+    big = torch.zeros((1, 8 * 512 * 31 + 8), device=DEV)
+    assert AC.select(big, win.t[:1], 1, 512) is None
+
+
+def test_backend_on_equals_off():
+    from tensorfold.families.deepseek_v41.cuda.csa2.backend import Triton
+    from tensorfold.families.deepseek_v41.cuda.csa2.stores import Keys, Records
+
+    R, ratio, nk = 4, 4, 30000
+    P = nk * ratio - R
+    g = torch.Generator().manual_seed(5)
+    qi = torch.randn((R, 32, 128), generator=g).to(torch.bfloat16).to(DEV)
+    w = torch.randn((R, 32), generator=g).to(DEV)
+    ik = torch.randn((nk, 128), generator=g)
+    ik[1000:1400] = 0.0
+    keys = Keys(ik.to(torch.bfloat16).to(DEV))
+    be = Triton(R, H, DEV)
+    win = Win.make(P, R, DEV)
+    case = Case(R, [512, 300, 0, 129], seed=6)
+
+    class _T:
+        cs = case.cs
+
+    out = {}
+    for on in (False, True):
+        be.acuda = on
+        sel, cand = be.select_cand(qi, w, keys, win, ratio, 512, 8, 2048)
+        rsel = be.reindex(qi, w, keys, win, cand, ratio, 512, 8)
+        o = be.attention(case.q, Records(*case.comp), case.tok, case.cnt, Records(*case.swa), case.lo,
+                         Win.make(3000, R, DEV), case.sink, _T, RING)
+        out[on] = [sel, cand, rsel, sel._dsv41_counts[1], rsel._dsv41_counts[1], _bits(o)]
+    for a, b in zip(out[False], out[True]):
+        assert torch.equal(a, b)
+
