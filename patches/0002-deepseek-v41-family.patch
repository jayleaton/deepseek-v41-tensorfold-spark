+    const uint32_t lane = tid & 31u;
+    const uint32_t k = tid >> 5;
+    if (lane < static_cast<uint32_t>(a.world * a.n_hca) && k < a.pollers) {
+        const int peer = static_cast<int>(lane) / a.n_hca;
+        const int hca = static_cast<int>(lane) - peer * a.n_hca;
+        if (peer != a.rank && (used < 0 || hca == used)) {
+            const uint32_t *flag = reinterpret_cast<const uint32_t *>(
+                a.flag_base + ((static_cast<uint64_t>(peer) * a.slots + slot) * a.n_hca + hca) * a.flag_stride);
+            if (k > 0u && a.stagger_ns != 0u) {
