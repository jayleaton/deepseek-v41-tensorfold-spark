index 0000000..1a42e7d
--- /dev/null
+++ b/tests/test_dsv41_nucleus.py
@@ -0,0 +1,191 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Top-p sampling without top-k from candidates (``cuda/nucleus.py``) == ``exact_sampling.choose_rows`` over the
+whole vocabulary, token for token:
+
+- rows split over two vocabulary halves (bf16-valued logits: many exact ties), every rank's top C merged as
+  ``SlotsForward.candidates`` merges them, the halves' (max, sum) combined: whenever the candidates decide a row its
+  token is the full row's; rows they cannot decide (flat, guard, ties at the cut) fall back to the full row;
+- the batcher with TF_DSV41_NUCLEUS = 16 (keep counts and fallbacks) gives the replies of TF_DSV41_NUCLEUS = 0 (the
+  old full-vocabulary candidates), drafted and serial, one rank and two;
+- the plan carries the specs; ``Candidates.rows`` slices them.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+from tensorfold.engine.exact_sampling import Sampling, choose_rows
+from tensorfold.families.deepseek_v41.cuda import nucleus as NU
+from tensorfold.families.deepseek_v41.cuda.plan import Plan, WindowSpec
+from tensorfold.families.deepseek_v41.cuda.protocol import Candidates
+
+
+def _merged(lg: torch.Tensor, c: int, world: int = 2):
+    """``SlotsForward.candidates``' merge of each half's top c (value desc, id asc) -> (ids, values) [R, c]."""
+
+    R, V = lg.shape
+    half = V // world
+    vals, ids = [], []
+    for r in range(world):
+        part = lg[:, r * half:(r + 1) * half]
+        v, i = torch.sort(-part, dim=1, stable=True)
+        vals.append((-v[:, :c]).numpy())
+        ids.append((i[:, :c] + r * half).numpy())
+    values, tokens = np.concatenate(vals, 1).astype(np.float32), np.concatenate(ids, 1).astype(np.int64)
+    order = np.lexsort((tokens, -values), axis=-1)[:, :c]
+    return np.take_along_axis(tokens, order, 1), np.take_along_axis(values, order, 1)
+
+
+def _decide(lg: torch.Tensor, c: int, sp, world: int = 2):
+    ids, vals = _merged(lg, c, world)
+    half = lg.shape[1] // world
+    temps = torch.full((lg.shape[0],), float(sp[0]), dtype=torch.float64)
+    st = np.stack([NU.row_stats(lg[:, r * half:(r + 1) * half], temps).numpy() for r in range(world)], 1)
+    info = {}
+    for r in range(lg.shape[0]):
+        zm, z = NU.normalizer(st[r], sp[0])
+        k = NU.keep_count(vals[r], ids[r], sp, zm, z)
+        info[r] = ("keep", k) if k is not None else \
+            ("full", np.arange(lg.shape[1], dtype=np.int64), lg[r].numpy().astype(np.float32))
+    return ids, vals, info
+
+
+@pytest.mark.parametrize("scale", [0.5, 3.0, 12.0])
+@pytest.mark.parametrize("c", [8, 64, 512])
+def test_candidates_choose_the_full_rows_token(scale, c):
+    g = torch.Generator().manual_seed(int(scale * 10) + c)
+    V, R = 4096, 24
+    lg = (torch.randn(R, V, generator=g) * scale).to(torch.bfloat16).float()     # bf16 values: exact ties
+    lg[:4, :] = torch.round(lg[:4, :])                                          # heavy ties
+    decided = fell = 0
+    for t, top_p, min_p in ((0.7, 0.95, 0.0), (1.0, 0.9, 0.05), (0.3, 0.5, 0.0), (1.5, 0.999, 0.0)):
+        s = Sampling(seed=1234, temperature=t, top_k=0, top_p=top_p, min_p=min_p)
+        sp = NU.spec(s)
+        ids, vals, info = _decide(lg, c, sp)
+        positions = list(range(100, 100 + R))
+        got = NU.choose(vals, ids, positions, s, info)
+        full_ids = np.broadcast_to(np.arange(V, dtype=np.int64), (R, V)).copy()
+        want = choose_rows(lg.numpy().astype(np.float32), full_ids, positions, s)
+        assert got == want
+        decided += sum(1 for v in info.values() if v[0] == "keep")
+        fell += sum(1 for v in info.values() if v[0] == "full")
+    if c >= 64 and scale >= 3.0:
+        assert decided > 0                                  # the candidates decide most peaked rows
+    if c == 8 and scale <= 0.5:
+        assert fell > 0                                     # a flat row's nucleus is past 8 candidates
+
+
+def test_guard_and_ties_fall_back():
+    # two equal logits on top, top_p exactly at their cumulative mass (0.5 each over two tokens): the guard
+    lg = torch.full((1, 64), -1e4)
+    lg[0, 3] = lg[0, 40] = 5.0
+    sp = [1.0, 0.5, 0.0]
+    ids, vals, info = _decide(lg, 8, sp)
+    assert info[0][0] == "full"
+    # the last kept value tied with the candidates' last: the cut could split a tie
+    lg = torch.zeros((1, 64))
+    lg[0, 0] = 10.0
+    ids, vals = _merged(lg, 4)
+    temps = torch.ones(1, dtype=torch.float64)
+    st = np.stack([NU.row_stats(lg[:, :32], temps).numpy(), NU.row_stats(lg[:, 32:], temps).numpy()], 1)
+    zm, z = NU.normalizer(st[0], 1.0)
+    assert NU.keep_count(vals[0], ids[0], [1.0, 0.99999, 0.0], zm, z) is None
+
+
+def test_spec_and_counts():
+    assert NU.spec(None) == [] and NU.spec(Sampling(seed=1, temperature=0.0, top_k=0, top_p=0.9)) == []
+    assert NU.spec(Sampling(seed=1, temperature=0.7, top_k=20, top_p=0.9)) == []
+    assert NU.spec(Sampling(seed=1, temperature=0.7, top_k=0, top_p=1.0)) == []
+    assert NU.spec(Sampling(seed=1, temperature=0.7, top_k=0, top_p=0.95, min_p=0.1)) == [0.7, 0.95, 0.1]
+
+
+def test_plan_and_candidates_carry_the_specs():
+    p = Plan(windows=[WindowSpec(0, 5, 9, 3, [], [], [0.7, 0.95, 0.0]), WindowSpec(1, 7, 4)])
+    q = Plan.decode(p.encode())
+    assert q.windows[0].nucleus == [0.7, 0.95, 0.0] and q.windows[1].nucleus == []
+    c = Candidates(np.zeros((5, 2), dtype=np.int64), np.zeros((5, 2), dtype=np.float32),
+                   {2: ("keep", 1), 3: ("keep", 2), 4: ("keep", 1)})
+    assert c.rows(0, 2).nucleus is None and c.rows(2, 5).nucleus == {0: ("keep", 1), 1: ("keep", 2), 2: ("keep", 1)}
+
+
+# -- the batcher on the real forward (CPU twin) ------------------------------------------------------------------
+import dsv41_dspark_fakes as DF  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda.batch import Job  # noqa: E402
+
+HOT = [Sampling(seed=11, temperature=1.1, top_k=0, top_p=0.9, min_p=0.02),
+       Sampling(seed=5, temperature=0.2, top_k=0, top_p=0.95), None]      # the fake model: flat at 1.1, peaked at 0.2
+PROMPTS = [[int(t) for t in np.random.default_rng(40 + i).integers(3, 250, size=37 + 11 * i)] for i in range(3)]
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41nuc"))
+
+
+def _replies(ck, monkeypatch, nucleus: str, depth=None, n=3):
+    monkeypatch.setenv(NU.ENV, nucleus)
+    fw = DF.forward(ck, slots=n)
+    seen = []
+    real = fw.window
+
+    def rec(*a, **k):
+        out = real(*a, **k)
+        seen.append(out.nucleus or {})
+        return out
+
+    fw.window = rec
+    b = DF.batcher(ck, fw, n=n, depth=depth)
+    got = DF.run(b, [Job(list(p), 16, s) for p, s in zip(PROMPTS, HOT)])
+    return got, seen
+
+
+def test_batcher_nucleus_equals_full_vocabulary(ck, monkeypatch):
+    old, seen_old = _replies(ck, monkeypatch, "0")
+    assert not any(seen_old)
+    new, seen_new = _replies(ck, monkeypatch, "16")
+    kinds = [v[0] for d in seen_new for v in d.values()]
+    assert new == old and "keep" in kinds and "full" in kinds
+    serial, _ = _replies(ck, monkeypatch, "16", depth=0)
+    assert serial == old
+
+
+def test_two_ranks_nucleus_alike(ck, monkeypatch):
+    import queue
+    import threading
+
+    import dsv41_fakes as FK
+
+    monkeypatch.setenv(NU.ENV, "16")
+
+    class PairLink:
+        def __init__(self):
+            self.q = queue.Queue()
+
+        def send(self, plan):
+            self.q.put(list(plan))
+
+        def recv(self):
+            return self.q.get(timeout=120)
+
+    pair = FK.ThreadPair()
+    comms = pair.comms()
+    fws = pair.run([lambda r=r: DF.forward(ck, slots=2, rank=r, world=2, comm=comms[r]) for r in range(2)])
+    link = PairLink()
+    b0 = DF.batcher(ck, fws[0], n=2, link=link, rank=0)
+    b1 = DF.batcher(ck, fws[1], n=2, link=link, rank=1)
+    t = threading.Thread(target=b1.follow, daemon=True)
+    t.start()
+    got = DF.run(b0, [Job(list(PROMPTS[0]), 12, HOT[0]), Job(list(PROMPTS[1]), 12, HOT[1])])
+    b0.send_stop()
+    t.join(timeout=120)
+    assert not t.is_alive()
+    monkeypatch.setenv(NU.ENV, "0")
+    one = DF.run(DF.batcher(ck, DF.forward(ck, slots=2), n=2), [Job(list(PROMPTS[0]), 12, HOT[0]),
+                                                               Job(list(PROMPTS[1]), 12, HOT[1])])
+    assert [g[:4] for g in got] == [o[:4] for o in one] and all(len(g) == 12 for g in got)
