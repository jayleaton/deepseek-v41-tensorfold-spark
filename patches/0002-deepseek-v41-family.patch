@@ -0,0 +1,277 @@
+"""G14 (``GLM53_TF_ROCE_FAST`` / ``_POLLERS``, the host trace ring) on ONE GPU: ``roce.Runtime(loop_xor=K)`` replaces
+the RDMA proxy with ``roce.cpp``'s ``Loop`` thread, which plays the peer through the same pinned region, flags and
+doorbell (the wire protocol the fast kernel must keep): every peer's shard is this rank's XOR K.
+
+- bits: every size and alignment (DeepSeek-V4.1's 1 / 2 / 4 / 6 / 8 bf16 rows of 5,120 among them), eager, for the
+  fast kernel with 1 and 4 pollers, striped and one-HCA, both ranks: == the expected concatenation, and == the
+  classic kernel's output for the same input;
+- graphs: 81 exchanges a replay with the payload changing every op and an in-graph mismatch count (a stale slot or a
+  flag ahead of its payload would count), 40 replays; the epoch advances by one an op;
+- failure: a peer that stops answering times out in ~timeout, poisons, reports "never arrived"; the peer's half of
+  the output is not written (the local half is: the fast kernel copies it while waiting); later launches are no-ops;
+  a poisoned graph replay is a no-op;
+- trace: the device ring's stamps are ordered for the fast kernel; the host ring (``trace_host``) works for both
+  kernels and ``rocedump``'s thread reads it with no CUDA call, while a CUDA graph is captured in global mode.
+
+    pytest -q tests/cuda/test_roce_g14_gpu.py        (inside the image, PYTHONPATH=<tree>/src; ~3 min)
+"""
+
+from __future__ import annotations
+
+import json
+import time
+
+import pytest
+import torch
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from tensorfold.families.glm5_next.spark import roce, roce_split, rocedump  # noqa: E402
+
+KEY = 0x6B
+D = 5120
+SIZES = [1, 3, 7, 16, 100, 4096, 2 * D, 2 * 2 * D, 16 * 1024 + 4, 4 * 2 * D, 6 * 2 * D, 8 * 2 * D, 128 * 1024 + 12,
+         256 * 1024]
+VARIANTS = [(False, 1), (True, 1), (True, 4)]
+IDS = ["classic", "fast", "fast-p4"]
+
+
+def _rt(rank=0, fast=True, pollers=1, stripe_kb=0, trace=0, trace_host=False, timeout_s=10.0, stall_after=-1,
+        blocks=8, threads=512):
+    s = roce.Settings(max_bytes=256 * 1024, timeout_s=timeout_s, blocks=blocks, threads=threads, stripe_kb=stripe_kb,
+                      fast=fast, pollers=pollers, trace=trace, trace_host=trace_host)
+    return roce.Runtime(rank=rank, world=2, hcas=[], n_hca=2, s=s, loop_xor=KEY, loop_stall_after=stall_after)
+
+
+def _expect(send: torch.Tensor, rank: int) -> torch.Tensor:
+    mine = send.contiguous().view(-1).view(torch.uint8)
+    peer = mine ^ KEY
+    return torch.cat([mine, peer] if rank == 0 else [peer, mine])
+
+
+def _close(*rts):
+    torch.cuda.synchronize()
+    for rt in rts:
+        rt.close()
+
+
+@pytest.mark.parametrize("fast,pollers", VARIANTS, ids=IDS)
+@pytest.mark.parametrize("stripe_kb", [0, 32])
+@pytest.mark.parametrize("rank", [0, 1])
+def test_sizes_eager(fast, pollers, stripe_kb, rank):
+    rt = _rt(rank, fast, pollers, stripe_kb)
+    try:
+        g = torch.Generator(device="cuda").manual_seed(11)
+        for n in SIZES:
+            for off in (0, 1, 4):
+                src = torch.randint(0, 256, (n + off,), dtype=torch.uint8, device="cuda", generator=g)
+                send = src[off:]
+                dst = torch.full((2 * n + off,), 0xEE, dtype=torch.uint8, device="cuda")
+                recv = dst[off:]
+                rt.gather(send, recv)
+                torch.cuda.synchronize()
+                rt.check()
+                assert torch.equal(recv, _expect(send, rank)), (n, off)
+        snap = rt.snapshot()
+        assert snap["completed"] == snap["doorbell"] == 3 * len(SIZES) and snap["failed"] == 0
+    finally:
+        _close(rt)
+
+
+@pytest.mark.parametrize("rows", [1, 2, 4, 6, 16])
+def test_fast_equals_classic_bytes(rows):
+    """The same bf16 partials [rows, 5,120] through both kernels: the same bytes out."""
+
+    a, b = _rt(0, fast=False), _rt(0, fast=True, pollers=4)
+    try:
+        x = (torch.randn(rows, D, device="cuda") * 3).to(torch.bfloat16)
+        ya = torch.empty((2 * x.numel(),), dtype=torch.bfloat16, device="cuda")
+        yb = torch.empty_like(ya)
+        a.gather(x.view(-1), ya)
+        b.gather(x.view(-1), yb)
+        torch.cuda.synchronize()
+        assert torch.equal(ya.view(torch.int16), yb.view(torch.int16))
+        assert torch.equal(yb[:x.numel()].view(torch.int16), x.view(-1).view(torch.int16))
+    finally:
+        _close(a, b)
+
+
+@pytest.mark.parametrize("fast,pollers", VARIANTS, ids=IDS)
+@pytest.mark.parametrize("rows", [1, 4])
+def test_graph_changing_payload(fast, pollers, rows):
+    """81 exchanges a replay (a 1-row window's count), payload = base + counter, every op checked in the graph."""
+
+    rank = 1
+    rt = _rt(rank, fast, pollers)
+    try:
+        e = rows * D // 2                                       # int32 words of rows bf16 rows
+        base = torch.randint(-2**30, 2**30, (e,), dtype=torch.int32, device="cuda")
+        cnt = torch.zeros((1,), dtype=torch.int32, device="cuda")
+        send = torch.empty_like(base)
+        recv = torch.empty((2 * e,), dtype=torch.int32, device="cuda")
+        bad = torch.zeros((1,), dtype=torch.int64, device="cuda")
+
+        def body():
+            for _ in range(81):
+                cnt.add_(1)
+                torch.add(base, cnt, out=send)
+                rt.gather(send, recv)
+                want_peer = ((base + cnt).view(torch.uint8) ^ KEY).view(torch.int32)
+                bad.add_((recv[:e] != want_peer).sum() + (recv[e:] != base + cnt).sum())
+
+        s = torch.cuda.Stream()
+        s.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(s):
+            body()
+        torch.cuda.current_stream().wait_stream(s)
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            body()
+        e0 = int(rt.counters[0].item())
+        bad.zero_()
+        for _ in range(40):
+            graph.replay()
+        torch.cuda.synchronize()
+        rt.check()
+        assert int(bad.item()) == 0
+        assert int(rt.counters[0].item()) - e0 == 40 * 81
+    finally:
+        _close(rt)
+
+
+@pytest.mark.parametrize("pollers", [1, 4])
+def test_fast_timeout_poisons_and_reports(monkeypatch, tmp_path, pollers):
+    monkeypatch.setenv("GLM53_TF_ROCE_MARK", str(tmp_path / "roce-failed"))
+    rt = _rt(0, fast=True, pollers=pollers, timeout_s=0.5, stall_after=3)
+    try:
+        x = torch.arange(2048, dtype=torch.float32, device="cuda")
+        y = torch.zeros(4096, device="cuda")
+        for _ in range(3):
+            rt.gather(x, y)
+        torch.cuda.synchronize()
+        rt.check()
+        y.fill_(-1)
+        t = time.perf_counter()
+        rt.gather(x, y)                                       # the peer never answers
+        torch.cuda.synchronize()
+        waited = time.perf_counter() - t
+        assert 0.4 < waited < 5.0, waited
+        assert rt.failed
+        with pytest.raises(roce.RoceError, match="timed out after 0.5 s waiting for rank 1") as info:
+            rt.check()
+        assert "never arrived" in str(info.value) and "sequence 4" in str(info.value)
+        assert torch.equal(y[2048:], torch.full((2048,), -1.0, device="cuda"))   # the peer's half: untouched
+        assert torch.equal(y[:2048], x)                       # the local half: copied while waiting (fast path)
+        assert rt.snapshot()["completed"] == 3
+        y.fill_(-2)                                           # a direct launch (gather() raises first: checked)
+        stage, tail = rt._counter_addrs(1)
+        rt.launcher.run(x.data_ptr(), y.data_ptr(), x.numel() * 4, 1, stage, tail, rt.timeout_ns)
+        torch.cuda.synchronize()
+        assert torch.equal(y, torch.full_like(y, -2.0))       # poisoned: the launch does nothing
+    finally:
+        _close(rt)
+
+
+def test_fast_poisoned_graph_replay_is_a_noop(monkeypatch, tmp_path):
+    monkeypatch.setenv("GLM53_TF_ROCE_MARK", str(tmp_path / "roce-failed"))
+    rt = _rt(0, fast=True, pollers=2, timeout_s=0.3, stall_after=8)
+    try:
+        x = torch.randn(1024, device="cuda")
+        y = torch.zeros(2048, device="cuda")
+        s = torch.cuda.Stream()
+        s.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(s):
+            for _ in range(2):
+                rt.gather(x, y)
+        torch.cuda.current_stream().wait_stream(s)
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            for _ in range(4):
+                rt.gather(x, y)
+        graph.replay()                                        # ops 3..6: delivered
+        torch.cuda.synchronize()
+        rt.check()
+        graph.replay()                                        # ops 7, 8 delivered, 9 times out, 10 is a no-op
+        torch.cuda.synchronize()
+        assert rt.failed
+        done = rt.snapshot()["completed"]
+        assert done == 8
+        t = time.perf_counter()
+        graph.replay()                                        # poisoned: no wait, nothing moves
+        torch.cuda.synchronize()
+        assert time.perf_counter() - t < 0.2
+        assert rt.snapshot()["completed"] == done
+    finally:
+        _close(rt)
+
+
+def test_fast_trace_ring_ordered():
+    rt = _rt(0, fast=True, pollers=4, trace=256)
+    try:
+        x = torch.randn(4 * D, device="cuda").to(torch.bfloat16)
+        y = torch.empty((2 * x.numel(),), dtype=torch.bfloat16, device="cuda")
+        for _ in range(300):
+            rt.gather(x, y)
+        torch.cuda.synchronize()
+        rows = rt.trace_rows()
+        assert len(rows) == 256
+        for r in rows:
+            assert 0 < r["start"] <= r["bell"] <= r["flag"] <= r["end"], r
+        assert all(roce_split.components(r) is not None for r in rows)
+    finally:
+        _close(rt)
+
+
+@pytest.mark.parametrize("fast", [False, True], ids=["classic", "fast"])
+def test_host_ring_and_dump_thread(monkeypatch, tmp_path, fast):
+    """The host ring: ordered stamps for both kernels (the classic one stores the flags stamp instead of its device
+    atomicMax); the dump thread writes lines while the main thread captures and replays a graph in global mode."""
+
+    prefix = tmp_path / "trace"
+    monkeypatch.setenv("GLM53_TF_ROCE_TRACE_DUMP", str(prefix))
+    monkeypatch.setenv("GLM53_TF_ROCE_TRACE_DUMP_S", "0.02")
+    rt = _rt(1, fast=fast, pollers=1, trace=1024, trace_host=True)
+    try:
+        assert rt.trace_buf is None and rt.trace_host is not None
+        th = rocedump.start_thread(rt)
+        assert th is not None and th.is_alive()
+        x = torch.randn(2 * D, device="cuda").to(torch.bfloat16)
+        y = torch.empty((2 * x.numel(),), dtype=torch.bfloat16, device="cuda")
+        s = torch.cuda.Stream()
+        s.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(s):
+            for _ in range(3):
+                rt.gather(x, y)
+        torch.cuda.current_stream().wait_stream(s)
+        torch.cuda.synchronize()
+        for _ in range(5):                                    # captures while the thread polls (global mode)
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph, capture_error_mode="global"):
+                for _ in range(81):
+                    rt.gather(x, y)
+            for _ in range(10):
+                graph.replay()
+            torch.cuda.synchronize()
+            time.sleep(0.05)
+        rt.check()
+        assert torch.equal(y.view(torch.int16), _expect(x, 1).view(torch.int16))
+        rows = rt.trace_rows()
+        assert rows and all(0 < r["start"] <= r["bell"] <= r["flag"] <= r["end"] for r in rows)
+        time.sleep(0.1)
+        path = tmp_path / "trace-r1.jsonl"
+        lines = [json.loads(v) for v in path.read_text().splitlines()]
+        assert lines, "no dump line"
+        dumped = roce_split.load_rows(str(path))
+        assert len(dumped) > 100 and all(roce_split.components(r) is not None for r in dumped)
+        seqs = [r["seq"] for r in dumped]
+        assert seqs == sorted(set(seqs))
+    finally:
+        _close(rt)
+
+
+def test_pollers_need_threads():
+    with pytest.raises(Exception, match="pollers"):
+        _rt(0, fast=True, pollers=8, threads=128)
