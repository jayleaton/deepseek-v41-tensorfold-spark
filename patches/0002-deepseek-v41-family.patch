+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""A decode window's attention sublayer as two branches of the captured graph (REWRITE-PLAN candidate g + e4,
+``TF_DSV41_BRANCHES``, default 0): the CSA2 indexer and compressor chains run on a side stream, forked from and
+joined back to the main stream with events inside the capture, while the main path streams its projections.
+
+Why. On the 8 index layers (kv sources 2 / 8 / 14 / 20, reindex 24 / 28 / 32 / 36) the window serialises ~95 us of
+latency-bound, under-occupied launches (``_scores``, the dtopk selection, ``_plain``, the compressor's pool / store /
+``wk`` / key store) with ~75 us of the main path that does not need them (wq_b's 13 MB stream, RoPE, the SWA store).
+Only the attention core needs both. Here (``plan``):
+
+    main:  x group ------ rms_pair -- wq_b (x3seg, alone) -- L2PF o -- RoPE q -- SWA store --+-- attention core
+    side:  weights_proj --------------+ [compressor] -- indexer wq_b -- RoPE qi -- select ---+
+
+so the side chain hides under wq_b's weight stream (the streamers do not add bandwidth to each other; what is won
+is the latency-bound chain). Every other layer only moves its SWA store beside wq_b. The fused q group (wq_b +
+the indexer's wq_b, one launch) becomes two 1-segment x3seg launches, one a stream: ``fused_proj``'s segment table
+gives each segment upstream's programs, so the bits are the group's (and each launch has its own split-K counters:
+no group runs on two streams at once, ``check``).
+
+e4 (the copies on this path, folded into their producers, the same values):
+- the indexer's ``weights_proj``: ``_plain`` stores bf16 (its fp64 sums rounded to fp32, then to bf16) instead of
+  fp64 + three cast launches; the scoring kernels widen bf16 w as they load it (``backend._w32``);
+- the compressor projection stays bf16 as the x group stores it (no ``.to(fp32)``), and ratio-2 pooling reads the
+  carry through its own pointer (``compress.pool_norm(carry=...)``: no ``torch.cat``). The pending rows a commit
+  keeps are then bf16; ``forward.keep`` copies them into the fp32 carry (an exact widening: the same carry);
+- a window of one segment (every row-mode window) takes the attention core's output as it is (no slice copy).
+
+Exactness: the same kernels compute every value from the same inputs; only the launch order and the overlap
+change. Every stream-crossing value is produced before the join that publishes it (``check`` simulates it), every
+side-stream branch is joined before the sublayer returns (a capture holds no open fork), and the values the side
+reads stay referenced until the join (the caching allocator's per-stream reuse cannot hand them out early).
+tests/test_dsv41_branches.py (the plans, the executed order, branched == serial in the interpreter),
+tests/cuda/test_dsv41_branches_gpu.py (on == off bit for bit, graph replay == eager, batched == alone).
+
+G13 (2026-10-03) and the G14 changes. G13 measured the 1-row window at 26.2 ms in one boot and 31.5 in another
+(off: 26.6 / 26.6). That number is one boot-time calibration sample, the best of 3 back-to-back replays taken first
+after the prefill, maxed over the ranks. The serving rounds of the same boots do not show it: ``window`` ms per round
+was off 30.42 / 30.38, on 29.90 at the same 2.31 rows a window, and the "31.5" boot 30.15 at 2.47 rows. That boot's
+depth policy, priced from 31.5, never chose a 1-row round (zero-depth rounds 0 against 36-49), which explains its
+-4% prose T0. The capture is deterministic: plans depend on the layer kind alone, the side stream exists before any
+capture, and every fork is joined. G14 makes that explicit and adds levers to test:
+
+- **one capture stream a device** (``capture_stream``): the row graphs capture on the driver's own main stream, so
+  every graph forks from and joins to the same two streams, with priorities set when they are created:
+  ``TF_DSV41_BRANCHES_PRIO`` ``main`` (default: main high, side low), ``side`` (side high, the index layers' longer
+  chain first) or ``equal`` (both at the default priority, G13's behaviour). Kernel nodes record their stream's
+  priority at capture. CUDA honours it in a replay only when the graph is instantiated with
+  cudaGraphInstantiateFlagUseNodePriority; otherwise the whole graph runs at the launch stream's priority;
+- **joins on every path**: the driver remembers the stream it forked from. A join on another stream raises, and an
+  exception between a fork and its join still joins (``run``: no open fork leaks into a capture or into eager
+  work);
+- **e4 alone** (``TF_DSV41_BRANCHES=serial``): the folded copies in the serial order (the fused q group, no side
+  stream, no fork). It keeps the ~75 cast / copy launches' saving without any overlap (``plan_serial``).
+
+Knobs: ``TF_DSV41_BRANCHES`` 0 (default) | 1 (side stream) | serial (e4 only), read when the blocks are built;
+``TF_DSV41_BRANCHES_ROWS`` (64: wider windows, i.e. prefill segments, keep the serial path);
+``TF_DSV41_BRANCHES_PRIO`` main (default) | side | equal.
+"""
+
+from __future__ import annotations
+
+import os
+from contextlib import nullcontext
+from dataclasses import dataclass
+
+import torch
+
+ENV = "TF_DSV41_BRANCHES"
+PRIOS = ("main", "side", "equal")
+HIGH = -100                     # torch maps it to the device's greatest priority; 0 is CUDA's lowest (the default)
+
+
+@dataclass(frozen=True)
+class Settings:
+    on: bool = False
+    rows: int = 64
+    serial: bool = False        # TF_DSV41_BRANCHES=serial: e4 alone, no side stream
+    prio: str = "main"          # TF_DSV41_BRANCHES_PRIO
+
+    @property
+    def mode(self) -> str:
+        return "off" if not self.on else "serial" if self.serial else "streams"
+
+
+def settings(env: dict | None = None) -> Settings:
+    env = os.environ if env is None else env
+    raw = str(env.get(ENV, "")).strip().lower()
+    if raw not in ("", "0", "1", "on", "off", "streams", "serial", "e4"):
+        raise ValueError(f"{ENV}={raw!r}: expected 0, 1 or serial")
+    rows_raw = str(env.get(ENV + "_ROWS", "")).strip()
+    rows = int(rows_raw) if rows_raw else 64
+    if not 1 <= rows <= 4096:
+        raise ValueError(f"{ENV}_ROWS={rows}: expected 1..4096")
+    prio = str(env.get(ENV + "_PRIO", "")).strip().lower() or "main"
+    if prio not in PRIOS:
+        raise ValueError(f"{ENV}_PRIO={prio!r}: expected one of {', '.join(PRIOS)}")
+    serial = raw in ("serial", "e4")
+    return Settings(raw in ("1", "on", "streams") or serial, rows, serial, prio)
+
+
+def priorities(prio: str) -> tuple[int, int]:
+    """(main, side) stream priorities requested for ``TF_DSV41_BRANCHES_PRIO`` (lower = higher priority)."""
+
+    if prio not in PRIOS:
+        raise ValueError(prio)
+    return (HIGH if prio == "main" else 0), (HIGH if prio == "side" else 0)
+
+
+# -- the plan (pure Python) ---------------------------------------------------------------------------------------------
+# what each op of the sublayer reads and writes (names of values; in-place RoPE writes a new name)
+READS = {
+    "ix_wp": ("x",), "xproj": ("x",), "rms2": ("qa", "kva"), "compress": ("proj", "carry"),
+    "q": ("qr",), "wq_b": ("qr",), "ix_wq_b": ("qr",), "l2pf_o": (), "rope_q": ("q",), "rope_qi": ("qi",),
+    "select": ("qi_r", "w", "ikeys"), "kv_swa": ("kv",), "attn": ("q_r", "swa", "sel", "comp_rows"),
+}
+WRITES = {
+    "ix_wp": ("w",), "xproj": ("qa", "kva", "proj"), "rms2": ("qr", "kv"), "compress": ("comp_rows", "ikeys"),
+    "q": ("q", "qi"), "wq_b": ("q",), "ix_wq_b": ("qi",), "l2pf_o": (), "rope_q": ("q_r",), "rope_qi": ("qi_r",),
+    "select": ("sel",), "kv_swa": ("swa",), "attn": ("o",),
+}
+# launches that own split-K counters (x3seg groups): each must stay on one stream
+GROUPS = {"xproj": "x", "q": "q", "wq_b": "q.main", "ix_wq_b": "q.index"}
+
+
+def plan(ix: bool, comp: bool, split: bool) -> tuple:
+    """The sublayer's steps: ("fork",), ("join",) or (stream, op), stream "main" / "side". ``ix``: an index layer
+    (full / reindex); ``comp``: its compressor runs (a kv source not yet stored); ``split``: wq_b and the indexer's
+    wq_b as two launches (else the fused q group on main, the indexer forked after it)."""
+
+    if not ix:
+        return (("main", "xproj"), ("main", "rms2"), ("fork",), ("side", "kv_swa"), ("main", "wq_b"),
+                ("main", "l2pf_o"), ("main", "rope_q"), ("join",), ("main", "attn"))
+    head = (("fork",), ("side", "ix_wp"), ("main", "xproj"), ("main", "rms2"), ("fork",))
+    cmp = (("side", "compress"),) if comp else ()
+    if split:
+        return head + cmp + (("side", "ix_wq_b"), ("side", "rope_qi"), ("side", "select"), ("main", "wq_b"),
+                             ("main", "l2pf_o"), ("main", "rope_q"), ("main", "kv_swa"), ("join",), ("main", "attn"))
+    return head + cmp + (("main", "q"), ("main", "l2pf_o"), ("fork",), ("side", "rope_qi"), ("side", "select"),
+                         ("main", "rope_q"), ("main", "kv_swa"), ("join",), ("main", "attn"))
+
+
+def plan_serial(ix: bool, comp: bool, split: bool) -> tuple:
+    """e4 alone (``TF_DSV41_BRANCHES=serial``): ``plan``'s ops on main, in ``blocks.attention``'s serial order (the q
+    projections, the L2 prefetch mark, RoPE q / qi, the head weights, then the SWA store, the compressor, the
+    selection and the core). No fork. ``split``: wq_b and the indexer's wq_b as two launches; the caller passes
+    False where the fused q group exists, so the q launch is the serial path's own."""
+
+    m = lambda *ops: tuple(("main", o) for o in ops)            # noqa: E731
+    if not ix:
+        return m("xproj", "rms2", "wq_b", "l2pf_o", "rope_q", "kv_swa", "attn")
+    q = m("wq_b", "ix_wq_b") if split else m("q")
+    return (m("xproj", "rms2") + q + m("l2pf_o", "rope_q", "rope_qi", "ix_wp", "kv_swa")
+            + (m("compress") if comp else ()) + m("select", "attn"))
+
+
+def initial(ix: bool, comp: bool) -> set:
+    """Values present when the sublayer starts (on both streams: the previous launches are joined)."""
+
+    out = {"x", "carry"}
+    if not ix:
+        out.add("sel")                          # the latest index source's selection (any layer before)
+    if not comp:
+        out |= {"comp_rows", "ikeys"}           # a reindex / reuse layer reads its kv source's stored rows and keys
+    return out
+
+
+def check(steps, init, want=("o",)) -> None:
+    """Raise ValueError unless ``steps`` are a safe fork / join plan: every op reads values its stream already has
+    (a fork gives the side what main has; a join gives main what the side has); side ops only between a fork and
+    the join; nothing written on one stream while the other may still read or write it (between a fork and its
+    join); each counter group on one stream; every op at most once; no open fork at the end; and main holds
+    ``want`` at the end (the sublayer's output: a plan that leaves it on the side, or never makes it, fails)."""
+
+    have = {"main": set(init), "side": set(init)}
+    seen, group_at = set(), {}
+    open_ = False
+    # what each stream read / wrote that the other stream's later ops are NOT ordered after
+    touched = {"main": set(), "side": set()}
+    wrote = {"main": set(), "side": set()}
+    for st in steps:
+        if st == ("fork",):                         # the side's next ops follow everything main issued so far
+            have["side"] |= have["main"]
+            touched["main"], wrote["main"] = set(), set()
+            open_ = True
+            continue
+        if st == ("join",):                         # main's next ops follow everything the side issued
+            if not open_:
+                raise ValueError("join without a fork")
+            have["main"] |= have["side"]
+            touched["side"], wrote["side"] = set(), set()
+            open_ = False
+            continue
+        where, op = st
+        if where not in ("main", "side") or op not in READS:
+            raise ValueError(f"unknown step {st}")
+        if op in seen:
+            raise ValueError(f"{op} twice")
+        seen.add(op)
+        if where == "side" and not open_:
+            raise ValueError(f"{op} on the side stream outside a fork")
+        missing = set(READS[op]) - have[where]
+        if missing:
+            raise ValueError(f"{op} on {where} reads {sorted(missing)} before its stream has them")
+        g = GROUPS.get(op)
+        if g is not None and group_at.setdefault(g, where) != where:
+            raise ValueError(f"counter group {g} on two streams")
+        other = "side" if where == "main" else "main"
+        clash = (set(WRITES[op]) & touched[other]) | (set(READS[op]) & wrote[other])
+        if clash:
+            raise ValueError(f"{op} on {where} races the {other} stream on {sorted(clash)}")
+        touched[where] |= set(READS[op]) | set(WRITES[op])
+        wrote[where] |= set(WRITES[op])
+        have[where] |= set(WRITES[op])
+    if open_:
+        raise ValueError("the plan ends with an open fork")
+    missing = set(want) - have["main"]
+    if missing:
+        raise ValueError(f"the plan ends without {sorted(missing)} on main")
+
+
+def values(steps) -> set:
+    """Every value a plan's ops write (two plans of one sublayer must make the same values: ``plan`` vs
+    ``plan_serial``)."""
+
+    return {v for st in steps if len(st) == 2 for v in WRITES[st[1]]}
+
+
+# -- running a plan ------------------------------------------------------------------------------------------------
+def _dedicated(device, priority: int):
+    """A CUDA stream of its own (``cuStreamCreateWithPriority``, non-blocking, the priority clamped to the device's
+    range) as a torch ``ExternalStream``, or None (no driver library, no current context: the caller takes a pooled
+    stream). ``torch.cuda.Stream()`` hands out one of 32 pooled streams a priority, round robin: another component's
+    ``Stream()`` (L2PF's side, torch's capture stream, a per-block stream) can be the same CUDA stream once 32 more
+    have been taken, and two components' captured chains then share one stream."""
+
+    import ctypes
+
+    try:
+        cu = ctypes.CDLL("libcuda.so.1")
+        dev = torch.device(device)
+        with torch.cuda.device(dev):
+            torch.cuda.current_stream(dev).synchronize()        # the runtime's primary context current here
+            ctx = ctypes.c_void_p()
+            if cu.cuCtxGetCurrent(ctypes.byref(ctx)) != 0 or not ctx.value:
+                return None
+            least, greatest = ctypes.c_int(0), ctypes.c_int(0)
+            if cu.cuCtxGetStreamPriorityRange(ctypes.byref(least), ctypes.byref(greatest)) != 0:
+                return None
+            p = min(max(int(priority), greatest.value), least.value)
+            s = ctypes.c_void_p()
+            # flags 1: CU_STREAM_NON_BLOCKING (as torch's pooled streams)
+            if cu.cuStreamCreateWithPriority(ctypes.byref(s), 1, ctypes.c_int(p)) != 0 or not s.value:
+                return None
+            return torch.cuda.ExternalStream(s.value, device=dev)
+    except (OSError, AttributeError, RuntimeError, TypeError):
+        return None
+
+
+def _same(a, b) -> bool:
+    """Two torch stream objects naming one CUDA stream (``current_stream()`` builds a new wrapper each call)."""
+
+    return getattr(a, "cuda_stream", a) == getattr(b, "cuda_stream", b)
+
+
+class Driver:
+    """A device's two streams, made once at block build (never during a capture), each its own CUDA stream
+    (``_dedicated``; a pooled one if the driver API is not reachable) with explicit priorities
+    (``TF_DSV41_BRANCHES_PRIO``): ``main``, the stream the row graphs capture on (``capture_stream``), and ``side``.
+    ``fork`` / ``join`` are event edges (``wait_stream``; in a capture, graph edges). A join must happen on the
+    stream the fork left; ``abort`` joins an open fork after an exception."""
+
+    def __init__(self, device, prio: str = "main") -> None:
+        pm, ps = priorities(prio)
+        self.prio = prio
+        main, side = _dedicated(device, pm), _dedicated(device, ps)
+        self.dedicated = main is not None and side is not None
+        self.main = main or torch.cuda.Stream(device=device, priority=pm)
+        self.side = side or torch.cuda.Stream(device=device, priority=ps)
+        self.at = None                  # the stream an open fork left (None: no open fork)
+        self.forks = self.joins = 0
+
+    def fork(self) -> None:
+        cur = torch.cuda.current_stream()
+        if self.at is not None and not _same(self.at, cur):
+            raise RuntimeError("branches: a fork on another stream than the open fork's")
+        self.side.wait_stream(cur)
+        self.at = cur
+        self.forks += 1
+
+    def join(self) -> None:
+        cur = torch.cuda.current_stream()
+        if self.at is None:
+            raise RuntimeError("branches: a join without an open fork")
+        if not _same(self.at, cur):
+            raise RuntimeError("branches: a join on another stream than the fork's")
+        cur.wait_stream(self.side)
+        self.at = None
+        self.joins += 1
+
+    def abort(self) -> None:
+        """After an exception inside a plan: join the open fork if there is one (best effort: a failed capture may
+        refuse the edge; the capture is void then anyway)."""
+
+        if self.at is None:
+            return
+        at, self.at = self.at, None
+        try:
+            at.wait_stream(self.side)
+        except Exception:               # noqa: BLE001 - the original exception is the one that matters
+            pass
+
+    def on(self, where: str):
+        return torch.cuda.stream(self.side) if where == "side" else nullcontext()
+
+    def describe(self) -> str:
+        return (f"streams ({'dedicated' if self.dedicated else 'pooled'}), priority {self.prio} (main "
+                f"{self.main.priority}, side {self.side.priority}); {self.forks} forks / {self.joins} joins issued")
+
+
+class Serial:
+    """``TF_DSV41_BRANCHES=serial``: every op on the current stream; a fork, a join or a side op is a bug."""
+
+    prio = "serial"
+
+    def fork(self) -> None:
+        raise RuntimeError("branches: a fork in a serial plan")
+
+    join = fork
+
+    def on(self, where: str):
+        if where != "main":
+            raise RuntimeError("branches: a side op in a serial plan")
+        return nullcontext()
+
+    def describe(self) -> str:
+        return "serial (e4: the folded copies, no side stream)"
+
+
+SERIAL = Serial()
+
+
+def run(steps, impl: dict, drv) -> None:
+    """Issue ``steps``. An exception between a fork and its join joins first (``drv.abort``), so no path leaves a
+    fork open."""
+
+    try:
+        for st in steps:
+            if st == ("fork",):
+                drv.fork()
+            elif st == ("join",):
+                drv.join()
+            else:
+                with drv.on(st[0]):
+                    impl[st[1]]()
+    except BaseException:
+        abort = getattr(drv, "abort", None)
+        if abort is not None:
+            abort()
+        raise
+
+
+_DRIVERS: dict = {}
+_SAID: set = set()
+
+
+@dataclass
+class Branch:
+    """A block's branch state: the device's driver (``Driver``, or ``SERIAL``) and, on index layers with the fused q
+    group and side streams, its two matrices as 1-segment x3seg launches (each with its own counters)."""
+
+    drv: object
+    rows: int
+    wq_b: object = None
+    ix_wq_b: object = None
+
+    @property
+    def serial(self) -> bool:
+        return self.drv is SERIAL
+
+
+def driver(device, prio: str = "main") -> Driver:
+    """The device's driver for ``prio``, made on first use (at block build, before any capture)."""
+
+    if torch.cuda.is_current_stream_capturing():
+        raise RuntimeError("branches: the side stream must exist before any capture")
+    dev = torch.device(device)
+    key = (dev.index if dev.index is not None else torch.cuda.current_device(), prio)
+    drv = _DRIVERS.get(key)
+    if drv is None:
+        drv = _DRIVERS[key] = Driver(torch.device("cuda", key[0]), prio)
+    return drv
+
+
+def build(blk, device) -> Branch | None:
+    """At block build: a ``Branch`` when ``TF_DSV41_BRANCHES`` is on and the block runs on CUDA, else None."""
+
+    s = settings()
+    dev = torch.device(device)
+    if not s.on or dev.type != "cuda" or not torch.cuda.is_available():
+        return None
+    if s.serial:
+        b = Branch(SERIAL, s.rows)
+    else:
+        b = Branch(driver(dev, s.prio), s.rows)
+        g = getattr(blk, "fused", None)
+        if g is not None and g.q is not None and g.q.dense() is None:
+            from . import fused_proj as FP
+
+            b.wq_b, b.ix_wq_b = FP.Fused([g.q.lins[0]]), FP.Fused([g.q.lins[1]])
+    said = (s.mode, s.prio, s.rows)
+    if said not in _SAID:
+        _SAID.add(said)
+        print(f"[dsv41] branches: {b.drv.describe()}; windows <= {s.rows} rows", flush=True)
+    return b
+
+
+def capture_stream(fw):
+    """The stream ``fw``'s row graphs capture on: its blocks' driver's ``main`` (side streams on), else None
+    (torch's own capture stream; nothing forks)."""
+
+    for blk in getattr(fw, "blocks", ()) or ():
+        b = getattr(blk, "branch", None)
+        if b is not None and isinstance(b.drv, Driver):
+            return b.drv.main
+    return None
+
+
+def active(blk, x: torch.Tensor, ctxs):
+    """The block's ``Branch`` when this call branches: built, a CUDA decode window (not a fast prefill run, at most
+    ``TF_DSV41_BRANCHES_ROWS`` rows, no staging ring), else None."""
+
+    b = getattr(blk, "branch", None)
+    if b is None or not x.is_cuda or x.shape[0] > b.rows or any(c.stage is not None for c in ctxs):
+        return None
+    from . import prefill_mm as PM
+
+    return None if PM.active() else b
+
+
+# -- the branched sublayer ------------------------------------------------------------------------------------------
+def ix_weights(A, x: torch.Tensor) -> torch.Tensor:
+    """The indexer's head weights bf16 [n, 32]: ``_plain`` rounding as it stores (the values of
+    ``A.ix_wp(x, bf16).to(fp32)``)."""
+
+    from . import numerics as N
+    from . import plain_fp64 as PF
+
+    if N.ACT == torch.bfloat16 and N.ACC == torch.float32 and PF.eligible(x, A.ix_wp.w):
+        return PF.matmul_t(x, A.ix_wp.w, torch.bfloat16)
+    return A.ix_wp(x, N.ACT)
+
+
+def proj_rows(blk, x: torch.Tensor) -> torch.Tensor:
+    """A kv source's compressor projection in ACT ([n, D], ratio 2 [kv | score] [n, 2 D]): the values of
+    ``blocks._projection`` without its fp32 casts."""
+
+    from . import numerics as N
+
+    A = blk.attn
+    p = A.comp_wkv(x, N.ACT)
+    return torch.cat([p, A.comp_wgate(x, N.ACT)], 1) if blk.ratio == 2 else p
+
+
+def compress(blk, ctx, table, proj: torch.Tensor) -> None:
+    """``blocks._compress`` on ACT projection rows: the carry through its own pointer where the backend has it."""
+
+    from . import numerics as N
+
+    cfg, A, win, cs, slot, L, r = blk.cfg, blk.attn, ctx.win, ctx.csa2, ctx.slot, blk.index, blk.ratio
+    if r == 2:
+        ctx.proj[L] = proj
+    if hasattr(cs, "pool_norm_split"):
+        lat = cs.pool_norm_split(slot.carry[L] if r == 2 else None, proj, A.comp_norm, win, r, cfg.rms_norm_eps)
+    else:                                           # the CPU twin: the concatenated fp32 buffer
+        p = proj.to(N.ACC)
+        if r == 2:
+            c = slot.carry[L]
+            p = torch.cat([c if win.rows else c.view(1, -1), p], 0)
+        lat = cs.pool_norm(p.contiguous(), A.comp_norm, win, r, cfg.rms_norm_eps)
+    cs.kv_store(lat, table, slot.comp[L], win, r)
+    cs.index_k(A.ix_wk(lat, N.ACT), A.ix_knorm, table, slot.ikeys[L], win, r, cfg.rms_norm_eps)
+
+
+def attention(blk, x: torch.Tensor, ctxs: list, out_dtype, br: Branch, trace: list | None = None) -> torch.Tensor:
+    """``blocks.attention``'s result through ``plan``'s two streams (``trace``: the executed steps, for tests)."""
+
+    from . import blocks as B
+    from . import fused_proj as FP
+    from . import l2pf
+    from . import numerics as N
+    from .rope import inplace as rope_inplace
+
+    cfg, A = blk.cfg, blk.attn
+    eps, n, act, acc = cfg.rms_norm_eps, x.shape[0], N.ACT, N.ACC
+    table = ctxs[0].tables[1 if blk.ratio > 0 else 0]
+    positions = torch.cat([c.win.positions for c in ctxs]) if len(ctxs) > 1 else ctxs[0].win.positions
+    fz = FP.active(blk)
+    comp = blk.mode == "full" and not ctxs[0].comp_done
+    ix = blk.mode in ("full", "reindex")
+    serial = getattr(br, "serial", False)
+    # serial: the fused q group where it exists (the serial path's one launch); streams: its two 1-segment launches
+    split = ix and (fz is None or fz.q is None or (not serial and br.wq_b is not None))
+    inplace = rope_inplace()
+    v: dict = {}
+
+    def xproj():
+        if fz is not None and (fz.x4 is not None or not comp):
+            ys = (fz.x4 if comp else fz.x2)(x, act)
+            v["qa"], v["kva"], v["proj"] = ys[0], ys[1], (ys[2] if comp else None)
+        else:
+            v["qa"], v["kva"] = A.wq_a(x, act), A.wkv(x, act)
+            v["proj"] = proj_rows(blk, x) if comp else None
+
+    def rms2():
+        v["qr"], v["kv"] = B.rms2(v["qa"], A.q_norm, v["kva"], A.kv_norm, eps)
+
+    def q():
+        v["q"], v["qi"] = fz.qproj(v["qr"])
+
+    def wq_b():
+        v["q"] = br.wq_b(v["qr"], act)[0] if br.wq_b is not None else A.wq_b(v["qr"], act)
+
+    def ix_wq_b():
+        v["qi"] = br.ix_wq_b(v["qr"], act)[0] if br.ix_wq_b is not None else A.ix_wq_b(v["qr"], act)
+
+    def rope_q():
+        qq = v["q"].view(n, -1, cfg.head_dim)
+        v["q"] = table.apply_(qq, positions, dtype=act) if inplace else table.apply(qq.to(acc), positions, dtype=act)
+
+    def rope_qi():
+        qi = v["qi"].view(n, cfg.index_n_heads, cfg.index_head_dim)
+        v["qi"] = table.apply_(qi, positions, dtype=act) if inplace else table.apply(qi, positions, dtype=act)
+
+    def ix_wp():
+        v["w"] = ix_weights(A, x)
+
+    def compress_():
+        for c in ctxs:
+            compress(blk, c, table, v["proj"][c.a:c.b])
+
+    def select():
+        for c in ctxs:
+            B._select(blk, c, v["qi"][c.a:c.b], v["w"][c.a:c.b])
+
+    def kv_swa():
+        for c in ctxs:
+            c.csa2.kv_store(v["kv"][c.a:c.b], table, c.slot.swa[blk.index], c.win, 0, c.ring)
+
+    def attn():
+        if len(ctxs) == 1:
+            c = ctxs[0]
+            v["o"] = B._attend(blk, c, table, v["q"], c.slot.swa[blk.index], c.ring)
+            return
+        o = torch.empty((n, v["q"].shape[1], cfg.head_dim), dtype=act, device=x.device)
+        for c in ctxs:
+            o[c.a:c.b] = B._attend(blk, c, table, v["q"][c.a:c.b], c.slot.swa[blk.index], c.ring)
+        v["o"] = o
+
+    impl = {"xproj": xproj, "rms2": rms2, "q": q, "wq_b": wq_b, "ix_wq_b": ix_wq_b, "rope_q": rope_q,
+            "rope_qi": rope_qi, "ix_wp": ix_wp, "compress": compress_, "select": select, "kv_swa": kv_swa,
+            "attn": attn, "l2pf_o": lambda: l2pf.mark(blk, "o", n)}
+    steps = (plan_serial if serial else plan)(ix, comp, split)
+    if trace is not None:
+        trace.append(steps)
+        impl = {k: (lambda f=f, k=k: (trace.append(k), f())) for k, f in impl.items()}
+    run(steps, impl, br.drv)
+    return B._out(blk, fz, v["o"], n, out_dtype)
+
+
+__all__ = ["ENV", "PRIOS", "SERIAL", "Branch", "Driver", "Serial", "Settings", "active", "attention", "build",
+           "capture_stream", "check", "compress", "driver", "initial", "ix_weights", "plan", "plan_serial",
+           "priorities", "proj_rows", "run", "settings", "values"]
