+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The round's host tail off the GPU's critical path (CPU): ``vsample`` (device merge / choice / acceptance),
+``SlotsForward.candidates`` on the device sort, ``spec`` (the speculative DSpark pass) and ``planlink`` (the plan
+over TCP).
+
+- ``vsample.uniform`` == ``exact_sampling.uniform_rows`` bit for bit; ``choose`` == ``choose_rows`` (greedy, top-k,
+  top-p, min-p, top-k 0) and ``accept`` == ``protocol.accepted``;
+- ``merge`` == the old host merge (``np.lexsort((ids, -values))`` over the gathered halves): ties, -0.0 / +0.0, -inf;
+- speculation on: drafted == serial (1 slot, 2 slots, T = 0 and T > 0), the passes are used (hits), and every
+  round's drafts equal those of the same run without speculation (the whole-window ingest keeps the rings' kept rows
+  bit for bit); a whole-window ingest's kept rows == a kept-rows ingest; ``stage_device`` == ``DraftInputs.stage``;
+- two ranks (threads) with speculation: the same drafts and the same speculation decisions, replies == one rank's;
+- ``TcpLink``: plans (a 100,000-token admission too) arrive whole and in order; a closed link raises.
+"""
+
+from __future__ import annotations
+
+import socket
+import threading
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_dspark_fakes as DF
+import dsv41_fakes as FK
+
+from tensorfold.engine.exact_sampling import Sampling, choose_rows, uniform_rows
+from tensorfold.families.deepseek_v41.cuda import planlink as PL
+from tensorfold.families.deepseek_v41.cuda import spec as SP
+from tensorfold.families.deepseek_v41.cuda import vsample as VS
+from tensorfold.families.deepseek_v41.cuda.batch import Job
+from tensorfold.families.deepseek_v41.cuda.plan import Admit, Plan, WindowSpec
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece, accepted
+
+SAMPLINGS = [None, Sampling(seed=7, temperature=0.8, top_k=20, top_p=0.95),
+             Sampling(seed=(1 << 64) - 5, temperature=1.1, top_k=0, top_p=0.9, min_p=0.02),
+             Sampling(seed=3, temperature=0.6, top_k=4, top_p=1.0, min_p=0.1)]
+SHORT = [[int(t) for t in np.random.default_rng(s).integers(3, 250, size=n)] for s, n in ((1, 45), (2, 70))]
+N = 24
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41host"))
+
+
+def _bf16_rows(rng, R, C, ties=True):
+    v = torch.from_numpy(rng.normal(0, 3, (R, C)).astype(np.float32)).to(torch.bfloat16).float()
+    if ties:
+        v[:, 1] = v[:, 0]
+        v[:, 3] = 0.0
+        v[:, 4] = -0.0
+    return v
+
+
+# -- vsample ---------------------------------------------------------------------------------------------------------
+def test_uniform_bits():
+    rng = np.random.default_rng(0)
+    for seed in (0, 7, (1 << 63) - 1, (1 << 64) - 5, 123456789012345):
+        pos = rng.integers(0, 1 << 20, 6)
+        ids = rng.integers(0, 129280, (6, 40))
+        want = uniform_rows(seed, pos, ids)
+        got = VS.uniform(torch.full((6,), VS.s64(seed), dtype=torch.int64), torch.from_numpy(pos),
+                         torch.from_numpy(ids)).numpy()
+        assert np.array_equal(want, got)
+
+
+def _sorted(v, ids):
+    order = np.lexsort((ids, -v), axis=-1)
+    return np.take_along_axis(v, order, 1), np.take_along_axis(ids, order, 1)
+
+
+@pytest.mark.parametrize("si", range(len(SAMPLINGS)))
+def test_choose_is_choose_rows(si):
+    s = SAMPLINGS[si]
+    rng = np.random.default_rng(si)
+    R, C = 64, 28
+    v = _bf16_rows(rng, R, C).numpy()
+    ids = np.stack([rng.permutation(129280)[:C] for _ in range(R)]).astype(np.int64)
+    v, ids = _sorted(v, ids)
+    pos = list(range(1000, 1000 + R))
+    want = [int(ids[r, 0]) for r in range(R)] if s is None else choose_rows(v, ids, pos, s)
+    i64, f64 = VS.row_tables([(999, list(range(R)))], [s])
+    got = VS.run(torch.from_numpy(v), torch.from_numpy(ids), torch.tensor(i64), torch.tensor(f64, dtype=torch.float64),
+                 R, 1)[0]
+    assert got.tolist() == want
+
+
+def test_accept_is_accepted():
+    rng = np.random.default_rng(3)
+    wins, chosen, ref = [], [], []
+    for w in range(5):
+        n = int(rng.integers(1, 7))
+        toks = [int(t) for t in rng.integers(0, 5, n)]
+        ch = [int(t) for t in rng.integers(0, 5, n)]
+        wins.append((100 * w, toks))
+        chosen += ch
+        a = accepted(toks, ch)
+        ref.append((a, ch[a], 100 * w + a + 1))
+    i64, _ = VS.row_tables(wins, [None] * len(wins))
+    R, Wn = len(chosen), len(wins)
+    t = torch.tensor(i64)
+    acc, bonus, nstart = VS.accept(torch.tensor(chosen), t[:R], t[R:2 * R], t[2 * R:3 * R], t[7 * R:7 * R + Wn],
+                                   t[7 * R + Wn:])
+    assert list(zip(acc.tolist(), bonus.tolist(), nstart.tolist())) == ref
+
+
+def _old_merge(g, k, count):
+    W = g.shape[0]
+    values = torch.cat([g[r, :, :k] for r in range(W)], 1).numpy().astype(np.float32)
+    tokens = torch.cat([g[r, :, k:].contiguous().view(torch.int32) for r in range(W)], 1).numpy().astype(np.int64)
+    order = np.lexsort((tokens, -values), axis=-1)[:, :count]
+    return np.take_along_axis(tokens, order, 1), np.take_along_axis(values, order, 1)
+
+
+@pytest.mark.parametrize("W,k,count", [(1, 9, 9), (2, 9, 9), (2, 28, 30), (2, 64, 128)])
+def test_merge_is_lexsort(W, k, count):
+    rng = np.random.default_rng(k)
+    R = 7
+    parts = []
+    for r in range(W):
+        v = _bf16_rows(rng, R, k)
+        v[2, :] = v[2, 0]                       # a row of ties across both halves
+        v[5, -3:] = float("-inf")
+        ids = torch.from_numpy(np.stack([rng.permutation(64640)[:k] for _ in range(R)]).astype(np.int32) + 64640 * r)
+        parts.append(torch.cat([v, ids.view(torch.float32)], 1))
+    g = torch.stack(parts)
+    vals, ids = VS.merge(g, k, count)
+    want_ids, want_vals = _old_merge(g, k, count)
+    assert np.array_equal(ids.numpy(), want_ids)
+    assert np.array_equal(vals.numpy().view(np.int32), want_vals.view(np.int32))       # -0.0 stays -0.0
+
+
+def test_candidates_sorted_and_greedy(ck):
+    fw = DF.forward(ck)
+    DF.batcher(ck, fw).ex.slots[0].ensure(100)
+    p = SHORT[0]
+    fw.reset(0)
+    fw.prefill([Piece(0, 0, tuple(p[:-1]))], mode="full")
+    from tensorfold.families.deepseek_v41.cuda.protocol import Rows
+
+    c = fw.window([Rows(0, len(p) - 1, (p[-1], 5, 6))], count=12)
+    assert c.ids.shape == (3, 12) and c.ids.dtype == np.int64 and c.values.dtype == np.float32
+    for r in range(c.ids.shape[0]):
+        o = np.lexsort((c.ids[r], -c.values[r]))
+        assert np.array_equal(o, np.arange(c.ids.shape[1]))
+
+
+# -- spec ------------------------------------------------------------------------------------------------------------
+def _serial(ck, prompts, samplings, n=N):
+    b = DF.batcher(ck, DF.forward(ck, slots=len(prompts), dspark=False), n=len(prompts), depth=0)
+    return DF.run(b, [Job(list(p), n, s) for p, s in zip(prompts, samplings)])
+
+
+def _drafted(ck, prompts, samplings, spec: bool, monkeypatch, n=N):
+    monkeypatch.setenv(SP.ENV, "1" if spec else "0")
+    fw = DF.forward(ck, slots=len(prompts))
+    assert (fw.spec is not None) == spec
+    seen = []
+    real = fw.draft
+
+    def rec(*a, **k):
+        out = real(*a, **k)
+        seen.append(out)
+        return out
+
+    fw.draft = rec
+    b = DF.batcher(ck, fw, n=len(prompts))
+    got = DF.run(b, [Job(list(p), n, s) for p, s in zip(prompts, samplings)])
+    return got, seen, fw
+
+
+@pytest.mark.parametrize("case", ["greedy", "sampled", "two", "nucleus"])
+def test_spec_drafted_equals_serial(ck, monkeypatch, case):
+    prompts, samp = {"greedy": ([SHORT[0]], [None]), "sampled": ([SHORT[1]], [SAMPLINGS[1]]),
+                     "two": (SHORT, [None, SAMPLINGS[3]]), "nucleus": (SHORT, [None, SAMPLINGS[2]])}[case]
+    want = _serial(ck, prompts, samp)
+    got, seen, fw = _drafted(ck, prompts, samp, True, monkeypatch)
+    assert got == want
+    st = fw.spec.stats
+    if case == "nucleus":               # a top-p window (more exchanges after the candidates): no speculation
+        assert st["launched"] == 0
+    else:
+        assert st["launched"] > 0 and st["hit"] > 0, fw.spec.describe()
+    off, seen_off, _ = _drafted(ck, prompts, samp, False, monkeypatch)
+    assert off == want and seen == seen_off          # the speculated drafts are the passes the rounds ran
+
+
+def test_spec_nucleus_drafted_equals_serial(ck, monkeypatch):
+    """G17 TF_DSV41_SPEC_NUCLEUS: top-p windows speculate too (the stats exchange first, the device choice with the
+    full-vocabulary normalizer): drafted == serial, passes launched and used, the same drafts as without
+    speculation, and the host's tokens are unchanged (replies == the speculation-off run)."""
+
+    monkeypatch.setenv(SP.NUCLEUS_ENV, "1")
+    for prompts, samp in ((SHORT, [None, SAMPLINGS[2]]), ([SHORT[1]], [SAMPLINGS[2]])):
+        want = _serial(ck, prompts, samp)
+        got, seen, fw = _drafted(ck, prompts, samp, True, monkeypatch)
+        assert got == want
+        st = fw.spec.stats
+        assert st["launched"] > 0 and st["hit"] > 0, fw.spec.describe()
+        off, seen_off, _ = _drafted(ck, prompts, samp, False, monkeypatch)
+        assert off == want and seen == seen_off
+
+
+@pytest.mark.parametrize("seed", range(4))
+def test_choose_with_normalizer_is_nucleus_choose(seed):
+    """``vsample.choose`` with ``zs`` (a top-p row's full-vocabulary Z) == ``nucleus.choose`` over its keep count,
+    the host rule a nucleus row is sampled by (rows the candidates cannot decide are the host's full fallback)."""
+
+    from tensorfold.families.deepseek_v41.cuda import nucleus as NU
+
+    rng = np.random.default_rng(100 + seed)
+    s = SAMPLINGS[2]                            # T 1.1, top_k 0, top_p 0.9, min_p 0.02
+    R, C, V = 48, 256, 4096
+    full = torch.from_numpy(rng.normal(0, 5.0 + 2 * seed, (R, V)).astype(np.float32)).to(torch.bfloat16).float()
+    ids_all = np.stack([rng.permutation(129280)[:V] for _ in range(R)]).astype(np.int64)
+    v, ids = _sorted(full.numpy(), ids_all)
+    v, ids = v[:, :C].copy(), ids[:, :C].copy()
+    st = NU.row_stats(full, torch.full((R,), float(s.temperature), dtype=torch.float64))
+    z = NU.device_z(st.view(R, 1, 2), torch.full((R,), float(s.temperature), dtype=torch.float64))
+    pos = list(range(500, 500 + R))
+    i64, f64 = VS.row_tables([(499, list(range(R)))], [s])
+    got = VS.run(torch.from_numpy(v), torch.from_numpy(ids), torch.tensor(i64), torch.tensor(f64, dtype=torch.float64),
+                 R, 1, z)[0].tolist()
+    decided = 0
+    for r in range(R):
+        zm, zz = NU.normalizer(st[r:r + 1].numpy(), s.temperature)
+        k = NU.keep_count(v[r], ids[r], [s.temperature, s.top_p, s.min_p], zm, zz)
+        if k is None:
+            continue
+        decided += 1
+        want = NU.choose(v[r:r + 1], ids[r:r + 1], [pos[r]], s, {0: ("keep", k)})[0]
+        assert got[r] == want, r
+    assert decided >= R // 4
+
+
+def test_whole_window_ingest_keeps_rows(ck):
+    from tensorfold.families.deepseek_v41.cuda.protocol import Rows
+
+    p = SHORT[0]
+    fws = [DF.forward(ck), DF.forward(ck)]
+    for f in fws:
+        DF.batcher(ck, f).ex.slots[0].ensure(200)
+        f.reset(0)
+        f.prefill([Piece(0, 0, tuple(p[:-1]))], mode="full")
+        f.window([Rows(0, len(p) - 1, (p[-1], 11, 12, 13))], count=1)
+    P = len(p) - 1
+    a, z = fws
+    a.drafter.ingest(0, P, a.slots[0].pending.taps)         # every row first (``spec``), then the commit's rows
+    a.commit(0, 1)
+    z.commit(0, 1)
+    rows = torch.arange(max(0, P + 2 - 128), P + 2) % a.drafter.ring
+    for ra, rz in zip(a.drafter.rings[0], z.drafter.rings[0]):
+        x, y = ra.raw(rows), rz.raw(rows)
+        assert all(np.array_equal(x[k], y[k]) for k in x)
+
+
+def test_stage_device_is_stage(ck):
+    fw = DF.forward(ck, slots=3)
+    dr = fw.drafter
+    for s in range(3):
+        dr._slot(s)
+    key = ((0, 2), dr.rows, dr.head.variant((0, 2)))
+    a, b = dr.inputs(key), DraftInputsCopy(dr, key)
+    P, A, valid = [300, 7], [41, 42], [250, 0]
+    samp = [SAMPLINGS[1], None]
+    b.stage(A, P, valid, samp, dr.noise, dr.ring)
+    a.stage([0, 0], [p - 3 for p in P], valid, samp, dr.noise, dr.ring)
+    SP.stage_device(a, torch.tensor(P), torch.tensor(A), torch.tensor(valid), dr.ring)
+    assert torch.equal(a.d64, b.d64) and torch.equal(a.d32, b.d32)
+
+
+def DraftInputsCopy(dr, key):
+    from tensorfold.families.deepseek_v41.cuda.draft_graphs import DraftInputs
+
+    return DraftInputs(dr, key)
+
+
+@pytest.mark.parametrize("nucleus", [False, True])
+def test_spec_two_ranks(ck, monkeypatch, nucleus):
+    """Two ranks with speculation (``nucleus``: G17 TF_DSV41_SPEC_NUCLEUS with a top-p stream: the stats exchange
+    moves before the pass on both ranks alike)."""
+
+    import queue
+
+    monkeypatch.setenv(SP.ENV, "1")
+    if nucleus:
+        monkeypatch.setenv(SP.NUCLEUS_ENV, "1")
+
+    class PairLink:
+        def __init__(self):
+            self.q = queue.Queue()
+
+        def send(self, plan):
+            self.q.put(list(plan))
+
+        def recv(self):
+            return self.q.get(timeout=120)
+
+    pair = FK.ThreadPair()
+    comms = pair.comms()
+    fws = pair.run([lambda r=r: DF.forward(ck, slots=2, rank=r, world=2, comm=comms[r]) for r in range(2)])
+    seen = [[], []]
+    for r, f in enumerate(fws):
+        real = f.draft
+
+        def rec(*a, real=real, r=r, **k):
+            out = real(*a, **k)
+            seen[r].append(out)
+            return out
+
+        f.draft = rec
+    link = PairLink()
+    b0 = DF.batcher(ck, fws[0], n=2, link=link, rank=0)
+    b1 = DF.batcher(ck, fws[1], n=2, link=link, rank=1)
+    t = threading.Thread(target=b1.follow, daemon=True)
+    t.start()
+    jobs = [Job(list(SHORT[0]), 12, None), Job(list(SHORT[1]), 12, SAMPLINGS[2 if nucleus else 1])]
+    got = DF.run(b0, jobs)
+    b0.send_stop()
+    t.join(timeout=120)
+    assert not t.is_alive()
+    assert seen[0] == seen[1] and len(seen[0]) > 0
+    assert fws[0].spec.stats == fws[1].spec.stats and fws[0].spec.stats["hit"] > 0
+    assert all(len(g) == 12 for g in got)
+
+
+# -- planlink --------------------------------------------------------------------------------------------------------
+def _free_port() -> int:
+    s = socket.socket()
+    s.bind(("127.0.0.1", 0))
+    port = s.getsockname()[1]
+    s.close()
+    return port
+
+
+def test_tcp_link_round_trip():
+    port = _free_port()
+    links: list = [None, None]
+
+    def side(r):
+        links[r] = PL.TcpLink(r, "127.0.0.1", port, timeout_s=30)
+
+    ts = [threading.Thread(target=side, args=(r,)) for r in (0, 1)]
+    for t in ts:
+        t.start()
+    for t in ts:
+        t.join(timeout=60)
+    l0, l1 = links
+    big = Plan(round=3, admits=[Admit(1, list(range(100000)), 64)],
+               windows=[WindowSpec(0, 77, 5, 3, [], [7, 0.8, 20, 0.95, 0.0])])
+    plans = [Plan(round=1, commits=[(0, 2, 99)]), big, Plan(stop=True)]
+    for p in plans:
+        l0.send(p.encode())
+    got = [Plan.decode(l1.recv()) for _ in plans]
+    assert [g.encode() for g in got] == [p.encode() for p in plans]
+    assert l0.sent == 3 and l1.received == 3
+    l0.close()
+    with pytest.raises(ConnectionError):
+        l1.recv()
+    l1.close()
+
+
+def test_plan_link_mode(monkeypatch):
+    monkeypatch.delenv(PL.ENV, raising=False)
+    sentinel = object()
+    assert PL.make(sentinel, 0, "127.0.0.1", 29561) is sentinel and PL.port_for(29561) == 29568
+    monkeypatch.setenv(PL.ENV, "udp")
+    with pytest.raises(ValueError):
+        PL.mode()
