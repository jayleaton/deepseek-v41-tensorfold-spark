index 0000000..6720fed
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/l2probe.py
@@ -0,0 +1,186 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G10's L2 probe (one GPU, ~1 min): how much a weight read gains from being in L2 on this GPU, and whether the L2
+persistence controls work here. It decides between ``TF_DSV41_L2PF`` (a prefetch kernel on a side stream) and an
+access-policy window (``cudaStreamAttributeAccessPolicyWindow`` / ``cudaLimitPersistingL2CacheSize``).
+
+For a weight-sized buffer W (``--mb``, default 6 and 12: the x group and the half-L2 cap), read by a plain fp32 sum:
+
+- ``cold``      after a 96 MB stream evicted W (the in-window case for a dense group);
+- ``hot``       right after reading W (the L2-hot ceiling a perfect prefetch could reach);
+- ``l2pf``      cold, then ``l2pf``'s bulk prefetch kernel over W on a side stream, a ``--gap`` us spin on the main
+                stream (the glue window), then the read: what the prefetch site buys;
+- ``persist``   cold with W inside the stream's access-policy window (hitRatio 1, persisting) set before the flush:
+                whether persistence keeps W through the 96 MB stream. Skipped (with the reason) when the device
+                reports no persisting L2 (``cudaDevAttrMaxPersistingL2CacheSize`` 0) or the runtime call fails.
+
+    python -m tensorfold.families.deepseek_v41.cuda.l2probe [--mb 6,12] [--gap 40] [--json OUT]
+"""
+
+from __future__ import annotations
+
+import argparse
+import ctypes
+import glob
+import json
+import os
+
+import torch
+
+ATTR_L2 = 38                    # cudaDevAttrL2CacheSize
+ATTR_PERSIST_MAX = 108          # cudaDevAttrMaxPersistingL2CacheSize
+ATTR_WINDOW_MAX = 109           # cudaDevAttrMaxAccessPolicyWindowSize
+LIMIT_PERSIST = 0x06            # cudaLimitPersistingL2CacheSize
+STREAM_ATTR_WINDOW = 1          # cudaStreamAttributeAccessPolicyWindow (= cudaLaunchAttributeAccessPolicyWindow)
+PROP_NORMAL, PROP_STREAMING, PROP_PERSISTING = 0, 1, 2
+
+
+class _Window(ctypes.Structure):
+    _fields_ = [("base_ptr", ctypes.c_void_p), ("num_bytes", ctypes.c_size_t), ("hitRatio", ctypes.c_float),
+                ("hitProp", ctypes.c_int), ("missProp", ctypes.c_int)]
+
+
+class _Value(ctypes.Union):    # cudaLaunchAttributeValue: 64 bytes, the window first
+    _fields_ = [("window", _Window), ("pad", ctypes.c_char * 64)]
+
+
+def _cudart():
+    names = ["libcudart.so", "libcudart.so.13", "libcudart.so.12"]
+    for d in [os.path.dirname(torch.__file__) + "/lib", *glob.glob(os.path.dirname(torch.__file__) +
+                                                                    "/../nvidia/cu*/lib"),
+              *glob.glob(os.path.dirname(torch.__file__) + "/../nvidia/cuda_runtime/lib"), "/usr/local/cuda/lib64"]:
+        for n in names:
+            p = os.path.join(d, n)
+            if os.path.exists(p):
+                return ctypes.CDLL(p)
+    for n in names:
+        try:
+            return ctypes.CDLL(n)
+        except OSError:
+            continue
+    raise OSError("libcudart not found")
+
+
+def attrs(rt, dev: int) -> dict:
+    out = {}
+    for name, a in (("l2", ATTR_L2), ("persist_max", ATTR_PERSIST_MAX), ("window_max", ATTR_WINDOW_MAX)):
+        v = ctypes.c_int(0)
+        rc = rt.cudaDeviceGetAttribute(ctypes.byref(v), a, dev)
+        out[name] = int(v.value) if rc == 0 else f"error {rc}"
+    return out
+
+
+def _spin(us: float) -> None:
+    torch.cuda._sleep(int(us * 2000))             # ~2,000 cycles a us (GB10 ~2.4 GHz): a rough wait on the main stream
+
+
+def _time(fn, reps: int) -> float:
+    ts = []
+    for _ in range(reps):
+        a, b = torch.cuda.Event(True), torch.cuda.Event(True)
+        fn(a, b)
+        torch.cuda.synchronize()
+        ts.append(a.elapsed_time(b) * 1e3)
+    ts.sort()
+    return ts[len(ts) // 2]
+
+
+def probe(mb_list=(6.0, 12.0), gap_us: float = 40.0, reps: int = 21) -> dict:
+    dev = torch.cuda.current_device()
+    res: dict = {"device": torch.cuda.get_device_name(dev), "rows": []}
+    try:
+        rt = _cudart()
+        res["attrs"] = attrs(rt, dev)
+    except OSError as e:
+        rt, res["attrs"] = None, {"error": str(e)}
+    flush = torch.empty(96 * 2**20 // 4, dtype=torch.float32, device="cuda")
+    from . import l2pf as L2
+
+    ext = L2._ext()
+    side = torch.cuda.Stream()
+    for mb in mb_list:
+        w = torch.randn(int(mb * 2**20) // 4, device="cuda")
+        table = torch.tensor([[w.data_ptr(), w.numel() * 4 // 16 * 16]], dtype=torch.int64, device="cuda")
+        row = {"mb": mb}
+
+        def cold(a, b, w=w):
+            flush.sum()
+            a.record()
+            w.sum()
+            b.record()
+
+        def hot(a, b, w=w):
+            w.sum()
+            a.record()
+            w.sum()
+            b.record()
+
+        def pf(a, b, w=w, table=table):
+            flush.sum()
+            side.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(side):
+                ext.segments(table, 48, 128, 32 * 1024, True)
+            _spin(gap_us)
+            a.record()
+            w.sum()
+            b.record()
+            torch.cuda.current_stream().wait_stream(side)
+
+        for k, fn in (("cold", cold), ("hot", hot), ("l2pf", pf)):
+            us = _time(fn, reps)
+            row[k + "_us"] = round(us, 1)
+            row[k + "_gbps"] = round(mb * 2**20 / us / 1e3, 1)
+        row["persist"] = _persist(rt, res.get("attrs", {}), w, flush, reps) if rt is not None else "no cudart"
+        res["rows"].append(row)
+    return res
+
+
+def _persist(rt, at: dict, w, flush, reps: int):
+    """W in a persisting access-policy window of the current stream, then the cold read; the window reset after."""
+
+    if not isinstance(at.get("persist_max"), int) or at["persist_max"] <= 0:
+        return f"no persisting L2 (max {at.get('persist_max')})"
+    nbytes = min(w.numel() * 4, int(at.get("window_max") or 0) or w.numel() * 4)
+    if rt.cudaDeviceSetLimit(LIMIT_PERSIST, ctypes.c_size_t(min(nbytes, at["persist_max"]))) != 0:
+        return "cudaDeviceSetLimit(persisting) failed"
+    stream = ctypes.c_void_p(torch.cuda.current_stream().cuda_stream)
+    v = _Value()
+    v.window = _Window(w.data_ptr(), nbytes, 1.0, PROP_PERSISTING, PROP_STREAMING)
+    if rt.cudaStreamSetAttribute(stream, STREAM_ATTR_WINDOW, ctypes.byref(v)) != 0:
+        return "cudaStreamSetAttribute(window) failed"
+    try:
+        def run(a, b):
+            w.sum()                                   # W in, persisting
+            flush.sum()                               # a 96 MB stream (normal / streaming lines)
+            a.record()
+            w.sum()
+            b.record()
+
+        us = _time(run, reps)
+        return {"us": round(us, 1), "gbps": round(w.numel() * 4 / us / 1e3, 1), "window_mb": round(nbytes / 2**20, 2)}
+    finally:
+        v.window = _Window(None, 0, 0.0, PROP_NORMAL, PROP_NORMAL)
+        rt.cudaStreamSetAttribute(stream, STREAM_ATTR_WINDOW, ctypes.byref(v))
+        rt.cudaCtxResetPersistingL2Cache()
+        rt.cudaDeviceSetLimit(LIMIT_PERSIST, ctypes.c_size_t(0))
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    ap.add_argument("--mb", default="6,12")
+    ap.add_argument("--gap", type=float, default=40.0)
+    ap.add_argument("--json")
+    a = ap.parse_args()
+    r = probe(tuple(float(x) for x in a.mb.split(",")), a.gap)
+    print(f"[G10] l2probe {r['device']}: attrs {r['attrs']}")
+    for row in r["rows"]:
+        print(f"[G10] l2probe {row['mb']} MB: cold {row['cold_us']} us ({row['cold_gbps']} GB/s), hot {row['hot_us']} "
+              f"({row['hot_gbps']}), l2pf + {a.gap:g} us gap {row['l2pf_us']} ({row['l2pf_gbps']}), persist "
+              f"{row['persist']}")
+    if a.json:
+        with open(a.json, "w") as f:
+            json.dump(r, f, indent=1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/tensorfold/families/deepseek_v41/cuda/linear.py b/src/tensorfold/families/deepseek_v41/cuda/linear.py
