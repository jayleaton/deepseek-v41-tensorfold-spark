+def _hugepage_flag(arr) -> bool | None:
+    """VmFlags ``hg`` (MADV_HUGEPAGE) of the mapping holding ``arr``'s data, None off Linux."""
+
+    addr = arr.__array_interface__["data"][0]
+    try:
+        smaps = open("/proc/self/smaps").read().split("\n")
+    except OSError:
+        return None
+    inside = False
+    for line in smaps:
+        head = line.split(" ", 1)[0]
+        if "-" in head and all(c in "0123456789abcdef-" for c in head):
+            lo, hi = (int(v, 16) for v in head.split("-"))
+            inside = lo <= addr < hi
+        elif inside and line.startswith("VmFlags:"):
+            return " hg" in line
+    return None
+
