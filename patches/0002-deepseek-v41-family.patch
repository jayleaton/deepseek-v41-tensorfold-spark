index 0000000..acf48cb
--- /dev/null
+++ b/tests/cuda/test_dsv41_prefill2_gpu.py
@@ -0,0 +1,196 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G7 prefill levers on the GPU (collected only where PyTorch sees an NVIDIA GPU), compiled kernels:
+
+- mHC at 2,048 rows and D = 5,120: ``TF_DSV41_MHC_BM`` 32 / 64 (and 4 / 16 warps) == the 16-row tile, bf16 gathered
+  partials == fp32, bit for bit; the time of each (printed, ``[G7]``);
+- the query RoPE in place == the widened copy's, bit for bit; its time;
+- the fused prefill attention (``csa2.attn_pf``, BMQ 16 / 32) at 2,048 rows against the chunked kernels (close),
+  rows alone == in the segment (bit for bit); the time of each;
+- the fast tag end to end on the synthetic checkpoint with every G7 knob: segments 1,024 / 256 / 96 equal (bit for
+  bit), the exact knobs (rope in place) == off, the fused attention close to off.
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_prefill2_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.families.deepseek_v41.cuda import mhc, rope_fused  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import attn, attn_pf, ref  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import rows as RW  # noqa: E402
+
+DEV = "cuda"
+R = 2048
+
+
+def _bits(t):
+    return t.reshape(-1).contiguous().view(torch.uint8)
+
+
+def _ms(fn, reps: int = 10) -> float:
+    fn()
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(reps):
+        fn()
+    b.record()
+    torch.cuda.synchronize()
+    return a.elapsed_time(b) / reps
+
+
+# -- mHC ---------------------------------------------------------------------------------------------------------
+def _mhc_case(d: int = 5120, world: int = 2):
+    g = torch.Generator().manual_seed(1)
+    x = torch.randn((R, 4 * d), generator=g).to(torch.bfloat16)
+    gathered = (torch.randn((world, R, d), generator=g) * 0.7).to(torch.bfloat16).float()
+    comb = torch.rand((R, 4, 4), generator=g)
+    comb = (comb / comb.sum(1, keepdim=True)).reshape(R, 16)
+    prev = mhc.Coefs(R, DEV, pre=(torch.rand((R, 4), generator=g) + 0.1).to(DEV),
+                     post=(torch.rand((R, 4), generator=g) * 2).to(DEV), comb=comb.contiguous().to(DEV))
+    hc = mhc.Hc((torch.randn((24, 4 * d), generator=g) * 0.01).to(DEV), (torch.randn(24, generator=g) * 0.5).to(DEV),
+                (torch.rand(3, generator=g) + 0.5).to(DEV))
+    nw = (torch.rand(d, generator=g) + 0.5).to(torch.bfloat16).to(DEV)
+    return x.to(DEV), gathered.to(DEV), prev, hc, nw
+
+
+def _boundary(x, gathered, prev, hc, nw):
+    d = gathered.shape[2]
+    xo = torch.empty_like(x)
+    out = torch.empty((R, d), dtype=torch.bfloat16, device=DEV)
+    co = mhc.Coefs(R, DEV)
+    sc = mhc.Scratch(R, DEV, d)
+    mhc.boundary(x, xo, gathered, prev, hc, nw, out, co, sc)
+    return [xo, out, co.pre, co.post, co.comb, sc.c[:R]]
+
+
+@pytest.mark.parametrize("bm,warps", [(32, 8), (64, 8), (32, 16), (64, 16)])
+def test_mhc_tiles_and_bf16_partials(monkeypatch, bm, warps):
+    x, gathered, prev, hc, nw = _mhc_case()
+    want = _boundary(x, gathered, prev, hc, nw)
+    t16 = _ms(lambda: _boundary(x, gathered, prev, hc, nw))
+    half = gathered.to(torch.bfloat16)
+    for a, b in zip(_boundary(x, half, prev, hc, nw), want):
+        assert torch.equal(_bits(a), _bits(b))
+    th = _ms(lambda: _boundary(x, half, prev, hc, nw))
+    monkeypatch.setenv("TF_DSV41_MHC_BM", str(bm))
+    monkeypatch.setenv("TF_DSV41_MHC_WARPS", str(warps))
+    for a, b in zip(_boundary(x, gathered, prev, hc, nw), want):
+        assert torch.equal(_bits(a), _bits(b))
+    tb = _ms(lambda: _boundary(x, half, prev, hc, nw))
+    print(f"[G7] mhc boundary at {R} rows: BM16 fp32 G {t16:.3f} ms, bf16 G {th:.3f} ms; BM{bm} w{warps} bf16 G "
+          f"{tb:.3f} ms")
+
+
+# -- RoPE in place -----------------------------------------------------------------------------------------------
+def test_rope_in_place_bits_and_time():
+    g = torch.Generator().manual_seed(2)
+    x = (torch.randn((R, 32, 512), generator=g) * 3).to(torch.bfloat16).to(DEV)
+    inv = 160000.0 ** (-torch.arange(0, 64, 2, dtype=torch.float64) / 64)
+    ang = torch.arange(8192, dtype=torch.float64)[:, None] * inv[None, :]
+    cs = torch.cat([ang.cos(), ang.sin()], 1).float().contiguous().to(DEV)
+    pos = torch.arange(5000, 5000 + R, device=DEV)
+    want = rope_fused.apply(x.float(), cs, pos, 64)
+    got = rope_fused.apply_(x.clone(), cs, pos, 64)
+    assert torch.equal(_bits(got), _bits(want))
+    t_old = _ms(lambda: rope_fused.apply(x.float(), cs, pos, 64))
+    y = x.clone()
+    t_new = _ms(lambda: rope_fused.apply_(y, cs, pos, 64))
+    print(f"[G7] query RoPE at {R} rows: widened copy + kernel {t_old:.3f} ms, in place {t_new:.3f} ms")
+
+
+# -- the fused prefill attention -----------------------------------------------------------------------------------
+def _attn_case(ncomp: int = 8192, P: int = 30000, ring: int = 4096):
+    g = torch.Generator().manual_seed(3)
+    q = (torch.randn((R, 32, 512), generator=g) * 0.5).to(torch.bfloat16)
+    cv, csc = ref.quantize_rows(torch.randn((ncomp, 512), generator=g) * 2)
+    sv, ssc = ref.quantize_rows(torch.randn((ring, 512), generator=g) * 2)
+    tok = torch.full((R, 512), -1, dtype=torch.int32)
+    cnt = torch.zeros(R, dtype=torch.int32)
+    rng = np.random.default_rng(4)
+    base = np.sort(rng.choice(ncomp, size=600, replace=False))
+    for r in range(R):                                   # neighbours share most of their selection, as real rows do
+        k = 512 if r % 7 else int(rng.integers(1, 512))
+        sel = np.sort(rng.choice(base, size=k, replace=False))
+        tok[r, :k] = torch.from_numpy(sel.astype(np.int32))
+        cnt[r] = k
+    sink = torch.randn(32, generator=g) * 2
+    inv = 160000.0 ** (-torch.arange(0, 64, 2, dtype=torch.float64) / 64)
+    ang = torch.arange(P + R + 8, dtype=torch.float64)[:, None] * inv[None, :]
+    cs = torch.cat([ang.cos(), ang.sin()], 1).float().contiguous()
+    to = (lambda t: t.to(DEV).contiguous())             # noqa: E731
+    return (to(q), (to(cv), to(csc)), to(tok), to(cnt), (to(sv), to(ssc)), torch.zeros(R, dtype=torch.int32,
+            device=DEV), torch.tensor([P], dtype=torch.int32, device=DEV), to(sink), to(cs), ring)
+
+
+def _chunks(q, comp, tok, cnt, swa, lo, p, sink, cs, ring, rows=128):
+    out = torch.empty((q.shape[0], 32, 512), dtype=torch.bfloat16, device=DEV)
+    sc = attn.Scratch(rows, DEV)
+    for a in range(0, q.shape[0], rows):                # the backend's row blocks (its 128-row scratch)
+        b = min(q.shape[0], a + rows)
+        attn.attention(q[a:b], comp, tok[a:b], cnt[a:b], swa, lo[a:b], p + a, sink, cs, out[a:b], sc, ring=ring)
+    return out
+
+
+def _fused(q, comp, tok, cnt, swa, lo, p, sink, cs, ring):
+    out = torch.empty((q.shape[0], 32, 512), dtype=torch.bfloat16, device=DEV)
+    return attn_pf.attention(q, comp, tok, cnt, swa, lo, p, sink, cs, out, ring=ring)
+
+
+@pytest.mark.parametrize("bmq,warps", [(16, 8), (32, 8), (32, 16)])
+def test_fused_attention_close_row_invariant_and_time(monkeypatch, bmq, warps):
+    monkeypatch.setenv("TF_DSV41_PREFILL_ATTN_BMQ", str(bmq))
+    monkeypatch.setenv("TF_DSV41_PREFILL_ATTN_WARPS", str(warps))
+    case = _attn_case()
+    q, comp, tok, cnt, swa, lo, p, sink, cs, ring = case
+    want = _chunks(*case)
+    got = _fused(*case)
+    torch.testing.assert_close(got.float(), want.float(), rtol=2e-2, atol=4e-3)
+    for r in (0, 777, R - 1):
+        one = _fused(q[r:r + 1], comp, tok[r:r + 1], cnt[r:r + 1], swa, lo[r:r + 1], p + r, sink, cs, ring)
+        assert torch.equal(_bits(one[0]), _bits(got[r]))
+    t_old = _ms(lambda: _chunks(*case), 5)
+    t_new = _ms(lambda: _fused(*case), 5)
+    print(f"[G7] attention at {R} rows (512 compressed + 128 SWA keys): chunks + merge {t_old:.2f} ms, fused BMQ "
+          f"{bmq} w{warps} {t_new:.2f} ms")
+
+
+# -- the fast tag end to end -----------------------------------------------------------------------------------------
+@pytest.mark.parametrize("knobs", [{"TF_DSV41_ROPE_INPLACE": "1"},
+                                   {"TF_DSV41_PREFILL_ATTN": "fused"},
+                                   {"TF_DSV41_PREFILL_ATTN": "fused", "TF_DSV41_PREFILL_ATTN_BMQ": "32",
+                                    "TF_DSV41_ROPE_INPLACE": "1"}])
+def test_fast_prefill_with_g7_knobs(tmp_path_factory, monkeypatch, knobs):
+    import importlib.util
+    from pathlib import Path
+
+    import dsv41_dspark_fakes as DF
+
+    spec = importlib.util.spec_from_file_location("dsv41_prefill_gpu_g5", Path(__file__).with_name(
+        "test_dsv41_prefill_gpu.py"))
+    G5 = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(G5)                         # G5's builders (one module, no second copy of them)
+    PROMPT, build, prompt = G5.PROMPT, G5.build, G5.prompt
+
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")       # the synthetic checkpoint's D is not the mHC kernels' 5,120
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    monkeypatch.setenv("TF_DSV41_FAST_EXPERTS", "gm")
+    ck = DF.ckpt(tmp_path_factory.mktemp("dsv41g7"))
+    off = prompt(build(ck, 1024), PROMPT)
+    for k, v in knobs.items():
+        monkeypatch.setenv(k, v)
+    want = prompt(build(ck, 1024), PROMPT)
+    assert torch.equal(prompt(build(ck, 256), PROMPT, cuts=(700,)), want)
+    assert torch.equal(prompt(build(ck, 96), PROMPT), want)
+    if "TF_DSV41_PREFILL_ATTN" not in knobs:
+        assert torch.equal(want, off)                    # the exact knobs: the same bits
+    rel = (off - want).abs().amax(-1) / off.abs().amax(-1)
+    print(f"[G7] fast + {knobs} vs fast: rel max {float(rel.max()):.3g}, argmax agree "
+          f"{float((off.argmax(-1) == want.argmax(-1)).float().mean()):.2f}")
diff --git a/tests/cuda/test_dsv41_prefill_gpu.py b/tests/cuda/test_dsv41_prefill_gpu.py
new file mode 100644
index 0000000..b8587b2
--- /dev/null
+++ b/tests/cuda/test_dsv41_prefill_gpu.py
@@ -0,0 +1,190 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Prefill performance paths on the GPU (window G5; collected only where PyTorch sees an NVIDIA GPU), on the
+synthetic DSpark checkpoint with the kernels' shapes (``dsv41_dspark_fakes``) and the compiled kernels:
+
+- big prefill segments (``TF_DSV41_PREFILL_CHUNK``): a 1,024-row segment (staging ring, attention row blocks, the
+  indexer in row blocks under a tiny budget) == 128-row segments == the verify path, logits and replies bit for bit;
+  the streaming top-k == the materialised selection;
+- the fast prefill tag (``TF_DSV41_PREFILL_KERNELS=fast``): row-independent (segments 1,024 / 256 / 96 equal, bit for
+  bit) with upstream's grouped routed experts, ``x3tc`` (``TF_DSV41_FAST_EXPERTS=tc``) and ``x3gm`` (gm); near exact;
+- ``x3tc``: the mul1 decode == upstream's ``format.unpack`` (inline PTX and plain), the routed experts vs float64,
+  rows independent, PTX == plain, the k-step settings agree;
+- ``prefill_mm``: column blocks == the whole GEMM, rows alone == in a segment;
+- CED replay on the compiled kernels: n <= 128 == full, chunked == unchunked.
+
+Run: python -m pytest -q tests/cuda/test_dsv41_prefill_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+import dsv41_dspark_fakes as DF
+
+from tensorfold.cuda.exl3 import format as fmt
+from tensorfold.families.deepseek_v41.cuda import prefill_mm as PM
+from tensorfold.families.deepseek_v41.cuda import x3tc
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+from tensorfold.families.deepseek_v41.cuda.weights import X3Stack
+
+DEV = "cuda"
+PROMPT = [int(t) for t in np.random.default_rng(91).integers(3, 250, size=2301)]
+
+
+@pytest.fixture(autouse=True)
+def _torch_seams(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")       # the mHC / Engram kernels are laid out for D = 5,120
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41pfg"))
+
+
+def build(ck, pchunk: int, limit: int = 4096):
+    """``decode.DecodeForward`` on the compiled kernels with ``pchunk``-row prefill segments (env read now)."""
+
+    from tensorfold.families.deepseek_v41.cuda import drafter as DR
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+    from tensorfold.families.deepseek_v41.cuda.csa2.backend import Triton
+    from tensorfold.families.deepseek_v41.cuda.decode import DecodeForward
+
+    root, cfg, table, _ = ck
+    tmap = DF.FK.token_map(cfg)
+    loader = W.Loader(cfg, W.Shards(root), 0, 1, DEV)
+    tree = loader.load(token_map=tmap)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    return DecodeForward(cfg, tree, csa2=Triton(128, cfg.num_attention_heads, DEV), limit=limit, chunk=128,
+                         pchunk=pchunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap), slots=1,
+                         dspark=DR.load(loader), device=DEV)
+
+
+def prompt(fw, ids, mode: str = "full", cuts=(), budget=None, stream=0) -> torch.Tensor:
+    if budget is not None:
+        fw.csa2.index_budget = budget
+    fw.csa2.stream_min = stream
+    n, a = len(ids), 0
+    for b in list(cuts) + [n - 1]:
+        fw.prefill([Piece(0, a, tuple(ids[a:b]))], mode=mode)
+        a = b
+    fw.finish_prompt(0, n - 1, tuple(ids[max(0, n - 128):n - 1]), mode=mode)
+    out = [fw.step([ids[-1]])]
+    for t in (5, 6, 7):
+        out.append(fw.step([t]))
+    return torch.cat(out).float().cpu()
+
+
+# -- the exact path's big segments ------------------------------------------------------------------------------
+def test_big_segments_equal_small_ones(ck):
+    want = prompt(build(ck, 128), PROMPT)
+    fw = build(ck, 1024)
+    got = prompt(fw, PROMPT, budget=1 << 20)
+    assert fw.stage is not None and fw.stage[1] >= 1024 + 127
+    assert torch.equal(got, want)
+
+
+def test_stream_topk_prefill_equals_materialised(ck):
+    want = prompt(build(ck, 1024), PROMPT)
+    assert torch.equal(prompt(build(ck, 1024), PROMPT, stream=1), want)
+
+
+# -- the fast prefill tag -------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("experts", ["grouped", "tc", "gm"])
+def test_fast_prefill_row_independent_and_close(ck, monkeypatch, experts):
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    monkeypatch.setenv("TF_DSV41_FAST_EXPERTS", experts)
+    want = prompt(build(ck, 1024), PROMPT)
+    assert torch.equal(prompt(build(ck, 256), PROMPT, cuts=(700,)), want)
+    assert torch.equal(prompt(build(ck, 96), PROMPT), want)
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "exact")
+    exact = prompt(build(ck, 1024), PROMPT)
+    assert not torch.equal(exact, want) and torch.isfinite(want).all()
+    rel = (exact - want).abs().amax(-1) / exact.abs().amax(-1)
+    print(f"[G5] fast ({experts}) vs exact logits: rel max {float(rel.max()):.3g}, argmax agree "
+          f"{float((exact.argmax(-1) == want.argmax(-1)).float().mean()):.2f}")
+
+
+# -- x3tc ---------------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("bits", [2, 3, 4, 5])
+def test_x3tc_decode_is_upstreams_unpack(bits):
+    g = np.random.default_rng(bits)
+    t = torch.from_numpy(g.integers(-32768, 32768, size=(320, 72, 16 * bits), dtype=np.int64).astype(np.int16))
+    want = torch.from_numpy(fmt.unpack(t.numpy(), bits, "mul1")).view(torch.int16)
+    for asm in (True, False):
+        got = x3tc.decode(t.to(DEV), asm=asm).cpu().view(torch.int16)
+        assert torch.equal(got, want), asm
+
+
+def _stack(E, k, n, bits, seed):
+    g = np.random.default_rng(seed)
+    t = torch.from_numpy(g.integers(-32768, 32768, size=(E, k // 16, n // 16, 16 * bits), dtype=np.int64)
+                         .astype(np.int16)).contiguous()
+    suh = torch.from_numpy((g.choice([-1.0, 1.0], size=(E, k)) * g.uniform(0.5, 1.5, (E, k))).astype(np.float16))
+    svh = torch.from_numpy((g.choice([-1.0, 1.0], size=(E, n)) * g.uniform(0.002, 0.004, (E, n))).astype(np.float16))
+    return X3Stack(t.to(DEV), suh.to(DEV), svh.to(DEV), "mul1")
+
+
+def test_x3tc_routed_on_the_gpu(monkeypatch):
+    E, D, I, S, R = 16, 512, 384, 6, 300
+    gate, up, down = _stack(E, D, I, 3, 1), _stack(E, D, I, 3, 2), _stack(E, I, D, 3, 3)
+    gen = torch.Generator().manual_seed(3)
+    x = (torch.randn(R, D, generator=gen) * 0.5).to(torch.bfloat16).to(DEV)
+    pick = torch.stack([torch.randperm(E, generator=gen)[:S] for _ in range(R)]).to(torch.int32).to(DEV)
+    w = (torch.rand(R, S, generator=gen) + 0.2).to(torch.float16).to(torch.float32).to(DEV)
+    got = x3tc.run(x, pick, w, gate, up, down, 10.0, rows=2048, asm=True)
+    assert torch.equal(got, x3tc.run(x, pick, w, gate, up, down, 10.0, rows=2048, asm=False))
+    assert torch.equal(got, x3tc.run(x, pick, w, gate, up, down, 10.0, rows=64, asm=True))
+    sub = [0, 7, 150, 299]
+    assert torch.equal(got[sub], x3tc.run(x[sub], pick[sub], w[sub], gate, up, down, 10.0, asm=True))
+    for cfg in ("1,2,8", "2,1,8", "4,1,8"):
+        monkeypatch.setenv("TF_DSV41_TC_CFG", cfg)
+        other = x3tc.run(x, pick, w, gate, up, down, 10.0, asm=True)
+        assert torch.allclose(other, got, rtol=0, atol=1e-3 * float(got.abs().max())), cfg
+    Wf = [[torch.from_numpy(fmt.dequantize(m.trellis[e].cpu().numpy(), m.suh[e].cpu().numpy(),
+                                           m.svh[e].cpu().numpy(), 3, "mul1")) for e in range(E)]
+          for m in (gate, up, down)]
+    xf, pk, wc = x.double().cpu(), pick.cpu(), w.double().cpu()
+    ref = torch.zeros(R, D, dtype=torch.float64)
+    for r in range(R):
+        for k in range(S):
+            e = int(pk[r, k])
+            gg = (xf[r] @ Wf[0][e]).clamp(max=10.0)
+            uu = (xf[r] @ Wf[1][e]).clamp(-10.0, 10.0)
+            ref[r] += float(wc[r, k]) * ((torch.nn.functional.silu(gg) * uu) @ Wf[2][e])
+    assert float((got.double().cpu() - ref).abs().max() / ref.abs().max()) < 3e-3
+
+
+# -- prefill_mm ---------------------------------------------------------------------------------------------------
+def test_prefill_gemm_column_blocks_and_rows():
+    from tensorfold.cuda.exl3.linear import Exl3Linear
+
+    g = np.random.default_rng(5)
+    K, N = 1280, 4096
+    t = torch.from_numpy(g.integers(-32768, 32768, size=(K // 16, N // 16, 64), dtype=np.int64).astype(np.int16))
+    suh = torch.from_numpy(g.choice([-1.0, 1.0], size=K).astype(np.float16))
+    svh = torch.from_numpy(g.uniform(0.001, 0.002, size=N).astype(np.float16))
+    lin = Exl3Linear.from_tensors(t, suh, svh, "mul1", device=DEV)
+    x = (torch.randn(700, K) * 0.3).to(torch.bfloat16).to(DEV)
+    whole = PM.matmul(lin, x, torch.float32)
+    parts = PM.column_blocks(lin, 1 << 20)
+    assert len(parts) > 1
+    assert torch.equal(PM.matmul(lin, x, torch.float32, parts), whole)
+    assert torch.equal(PM.matmul(lin, x[300:301], torch.float32), whole[300:301])
+    dec = lin(x[:64], out_dtype=torch.float32)               # the decode path's linear: the same layer, other sums
+    assert float((dec - whole[:64]).abs().max() / dec.abs().max()) < 1e-2
+
+
+# -- CED replay --------------------------------------------------------------------------------------------------
+def test_replay_on_the_gpu(ck):
+    short = PROMPT[:100]
+    assert torch.equal(prompt(build(ck, 1024), short, mode="replay"), prompt(build(ck, 1024), short, mode="full"))
+    want = prompt(build(ck, 1024), PROMPT, mode="replay")
+    assert torch.equal(prompt(build(ck, 256), PROMPT, mode="replay", cuts=(2250,)), want)
+    assert not torch.equal(want, prompt(build(ck, 1024), PROMPT, mode="full"))
