+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The indexer ``weights_proj`` float64 kernel (families/deepseek_v41/cuda/plain_fp64.py) in Triton's CPU
+interpreter: float64 sums equal to torch's ``x.double() @ w.double().t()`` to rounding (the fp32 values bit for bit),
+and a row alone == the row in a window, bit for bit in float64.
+
+Run: python -m pytest -q tests/test_dsv41_plain_fp64_interp.py
+"""
+
+from __future__ import annotations
+
+import os
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401
+
+interpret()
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+
+from tensorfold.families.deepseek_v41.cuda import plain_fp64 as PF
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1" and type(PF._plain).__name__ == "InterpretedFunction"
+pytestmark = [pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)"),
+              pytest.mark.usefixtures("gpu_like")]
+
+
+@pytest.mark.parametrize("K", [5120, 300])
+@pytest.mark.parametrize("xdtype", [torch.bfloat16, torch.float32])
+def test_plain_equals_torch_fp64(K, xdtype):
+    g = torch.Generator().manual_seed(K)
+    x = (torch.randn(9, K, generator=g) * 2).to(xdtype)
+    w = (torch.randn(32, K, generator=g) * 0.05).to(torch.bfloat16)
+    want = x.to(torch.float64) @ w.to(torch.float64).t()
+    got = PF.matmul_t(x, w)
+    assert got.dtype == torch.float64 and got.shape == (9, 32)
+    assert torch.allclose(got, want, rtol=1e-13, atol=1e-13)
+    assert torch.equal(got.to(torch.float32), want.to(torch.float32))
+
+
+def test_plain_row_invariant():
+    g = torch.Generator().manual_seed(7)
+    x = torch.randn(16, 5120, generator=g).to(torch.bfloat16)
+    w = (torch.randn(32, 5120, generator=g) * 0.05).to(torch.bfloat16)
+    whole = PF.matmul_t(x, w)
+    for r in (0, 5, 15):
+        assert torch.equal(PF.matmul_t(x[r:r + 1], w), whole[r:r + 1])
+    assert torch.equal(PF.matmul_t(x[3:11], w), whole[3:11])
+
+
+def test_plain_eligibility():
+    x, w = torch.zeros(2, 64), torch.zeros(32, 64)
+    assert not PF.eligible(x, w)            # CPU: linear.Plain keeps the torch form
+    assert PF.enabled()
