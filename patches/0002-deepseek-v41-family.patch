+
+def test_plan_carries_release():
+    p = Plan(round=3, pieces=[(0, 0, 64)], release=True)
+    q = Plan.decode(p.encode())
+    assert q.release and q.pieces == [(0, 0, 64)]
+    assert not Plan.decode(Plan(round=1, pieces=[(0, 0, 16)]).encode()).release
+
+
+# -- the batcher on the CPU forward -----------------------------------------------------------------------------------
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41adapt"), **SHAPES)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg), topology.load(root)
+
+
+def build(ck, slots: int) -> SlotsForward:
+    root, cfg, table, _ = ck
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), 0, 1).load(token_map=tmap)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    return SlotsForward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), limit=1024, chunk=8,
+                        pchunk=64, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap), slots=slots)
+
+
+class ScriptFloor:
+    """``memory.Floor`` as the batcher uses it, with the tighter rank's usable memory from a script (GiB, cycled)."""
+
+    hard_gib, target_gib, refuse_s = 4.0, 5.0, 30.0
+
+    def __init__(self, script) -> None:
+        self.script, self.i, self.last = list(script), 0, (1, 0, 0)
+        self.needs: list[int] = []
+
+    def check(self, need: int = 0, *, queued: int = 0) -> bool:
+        self.needs.append(int(need))
+        return True
+
+    def fits_idle(self, need: int) -> bool:
+        return True
+
+    def tight(self) -> tuple[int, int]:
+        v = self.script[self.i % len(self.script)]
+        self.i += 1
+        return 1, int(v * GiB)
+
+
+class Recorder:
+    def __init__(self) -> None:
+        self.plans: list[Plan] = []
+
+    def send(self, ints) -> None:
+        self.plans.append(Plan.decode(list(ints)))
+
+
+def digest(store: Store) -> dict:
+    out = {}
+    for k, e in store.entries.items():
+        h = hashlib.sha256()
+        for name in sorted(e.bounded.arrays):
+            h.update(name.encode() + np.ascontiguousarray(e.bounded.arrays[name]).tobytes())
+        out[k] = (e.kind, tuple(e.ids), h.hexdigest())
+    return out
+
+
+def serve(ck, mode: str, floor, monkeypatch):
+    monkeypatch.setenv("TF_DSV41_PREFILL_ADAPT_MIN", "16")
+    fw = build(ck, slots=3)
+    pool = Pool(ck[3], 4096)
+    st = Store(pool, ram_bytes=1 << 30)
+    link = Recorder()
+    b = Batcher(fw, pool, n_slots=3, capacity=1024, store=st, mode=mode, tag=Tag(ced=mode).code(), prefill_rows=64,
+                depth=0, session_min=16, start=False, floor=floor, link=link)
+    jobs = [Job(list(p), 6, s) for p, s in zip(PROMPTS, SAMPLINGS)]
+    for j in jobs:
+        b.submit(j)
+    for _ in range(10000):
+        if not b.step():
+            break
+    out = []
+    for j in jobs:
+        toks = []
+        while (item := j.out.get_nowait()) is not None:
+            if isinstance(item, BaseException):
+                raise item
+            toks += item
+        out.append(toks)
+    return out, digest(st), link.plans, b
+
+
+@pytest.mark.parametrize("mode,cone", [("full", False), ("full", True), ("replay", False)])
+def test_adaptive_rows_same_bits(ck, mode, cone, monkeypatch):
+    monkeypatch.delenv("TF_DSV41_FULL_CONE", raising=False)
+    if cone:                                                # prod's words: the full-mode decoder over its cone
+        monkeypatch.setenv("TF_DSV41_FULL_CONE", "1")
+    fixed, ents_fixed, plans_fixed, _ = serve(ck, mode, None, monkeypatch)
+    # 8 GiB: 64 rows; 5.03: 32 (64's transient would leave < 5); 4.0: 16 (none fits: the smallest)
+    floor = ScriptFloor([8.0, 5.03, 4.0, 4.0, 8.0, 8.0, 5.03])
+    got, ents, plans, b = serve(ck, mode, floor, monkeypatch)
+    assert got == fixed and all(len(t) == 6 for t in got)
+    assert ents == ents_fixed and ents                      # every stored snapshot: the same arrays, bit for bit
+    rows = [sum(e - s for _, s, e in p.pieces) for p in plans if p.pieces]
+    assert max(sum(e - s for _, s, e in p.pieces) for p in plans_fixed if p.pieces) == 64
+    assert {16, 32, 64} <= {r for r in rows if r in (16, 32, 64)} and max(rows) <= 64
+    assert len(rows) > sum(1 for p in plans_fixed if p.pieces)     # smaller rounds: more of them
+    downs = [p for p in plans if p.release]
+    assert downs and all(p.pieces for p in downs) and b.counts["rows_down"] == len(downs)
+    assert b.counts["rows_up"] > 0 and b.ex.releases == len(downs)
+    assert all(not p.release for p in plans_fixed)
+    # admission priced each prompt at the smallest step (16 rows), not at 64
+    assert floor.needs and floor.needs[0] == M.prefill_price(len(PROMPTS[0]), 0, rows=16).total
+
+
+def test_adapt_off_is_the_fixed_rows(ck, monkeypatch):
+    fixed, ents_fixed, plans_fixed, _ = serve(ck, "replay", None, monkeypatch)
