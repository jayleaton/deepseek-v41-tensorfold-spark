+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The CSA2 kernels' row mode (G8, the slot-agnostic CUDA graphs: ``rowtab.py``) in Triton's CPU interpreter: one
+launch over the rows of several slots, each row's position / slot / previous row read from the row table, against
+one launch a segment on the slot's own ring, page table and carry, bit for bit:
+
+- the stores (SWA rows into the stacked rings, compressed rows and index keys through the stacked page tables,
+  ratio 2 pooling with each slot's carry) write the per-segment bytes, and padding rows write nothing;
+- the reads (indexer scores, candidate blocks, reindex, attention over compressed + SWA rows) give each real row
+  the per-segment bits.
+
+Run: python -m pytest -q tests/test_dsv41_rowmode_interp.py (~1-2 min).
+"""
+
+from __future__ import annotations
+
+import os
+
+from dsv41_interp import gpu_like, interpret  # noqa: E402,F401
+
+interpret()
+
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+triton = pytest.importorskip("triton")
+
+from tensorfold.families.deepseek_v41.cuda import rowtab as RT  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import attn, compress, index  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import rows as RW  # noqa: E402
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1" and type(compress._kv_store).__name__ == "InterpretedFunction"
+pytestmark = [pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)"),
+              pytest.mark.usefixtures("gpu_like")]
+
+S, RING, PAGE = 3, 256, 8
+PSH = PAGE.bit_length() - 1
+MIX = [(2, 41, 3), (0, 10, 1), (1, 119, 4)]       # (slot, start, rows): odd and even starts (ratio-2 groups)
+R = 12                                              # 8 real rows + 4 padding
+
+
+def _bits(t):
+    return t.reshape(-1).contiguous().view(torch.uint8)
+
+
+def _rope_table(n: int, theta: float = 160000.0) -> torch.Tensor:
+    inv = theta ** (-torch.arange(0, 64, 2, dtype=torch.float64) / 64)
+    ang = torch.arange(n, dtype=torch.float64)[:, None] * inv[None, :]
+    return torch.cat([ang.cos(), ang.sin()], 1).float().contiguous()
+
+
+def _tables(mp: int = 40):
+    """Stacked page tables [S, mp] over scrambled physical pages (no two slots share one)."""
+
+    g = torch.Generator().manual_seed(1)
+    order = torch.randperm(S * mp + 5, generator=g)[:S * mp].to(torch.int32)
+    return order.view(S, mp).contiguous()
+
+
+def _plan():
+    ids = list(range(sum(n for _, _, n in MIX)))
+    t = torch.from_numpy(RT.plan_rows(MIX, ids, R, S))
+    return t, [(sl, st, n, a, b) for (sl, st, n), (a, b) in zip(MIX, RT.bounds(MIX))]
+
+
+def _pos1(p):
+    return torch.tensor([p], dtype=torch.int32)
+
+
+def test_stores_equal_per_segment_and_padding_writes_nothing():
+    g = torch.Generator().manual_seed(2)
+    t, segs = _plan()
+    pos, wslot, prev = t[RT.POS].contiguous(), t[RT.WSLOT].contiguous(), t[RT.PREV].contiguous()
+    lat = (torch.randn((R, 512), generator=g) * 2).to(torch.bfloat16)      # padding rows: other values
+    cs = _rope_table(200)
+    pt = _tables()
+    # SWA rows: per segment into the slot's ring == row mode into the stacked rings
+    rv = torch.zeros((S * RING, RW.VB), dtype=torch.uint8)
+    rs = torch.zeros((S * RING, RW.SB), dtype=torch.uint8)
+    wv, ws = rv.clone(), rs.clone()
+    for sl, st, n, a, b in segs:
+        compress.kv_store(lat[a:b], cs, wv[sl * RING:(sl + 1) * RING], ws[sl * RING:(sl + 1) * RING], _pos1(st), n,
+                          0, RING)
+    compress.kv_store(lat, cs, rv, rs, pos, R, 0, RING, slots=wslot)
+    assert torch.equal(rv, wv) and torch.equal(rs, ws)
+    # compressed rows (ratio 1 and 2) and index keys through the slot's page table
+    nphys = (pt.numel() + 5) * PAGE
+    for ratio in (1, 2):
+        a_ = torch.zeros((nphys, RW.ROW_BYTES), dtype=torch.uint8)
+        b_ = a_.clone()
+        ka = torch.zeros((nphys, 128), dtype=torch.bfloat16)
+        kb = ka.clone()
+        kp = (torch.randn((R, 128), generator=g)).to(torch.bfloat16)
+        w = torch.randn(128, generator=g).to(torch.bfloat16)
+        for sl, st, n, a, b in segs:
+            compress.kv_store(lat[a:b], cs, a_[:, :RW.VB], a_[:, RW.VB:], _pos1(st), n, ratio, page_table=pt[sl],
+                              page_shift=PSH)
+            compress.index_k(kp[a:b], w, cs, ka, _pos1(st), n, ratio, page_table=pt[sl], page_shift=PSH)
+        compress.kv_store(lat, cs, b_[:, :RW.VB], b_[:, RW.VB:], pos, R, ratio, page_table=pt, page_shift=PSH,
+                          slots=wslot)
+        compress.index_k(kp, w, cs, kb, pos, R, ratio, page_table=pt, page_shift=PSH, slots=wslot)
+        assert torch.equal(a_, b_), ratio
+        assert torch.equal(_bits(ka), _bits(kb)), ratio
+    # ratio-2 pooling: [the slot's carry, rows] per segment == [carries | rows] with each row's previous row
+    carry = torch.randn((S, 1024), generator=g)
+    proj = torch.randn((R, 1024), generator=g)
+    w = torch.randn(512, generator=g).to(torch.bfloat16)
+    want = torch.zeros((R, 512), dtype=torch.bfloat16)
+    for sl, st, n, a, b in segs:
+        buf = torch.cat([carry[sl:sl + 1], proj[a:b]], 0).contiguous()
+        want[a:b] = compress.pool_norm(buf, w, _pos1(st), n, 2, torch.zeros((n, 512), dtype=torch.bfloat16))
+    got = compress.pool_norm(torch.cat([carry, proj], 0).contiguous(), w, pos, R, 2,
+                             torch.zeros((R, 512), dtype=torch.bfloat16), slots=wslot, prev=prev)
+    n_real = segs[-1][4]
+    assert torch.equal(_bits(got[:n_real]), _bits(want[:n_real]))
+    assert not bool(got[n_real:].float().abs().sum())                     # padding: nothing pooled
+    r1 = torch.randn((R, 512), generator=g)
+    w1 = compress.pool_norm(r1, w, pos, R, 1, torch.zeros((R, 512), dtype=torch.bfloat16), slots=wslot)
+    for sl, st, n, a, b in segs:
+        one = compress.pool_norm(r1[a:b].contiguous(), w, _pos1(st), n, 1, torch.zeros((n, 512), dtype=torch.bfloat16))
+        assert torch.equal(_bits(one), _bits(w1[a:b]))
+
+
+def _keys_case(g, pt, nv):
+    """Index keys of every slot's first ``nv`` compressed rows in the shared physical rows, through its table."""
+
+    nphys = (pt.numel() + 5) * PAGE
+    ik = torch.full((nphys, 128), float("nan"), dtype=torch.bfloat16)
+    for sl in range(S):
+        for j in range(nv):
+            ik[int(pt[sl, j // PAGE]) * PAGE + j % PAGE] = torch.randn(128, generator=g).to(torch.bfloat16)
+    return ik
+
+
+def test_indexer_reads_equal_per_segment():
+    g = torch.Generator().manual_seed(3)
+    t, segs = _plan()
+    pos, rslot = t[RT.POS].contiguous(), t[RT.RSLOT].contiguous()
+    pt = _tables()
+    ratio, cap = 1, 127
+    nv = cap + 1
+    ik = _keys_case(g, pt, nv)
+    qi = (torch.randn((R, 32, 128), generator=g)).to(torch.bfloat16).contiguous()
+    w = torch.randn((R, 32), generator=g).contiguous()
+    n_real = segs[-1][4]
+    qi[n_real:], w[n_real:] = qi[n_real - 1], w[n_real - 1]             # padding: the last real row's inputs
+    s = index.scores(qi, w, ik, pos, R, nv, ratio, page_table=pt, page_shift=PSH, slots=rslot)
+    cand = index.candidate_blocks(s, pos, R, ratio, block=8, topk_blocks=6, rows=True)
+    re = index.reindex(qi, w, ik, pos, R, cand, ratio, topk=16, block=8, page_table=pt, page_shift=PSH, slots=rslot)
+    for sl, st, n, a, b in segs:
+        p = _pos1(st)
+        one = index.scores(qi[a:b].contiguous(), w[a:b].contiguous(), ik, p, n, nv, ratio, page_table=pt[sl],
+                           page_shift=PSH)
+        assert torch.equal(_bits(one), _bits(s[a:b])), sl
+        c1 = index.candidate_blocks(one, p, n, ratio, block=8, topk_blocks=6)
+        assert torch.equal(c1, cand[a:b])
+        r1 = index.reindex(qi[a:b].contiguous(), w[a:b].contiguous(), ik, p, n, c1, ratio, topk=16, block=8,
+                           page_table=pt[sl], page_shift=PSH)
+        assert torch.equal(r1, re[a:b])
+    # padding rows mirror the last real row (the same reads)
+    assert torch.equal(_bits(s[n_real:]), _bits(s[n_real - 1:n_real].expand(R - n_real, -1)))
+
+
+def test_attention_equals_per_segment():
+    g = torch.Generator().manual_seed(4)
+    t, segs = _plan()
+    pos, rslot, wslot = t[RT.POS].contiguous(), t[RT.RSLOT].contiguous(), t[RT.WSLOT].contiguous()
+    pt = _tables()
+    cs = _rope_table(200)
+    nphys = (pt.numel() + 5) * PAGE
+    phys = torch.zeros((nphys, RW.ROW_BYTES), dtype=torch.uint8)
+    rv = torch.zeros((S * RING, RW.VB), dtype=torch.uint8)
+    rs = torch.zeros((S * RING, RW.SB), dtype=torch.uint8)
+    for sl in range(S):                    # each slot's history: SWA rows and compressed rows (ratio 1)
+        hist = (torch.randn((130, 512), generator=g) * 2).to(torch.bfloat16)
+        compress.kv_store(hist, cs, rv[sl * RING:(sl + 1) * RING], rs[sl * RING:(sl + 1) * RING], _pos1(0), 130, 0,
+                          RING)
+        compress.kv_store(hist, cs, phys[:, :RW.VB], phys[:, RW.VB:], _pos1(0), 130, 1, page_table=pt[sl],
+                          page_shift=PSH)
+    q = (torch.randn((R, 32, 512), generator=g) * 0.5).to(torch.bfloat16).contiguous()
+    tok = torch.full((R, 40), -1, dtype=torch.int32)
+    cnt = torch.zeros((R,), dtype=torch.int32)
+    for r in range(R):
+        k = int(torch.randint(1, 40, (1,), generator=g))
+        tok[r, :k] = torch.sort(torch.randperm(int(pos[r]) + 1, generator=g)[:k]).values.to(torch.int32)
+        cnt[r] = k
+    n_real = segs[-1][4]
+    tok[n_real:], cnt[n_real:] = tok[n_real - 1], cnt[n_real - 1]          # padding mirrors the last real row
+    lo = torch.zeros((R,), dtype=torch.int32)
+    sink = torch.randn(32, generator=g)
+    sc = attn.Scratch(R, "cpu")
+    comp = (phys[:, :RW.VB], phys[:, RW.VB:])
+    out = torch.empty_like(q)
+    attn.attention(q, comp, tok, cnt, (rv, rs), lo, pos, sink, cs, out, sc, ring=RING, page_table=pt, page_shift=PSH,
+                   slots=rslot)
+    for sl, st, n, a, b in segs:
+        one = torch.empty_like(q[a:b])
+        attn.attention(q[a:b].contiguous(), comp, tok[a:b].contiguous(), cnt[a:b].contiguous(),
+                       (rv[sl * RING:(sl + 1) * RING], rs[sl * RING:(sl + 1) * RING]), lo[a:b].contiguous(), _pos1(st),
+                       sink, cs, one, attn.Scratch(n, "cpu"), ring=RING, page_table=pt[sl], page_shift=PSH)
+        assert torch.equal(_bits(one), _bits(out[a:b])), sl
+    # DSpark's pass: the context list holds ring rows (made absolute in the stacked rings: slot * RING + row) and
+    # every row sees its block (hi): the same per row as the slot's own ring
+    hi = (pos + 1).to(torch.int32)
+    tabs = torch.where(tok >= 0, tok + (rslot * RING).to(torch.int32)[:, None], tok).contiguous()
+    outd = torch.empty_like(q)
+    attn.attention(q, (rv, rs), tabs, cnt, (rv, rs), lo, pos, sink, cs, outd, sc, ring=RING, hi=hi, slots=rslot)
+    for sl, st, n, a, b in segs:
+        ring = (rv[sl * RING:(sl + 1) * RING], rs[sl * RING:(sl + 1) * RING])
+        one = torch.empty_like(q[a:b])
+        attn.attention(q[a:b].contiguous(), ring, tok[a:b].contiguous(), cnt[a:b].contiguous(), ring,
+                       lo[a:b].contiguous(), _pos1(st), sink, cs, one, attn.Scratch(n, "cpu"), ring=RING,
+                       hi=hi[a:b].contiguous())
+        assert torch.equal(_bits(one), _bits(outd[a:b])), sl
+    assert wslot[n_real:].eq(-1).all()
