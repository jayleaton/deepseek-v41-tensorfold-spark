+# -- Triton's lowering, pinned ------------------------------------------------------------------------------------------
+def _triton_ptx(bm, bk, warps, stages, group, out="bf16", bias=0, K=5120, N=1280):
+    triton = pytest.importorskip("triton")
+    try:
+        from triton.backends.compiler import GPUTarget
+        from triton.compiler import ASTSource
+
+        from tensorfold.cuda.exl3 import prefill as P
+    except Exception as exc:  # noqa: BLE001 - no backend in this install
+        pytest.skip(f"no Triton CUDA backend: {exc}")
+    sig = {"X": "*fp16", "W": "*fp16", "H": "*bf16", "SVH": "*fp16", "BIAS": "*fp16", "OUT": "*" + out, "M": "i32",
+           "o_stride": "i32", "K": "constexpr", "N": "constexpr", "BM": "constexpr", "BK": "constexpr",
+           "GROUP": "constexpr", "HAS_BIAS": "constexpr", "SCALE": "constexpr"}
+    const = {"K": K, "N": N, "BM": bm, "BK": bk, "GROUP": group, "HAS_BIAS": bias, "SCALE": P.HAD_SCALE}
+    try:
+        k = triton.compile(ASTSource(fn=P._gemm, signature=sig, constexprs=const),
+                           target=GPUTarget("cuda", 121, 32), options={"num_warps": warps, "num_stages": stages})
+    except Exception as exc:  # noqa: BLE001 - e.g. no ptxas for sm_121 in this Triton
+        pytest.skip(f"Triton cannot compile for sm_121 here: {type(exc).__name__}: {str(exc)[:200]}")
+    return k.asm["ptx"]
+
+
+MMA = re.compile(r"mma\.sync\.aligned\.m16n8k16\.row\.col\.f32\.(f16|bf16)\.(?:f16|bf16)\.f32 \{([^}]*)\}, "
+                 r"\{([^}]*)\}, \{([^}]*)\}, \{([^}]*)\}")
+
+
+def _first(regs: str) -> str:
+    return regs.split(",")[0].strip()
+
+
+MUL = re.compile(r"mul(?:\.rn)?\.(f32x2|f32)\s+(%rd?\d+),\s*(%rd?\d+),\s*(?:%rd?\d+|0f[0-9A-F]{8});")
+
+
+def _scaled(ptx: str) -> tuple[int, set]:
+    """(fp32 products by 1/sqrt(128), their destination registers): mul.f32 by the immediate or a register holding
+    it, or the paired mul.f32x2 (sm_100+: two IEEE RN products) by a {scale, scale} pair."""
+
+    sc = set(re.findall(r"mov\.b32\s+(%r\d+),\s*0f3DB504F3;", ptx))
+    pk = {d for d, a, b in re.findall(r"mov\.b64\s+(%rd\d+),\s*\{(%r\d+),\s*(%r\d+)\};", ptx) if a in sc and b in sc}
+    n, outs = 0, set()
+    for op, d, a, b in re.findall(r"mul(?:\.rn)?\.(f32x2|f32)\s+(%rd?\d+),\s*(%rd?\d+),\s*(%rd?\d+|0f3DB504F3);", ptx):
+        if b == "0f3DB504F3" or b in sc or b in pk:
+            n += 2 if op == "f32x2" else 1
+            outs.add(d)
+    return n, outs
+
+
+@pytest.mark.parametrize("tiles", ["128,32,8,4,8", "128,64,8,3,8", "64,64,4,3,8", "256,32,8,2,8"])
+def test_triton_lowering_pins(tiles):
+    bm, bk, warps, stages, group = (int(v) for v in tiles.split(","))
+    ptx = _triton_ptx(bm, bk, warps, stages, group)
+    mmas = MMA.findall(ptx)
+    kinds = {m[0] for m in mmas}
+    assert kinds == {"f16", "bf16"}, kinds                              # nothing but m16n8k16 f32-accumulating MMAs
+    assert not re.search(r"\bmma\.sync\.aligned\.m16n8k8|wgmma", ptx)
+
+    f16 = [m for m in mmas if m[0] == "f16"]
+    per_k = len(f16) // (bk // 16)
+    assert per_k * (bk // 16) == len(f16) and per_k == bm // warps        # (m16, n8) tiles a warp
+    for m in f16:                                                       # accumulate in place: D == C
+        assert m[1].replace(" ", "") == m[4].replace(" ", ""), m
+    blocks = [[_first(m[1]) for m in f16[i * per_k:(i + 1) * per_k]] for i in range(bk // 16)]
+    assert all(b == blocks[0] for b in blocks) and len(set(blocks[0])) == per_k     # k-outer: one link a tile a k16
+    a_regs = [{_first(m[2]) for m in f16[i * per_k:(i + 1) * per_k]} for i in range(bk // 16)]
+    assert all(not (a_regs[i] & a_regs[j]) for i in range(len(a_regs)) for j in range(i))   # each k16 its own A
+
+    bf = [m for m in mmas if m[0] == "bf16"]
+    chains, cur = [], {}
+    for _, d, a, b, c in bf:
+        key = cur.pop(_first(c), None)
+        if key is None:
+            key = len(chains)
+            chains.append([])
+        chains[key].append((_first(a), _first(b), _first(c)))
+        cur[_first(d)] = key
+    assert chains and all(len(ch) == 16 for ch in chains)              # top's 8 k16 links, then rest's 8
+    for ch in chains:
+        assert [x[1] for x in ch[:8]] == [x[1] for x in ch[8:]]         # the same H fragments for top and rest
+        assert len({x[0] for x in ch}) == 16                            # 16 distinct A fragments
+        init = ch[0][2]                                                 # the chain starts from +0
+        src = re.search(r"mov\.b32\s+" + re.escape(init) + r",\s*(%r\d+|0|0f00000000);", ptx)
+        assert src, init
+        if src.group(1).startswith("%r"):
+            assert re.search(r"mov\.b32\s+" + re.escape(src.group(1)) + r",\s*(0|0f00000000);", ptx)
+    n_scaled, scaled = _scaled(ptx)
+    assert n_scaled == len(chains) * 4                                  # every output * fp32(1/sqrt 128) first
+    n_svh = sum(2 if op == "f32x2" else 1 for op, _, a in MUL.findall(ptx) if a in scaled)
+    assert n_svh == n_scaled                                            # ... then * svh (mul.f32 or paired mul.f32x2)
+    assert not re.search(r"\bfma\.", ptx)                               # no contraction without a bias
+    assert len(re.findall(r"cvt\.rn\.bf16(?:x2)?\.f32", ptx)) > 0
+
+
+def test_triton_lowering_pins_bias_and_dtypes():
+    for tiles in ((128, 32, 8, 4, 8), (64, 64, 4, 3, 8)):
+        ptx = _triton_ptx(*tiles, out="fp32", bias=1)
+        n_scaled, _ = _scaled(ptx)
+        n_fma = sum(2 if x else 1 for x in re.findall(r"fma\.rn\.f32(x2)?\s", ptx))
+        assert n_fma == n_scaled > 0                                    # fma.rn(y * SCALE, svh, bias), one each
+        assert not re.search(r"\bfma\.(?!rn\.f32)", ptx)
+    ptx16 = _triton_ptx(128, 32, 8, 4, 8, out="fp16", bias=0)
+    assert re.search(r"cvt\.rn\.f16(?:x2)?\.f32", ptx16)
