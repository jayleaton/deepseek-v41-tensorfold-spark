+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""M2 on the GPU (window G3; collected only where PyTorch sees an NVIDIA GPU), on a synthetic checkpoint with DSpark
+and the kernels' shapes (``dsv41_dspark_fakes``), the Triton CSA2 / router / DSpark kernels and upstream's EXL3:
+
+- drafted == serial with the DSpark chain kernel (keyed draft noise), 1 slot and 4 slots, T = 0 and T > 0, past
+  2,048 tokens of context, with lookup rounds mixed in;
+- CUDA graphs: a replayed window's logits == the eager window's, bit for bit, at widths 1-6, 8, 12, 16 and a 4-slot
+  mix, before and after a context bucket boundary (lazy capture), and the pending rows a commit keeps are the
+  replay's; replies with graphs == without;
+- the boot path: ``GraphCache`` warm-up within its budget, then the measured cost table.
+
+The real-weights numbers (acceptance vs the kit, tok/s, C4, graphs A/B) are ``cuda/m2bench.py`` (G3-m2.sh).
+Run: python -m pytest -q tests/cuda/test_dsv41_m2_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+import dsv41_dspark_fakes as DF
+
+from tensorfold.engine.exact_sampling import Sampling
+from tensorfold.families.deepseek_v41.cuda import graphs as G
+from tensorfold.families.deepseek_v41.cuda.batch import Job
+from tensorfold.families.deepseek_v41.cuda.forward import Seg
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+
+DEV = "cuda"
+LONG = 4096
+SAMPLINGS = [None, Sampling(seed=7, temperature=0.8, top_k=20, top_p=0.95), None,
+             Sampling(seed=11, temperature=1.1, top_k=0, top_p=0.9, min_p=0.02)]
+PROMPTS = [[int(t) for t in np.random.default_rng(20 + i).integers(3, 250, size=2060 + 31 * i)] for i in range(4)]
+N = 48
+SETTINGS = {"on": True, "budget_s": 120.0, "max_graphs": 64, "bucket": 2048, "slots": 4}
+
+
+@pytest.fixture(autouse=True)
+def _torch_seams(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")       # the mHC / Engram kernels are laid out for D = 5,120
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41m2g"))
+
+
+def _fw(ck, slots=1, dspark=True):
+    return DF.forward(ck, slots=slots, limit=LONG, dspark=dspark, device=DEV, chunk=128)
+
+
+@pytest.fixture(scope="module")
+def serial(ck):
+    # module scope runs before the function-scoped autouse env fixture: set the seams here too (G3: without it the
+    # serial replies came from the mHC / Engram kernels, the drafted ones from the torch seams, and differed)
+    with pytest.MonkeyPatch.context() as mp:
+        mp.setenv("TF_DSV41_SEAMS", "torch")
+        b = DF.batcher(ck, _fw(ck, dspark=False), capacity=LONG, pool_tokens=2 * LONG, depth=0)
+        return DF.run(b, [Job(p, N, s) for p, s in zip(PROMPTS, SAMPLINGS)])
+
+
+@pytest.mark.parametrize("slots", [1, 4])
+def test_drafted_equals_serial_gpu(ck, serial, slots):
+    fw = _fw(ck, slots=slots)
+    b = DF.batcher(ck, fw, n=slots, capacity=LONG, pool_tokens=(slots + 1) * LONG, lookup=True)
+    jobs = [Job(p, N, s) for p, s in zip(PROMPTS, SAMPLINGS)]
+    assert DF.run(b, jobs) == serial
+    assert sum(j.stats["drafting"]["dspark_rounds"] for j in jobs) > 0
+
+
+def _prefill(fw, slot, ids):
+    fw.reset(slot)
+    fw.prefill([Piece(slot, 0, tuple(ids))], mode="full")
+
+
+def test_graph_replay_equals_eager(ck):
+    """Two forwards fed the same windows: one through ``CudaGraphs`` (warm-up + lazy keys), one eager."""
+
+    g, e = _fw(ck, slots=4), _fw(ck, slots=4)
+    bg = DF.batcher(ck, g, n=4, capacity=LONG, pool_tokens=5 * LONG)
+    be = DF.batcher(ck, e, n=4, capacity=LONG, pool_tokens=5 * LONG)
+    g.graphs = G.CudaGraphs(g, settings=SETTINGS)
+    n = g.graphs.warmup(4, lambda s, end: bg.ex.slots[s].ensure(end))
+    assert n == len(G.warmup_keys(4)) and g.graphs.cache.on
+    for f, b in ((g, bg), (e, be)):
+        for s in range(4):
+            b.ex.slots[s].ensure(LONG)
+            _prefill(f, s, PROMPTS[s][:2030 + 3 * s])
+    rng = np.random.default_rng(5)
+    for step in range(12):                             # crosses position 2,048: bucket 1's keys captured lazily
+        widths = [int(w) for w in rng.choice(G.WIDTHS, size=4)] if step % 3 else [int(rng.choice(G.WIDTHS))] * 4
+        live = [s for s in range(4) if step % 4 != s] if step % 2 else [0]
+        segs = [Seg(s, g.slots[s].pos, tuple(int(t) for t in rng.integers(3, 250, size=widths[i])))
+                for i, s in enumerate(live)]
+        lg = g.graphs.run(segs).clone()
+        le = e.run(segs)
+        assert torch.equal(lg, le), (step, [(sg.slot, len(sg.ids)) for sg in segs])
+        for sg in segs:
+            keep = len(sg.ids) // 2
+            g.keep(sg.slot, keep)
+            e.keep(sg.slot, keep)
+            assert g.slots[sg.slot].pos == e.slots[sg.slot].pos
+            for L, t in e.slots[sg.slot].carry.items():
+                assert torch.equal(g.slots[sg.slot].carry[L], t)
+    st = g.graphs.cache.stats
+    assert st["replays"] > 0 and st["lazy"] > 0 and st["failed"] == 0
+    assert any(k[1] == 1 for k in g.graphs.cache.graphs)
+
+
+def test_graphs_on_equals_off_replies(ck, serial):
+    fw = _fw(ck, slots=4)
+    b = DF.batcher(ck, fw, n=4, capacity=LONG, pool_tokens=5 * LONG, lookup=True)
+    fw.graphs = G.CudaGraphs(fw, settings=SETTINGS)
+    fw.graphs.warmup(4, lambda s, end: b.ex.slots[s].ensure(end))
+    for s in b.ex.slots:
+        s.release()
+    jobs = [Job(p, N, s) for p, s in zip(PROMPTS, SAMPLINGS)]
+    assert DF.run(b, jobs) == serial
+    assert fw.graphs.cache.stats["replays"] > 0
+
+
+def test_calibration_measures_on_gpu(ck):
+    from tensorfold.families.deepseek_v41.cuda import calib
+
+    fw = _fw(ck)
+    b = DF.batcher(ck, fw, capacity=LONG, pool_tokens=2 * LONG)
+    costs = calib.measure(fw, PROMPTS[0][:300], ensure=lambda s, end: b.ex.slots[s].ensure(end),
+                          gather_max=lambda v: list(v), sync=torch.cuda.synchronize, reps=2)
+    assert len(costs.verify) == 16 and costs.draft > 0 and all(b >= a for a, b in zip(costs.verify, costs.verify[1:]))
