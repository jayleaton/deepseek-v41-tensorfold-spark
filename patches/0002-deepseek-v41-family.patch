@@ -0,0 +1,183 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""REWRITE-PLAN e1: an mHC boundary of a decode window (R <= 16 rows) as ONE hand-written CUDA launch
+(``mhc_cuda.cu``), ``TF_DSV41_MHC_CUDA=1`` (default 0: the Triton ``_site_dec`` + ``_finish_k`` pair).
+
+What one launch does (``mhc.boundary``; ``site`` and ``final`` take the same kernel without the post / the mixes):
+the rank-order sum of the gathered partials (bf16 or fp32, read straight from the exchange's buffer), the post (the
+new 4 streams), the collapse with the carried pre-mix, the DSpark taps, the next site's 24 mixes and square sums
+against ``fn`` (bf16 in prod, ``TF_DSV41_MHC_FN=bf16``; fp32 too), then in the last CTA to finish: the row sums of
+the 160 partials, rinv, pre / post / comb (sigmoid, softmax, 20 Sinkhorn iterations) and the next sublayer's input
+``bf16((c * rn) * norm_w)``. Today the same work is 2 launches a boundary with a global round trip between them
+(G9 nsys, 1-row window: site 26 us + finish ~10 us, x 83 = 3.0 ms).
+
+Bits: the SAME as the Triton path (``mhc._site`` / ``mhc_dec._site_dec`` + ``mhc._finish_k`` at its default 4
+warps), output for output: every operation is the one Triton emits (``enable_fp_fusion=False``: a rounded product
+and a rounded sum; the ieee dots are ``fma.rn.f32`` chains over a block's 128 columns ascending from +0.0; the
+finish's sums in (stream, block) order; ``ex2.approx.f32`` (not ftz) and ``div.full.f32`` where ``tl.exp`` and
+``/`` are; ``div_rn`` / ``sqrt_rn`` where Triton has them; the Sinkhorn's [4, 4] sums in Triton's butterfly order
+(a0 + a2) + (a1 + a3), read off its PTX for sm_121). ``mhc_cuda_emu.py`` is this arithmetic in numpy (bit for bit
+except ex2.approx / div.full, which it models as correctly rounded: the coefficients within ~2 ulp); tests compare it
+with ``tests/dsv41_kref.py`` and the GPU tests compare the kernel with the Triton path bit for bit. So row invariance,
+batched == alone and drafted == serial hold as before, and the M1 gate is unchanged (fn16: top-1 0.9963).
+
+Design (sm_121, GB10: 48 SMs, ~99 KiB shared memory a block, clusters of <= 8 portable / 16 non-portable CTAs):
+- grid (NB = 40 column blocks) x (4 streams) = 160 CTAs of 128 threads, ~22.5 KiB shared memory and <= 128
+  registers each (launch bounds: 4 CTAs an SM, all 160 resident in one wave). Each CTA streams its 24 x 128 ``fn``
+  values (6 KiB bf16; 983 KiB a boundary over the grid, all requested at once with ``ld.global.nc.L1::no_allocate``)
+  while it computes the post of its column block (phase A: every row, 8 columns a thread), then runs its chains
+  (phase B: R x 25 FMA chains of 128 steps, + R for the collapsed row in stream 0's CTAs; up to 4 chains a thread
+  interleaved, operands from shared memory) and writes its partials to ``Scratch.part`` (Triton's layout).
+- cross-CTA reduction: a ticket (fence + one atomicAdd); the last CTA to arrive runs the finish and resets the
+  counter (self-cleaning across graph replays). Not clusters / DSMEM: a cluster spans at most 8-16 SMs, and the
+  boundary needs ~40+ SMs in flight to stream ``fn`` at bandwidth; the ticket costs one fence + atomic (~1 us).
+- the finish (1 CTA): the R x 160 partials through two cp.async stages (L2) into 7 sums a row (24 mixes, the square
+  sum, the collapsed row's square sum), each one thread's chain in Triton's order; then the coefficients (16 lanes a
+  row, shuffles) on ceil(R / 2) warps while the other warps write the normed input (all warps at R >= 7).
+- in place: ``final`` runs a CTA a block over all 4 streams (grid 40 x 1), so x == xout is safe. A boundary or site
+  in place (the drafter's) keeps the Triton path.
+
+Cost model, R = 1, in a graph after a big predecessor (cold ``fn``): launch ramp ~2-3 us; ``fn`` 983 KiB at ~220 GB/s
+~4.5 us, overlapped with phase A (streams + partials from L2 / DRAM, one round trip); phase B ~0.5 us (26 chains of
+128 FMAs a CTA); fence + ticket ~1 us; finish ~2.5 us (partials from L2 0.5, 160-add chains 0.4, Sinkhorn ~1.2 with
+the norm beside it). => ~11-13 us a boundary (today ~37 us: site 26 + finish 11), R = 4 ~13-15 us, R = 16 ~20-25 us.
+x 83 a window: -1.9 to -2.1 ms in isolation; with the transfer this project has measured (50-70%), **-1.0 to
+-1.5 ms a 1-row window** (REWRITE-PLAN's -1.2 to -2.0).
+
+Knobs: ``TF_DSV41_MHC_CUDA`` (0 / 1); ``TF_DSV41_MHC_CUDA_ROWS`` (16: the largest window it takes, 1..16; the Triton
+path above, a function of the row count only, so rows stay invariant: both paths are the same bits anyway).
+"""
+
+from __future__ import annotations
+
+import os
+from functools import lru_cache
+
+D = 5120
+NB = 40
+MAX_ROWS = 16
+NT = 128
+ROWB = 128                      # dynamic shared memory a row: nsys_window.py reads a window's rows from it
+MODES = {"boundary": 0, "site1": 1, "site2": 2, "final": 3}
+
+
+def enabled() -> bool:
+    return (os.environ.get("TF_DSV41_MHC_CUDA", "").strip() or "0") not in ("0", "off", "no", "false")
+
+
+def max_rows() -> int:
+    n = int(os.environ.get("TF_DSV41_MHC_CUDA_ROWS", "").strip() or MAX_ROWS)
+    if not 1 <= n <= MAX_ROWS:
+        raise ValueError(f"TF_DSV41_MHC_CUDA_ROWS={n} (1..{MAX_ROWS})")
+    return n
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    from pathlib import Path
+
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tf_dsv41_mhc_cuda_v1", sources=[str(here / "mhc_cuda.cpp"), str(here / "mhc_cuda.cu")],
+                extra_cuda_cflags=["-O3", "-lineinfo", "--fmad=false"], verbose=False)
+
+
+def info(device: int = 0) -> dict:
+    """What the GPU offers for the cross-CTA step (the GB10 check): cluster launch, the largest cluster this kernel
+    could use, SMs, opt-in shared memory a block, resident CTAs an SM of the boundary kernel."""
+
+    cl, maxcl, sms, optin, blocks = _ext().info(device)
+    return {"cluster_launch": bool(cl), "max_cluster": maxcl, "sms": sms, "smem_optin": optin, "ctas_per_sm": blocks}
+
+
+def _aligned(t, elems: int = 8) -> bool:
+    return t.data_ptr() % 16 == 0 and all(t.stride(i) % elems == 0 for i in range(t.dim() - 1))
+
+
+def why_not(rows: int, x, xout, gathered, prev, pre_in, hc, norm_w, out, coefs, scratch, tap, post_on: bool,
+            mix: bool) -> str | None:
+    """None when the CUDA boundary takes this call, else the reason (the Triton path runs)."""
+
+    import torch
+
+    from . import mhc as M
+
+    if not enabled():
+        return "off"
+    if not 0 < rows <= max_rows():
+        return "rows"
+    if x.device.type != "cuda" or norm_w.shape[0] != D or M.NB != NB:
+        return "device or shape"
+    bf, f32 = torch.bfloat16, torch.float32
+    if x.dtype != bf or x.shape[1] != 4 * D or x.stride(1) != 1 or not _aligned(x):
+        return "x"
+    if scratch is None or scratch.rows < rows or scratch.dims != D or not scratch.part.is_contiguous() \
+            or not scratch.c.is_contiguous():
+        return "scratch"
+    if out.dtype != bf or out.stride(1) != 1 or out.stride(0) != D or out.data_ptr() % 16:
+        return "out"
+    if norm_w.dtype not in (bf, f32) or not norm_w.is_contiguous() or norm_w.data_ptr() % 16:
+        return "norm_w"
+    if post_on:
+        if xout is None or xout.dtype != bf or not xout.is_contiguous() or xout.data_ptr() % 16:
+            return "xout"
+        if mix and M._overlap(x, xout):
+            return "in place"                       # the drafter's boundaries: Triton
+        g = gathered
+        if g.dtype not in (bf, f32) or g.dim() != 3 or g.shape[0] > 8 or g.stride(2) != 1 or g.stride(1) != D \
+                or g.data_ptr() % 16 or g.stride(0) % (8 if g.dtype == bf else 4):
+            return "gathered"
+    if tap is not None and (tap.dtype != bf or tap.stride(1) != 1 or not _aligned(tap)):
+        return "tap"
+    if mix:
+        if hc.fn.dtype not in (bf, f32) or not hc.fn.is_contiguous() or hc.fn.shape != (24, 4 * D) \
+                or hc.fn.data_ptr() % 16:
+            return "fn"
+        if hc.base.dtype != f32 or hc.scale.dtype != f32 or not hc.base.is_contiguous() \
+                or not hc.scale.is_contiguous():
+            return "base / scale"
+        for t in (coefs.pre, coefs.post, coefs.comb):
+            if t.dtype != f32 or not t.is_contiguous():
+                return "coefs"
+    for t in (pre_in,) + ((prev.post, prev.comb) if post_on else ()):
+        if t is not None and (t.dtype != f32 or not t.is_contiguous()):
+            return "carried coefficients"
+    return None
+
+
+def _counter(scratch, device):
+    """The ticket of a Scratch (one forward's boundaries run in stream order, so one counter serves them all)."""
+
+    import torch
+
+    cnt = getattr(scratch, "mhc_cnt", None)
+    if cnt is None or cnt.device != device:
+        cnt = scratch.mhc_cnt = torch.zeros(4, dtype=torch.int32, device=device)
+    return cnt
+
+
+def run(x, xout, gathered, prev, pre_in, hc, norm_w, out, coefs, scratch, tap, rows: int, post_on: bool,
+        collapse: int, mix: bool, consts: tuple) -> bool:
+    """The CUDA boundary / site / final if it applies (``why_not``): True when it ran."""
+
+    if why_not(rows, x, xout, gathered, prev, pre_in, hc, norm_w, out, coefs, scratch, tap, post_on, mix) is not None:
+        return False
+    import torch
+
+    eps, hc_eps, post_alpha, iters = consts
+    mode = MODES["boundary"] if post_on and mix else MODES["final"] if post_on else \
+        MODES["site2"] if collapse == 2 else MODES["site1"]
+    none = x.new_empty(0)
+    f0 = torch.empty(0, dtype=torch.float32, device=x.device)
+    _ext().run(x, xout if post_on else none, gathered if post_on else none,
+               prev.post if post_on else f0, prev.comb if post_on else f0,
+               pre_in if collapse == 2 else f0, hc.fn if mix else none, hc.base if mix else f0,
+               hc.scale if mix else f0, scratch.part, scratch.c, tap if tap is not None else none, norm_w, out,
+               coefs.pre if mix else f0, coefs.post if mix else f0, coefs.comb if mix else f0,
+               _counter(scratch, x.device), int(rows), int(mode), float(eps), float(hc_eps), float(post_alpha),
+               int(iters))
+    return True
+
+
+__all__ = ["MAX_ROWS", "enabled", "info", "max_rows", "run", "why_not"]
