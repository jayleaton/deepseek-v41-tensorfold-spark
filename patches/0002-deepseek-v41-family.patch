+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DeepSeek-V4.1-Flash's forward on one rank of a TP group.
+
+A window is a list of segments, each one slot's rows at consecutive positions (a prefill chunk, a verify window).
+The linears, the MoE, mHC and the exchanges run over every row of the window at once; the CSA2 steps run a segment at
+a time on its slot's ring, compressed rows and index keys. A run writes every row's state (rings, pool rows, keys)
+but moves no position: ``keep(slot, accepted)`` does (the pending row + ``accepted`` drafts; the carry, the Engram
+lookback and the taps of the last kept row), so a rejected draft's writes lie past the position and are overwritten
+before anything reads them.
+
+Both ranks run the same windows with the same ids; the two exchanges a block (attention ``wo_b`` and the MoE
+partials [n, D]: bf16 values, sent as bf16 in decode windows and prefill segments) are all-gathers that the mHC
+boundary adds in rank order, so both ranks hold identical streams. The embedding (vocabulary halves) is one gather, Engram's rows one gather a module (each rank reads its hash
+heads), the head returns this rank's vocabulary half.
+
+Row invariance: every kernel and every torch step computes a row from that row alone (the linears are upstream's
+row-invariant EXL3 kernels or float64 twins, norms float64, the CSA2 kernels one program a row), so a row's logits
+are the same whether it runs alone, in a verify window, next to other slots' rows or in a prefill chunk.
+
+Per slot: an SWA ring a layer (``ring`` >= chunk + window - 1 rows), the kv sources' compressed rows and index keys
+(contiguous over ``limit`` positions, or the KV pool's pages once ``slots.SlotsForward.bind`` is called), the
+ratio-2 carries, the last ids (Engram's lookback), DSpark's taps when asked. ``step`` / ``prompt`` are the one-slot
+interface (M1's engine and gates); ``slots.py`` adds the serving layer's protocol.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+
+import torch
+
+from tensorfold.cuda.comm import fast_gather
+
+from . import blocks as B
+from . import numerics as N
+from . import pick as P
+from . import prefill_mm as PM
+from . import seams
+from .config import Config
+from .csa2.backend import Win
+from .rope import tables
+from .vision_prep import VBASE
+
+F32, BF16 = torch.float32, torch.bfloat16
+CHUNK = 128                      # rows a verify segment at most (the slot's SWA ring below)
+PCHUNK = 2048                    # rows a prefill segment at most (TF_DSV41_PREFILL_CHUNK; ``prefill_chunk``)
+
+
+def prefill_chunk(chunk: int = CHUNK) -> int:
+    """``TF_DSV41_PREFILL_CHUNK`` (default 2,048): rows a prefill segment holds. Every kernel computes a row from that
+    row alone, so the size changes speed and memory, never a bit. Above 2,048 (G16 4K: ``TF_DSV41_PF_4K=1`` = 4,096)
+    it refuses unless ``TF_DSV41_PF_4K_MEMORY_OK=1`` (``pf4k.check``: the memory cap / leak work comes first)."""
+
+    from . import pf4k
+
+    v = pf4k.chunk()
+    if v < 1:
+        raise ValueError(f"TF_DSV41_PREFILL_CHUNK={v}: expected >= 1")
+    pf4k.check(pchunk=max(int(chunk), v))
+    return max(int(chunk), v)
+
+
+def next_pow2(n: int) -> int:
+    return 1 << max(0, (n - 1).bit_length())
+
+
+@dataclass
+class Pending:
+    """A slot's last run, until ``keep``: where it started, its ids, its ratio-2 projection rows and taps."""
+
+    start: int
+    ids: list
+    proj: dict = field(default_factory=dict)
+    taps: dict = field(default_factory=dict)
+
+
+@dataclass
+class Slot:
+    pos: int = 0
+    swa: dict = field(default_factory=dict)          # layer -> ring store
+    comp: dict = field(default_factory=dict)         # kv source -> compressed rows store
+    ikeys: dict = field(default_factory=dict)        # kv source -> index keys store
+    carry: dict = field(default_factory=dict)        # ratio-2 kv source -> [2 D] (position pos - 1's projection)
+    tail: list = field(default_factory=list)         # the last ids (Engram lookback)
+    taps: dict = field(default_factory=dict)         # tap layer -> [n, D] of the last kept rows
+    pending: Pending | None = None
+
+
+@dataclass
+class Streams:
+    """A run's mHC state between blocks: the 4 streams, the sublayer input, the scratch, the two coefficient sets
+    (``cur``: the pending post's), the gathered partials of the last sublayer, the DSpark taps."""
+
+    x: torch.Tensor
+    out: torch.Tensor
+    scratch: object
+    coefs: list
+    cur: int = 0
+    gathered: torch.Tensor | None = None
+    taps: dict = field(default_factory=dict)
+    alt: torch.Tensor | None = None     # a second streams buffer: boundaries write it (out of place), then swap (G7)
+    image: object = None                # ``vision.Window``: the window's image positions (None: a text window)
+
+
+@dataclass(frozen=True)
+class Seg:
+    slot: int
+    start: int
+    ids: tuple
+
+
+class LocalComm:
+    """World 1: no exchange."""
+
+    rank, world = 0, 1
+
+    def all_gather(self, send: torch.Tensor, recv: torch.Tensor) -> None:
+        recv.copy_(send.reshape(-1))
+
+
+class Forward:
+    """One rank's forward. ``tree``: this rank's ``weights.RankW``; ``csa2``: ``csa2.backend.Triton`` or
+    ``csa2.twin.Twin``; ``engram_rows``: {layer: row source with ``rows(global ids) -> fp32 [N, 256]``} of this
+    rank's heads; ``hasher``: ``engram_host.NgramHasher``; ``slots``: request slots."""
+
+    def __init__(self, cfg: Config, tree, *, csa2, comm=None, device="cpu", limit: int = 4096,
+                 chunk: int = CHUNK, engram_rows: dict | None = None, hasher=None, taps: bool = False,
+                 slots: int = 1, contiguous: bool = True, pchunk: int | None = None) -> None:
+        self.cfg, self.device = cfg, torch.device(device)
+        self.comm = comm if comm is not None else LocalComm()
+        self.rank, self.world = tree.rank, tree.world
+        if getattr(self.comm, "world", self.world) != self.world:
+            raise ValueError(f"the weights are for {self.world} ranks, the communicator has {self.comm.world}")
+        self.csa2 = csa2
+        self.chunk = chunk
+        self.pchunk = max(chunk, int(pchunk or chunk))      # prefill segments (``prefill`` / ``prompt``)
+        self.fast_prefill = PM.mode() == "fast"             # TF_DSV41_PREFILL_KERNELS (the fast session tag)
+        import os
+
+        # prefill segments' exchanges as bf16 (their values are bf16 with the kit's rounding: the same bits)
+        self.exchange_bf16 = (os.environ.get("TF_DSV41_PREFILL_EXCHANGE", "bf16").strip() or "bf16") == "bf16"
+        # G7: those bf16 partials go to the mHC boundary as they arrive (it widens them as it loads them: the same
+        # values), without the kit rounding's fp32 round trip before the exchange and the fp32 copy after it
+        self.gather_bf16 = (os.environ.get("TF_DSV41_PREFILL_GATHER", "fp32").strip() or "fp32") == "bf16"
+        # G7 decode (windows of at most ``chunk`` rows): the partials travel as bf16 (the same values: ``kit_partial``
+        # rounds them to bf16) straight into the mHC boundary, into persistent receive buffers (no allocation a call;
+        # stable addresses inside CUDA graphs). TF_DSV41_DECODE_EXCHANGE=fp32 / TF_DSV41_XCHG_BUFS=0: the old path.
+        self.decode_bf16 = (os.environ.get("TF_DSV41_DECODE_EXCHANGE", "bf16").strip() or "bf16") == "bf16"
+        self.xbufs = (os.environ.get("TF_DSV41_XCHG_BUFS", "1").strip() or "1") != "0"
+        self._recv: dict = {}       # (dtype, device) -> [capacity, [buffer, buffer], parity]
+        self._retired: list = []    # outgrown receive buffers: a captured graph may still write them
+        self.ring = next_pow2(chunk + cfg.sliding_window - 1)
+        self.stage = None           # (store, rows): one staging ring for prefill segments longer than ``ring`` allows
+        self.limit = limit
+        self.tables = tables(cfg, limit + self.pchunk, self.device)
+        self.embed, self.vocab_lo = tree.embed, tree.vocab_lo
+        self.vocab = int(cfg.vocab_size)
+        self.norm = tree.norm
+        self.head = B.materialize(tree.head, self.device)
+        self.blocks = [B.Block(cfg, lw, self.device, self.world) for lw in tree.layers]
+        tree.layers = []
+        from . import l2pf as L2
+        from . import pdl as PD
+
+        PD.check()                              # G14: TF_DSV41_PDL with TF_DSV41_DENSE_V3=1 refuses (not bit-exact)
+        L2.install(self.blocks, self.device)    # G10 TF_DSV41_L2PF (off: None, nothing changes)
+        from . import xmap as XM
+
+        XM.install(self, self.device)           # G15 TF_DSV41_XMAP / _TRACE (off: None, nothing changes)
+        if self.device.type == "cuda":
+            PD.prebuild([self.head, *self.blocks])  # G10 TF_DSV41_PDL part single: its x3seg launches built eagerly
+        self.engram_rows = engram_rows or {}
+        self.hasher = hasher
+        if any(L < len(self.blocks) for L in cfg.engram_layer_ids) and (hasher is None or not self.engram_rows):
+            raise ValueError("Engram layers need the hasher (token map) and this rank's row sources")
+        self.keep_taps = taps
+        self.hc = seams.hc_ops(self.device, cfg)
+        self.trace: dict | None = None      # {layer: streams after the block} of the last run, when a dict
+        self.slots = [self.new_slot(contiguous) for _ in range(slots)]      # no rows yet: the pool's (bind)
+
+    # -- state ---------------------------------------------------------------------------------------------------
+    def new_slot(self, contiguous: bool = True) -> Slot:
+        cfg, cs, dev = self.cfg, self.csa2, self.device
+        s = Slot()
+        for blk in self.blocks:
+            s.swa[blk.index] = cs.rows(self.ring, cfg.head_dim, dev)
+            if blk.mode == "full":
+                if contiguous:
+                    n = self.limit // blk.ratio + 1
+                    s.comp[blk.index] = cs.rows(n, cfg.head_dim, dev)
+                    s.ikeys[blk.index] = cs.keys(n, cfg.index_head_dim, dev)
+                if blk.ratio == 2:
+                    s.carry[blk.index] = torch.zeros((2 * cfg.head_dim,), dtype=N.ACC, device=dev)
+        return s
+
+    @property
+    def slot(self) -> Slot:
+        return self.slots[0]
+
+    def reset(self, slot: int = 0) -> None:
+        """A fresh sequence: the stores are overwritten before they are read, so only the position restarts."""
+
+        s = self.slots[slot]
+        s.pos, s.tail, s.taps, s.pending = 0, [], {}, None
+        for c in s.carry.values():
+            c.zero_()
+
+    def keep(self, slot: int, accepted: int) -> None:
+        """Commit the slot's last run: its first row + ``accepted`` more (prefill: every row)."""
+
+        s = self.slots[slot]
+        p = s.pending
+        if p is None:
+            raise RuntimeError(f"slot {slot}: nothing to commit")
+        if not 0 <= accepted < len(p.ids):
+            raise ValueError(f"slot {slot}: {accepted} accepted of a {len(p.ids)}-row window")
+        s.pos = p.start + accepted + 1
+        for L, rows in p.proj.items():
+            # in place, whatever the dtype: a CUDA graph holds the carry's address, and the carry is a row of the
+            # slots' stacked carries (``rowmode``) that row-mode windows read
+            s.carry[L].copy_(rows[accepted])
+        s.tail = (s.tail + list(p.ids[:accepted + 1]))[-max(1, self.cfg.engram_max_ngram_size - 1):]
+        s.taps = {L: t[:accepted + 1] for L, t in p.taps.items()}
+        s.pending = None
+
+    # -- exchanges -----------------------------------------------------------------------------------------------
+    def allsum(self, partial: torch.Tensor) -> torch.Tensor:
+        """Every rank's partial, added in rank order (identical on every rank)."""
+
+        if self.world == 1:
+            return partial
+        parts = self.gather_partials(partial, wide=True)        # fp32 values, rank order
+        out = parts[0].clone()
+        for r in range(1, self.world):
+            out += parts[r]
+        return out
+
+    def partial_dtype(self, n: int):
+        """The dtype a sublayer of an ``n``-row window should hand ``gather_partials``: bf16 where the decode exchange
+        rounds its partials to bf16 anyway (G9 ``TF_DSV41_PARTIAL_BF16``, default 1: the producer rounds as it
+        stores, the same bits, no cast launch), else None (fp32)."""
+
+        import os
+
+        if self.world > 1 and self.decode_bf16 and n <= self.chunk and N.KIT_ROUNDING and \
+                (os.environ.get("TF_DSV41_PARTIAL_BF16", "1").strip() or "1") != "0":
+            return BF16
+        if self.prefill_bf16(n):
+            return BF16
+        return None
+
+    def prefill_bf16(self, n: int) -> bool:
+        """G16 ``TF_DSV41_PF_COPIES``: a fast prefill segment whose partials travel bf16 into the mHC boundary
+        (``TF_DSV41_PREFILL_GATHER=bf16`` with the kit rounding): the producers round to bf16 as they store (``wo_b``'s
+        GEMM, the MoE's ``bf16(routed + shared)``), the RNE of the ``.to(bf16)`` that ``gather_partials`` runs today."""
+
+        return self.world > 1 and n > self.chunk and self.exchange_bf16 and self.gather_bf16 and N.KIT_ROUNDING \
+            and PM.active() and PM.copies()
+
+    def gather_partials(self, partial: torch.Tensor, wide: bool = False) -> torch.Tensor:
+        """Every rank's fp32 partial [n, D] -> [W, n, D] in rank order (the mHC boundary adds them, rank 0 first).
+        ``TF_DSV41_PREFILL_GATHER=bf16`` (prefill segments): bf16 [W, n, D] holding the same values, unless ``wide``."""
+
+        world = self.world
+        if world > 1 and self.decode_bf16 and partial.shape[0] <= self.chunk and (
+                partial.dtype == BF16 or (N.KIT_ROUNDING and partial.dtype == F32)):
+            # a decode window: bf16(p) == bf16(kit_partial(p)) (kit_partial's values are bf16: rounding one is the
+            # identity), and the mHC widens a bf16 load exactly, so the boundary sums the very fp32 values of the
+            # fp32 path. One cast kernel instead of kit_partial's two, half the bytes on the wire, no fp32 copy after
+            half = partial if partial.dtype == BF16 else partial.contiguous().to(BF16)
+            got = self._exchange(half.contiguous())
+            return got.to(F32) if wide else got
+        if world > 1 and self.exchange_bf16 and self.gather_bf16 and N.KIT_ROUNDING and partial.dtype == BF16 and \
+                partial.shape[0] > self.chunk and not wide:
+            # G16 TF_DSV41_PF_COPIES: the producer stored bf16(p) already (``prefill_bf16``): the next branch's bits
+            half = partial.contiguous()
+            recv = torch.empty((world * half.numel(),), dtype=half.dtype, device=half.device)
+            fast_gather(self.comm, half.view(-1), recv)
+            return recv.view(world, *partial.shape)
+        if world > 1 and self.exchange_bf16 and N.KIT_ROUNDING and partial.dtype == torch.float32 and \
+                partial.shape[0] > self.chunk:
+            # a prefill segment: the partials are bf16 values (``kit_partial``), so they travel as bf16 (half the
+            # bytes: 2 x 21 MB a layer at 2,048 rows) and widen back exactly
+            if self.gather_bf16 and not wide:   # bf16(fp32(bf16(x))) == bf16(x): one rounding, no widening after
+                half = partial.contiguous().to(torch.bfloat16)
+            else:
+                half = P.kit_partial(partial).contiguous().to(torch.bfloat16)
+            recv = torch.empty((world * half.numel(),), dtype=half.dtype, device=half.device)
+            fast_gather(self.comm, half.view(-1), recv)
+            got = recv.view(world, *partial.shape)
+            return got if self.gather_bf16 and not wide else got.to(torch.float32)
+        partial = P.kit_partial(partial).contiguous()
+        if world == 1:
+            return partial.unsqueeze(0)
+        if partial.shape[0] <= self.chunk:
+            return self._exchange(partial)
+        recv = torch.empty((self.world * partial.numel(),), dtype=partial.dtype, device=partial.device)
+        fast_gather(self.comm, partial.view(-1), recv)
+        return recv.view(self.world, *partial.shape)
+
+    def _exchange(self, send: torch.Tensor) -> torch.Tensor:
+        """A decode window's contiguous partial [n, D] -> [W, n, D] in rank order, in a persistent receive buffer."""
+
+        recv = self.recv_buffer(send.dtype, self.world * send.numel(), send.device)
+        fast_gather(self.comm, send.view(-1), recv)
+        return recv.view(self.world, *send.shape)
+
+    def recv_buffer(self, dtype, numel: int, device) -> torch.Tensor:
+        """``numel`` elements of one of two persistent buffers a dtype, alternating call by call: an exchange's
+        result stays valid until the second exchange after it (the forward and the drafter consume each one before
+        the next). Grown by powers of two; an outgrown pair is kept alive (a captured graph holds its address)."""
+
+        if not self.xbufs:
+            return torch.empty((numel,), dtype=dtype, device=device)
+        key = (dtype, str(device))
+        ent = self._recv.get(key)
+        if ent is None or ent[0] < numel:
+            if ent is not None:
+                self._retired.append(ent[1])
+            cap = next_pow2(numel)
+            ent = self._recv[key] = [cap, [torch.empty((cap,), dtype=dtype, device=device) for _ in range(2)], 0]
+        ent[2] ^= 1
+        return ent[1][ent[2]][:numel]
+
+    def gather_cols(self, x: torch.Tensor) -> torch.Tensor:
+        """[n, c] a rank -> [n, world c] in rank order."""
+
+        if self.world == 1:
+            return x
+        x = x.contiguous()
+        recv = torch.empty((self.world * x.numel(),), dtype=x.dtype, device=x.device)
+        fast_gather(self.comm, x.view(-1), recv)
+        return recv.view(self.world, *x.shape).permute(1, 0, 2).reshape(x.shape[0], -1)
+
+    # -- one run -------------------------------------------------------------------------------------------------
+    def embed_rows(self, ids: torch.Tensor, image=None) -> torch.Tensor:
+        local = ids - self.vocab_lo
+        ok = (local >= 0) & (local < self.embed.shape[0])
+        rows = self.embed.index_select(0, local.clamp(0, self.embed.shape[0] - 1)).to(N.ACC)
+        rows = torch.where(ok[:, None], rows, torch.zeros_like(rows))
+        if image is not None:               # image positions: rank 0's rows into its partial (``vision.fill``)
+            from . import vision as V
+
+            rows = V.fill(rows, image, self.rank)
+        return self.allsum(rows).to(N.ACT)
+
+    def _engram_inputs(self, segs) -> dict:
+        if not any(blk.engram is not None for blk in self.blocks):
+            return {}
+        hashes = torch.cat([self.hasher(torch.tensor(sg.ids), lookback=torch.tensor(
+            [t for t in self.slots[sg.slot].tail if t >= 0], dtype=torch.long)) for sg in segs])
+        out = {}
+        for blk in self.blocks:
+            if blk.engram is not None:
+                mine = B.engram_rows(blk, hashes, self.engram_rows[blk.index], self.rank, self.world,
+                                     self.hasher.layout)
+                out[blk.index] = self.gather_cols(mine.to(self.device))
+        return out
+
+    def win_of(self, i: int, start: int, n: int) -> Win:
+        """Segment i's window (a hook: ``decode.DecodeForward`` hands static windows to a CUDA graph capture)."""
+
+        return Win.make(start, n, self.device)
+
+    def ids_of(self, segs) -> torch.Tensor:
+        ids = torch.tensor([t for sg in segs for t in sg.ids], dtype=torch.long)
+        return to_device(ids, self.device) if ids.numel() > self.chunk else ids.to(self.device)
+
+    def staging(self, n: int):
+        """The staging ring for a segment of ``n`` rows, or None when the slot's ring holds it (verify windows)."""
+
+        if n + self.cfg.sliding_window - 1 <= self.ring:
+            return None
+        rows = next_pow2(self.pchunk + self.cfg.sliding_window - 1)
+        if self.stage is None or self.stage[1] < rows:
+            self.stage = (self.csa2.rows(rows, self.cfg.head_dim, self.device), rows)
+        return self.stage
+
+    def run(self, segs, *, logits: bool = True, prefill: bool = False, upto: int | None = None):
+        """Every segment's rows (each at its slot's position, at most ``chunk`` rows a segment, ``pchunk`` when
+        ``prefill``); this rank's logits fp32 [rows, V / W] in segment order, or None. Positions move only with
+        ``keep``. Prefill runs take the fast prefill kernels under ``TF_DSV41_PREFILL_KERNELS=fast``
+        (``prefill_mm``; the head's logits always come from the decode path's linear). ``upto``: stop at that block's
+        attention site after its compressor (CED's encoder pass, ``replay.encode``) and return the ``Streams``."""
+
+        from . import prune as PR
+
+        with PM.fast(prefill and self.fast_prefill), PR.phase(prefill):
+            return self._run(segs, logits=logits, prefill=prefill, upto=upto)
+
+    def _run(self, segs, *, logits: bool, prefill: bool, upto: int | None = None):
+        cfg = self.cfg
+        segs = [sg if isinstance(sg, Seg) else Seg(*sg) for sg in segs]
+        from . import xmap as XM
+
+        XM.begin(self, segs, prefill)                       # G15 trace: the window's slots / positions / ids
+        most = self.pchunk if prefill else self.chunk
+        rv = getattr(getattr(self, "static", None), "rowv", None)       # row mode (``rowgraphs``): one context
+        ctxs, a, spans = [], 0, []
+        for sg in segs:
+            s, n = self.slots[sg.slot], len(sg.ids)
+            if not 1 <= n <= most:
+                raise ValueError(f"a segment holds 1 to {most} rows, not {n}")
+            if sg.start != s.pos:
+                raise ValueError(f"slot {sg.slot}: a segment at {sg.start}, its position is {s.pos}")
+            if sg.start + n > self.limit:
+                raise ValueError(f"positions up to {sg.start + n} exceed this slot's {self.limit}")
+            if rv is None:
+                ctxs.append(B.Context(self.win_of(len(ctxs), sg.start, n), self.tables, self.csa2, self.ring, s, a,
+                                      self.staging(n)))
+            spans.append((a, a + n))
+            a += n
+        n = a
+        ids_t = self.ids_of(segs)
+        image = None
+        if rv is None and max(max(sg.ids) for sg in segs) >= VBASE:     # image positions (``vision.py``)
+            from . import vision as V
+
+            image = V.window([int(t) for sg in segs for t in sg.ids], self.device)
+        rows = self._engram_inputs(segs)
+        if rv is not None:          # every row of every slot at once, padded to the graph's rows (``rowtab``)
+            from . import rowmode
+
+            ctxs = [B.Context(rv.win, self.tables, self.csa2, self.ring, self.rowslot, 0, None)]
+            n = rv.win.n
+            rows = rowmode.mirrored(rows, n, rv.src) if rows else rows
+        D, hcm, ops = cfg.hidden_size, cfg.hc_mult, self.hc
+        x = self.embed_rows(ids_t, image).repeat(1, hcm).contiguous()     # the 4 streams [n, 4 D], flat
+        st = Streams(x, torch.empty((n, D), dtype=N.ACT, device=self.device), ops.Scratch(n, self.device, D),
+                     [ops.Coefs(n, self.device), ops.Coefs(n, self.device)], image=image)
+        wants = getattr(ops, "out_of_place", None)          # G7: per-stream mHC programs need xout != x
+        if wants is not None and wants(n):
+            st.alt = torch.empty_like(x)
+        from . import budget as BU
+
+        with BU.window(spans, rv, n=n, device=self.device, prefill=prefill or upto is not None):
+            self._layers(st, ctxs, rows, upto=upto)     # TF_DSV41_VERIFY_BUDGET: draft rows' experts (budget.py)
+        if rv is not None:
+            c = ctxs[0]
+            self.row_out = (c.proj, st.taps)                # every row's (``rowgraphs`` slices them per window)
+            for sg, (a, b) in zip(segs, spans):
+                self.slots[sg.slot].pending = Pending(sg.start, list(sg.ids), {L: p[a:b] for L, p in c.proj.items()},
+                                                      {L: t[a:b] for L, t in st.taps.items()})
+        else:
+            for sg, c in zip(segs, ctxs):
+                self.slots[sg.slot].pending = Pending(sg.start, list(sg.ids), c.proj,
+                                                      {L: t[c.a:c.b] for L, t in st.taps.items()})
+        if upto is not None:
+            return st
+        return self._finish(st, logits)
+
+    def _layers(self, st: "Streams", ctxs, rows, *, first: int = 0, upto: int | None = None,
+                entered: bool = False) -> None:
+        """Blocks ``first``.. over the window's rows. ``upto``: stop at that block once its attention site is computed
+        and its compressor has stored the rows (CED's encoder pass, ``replay``); ``entered``: the first block's site
+        is already in ``st`` (the decoder replay starts at its attention)."""
+
+        from . import l2pf as L2
+        from . import xmap as XM
+        from . import xovl as XO
+
+        cfg, ops = self.cfg, self.hc
+        x, out, scratch, coefs, n, D = st.x, st.out, st.scratch, st.coefs, st.x.shape[0], cfg.hidden_size
+        xo = XO.active(self, n) and st.image is None    # G16 TF_DSV41_PF_XOVL: exchanges by row halves, overlapped
+        for blk in self.blocks[first:]:
+            if not entered:
+                ha = ops.Hc(blk.hc_attn.fn, blk.hc_attn.base, blk.hc_attn.scale)
+                tap = None
+                if self.keep_taps and blk.index in cfg.aux_layer_ids and st.gathered is not None:
+                    tap = st.taps[blk.index] = torch.empty((n, D), dtype=N.ACT, device=self.device)
+                if st.gathered is None or blk.engram is not None:
+                    if isinstance(st.gathered, XO.Split):
+                        XO.post_only(ops, x, x, st.gathered, coefs[st.cur], tap)
+                    elif st.gathered is not None:
+                        ops.post_only(x, x, st.gathered, coefs[st.cur], tap)
+                    if blk.engram is not None:
+                        B.engram(blk, x, rows[blk.index], None if st.image is None else st.image.keep)
+                    pre_in = coefs[st.cur].pre if st.gathered is not None else None
+                    ops.site(x, ha, blk.attn_norm, out, coefs[1 - st.cur], scratch, pre_in)
+                else:
+                    dst = x if st.alt is None else st.alt
+                    if isinstance(st.gathered, XO.Split):
+                        XO.boundary(ops, x, dst, st.gathered, coefs[st.cur], ha, blk.attn_norm, out,
+                                    coefs[1 - st.cur], scratch, tap)
+                    else:
+                        ops.boundary(x, dst, st.gathered, coefs[st.cur], ha, blk.attn_norm, out, coefs[1 - st.cur],
+                                     scratch, tap)
+                    x = _swap(st, dst)
+                st.cur = 1 - st.cur
+                if blk.index == upto:
+                    B.compress_rows(blk, out, ctxs)
+                    L2.join(self.blocks)
+                    XM.end(self, n)
+                    return
+            entered = False
+            XM.attn_input(blk, out, n)          # G15 trace + pregate: this layer's gate on its attention input
+            if xo:                              # G16: wo_b's halves go out as they are stored
+                st.gathered = XO.Split(self, n)
+                B.attention(blk, out, ctxs, self.partial_dtype(n), emit=st.gathered)
+            else:
+                part = B.attention(blk, out, ctxs, self.partial_dtype(n))
+            L2.mark(blk, "f", n)                # G10 TF_DSV41_L2PF: router + shared expert into L2 during the exchange
+            XM.site(blk, "f", n)                # G15 TF_DSV41_XMAP=prev / both, site f
+            if not xo:
+                st.gathered = self.gather_partials(part)
+            XM.site(blk, "b", n)                # G15 TF_DSV41_XMAP=prev / both, site b (default): beside the boundary
+            hf = ops.Hc(blk.hc_ffn.fn, blk.hc_ffn.base, blk.hc_ffn.scale)
+            dst = x if st.alt is None else st.alt
+            if xo:
+                XO.boundary(ops, x, dst, st.gathered, coefs[st.cur], hf, blk.ffn_norm, out, coefs[1 - st.cur],
+                            scratch)
+            else:
+                ops.boundary(x, dst, st.gathered, coefs[st.cur], hf, blk.ffn_norm, out, coefs[1 - st.cur], scratch)
+            x = _swap(st, dst)
+            st.cur = 1 - st.cur
+            if st.image is None:
+                # G16 TF_DSV41_PF_COPIES: the MoE hands back bf16(routed + shared) when the exchange takes bf16 anyway
+                part = blk.moe(out, out_dtype=BF16) if self.prefill_bf16(n) else blk.moe(out)
+            else:                               # image rows route with ``gate.bias_vl`` (``vision.moe``)
+                from . import vision as V
+
+                part = V.moe(blk.moe, out, st.image)
+            L2.mark(blk, "x", n)                # the next block's x / q groups during the exchange and mHC boundary
+            if xo:                              # G16: the MoE partial in two halves (the next boundary takes each)
+                st.gathered = XO.Split(self, n)
+                for a, b in XO.spans(n):
+                    st.gathered.send(a, b, part[a:b])
+            else:
+                st.gathered = self.gather_partials(part)
+            if self.trace is not None:          # the streams after the block: its FFN post applied to a copy
+                y = x.clone()
+                if xo:
+                    XO.post_only(ops, x, y, st.gathered, coefs[st.cur])
+                else:
+                    ops.post_only(x, y, st.gathered, coefs[st.cur])
+                self.trace[blk.index] = y.view(n, cfg.hc_mult, D)
+        L2.join(self.blocks)
+        XM.end(self, n)                         # G15: the map's side stream joins; the trace closes the window
+
+    def _finish(self, st: "Streams", logits: bool) -> torch.Tensor | None:
+        cfg, n, D = self.cfg, st.x.shape[0], self.cfg.hidden_size
+        if self.keep_taps and len(self.blocks) in cfg.aux_layer_ids:
+            st.taps[len(self.blocks)] = torch.empty((n, D), dtype=N.ACT, device=self.device)
+        from . import xovl as XO
+
+        if isinstance(st.gathered, XO.Split):       # G16 TF_DSV41_PF_XOVL: the last MoE partial's halves
+            XO.final(self.hc, st.x, st.x, st.gathered, st.coefs[st.cur], self.norm, st.out, st.scratch,
+                     st.taps.get(len(self.blocks)))
+        else:
+            self.hc.final(st.x, st.x, st.gathered, st.coefs[st.cur], self.norm, st.out, st.scratch,
+                          st.taps.get(len(self.blocks)))
+        self.hidden = st.scratch.c[:n]                                    # pre-norm (DSpark's confidence head)
+        if not logits:
+            return None
+        with PM.fast(False):
+            return P.kit_logits(self.head(st.out, N.ACC))
+
+    # -- one slot (M1's engine and gates) ------------------------------------------------------------------------
+    def step(self, ids, *, logits: bool = True, slot: int = 0) -> torch.Tensor | None:
+        """``ids`` at the slot's next positions, every row kept; this rank's logits fp32 [n, V / W]."""
+
+        out = self.run([Seg(slot, self.slots[slot].pos, tuple(ids))], logits=logits)
+        self.keep(slot, len(ids) - 1)
+        return out
+
+    def prompt(self, ids, *, every=None, slot: int = 0) -> torch.Tensor | None:
+        """The prompt in windows of ``chunk`` rows (``every``) or ``pchunk`` rows; ``every(start, logits)`` sees each
+        window's logits (teacher-forced scoring); the last row's logits are returned."""
+
+        last = None
+        size = self.chunk if every is not None else self.pchunk
+        for a in range(0, len(ids), size):
+            want = every is not None or a + size >= len(ids)
+            out = self.run([Seg(slot, self.slots[slot].pos, tuple(ids[a:a + size]))], logits=want, prefill=True)
+            self.keep(slot, len(ids[a:a + size]) - 1)
+            if every is not None:
+                every(a, out)
+            if out is not None:
+                last = out[-1:]
+        return last
+
+    def routing(self) -> dict[int, torch.Tensor]:
+        """{layer: the last run's expert picks [n, slots]} (tests)."""
+
+        return {b.index: b.moe.last_pick for b in self.blocks}
+
+
+def _swap(st: Streams, dst: torch.Tensor) -> torch.Tensor:
+    """After a boundary wrote ``dst``: it becomes the streams, the old streams the spare buffer."""
+
+    if dst is not st.x:
+        st.alt, st.x = st.x, dst
+    return st.x
+
+
+def to_device(t: torch.Tensor, device) -> torch.Tensor:
+    """A host tensor on ``device``; on CUDA through pinned memory without a stream sync."""
+
+    if torch.device(device).type != "cuda":
+        return t.to(device)
+    return t.pin_memory().to(device, non_blocking=True)
+
+
+def greedy(fw: Forward, logits: torch.Tensor) -> torch.Tensor:
+    """The argmax over the whole vocabulary of each row from the ranks' halves (ties: the lower id), int64 [n]."""
+
+    v, i = P.argmax(logits)
+    pair = torch.stack([v.to(torch.float64), (i + fw.vocab_lo).to(torch.float64)], 1)
+    allp = fw.gather_cols(pair).view(logits.shape[0], fw.world, 2)
+    best = allp[:, :, 0].argmax(1)                  # max takes the first (lowest rank = lowest ids) on ties
+    return allp[torch.arange(logits.shape[0]), best, 1].to(torch.long)
