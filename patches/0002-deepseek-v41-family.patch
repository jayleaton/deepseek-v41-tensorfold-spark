index 0000000..5742a63
--- /dev/null
+++ b/tests/test_dsv41_prune.py
@@ -0,0 +1,311 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Dynamic routed-expert pruning (families/deepseek_v41/cuda/prune.py) on the CPU: the rule (top-p, the weight floor,
+min-k, ties, untouched rows), the renormalization, the kernel in Triton's interpreter == the torch reference bit for
+bit, row invariance, the knobs and the phase / geometry choice, and an emulator of upstream's ``group`` kernel and
+``down_combine``: a dropped (row, expert) pair is never a group member (no trellis read), an expert nobody keeps is
+never read, and the combine equals the kept experts' sum (stale ``y`` included)."""
+
+from __future__ import annotations
+
+import os
+
+from dsv41_interp import gpu_like, interpret  # noqa: E402,F401
+
+interpret()
+
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+
+from tensorfold.families.deepseek_v41.cuda import prune as PR  # noqa: E402
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1"
+E, K, S = 384, 6, 7                # the target's experts, top-k, slots (routed + shared)
+DROP = E + 1                       # the table size: past the shared expert
+
+
+def _rows(R: int, seed: int, K: int = K, E: int = E, scale: float = 1.5):
+    """Router-like rows: distinct ids a row, weights scale * s / sum s (fp32), the shared slot (E, 1.0)."""
+
+    g = torch.Generator().manual_seed(seed)
+    ids = torch.stack([torch.randperm(E, generator=g)[:K] for _ in range(R)]).to(torch.int32)
+    s = torch.rand((R, K), generator=g) ** 3 + 1e-3
+    w = (scale * (s / s.sum(-1, keepdim=True))).to(torch.float32)
+    pick = torch.cat([ids, torch.full((R, 1), E, dtype=torch.int32)], 1).contiguous()
+    wts = torch.cat([w, torch.ones((R, 1))], 1).contiguous()
+    return pick, wts
+
+
+def _row(fr, ids=None):
+    f = torch.tensor([fr], dtype=torch.float32)
+    k = f.shape[1]
+    ids = torch.tensor([ids or list(range(10, 10 + k))], dtype=torch.int32)
+    return torch.cat([ids, torch.tensor([[E]], dtype=torch.int32)], 1), torch.cat([1.5 * f, torch.ones((1, 1))], 1)
+
+
+HALVES = [0.03125, 0.5, 0.0625, 0.25, 0.03125, 0.125]          # exact binary fractions, out of weight order
+
+
+# -- the rule ------------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("rule,keep", [
+    (PR.Rule(topp=0.875, min_k=1, renorm="kept"), {1, 3, 5}),                     # exclusive mass 0, .5, .75 < .875; then .875
+    (PR.Rule(topp=0.5, min_k=1, renorm="kept"), {1}),
+    (PR.Rule(topp=0.5, min_k=3, renorm="kept"), {1, 3, 5}),        # min-k wins
+    (PR.Rule(min_w=0.0625, min_k=1, renorm="kept"), {1, 3, 5, 2}),  # f >= 1/16
+    (PR.Rule(min_w=0.07, topp=0.99, min_k=1, renorm="kept"), {1, 3, 5}),  # both: the shorter prefix
+    (PR.Rule(min_w=0.03125, min_k=1, renorm="kept"), set(range(6))),  # all kept: the row is untouched
+])
+def test_rule(rule, keep):
+    pick, wts = _row(HALVES)
+    p, w = PR.reference(pick, wts, K, rule, 1.5, DROP)
+    got = {i for i in range(K) if int(p[0, i]) != DROP}
+    assert got == keep
+    if len(keep) == K:
+        assert torch.equal(p, pick) and torch.equal(w.view(torch.int32), wts.view(torch.int32))
+        return
+    tot = sum(HALVES[i] for i in keep)
+    for i in range(K):
+        want = 1.5 * HALVES[i] / tot if i in keep else 0.0
+        assert float(w[0, i]) == pytest.approx(want, rel=1e-6)
+    assert float(w[0, :K].sum()) == pytest.approx(1.5, rel=1e-6)
+    assert int(p[0, K]) == E and float(w[0, K]) == 1.0                    # the shared slot is never touched
+
+
+def test_orig_keeps_router_weights():
+    """RENORM=orig (default): kept weights are the router's own bits, dropped ones 0 (the sum shrinks by the dropped
+    mass); same kept set as ``kept``."""
+
+    pick, wts = _rows(200, 11)
+    for rule in (PR.Rule(topp=0.85, min_k=3), PR.Rule(min_w=0.1, min_k=4)):
+        assert rule.renorm == "orig"
+        p, w = PR.reference(pick, wts, K, rule, 1.5, DROP)
+        pk, _ = PR.reference(pick, wts, K, PR.Rule(rule.min_w, rule.topp, rule.min_k, "kept"), 1.5, DROP)
+        assert torch.equal(p, pk)
+        keep = p[:, :K] != DROP
+        assert torch.equal(w[:, :K].view(torch.int32), torch.where(keep, wts[:, :K], 0.0).view(torch.int32))
+        assert bool((w[:, :K].sum(-1) <= 1.5 + 1e-6).all()) and bool((w[:, :K].sum(-1) < 1.4999).any())
+
+
+def test_ties_lower_slot_first():
+    pick, wts = _row([0.25, 0.25, 0.25, 0.25 - 2 ** -6, 2 ** -7, 2 ** -7])
+    p, _ = PR.reference(pick, wts, K, PR.Rule(topp=0.5, min_k=1), 1.5, DROP)
+    assert [int(v) != DROP for v in p[0, :K]] == [True, True, False, False, False, False]
+    p, _ = PR.reference(pick, wts, K, PR.Rule(topp=0.99, min_k=1), 1.5, DROP)
+    kept = [i for i in range(K) if int(p[0, i]) != DROP]
+    assert kept == [0, 1, 2, 3, 4]                                  # the last of two equal tails: the higher slot
+
+
+def test_dup_mode_points_at_top_expert():
+    pick, wts = _row(HALVES, ids=[7, 8, 9, 10, 11, 12])
+    p, w = PR.reference(pick, wts, K, PR.Rule(topp=0.875, min_k=1), 1.5, DROP, dup=True)
+    assert p[0, :K].tolist() == [8, 8, 8, 10, 8, 12] and float(w[0, 0]) == 0.0 and float(w[0, 2]) == 0.0
+    assert PR.kept(p, K, DROP).tolist() == [3]
+
+
+def test_min_k_never_exceeded_and_mass():
+    pick, wts = _rows(500, 1)
+    for rule in (PR.Rule(topp=0.6, min_k=3, renorm="kept"), PR.Rule(min_w=0.2, min_k=4, renorm="kept"),
+                 PR.Rule(topp=0.3, min_k=1, renorm="kept")):
+        p, w = PR.reference(pick, wts, K, rule, 1.5, DROP)
+        n = PR.kept(p, K, DROP)
+        assert int(n.min()) >= rule.min_k
+        assert torch.allclose(w[:, :K].double().sum(-1), torch.full((500,), 1.5, dtype=torch.float64), rtol=1e-6)
+        assert torch.equal(p[:, K], pick[:, K]) and torch.equal(w[:, K], wts[:, K])
+        f = wts[:, :K] / wts[:, :K].sum(-1, keepdim=True)
+        for r in range(0, 500, 37):                                  # kept = a prefix by weight
+            kept = p[r, :K] != DROP
+            if (~kept).any():
+                assert float(f[r][kept].min()) >= float(f[r][~kept].max())
+
+
+# -- the kernel ----------------------------------------------------------------------------------------------------
+RULES = [PR.Rule(topp=0.9, min_k=3), PR.Rule(min_w=0.08, min_k=4, renorm="kept"),
+         PR.Rule(min_w=0.05, topp=0.95, min_k=3), PR.Rule(topp=0.7, min_k=1, renorm="kept")]
+
+
+def _bits(p, w):
+    return p.clone(), w.view(torch.int32).clone()
+
+
+@pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)")
+@pytest.mark.usefixtures("gpu_like")
+@pytest.mark.parametrize("rule", RULES)
+@pytest.mark.parametrize("dup", [False, True])
+def test_kernel_equals_reference(rule, dup):
+    pick, wts = _rows(37, 2)
+    want = _bits(*PR.reference(pick, wts, K, rule, 1.5, DROP, dup))
+    p, w = pick.clone(), wts.clone()
+    PR.apply(p, w, K, rule, 1.5, DROP, dup)
+    got = _bits(p, w)
+    assert torch.equal(got[0], want[0]) and torch.equal(got[1], want[1])
+
+
+@pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)")
+@pytest.mark.usefixtures("gpu_like")
+def test_kernel_draft_geometry():
+    pick, wts = _rows(21, 3, K=3, E=128)
+    pick[:, 3] = 128
+    rule = PR.Rule(topp=0.8, min_k=2)
+    want = _bits(*PR.reference(pick, wts, 3, rule, 1.5, 129))
+    p, w = pick.clone(), wts.clone()
+    PR.apply(p, w, 3, rule, 1.5, 129)
+    assert torch.equal(p, want[0]) and torch.equal(w.view(torch.int32), want[1])
+
+
+@pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)")
+@pytest.mark.usefixtures("gpu_like")
+def test_row_invariance():
+    """A row alone == the row in windows of 1..33 rows at any offset (batched == alone, drafted == serial)."""
+
+    pick, wts = _rows(40, 4)
+    rule = RULES[2]
+    alone = []
+    for r in range(40):
+        p, w = pick[r:r + 1].clone(), wts[r:r + 1].clone()
+        PR.apply(p, w, K, rule, 1.5, DROP)
+        alone.append(_bits(p, w))
+    for R, off in ((3, 0), (16, 5), (17, 20), (33, 7)):
+        p, w = pick[off:off + R].clone(), wts[off:off + R].clone()
+        PR.apply(p, w, K, rule, 1.5, DROP)
+        for i in range(R):
+            a = alone[off + i]
+            assert torch.equal(p[i:i + 1], a[0]) and torch.equal(w[i:i + 1].view(torch.int32), a[1])
+
+
+def test_cpu_apply_in_place_without_interpreter(monkeypatch):
+    monkeypatch.delenv("TRITON_INTERPRET", raising=False)
+    pick, wts = _rows(9, 5)
+    want = PR.reference(pick, wts, K, RULES[0], 1.5, DROP)
+    PR.apply(pick, wts, K, RULES[0], 1.5, DROP)
+    assert torch.equal(pick, want[0]) and torch.equal(wts, want[1])
+
+
+def test_off_rule_is_a_no_op():
+    pick, wts = _rows(5, 6)
+    p, w = pick.clone(), wts.clone()
+    PR.apply(p, w, K, PR.Rule(), 1.5, DROP)
+    PR.apply(p, w, K, PR.Rule(topp=0.5, min_k=6), 1.5, DROP)          # min_k >= top-k: nothing to drop
+    assert torch.equal(p, pick) and torch.equal(w, wts)
+
+
+# -- knobs and choice ----------------------------------------------------------------------------------------------
+def test_parse():
+    c = PR.parse({})
+    assert c["target"].renorm == "orig" and PR.parse({"TF_DSV41_EXPERT_RENORM": "kept"})["draft"].renorm == "kept"
+    with pytest.raises(ValueError):
+        PR.parse({"TF_DSV41_EXPERT_RENORM": "x"})
+    assert not c["target"].on and not c["draft"].on and not c["prefill"]
+    c = PR.parse({"TF_DSV41_EXPERT_TOPP": "0.9", "TF_DSV41_EXPERT_MIN_K": "4", "TF_DSV41_EXPERT_PRUNE_PREFILL": "1",
+                  "TF_DSV41_DRAFT_EXPERT_MIN_W": "0.1"})
+    assert c["target"] == PR.Rule(0.0, 0.9, 4, "orig") and c["prefill"] and c["draft"] == PR.Rule(0.1, 0.0, 2)
+    assert not PR.parse({"TF_DSV41_EXPERT_TOPP": "1"})["target"].on
+    for bad in ({"TF_DSV41_EXPERT_TOPP": "x"}, {"TF_DSV41_EXPERT_MIN_W": "1.5"}, {"TF_DSV41_EXPERT_MIN_K": "0"}):
+        with pytest.raises(ValueError):
+            PR.parse(bad)
+    assert "topp 0.9" in PR.describe(PR.parse({"TF_DSV41_EXPERT_TOPP": "0.9"}))
+
+
+class _Moe:
+    def __init__(self, experts, topk):
+        self.gate = torch.zeros((experts, 4))
+        self.topk = topk
+
+
+def test_rule_for_phase_and_geometry():
+    cfg = PR.parse({"TF_DSV41_EXPERT_TOPP": "0.9", "TF_DSV41_DRAFT_EXPERT_TOPP": "0.8"})
+    tgt, drf = _Moe(384, 6), _Moe(128, 3)
+    assert PR.rule_for(tgt, cfg) == cfg["target"]
+    with PR.phase(True):
+        assert PR.rule_for(tgt, cfg) is None                         # prompts keep all 6 by default
+        assert PR.rule_for(drf, cfg) == cfg["draft"]
+        assert PR.rule_for(tgt, {**cfg, "prefill": True}) == cfg["target"]
+    assert not PR.in_prefill()
+    assert PR.rule_for(tgt, PR.parse({})) is None
+    assert PR.rule_for(drf, PR.parse({"TF_DSV41_DRAFT_EXPERT_TOPP": "0.8", "TF_DSV41_DRAFT_EXPERT_MIN_K": "3"})) is None
+
+
+# -- grouping and combine emulators (upstream experts.cu: group_kernel, down_combine_kernel) ------------------------
+def group_emu(pick, R: int, slots: int, E: int):
+    """group_kernel: distinct ids < E in id order, members row * 32 + slot in row order."""
+
+    flat = pick.reshape(-1).tolist()[:R * slots]
+    ids = sorted({e for e in flat if 0 <= e < E})
+    members = {e: [(i // slots) * 32 + i % slots for i, v in enumerate(flat) if v == e] for e in ids}
+    return ids, members
+
+
+def combine_emu(pick, wts, y, E: int):
+    """down_combine: every slot's y (recomputed for picks < E, stale otherwise) times its weight, fp32 fma in order."""
+
+    R, slots = pick.shape
+    out = torch.zeros((R, y.shape[-1]), dtype=torch.float32)
+    for r in range(R):
+        acc = torch.zeros(y.shape[-1], dtype=torch.float64)
+        for k in range(slots):
+            acc = (acc + wts[r, k].double() * y[r, k].double()).float().double()
+        out[r] = acc.float()
+    return out
+
+
+def test_grouping_skips_dropped_pairs():
+    pick, wts = _rows(4, 7)                                          # a 4-row verify window
+    rule = PR.Rule(topp=0.8, min_k=2)
+    p, w = PR.reference(pick, wts, K, rule, 1.5, DROP)
+    T = E + 1                                                        # the table: routed + shared
+    ids0, _ = group_emu(pick, 4, S, T)
+    ids1, mem1 = group_emu(p, 4, S, T)
+    kept = {int(v) for v in p[:, :K].reshape(-1) if int(v) != DROP}
+    assert set(ids1) == kept | {E} and set(ids1) < set(ids0)
+    for e, ms in mem1.items():                                       # every member a kept (row, slot)
+        for code in ms:
+            r, s = divmod(code, 32)
+            assert int(p[r, s]) == e and (s == K or float(w[r, s]) > 0)
+    dropped = {int(pick[r, s]) for r in range(4) for s in range(K) if int(p[r, s]) == DROP}
+    assert not (dropped - kept) & set(ids1)                          # an expert nobody keeps is never read
+    assert len(ids1) < len(ids0)
+
+
+def test_combine_equals_kept_sum_with_stale_y():
+    pick, wts = _rows(6, 8)
+    p, w = PR.reference(pick, wts, K, PR.Rule(topp=0.75, min_k=2), 1.5, DROP)
+    g = torch.Generator().manual_seed(9)
+    y = torch.randn((6, S, 32), generator=g)                         # stale values in dropped pairs' rows
+    got = combine_emu(p, w, y, E + 1)
+    keep = (p != DROP).float()
+    ref = combine_emu(p, w * keep, y * keep[..., None], E + 1)
+    assert torch.equal(got, ref)
+
+
+def test_twin_moe_prunes(monkeypatch):
+    """The CPU forward's MoE with a rule == the experts the rule keeps, renormalized."""
+
+    from tensorfold.families.deepseek_v41.cuda import moe as M
+
+    D, En = 8, 16
+    g = torch.Generator().manual_seed(10)
+    gate = torch.randn((En, D), generator=g)
+    bias = torch.zeros(En)
+
+    class Lin:
+        def __init__(self, a, b):
+            self.m = torch.randn((a, b), generator=g, dtype=torch.float64)
+
+        def __call__(self, h, dt):
+            return h.to(torch.float64) @ self.m
+
+    experts = [M.TwinExpert(Lin(D, 4), Lin(4, D), Lin(D, 4)) for _ in range(En + 1)]
+    twin = M.TwinMoE(gate, bias, experts, 4, 1.5, 10.0)
+    x = torch.randn((5, D), generator=g, dtype=torch.float64)
+    cfg = PR.parse({"TF_DSV41_EXPERT_TOPP": "0.6", "TF_DSV41_EXPERT_MIN_K": "1"})
+    monkeypatch.setattr(PR, "CFG", cfg)
+    from tensorfold.families.deepseek_v41.cuda import experts as X
+
+    monkeypatch.setattr(X, "EXPERTS", En)                           # this toy block is the "target"
+    out = twin(x)
+    pick = twin.last_pick
+    assert (pick[:, :4] == len(experts)).any()
+    monkeypatch.setattr(PR, "CFG", PR.parse({}))
+    full = twin(x)
+    assert not torch.equal(out, full)
