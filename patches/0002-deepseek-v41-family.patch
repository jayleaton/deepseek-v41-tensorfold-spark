index 0000000..fe79f9e
--- /dev/null
+++ b/tests/test_dsv41_engram_hash_vllm.py
@@ -0,0 +1,113 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Engram's n-gram hashes == vLLM's semantics (``deepseek_v4_1/common/engram.py``: ``_hash_ids_kernel``; math only,
+re-derived here as a scalar loop), with the real config's layout (layers 1 / 14, 2- to 4-grams, 8 heads, primes above
+16M), on sequences with a BOS / EOS in the middle (G2's prompt-5 lead: we looped on BOS mid-reply, the kit did not).
+
+vLLM's rule per position p of a chunk starting at position c: the id at p - s comes from the chunk when p - s >= c,
+else from the runner's lookback ids (newest first: column c - 1 - (p - s)), else (no id: before the sequence) it
+blocks; a block (or an image token) makes this and every older slot the pad id's compressed value. BOS and EOS are
+ordinary ids there: no reset at a mid-sequence BOS. Both of our paths (``NgramHasher`` with raw-id lookback, and
+``engram.Tables`` with compressed lookback, the serving path) must give the same rows for any chunking."""
+
+from __future__ import annotations
+
+import random
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+from tensorfold.families.deepseek_v41.cuda import engram as EG
+from tensorfold.families.deepseek_v41.cuda.engram_host import NgramHasher
+
+CFG = SimpleNamespace(engram_layer_ids=(1, 14), engram_max_ngram_size=4, engram_n_heads=8,
+                      engram_vocab_size=16_000_000, engram_pad_token_id=2, engram_compressed_vocab_size=99_092)
+VOCAB = 129_280
+
+
+def _tmap():
+    rng = random.Random(7)
+    return [i if i < 300 else rng.randrange(99_092) for i in range(VOCAB)]
+
+
+@pytest.fixture(scope="module")
+def hasher():
+    return NgramHasher(CFG, _tmap())
+
+
+def vllm_rows(h, ids, chunks, dead=None):
+    """[T, layers, cols] by vLLM's per-chunk rule (V2 runner: lookback ids, no slot cache)."""
+
+    tm = h.token_map.tolist()
+    mult, primes, offsets = h.multipliers.tolist(), h.layout.primes.tolist(), h.layout.offsets.tolist()
+    mx, nh, depth = CFG.engram_max_ngram_size, CFG.engram_n_heads, CFG.engram_max_ngram_size - 1
+    dead = dead or [False] * len(ids)
+    out = np.zeros((len(ids), len(CFG.engram_layer_ids), (mx - 1) * nh), dtype=np.int64)
+    for c, e in chunks:
+        window = [ids[c - 1 - k] if c - 1 - k >= 0 else -1 for k in range(depth)]       # newest first
+        wdead = [dead[c - 1 - k] if c - 1 - k >= 0 else False for k in range(depth)]
+        for p in range(c, e):
+            for li in range(len(CFG.engram_layer_ids)):
+                blocked, rolling = False, 0
+                for s in range(mx):
+                    lb = p - s
+                    if lb >= c:
+                        src = -1 if dead[lb] else tm[ids[lb]]
+                    else:
+                        col = c - 1 - lb
+                        known = 0 <= col < depth and window[col] >= 0
+                        src = (-1 if wdead[col] else tm[window[col]]) if known else h.pad_id
+                    blocked = blocked or lb < 0 or src == -1
+                    rolling ^= (h.pad_id if blocked else src) * mult[li][s]
+                    if s > 0:
+                        for hh in range(nh):
+                            col_ = (s - 1) * nh + hh
+                            out[p, li, col_] = rolling % primes[li][col_] + offsets[li][col_]
+    return out
+
+
+def _seq(n, seed):
+    rng = random.Random(seed)
+    ids = [0] + [rng.randrange(3, VOCAB) for _ in range(n - 1)]
+    for p in (9, 10, 23):                    # EOS, BOS mid-sequence; a lone BOS later
+        ids[p] = 1 if p == 9 else 0
+    ids[24] = ids[25] = 0                    # BOS, BOS, BOS: the loop G2 saw on prompt 5
+    return ids
+
+
+@pytest.mark.parametrize("cuts", [[], [10], [9, 11], [1, 2, 3, 24, 25], list(range(1, 32))])
+def test_chunked_hashes_match_vllm(hasher, cuts):
+    ids = _seq(32, 1)
+    bounds = [0, *cuts, len(ids)]
+    chunks = list(zip(bounds[:-1], bounds[1:]))
+    ref = vllm_rows(hasher, ids, chunks)
+    whole = hasher(torch.tensor(ids)).numpy()
+    assert np.array_equal(whole, ref)                       # chunking never changes vLLM's rows either
+    tables = EG.Tables.from_hasher(hasher)
+    got_h, got_t, lb_c = [], [], None
+    for c, e in chunks:
+        got_h.append(hasher(torch.tensor(ids[c:e]), lookback=torch.tensor(ids[max(0, c - 3):c])).numpy())
+        got_t.append(tables.rows(ids[c:e], None, lb_c))
+        lb_c = tables.next_lookback(lb_c, ids[c:e])
+    assert np.array_equal(np.concatenate(got_h), ref)
+    assert np.array_equal(np.concatenate(got_t), ref)
+
+
+def test_mid_sequence_bos_is_an_ordinary_id(hasher):
+    """A BOS at p hashes as token 0 with the ids before it (no reset): its 4-gram differs from a sequence start's."""
+
+    ids = _seq(32, 2)
+    rows = hasher(torch.tensor(ids)).numpy()
+    start = hasher(torch.tensor([0])).numpy()[0]
+    assert not np.array_equal(rows[10], start)
+    assert np.array_equal(rows, vllm_rows(hasher, ids, [(0, len(ids))]))
+
+
+def test_dead_tokens_block_like_vllm(hasher):
+    ids = _seq(32, 3)
+    dead = [False] * 32
+    dead[5] = dead[6] = True
+    ref = vllm_rows(hasher, ids, [(0, 7), (7, 32)], dead)
+    assert np.array_equal(hasher(torch.tensor(ids), torch.tensor(dead)).numpy(), ref)
diff --git a/tests/test_dsv41_engram_interp.py b/tests/test_dsv41_engram_interp.py
