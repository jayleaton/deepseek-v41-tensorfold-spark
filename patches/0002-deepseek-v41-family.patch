index 0000000..c10e7d1
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/moe.py
@@ -0,0 +1,324 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""A rank's MoE block: the router (replicated) and its half of every expert's intermediate width, routed and shared
+experts in one combine, returning the rank's fp32 partial [R, D] (the caller exchanges and adds the partials in rank
+order, then rounds to bf16 once).
+
+Math reference: vLLM ``deepseek_v4`` MoE (sqrt-softplus scores, the selection bias, top-6 renormalized x 1.5, SwiGLU
+clamped at 10) and the kit's EXL3 expert loop (fp16 inputs, fp32 between ``w1/w3`` and ``w2``); engine/reference's
+moe.py is the oracle. The shared expert is the table entry after the routed ones with weight 1.0 (``experts.py``):
+on the GPU it rides in the routed launch, so its SwiGLU is fp32 like the routed experts' (vLLM rounds the shared
+expert's activations to bf16: a rounding difference only).
+
+- ``GpuMoE``: ``router.route`` (Triton) + ``experts.routed`` (upstream's grouped EXL3 kernels, our 0580 load path
+  when ``TF_DSV41_EXPERT_LOADS=1``).
+- ``TwinMoE``: the same on torch (``linear.Dense`` experts, float64 sums), for the CPU forward.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+
+import torch
+import torch.nn.functional as F
+
+from . import budget as BU
+from . import numerics as N
+from . import pick as P
+from . import prune as PR
+
+F32, F64, BF16 = torch.float32, torch.float64, torch.bfloat16
+
+
+def route_twin(x: torch.Tensor, gate: torch.Tensor, bias: torch.Tensor, topk: int, scale: float,
+               shared: int = 1) -> tuple[torch.Tensor, torch.Tensor]:
+    """(pick int32 [R, topk + shared], wts fp32): the router kernel's rule in float64 (ties to the lower id)."""
+
+    E = gate.shape[0]
+    logits = (x.to(F64) @ gate.to(F64).t()).to(N.ACC).to(F64)
+    s = torch.sqrt(F.softplus(logits))
+    choice = s + bias.to(F64)[None, :]
+    order = torch.sort(-choice, dim=-1, stable=True).indices[:, :topk]          # stable: ties keep the lower id
+    sv = s.gather(1, order)
+    w = scale * sv / sv.sum(-1, keepdim=True)
+    R = x.shape[0]
+    pick = torch.cat([order, torch.arange(E, E + shared, device=x.device).expand(R, shared)], 1)
+    wts = torch.cat([w, torch.ones((R, shared), dtype=F64, device=x.device)], 1)
+    return pick.to(torch.int32), wts.to(N.ACC)
+
+
+@dataclass
+class TwinExpert:
+    w1: object                  # linear.Dense, this rank's half of the gate / up columns, the down rows
+    w2: object
+    w3: object
+
+
+@dataclass
+class TwinMoE:
+    gate: torch.Tensor          # [E, D] bf16 values (router)
+    bias: torch.Tensor          # [E] fp32
+    experts: list               # TwinExpert per table entry: routed, then shared
+    topk: int
+    scale: float
+    limit: float
+    last_pick: torch.Tensor | None = field(default=None, repr=False)
+
+    def __call__(self, x: torch.Tensor, out_dtype: torch.dtype | None = None) -> torch.Tensor:
+        """``out_dtype`` (G16 ``TF_DSV41_PF_COPIES``): the fp32 partial rounded to it (bf16 prefill exchanges)."""
+
+        out = self._call(x)
+        return out if out_dtype is None else out.to(out_dtype)
+
+    def _call(self, x: torch.Tensor) -> torch.Tensor:
+        E = self.gate.shape[0]
+        pick, wts = route_twin(x, self.gate, self.bias, self.topk, self.scale, len(self.experts) - E)
+        plan = BU.plan_for(self, x.shape[0])           # TF_DSV41_VERIFY_BUDGET (budget.py; off / prompts: None)
+        if plan is not None:
+            lg = (x.to(F64) @ self.gate.to(F64).t()).to(N.ACC)
+            pick, wts = BU.reference(pick, wts, lg, self.bias, plan.meta, self.topk, plan.cfg, len(self.experts))
+        rule = PR.rule_for(self)
+        if rule is not None:
+            pick, wts = PR.reference(pick, wts, self.topk, rule, self.scale, len(self.experts))
+        wts = P.kit_weights(wts)
+        self.last_pick = pick
+        out = torch.zeros((x.shape[0], x.shape[1]), dtype=F64, device=x.device)
+        for e in torch.unique(pick).tolist():
+            if e >= len(self.experts):              # a pruned slot (prune.py): weight 0, nothing to run
+                continue
+            rows, slot = (pick == e).nonzero(as_tuple=True)
+            ex = self.experts[e]
+            h = x.index_select(0, rows)
+            g = ex.w1(h, N.ACC).to(F64).clamp(max=self.limit)
+            u = ex.w3(h, N.ACC).to(F64).clamp(min=-self.limit, max=self.limit)
+            act = (F.silu(g) * u).to(N.ACC)
+            down = ex.w2(act, N.ACC).to(F64)
+            out.index_add_(0, rows, down * wts[rows, slot].to(F64).unsqueeze(-1))
+        return out.to(N.ACC)
+
+
+GROUP_SMEM = 48 << 10           # upstream's ``group`` kernel: a window's picks [R, slots] int32 in shared memory
+GROUP_STATIC = 128              # ... beside its static ``warp_tot`` [32] int32 (48 KiB is the launch's whole budget)
+EXPERT_BLOCK = 1024             # rows an expert pass at most (TF_DSV41_EXPERT_BLOCK; a power of two under the limit)
+
+
+def group_rows_limit(slots: int) -> int:
+    """The most rows upstream's ``group`` kernel takes with ``slots`` picks a row: 48 KiB less its static 128 bytes of
+    int32 picks (1,750 at the target's 6 routed + 1 shared; G1 found a 2,048-row window over it)."""
+
+    return (GROUP_SMEM - GROUP_STATIC) // (4 * int(slots))
+
+
+DRAFT_BLOCK = 64                # DSpark's MoE runs draft rows only (slots x depth); TF_DSV41_DRAFT_EXPERT_BLOCK
+
+
+def expert_block(slots: int, draft: bool = False) -> int:
+    """Rows an expert pass of a window takes at once: ``TF_DSV41_EXPERT_BLOCK`` (default 1,024; DSpark's blocks
+    ``TF_DSV41_DRAFT_EXPERT_BLOCK``, 64), never over the group kernel's limit. Rows are independent in the router and
+    the grouped GEMMs, so the bits do not depend on it."""
+
+    import os
+
+    name, default = ("TF_DSV41_DRAFT_EXPERT_BLOCK", DRAFT_BLOCK) if draft else ("TF_DSV41_EXPERT_BLOCK", EXPERT_BLOCK)
+    want = int(os.environ.get(name, "") or default)
+    if want < 1:
+        raise ValueError(f"{name}={want}: expected >= 1")
+    return max(1, min(want, group_rows_limit(slots)))
+
+
+def block_of(geom) -> int:
+    """``expert_block`` for a block geometry (DSpark's: fewer experts than the target's 384)."""
+
+    from . import experts as X
+
+    return expert_block(geom.slots, draft=geom.experts != X.EXPERTS)
+
+
+_SCRATCH: dict = {}
+
+
+def scratch_for(block, device) -> object:
+    """One upstream ``Scratch`` per (geometry, device), sized once to ``block_of`` rows and never grown: layers run
+    one after another on one stream and a scratch holds nothing between calls, so every layer of a geometry shares it
+    (G2's ~3.0 GiB workspace was 40 per-layer scratches of 68.7 MiB at 128 rows). Fixed addresses also keep CUDA graph
+    captures valid: a scratch grown after a capture (16-row decode keys, then a 128-row prefill piece) freed the
+    memory the graphs still wrote to."""
+
+    from . import experts as X
+    from . import pf4k
+
+    key = (block.geom, str(device))
+    s = _SCRATCH.get(key)
+    if s is None:
+        gm = pf4k.gm_arena_bytes(block.geom)        # G16 4K (acknowledged, TF_DSV41_PF_4K): one arena; else 0
+        if gm:
+            s = _SCRATCH[key] = arena_scratch(block, block_of(block.geom), device, gm)
+        else:
+            s = _SCRATCH[key] = X.scratch(block, block_of(block.geom), device=device)
+    return s
+
+
+def arena_bytes(rows: int, slots: int, D: int, I: int, sk_gu: int = 4, sk_d: int = 1) -> int:
+    """Bytes of upstream ``Scratch``'s float buffers at ``rows`` rows: z (split-K partials, fp32), y (fp32), xg / xu
+    (fp16 rotated inputs), xd (fp16)."""
+
+    P = rows * slots
+    return max(2 * sk_gu * I, sk_d * D) * P * 4 + P * D * 4 + 2 * P * D * 2 + P * I * 2
+
+
+def arena_scratch(block, rows: int, device, min_bytes: int = 0) -> object:
+    """Upstream's ``Scratch`` for ``rows`` rows (``experts.scratch``: the same buffers, shapes, dtypes and zeros)
+    with its float buffers as disjoint views of ONE allocation ``arena`` (uint8) of at least ``min_bytes``: x3gm's
+    4,096-row block (``x3gm.Buffers``: X / Y from the start, Xd at the end) fits the bytes a 1,024-row grouped
+    scratch holds anyway (G16 4K). The grouped kernels see the same tensors as before; a call still writes every
+    element it reads (x3gm / x3tc already alias z / xg / y), so nothing depends on the layout."""
+
+    import torch
+
+    from tensorfold.cuda.exl3 import experts as x3
+
+    from . import experts as X
+
+    gu, dn = X.configs(block.geom)
+    ex = block.ex
+    D, I, slots = ex.dims, ex.width, block.geom.slots
+    P = rows * slots
+    sizes = [("z", max(2 * gu[2] * I, dn[2] * D) * P, torch.float32), ("y", P * D, torch.float32),
+             ("xg", P * D, torch.float16), ("xu", P * D, torch.float16), ("xd", P * I, torch.float16)]
+    need = sum(n * torch.empty((), dtype=dt).element_size() for _, n, dt in sizes)
+    arena = torch.zeros((max(need, int(min_bytes)),), dtype=torch.uint8, device=device)
+    s = x3.Scratch.__new__(x3.Scratch)
+    s.cfg_gu, s.cfg_d = gu, dn
+    at = 0
+    for name, n, dt in sizes:
+        nb = n * torch.empty((), dtype=dt).element_size()
+        setattr(s, name, arena[at:at + nb].view(dt))
+        at += nb
+    s.xg, s.xu, s.y = s.xg.view(P, D), s.xu.view(P, D), s.y.view(P, D)
+    s.xd = s.xd.view(P, I)
+    maxu = min(P, ex.count)
+    s.ids = torch.zeros((maxu,), dtype=torch.int32, device=device)
+    s.count = torch.zeros((1,), dtype=torch.int32, device=device)
+    s.members_buf = torch.full((maxu * rows,), -1, dtype=torch.int32, device=device)
+    s.rows, s.slots, s.count_experts = rows, slots, ex.count
+    s.arena = arena
+    return s
+
+
+def scratch_bytes_total() -> int:
+    """Bytes the shared expert scratches hold (memory reports)."""
+
+    from . import experts as X
+    from . import moe_fused as MF
+
+    return sum(X.scratch_bytes(s.rows, g) for (g, _), s in _SCRATCH.items()) + MF.side_bytes_total()
+
+
+def row_blocks(R: int, block: int) -> list[tuple[int, int]]:
+    return [(a, min(R, a + block)) for a in range(0, R, block)]
+
+
+def router_tail() -> bool:
+    """``TF_DSV41_RG_TAIL`` (router_gemv.TAIL): the router's folded tail (``router.route_fold``)."""
+
+    from . import router_gemv as RG
+
+    return bool(RG.TAIL)
+
+
+@dataclass
+class GpuMoE:
+    gate: torch.Tensor          # [E, D] bf16 (the router kernel widens any dtype to fp32)
+    bias: torch.Tensor          # [E] fp32
+    block: object               # experts.Experts (routed + shared entries)
+    topk: int
+    scale: float
+    limit: float
+    scratch: object = field(default=None, repr=False)
+    last_pick: torch.Tensor | None = field(default=None, repr=False)
+
+    def ensure(self, rows: int = 0) -> None:
+        """The geometry's shared scratch (``scratch_for``; ``rows`` is not needed: windows run in blocks of it)."""
+
+        if self.scratch is None:
+            self.scratch = scratch_for(self.block, self.gate.device)
+        from . import moe_fused as MF
+
+        if MF.CFG["on"] and self.gate.is_cuda:      # TF_DSV41_MOE_FUSED: its side stream / buffers before captures
+            MF.side_for(self.block, self.scratch, self.gate.device)
+
+    def __call__(self, x: torch.Tensor, out_dtype: torch.dtype | None = None) -> torch.Tensor:
+        """The window's rows in expert passes of at most ``block_of`` rows (a 2,048-row prefill chunk is two 1,024-row
+        passes: upstream's ``group`` takes 1,750 at most, and the scratch stays a block's size). ``out_dtype`` (G16
+        ``TF_DSV41_PF_COPIES``, fast prefill runs): the partial rounded to it as it is stored."""
+
+        from . import experts as X
+        from . import prefill_mm as PM
+        from . import router
+
+        if PM.active():                             # a fast prefill run (TF_DSV41_PREFILL_KERNELS=fast)
+            from . import prefill_moe
+
+            return prefill_moe.forward(self, x, out_dtype)
+        if out_dtype is not None:
+            return self(x).to(out_dtype)
+        R = x.shape[0]
+        x = x.contiguous()
+        self.ensure(R)
+        rule = PR.rule_for(self)                    # TF_DSV41_EXPERT_MIN_W / TOPP (prune.py; off: None)
+        plan = BU.plan_for(self, R)                 # TF_DSV41_VERIFY_BUDGET (budget.py; off / prompts: None)
+        from . import moe_fused as MF
+
+        xm = getattr(self, "xmap", None)            # G15 TF_DSV41_XMAP / _TRACE (xmap.py; off: None)
+        if MF.CFG["on"] and MF.eligible(self, x, plan):     # TF_DSV41_MOE_FUSED (moe_fused.py): the same bits
+            out, self.last_pick = MF.forward(self, x, rule)
+            if xm is not None:
+                xm.routed(self, x, self.last_pick, R)
+            return out
+        blocks = row_blocks(R, self.scratch.rows)
+        kit_done = grouped = False
+        if router_tail() and rule is None and plan is None and x.is_cuda:
+            # G9 TF_DSV41_RG_TAIL: the fp16 weights (``kit_weights``) and, for one block of rows, the grouping run
+            # in the router's tail (the same bits); never with pruning (it changes picks and weights after it)
+            grp = None
+            if len(blocks) == 1:
+                ids, members = self.scratch.window(R)
+                grp = (ids, self.scratch.count, members, self.block.ex.count)
+            pick, wts, kit_done, grouped = router.route_fold(x, self.gate, self.bias, topk=self.topk,
+                                                             scale=self.scale, kit=N.KIT_ROUNDING, group=grp,
+                                                             fold=True)
+            if xm is not None:
+                xm.picked(self, pick, R)            # G15 post: this window's experts into L2 beside the chain's head
+        else:
+            keep = None
+            if plan is not None and plan.cfg.mode == "sub":
+                keep = torch.empty((R, self.gate.shape[0]), dtype=F32, device=x.device)
+            pick, wts = router.route(x, self.gate, self.bias, topk=self.topk, shared=True, scale=self.scale,
+                                     keep=keep)
+            if plan is not None:                    # draft rows inside the segment's expert set; row 1 exact
+                pick, wts = BU.apply(pick, wts, keep, self.bias, plan.meta, self.topk, plan.cfg,
+                                     self.block.ex.count)
+            if xm is not None:
+                xm.picked(self, pick, R)            # G15 post: this window's experts into L2 beside the chain's head
+        if rule is not None:                        # dropped slots: weight 0, an id past the table (never grouped)
+            PR.apply(pick, wts, self.topk, rule, self.scale, self.block.ex.count)
+        if xm is not None:
+            xm.routed(self, x, pick, R)             # G15: record the picks x3ld reads (prev map / trace)
+        if not kit_done:
+            wts = P.kit_weights(wts)                # fp16 weights, as the kit's expert kernels (shared slot: 1.0)
+        self.last_pick = pick
+        if len(blocks) == 1:
+            if grouped:
+                return X.routed(x, pick, wts, self.block, self.scratch, None, R, limit=self.limit, group=False)
+            return X.routed(x, pick, wts, self.block, self.scratch, None, R, limit=self.limit)
+        out = torch.empty((R, x.shape[1]), dtype=F32, device=x.device)
+        for a, b in blocks:
+            X.routed(x[a:b], pick[a:b], wts[a:b], self.block, self.scratch, out[a:b], b - a, limit=self.limit)
+        return out
+
+
+def shared_scratch(blocks: list[GpuMoE], rows: int = 0) -> None:
+    """Bind every block to its geometry's shared scratch now (before any graph capture)."""
+
+    for b in blocks:
+        b.ensure()
