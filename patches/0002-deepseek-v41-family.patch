+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16 4K exactness on the CPU twin (the tiny synthetic checkpoint: every V4.1 mechanism at small sizes): a prompt of
+4,096 + 65 tokens prefilled in 4,096-row segments (4K) against 2,048-row segments (2K), both modes:
+
+- full: the logits of the last prompt token and two reply rows, and the whole slot state (every SWA ring, every kv
+  source's compressed rows and index keys, the ratio-2 carries, the Engram lookback) are bit for bit 2K's;
+- replay (production): the same, the CED stash included (4K with the stash trim, 2K without: the trim is exact);
+- resumed == fresh: a 2K prompt snapshot at 2,048 restored on a 4K forward that prefills the rest (one 2,112-row
+  segment) == the 4K prompt from scratch (sessions saved under 2K resume under 4K: the chunk is not in the tag);
+- a 4K window holding two slots' segments (rounds of 4,096 rows) == each slot alone.
+
+Why it holds (docs/G16-CHUNK4K.md): every kernel computes a row from that row alone, every reduction has a fixed
+order per row (the k chains, the mHC column order, the indexer's per-row selection over the keys visible to the row),
+and a segment's compressed rows / keys are stored before its rows select or attend; segment starts stay even (the
+ratio-2 groups never straddle a boundary through the carry: it is the exact fp32 projection row anyway). The GPU
+paths that switch on window size (streaming top-k, index row blocks, mHC tiles, partial dtypes) are checked in
+``test_dsv41_chunk4k_interp.py`` and tests/cuda/test_dsv41_chunk4k_gpu.py. TF_DSV41_TEST_4K_N: the prompt length.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import replay as RP  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.slots import SlotsForward  # noqa: E402
+
+N = int(os.environ.get("TF_DSV41_TEST_4K_N", "") or 4096 + 65)
+IDS = [int(t) for t in np.random.default_rng(41).integers(3, 256, size=N)]
+LIMIT = N + 256
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41c4k"))
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg)
+
+
+def build(ck, pchunk: int, slots: int = 1) -> SlotsForward:
+    root, cfg, table = ck
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), 0, 1).load(token_map=tmap)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    return SlotsForward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), limit=LIMIT, chunk=4,
+                        pchunk=pchunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap), slots=slots)
+
+
+def state(fw, slot: int = 0) -> dict:
+    s = fw.slots[slot]
+    out = {f"ring.{L}": getattr(r, "values", getattr(r, "data", None)).clone() for L, r in s.swa.items()}
+    for L, st in s.comp.items():
+        n = (s.pos + 1) // next(b.ratio for b in fw.blocks if b.index == L)
+        out[f"comp.{L}"] = st.read(torch.arange(n))
+        out[f"keys.{L}"] = s.ikeys[L].read(torch.arange(n))
+    out.update({f"carry.{L}": c.clone() for L, c in s.carry.items()})
+    out["tail"] = torch.tensor(s.tail)
+    out["pos"] = torch.tensor([s.pos])
+    sh = fw.stash.get(slot)
+    if sh is not None:
+        out.update({"stash.lo": torch.tensor([sh.lo]), "stash.ids": torch.tensor(sh.ids), "stash.x": sh.x,
+                    "stash.out": sh.out, "stash.pre": sh.pre, "stash.post": sh.post, "stash.comb": sh.comb})
+    return out
+
+
+def prompt(fw, mode: str, cuts=(), slot: int = 0):
+    """Prefill IDS[:-1] in pieces ending at ``cuts`` (each piece in ``pchunk`` segments), finish, then the last
+    token and two reply rows: (logits, the state after the prefill)."""
+
+    a = 0
+    for b in [*cuts, N - 1]:
+        fw.prefill([Piece(slot, a, tuple(IDS[a:b]))], mode=mode)
+        a = b
+    fw.finish_prompt(slot, N - 1, tuple(IDS[max(0, N - RP.REPLAY):N - 1]), mode=mode)
+    st = state(fw, slot)
+    logits = torch.cat([fw.step([IDS[-1]], slot=slot), fw.step([11], slot=slot), fw.step([12], slot=slot)])
+    return logits, st
+
+
+def same(a: dict, b: dict) -> None:
+    assert set(a) == set(b)
+    for k in a:
+        assert torch.equal(a[k], b[k]), k
+
+
+@pytest.fixture(scope="module")
+def runs(ck):
+    return {}
+
+
+def _get(runs, ck, key, fn):
+    if key not in runs:
+        runs[key] = fn()
+    return runs[key]
+
+
+@pytest.mark.parametrize("mode", ["full", "replay"])
+def test_4k_equals_2k(ck, runs, mode, monkeypatch):
+    two = _get(runs, ck, ("2k", mode), lambda: prompt(build(ck, 2048), mode))
+    monkeypatch.setenv("TF_DSV41_CED_STASH_TRIM", "1")             # 4K's stash (2K ran without the trim)
+    four = _get(runs, ck, ("4k", mode), lambda: prompt(build(ck, 4096), mode))
+    assert not torch.isnan(four[0]).any()
+    assert torch.equal(four[0], two[0])
+    same(four[1], two[1])
+    if mode == "replay":
+        assert four[1]["stash.x"].untyped_storage().nbytes() == RP.KEEP * four[1]["stash.x"][0].numel() * 2
+
+
+def test_resumed_under_4k_equals_fresh(ck, runs, monkeypatch):
+    """A 2K forward's prompt snapshot at 2,048 (replay: the stash, rings, carries, lookback) restored on a 4K
+    forward, the rest of the prompt one 2,112-row segment: the fresh 4K prompt's logits and state."""
+
+    monkeypatch.setenv("TF_DSV41_CED_STASH_TRIM", "1")
+    fresh = _get(runs, ck, ("4k", "replay"), lambda: prompt(build(ck, 4096), "replay"))
+    two = build(ck, 2048)
+    two.prefill([Piece(0, 0, tuple(IDS[:2048]))], mode="replay")
+    snap = two.snapshot(0)
+    four = build(ck, 4096)
+    four.restore(0, snap)
+    for L, st in two.slots[0].comp.items():                         # the pool pages are the store's: shared
+        four.slots[0].comp[L], four.slots[0].ikeys[L] = st, two.slots[0].ikeys[L]
+    four.prefill([Piece(0, 2048, tuple(IDS[2048:N - 1]))], mode="replay")
+    four.finish_prompt(0, N - 1, tuple(IDS[N - RP.REPLAY:N - 1]), mode="replay")
+    st = state(four)
+    got = torch.cat([four.step([IDS[-1]]), four.step([11]), four.step([12])])
+    assert torch.equal(got, fresh[0])
+    same(st, fresh[1])
+
+
+def test_two_slots_in_one_4k_window_equal_alone(ck):
+    """Rounds of 4,096 rows hold several slots' segments in one window (``slots.prefill_runs``): two 2,048-row
+    pieces in one 4,096-row window == each piece alone in 2,048-row windows."""
+
+    a, b = IDS[:2048], IDS[1000:3048]
+    both = build(ck, 4096, slots=2)
+    both.prefill([Piece(0, 0, tuple(a)), Piece(1, 0, tuple(b))], mode="replay")
+    for slot, ids in ((0, a), (1, b)):
+        alone = build(ck, 2048)
+        alone.prefill([Piece(0, 0, tuple(ids))], mode="replay")
+        sa, sb = state(both, slot), state(alone, 0)
+        same(sa, sb)
