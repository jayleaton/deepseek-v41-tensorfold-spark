+def test_numpy_hugepages_off_by_default():
+    """G12: NumPy's MADV_HUGEPAGE on its >= 4 MiB buffers is off on the ranks (THP faults compacted memory
+    synchronously in long prefills: 150 instead of 1,650 tokens/s); TF_DSV41_NUMPY_HUGEPAGE=1 restores NumPy's
+    default. In a fresh interpreter (an earlier test's madvise can leave a heap range flagged)."""
+
+    import os
+    import subprocess
+    import sys
+
+    if not os.path.exists("/proc/self/smaps"):
+        pytest.skip("no /proc/self/smaps")
+    code = (
+        "import sys; sys.path[:0] = %r\n"
+        "import numpy as np\n"
+        "from tensorfold.families.deepseek_v41.cuda import hostmem\n"
+        "from test_dsv41_long_prefill_memory import _hugepage_flag\n"
+        "on = hostmem.numpy_hugepages()\n"
+        "a = np.ones(48 << 20, dtype=np.uint8)\n"
+        "print(on, _hugepage_flag(a))\n"
+    ) % ([os.path.dirname(__file__)] + sys.path,)
+    env = {k: v for k, v in os.environ.items() if k != "TF_DSV41_NUMPY_HUGEPAGE"}
+    out = subprocess.run([sys.executable, "-c", code], capture_output=True, text=True, env=env, timeout=300)
+    assert out.returncode == 0, out.stderr[-2000:]
+    assert out.stdout.split()[-2:] == ["False", "False"]
+    env["TF_DSV41_NUMPY_HUGEPAGE"] = "1"
+    out = subprocess.run([sys.executable, "-c", code], capture_output=True, text=True, env=env, timeout=300)
+    assert out.returncode == 0 and out.stdout.split()[-2] == "True"
+
