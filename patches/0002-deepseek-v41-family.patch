@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+// Bindings of moe_fused.cu (TF_DSV41_MOE_FUSED; moe_fused.py).
+#include <torch/extension.h>
+#include <c10/cuda/CUDAGuard.h>
+
+void dsv41_mf_route_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, at::Tensor&, at::Tensor&,
+                         at::Tensor&, at::Tensor&, at::Tensor&, int64_t, int64_t, double, bool, bool, bool, int64_t,
+                         int64_t, double, double, at::Tensor&, at::Tensor&, at::Tensor&, const at::Tensor&,
+                         const at::Tensor&, at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t, int64_t, int64_t,
+                         bool);
+void dsv41_mf_combine2_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&, at::Tensor&,
+                            const at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t,
+                            int64_t, int64_t);
+
+static void check(const at::Tensor& t, at::ScalarType dt, const char* name, bool contiguous = true) {
+    TORCH_CHECK(t.is_cuda() && t.scalar_type() == dt && (!contiguous || t.is_contiguous()), name,
+                ": expected a ", contiguous ? "contiguous " : "", "CUDA tensor of the right dtype");
+}
+
+void route(const at::Tensor& X, const at::Tensor& W, const at::Tensor& B, at::Tensor pick, at::Tensor wts,
+           at::Tensor pickr, at::Tensor LG, at::Tensor cnt, int64_t K, int64_t slots, double scale, bool kit,
+           bool prune, bool kept, int64_t min_k, int64_t drop, double min_w, double topp, at::Tensor gid,
+           at::Tensor gcnt, at::Tensor gmem, const at::Tensor& suh_g, const at::Tensor& suh_u, at::Tensor xg,
+           at::Tensor xu, int64_t rt, int64_t nw, int64_t help, int64_t rk, int64_t ge, bool fast) {
+    check(X, at::kBFloat16, "x", false);
+    check(W, at::kBFloat16, "weight");
+    check(B, at::kFloat, "bias");
+    check(pick, at::kInt, "pick");
+    check(wts, at::kFloat, "wts");
+    check(pickr, at::kInt, "pickr");
+    check(LG, at::kFloat, "logits");
+    check(cnt, at::kInt, "counters");
+    check(gid, at::kInt, "group ids");
+    check(gcnt, at::kInt, "group count");
+    check(gmem, at::kInt, "group members");
+    check(suh_g, at::kHalf, "suh_g");
+    check(suh_u, at::kHalf, "suh_u");
+    check(xg, at::kHalf, "xg");
+    check(xu, at::kHalf, "xu");
+    TORCH_CHECK(X.dim() == 2 && W.dim() == 2 && B.numel() == W.size(0), "moe_fused: x [R, D], weight [E, D], bias [E]");
+    c10::cuda::CUDAGuard guard(X.device());
+    dsv41_mf_route_cuda(X, W, B, pick, wts, pickr, LG, cnt, K, slots, scale, kit, prune, kept, min_k, drop, min_w,
+                        topp, gid, gcnt, gmem, suh_g, suh_u, xg, xu, rt, nw, help, rk, ge, fast);
+}
+
+void combine2(const at::Tensor& Z, const at::Tensor& Zs, const at::Tensor& pick, const at::Tensor& svh_d,
+              at::Tensor y, const at::Tensor& wts, at::Tensor out, int64_t rows, int64_t P, int64_t Ps, int64_t D,
+              int64_t SK, int64_t slots, int64_t E, int64_t ks) {
+    check(Z, at::kFloat, "Z");
+    check(Zs, at::kFloat, "Zs");
+    check(pick, at::kInt, "pick");
+    check(svh_d, at::kHalf, "svh_d");
+    check(y, at::kFloat, "y");
+    check(wts, at::kFloat, "wts");
+    check(out, at::kFloat, "out");
+    c10::cuda::CUDAGuard guard(Z.device());
+    dsv41_mf_combine2_cuda(Z, Zs, pick, svh_d, y, wts, out, rows, P, Ps, D, SK, slots, E, ks);
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("route", &route);
+    m.def("combine2", &combine2);
+}
diff --git a/src/tensorfold/families/deepseek_v41/cuda/moe_fused.cu b/src/tensorfold/families/deepseek_v41/cuda/moe_fused.cu
new file mode 100644
index 0000000..aa85af7
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/moe_fused.cu
@@ -0,0 +1,608 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+// The decode MoE chain's head in one launch (TF_DSV41_MOE_FUSED; moe_fused.py has the design, the cost model and the
+// exactness argument): router logits + selection + pruning + the kit's fp16 weights + grouping + the routed pairs'
+// input rotation, and the combine of a routed launch with the shared expert's own (side-stream) launch.
+//
+// fused_kernel<RT, NW> (rows <= 16, one row tile): grid.x = E / NW producer CTAs, a warp an expert.
+//   1. logits: router_gemv.cu's narrow_kernel main loop, statement for statement (lane l: one fp32 FMA chain from
+//      +0.0 over k = 8 (l + 32 j) + i, then the xor butterfly): the same bits as gemv_kernel / narrow_kernel.
+//   2. the last CTA to arrive selects each row (router_gemv.cu's select_row: the same top-K, weights
+//      scale * (s_i / total)), then on lane 0 prunes (prune.py's _prune, operation for operation: fp32 sequential
+//      sums, div.rn, the rank / exclusive-mass rule, RENORM orig | kept, dropped slots -> id `drop`, weight 0) and
+//      rounds the weights to fp16 (pick.kit_weights: RN to fp16 and back). The shared slot: id E, weight 1.0, and
+//      -1 in `pickr` (the routed-only picks the routed epilogue reads). Then upstream's grouping of the routed ids
+//      (router_gemv.cu's group_rows: ids < E in id order, members row * 32 + slot in row order).
+//   3. rot_in of every routed pair: upstream's rot_in_kernel arithmetic per (pair, 128-block, matrix), transcribed
+//      with the contraction its sm_121 SASS has (the first butterfly stage is 2 FMUL + 4 FFMA; the compile test
+//      checks upstream's SASS still has that shape). Either way the bits agree: a bf16 x fp16 product has <= 19
+//      significant bits, exact in fp32, so fusing it into the add rounds once either way (normal-range products).
+//      Tasks (row, 128-block) are claimed by warps through a counter:
+//      the selecting CTA and the CTAs that arrived among the last `help` (each waits on the selection's flag).
+//      Waiting is deadlock-free: at most help <= SMs - 1 CTAs wait, every SM holds at least one CTA of this kernel,
+//      and producers never wait, so the remaining producers always find a slot. Which warp takes a task never
+//      changes a bit (each task's outputs are its own).
+//   4. counters [arrive, go, next, fin] are reset by the last CTA to finish (fin): a graph replay starts from 0.
+//
+// combine2_kernel: upstream's down_combine_kernel, statement for statement, except that the shared slot's split
+// partials come from the shared branch's compact Z (row r at r, not r * slots + K).
+//
+// G14 variants (moe_fused.py: TF_DSV41_MOE_FUSED_SHARED, TF_DSV41_MOE_FUSED_TAIL; every one the same bits):
+//   - rk / ge (runtime): the pairs a row's rot_in serves (slots k < rk) and the table bound of the grouping and of
+//     rot_in (ids < ge). b1: rk = K, ge = E (routed only; the shared expert on its own launches). SHARED=inline:
+//     rk = slots, ge = E + 1: the grouping and the rotated inputs of the whole table, i.e. exactly what upstream's
+//     group_kernel + rot_in_kernel give the production path (pruned slots carry id E + 1 = ge: skipped by both).
+//   - FAST (template, TAIL=fast): (a) the selection's per-round argmax across lanes by two redux.sync (max of an
+//     order-preserving key, then min of the ids holding it) instead of the 5-step, 10-shuffle butterfly: the same
+//     (score desc, id asc) winner, so the same picks (argmax_fast has the argument); (b) rot_in tasks assigned
+//     statically by arrival rank (no claim atomics); (c) a warp loads its first task's x words (and, with rk > K,
+//     prefetches the shared expert's suh into L2) before waiting on the selection.
+#define DSV41_RG_NO_TORCH
+#include "router_gemv.cu"
+#include <cuda_bf16.h>
+
+namespace dsv41_mf {
+
+using dsv41_rg::cp_async16;
+using dsv41_rg::cp_commit;
+using dsv41_rg::cp_wait_n;
+using dsv41_rg::D;
+using dsv41_rg::EPL;
+using dsv41_rg::GROUP_INTS;
+using dsv41_rg::KMAX;
+using dsv41_rg::ldg_keep;
+using dsv41_rg::NV;
+using dsv41_rg::softplus;
+using dsv41_rg::TAIL_INTS;
+using dsv41_rg::widen8;
+
+constexpr int NB = D / 128;                         // Hadamard blocks of 128 along the model width
+constexpr float HAD_SCALE = 0.08838834764831845f;   // upstream's 1 / sqrt(128)
+constexpr unsigned FULL = 0xffffffffu;
+
+struct Args {
+    const uint16_t* x;      // [R, xs] bf16, rows 16-byte aligned
+    long long xs;
+    const uint16_t* w;      // [E, D] bf16 gate
+    const float* bias;      // [E]
+    int* pick;              // [R, slots]
+    float* wts;             // [R, slots]
+    int* pickr;             // [R, slots]: pick with the shared slot -1 (the routed epilogue's)
+    float* lg;              // [R, E] fp32
+    int* cnt;               // [4] int32: arrive, go, next, fin (0 between launches)
+    int R, E, K, slots, kit;
+    float scale;
+    int prune, kept, min_k, drop;
+    float min_w, topp;
+    int* gid;               // routed grouping: ids, count, members [., maxm]
+    int* gcnt;
+    int* gmem;
+    int maxm;
+    const __half* suh_g;    // [E + shared, D]
+    const __half* suh_u;
+    __half* xg;             // [R * slots, D]
+    __half* xu;
+    int nprod, help;
+    int rk, ge;             // rot_in serves slots k < rk with ids < ge; the grouping takes ids < ge (see the header)
+};
+
+// prune.py's _prune on one row's K routed slots, in registers (lane 0), then the kit rounding; w: the router's fp32
+// weights in slot order, p: the picks.
+__device__ __forceinline__ void prune_row(const Args& a, float (&w)[KMAX], int (&p)[KMAX]) {
+    const int K = a.K;
+    float total = 0.0f;
+#pragma unroll
+    for (int i = 0; i < KMAX; ++i)
+        if (i < K) total = __fadd_rn(total, w[i]);
+    float f[KMAX];
+#pragma unroll
+    for (int i = 0; i < KMAX; ++i) f[i] = i < K ? __fdiv_rn(w[i], total) : 0.0f;
+    int rank[KMAX];
+#pragma unroll
+    for (int i = 0; i < KMAX; ++i) {
+        int c = 0;
+#pragma unroll
+        for (int j = 0; j < KMAX; ++j)
+            if (j < K) c += (f[j] > f[i]) || (f[j] == f[i] && j < i);
+        rank[i] = c;
+    }
+    float excl[KMAX], acc = 0.0f;
+#pragma unroll
+    for (int i = 0; i < KMAX; ++i) excl[i] = 0.0f;
+#pragma unroll
+    for (int r = 0; r < KMAX; ++r) {
+        if (r >= K) break;
+        float fr = 0.0f;
+#pragma unroll
+        for (int i = 0; i < KMAX; ++i)
+            if (i < K && rank[i] == r) { excl[i] = acc; fr = f[i]; }
+        acc = __fadd_rn(acc, fr);
+    }
+    bool keep[KMAX];
+    int nkeep = 0;
+#pragma unroll
+    for (int i = 0; i < KMAX; ++i) {
+        keep[i] = i < K && (((excl[i] < a.topp) && (f[i] >= a.min_w)) || (rank[i] < a.min_k));
+        nkeep += keep[i];
+    }
+    if (nkeep >= K) return;                         // every slot kept: the router's row, untouched
+    float ks = 0.0f;
+#pragma unroll
+    for (int i = 0; i < KMAX; ++i)
+        if (i < K) ks = __fadd_rn(ks, keep[i] ? w[i] : 0.0f);
+#pragma unroll
+    for (int i = 0; i < KMAX; ++i) {
+        if (i >= K) break;
+        w[i] = keep[i] ? (a.kept ? __fmul_rn(a.scale, __fdiv_rn(w[i], ks)) : w[i]) : 0.0f;
+        p[i] = keep[i] ? p[i] : a.drop;
+    }
+}
+
+// An order-preserving key of a non-NaN fp32 score (-0 and +0 equal, as the shuffle butterfly's == has them); a lane
+// without a candidate passes 0, below every candidate (a candidate is > -inf, so its key is > key(-inf) = 0x7fffff).
+__device__ __forceinline__ unsigned okey(float v) {
+    const unsigned u = __float_as_uint(v == 0.0f ? 0.0f : v);
+    return (u & 0x80000000u) ? ~u : (u | 0x80000000u);
+}
+
+// One round's winner, FAST: the lane's best as select_row scans it (strict >, so the lower id on a tie; NaN and -inf
+// are never candidates), then the warp's best key and the lowest id holding it, by two redux.sync. The butterfly
+// picks the lexicographic max of (score, -id) over the lanes' bests; so does this. With no candidate anywhere every
+// key is 0 and the id 0x7fffffff, as the butterfly leaves it.
+__device__ __forceinline__ int argmax_fast(const float (&ch)[EPL], int lane) {
+    float bv = -INFINITY;
+    int bi = 0x7fffffff;
+#pragma unroll
+    for (int i = 0; i < EPL; ++i)
+        if (ch[i] > bv) { bv = ch[i]; bi = lane + 32 * i; }
+    const unsigned key = bi == 0x7fffffff ? 0u : okey(bv);
+    const unsigned top = __reduce_max_sync(FULL, key);
+    return __reduce_min_sync(FULL, key == top ? bi : 0x7fffffff);
+}
+
+// router_gemv.cu's select_row (the same top-K and weights), then prune + kit on lane 0 and the three pick layouts.
+template <bool FAST>
+__device__ __forceinline__ void select_row(const Args& a, int r, int* psh, int lane) {
+    const float* lg = a.lg + (size_t)r * a.E;
+    const int E = a.E, K = a.K;
+    float s[EPL], ch[EPL];
+#pragma unroll
+    for (int i = 0; i < EPL; ++i) {
+        const int e = lane + 32 * i;
+        if (e < E) {
+            s[i] = __fsqrt_rn(softplus(__ldcg(lg + e)));
+            ch[i] = __fadd_rn(s[i], a.bias[e]);
+        } else {
+            s[i] = 0.0f;
+            ch[i] = -INFINITY;
+        }
+    }
+    float sp[KMAX];
+    int ip[KMAX];
+    float total = 0.0f;
+#pragma unroll
+    for (int t = 0; t < KMAX; ++t) {
+        if (t >= K) break;
+        int bi;
+        if constexpr (FAST) {
+            bi = argmax_fast(ch, lane);
+        } else {
+            float bv = -INFINITY;
+            bi = 0x7fffffff;
+#pragma unroll
+            for (int i = 0; i < EPL; ++i)
+                if (ch[i] > bv) { bv = ch[i]; bi = lane + 32 * i; }
+#pragma unroll
+            for (int o = 16; o > 0; o >>= 1) {
+                const float ov = __shfl_xor_sync(FULL, bv, o);
+                const int oi = __shfl_xor_sync(FULL, bi, o);
+                if (ov > bv || (ov == bv && oi < bi)) { bv = ov; bi = oi; }
+            }
+        }
+        float mine = 0.0f;
+#pragma unroll
+        for (int i = 0; i < EPL; ++i)
+            if (lane + 32 * i == bi) { mine = s[i]; ch[i] = -INFINITY; }
+        sp[t] = __shfl_sync(FULL, mine, bi & 31);
+        ip[t] = bi;
+        total = __fadd_rn(total, sp[t]);
+    }
+    if (lane != 0) return;
+    float w[KMAX];
+    int p[KMAX];
+#pragma unroll
+    for (int t = 0; t < KMAX; ++t) {
+        w[t] = t < K ? __fmul_rn(a.scale, __fdiv_rn(sp[t], total)) : 0.0f;
+        p[t] = t < K ? ip[t] : 0;
+    }
+    if (a.prune) prune_row(a, w, p);
+    const size_t o = (size_t)r * a.slots;
+#pragma unroll
+    for (int t = 0; t < KMAX; ++t) {
+        if (t >= K) break;
+        const float v = a.kit ? __half2float(__float2half_rn(w[t])) : w[t];
+        a.pick[o + t] = p[t];
+        a.pickr[o + t] = p[t];
+        a.wts[o + t] = v;
+        psh[r * a.slots + t] = p[t];
+    }
+    if (a.slots > K) {
+        a.pick[o + K] = E;
+        a.pickr[o + K] = -1;
+        a.wts[o + K] = 1.0f;                        // kit_weights(1.0) == 1.0
+        psh[r * a.slots + K] = E;
+    }
+}
+
+// Walsh-Hadamard butterflies across lanes (strides 4..64), upstream's fwht128 after its in-register stage.
+__device__ __forceinline__ void fwht_lanes(float (&v)[4], int lane) {
+#pragma unroll
+    for (int m = 1; m < 32; m <<= 1) {
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            const float o = __shfl_xor_sync(FULL, v[j], m);
+            v[j] = (lane & m) ? __fsub_rn(o, v[j]) : __fadd_rn(v[j], o);
+        }
+    }
+}
+
+__device__ __forceinline__ void fwht128(float (&v)[4], int lane) {
+    const float a = __fadd_rn(v[0], v[1]), b = __fsub_rn(v[0], v[1]);
+    const float c = __fadd_rn(v[2], v[3]), d = __fsub_rn(v[2], v[3]);
+    v[0] = __fadd_rn(a, c); v[1] = __fadd_rn(b, d); v[2] = __fsub_rn(a, c); v[3] = __fsub_rn(b, d);
+    fwht_lanes(v, lane);
+}
+
+// upstream's rot_in for one (pair, block, matrix): v = x * suh, fwht128, * 1/sqrt(128), fp16 -- with the first
+// stage contracted as nvcc does it for rot_in_kernel (x1 s1 and x3 s3 rounded, x0 s0 / x2 s2 fused into the add/sub)
+__device__ __forceinline__ void rot4(const float (&x)[4], uint2 sraw, __half* out, int lane) {
+    const __half2 s01 = *reinterpret_cast<const __half2*>(&sraw.x), s23 = *reinterpret_cast<const __half2*>(&sraw.y);
+    const float s0 = __low2float(s01), s1 = __high2float(s01), s2 = __low2float(s23), s3 = __high2float(s23);
+    const float p1 = __fmul_rn(x[1], s1), p3 = __fmul_rn(x[3], s3);
+    const float a = __fmaf_rn(x[0], s0, p1), b = __fmaf_rn(x[0], s0, -p1);
+    const float c = __fmaf_rn(x[2], s2, p3), d = __fmaf_rn(x[2], s2, -p3);
+    float v[4] = {__fadd_rn(a, c), __fadd_rn(b, d), __fsub_rn(a, c), __fsub_rn(b, d)};
+    fwht_lanes(v, lane);
+    const __half2 o01 = __halves2half2(__float2half_rn(__fmul_rn(v[0], HAD_SCALE)),
+                                       __float2half_rn(__fmul_rn(v[1], HAD_SCALE)));
+    const __half2 o23 = __halves2half2(__float2half_rn(__fmul_rn(v[2], HAD_SCALE)),
+                                       __float2half_rn(__fmul_rn(v[3], HAD_SCALE)));
+    uint2 ov;
+    ov.x = *reinterpret_cast<const unsigned*>(&o01);
+    ov.y = *reinterpret_cast<const unsigned*>(&o23);
+    *reinterpret_cast<uint2*>(out) = ov;
+}
+
+constexpr int KS = KMAX + 1;                        // slots a row at most (top-k + the shared expert)
+
+// One task t = (row, 128-block): every served pair of the row (slots k < rk, ids < ge), gate and up; xr: the row's
+// x words at the block (already loaded).
+__device__ __forceinline__ void rot_task(const Args& a, int t, uint2 xr, int lane) {
+    const int r = t / NB, blk = t % NB, col = blk * 128 + 4 * lane;
+    const float x[4] = {__uint_as_float(xr.x << 16), __uint_as_float(xr.x & 0xffff0000u),
+                        __uint_as_float(xr.y << 16), __uint_as_float(xr.y & 0xffff0000u)};
+    const int mine = lane < a.rk ? __ldcg(a.pick + (size_t)r * a.slots + lane) : -1;
+    int e[KS];
+    uint2 sg[KS], su[KS];
+#pragma unroll
+    for (int k = 0; k < KS; ++k) {                  // every suh vector of the row's pairs in flight at once
+        e[k] = __shfl_sync(FULL, mine, k);
+        if (k < a.rk && e[k] >= 0 && e[k] < a.ge) {
+            sg[k] = __ldg(reinterpret_cast<const uint2*>(a.suh_g + (size_t)e[k] * D + col));
+            su[k] = __ldg(reinterpret_cast<const uint2*>(a.suh_u + (size_t)e[k] * D + col));
+        }
+    }
+#pragma unroll
+    for (int k = 0; k < KS; ++k) {
+        if (k >= a.rk || e[k] < 0 || e[k] >= a.ge) continue;       // warp-uniform
+        const size_t p = (size_t)r * a.slots + k;
+        rot4(x, sg[k], a.xg + p * D + col, lane);
+        rot4(x, su[k], a.xu + p * D + col, lane);
+    }
+}
+
+__device__ __forceinline__ uint2 x_words(const Args& a, int t, int lane) {
+    const int r = t / NB, col = (t % NB) * 128 + 4 * lane;
+    return __ldg(reinterpret_cast<const uint2*>(a.x + (size_t)r * a.xs + col));
+}
+
+// b1: a warp claims tasks through the counter until none is left.
+__device__ __forceinline__ void rot_tasks(const Args& a, int lane) {
+    const int ntask = a.R * NB;
+    for (;;) {
+        int t = 0;
+        if (lane == 0) t = atomicAdd(a.cnt + 2, 1);
+        t = __shfl_sync(FULL, t, 0);
+        if (t >= ntask) return;
+        rot_task(a, t, x_words(a, t, lane), lane);
+    }
+}
+
+// FAST: global warp gw of nwarps takes tasks gw, gw + nwarps, ... (gw from the CTA's arrival rank: unique, so every
+// task once); x0 holds task gw's x words, loaded before the wait; each next task's x is in flight during the current.
+__device__ __forceinline__ void rot_static(const Args& a, int gw, int nwarps, uint2 x0, int lane) {
+    const int ntask = a.R * NB;
+    uint2 xr = x0;
+    for (int t = gw; t < ntask; t += nwarps) {
+        const uint2 xn = t + nwarps < ntask ? x_words(a, t + nwarps, lane) : make_uint2(0u, 0u);  // the next task's
+        rot_task(a, t, xr, lane);
+        xr = xn;
+    }
+}
+
+template <int RT, int NW, bool FAST>
+__global__ void __launch_bounds__(NW * 32) fused_kernel(const Args a) {
+    constexpr int PD = NW <= 4 && RT <= 4 ? NV : NV / 2;       // narrow_kernel's
+    constexpr int XP = RT <= 4 ? 2 : 0;
+    constexpr int TS = (GROUP_INTS * 4 + NW * 512 - 1) / (NW * 512);
+    __shared__ __align__(16) uint4 wsh[NW][PD > TS ? PD : TS][32];
+    __shared__ int role_sh, rank_sh;
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    const int nr = min(RT, a.R);
+    const int e = blockIdx.x * NW + warp;
+    const bool live = e < a.E;
+    const uint16_t* wrow = a.w + (size_t)(live ? e : 0) * D + (size_t)lane * 8;
+
+    // ---- 1. logits: narrow_kernel's main loop (r0 = 0: one row tile) ----
+    auto wload = [&](int j) {
+        if (live) cp_async16(&wsh[warp][j % PD][lane], wrow + (size_t)j * 256);
+        cp_commit();
+    };
+    auto xload = [&](int j, uint4 (&dst)[RT]) {
+#pragma unroll
+        for (int r = 0; r < RT; ++r)
+            dst[r] = (live && r < nr) ? ldg_keep(a.x + (size_t)r * a.xs + (size_t)(j * 32 + lane) * 8)
+                                      : make_uint4(0u, 0u, 0u, 0u);
+    };
+#pragma unroll
+    for (int j = 0; j < PD; ++j) wload(j);
+    uint4 xr[XP > 0 ? XP : 1][RT];
+#pragma unroll
+    for (int j = 0; j < XP; ++j) xload(j, xr[j]);
+    float acc[RT];
+#pragma unroll
+    for (int r = 0; r < RT; ++r) acc[r] = 0.0f;
+#pragma unroll
+    for (int j = 0; j < NV; ++j) {
+        cp_wait_n(min(NV - j - 1, PD - 1));
+        float wf[8];
+        widen8(wsh[warp][j % PD][lane], wf);
+        uint4 xc[RT];
+        if constexpr (XP == 0) {
+            xload(j, xc);
+        } else {
+#pragma unroll
+            for (int r = 0; r < RT; ++r) xc[r] = xr[j % XP][r];
+            if (j + XP < NV) xload(j + XP, xr[j % XP]);
+        }
+#pragma unroll
+        for (int r = 0; r < RT; ++r) {
+            float xf[8];
+            widen8(xc[r], xf);
+#pragma unroll
+            for (int i = 0; i < 8; ++i) acc[r] = __fmaf_rn(xf[i], wf[i], acc[r]);
+        }
+        if (j + PD < NV) wload(j + PD);
+    }
+#pragma unroll
+    for (int r = 0; r < RT; ++r) {
+        float v = acc[r];
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) v = __fadd_rn(v, __shfl_xor_sync(FULL, v, o));
+        if (lane == r && r < nr && live) a.lg[(size_t)r * a.E + e] = v;
+    }
+
+    // ---- arrival: the last CTA selects; the `help` before it wait for the selection and share rot_in ----
+    int* sh = reinterpret_cast<int*>(&wsh[0][0][0]);
+    __threadfence();
+    __syncthreads();                                 // every thread is past the main loop's shared memory
+    if (tid == 0) {
+        const int old = atomicAdd(a.cnt + 0, 1);
+        role_sh = old == a.nprod - 1 ? 2 : (old >= a.nprod - 1 - a.help ? 1 : 0);
+        rank_sh = old - (a.nprod - 1 - a.help);     // FAST: helpers 0 .. help - 1, the selecting CTA help
+    }
+    __syncthreads();
+    const int role = role_sh;
+    const int gw = rank_sh * NW + warp, nwarps = (a.help + 1) * NW;
+    uint2 x0 = make_uint2(0u, 0u);
+    if constexpr (FAST) {                            // before any wait: the first task's x (no dependence on routing)
+        if (role != 0 && gw < a.R * NB) {
+            x0 = x_words(a, gw, lane);
+            if (a.rk > a.K) {                       // the shared expert's suh words into L2: its id (E) is known
+                const size_t o = (size_t)a.E * D + (gw % NB) * 128 + 4 * lane;
+                asm volatile("prefetch.global.L2 [%0];" ::"l"(a.suh_g + o));
+                asm volatile("prefetch.global.L2 [%0];" ::"l"(a.suh_u + o));
+            }
+        }
+    }
+    if (role == 2) {
+        __threadfence();
+        for (int r = warp; r < nr; r += NW) select_row<FAST>(a, r, sh, lane);
+        __syncthreads();
+        dsv41_rg::Args g;                            // upstream's grouping of the routed ids (< E)
+        g.R = a.R; g.slots = a.slots; g.GE = a.ge; g.gid = a.gid; g.gcnt = a.gcnt; g.gmem = a.gmem; g.maxm = a.maxm;
+        dsv41_rg::group_rows<NW>(g, sh, sh + TAIL_INTS, tid);
+        __threadfence();
+        __syncthreads();
+        if (tid == 0) atomicExch(a.cnt + 1, 1);     // go: picks, weights and groups are out
+        if constexpr (!FAST) rot_tasks(a, lane);
+    } else if (role == 1) {
+        if (tid == 0) {
+            while (*reinterpret_cast<volatile int*>(a.cnt + 1) == 0) __nanosleep(64);
+            __threadfence();
+        }
+        __syncthreads();
+        if constexpr (!FAST) rot_tasks(a, lane);
+    }
+    if constexpr (FAST) {                            // one call site (two inlined copies spilled at RT 8 / NW 8)
+        if (role != 0) rot_static(a, gw, nwarps, x0, lane);
+    }
+    __syncthreads();
+    if (tid == 0) {
+        __threadfence();
+        if (atomicAdd(a.cnt + 3, 1) == a.nprod - 1) {   // the last CTA out: nobody touches the counters again
+            a.cnt[0] = 0;
+            a.cnt[1] = 0;
+            a.cnt[2] = 0;
+            a.cnt[3] = 0;
+        }
+    }
+}
+
+// upstream's down_combine_kernel with the shared slot `ks`'s partials from Zs (compact: row r, Ps rows a split)
+__global__ void combine2_kernel(const float* __restrict__ Z, const float* __restrict__ Zs, const int* __restrict__ pick,
+                                const __half* __restrict__ svh_d, float* __restrict__ y, const float* __restrict__ wts,
+                                float* __restrict__ out, int P, int Ps, int Dm, int SK, int E, int slots, int ks) {
+    __shared__ float4 part[32][32];
+    const int r = blockIdx.x, blk = blockIdx.y;
+    const int k = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int n = blk * 128 + 4 * lane;
+    const int p = r * slots + k;
+    const int e = pick[p];
+    float o[4];
+    if (e >= 0 && e < E) {
+        const bool sh = k == ks;
+        const float* zb = sh ? Zs + (size_t)r * Dm : Z + (size_t)p * Dm;
+        const size_t qs = sh ? (size_t)Ps * Dm : (size_t)P * Dm;
+        float v[4];
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            float s = 0.0f;
+            for (int q = 0; q < SK; ++q) s = __fadd_rn(s, zb[q * qs + n + j]);
+            v[j] = s;
+        }
+        fwht128(v, lane);
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            o[j] = __fmul_rn(__fmul_rn(v[j], HAD_SCALE), __half2float(svh_d[(size_t)e * Dm + n + j]));
+            y[(size_t)p * Dm + n + j] = o[j];
+        }
+    } else {
+#pragma unroll
+        for (int j = 0; j < 4; ++j) o[j] = y[(size_t)p * Dm + n + j];
+    }
+    part[k][lane] = make_float4(o[0], o[1], o[2], o[3]);
+    __syncthreads();
+    if (k != 0) return;
+    float acc[4] = {0.f, 0.f, 0.f, 0.f};
+    for (int q = 0; q < slots; ++q) {
+        const float w = wts[r * slots + q];
+        const float4 u = part[q][lane];
+        acc[0] = __fmaf_rn(w, u.x, acc[0]);
+        acc[1] = __fmaf_rn(w, u.y, acc[1]);
+        acc[2] = __fmaf_rn(w, u.z, acc[2]);
+        acc[3] = __fmaf_rn(w, u.w, acc[3]);
+    }
+#pragma unroll
+    for (int j = 0; j < 4; ++j) out[(size_t)r * Dm + n + j] = acc[j];
+}
+
+template <int RT, int NW, bool FAST>
+cudaError_t launch(const Args& a, cudaStream_t stream) {
+    static const bool carved = [] {
+        cudaFuncSetAttribute(fused_kernel<RT, NW, FAST>, cudaFuncAttributePreferredSharedMemoryCarveout,
+                             (int)cudaSharedmemCarveoutMaxShared);
+        (void)cudaGetLastError();
+        return true;
+    }();
+    (void)carved;
+    fused_kernel<RT, NW, FAST><<<dim3((unsigned)a.nprod), NW * 32, 0, stream>>>(a);
+    return cudaGetLastError();
+}
+
+template <int NW, bool FAST>
+cudaError_t by_rt(const Args& a, int rt, cudaStream_t stream) {
+    switch (rt) {
+    case 1: return launch<1, NW, FAST>(a, stream);
+    case 2: return launch<2, NW, FAST>(a, stream);
+    case 4: return launch<4, NW, FAST>(a, stream);
+    case 8: return launch<8, NW, FAST>(a, stream);
+    case 16: return launch<16, NW, FAST>(a, stream);
+    default: return cudaErrorInvalidValue;
+    }
+}
+
+template <bool FAST>
+cudaError_t by_nw(const Args& a, int rt, int nw, cudaStream_t stream) {
+    switch (nw) {
+    case 1: return by_rt<1, FAST>(a, rt, stream);
+    case 2: return by_rt<2, FAST>(a, rt, stream);
+    case 4: return by_rt<4, FAST>(a, rt, stream);
+    case 8: return by_rt<8, FAST>(a, rt, stream);
+    default: return cudaErrorInvalidValue;
+    }
+}
+
+inline cudaError_t dispatch(const Args& a, int rt, int nw, bool fast, cudaStream_t stream) {
+    return fast ? by_nw<true>(a, rt, nw, stream) : by_nw<false>(a, rt, nw, stream);
+}
