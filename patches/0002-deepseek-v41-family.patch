+    b0 = Batcher(f0, _Pool(), link=QueueLink(q), rank=0, **kw)
+    b1 = Batcher(f1, _Pool(), link=QueueLink(q), rank=1, **kw)
+    for r, b in ((0, b0), (1, b1)):
+        b.ex.trim = hostmem.Trimmer(every=32768, trim_fn=lambda full, r=r: trims.append((r, full)) or 0.0,
+                                    idle_s=0, busy_mib=0, background=False)   # long-prefill trims only, in line
+    errors: list[BaseException] = []
+
+    def follow():
+        try:
+            b1.follow()
+        except BaseException as exc:            # noqa: BLE001
+            errors.append(exc)
+
+    th = threading.Thread(target=follow, daemon=True)
