+    out = subprocess.run([_nvcc(), "-std=c++17", "-O3", "--expt-relaxed-constexpr", f"-I{HERE}",
+                          f"-I{Path(upstream.__file__).parent}", "-gencode=arch=compute_121,code=sm_121", "-Xptxas",
+                          "-v", "-cubin", str(cu), "-o", str(cubin)], capture_output=True, text=True, timeout=1800,
+                         check=False)
+    assert out.returncode == 0, out.stderr[-3000:]
+    blocks = re.split(r"ptxas info\s*: Compiling entry function '", out.stderr)[1:]
+    mains, rows = 0, []
+    for blk in blocks:
+        name = blk.split("'", 1)[0]
+        regs = int(re.search(r"Used (\d+) registers", blk).group(1))
+        st, ss, sl = (int(v) for v in re.search(r"(\d+) bytes stack frame, (\d+) bytes spill stores, (\d+) bytes "
+                                                 r"spill loads", blk).groups())
+        assert (st, ss, sl) == (0, 0, 0), (name, st, ss, sl)
+        m = KNAME.search(name)
+        if m is None:
+            assert "dequant" in name
+            continue
+        mains += 1
+        kk, ln, bm, wm, wn, ks, nst = (int(v) for v in m.groups())
+        cfg = next(c for c, v in E.CFGS.items() if v == (bm, wm, wn, ks, nst))
+        geo = E.Geo(cfg, kk, bool(ln))
+        cap = min(255, (65536 // (geo.THREADS * geo.MINB)) // 8 * 8)
+        assert regs <= cap, (name, regs, cap)
+        rows.append(f"{'L' if ln else 'S'}{cfg}:{regs}")
+    assert mains == len(E.CFGS) * (1 if k2 == 16 else 2)
+    print(f"[G16D] pfdense K2 {k2} sm_121: {mains} kernels, 0 spills / stack; registers " + " ".join(rows))
