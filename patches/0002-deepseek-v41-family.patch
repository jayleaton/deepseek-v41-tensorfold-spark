+@pytest.mark.parametrize("grid", [(6, 9), (7, 5), (3, 3), (1, 4)])
+def test_tower_matches_reference(ref_vit, grid):
+    tower, vit, al = small_tower(ref_vit)
+    vh, vw = grid
+    patches = torch.randn(vh * vw, 3, 14, 14)
+    with torch.no_grad():
+        want = al(vit(patches, vh, vw), vh, vw)
+    got = tower.align(tower.vit(patches, vh, vw), vh, vw)
+    assert got.shape == want.shape == (-(-vh // 3) * -(-vw // 3), 128)
+    assert torch.allclose(got, want, atol=1e-5, rtol=1e-5)
+
