+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G13 ``branches``: the attention sublayer's indexer / compressor chains on a side stream (``branches.py``,
+TF_DSV41_BRANCHES) on the GPU. Only the launch order and the overlap change, so everything here is bit for bit:
+
+- the fused q group (wq_b + the indexer's wq_b, one x3seg launch) == its two matrices as 1-segment launches, eager
+  and captured on two streams forked / joined in one graph, R 1..16; the counters return to zero;
+- e4's folded copies: ``_plain`` storing bf16 == float64 ``.to(fp32).to(bf16)``; ratio-2 pooling with the carry
+  through its own pointer on bf16 rows == the concatenated fp32 buffer (one slot and row mode);
+- the engine (the synthetic checkpoint, 4 slots on a KV pool): row graphs with branches on, replayed, == the eager
+  forward with branches off (logits, pending projection rows, kept carries), across context buckets and every row
+  bucket; the captured graph really forks (DOT dump: more fan-out nodes than the off graph);
+- batched == alone with branches on: a window of two slots gives each slot's rows the bits of that slot's window run
+  alone (row graphs on both).
+
+G14 (the unstable G13 1-row window; branches.py's G14 notes):
+- every mode (side stream at each TF_DSV41_BRANCHES_PRIO, and ``serial``: e4 alone) replayed == off eager, bit for bit;
+- the row graphs capture on the driver's main stream with the requested priorities, no fork is left open after
+  warm-up, replays and eager windows, and two engines built alike capture the same 1-row graph (nodes, edges,
+  fan-out / fan-in: the capture is deterministic);
+- [G14] lines: the streams' priorities, the device's priority range, whether the DOT dump carries node priorities.
+"""
+
+from __future__ import annotations
+
+import re
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available() or torch.cuda.get_device_capability()[0] < 9:
+    pytest.skip("needs an sm_90+ NVIDIA GPU", allow_module_level=True)
+
+import dsv41_dspark_fakes as DF  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import fused_proj as FP  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import plain_fp64 as PF  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import rowgraphs as RG  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import rowmode  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import rowtab as RT  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import compress  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.forward import Seg  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece  # noqa: E402
+
+BF, F32 = torch.bfloat16, torch.float32
+DEV = "cuda"
+LONG = 4096
+PROMPTS = [[int(t) for t in np.random.default_rng(90 + i).integers(3, 250, size=2040 + 5 * i)] for i in range(4)]
+SETTINGS = {"on": True, "budget_s": 300.0, "max_graphs": 128, "bucket": 2048, "slots": 4, "warm": "decode",
+            "floor_gib": 0.0}
+
+
+@pytest.fixture(autouse=True)
+def _knobs(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")       # the mHC / Engram kernels are laid out for D = 5,120
+    for k in ("TF_DSV41_BRANCHES", "TF_DSV41_BRANCHES_ROWS", "TF_DSV41_BRANCHES_PRIO", "TF_DSV41_PDL", "TF_DSV41_L2PF"):
+        monkeypatch.delenv(k, raising=False)
+
+
+def _bits(t):
+    return t.reshape(-1).contiguous().view(torch.uint8)
+
+
+def _lin(k: int, n: int, bits: int, seed: int):
+    from tensorfold.cuda.exl3.linear import Exl3Linear
+
+    g = torch.Generator().manual_seed(seed)
+    tr = torch.randint(-32768, 32767, (k // 16, n // 16, 16 * bits), generator=g, dtype=torch.int32).to(torch.int16)
+    suh = torch.where(torch.rand(k, generator=g) < 0.5, -1.0, 1.0).to(torch.float16)
+    svh = (torch.rand(n, generator=g) * 0.02 + 0.01).to(torch.float16)
+    return Exl3Linear.from_tensors(tr, suh, svh, "mul1", device="cuda")
+
+
+def test_split_q_equals_the_fused_group():
+    a, b = _lin(1280, 16384, 5, 3), _lin(1280, 4096, 5, 4)
+    group, fa, fb = FP.Fused([a, b]), FP.Fused([a]), FP.Fused([b])
+    side = torch.cuda.Stream()
+    gen = torch.Generator(device="cuda").manual_seed(1)
+    for R in range(1, 17):
+        x = torch.randn((R, 1280), generator=gen, device="cuda").to(BF)
+        want = group(x, BF)
+        assert torch.equal(fa(x, BF)[0], want[0]) and torch.equal(fb(x, BF)[0], want[1]), R
+        out = {}
+
+        def branched(x=x, out=out):
+            side.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(side):
+                out["qi"] = fb(x, BF)[0]
+            out["q"] = fa(x, BF)[0]
+            torch.cuda.current_stream().wait_stream(side)
+
+        branched()                                  # eager on two streams
+        assert torch.equal(out["q"], want[0]) and torch.equal(out["qi"], want[1]), R
+        g = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(g):
+            branched()
+        for _ in range(3):
+            x.copy_(torch.randn((R, 1280), generator=gen, device="cuda").to(BF))
+            ref = group(x, BF)
+            g.replay()
+            torch.cuda.synchronize()
+            assert torch.equal(out["q"], ref[0]) and torch.equal(out["qi"], ref[1]), R
+    for f in (group, fa, fb):
+        assert not (f.counters != 0).any()
+
+
+def test_plain_bf16_equals_the_cast_chain():
+    gen = torch.Generator(device="cuda").manual_seed(2)
+    w = (torch.randn((32, 5120), generator=gen, device="cuda") * 0.05).to(BF)
+    for R in [*range(1, 17), 64]:
+        x = (torch.randn((R, 5120), generator=gen, device="cuda") * 3).to(BF)
+        want = PF.matmul_t(x, w).to(F32).to(BF)
+        got = PF.matmul_t(x, w, BF)
+        assert torch.equal(_bits(got), _bits(want)), R
+
+
+def test_pool_split_equals_the_concatenation():
+    gen = torch.Generator(device="cuda").manual_seed(3)
+    w = torch.randn(512, generator=gen, device="cuda").to(BF)
+    z = lambda n: torch.zeros((n, 512), dtype=BF, device="cuda")      # noqa: E731
+    for P, n in ((41, 5), (10, 16), (7, 1)):
+        carry = torch.randn(1024, generator=gen, device="cuda").to(BF).float()
+        rows = (torch.randn((n, 1024), generator=gen, device="cuda") * 2).to(BF)
+        pos = torch.tensor([P], dtype=torch.int32, device="cuda")
+        want = compress.pool_norm(torch.cat([carry.view(1, -1), rows.float()], 0), w, pos, n, 2, z(n))
+        assert torch.equal(_bits(compress.pool_norm(rows, w, pos, n, 2, z(n), carry=carry)), _bits(want)), (P, n)
+    S, R = 3, 12
+    mix = [(2, 41, 3), (0, 10, 1), (1, 119, 4)]
+    t = torch.from_numpy(RT.plan_rows(mix, list(range(8)), R, S)).to("cuda")
+    pos, wslot, prev = t[RT.POS].contiguous(), t[RT.WSLOT].contiguous(), t[RT.PREV].contiguous()
+    carry = torch.randn((S, 1024), generator=gen, device="cuda").to(BF).float()
+    rows = (torch.randn((R, 1024), generator=gen, device="cuda") * 2).to(BF)
+    want = compress.pool_norm(torch.cat([carry, rows.float()], 0), w, pos, R, 2, z(R), slots=wslot, prev=prev)
+    got = compress.pool_norm(rows, w, pos, R, 2, z(R), slots=wslot, prev=prev, carry=carry)
+    assert torch.equal(_bits(got), _bits(want))
+
+
+# -- the engine -------------------------------------------------------------------------------------------------------
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41br"))
+
+
+def _fw(ck, mp, branches: bool, graphs: bool):
+    mp.setenv("TF_DSV41_BRANCHES", "1") if branches else mp.delenv("TF_DSV41_BRANCHES", raising=False)
+    fw = DF.forward(ck, slots=4, limit=LONG, dspark=False, device=DEV, chunk=128)
+    b = DF.batcher(ck, fw, n=4, capacity=LONG, pool_tokens=5 * LONG)
+    if branches:
+        assert any(getattr(blk, "branch", None) is not None for blk in fw.blocks)
+    if graphs:
+        assert rowmode.ready(fw)
+        fw.graphs = RG.make(fw, settings=SETTINGS)
+        assert isinstance(fw.graphs, RG.RowGraphs)
+        fw.graphs.warmup(4, lambda s, end: b.ex.slots[s].ensure(end))
+    for s in range(4):
+        b.ex.slots[s].ensure(LONG)
+        fw.reset(s)
+        fw.prefill([Piece(s, 0, tuple(PROMPTS[s]))], mode="full")
+    return fw, b
+
+
+def _segs(fw, rng, live, rows):
+    return [Seg(s, fw.slots[s].pos, tuple(int(t) for t in rng.integers(3, 250, size=n))) for s, n in zip(live, rows)]
+
+
+def test_engine_branches_on_equals_off(ck, monkeypatch):
+    on, _ = _fw(ck, monkeypatch, True, True)
+    off, _ = _fw(ck, monkeypatch, False, False)
+    rng = np.random.default_rng(5)
+    for step in range(24):                          # crosses position 2,048: context bucket 1 captured lazily
+        k = 1 + step % 4
+        live = [int(s) for s in rng.permutation(4)[:k]]
+        rows = [int(r) for r in rng.integers(1, 17, size=k)] if step % 5 else [16] * k
+        segs = _segs(off, rng, live, rows)
+        got = on.graphs.run(segs).clone()
+        want = off.run(segs)
+        assert torch.equal(_bits(got), _bits(want)), (step, live, rows)
+        for sg in segs:
+            pg, pe = on.slots[sg.slot].pending, off.slots[sg.slot].pending
+            assert set(pg.proj) == set(pe.proj)
+            for L in pe.proj:
+                assert torch.equal(pg.proj[L].float(), pe.proj[L]), (step, L)
+            keep = int(rng.integers(0, len(sg.ids)))
+            on.keep(sg.slot, keep)
+            off.keep(sg.slot, keep)
+            for L, t in off.slots[sg.slot].carry.items():
+                assert torch.equal(on.slots[sg.slot].carry[L], t), (step, L)
+    st = on.graphs.cache.stats
+    assert st["replays"] > 0 and st["failed"] == 0, st
+    print(f"[G13] branches: on (row graphs) == off (eager) over 24 windows; {on.graphs.cache.describe()}")
+
+
+def _fanout(path) -> tuple[int, int]:
+    """(nodes, nodes with more than one successor) of a CUDA graph DOT dump."""
+
+    with open(path, errors="replace") as f:
+        text = f.read()
+    out: dict = {}
+    for a, _b in re.findall(r'"?([\w.]+)"?\s*->\s*"?([\w.]+)"?', text):
+        out[a] = out.get(a, 0) + 1
+    nodes = len(set(re.findall(r'^\s*"?([\w.]+)"?\s*\[', text, re.MULTILINE)))
+    return nodes, sum(1 for v in out.values() if v > 1)
+
+
+def test_the_window_graph_forks(ck, monkeypatch, tmp_path):
+    real = torch.cuda.CUDAGraph
+
+    class Dbg(real):
+        # torch 2.13 destroys the cudaGraph_t at capture_end unless keep_graph=True (debug mode alone no longer
+        # keeps it: G13, debug_dump wrote nothing); the exec graph is then instantiated at the first replay. The
+        # pybind __init__ runs again after __new__ and would reset keep_graph to its default: pass True there too
+        def __new__(cls, keep_graph: bool = False):
+            return super().__new__(cls, True)
+
+        def __init__(self, keep_graph: bool = False):
+            super().__init__(True)
+            self.enable_debug_mode()
+
+    monkeypatch.setattr(torch.cuda, "CUDAGraph", Dbg)
+    fan = {}
+    for name, on in (("off", False), ("on", True)):
+        fw, _ = _fw(ck, monkeypatch, on, True)
+        key = next(k for k in fw.graphs.cache.graphs if k[0] == 1)
+        e = fw.graphs.cache.graphs[key]
+        path = tmp_path / f"{name}.dot"
+        e.graph.debug_dump(str(path))
+        fan[name] = _fanout(path)
+    print(f"[G13] branches: 1-row window graph nodes / fan-out nodes: off {fan['off']}, on {fan['on']}")
+    assert fan["on"][1] > fan["off"][1]
+
+
+def test_batched_equals_alone_with_branches(ck, monkeypatch):
+    both, _ = _fw(ck, monkeypatch, True, True)
+    alone, _ = _fw(ck, monkeypatch, True, True)
+    rng = np.random.default_rng(7)
+    for step in range(6):
+        rows = [int(r) for r in rng.integers(1, 9, size=2)]
+        segs = _segs(both, rng, [0, 1], rows)
+        got = both.graphs.run(segs).clone()
+        parts = [alone.graphs.run([sg]).clone() for sg in segs]
+        assert torch.equal(_bits(got), _bits(torch.cat(parts, 0))), (step, rows)
+        for sg in segs:
+            keep = len(sg.ids) - 1
+            both.keep(sg.slot, keep)
+            alone.keep(sg.slot, keep)
+    assert both.graphs.cache.stats["replays"] > 0 and alone.graphs.cache.stats["replays"] > 0
+
+
+# -- G14 ---------------------------------------------------------------------------------------------------------------
+from tensorfold.families.deepseek_v41.cuda import branches as BR  # noqa: E402
+
+MODES = [("1", "main"), ("1", "side"), ("1", "equal"), ("serial", None)]
+
+
+def _fwm(ck, mp, mode: str | None, prio: str | None, graphs: bool = True):
+    """``_fw`` for a G14 mode: TF_DSV41_BRANCHES=mode (None: off), TF_DSV41_BRANCHES_PRIO=prio (None: default)."""
+
+    mp.setenv("TF_DSV41_BRANCHES_PRIO", prio) if prio else mp.delenv("TF_DSV41_BRANCHES_PRIO", raising=False)
+    if mode is None:
+        return _fw(ck, mp, False, graphs)
+    mp.setenv("TF_DSV41_BRANCHES", mode)
+    fw = DF.forward(ck, slots=4, limit=LONG, dspark=False, device=DEV, chunk=128)
+    b = DF.batcher(ck, fw, n=4, capacity=LONG, pool_tokens=5 * LONG)
+    assert any(getattr(blk, "branch", None) is not None for blk in fw.blocks)
+    if graphs:
+        fw.graphs = RG.make(fw, settings=SETTINGS)
+        assert isinstance(fw.graphs, RG.RowGraphs)
+        fw.graphs.warmup(4, lambda s, end: b.ex.slots[s].ensure(end))
+    for s in range(4):
+        b.ex.slots[s].ensure(LONG)
+        fw.reset(s)
+        fw.prefill([Piece(s, 0, tuple(PROMPTS[s]))], mode="full")
+    return fw, b
+
+
+def _driver_of(fw):
+    for blk in fw.blocks:
+        br = getattr(blk, "branch", None)
+        if br is not None:
+            return br.drv
+    return None
+
+
+@pytest.mark.parametrize("mode,prio", MODES)
+def test_g14_every_mode_equals_off(ck, monkeypatch, mode, prio):
+    on, _ = _fwm(ck, monkeypatch, mode, prio)
+    off, _ = _fwm(ck, monkeypatch, None, None, graphs=False)
+    rng = np.random.default_rng(11)
+    for step in range(10):
+        k = 1 + step % 3
+        live = [int(s) for s in rng.permutation(4)[:k]]
+        rows = [int(r) for r in rng.integers(1, 9, size=k)] if step % 4 else [1] * k     # 1-row windows too
+        segs = _segs(off, rng, live, rows)
+        got = on.graphs.run(segs).clone()
+        want = off.run(segs)
+        assert torch.equal(_bits(got), _bits(want)), (mode, prio, step, live, rows)
+        for sg in segs:
+            pg, pe = on.slots[sg.slot].pending, off.slots[sg.slot].pending
+            for L in pe.proj:
+                assert torch.equal(pg.proj[L].float(), pe.proj[L]), (step, L)
+            keep = int(rng.integers(0, len(sg.ids)))
+            on.keep(sg.slot, keep)
+            off.keep(sg.slot, keep)
+    drv = _driver_of(on)
+    st = on.graphs.cache.stats
+    assert st["replays"] > 0 and st["failed"] == 0, st
+    if mode == "serial":
+        assert drv is BR.SERIAL and BR.capture_stream(on) is None
+        assert all(getattr(blk.branch, "wq_b", None) is None for blk in on.blocks if blk.branch is not None)
+    else:
+        assert isinstance(drv, BR.Driver) and drv.at is None, "a fork left open"
+        assert drv.forks >= drv.joins > 0
+        assert BR.capture_stream(on) is drv.main
+    print(f"[G14] branches {mode}/{prio}: replayed == off eager over 10 windows; "
+          f"{drv.describe()}; {on.graphs.cache.describe()}")
+
+
+def test_g14_priorities_are_set(ck, monkeypatch):
+    lo, hi = torch.cuda.Stream.priority_range()         # (least, greatest): e.g. (0, -5)
+    got = {}
+    for prio in BR.PRIOS:
+        drv = BR.driver(DEV, prio)
+        got[prio] = (drv.main.priority, drv.side.priority)
+    print(f"[G14] branches: device priority range least {lo} / greatest {hi}; (main, side) by prio {got}")
+    if hi < lo:                                          # the device has priorities
+        assert got["main"][0] < got["main"][1] and got["side"][1] < got["side"][0]
+        assert got["equal"][0] == got["equal"][1] == lo
+    for p in BR.PRIOS:                                   # one driver a (device, prio): the same streams every time
+        assert BR.driver(DEV, p) is BR.driver(DEV, p)
+    # dedicated streams: none of torch's pooled streams (32 a priority, round robin) is a driver's stream
+    pool = {torch.cuda.Stream(priority=p).cuda_stream for p in (0, BR.HIGH) for _ in range(96)}
+    ded = {p: BR.driver(DEV, p).dedicated for p in BR.PRIOS}
+    print(f"[G14] branches: dedicated streams {ded}; {len(pool)} pooled streams seen")
+    for p in BR.PRIOS:
+        drv = BR.driver(DEV, p)
+        assert drv.dedicated, "cuStreamCreateWithPriority unreachable: the driver fell back to pooled streams"
+        assert drv.main.cuda_stream not in pool and drv.side.cuda_stream not in pool
+        assert drv.main.cuda_stream != drv.side.cuda_stream
+
+
+def _topology(path) -> tuple:
+    """(nodes, edges, nodes with > 1 successor, nodes with > 1 predecessor) of a CUDA graph DOT dump."""
+
+    with open(path, errors="replace") as f:
+        text = f.read()
+    edges = re.findall(r'"?([\w.]+)"?\s*->\s*"?([\w.]+)"?', text)
+    succ, pred = {}, {}
+    for a, b in edges:
+        succ[a] = succ.get(a, 0) + 1
+        pred[b] = pred.get(b, 0) + 1
+    nodes = len(set(re.findall(r'^\s*"?([\w.]+)"?\s*\[', text, re.MULTILINE)))
+    return (nodes, len(edges), sum(v > 1 for v in succ.values()), sum(v > 1 for v in pred.values())), \
+        "priority" in text.lower()
+
+
+def test_g14_capture_is_deterministic(ck, monkeypatch, tmp_path):
+    real = torch.cuda.CUDAGraph
+
+    class Dbg(real):                                     # as test_the_window_graph_forks (keep_graph for the DOT)
+        def __new__(cls, keep_graph: bool = False):
+            return super().__new__(cls, True)
+
+        def __init__(self, keep_graph: bool = False):
+            super().__init__(True)
+            self.enable_debug_mode()
+
+    monkeypatch.setattr(torch.cuda, "CUDAGraph", Dbg)
+    topo = {}
+    for i in range(2):                                   # two engines built alike, captured at boot alike
+        fw, _ = _fwm(ck, monkeypatch, "1", "main")
+        key = next(k for k in fw.graphs.cache.graphs if k[0] == 1)
+        path = tmp_path / f"g14-{i}.dot"
+        fw.graphs.cache.graphs[key].graph.debug_dump(str(path))
+        topo[i] = _topology(path)
+        assert _driver_of(fw).at is None
+    print(f"[G14] branches: 1-row window graph (nodes, edges, fan-out, fan-in) {topo[0][0]} / {topo[1][0]}; "
+          f"DOT shows node priorities: {topo[0][1]}")
+    assert topo[0][0] == topo[1][0]
+    assert topo[0][0][2] > 0 and topo[0][0][3] > 0      # it forks and joins
