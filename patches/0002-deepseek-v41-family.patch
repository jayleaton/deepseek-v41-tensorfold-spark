index 0000000..efc8ecc
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/jointsim.py
@@ -0,0 +1,157 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Multi-stream rounds of the DSpark depth policy on the measured window curve (G15b; ``joint.py`` mode 2).
+
+The policy under test is the engine's own ``depth.Depth`` (``choose_joint`` / ``record`` / ``bonus``, its calibration
+and rates); only the model and the clock are simulated:
+
+- **window**: ``ROWS_G14``, G14's prod (combo) windows at 1-16 total rows, the median over 3 boots x 5 passes of the
+  slower rank's raw ms (``results/G14-20261003/wt-g14c-combo-b*.json``: the curve calib VERSION 4 measures, steps at
+  9 and 13 rows included); past 16 rows ``WIDE`` (G9's measured 24 / 32 / 48 / 64-row buckets scaled to G14's 16-row
+  window). ``ROWS_V3`` is the same boots' VERSION 3 table (fitted lines: 2 rows +1.6 ms, 9-14 rows -2.5 to +0.6);
+- **round**: window + ``SLOT_MS`` a further slot + the DSpark pass (``PASS_MS`` + ``PASS_SLOT_MS`` a further slot) +
+  ``HOST_MS`` (G9 / G13 phases: C2 rounds 49.9 ms = window 41.1 + pass 5.0 + ~3.8 host);
+- **acceptance**: a round's chances q_1..q_5 per workload. q_1 is drawn from G13's measured q_1 bins (``Q1``: rounds
+  per bin of the calibrated q_1, m2bench T = 0, ``results/G13-20261003/m2-g13cs-combo.json``), uniform inside the
+  bin; later positions follow q_1 with a drift and noise (``LATER``) fitted so that one stream alone under the
+  independent policy commits what G13 measured: code 3.81 tokens a round (measured 3.80) at 4.8 rows, prose 1.60
+  (1.57-1.68) at 2.16 rows (2.17), structured 5.7 (5.9). The chances are the true keep probabilities and the head's
+  confidences (the calibration factor learns ~1);
+- **streams**: each emits ``tokens`` (m2bench: 384) and leaves; a round verifies every live stream. A lone stream
+  takes ``choose`` (zero depth), as the engine does.
+
+Metrics (as m2bench's ``concurrent`` now reports them): ``steady`` = tokens per second while every stream is live;
+``agg`` = all tokens / the time to the last stream's end (the mixed cells' old number); ``per`` = each stream's
+tokens per second while all are live.
+
+``python -m tensorfold.families.deepseek_v41.cuda.jointsim`` prints the policies against each other (C2 / C4,
+mixed and same-workload). Seeded, no clock: the same numbers every run.
+"""
+
+from __future__ import annotations
+
+import argparse
+import random
+import statistics
+from collections.abc import Sequence
+
+from . import calib, depth
+
+ROWS_G14 = [21.75, 26.42, 31.79, 35.87, 40.56, 44.46, 46.87, 50.96, 57.06, 59.16, 60.55, 62.2, 66.83, 68.84,
+            70.97, 71.66]
+ROWS_V3 = [21.671, 27.996, 31.897, 35.799, 39.701, 43.602, 47.504, 51.406, 53.866, 56.327, 58.788, 61.248, 63.709,
+           66.17, 68.63, 71.091]
+WIDE = {24: 100.3, 32: 114.4, 48: 146.4, 64: 194.5}
+SLOT_MS, PASS_MS, PASS_SLOT_MS, HOST_MS = 1.05, 3.5, 1.0, 3.0
+
+Q1 = {"code": [0, 0, 0, 0, 5, 6, 7, 12, 10, 61], "prose": [0, 23, 42, 45, 36, 24, 18, 22, 21, 13],
+      "struct": [0, 0, 0, 0, 0, 0, 0, 1, 0, 64]}
+LATER = {"code": (-0.02, 0.08), "prose": (-0.25, 0.12), "struct": (0.0, 0.01)}
+MIXES = {"C2 mixed": ("code", "prose"), "C2 code": ("code", "code"), "C2 prose": ("prose", "prose"),
+         "C4 mixed": ("code", "prose", "struct", "struct"), "C4 code": ("code",) * 4, "C4 prose": ("prose",) * 4}
+POLICIES = {"independent": {"joint": 0}, "joint1": {"joint": 1}, "joint2": {"joint": 2},
+            "joint2 fair0": {"joint": 2, "fair": 0.0}}
+
+
+def costs(table: Sequence[float] = ROWS_G14) -> depth.Costs:
+    """The engine's table of ``table`` (rows 1-16) + ``WIDE``, monotone, as ``calib.measure`` builds it."""
+
+    return depth.Costs(calib.extend(calib.monotone(table), WIDE), PASS_MS, "measured", SLOT_MS)
+
+
+def draw(rng: random.Random, kind: str) -> list[float]:
+    """One round's chances q_1..q_5 of a ``kind`` stream."""
+
+    b = rng.choices(range(10), weights=Q1[kind])[0]
+    q1 = 0.97 + 0.025 * rng.random() if kind == "struct" else (b + rng.random()) / 10
+    drift, sd = LATER[kind]
+    qs = [q1] + [q1 + drift * (j + 1) + rng.gauss(0.0, sd) for j in range(4)]
+    return [min(max(q, 0.01), 0.995) for q in qs]
+
+
+def run(kinds: Sequence[str], *, joint: int = 0, fair: float | None = None, table: Sequence[float] = ROWS_G14,
+        tokens: int = 384, seed: int = 0, host_ms: float = HOST_MS) -> dict:
+    """One multi-stream run: ``kinds`` streams of ``tokens`` each under the policy ``joint`` (0 / 1 / 2). The policy
+    prices with ``table``; the clock is always the measured curve (``ROWS_G14``)."""
+
+    rng = random.Random(seed)
+    c, clock = costs(table), costs(ROWS_G14)
+    d = depth.Depth(c, block=5, mode="cost", cap=5, skip=True, joint=joint,
+                    fair=0.5 if fair is None else fair, host_ms=host_ms)
+    n = len(kinds)
+    left, t, steady_ms = [int(tokens)] * n, 0.0, 0.0
+    per, rows, toks_round = [0] * n, [], [[0, 0] for _ in range(n)]
+    while any(x > 0 for x in left):
+        live = [s for s in range(n) if left[s] > 0]
+        qs = [draw(rng, kinds[s]) for s in live]
+        ks = d.choose_joint(live, qs, [min(5, left[s] - 1) for s in live], firsts=[7] * len(live))
+        total = sum(1 + k for k in ks)
+        ms = clock.rows_ms(total) + SLOT_MS * (len(live) - 1) + PASS_MS + PASS_SLOT_MS * (len(live) - 1) + host_ms
+        all_live = len(live) == n
+        for s, q, k in zip(live, qs, ks):
+            acc = 0
+            while acc < k and rng.random() < q[acc]:
+                acc += 1
+            keep = min(acc + 1, left[s])
+            d.record(s, k + 1, acc + 1)
+            d.bonus(s, 7 if (k == 0 and rng.random() < q[0]) else 8)
+            left[s] -= keep
+            if all_live:
+                per[s] += keep
+                toks_round[s][0] += keep
+                toks_round[s][1] += 1
+        if all_live:
+            steady_ms += ms
+            rows.append(total)
+        t += ms
+    return {"steady": 1e3 * sum(per) / steady_ms, "agg": 1e3 * n * tokens / t,
+            "per": [1e3 * p / steady_ms for p in per], "rows": statistics.fmean(rows),
+            "tpr": [a / max(b, 1) for a, b in toks_round]}
+
+
+def mean_runs(kinds: Sequence[str], reps: int = 40, **kw) -> dict:
+    """``run`` over seeds 0 .. reps - 1, averaged."""
+
+    rs = [run(kinds, seed=i, **kw) for i in range(reps)]
+    out = {k: statistics.fmean(r[k] for r in rs) for k in ("steady", "agg", "rows")}
+    out["per"] = [statistics.fmean(r["per"][i] for r in rs) for i in range(len(kinds))]
+    out["tpr"] = [statistics.fmean(r["tpr"][i] for r in rs) for i in range(len(kinds))]
+    return out
+
+
+def compare(mixes: dict | None = None, policies: dict | None = None, reps: int = 40,
+            table: Sequence[float] = ROWS_G14) -> dict:
+    """{mix: {policy: mean_runs}}."""
+
+    return {m: {p: mean_runs(k, reps, table=table, **kw) for p, kw in (policies or POLICIES).items()}
+            for m, k in (mixes or MIXES).items()}
+
+
+def report(res: dict, base: str = "independent") -> str:
+    lines = []
+    for m, pol in res.items():
+        b = pol[base]
+        lines.append(f"{m}:")
+        for p, r in pol.items():
+            lines.append(f"  {p:13s} steady {r['steady']:7.2f} ({100 * (r['steady'] / b['steady'] - 1):+5.1f}%)  "
+                         f"agg {r['agg']:7.2f} ({100 * (r['agg'] / b['agg'] - 1):+5.1f}%)  rows {r['rows']:5.2f}  "
+                         f"per {[round(x, 1) for x in r['per']]}  tok/round {[round(x, 2) for x in r['tpr']]}")
+    return "\n".join(lines)
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--reps", type=int, default=40)
+    ap.add_argument("--table", default="v4", choices=("v4", "v3"),
+                    help="the table the policy prices with (v4: the measured curve; v3: its fit); the clock is v4")
+    a = ap.parse_args(argv)
+    print(report(compare(reps=a.reps, table=ROWS_G14 if a.table == "v4" else ROWS_V3)))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
+
+
+__all__ = ["HOST_MS", "LATER", "MIXES", "POLICIES", "Q1", "ROWS_G14", "ROWS_V3", "WIDE", "compare", "costs", "draw",
+           "mean_runs", "report", "run"]
