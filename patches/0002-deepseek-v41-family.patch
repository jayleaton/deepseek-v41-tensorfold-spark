+"""Engram's device side on sm_121: the row dequant and the gated fusion into the 4 residual streams.
+
+Math (vLLM ``deepseek_v4_1/common/engram.py``, Apache-2.0, math only; ``engine/reference/engram.py: Engram``):
+
+    e     = bf16(e4m3 x 2^(ue8m0 - 127) every 32 values)               [R, 24 x 256], the rows of a token
+    kv    = bf16(wkv(e))                                               [R, 5 D] (EXL3 linear, outside this module)
+    dot_h = sum_d (x_h q_h k_h)[d] key_h[d] * rsqrt(ms(x_h) + eps) * rsqrt(ms(key_h) + eps) / sqrt(D)
+    gate  = sigmoid(sign(dot_h) sqrt(max(|dot_h|, 1e-6))) * keep       (keep 0 on image tokens)
+    x_h  <- bf16(x_h + gate_h * value)                                 value = kv[:, 4 D:]
+
+Arithmetic (``enable_fp_fusion=False``; tests/dsv41_kref.py emulates it):
+
+- ``_dequant``: the e4m3 byte decoded from its bits (normal: sign | (e + 120) << 23 | m << 20; subnormal m x 2^-9),
+  times the scale built from its byte (``byte << 23``: 2^(byte - 127), 0 for byte 0, as the reference), one IEEE
+  product, one round to bf16: bit for bit the reference's ``bf16(fp8_e4m3_dequant(...))``.
+- ``_fuse``: one program a row. ``qk = bf16(q) * bf16(k)`` (exact in fp32, precomputed at load); per stream the
+  three sums (x qk key with x qk exact and one rounding of the product, x^2 and key^2 exact) are FMA chains against
+  ones in column order (``tl.dot`` ieee: no reduction tree, the same for any row); 1 / sqrt with ``sqrt_rn`` /
+  ``div_rn``; the gate's sigmoid uses the hardware exp (tolerance, not bits); then the update elementwise.
+
+Interface:
+
+    Tables.from_hasher(engram_host.NgramHasher) / Tables.from_config(cfg, token_map)
+        token map, multipliers, primes, offsets as numpy (the prepared folder stores them)
+    Tables.rows(ids, dead=None, lookback=None) -> [T, 2, 24] int64     host hash, outside the graphs
+    Tables.next_lookback(lookback, ids, dead) -> the slot's last 3 compressed ids after a commit
+    Prefetch(tables, shards {layer: ShardRows}, rank, world, max_rows)
+        .issue(lookback, [pending, d1, ...]) at drafter end (prefill: when a chunk is cut); .land(ticket, li) waits
+        for a layer's rows into pinned staging [2, max_rows, 12, 264]; .upload(li, device_buf, n) one H2D copy
+
+    dequant(raw uint8 [R, H, 264], out bf16 [R, 24 x 256], col0=0)      a rank's H = 12 heads at column col0 (TP:
+                                                                          gather the raw records first: 3 KB a row)
+    fuse(x bf16 [R, 4 D] (updated in place), kv bf16 [R, 5 D], qk fp32 [4, D], keep fp32 [R] or None, gate=None)
+        kv = the Engram wkv output (EXL3 linear, 6,144 -> 25,600, bf16 out); qk = qk_weights(q_weight, k_weight)
+
+Order in a forward: ``mhc.post_only`` (the FFN boundary of layer L - 1), ``fuse``, then ``mhc.site`` with the carried
+pre-mix (the attention site of layer L).
+
+Staged and tested in the development tree (unpublished) (engine/kernels/engram); the torch emulations the tests compare with are in
+tests/dsv41_kref.py.
+"""
+
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass, field
+
+import numpy as np
+import torch
+import triton
+import triton.language as tl
+
+from . import pdl as P
+from .pdl import gdc_launch_dependents, gdc_wait
+
+HD = 256           # values a row
+SCALES = 8         # UE8M0 bytes a row (one a 32 values)
+RECORD = 264
+BK = 64            # columns a step of the fusion (no effect on bits)
+FUSE_WARPS = 4
+
+
+@triton.jit
+def e4m3_bits(b):
+    """uint8-valued int32 b -> the e4m3 value as fp32, exactly (NaN for 0x7F / 0xFF)."""
+
+    s = (b >> 7) & 1
+    e = (b >> 3) & 15
+    m = b & 7
+    normal = (s << 31) | ((e + 120) << 23) | (m << 20)
+    # the subnormal's magnitude (m x 2^-9, exact), its sign as the bit: Triton lowers ``-x`` to ``0 - x``, which gives
+    # +0.0 for byte 0x80 (G1: the e4m3 -0 came out +0 on sm_121; the interpreter's numpy negation kept -0)
+    sub = (m.to(tl.float32) * 0.001953125).to(tl.int32, bitcast=True) | (s << 31)
+    v = tl.where(e > 0, normal.to(tl.float32, bitcast=True), sub.to(tl.float32, bitcast=True))
+    nan = (e == 15) & (m == 7)
+    return tl.where(nan, ((s << 31) | 0x7FC00000).to(tl.float32, bitcast=True), v)
+
+
+@triton.jit
+def _dequant(RAW, raw_stride, OUT, o_stride, col0, H: tl.constexpr, HP: tl.constexpr):
+    """Program r: RAW[r] = H records of 264 bytes (256 e4m3, 8 scale bytes) -> OUT[r, (col0 + h) 256 + i] bf16."""
+
+    r = tl.program_id(0).to(tl.int64)
+    h = tl.arange(0, HP)
+    i = tl.arange(0, 256)
+    ok = h < H
+    b = tl.load(RAW + r * raw_stride + h[:, None] * 264 + i[None, :], mask=ok[:, None], other=0).to(tl.int32)
+    sc = tl.load(RAW + r * raw_stride + h[:, None] * 264 + 256 + i[None, :] // 32, mask=ok[:, None],
+                 other=0).to(tl.int32)
+    v = e4m3_bits(b) * (sc << 23).to(tl.float32, bitcast=True)
+    tl.store(OUT + r * o_stride + (col0 + h[:, None]) * 256 + i[None, :], v.to(tl.bfloat16), mask=ok[:, None])
+
+
+@triton.jit
+def _fuse(X, x_stride, KV, kv_stride, QK, KEEP, GATE, eps, clamp, sqrt_d, D: tl.constexpr, BK: tl.constexpr,
+          HAS_KEEP: tl.constexpr, HAS_GATE: tl.constexpr, PDL: tl.constexpr = False):
+    """Program r: the 4 gates of row r from X [R, 4 D] (bf16), KV [R, 5 D] (bf16: keys of streams 0-3, the value)
+    and QK [4, D] fp32; X updated in place. KEEP [R] fp32 (1 / 0), GATE [R, 4] fp32 (optional output)."""
+
+    if PDL:                                   # G10 (pdl.py, TF_DSV41_PDL): wait for the kernels before, then
+        gdc_wait()                            # let the next launch start its prologue
+        gdc_launch_dependents()
+    r = tl.program_id(0).to(tl.int64)
+    hh = tl.arange(0, 16)
+    hm = hh < 4
+    kk = tl.arange(0, BK)
+    ones = tl.full((BK, 16), 1.0, tl.float32)
+    sp = tl.zeros((16, 16), tl.float32)
+    sx = tl.zeros((16, 16), tl.float32)
+    sk = tl.zeros((16, 16), tl.float32)
+    for t in range(D // BK):
+        d = t * BK + kk
+        x = tl.load(X + r * x_stride + hh[:, None] * D + d[None, :], mask=hm[:, None], other=0.0).to(tl.float32)
+        k = tl.load(KV + r * kv_stride + hh[:, None] * D + d[None, :], mask=hm[:, None], other=0.0).to(tl.float32)
+        q = tl.load(QK + hh[:, None] * D + d[None, :], mask=hm[:, None], other=0.0)
+        p = (x * q) * k
+        sp = tl.dot(p, ones, sp, input_precision="ieee")
+        sx = tl.dot(x * x, ones, sx, input_precision="ieee")
+        sk = tl.dot(k * k, ones, sk, input_precision="ieee")
+    c0 = tl.arange(0, 16)[None, :] == 0
+    dp = tl.sum(tl.where(c0, sp, 0.0), 1)
+    rx = tl.div_rn(1.0, tl.sqrt_rn(tl.div_rn(tl.sum(tl.where(c0, sx, 0.0), 1), 1.0 * D) + eps))
+    rk = tl.div_rn(1.0, tl.sqrt_rn(tl.div_rn(tl.sum(tl.where(c0, sk, 0.0), 1), 1.0 * D) + eps))
+    dot = tl.div_rn((dp * rx) * rk, sqrt_d)
+    g = tl.sqrt_rn(tl.maximum(tl.abs(dot), clamp))
+    gate = 1.0 / (1.0 + tl.exp(-tl.where(dot < 0, -g, g)))
+    if HAS_KEEP:
+        gate = gate * tl.load(KEEP + r)
+    gate = tl.where(hm, gate, 0.0)
+    if HAS_GATE:
+        tl.store(GATE + r * 4 + hh, gate, mask=hm)
+    for t in range(D // BK):
+        d = t * BK + kk
+        x = tl.load(X + r * x_stride + hh[:, None] * D + d[None, :], mask=hm[:, None], other=0.0).to(tl.float32)
+        v = tl.load(KV + r * kv_stride + 4 * D + d).to(tl.float32)
+        tl.store(X + r * x_stride + hh[:, None] * D + d[None, :], (x + gate[:, None] * v[None, :]).to(tl.bfloat16),
+                 mask=hm[:, None])
+
+
+EPS = 1e-20
+CLAMP = 1e-6
+LAUNCH = {"enable_fp_fusion": False}
+
+
+def qk_weights(q_weight: torch.Tensor, k_weight: torch.Tensor) -> torch.Tensor:
+    """bf16(q) * bf16(k) in fp32 [4, D] (exact: two 8-bit mantissas), computed once at load."""
+
+    return (q_weight.to(torch.bfloat16).float() * k_weight.to(torch.bfloat16).float()).contiguous()
+
+
+def dequant(raw: torch.Tensor, out: torch.Tensor, col0: int = 0) -> torch.Tensor:
+    R, H, rb = raw.shape
+    if raw.dtype != torch.uint8 or rb != RECORD or raw.stride(2) != 1 or raw.stride(1) != RECORD:
+        raise ValueError("engram.dequant: raw uint8 [R, H, 264] with contiguous records")
+    if out.dtype != torch.bfloat16 or out.stride(1) != 1 or out.shape[1] < (col0 + H) * HD:
+        raise ValueError("engram.dequant: out bf16 [R, >= (col0 + H) 256]")
+    if R:
+        _dequant[(R,)](raw, raw.stride(0), out, out.stride(0), col0, H=H, HP=triton.next_power_of_2(H),
+                         num_warps=4, **LAUNCH)
+    return out
+
+
+def fuse(x: torch.Tensor, kv: torch.Tensor, qk: torch.Tensor, keep: torch.Tensor | None = None,
+         gate: torch.Tensor | None = None, *, eps: float = EPS, clamp: float = CLAMP) -> torch.Tensor:
+    R = x.shape[0]
+    d = qk.shape[1]
+    if x.dtype != torch.bfloat16 or x.shape[1] != 4 * d or x.stride(1) != 1 or d % BK:
+        raise ValueError("engram.fuse: x bf16 [R, 4 D] unit-stride, D a multiple of 64")
+    if kv.dtype != torch.bfloat16 or kv.shape[1] < 5 * d or kv.stride(1) != 1 or qk.dtype != torch.float32:
+        raise ValueError("engram.fuse: kv bf16 [R, 5 D], qk fp32 [4, D]")
+    if keep is not None and keep.dtype != torch.float32:
+        keep = keep.to(torch.float32)
+    if R:
+        _fuse[(R,)](x, x.stride(0), kv, kv.stride(0), qk, keep if keep is not None else qk,
+                      gate if gate is not None else qk, eps, clamp, float(math.sqrt(d)), D=d, BK=BK,
+                      HAS_KEEP=keep is not None, HAS_GATE=gate is not None, num_warps=FUSE_WARPS, **LAUNCH,
+                      **P.triton_kw())
+    return x
+
+
+# -- the host side: hash tables (numpy, outside every graph) and the round prefetch ----------------------------------
+DEAD = -1
+LOOKBACK = 3
+
+
+@dataclass
+class Tables:
+    """``engram_host.NgramHasher``'s tables as numpy (the prepared folder stores them): ``rows`` hashes a window in
+    vectorised int64 numpy, bit for bit the hasher's (wrap-around products, non-negative remainders)."""
+
+    token_map: np.ndarray       # [vocab] int64 -> compressed id
+    mult: np.ndarray            # [layers, max_ngram] int64 (odd)
+    primes: np.ndarray          # [layers, 24] int64
+    offsets: np.ndarray         # [layers, 24] int64
+    pad_id: int
+    layer_ids: tuple[int, ...] = (1, 14)
+    n_heads: int = 8
+    max_ngram: int = 4
+
+    @classmethod
+    def from_hasher(cls, h) -> Tables:
+        lay = h.layout
+        return cls(h.token_map.numpy().astype(np.int64), h.multipliers.numpy().astype(np.int64),
+                   lay.primes.numpy().astype(np.int64), lay.offsets.numpy().astype(np.int64), int(h.pad_id),
+                   tuple(lay.layer_ids), h.cfg.engram_n_heads, h.cfg.engram_max_ngram_size)
+
+    @classmethod
+    def from_config(cls, cfg, tmap) -> Tables:
+        from .engram_host import NgramHasher
+
+        return cls.from_hasher(NgramHasher(cfg, tmap))
+
+    @property
+    def cols(self) -> int:
+        return (self.max_ngram - 1) * self.n_heads
+
+    def shard(self, li: int, rank: int, world: int) -> tuple[int, int, int, int]:
+        """(row lo, row hi, first column, columns) of a TP rank (complete heads, rank-major)."""
+
+        part = (self.cols + world - 1) // world
+        c0 = rank * part
+        c1 = min(c0 + part, self.cols)
+        return int(self.primes[li, :c0].sum()), int(self.primes[li, :c1].sum()), c0, c1 - c0
+
+    def compress(self, ids, dead=None) -> np.ndarray:
+        ids = np.asarray(ids, dtype=np.int64)
+        past = ids >= self.token_map.size            # a virtual id (an image position): DEAD
+        x = self.token_map[np.minimum(ids, self.token_map.size - 1)]
+        if dead is not None:
+            past = past | np.asarray(dead, dtype=bool)
+        return np.where(past, DEAD, x) if past.any() else x
+
+    def rows(self, ids, dead=None, lookback=None) -> np.ndarray:
+        """[T] ids after ``lookback`` (<= 3 compressed ids, oldest first, DEAD allowed) -> [T, layers, 24] int64."""
+
+        cur = self.compress(ids, dead)
+        lb = np.zeros(0, dtype=np.int64) if lookback is None else np.asarray(lookback, dtype=np.int64)
+        src = np.concatenate([lb, cur])
+        t = cur.size
+        out = np.empty((t, len(self.layer_ids), self.cols), dtype=np.int64)
+        idx = np.arange(t) + lb.size
+        with np.errstate(over="ignore"):
+            for li in range(len(self.layer_ids)):
+                blocked = np.zeros(t, dtype=bool)
+                rolling = np.zeros(t, dtype=np.int64)
+                for s in range(self.max_ngram):
+                    j = idx - s
+                    before = j < 0
+                    v = np.where(before, self.pad_id, src[np.maximum(j, 0)])
+                    blocked = blocked | before | (v == DEAD)
+                    rolling = rolling ^ (np.where(blocked, self.pad_id, v) * self.mult[li, s])
+                    if s > 0:
+                        cols = slice((s - 1) * self.n_heads, s * self.n_heads)
+                        out[:, li, cols] = rolling[:, None] % self.primes[li, cols][None, :] + \
+                            self.offsets[li, cols][None, :]
+        return out
+
+    def next_lookback(self, lookback, ids, dead=None) -> np.ndarray:
+        """A slot's lookback after committing ``ids``: the last 3 compressed ids (DEAD kept)."""
+
+        lb = np.zeros(0, dtype=np.int64) if lookback is None else np.asarray(lookback, dtype=np.int64)
+        return np.concatenate([lb, self.compress(ids, dead)])[-LOOKBACK:].copy()
+
+
+@dataclass
+class RoundTicket:
+    n: int
+    futures: list
+    landed: list = field(default_factory=list)
+
+
+class Prefetch:
+    """A rank's Engram reads issued ahead of the forward: ``issue(lookback, [pending, d1, ..])`` at drafter end (a
+    prefill chunk: when it is cut) hashes the window and starts one read a layer on a worker thread (``shards``:
+    {layer: engram_host.ShardRows}, O_DIRECT, deduplicated, coalesced); ``land(ticket, li)`` waits for a layer's
+    records into the pinned staging [layers, max_rows, 12, 264]; ``upload(li, dst, n)`` is the one H2D copy a layer
+    into the fixed device buffer ``dequant`` reads (inside the graphs). Land layer 1 before the forward reaches it,
+    layer 14 after layer 1 is queued. Rows of rejected drafts cost a read only (rows are keyed by ids, not state)."""
+
+    def __init__(self, tables: Tables, shards: dict, rank: int, world: int, max_rows: int, *, pin: bool = True,
+                 workers: int = 2) -> None:
+        from concurrent.futures import ThreadPoolExecutor
+
+        self.t, self.shards, self.rank, self.world, self.max_rows = tables, shards, rank, world, max_rows
+        self.sh = [tables.shard(li, rank, world) for li in range(len(tables.layer_ids))]
+        self.pool = ThreadPoolExecutor(max_workers=workers, thread_name_prefix="engram")
+        self.staging = torch.empty((len(tables.layer_ids), max_rows, self.sh[0][3], RECORD), dtype=torch.uint8,
+                                   pin_memory=pin and torch.cuda.is_available())
+
+    def close(self) -> None:
+        self.pool.shutdown(wait=True)
+
+    def issue(self, lookback, tokens, dead=None) -> RoundTicket:
+        tokens = np.asarray(tokens, dtype=np.int64)
+        if tokens.size > self.max_rows:
+            raise ValueError(f"Engram prefetch: {tokens.size} rows > {self.max_rows}")
+        rows = self.t.rows(tokens, dead, lookback)
+        futs = []
+        for li, (_, _, c0, nc) in enumerate(self.sh):
+            mine = torch.from_numpy(np.ascontiguousarray(rows[:, li, c0:c0 + nc]).reshape(-1))
+            futs.append(self.pool.submit(self.shards[self.t.layer_ids[li]].raw, mine))
+        return RoundTicket(int(tokens.size), futs, [False] * len(futs))
+
+    def land(self, rt: RoundTicket, li: int) -> None:
+        if not rt.landed[li]:
+            got = rt.futures[li].result()                                     # [n * 12, 264] uint8
+            self.staging[li, :rt.n].copy_(torch.from_numpy(got).view(rt.n, -1, RECORD))
+            rt.landed[li] = True
+
+    def upload(self, li: int, dst: torch.Tensor, n: int) -> None:
+        dst[:n].copy_(self.staging[li, :n], non_blocking=True)
+
+
+__all__ = ["Prefetch", "RoundTicket", "Tables", "dequant", "fuse", "qk_weights"]
