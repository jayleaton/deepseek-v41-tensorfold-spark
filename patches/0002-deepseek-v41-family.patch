@@ -0,0 +1,219 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The Engram gate on the GPU (``engram_gate.cu``; window G8 ``engram``; collected only where PyTorch sees a GPU):
+
+- the kernel: launched before the rows exist, it waits on the pinned flag (the host returns at once), then copies the
+  armed round's parity of the staging; captured in a CUDA graph, one graph serves successive rounds; a wait past
+  the timeout marks the control word and returns;
+- the forward (synthetic checkpoint, packed shards, a reader delayed past layer 1): eager windows through the gate ==
+  the synchronous path bit for bit, 1 and 4 slots; graph replays with the gate == eager windows without it, across
+  lazy captures; a replay returns to the host before the reads finish; replies with the gate on == off.
+
+Run: python -m pytest -q tests/cuda/test_dsv41_engram_gate_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import threading
+import time
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+import dsv41_dspark_fakes as DF
+import dsv41_fakes as FK
+
+from tensorfold.families.deepseek_v41.cuda import engram_gate as EG
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+from tensorfold.families.deepseek_v41.cuda import engram_native as EN
+from tensorfold.families.deepseek_v41.cuda import graphs as G
+from tensorfold.families.deepseek_v41.cuda.batch import Job
+from tensorfold.families.deepseek_v41.cuda.forward import Seg
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+
+DEV = "cuda"
+LONG = 4096
+SETTINGS = {"on": True, "budget_s": 120.0, "max_graphs": 64, "bucket": 2048, "slots": 4, "warm": "decode"}
+PROMPTS = [[int(t) for t in np.random.default_rng(30 + i).integers(3, 250, size=200 + 17 * i)] for i in range(4)]
+
+
+@pytest.fixture(autouse=True)
+def _torch_seams(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")       # the mHC / Engram kernels are laid out for D = 5,120
+
+
+# -- the kernel ----------------------------------------------------------------------------------------------------
+class Bufs:
+    def __init__(self, rows=8, width=3072):
+        self.ext = EG._ext()
+        self.ctl = torch.zeros(EG.CTL_N, dtype=torch.int64, pin_memory=True)
+        self.stage = torch.zeros((2, rows, width), dtype=torch.bfloat16, pin_memory=True)
+        self.dst = torch.zeros((rows, width), dtype=torch.bfloat16, device=DEV)
+        self.nbytes = rows * width * 2
+
+    def launch(self, timeout_s=10.0):
+        e = self.ext
+        e.gate_copy(e.device_ptr(self.ctl.data_ptr()), EG.CTL_READY, EG.CTL_ERR, e.device_ptr(self.stage.data_ptr()),
+                    self.stage[1].data_ptr() - self.stage[0].data_ptr(), self.dst, self.nbytes, int(timeout_s * 1e9))
+
+    def publish_later(self, seq, delay):
+        def go():
+            time.sleep(delay)
+            self.stage[seq & 1].copy_(torch.randn(self.stage.shape[1:]).to(torch.bfloat16))
+            EN.publish(self.ctl.data_ptr() + 8 * EG.CTL_READY, seq)
+        t = threading.Thread(target=go)
+        t.start()
+        return t
+
+
+def test_kernel_waits_on_the_gpu_not_the_host():
+    b = Bufs()
+    b.ctl[EG.CTL_WANT] = 1
+    th = b.publish_later(1, 0.3)
+    t0 = time.perf_counter()
+    b.launch()
+    host = time.perf_counter() - t0
+    torch.cuda.synchronize()
+    total = time.perf_counter() - t0
+    th.join()
+    assert host < 0.1 and total >= 0.25
+    assert torch.equal(b.dst.cpu(), b.stage[1]) and int(b.ctl[EG.CTL_ERR]) == 0
+
+
+def test_kernel_in_a_graph_serves_every_round():
+    b = Bufs(rows=5, width=1000)                        # 10,000 bytes: the 16-byte path and a tail
+    s = torch.cuda.Stream()
+    g = torch.cuda.CUDAGraph()
+    b.ctl[EG.CTL_WANT] = 1
+    EN.publish(b.ctl.data_ptr() + 8 * EG.CTL_READY, 1)
+    with torch.cuda.stream(s):
+        b.launch()                                      # warm-up outside capture
+    torch.cuda.synchronize()
+    with torch.cuda.graph(g):
+        b.launch()
+    for seq in (2, 3, 4):
+        b.ctl[EG.CTL_WANT] = seq
+        th = b.publish_later(seq, 0.05)
+        g.replay()
+        torch.cuda.synchronize()
+        th.join()
+        assert torch.equal(b.dst.cpu(), b.stage[seq & 1]), seq
+
+
+def test_kernel_timeout_marks_the_control_word():
+    b = Bufs(rows=1, width=64)
+    b.ctl[EG.CTL_WANT] = 7
+    b.launch(timeout_s=0.05)
+    torch.cuda.synchronize()
+    assert int(b.ctl[EG.CTL_ERR]) == EG.CTL_READY
+
+
+# -- the forward ---------------------------------------------------------------------------------------------------
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41gateg"))
+
+
+@pytest.fixture(scope="module")
+def packed(ck, tmp_path_factory):
+    return FK.write_engram(tmp_path_factory.mktemp("gate-shards-g"), ck[1], ck[2], 1)
+
+
+def _fw(ck, packed, monkeypatch, gate, slots=1, delay=0.0):
+    monkeypatch.setenv("TF_DSV41_ENGRAM_GATE", "1" if gate else "0")
+    rows = EH.open_shards(packed, 0, 1, ck[1].engram_layer_ids, dim=ck[1].engram_head_dim)
+    fw = DF.forward(ck, slots=slots, limit=LONG, device=DEV, chunk=128, prefetch=True, rows=rows)
+    assert (fw.gate is not None) == gate
+    if gate and delay:
+        real = fw.gate.reader
+
+        def slow(parts):
+            time.sleep(delay)
+            return real(parts)
+
+        fw.gate.reader = slow
+    return fw
+
+
+def _prefill(fw, b, slot, ids):
+    b.ex.slots[slot].ensure(LONG)
+    fw.reset(slot)
+    fw.prefill([Piece(slot, 0, tuple(ids))], mode="full")
+
+
+def _steps(fw, rng_seed, slots, n=10):
+    """Windows of 1-6 random rows over a varying set of slots (at ``fw``'s positions when each is drawn)."""
+
+    rng = np.random.default_rng(rng_seed)
+    for step in range(n):
+        live = [s for s in range(slots) if step % (slots + 1) != s] or [0]
+        yield [Seg(s, fw.slots[s].pos, tuple(int(t) for t in rng.integers(3, 250, size=int(rng.integers(1, 7)))))
+               for s in live]
+
+
+@pytest.mark.parametrize("slots", [1, 4])
+def test_eager_gate_equals_sync(ck, packed, monkeypatch, slots):
+    fws = [_fw(ck, packed, monkeypatch, False, slots), _fw(ck, packed, monkeypatch, True, slots, delay=0.05)]
+    bs = [DF.batcher(ck, f, n=slots, capacity=LONG, pool_tokens=(slots + 1) * LONG) for f in fws]
+    for f, b in zip(fws, bs):
+        for s in range(slots):
+            _prefill(f, b, s, PROMPTS[s])
+    for segs in _steps(fws[0], 3, slots):
+        le = fws[0].run(segs).clone()
+        lg = fws[1].run(segs).clone()
+        fws[1].gate.check()
+        assert torch.equal(lg, le), [(sg.slot, len(sg.ids)) for sg in segs]
+        for f in fws:
+            for sg in segs:
+                f.keep(sg.slot, len(sg.ids) // 2)
+
+
+def test_graph_replay_with_gate_equals_eager(ck, packed, monkeypatch):
+    e = _fw(ck, packed, monkeypatch, False, 1)
+    g = _fw(ck, packed, monkeypatch, True, 1, delay=0.02)
+    be = DF.batcher(ck, e, capacity=LONG, pool_tokens=2 * LONG)
+    bg = DF.batcher(ck, g, capacity=LONG, pool_tokens=2 * LONG)
+    g.graphs = G.CudaGraphs(g, settings=SETTINGS)
+    assert g.graphs.warmup(1, lambda s, end: bg.ex.slots[s].ensure(end)) > 0
+    _prefill(e, be, 0, PROMPTS[0])
+    _prefill(g, bg, 0, PROMPTS[0])
+    for segs in _steps(e, 4, 1, n=14):
+        lg = g.graphs.run(segs).clone()
+        g.gate.check()
+        le = e.run(segs)
+        assert torch.equal(lg, le), [len(sg.ids) for sg in segs]
+        for f in (e, g):
+            f.keep(0, len(segs[0].ids) - 1)
+    assert g.graphs.cache.stats["replays"] > 0 and g.graphs.cache.stats["failed"] == 0
+
+
+def test_replay_returns_before_the_reads(ck, packed, monkeypatch):
+    g = _fw(ck, packed, monkeypatch, True, 1)
+    bg = DF.batcher(ck, g, capacity=LONG, pool_tokens=2 * LONG)
+    g.graphs = G.CudaGraphs(g, settings=SETTINGS)
+    g.graphs.warmup(1, lambda s, end: bg.ex.slots[s].ensure(end))
+    _prefill(g, bg, 0, PROMPTS[1])
+    real = g.gate.reader
+    g.gate.reader = lambda parts: (time.sleep(0.4), real(parts))[1]
+    segs = [Seg(0, g.slots[0].pos, (11, 12, 13, 14))]   # fresh n-grams: not cached
+    t0 = time.perf_counter()
+    g.graphs.run(segs)
+    host = time.perf_counter() - t0
+    torch.cuda.synchronize()
+    total = time.perf_counter() - t0
+    g.gate.check()
+    assert g.graphs.cache.stats["replays"] > 0
+    assert host < 0.2 and total >= 0.35, (host, total)
+
+
+def test_replies_gate_on_equal_off(ck, packed, monkeypatch):
+    def replies(gate):
+        fw = _fw(ck, packed, monkeypatch, gate, 2, delay=0.01)
+        b = DF.batcher(ck, fw, n=2, capacity=LONG, pool_tokens=3 * LONG, lookup=True)
+        return DF.run(b, [Job(list(PROMPTS[0]), 16, None), Job(list(PROMPTS[1]), 16, None)])
+
+    assert replies(True) == replies(False)
diff --git a/tests/cuda/test_dsv41_engram_pcache_gpu.py b/tests/cuda/test_dsv41_engram_pcache_gpu.py
new file mode 100644
index 0000000..08634ca
--- /dev/null
+++ b/tests/cuda/test_dsv41_engram_pcache_gpu.py
@@ -0,0 +1,218 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Engram's projected-row cache on the GPU (``engram_pcache``; collected only where PyTorch sees a GPU):
+
+- upstream's EXL3 linear with the skip word: 0 = the same bits as without it, nonzero = ``out`` untouched; rows alone
+  == rows in a window (the cache's premise), at the real Engram ``wkv`` shape (6,144 -> 25,600, 5 bits) too, with
+  the time of a launch that runs and one that skips printed;
+- ``PCache.project`` over a stream of windows (hits, partial hits, evictions) == the linear, bit for bit, eager and
+  as one captured CUDA graph replayed with a new plan each time;
+- the forward (synthetic checkpoint, packed shards): the gate with the cache == without the gate, eager windows and
+  graph replays, the same windows replayed (every layer window skips its matmul).
+
+Run: python -m pytest -q tests/cuda/test_dsv41_engram_pcache_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import time
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.cuda.exl3.linear import Exl3Linear
+from tensorfold.families.deepseek_v41.cuda import engram_pcache as EP
+
+DEV = "cuda"
+
+
+def _lin(k: int, n: int, bits: int, seed: int) -> Exl3Linear:
+    g = torch.Generator().manual_seed(seed)
+    tr = torch.randint(-32768, 32767, (k // 16, n // 16, 16 * bits), generator=g, dtype=torch.int32).to(torch.int16)
+    suh = torch.where(torch.rand(k, generator=g) < 0.5, -1.0, 1.0).to(torch.float16)
+    svh = (torch.rand(n, generator=g) * 0.02 + 0.01).to(torch.float16)
+    return Exl3Linear.from_tensors(tr, suh, svh, "mul1", device=DEV)
+
+
+def _bits(t: torch.Tensor) -> torch.Tensor:
+    return t.view(torch.int16)
+
+
+@pytest.mark.parametrize("k,n", [(512, 1280), (6144, 25600)])
+def test_skip_word_and_row_invariance(k, n):
+    lin = _lin(k, n, 5, k)
+    x = (torch.randn((7, k), device=DEV) * 0.5).to(torch.bfloat16)
+    ref = lin(x, out_dtype=torch.bfloat16)
+    zero = torch.zeros(1, dtype=torch.int32, device=DEV)
+    one = torch.ones(1, dtype=torch.int32, device=DEV)
+    got = torch.full_like(ref, 3.0)
+    lin(x, out=got, skip=zero)
+    assert torch.equal(_bits(got), _bits(ref))
+    kept = torch.full_like(ref, 3.0)
+    lin(x, out=kept, skip=one)
+    torch.cuda.synchronize()
+    assert bool((kept == 3.0).all())
+    for i in range(x.shape[0]):
+        assert torch.equal(_bits(lin(x[i:i + 1], out_dtype=torch.bfloat16)), _bits(ref[i:i + 1])), i
+    for a, b in ((0, 3), (2, 7)):
+        assert torch.equal(_bits(lin(x[a:b], out_dtype=torch.bfloat16)), _bits(ref[a:b]))
+    if k == 6144:                                   # the real shape: a launch that runs vs one that skips
+        out = torch.empty((1, n), dtype=torch.bfloat16, device=DEV)
+        for flag, name in ((zero, "runs"), (one, "skips")):
+            for _ in range(3):
+                lin(x[:1], out=out, skip=flag)
+            torch.cuda.synchronize()
+            t0 = time.perf_counter()
+            for _ in range(20):
+                lin(x[:1], out=out, skip=flag)
+            torch.cuda.synchronize()
+            print(f"Engram wkv 6144 x 25600 (5 bits, 1 row): rot_in + linear that {name}: "
+                  f"{(time.perf_counter() - t0) / 20 * 1e6:.1f} us")
+
+
+def _row(key: bytes, k: int) -> torch.Tensor:
+    g = torch.Generator().manual_seed(int.from_bytes(key, "little"))
+    return torch.randn(k, generator=g).to(torch.bfloat16)
+
+
+def _stream(steps: int, rows: int, seed: int):
+    rng = np.random.default_rng(seed)
+    pool = [bytes([i, 3]) for i in range(12)]
+    for step in range(steps):
+        m = int(rng.integers(1, rows + 1))
+        yield [pool[int(j)] for j in rng.integers(0, len(pool) if step % 3 else 3, size=m)]
+
+
+def test_project_eager_equals_matmul():
+    k, n, rows = 512, 1280, 6
+    lins = {1: _lin(k, n, 5, 1), 14: _lin(k, n, 4, 2)}
+    pc = EP.PCache([1, 14], lins, n, rows, 13, DEV)
+    for step, keys in enumerate(_stream(150, rows, 0)):
+        new = pc.plan({1: keys, 14: keys})
+        x = torch.stack([_row(key, k) for key in keys]).to(DEV)
+        for pos, L in enumerate((1, 14)):
+            got = pc.project(pos, x, torch.bfloat16)
+            assert torch.equal(_bits(got), _bits(lins[L](x, out_dtype=torch.bfloat16))), (step, L)
+        torch.cuda.synchronize()                    # the arm's sync: the next plan rewrites pinned memory
+        if step == 40:
+            pc.forget(new)
+    assert pc.stats["skipped"] > 0 and pc.stats["skipped"] < pc.stats["windows"]
+
+
+def test_project_in_a_cuda_graph():
+    """One capture of the projection over R padded rows; each replay a new plan (all hit, some, none)."""
+
+    k, n, rows = 512, 1280, 4
+    lin = _lin(k, n, 5, 7)
+    pc = EP.PCache([1], {1: lin}, n, rows, 9, DEV)
+    xs = torch.zeros((rows, k), dtype=torch.bfloat16, device=DEV)
+    pc.plan({1: [b"warm"]})
+    s = torch.cuda.Stream()
+    s.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(s):
+        pc.project(0, xs, torch.bfloat16)           # Triton compiled outside the capture
+    torch.cuda.current_stream().wait_stream(s)
+    torch.cuda.synchronize()
+    pc.forget({1: [b"warm"]})
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        out = pc.project(0, xs, torch.bfloat16)
+    skipped = 0
+    for step, keys in enumerate(_stream(120, rows, 1)):
+        torch.cuda.synchronize()
+        pc.plan({1: keys})
+        skipped += int(pc.host_np[0, 0])
+        x = torch.stack([_row(key, k) for key in keys] + [_row(b"pad", k)] * (rows - len(keys))).to(DEV)
+        xs.copy_(x)
+        g.replay()
+        want = lin(x[:len(keys)], out_dtype=torch.bfloat16)
+        assert torch.equal(_bits(out[:len(keys)]), _bits(want)), (step, keys)
+    assert 0 < skipped < 120
+
+
+# -- the forward ---------------------------------------------------------------------------------------------------
+LONG = 4096
+SETTINGS = {"on": True, "budget_s": 120.0, "max_graphs": 64, "bucket": 2048, "slots": 4, "warm": "decode"}
+PROMPT = [int(t) for t in np.random.default_rng(33).integers(3, 250, size=180)]
+WINDOWS = [tuple(int(t) for t in np.random.default_rng(50 + i).integers(3, 250, size=w))
+           for i, w in enumerate((1, 4, 2, 6, 3, 1, 5, 2))]
+
+
+@pytest.fixture(autouse=True)
+def _seams(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")       # the mHC / Engram kernels are laid out for D = 5,120
+    monkeypatch.setenv("TF_DSV41_DENSE", "0")
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    import dsv41_dspark_fakes as DF
+
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41pcg"))
+
+
+@pytest.fixture(scope="module")
+def packed(ck, tmp_path_factory):
+    import dsv41_fakes as FK
+
+    return FK.write_engram(tmp_path_factory.mktemp("pcache-shards-g"), ck[1], ck[2], 1)
+
+
+def _fw(ck, packed, monkeypatch, gate: bool, pcache: int = 0):
+    import dsv41_dspark_fakes as DF
+
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+
+    monkeypatch.setenv("TF_DSV41_ENGRAM_GATE", "1" if gate else "0")
+    monkeypatch.setenv(EP.KNOB, str(pcache))
+    rows = EH.open_shards(packed, 0, 1, ck[1].engram_layer_ids, dim=ck[1].engram_head_dim)
+    fw = DF.forward(ck, slots=1, limit=LONG, device=DEV, chunk=128, prefetch=True, rows=rows)
+    assert (fw.gate is not None) == gate and (not gate or (fw.gate.pc is not None) == (pcache > 0))
+    return fw
+
+
+def _pass(fw, b, run):
+    from tensorfold.families.deepseek_v41.cuda.forward import Seg
+    from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+
+    b.ex.slots[0].ensure(LONG)
+    fw.reset(0)
+    fw.prefill([Piece(0, 0, tuple(PROMPT))], mode="full")
+    out = []
+    for ids in WINDOWS:
+        out.append(run([Seg(0, fw.slots[0].pos, ids)]).clone())
+        if fw.gate is not None:
+            fw.gate.check()
+        fw.keep(0, len(ids) - 1)
+    return out
+
+
+@pytest.mark.parametrize("graphs", [False, True])
+def test_forward_with_pcache_equals_no_gate(ck, packed, monkeypatch, graphs):
+    import dsv41_dspark_fakes as DF
+
+    from tensorfold.families.deepseek_v41.cuda import graphs as G
+
+    e = _fw(ck, packed, monkeypatch, False)
+    be = DF.batcher(ck, e, capacity=LONG, pool_tokens=2 * LONG)
+    ref = _pass(e, be, e.run)
+    g = _fw(ck, packed, monkeypatch, True, pcache=64)
+    bg = DF.batcher(ck, g, capacity=LONG, pool_tokens=2 * LONG)
+    run = g.run
+    if graphs:
+        g.graphs = G.CudaGraphs(g, settings=SETTINGS)
+        g.graphs.warmup(1, lambda s, end: bg.ex.slots[s].ensure(end))
+        run = g.graphs.run
+    for rep in range(3):                            # rep 1, 2: the same windows at the same contexts: all hit
+        got = _pass(g, bg, run)
+        for i, (a, b) in enumerate(zip(got, ref)):
+            assert torch.equal(a, b), (rep, i, len(WINDOWS[i]))
+    st, nl = g.gate.pc.stats, len(g.gate.layers)
+    assert st["skipped"] >= 2 * nl * len(WINDOWS), g.gate.describe()
+    if graphs:
+        assert g.graphs.cache.stats["replays"] > 0 and g.graphs.cache.stats["failed"] == 0
+    print(g.gate.describe())
diff --git a/tests/cuda/test_dsv41_fused_proj_gpu.py b/tests/cuda/test_dsv41_fused_proj_gpu.py
new file mode 100644
index 0000000..884936f
--- /dev/null
+++ b/tests/cuda/test_dsv41_fused_proj_gpu.py
@@ -0,0 +1,183 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G7: the fused attention projections (``fused_proj`` / ``x3seg.cu``, TF_DSV41_FUSED_PROJ) on the GPU, bit for bit
+against upstream's ``Exl3Linear`` one projection at a time:
+
+- random trellises at the real shapes and widths (x: wq_a + wkv + compressor wkv / wgate, 5 and 6 bits; qr: wq_b's
+  8-warp plan + the indexer's 4-warp plan in one launch; wo_a's 4 groups from column slices of o), R = 1..16, 64,
+  128 and 130 (row blocks), bf16 and fp32 outputs; a CUDA graph replayed on new inputs, counters left at zero;
+- the real weights (``TF_DSV41_TEST_MODEL``, default /model when it holds config.json; rank ``TF_DSV41_TEST_RANK``),
+  every layer (``TF_DSV41_FP_LAYERS``, default all), R = 1..16, at TF_DSV41_PROJ_PLAN upstream and long: every
+  dense output of ``blocks.attention`` (wq_a, wkv, the compressor's [kv | score], wq_b, indexer wq_b, wo_a, wo_b)
+  fused == unfused, and the rows of a 16-row window == the same rows in R-row windows (row invariance); long's
+  drift from upstream's bits (fp32 reordering) is printed; [G7] ms lines.
+"""
+
+from __future__ import annotations
+
+import os
+import time
+from pathlib import Path
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA")
+
+BF, F32 = torch.bfloat16, torch.float32
+
+
+def _lin(k: int, n: int, bits: int, seed: int):
+    from tensorfold.cuda.exl3.linear import Exl3Linear
+
+    g = torch.Generator().manual_seed(seed)
+    tr = torch.randint(-32768, 32767, (k // 16, n // 16, 16 * bits), generator=g, dtype=torch.int32).to(torch.int16)
+    suh = torch.where(torch.rand(k, generator=g) < 0.5, -1.0, 1.0).to(torch.float16)
+    svh = (torch.rand(n, generator=g) * 0.02 + 0.01).to(torch.float16)
+    return Exl3Linear.from_tensors(tr, suh, svh, "mul1", device="cuda")
+
+
+def _ref(lins, xs, outs, dtype):
+    bufs: dict[int, list] = {}
+    for lin, x, o in zip(lins, xs, outs):
+        y = torch.empty((x.shape[0], lin.n), dtype=dtype, device="cuda")
+        for a in range(0, x.shape[0], 128):
+            lin(x[a:a + 128].contiguous(), out=y[a:a + 128])
+        bufs.setdefault(o, []).append(y)
+    return [torch.cat(bufs[o], 1) for o in sorted(bufs)]
+
+
+GROUPS = {
+    "x4": ([(5120, 1280, 5), (5120, 512, 5), (5120, 512, 5), (5120, 512, 5)], [0, 1, 2, 2]),
+    "x2_l0": ([(5120, 1280, 6), (5120, 512, 6)], [0, 1]),
+    "q": ([(1280, 16384, 5), (1280, 4096, 5)], [0, 1]),
+    "o": ([(4096, 1024, 5)] * 4, [0, 0, 0, 0]),
+}
+
+
+@pytest.fixture(scope="module")
+def groups():
+    from tensorfold.families.deepseek_v41.cuda import fused_proj as FP
+
+    out = {}
+    for i, (name, (shapes, outs)) in enumerate(GROUPS.items()):
+        lins = [_lin(k, n, b, 100 * i + j) for j, (k, n, b) in enumerate(shapes)]
+        out[name] = (lins, outs, FP.Fused(lins, outs))
+    return out
+
+
+def _inputs(name, lins, R, gen):
+    if name == "o":
+        o = (torch.randn((R, 4 * 4096), generator=gen, device="cuda") * 0.3).to(BF)
+        return [o[:, g * 4096:(g + 1) * 4096] for g in range(4)]
+    x = torch.randn((R, lins[0].k), generator=gen, device="cuda").to(BF)
+    return [x] * len(lins)
+
+
+@pytest.mark.parametrize("name", list(GROUPS))
+def test_fused_equals_upstream_random_weights(groups, name):
+    lins, outs, fused = groups[name]
+    gen = torch.Generator(device="cuda").manual_seed(3)
+    for R in [*range(1, 17), 64, 128, 130]:
+        xs = _inputs(name, lins, R, gen)
+        for dtype in (BF, F32) if R in (1, 5, 16, 130) else (BF,):
+            got = fused(xs, dtype)
+            want = _ref(lins, xs, outs, dtype)
+            assert all(torch.equal(a, b) for a, b in zip(got, want)), (name, R, dtype)
+    for f in (fused,):
+        assert not (f.counters != 0).any()
+
+
+def test_graph_replay_and_counters(groups):
+    lins, outs, fused = groups["x4"]
+    gen = torch.Generator(device="cuda").manual_seed(4)
+    x = torch.randn((3, 5120), generator=gen, device="cuda").to(BF)
+    s = torch.cuda.Stream()
+    s.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(s):
+        fused(x, BF)
+    torch.cuda.current_stream().wait_stream(s)
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        ys = fused(x, BF)
+    for _ in range(3):
+        x.copy_(torch.randn((3, 5120), generator=gen, device="cuda").to(BF))
+        g.replay()
+        torch.cuda.synchronize()
+        want = _ref(lins, [x] * 4, outs, BF)
+        assert all(torch.equal(a, b) for a, b in zip(ys, want))
+        assert not (fused.counters != 0).any()
+
+
+def _ms(fn, n=100):
+    for _ in range(5):
+        fn()
+    torch.cuda.synchronize()
+    t0 = time.perf_counter()
+    for _ in range(n):
+        fn()
+    torch.cuda.synchronize()
+    return 1e3 * (time.perf_counter() - t0) / n
+
+
+def test_fused_launch_ms(groups):
+    gen = torch.Generator(device="cuda").manual_seed(5)
+    for name, (lins, outs, fused) in groups.items():
+        xs = _inputs(name, lins, 1, gen)
+        t_f = _ms(lambda xs=xs, fused=fused: fused(xs, BF))
+        t_u = _ms(lambda xs=xs, lins=lins, outs=outs: _ref(lins, xs, outs, BF))
+        print(f"[G7] fused_proj {name} R=1 (eager, random weights): {t_u * 1e3:.1f} -> {t_f * 1e3:.1f} us")
+
+
+# -- the real weights -----------------------------------------------------------------------------------------------
+def _model() -> Path | None:
+    p = Path(os.environ.get("TF_DSV41_TEST_MODEL", "/model"))
+    return p if (p / "config.json").is_file() else None
+
+
+@pytest.mark.skipif(_model() is None, reason="TF_DSV41_TEST_MODEL: the checkpoint folder")
+@pytest.mark.parametrize("plan", ["upstream", "long"])
+def test_real_layers_fused_equals_unfused_r1_to_16(plan):
+    from tensorfold.families.deepseek_v41.cuda import projbench as PB
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+    from tensorfold.families.deepseek_v41.cuda.config import Config
+
+    root = _model()
+    cfg = Config.from_file(root / "config.json")
+    rank = int(os.environ.get("TF_DSV41_TEST_RANK", "0"))
+    raw = os.environ.get("TF_DSV41_FP_LAYERS", "all")
+    layers = range(cfg.num_hidden_layers) if raw == "all" else [int(v) for v in raw.split(",")]
+    ld = W.Loader(cfg, W.Shards(root), rank, 2, "cuda")
+    gen = torch.Generator(device="cuda").manual_seed(rank)
+    t_u = t_f = 0.0
+    drift = 0.0
+    for L in layers:
+        A = PB.attn_of(cfg, ld, L, "cuda")
+        ref = PB.set_plan([(L, A)], "upstream")[0][2] if plan != "upstream" else None
+        (_, _, G), = PB.set_plan([(L, A)], plan)
+        assert G is not None and G.o is not None, L
+        assert (G.x4 is not None) == (A.comp_wkv is not None) and (G.q is not None) == (A.ix_wq_b is not None), L
+        x16 = torch.randn((16, cfg.hidden_size), generator=gen, device="cuda").to(BF)
+        qr16 = torch.randn((16, cfg.q_lora_rank), generator=gen, device="cuda").to(BF)
+        o16 = (torch.randn((16, 16384), generator=gen, device="cuda") * 0.3).to(BF)
+        whole = PB.dense(A, G, x16, qr16, o16, True)
+        for R in range(1, 17):
+            x, qr, o = x16[:R], qr16[:R], o16[:R]
+            want = PB.dense(A, G, x, qr, o, False)
+            got = PB.dense(A, G, x, qr, o, True)
+            assert len(got) == len(want) and all(torch.equal(a, b) for a, b in zip(got, want)), (plan, L, R)
+            assert all(torch.equal(a, b[:R]) for a, b in zip(got, whole)), (plan, L, R)   # rows of a window
+        if ref is not None:                                   # the other plan's outputs, at fp32 rounding
+            PB.set_plan([(L, A)], "upstream")
+            base = PB.dense(A, None, x16, qr16, o16, False)
+            for a, b in zip(whole, base):
+                drift = max(drift, ((a.float() - b.float()).abs().max() / b.float().abs().max()).item())
+            PB.set_plan([(L, A)], plan)
+        x, qr, o = x16[:1], qr16[:1], o16[:1]
+        t_u += _ms(lambda A=A, G=G, x=x, qr=qr, o=o: PB.dense(A, G, x, qr, o, False), 20)
+        t_f += _ms(lambda A=A, G=G, x=x, qr=qr, o=o: PB.dense(A, G, x, qr, o, True), 20)
+        del A, G
+    assert drift < 2e-2
+    print(f"[G7] fused_proj plan {plan}, real layers {list(layers)[:3]}..{list(layers)[-1]} rank {rank}: R = 1..16 "
+          f"fused == unfused and rows of a window == alone, bit for bit; drift vs upstream {drift:.2e}; dense ms "
+          f"(eager, R=1, sum) {t_u:.2f} -> {t_f:.2f}")
