+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Single-Pass mHC for DeepSeek-V4.1-Flash on sm_121: one pass over the 4 residual streams a sublayer boundary.
+
+Math (vLLM ``model_executor/kernels/mhc/torch.py: mhc_pre_delayed_torch / mhc_post_torch``, Apache-2.0, cited for the
+math only; ``engine/reference/hc.py``): a boundary after sublayer X (its coefficients ``post_X``, ``comb_X``, ``pre_X``
+were computed before X ran) does
+
+    X'_j = bf16(post_X[j] * branch + (((comb_X[0, j] X_0 + comb_X[1, j] X_1) + comb_X[2, j] X_2) + comb_X[3, j] X_3))
+    c    = bf16(((pre_X[0] X'_0 + pre_X[1] X'_1) + pre_X[2] X'_2) + pre_X[3] X'_3)      the NEXT sublayer's input
+    mix  = (X'.flat . fn_{X+1}) * rsqrt(mean(X'.flat^2) + eps)                          the next site's 24 mixes
+
+and the next site's input is ``bf16((c * rsqrt(mean(c^2) + eps)) * norm_w)``. The pre-mix used to collapse is the
+*previous* site's (V4.1's delayed / Single-Pass form, TR 2.4.1), so the collapse needs nothing from this pass's dots:
+the streams are read once and written once a boundary (GLM ran hc_post, then hc_pre's partials over the written
+streams, then the finish: 0320 / 0520 / 0190). ``branch = bf16(sum of the ranks' fp32 partials, rank 0 first)``.
+
+Arithmetic (everything here is fixed by the shapes, never by the row count; kernels launch with
+``enable_fp_fusion=False`` so every written ``a * b + c`` is a rounded product and a rounded sum, as in the torch
+emulation in ``tests/dsv41_kref.py``):
+
+- ``_site``: program (16-row tile, column block b of CB = D / NB columns of all four streams). Per stream j and block
+  b, the 24 mixes are an FMA chain over the block's columns in ascending order from 0 (``tl.dot`` ieee on fp32: one
+  ``fma.rn.f32`` an element a column), and the stream's square sum is the FMA chain of the exact squares (a bf16
+  squared is exact in fp32) against ones; the collapsed row's square sum likewise. No reduction tree anywhere: a row's
+  partials are the same in any tile, for any BM / BK.
+- ``_finish``: one program a row; the 4 x NB partials summed in (stream, block) order, then pre / post / comb
+  (sigmoid, softmax, 20 Sinkhorn iterations; ``tl.exp`` is the hardware approximation: these coefficients are within
+  tolerance of torch, not bitwise), and the normed input with IEEE ``sqrt_rn`` / ``div_rn``.
+
+No atomics; rows never mix. Batched == alone, verify == serial: bit for bit.
+
+Interface (all tensors CUDA, rows contiguous; R rows; D = 5,120; ``world`` = TP ranks of the gathered partials):
+
+    Coefs(rows, device)                  pre / post fp32 [R, 4], comb fp32 [R, 16] (comb[i, j] at i * 4 + j): one site's
+                                         coefficients, made by the site's finish, consumed by the boundary after it
+    Scratch(rows, device)                partials [R, 4, NB, 32] fp32 (655 KB at R = 32) + the collapsed row [R, D] bf16
+
+    site(x, hc, norm_w, out, coefs, scratch, pre_in=None)
+        no post (model / DSpark entry, after Engram): the site's coefficients from the streams x [R, 4 D] bf16, the
+        sublayer input out [R, D] bf16 = norm(collapse(x, pre_in)); pre_in None = stream 0
+    boundary(x, xout, gathered, prev, hc, norm_w, out, coefs, scratch, tap=None)
+        the single pass after a sublayer: xout = post(x, branch, prev.post, prev.comb) (x and xout may alias),
+        out = norm(collapse(xout, prev.pre)), coefs = the next site's; ``tap`` [R, D] bf16 view (row stride any):
+        the streams' mean (DSpark taps at the entries of layers 37-39)
+    post_only(x, xout, gathered, prev, tap=None)       the post alone (before an Engram layer: Engram then ``site``)
+    final(x, xout, gathered, prev, norm_w, out, scratch)
+        the last post, then hidden = collapse(xout, prev.pre) (in ``scratch.c``, bf16, pre-norm: the DSpark
+        confidence head reads it) and out = norm(hidden) with the model's final norm
+
+    hc = Hc(fn fp32 [24, 4 D] contiguous, base fp32 [24], scale fp32 [3]); gathered fp32 [world, R, D] (rows
+    contiguous, any rank stride): the sublayer's per-rank partial outputs, summed rank 0 first then rounded to bf16;
+    or bf16 (``TF_DSV41_PREFILL_GATHER=bf16``: the kit-rounded partials as exchanged), widened as they load.
+
+Per block: ``boundary`` x 2 (attention, FFN) and 2 finishes inside them: 4 launches a block (GLM's unfused: 6).
+G7 decode (bit for bit the same): launches of at most ``split_rows()`` rows run a program a stream when the boundary
+writes another buffer than it reads (the forward's ``Streams.alt``) or for a ``site``; the finish's sums unrolled.
+
+Staged and tested in the development tree (unpublished) (engine/kernels/mhc: interpreter + sm_121a compile tests); the torch
+emulations the tests compare with are in tests/dsv41_kref.py.
+"""
+
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+
+import torch
+import triton
+import triton.language as tl
+
+from . import mhc_cuda as MC
+from . import mhc_dec as MD
+from . import mhc_pf as MP
+
+S = 4             # streams
+NMIX = 24         # 2 S + S^2
+BM = 16           # rows a program (tl.dot's minimum M; no effect on bits)
+BK = 16           # columns a step (no effect on bits: the FMA chains run in column order whatever the step)
+NB = 40           # column blocks of every stream (5,120 / 40 = 128 columns: 8 steps). Part of the arithmetic
+WARPS = 8         # with BK 16: 152 registers, no spills (BK 32 or 4 warps spill)
+FIN_BLOCK = 1024  # columns a step of the finish's norm (elementwise: no effect on bits)
+
+
+def _knob(name: str, default: str) -> str:
+    import os
+
+    return os.environ.get(name, "").strip() or default
+
+
+def split_rows() -> int:
+    """G7 decode: boundaries / sites of at most ``TF_DSV41_MHC_SPLIT_ROWS`` rows (32; 0 = never) run a program a
+    stream (``_site`` SPLIT): bit for bit the same, 4 x the programs. A boundary splits only out of place (the
+    forward's ``Streams.alt``): in place, a stream's program would overwrite columns another stream's program still
+    reads."""
+
+    return int(_knob("TF_DSV41_MHC_SPLIT_ROWS", "32"))
+
+
+def out_of_place(rows: int) -> bool:
+    """Should the forward give the boundaries of a ``rows``-row window a second streams buffer (``split_rows``)."""
+
+    return 0 < rows <= split_rows()
+
+
+def unroll() -> bool:
+    """``TF_DSV41_MHC_UNROLL`` (1, the default; 0 = the rolled loops): ``_finish_k``'s sums unrolled, same order."""
+
+    return _knob("TF_DSV41_MHC_UNROLL", "1") != "0"
+
+
+def fin2() -> bool:
+    """``TF_DSV41_MHC_FIN2`` (1, the default; 0 = G7's order): ``_finish_k`` stores the normed input before the
+    coefficients, its steps unrolled. Bit for bit the same."""
+
+    return _knob("TF_DSV41_MHC_FIN2", "1") != "0"
+
+
+def fin_warps() -> int:
+    """``TF_DSV41_MHC_FIN_WARPS`` (4; 1 / 2 / 8): the finish's warps. Not 4 may change the coefficients' last bits (the
+    Sinkhorn's [4, 4] sums take another layout's order): a numerics knob for the G9 gate, not a bit-for-bit one."""
+
+    w = int(_knob("TF_DSV41_MHC_FIN_WARPS", "4"))
+    if w not in (1, 2, 4, 8):
+        raise ValueError(f"TF_DSV41_MHC_FIN_WARPS={w} (1 / 2 / 4 / 8)")
+    return w
+
+
+def tile(rows: int) -> tuple[int, int]:
+    """(BM, warps) of a launch over ``rows`` rows. G7: windows of at least ``TF_DSV41_MHC_ROWS`` rows (256: prefill
+    segments, never a verify window or a graph) take ``TF_DSV41_MHC_BM`` rows a program (16 = unchanged; 32 / 64)
+    with ``TF_DSV41_MHC_WARPS`` warps (8). G5 nsys: ``_site`` is 3.3-3.9 ms a 2,048-row boundary (~3x its DRAM
+    floor) in 5,120 programs of one 16 x 16 tile a step. BM does not change a bit: each row's FMA chains run in
+    column order whatever the tile (tests/test_dsv41_prefill2_interp.py)."""
+
+    import os
+
+    if rows < int(os.environ.get("TF_DSV41_MHC_ROWS", "") or 256):
+        return BM, WARPS
+    bm = int(os.environ.get("TF_DSV41_MHC_BM", "") or BM)
+    warps = int(os.environ.get("TF_DSV41_MHC_WARPS", "") or WARPS)
+    if bm not in (16, 32, 64) or warps not in (4, 8, 16):
+        raise ValueError(f"TF_DSV41_MHC_BM={bm} (16 / 32 / 64), TF_DSV41_MHC_WARPS={warps} (4 / 8 / 16)")
+    return bm, warps
+
+
+@triton.jit
+def _chain(v, w, acc):
+    """acc[m, n] = fma(v[m, k], w[k, n], acc) for k ascending: the ieee fp32 dot's FMA chain."""
+
+    return tl.dot(v, w, acc, input_precision="ieee")
+
+
+@triton.jit
+def _mix_step(v, FN, col, mm, ones, acc, sq, WIDE: tl.constexpr):
+    """One stream tile v [BM, BK] (fp32 holding bf16 values): acc += v fn^T (24 mixes in 32 columns), sq += v^2 . 1."""
+
+    w = tl.load(FN + mm[None, :] * WIDE + col[:, None], mask=mm[None, :] < 24, other=0.0)      # [BK, 32]
+    acc = _chain(v, w.to(tl.float32), acc)              # fn fp32, or bf16 (TF_DSV41_MHC_FN: widened exactly)
+    sq = _chain(v * v, ones, sq)
+    return acc, sq
+
+
+@triton.jit
+def _site(X, x_stride, XOUT, G, g_rank, POST, COMB, PRE, FN, PART, C, TAP, tap_stride, R,
+          D: tl.constexpr, NB: tl.constexpr, BM: tl.constexpr, BK: tl.constexpr, WORLD: tl.constexpr,
+          POST_ON: tl.constexpr, COLLAPSE: tl.constexpr, MIX: tl.constexpr, TAP_ON: tl.constexpr,
+          SPLIT: tl.constexpr):
+    """Program (row tile, column block b[, stream j when SPLIT]).
+
+    POST_ON: the new streams from X (rows ``x_stride`` apart), the gathered partials G [WORLD, R, D] (``g_rank``
+    apart) and POST [R, 4] / COMB [R, 16] (comb[i, j] at i * 4 + j), stored to XOUT [R, 4 D]; else the streams are X.
+    COLLAPSE 1: c = stream 0 (model / DSpark entry); 2: c = sum_i PRE[i] X'_i; stored bf16 to C [R, D].
+    MIX: the next site's partials PART [R, 4, NB, 32]: [0:24] mixes, [24] the stream's square sum, and at stream 0
+    [25] the collapsed row's square sum. TAP_ON: TAP[r] = bf16((((X'_0 + X'_1) + X'_2) + X'_3) * 0.25) (DSpark taps).
+    SPLIT (G7 decode; MIX, XOUT not X): grid axis 2 is the stream j: the program stores X'_j and runs stream j's mix
+    and square chains only (the same chains: same values, same order); stream 0's program also stores the collapsed
+    row, its square sum and the taps. 4 x the programs, a quarter of the chain each: a 1-row boundary had 40.
+    """
+
+    pid = tl.program_id(0)
+    b = tl.program_id(1)
+    j = tl.program_id(2)            # SPLIT: this program's stream (0 without SPLIT)
+    lead = j == 0
+    WIDE: tl.constexpr = 4 * D
+    CB: tl.constexpr = D // NB
+    rows = pid * BM + tl.arange(0, BM)
+    ok = rows < R
+    rr = tl.where(ok, rows, 0).to(tl.int64)
+    kk = tl.arange(0, BK)
+    mm = tl.arange(0, 32)
+    ones = tl.full((BK, 16), 1.0, tl.float32)
+    xin = rr[:, None] * x_stride
+    xo = rr[:, None] * WIDE
+    if POST_ON:
+        cb = COMB + rr * 16
+        c00 = tl.load(cb + 0, mask=ok, other=0.0)
+        c01 = tl.load(cb + 1, mask=ok, other=0.0)
+        c02 = tl.load(cb + 2, mask=ok, other=0.0)
+        c03 = tl.load(cb + 3, mask=ok, other=0.0)
+        c10 = tl.load(cb + 4, mask=ok, other=0.0)
+        c11 = tl.load(cb + 5, mask=ok, other=0.0)
+        c12 = tl.load(cb + 6, mask=ok, other=0.0)
+        c13 = tl.load(cb + 7, mask=ok, other=0.0)
+        c20 = tl.load(cb + 8, mask=ok, other=0.0)
+        c21 = tl.load(cb + 9, mask=ok, other=0.0)
+        c22 = tl.load(cb + 10, mask=ok, other=0.0)
+        c23 = tl.load(cb + 11, mask=ok, other=0.0)
+        c30 = tl.load(cb + 12, mask=ok, other=0.0)
+        c31 = tl.load(cb + 13, mask=ok, other=0.0)
+        c32 = tl.load(cb + 14, mask=ok, other=0.0)
+        c33 = tl.load(cb + 15, mask=ok, other=0.0)
+        p0 = tl.load(POST + rr * 4 + 0, mask=ok, other=0.0)
+        p1 = tl.load(POST + rr * 4 + 1, mask=ok, other=0.0)
+        p2 = tl.load(POST + rr * 4 + 2, mask=ok, other=0.0)
+        p3 = tl.load(POST + rr * 4 + 3, mask=ok, other=0.0)
+    if COLLAPSE == 2:
+        q0 = tl.load(PRE + rr * 4 + 0, mask=ok, other=0.0)
+        q1 = tl.load(PRE + rr * 4 + 1, mask=ok, other=0.0)
+        q2 = tl.load(PRE + rr * 4 + 2, mask=ok, other=0.0)
+        q3 = tl.load(PRE + rr * 4 + 3, mask=ok, other=0.0)
+    a0 = tl.zeros((BM, 32), tl.float32)
+    a1 = tl.zeros((BM, 32), tl.float32)
+    a2 = tl.zeros((BM, 32), tl.float32)
+    a3 = tl.zeros((BM, 32), tl.float32)
+    s0 = tl.zeros((BM, 16), tl.float32)
+    s1 = tl.zeros((BM, 16), tl.float32)
+    s2 = tl.zeros((BM, 16), tl.float32)
+    s3 = tl.zeros((BM, 16), tl.float32)
+    sc = tl.zeros((BM, 16), tl.float32)
+    for t in range(CB // BK):
+        d = b * CB + t * BK + kk
+        m2 = ok[:, None]
+        x0 = tl.load(X + xin + d[None, :], mask=m2, other=0.0).to(tl.float32)
+        x1 = tl.load(X + xin + D + d[None, :], mask=m2, other=0.0).to(tl.float32)
+        x2 = tl.load(X + xin + 2 * D + d[None, :], mask=m2, other=0.0).to(tl.float32)
+        x3 = tl.load(X + xin + 3 * D + d[None, :], mask=m2, other=0.0).to(tl.float32)
+        if POST_ON:
+            g = tl.load(G + rr[:, None] * D + d[None, :], mask=m2, other=0.0).to(tl.float32)
+            for w in tl.static_range(1, WORLD):
+                g = g + tl.load(G + w * g_rank + rr[:, None] * D + d[None, :], mask=m2, other=0.0).to(tl.float32)
+            br = g.to(tl.bfloat16).to(tl.float32)
+            v0 = (p0[:, None] * br + (((c00[:, None] * x0 + c10[:, None] * x1) + c20[:, None] * x2)
+                                      + c30[:, None] * x3)).to(tl.bfloat16)
+            v1 = (p1[:, None] * br + (((c01[:, None] * x0 + c11[:, None] * x1) + c21[:, None] * x2)
+                                      + c31[:, None] * x3)).to(tl.bfloat16)
+            v2 = (p2[:, None] * br + (((c02[:, None] * x0 + c12[:, None] * x1) + c22[:, None] * x2)
+                                      + c32[:, None] * x3)).to(tl.bfloat16)
+            v3 = (p3[:, None] * br + (((c03[:, None] * x0 + c13[:, None] * x1) + c23[:, None] * x2)
+                                      + c33[:, None] * x3)).to(tl.bfloat16)
+            if SPLIT:
+                vj = tl.where(j == 0, v0, tl.where(j == 1, v1, tl.where(j == 2, v2, v3)))
+                tl.store(XOUT + xo + j * D + d[None, :], vj, mask=m2)
+            else:
+                tl.store(XOUT + xo + d[None, :], v0, mask=m2)
+                tl.store(XOUT + xo + D + d[None, :], v1, mask=m2)
+                tl.store(XOUT + xo + 2 * D + d[None, :], v2, mask=m2)
+                tl.store(XOUT + xo + 3 * D + d[None, :], v3, mask=m2)
+            x0 = v0.to(tl.float32)
+            x1 = v1.to(tl.float32)
+            x2 = v2.to(tl.float32)
+            x3 = v3.to(tl.float32)
+        if COLLAPSE > 0:
+            if COLLAPSE == 2:
+                cv = (((q0[:, None] * x0 + q1[:, None] * x1) + q2[:, None] * x2) + q3[:, None] * x3).to(tl.bfloat16)
+            else:
+                cv = x0.to(tl.bfloat16)
+            tl.store(C + rr[:, None] * D + d[None, :], cv, mask=m2 & lead)
+            cf = cv.to(tl.float32)
+            sc = _chain(cf * cf, ones, sc)
+        if TAP_ON:
+            tp = ((((x0 + x1) + x2) + x3) * 0.25).to(tl.bfloat16)
+            tl.store(TAP + rr[:, None] * tap_stride + d[None, :], tp, mask=m2 & lead)
+        if MIX:
+            if SPLIT:
+                xj = tl.where(j == 0, x0, tl.where(j == 1, x1, tl.where(j == 2, x2, x3)))
+                a0, s0 = _mix_step(xj, FN, j * D + d, mm, ones, a0, s0, WIDE)
+            else:
+                a0, s0 = _mix_step(x0, FN, d, mm, ones, a0, s0, WIDE)
+                a1, s1 = _mix_step(x1, FN, D + d, mm, ones, a1, s1, WIDE)
+                a2, s2 = _mix_step(x2, FN, 2 * D + d, mm, ones, a2, s2, WIDE)
+                a3, s3 = _mix_step(x3, FN, 3 * D + d, mm, ones, a3, s3, WIDE)
+    col0 = tl.arange(0, 16)[None, :] == 0
+    base = PART + (rr[:, None] * 4 * NB + b) * 32 + mm[None, :]
+    if MIX and SPLIT:
+        mine = tl.where(mm[None, :] == 24, tl.sum(tl.where(col0, s0, 0.0), 1)[:, None], a0)
+        mine = tl.where(mm[None, :] == 25, tl.sum(tl.where(col0, sc, 0.0), 1)[:, None], mine)
+        keep = (mm[None, :] < 25) | ((mm[None, :] == 25) & lead)
+        tl.store(base + j * (NB * 32), mine, mask=ok[:, None] & keep)
+    elif MIX:
+        first = tl.where(mm[None, :] == 24, tl.sum(tl.where(col0, s0, 0.0), 1)[:, None], a0)
+        first = tl.where(mm[None, :] == 25, tl.sum(tl.where(col0, sc, 0.0), 1)[:, None], first)
+        tl.store(base, first, mask=ok[:, None] & (mm[None, :] < 26))
+        tl.store(base + NB * 32, tl.where(mm[None, :] == 24, tl.sum(tl.where(col0, s1, 0.0), 1)[:, None], a1),
+                 mask=ok[:, None] & (mm[None, :] < 25))
+        tl.store(base + 2 * NB * 32, tl.where(mm[None, :] == 24, tl.sum(tl.where(col0, s2, 0.0), 1)[:, None], a2),
+                 mask=ok[:, None] & (mm[None, :] < 25))
+        tl.store(base + 3 * NB * 32, tl.where(mm[None, :] == 24, tl.sum(tl.where(col0, s3, 0.0), 1)[:, None], a3),
+                 mask=ok[:, None] & (mm[None, :] < 25))
+    elif COLLAPSE > 0:
+        tl.store(base + tl.zeros((BM, 32), tl.int32), tl.sum(tl.where(col0, sc, 0.0), 1)[:, None] +
+                 tl.zeros((BM, 32), tl.float32), mask=ok[:, None] & (mm[None, :] == 25))
+
+
+@triton.jit
+def _finish_k(PART, BASE, SCALE, PRE, POST, COMB, C, NW, OUT, eps, hc_eps, post_alpha,
+            D: tl.constexpr, NB: tl.constexpr, ITERS: tl.constexpr, COEF: tl.constexpr, BLOCK: tl.constexpr,
+            UNROLL: tl.constexpr, NORM_FIRST: tl.constexpr = False):
+    """Row r: the partials summed in (stream, block) order; COEF: pre / post / comb of the next site (PRE, POST
+    [R, 4], COMB [R, 16]); then OUT = bf16((c * (1 / sqrt(ssc / D + eps))) * NW) from the collapsed row C.
+    UNROLL (G7): the same sums in the same order, unrolled, so the 4 NB loads are issued ahead of the adds (the
+    rolled loop waits a load latency a step: ~10 us a 1-row finish). NORM_FIRST (G9, ``TF_DSV41_MHC_FIN2``): the normed
+    input first, its D / BLOCK steps unrolled (their loads issue together), then the coefficients: the same values
+    (the two parts share nothing but ``ssc``), the next matrix's input stored a Sinkhorn earlier."""
+
+    r = tl.program_id(0).to(tl.int64)
+    m = tl.arange(0, 32)
+    pr = PART + r * (4 * NB * 32)
+    ssc = 0.0
+    if UNROLL:
+        for bb in tl.static_range(NB):
+            ssc += tl.load(pr + bb * 32 + 25)
+    else:
+        for bb in range(NB):
+            ssc += tl.load(pr + bb * 32 + 25)
+    if NORM_FIRST:
+        rn = tl.div_rn(1.0, tl.sqrt_rn(tl.div_rn(ssc, 1.0 * D) + eps))
+        for t in tl.static_range(D // BLOCK):
+            d = t * BLOCK + tl.arange(0, BLOCK)
+            c = tl.load(C + r * D + d).to(tl.float32)
+            w = tl.load(NW + d).to(tl.float32)
+            tl.store(OUT + r * D + d, ((c * rn) * w).to(tl.bfloat16))
+    if COEF:
+        mix = tl.zeros((32,), tl.float32)
+        ss = 0.0
+        if UNROLL:
+            for j in tl.static_range(4 * NB):
+                mix += tl.load(pr + j * 32 + m)
+                ss += tl.load(pr + j * 32 + 24)
+        else:
+            for j in range(4 * NB):
+                mix += tl.load(pr + j * 32 + m)
+                ss += tl.load(pr + j * 32 + 24)
+        rinv = tl.div_rn(1.0, tl.sqrt_rn(tl.div_rn(ss, 4.0 * D) + eps))
+        mix = tl.where(m < 24, mix, 0.0) * rinv
+        s_pre = tl.load(SCALE + 0)
+        s_post = tl.load(SCALE + 1)
+        s_comb = tl.load(SCALE + 2)
+        sv = tl.arange(0, 4)
+        base = tl.load(BASE + m, mask=m < 24, other=0.0)
+        pre_l = tl.sum(tl.where(m[None, :] == sv[:, None], (mix * s_pre + base)[None, :], 0.0), axis=1)
+        post_l = tl.sum(tl.where(m[None, :] == (sv[:, None] + 4), (mix * s_post + base)[None, :], 0.0), axis=1)
+        pre = 1.0 / (1.0 + tl.exp(-pre_l)) + hc_eps
+        post = (1.0 / (1.0 + tl.exp(-post_l))) * post_alpha
+        ii = tl.arange(0, 4)[:, None]
+        jj = tl.arange(0, 4)[None, :]
+        flat = 8 + ii * 4 + jj
+        cl = tl.sum(tl.where(m[None, None, :] == flat[:, :, None], (mix * s_comb + base)[None, None, :], 0.0), axis=2)
+        ce = tl.exp(cl - tl.max(cl, axis=1)[:, None])
+        comb = ce / tl.sum(ce, axis=1)[:, None] + hc_eps
+        comb = comb / (tl.sum(comb, axis=0)[None, :] + hc_eps)
+        for _ in range(ITERS - 1):
+            comb = comb / (tl.sum(comb, axis=1)[:, None] + hc_eps)
+            comb = comb / (tl.sum(comb, axis=0)[None, :] + hc_eps)
+        tl.store(PRE + r * 4 + sv, pre)
+        tl.store(POST + r * 4 + sv, post)
+        tl.store(COMB + r * 16 + ii * 4 + jj, comb)
+    if not NORM_FIRST:
+        rn = tl.div_rn(1.0, tl.sqrt_rn(tl.div_rn(ssc, 1.0 * D) + eps))
+        for t in range(D // BLOCK):
+            d = t * BLOCK + tl.arange(0, BLOCK)
+            c = tl.load(C + r * D + d).to(tl.float32)
+            w = tl.load(NW + d).to(tl.float32)
+            tl.store(OUT + r * D + d, ((c * rn) * w).to(tl.bfloat16))
+
+
+DIMS = 5120
+EPS = 1e-20
+HC_EPS = 1e-6
+POST_ALPHA = 2.0
+ITERS = 20
+LAUNCH = {"enable_fp_fusion": False}     # every a * b + c is two roundings (the torch emulation's arithmetic)
+CONSTS = (EPS, HC_EPS, POST_ALPHA, ITERS)    # the finish's constants (mhc_cuda takes the same)
+
+
+@dataclass
+class Hc:
+    fn: torch.Tensor          # [24, 4 D] fp32
+    base: torch.Tensor        # [24] fp32
+    scale: torch.Tensor       # [3] fp32
+
+
+class Coefs:
+    def __init__(self, rows: int, device, *, pre=None, post=None, comb=None) -> None:
+        z = lambda n: torch.zeros((rows, n), dtype=torch.float32, device=device)
+        self.pre = z(4) if pre is None else pre
+        self.post = z(4) if post is None else post
+        self.comb = z(16) if comb is None else comb
+
+
+class Scratch:
+    def __init__(self, rows: int, device, dims: int = DIMS) -> None:
+        self.rows, self.dims = rows, dims
+        self.part = torch.zeros((rows, 4, NB, 32), dtype=torch.float32, device=device)
+        self.c = torch.empty((rows, dims), dtype=torch.bfloat16, device=device)
+
+    def nbytes(self) -> int:
+        return self.part.numel() * 4 + self.c.numel() * 2
+
+
+def scratch_bytes(rows: int, dims: int = DIMS) -> int:
+    return rows * (4 * NB * 32 * 4 + dims * 2)
+
+
+def _check(x: torch.Tensor, d: int, rows: int, scratch: Scratch | None) -> None:
+    if x.dtype != torch.bfloat16 or x.shape[1] != 4 * d or x.stride(1) != 1 or d % NB or (d // NB) % BK:
+        raise ValueError("mhc: streams bf16 [R, 4 D] unit-stride, D a multiple of NB * BK")
+    if scratch is not None and (rows > scratch.rows or scratch.dims != d):
+        raise ValueError("mhc: the scratch is too small")
+
+
+def _launch(x, xout, gathered, prev: Coefs | None, pre_in, hc: Hc | None, scratch: Scratch | None, tap, rows: int,
+            d: int, post_on: bool, collapse: int, mix: bool):
+    if rows == 0:
+        return
+    if mix and MP.enabled() and MP.run(x, xout, gathered, prev, pre_in, hc, scratch, tap, rows, post_on, collapse,
+                                       mix):
+        return                                  # G16 TF_DSV41_MHC_PF: a prefill segment's site in CUDA (same bits)
+    world = gathered.shape[0] if post_on else 1
+    if post_on and (gathered.dtype not in (torch.float32, torch.bfloat16) or gathered.stride(2) != 1
+                    or gathered.stride(1) != d):
+        raise ValueError("mhc: gathered fp32 (or bf16 partials, G7) [world, R, D] with contiguous rows")
+    if mix and (hc.fn.dtype not in (torch.float32, torch.bfloat16) or not hc.fn.is_contiguous()
+                or hc.fn.shape != (24, 4 * d)):
+        raise ValueError("mhc: fn fp32 (or bf16, TF_DSV41_MHC_FN) [24, 4 D] contiguous")
+    dummy = x
+    part = scratch.part if scratch is not None else dummy
+    c = scratch.c if scratch is not None else dummy
+    bm, warps = tile(rows)
+    split = mix and rows <= split_rows() and not (post_on and _overlap(x, xout))
+    if MD.applies(rows, mix, split):            # G9: the SPLIT launch restructured for <= 16 rows, bit for bit
+        MD.launch(x, xout, gathered, prev.post if post_on else None, prev.comb if post_on else None, pre_in, hc.fn,
+                  part, c, tap, rows, d, NB, BK, post_on, collapse, LAUNCH)
+        return
+    _site[(triton.cdiv(rows, bm), NB, 4 if split else 1)](
+        x, x.stride(0), xout if xout is not None else dummy, gathered if post_on else dummy,
+        gathered.stride(0) if post_on else 0, prev.post if post_on else dummy, prev.comb if post_on else dummy,
+        pre_in if collapse == 2 else dummy, hc.fn if mix else dummy, part, c,
+        tap if tap is not None else dummy, tap.stride(0) if tap is not None else 0, rows,
+        D=d, NB=NB, BM=bm, BK=BK, WORLD=world, POST_ON=post_on, COLLAPSE=collapse, MIX=mix,
+        TAP_ON=tap is not None, SPLIT=split, num_warps=warps, **LAUNCH)
+
+
+def _overlap(a: torch.Tensor, b: torch.Tensor | None) -> bool:
+    """Do two tensors' byte ranges overlap (the streams in place, or a view of them)."""
+
+    if b is None:
+        return True
+    a0, b0 = a.data_ptr(), b.data_ptr()
+    a1 = a0 + (a.shape[0] - 1) * a.stride(0) * a.element_size() + a.shape[1] * a.element_size()
+    b1 = b0 + (b.shape[0] - 1) * b.stride(0) * b.element_size() + b.shape[1] * b.element_size()
+    return a0 < b1 and b0 < a1
+
+
+def _finish(rows: int, d: int, scratch: Scratch, hc: Hc | None, coefs: Coefs | None, norm_w, out, coef: bool):
+    if rows == 0:
+        return
+    dummy = scratch.part
+    _finish_k[(rows,)](scratch.part, hc.base if coef else dummy, hc.scale if coef else dummy,
+                       coefs.pre if coef else dummy, coefs.post if coef else dummy, coefs.comb if coef else dummy,
+                       scratch.c, norm_w, out, EPS, HC_EPS, POST_ALPHA, D=d, NB=NB, ITERS=ITERS, COEF=coef,
+                       BLOCK=math.gcd(FIN_BLOCK, d), UNROLL=unroll(), NORM_FIRST=fin2(), num_warps=fin_warps(),
+                       **LAUNCH)
+
+
+def site(x: torch.Tensor, hc: Hc, norm_w: torch.Tensor, out: torch.Tensor, coefs: Coefs, scratch: Scratch,
+         pre_in: torch.Tensor | None = None) -> None:
+    rows, d = x.shape[0], norm_w.shape[0]
+    _check(x, d, rows, scratch)
+    if MC.run(x, None, None, None, pre_in, hc, norm_w, out, coefs, scratch, None, rows, False,
+              2 if pre_in is not None else 1, True, CONSTS):          # e1: one CUDA launch (TF_DSV41_MHC_CUDA)
+        return
+    _launch(x, None, None, None, pre_in, hc, scratch, None, rows, d, False, 2 if pre_in is not None else 1, True)
+    _finish(rows, d, scratch, hc, coefs, norm_w, out, True)
+
+
+def boundary(x: torch.Tensor, xout: torch.Tensor, gathered: torch.Tensor, prev: Coefs, hc: Hc, norm_w: torch.Tensor,
+             out: torch.Tensor, coefs: Coefs, scratch: Scratch, tap: torch.Tensor | None = None) -> None:
+    rows, d = gathered.shape[1], norm_w.shape[0]
+    _check(x, d, rows, scratch)
+    if coefs is prev:
+        raise ValueError("mhc.boundary: the next site's coefficients need their own buffers")
+    if MC.run(x, xout, gathered, prev, prev.pre, hc, norm_w, out, coefs, scratch, tap, rows, True, 2, True, CONSTS):
+        return
+    _launch(x, xout, gathered, prev, prev.pre, hc, scratch, tap, rows, d, True, 2, True)
+    _finish(rows, d, scratch, hc, coefs, norm_w, out, True)
+
+
+def post_only(x: torch.Tensor, xout: torch.Tensor, gathered: torch.Tensor, prev: Coefs,
+              tap: torch.Tensor | None = None) -> None:
+    rows, d = gathered.shape[1], gathered.shape[2]
+    _check(x, d, rows, None)
+    _launch(x, xout, gathered, prev, None, None, None, tap, rows, d, True, 0, False)
+
+
+def final(x: torch.Tensor, xout: torch.Tensor, gathered: torch.Tensor, prev: Coefs, norm_w: torch.Tensor,
+          out: torch.Tensor, scratch: Scratch, tap: torch.Tensor | None = None) -> None:
+    rows, d = gathered.shape[1], norm_w.shape[0]
+    _check(x, d, rows, scratch)
+    if MC.run(x, xout, gathered, prev, prev.pre, None, norm_w, out, None, scratch, tap, rows, True, 2, False, CONSTS):
+        return
+    _launch(x, xout, gathered, prev, prev.pre, None, scratch, tap, rows, d, True, 2, False)
+    _finish(rows, d, scratch, None, None, norm_w, out, False)
+
+
+__all__ = ["Coefs", "Hc", "Scratch", "boundary", "final", "post_only", "scratch_bytes", "site"]
