+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Milestone M1's gates on the real checkpoint, two ranks (run on both Sparks at once, like the server):
+
+    python -m tensorfold.families.deepseek_v41.cuda.gate --model DIR --rank R --master ADDR [--port P]
+        --capture oracle-kit.json --out report.json [--decode 256] [--prompts 8]
+
+1. teacher-forced top-1: our argmax after every prompt position against the kit's ``prompt_logprobs`` rank-1 token
+   (the oracle captured in the baseline window), over the whole 2,048 tokens and over each prompt's first copy (the
+   prompts repeat their text, so later copies are easy); also the kit's top-1 in our top-5 and the logprob error;
+2. greedy replies (``--decode`` tokens after each prompt's first copy), recorded for the comparison with the kit's
+   (the oracle has no kit replies: that comparison needs a kit capture of greedy replies);
+3. row invariance on the real weights: one prompt's logits in prefill windows of ``chunk`` rows == windows of 8 ==
+   one row at a time, bit for bit, on both ranks;
+4. serial decode tok/s (the floor: the kit's SPEC_METHOD=none);
+5. boot seconds (the engine's construction, prepared folder or checkpoint).
+
+Rank 0 writes the report; exit status 0 when gates 1 (whole prompts), 3 and 4 pass.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+TOP1 = 0.99
+DECODE_FLOOR = 23.0              # tok/s: the kit's serial decode (SPEC_METHOD=none), ENGINE-PLAN section 11 M1
+
+
+def period(ids: list[int]) -> int:
+    """The first copy's length after BOS (the capture repeats BOS + text to length), or the whole prompt."""
+
+    n = len(ids)
+    for k in range(1, n - 1):
+        if all(ids[1 + i] == ids[1 + i + k] for i in range(n - 1 - k)):
+            return k
+    return n - 1
+
+
+def mem_available_gib() -> float:
+    for line in open("/proc/meminfo"):
+        if line.startswith("MemAvailable:"):
+            return int(line.split()[1]) / 2 ** 20
+    return -1.0
+
+
+def first_divergence(a: list[int], b: list[int]) -> int:
+    for i, (x, y) in enumerate(zip(a, b)):
+        if x != y:
+            return i
+    return min(len(a), len(b))
+
+
+class Scorer:
+    """Per prompt row: our global top-1 / top-5, and our logprob of the kit's top-1 (both ranks call every step)."""
+
+    def __init__(self, eng) -> None:
+        self.eng = eng
+
+    def _gather(self, x):
+        import torch
+
+        from tensorfold.cuda.comm import fast_gather
+
+        x = x.contiguous()
+        out = torch.empty((2 * x.numel(),), dtype=x.dtype, device=x.device)
+        fast_gather(self.eng.comm, x.view(-1), out)
+        return out.view(2, *x.shape)
+
+    def rows(self, logits, kit_top1) -> tuple[list[int], list[list[int]], list[float]]:
+        import torch
+
+        from . import pick as P
+
+        fw = self.eng.fw
+        lg = logits.float()
+        vals, ids = P.top(lg, 5)
+        ids = ids + fw.vocab_lo
+        lse = torch.logsumexp(lg, -1)
+        local = kit_top1 - fw.vocab_lo
+        ok = (local >= 0) & (local < lg.shape[1])
+        at = torch.where(ok, lg.gather(1, local.clamp(0, lg.shape[1] - 1)[:, None])[:, 0],
+                         torch.full_like(lse, float("-inf")))
+        packed = torch.cat([vals, ids.to(torch.float32), lse[:, None], at[:, None]], 1)
+        g = self._gather(packed).cpu().double()
+        v = torch.cat([g[0, :, :5], g[1, :, :5]], 1)
+        t = torch.cat([g[0, :, 5:10], g[1, :, 5:10]], 1).long()
+        top5, top1 = [], []
+        for r in range(v.shape[0]):
+            o = sorted(range(10), key=lambda j: (-float(v[r, j]), int(t[r, j])))
+            top5.append([int(t[r, j]) for j in o[:5]])
+            top1.append(top5[-1][0])
+        gl = torch.logaddexp(g[0, :, 10], g[1, :, 10])
+        lp = torch.maximum(g[0, :, 11], g[1, :, 11]) - gl
+        return top1, top5, lp.tolist()
+
+
+def run(a, comm=None, device: str = "cuda") -> int:
+    import torch
+
+    from .engine import Dsv41Engine
+
+    t0 = time.time()
+    eng = Dsv41Engine(Path(a.model), rank=a.rank, master=a.master, port=a.port, context=a.context, comm=comm,
+                      device=device, serving=False)
+    cuda = eng.device.type == "cuda"
+    sync = torch.cuda.synchronize if cuda else (lambda: None)
+    boot = time.time() - t0
+    launch = float(os.environ.get("TF_DSV41_LAUNCH_T0", "0") or 0)
+    mem = {"after_boot_alloc_gib": round(torch.cuda.memory_allocated() / 2 ** 30, 2) if cuda else None,
+           "after_boot_reserved_gib": round(torch.cuda.memory_reserved() / 2 ** 30, 2) if cuda else None,
+           "mem_available_after_boot_gib": round(mem_available_gib(), 2)}
+    if cuda:
+        torch.cuda.reset_peak_memory_stats()
+    mins = [mem_available_gib()]
+    rec = json.loads(Path(a.capture).read_text()) if a.rank == 0 else None
+    if getattr(a, "profile", 0):        # debugging: where a serial decode step's time goes (rank 0 prints)
+        ids = eng._share(rec["prompts"][0]["ids"][:256] if a.rank == 0 else None)
+        eng.fw.reset()
+        lg = eng.fw.prompt(ids)
+        tok = int(eng.choose(lg, [len(ids)], None)[0])
+        for _ in range(8):
+            lg = eng.fw.step([tok])
+        sync()
+        from torch.profiler import ProfilerActivity, profile
+        with profile(activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA]) as prof:
+            t1 = time.time()
+            for _ in range(a.profile):
+                lg = eng.fw.step([tok])
+                tok = int(eng.choose(lg, [0], None)[0])
+            sync()
+            dt = (time.time() - t1) / a.profile
+        from .forward import Seg
+        t2 = time.time()
+        for _ in range(20):
+            eng.fw._engram_inputs([Seg(0, eng.fw.slots[0].pos, (tok,))])
+        sync()
+        te = (time.time() - t2) / 20
+        if a.rank == 0:
+            print(f"profile: {1e3 * dt:.1f} ms a step; Engram inputs (host hash + reads + gather) {1e3 * te:.2f} ms",
+                  flush=True)
+            print(prof.key_averages().table(sort_by="self_cpu_time_total", row_limit=40), flush=True)
+            print(prof.key_averages().table(sort_by="self_cuda_time_total", row_limit=30), flush=True)
+        return 0
+    if getattr(a, "trace", ""):         # debugging: the streams after every block for the first N tokens of prompts
+        n_tok, plist = a.trace.split(":")
+        n_tok = int(n_tok)
+        for p in [int(x) for x in plist.split(",")]:
+            ids = eng._share(rec["prompts"][p]["ids"][:n_tok] if a.rank == 0 else None)
+            eng.fw.reset()
+            eng.fw.trace = {}
+            out = []
+            for s0 in range(0, len(ids), eng.fw.chunk):
+                lg = eng.fw.step(ids[s0:s0 + eng.fw.chunk])
+                from .forward import greedy
+                out.append(greedy(eng.fw, lg).cpu())
+            if a.rank == 0:
+                torch.save({L: t.float().cpu() for L, t in eng.fw.trace.items()} | {"top1": torch.cat(out)},
+                           str(Path(a.out).parent / f"ours-p{p}-n{n_tok}.pt"))
+            eng.fw.trace = None
+        return 0
+    n = eng._share([min(a.prompts, len(rec["prompts"]))] if a.rank == 0 else None)[0]
+    sc = Scorer(eng)
+    report: dict = {"boot_s": round(boot, 1), "launch_to_ready_s": round(time.time() - launch, 1) if launch else None,
+                    "knobs": {k: v for k, v in sorted(os.environ.items()) if k.startswith(("TF_DSV41_", "GLM53_TF_"))},
+                    "prompts": []}
+    agree = total = first_agree = first_total = top5 = 0
+    errs: list[float] = []
+    for p in range(n):
+        ids = eng._share(rec["prompts"][p]["ids"] if a.rank == 0 else None)
+        kit = eng._share([(e["top"][0][0] if e and e.get("top") else -1)
+                          for e in rec["prompts"][p]["positions"]] if a.rank == 0 else None)
+        ours, ours5, lps = [], [], []
+
+        def every(start, logits, kit=kit, ids=ids):
+            nxt = torch.tensor([kit[start + i + 1] if start + i + 1 < len(ids) else -1
+                                for i in range(logits.shape[0])], device=logits.device)
+            t1, t5, lp = sc.rows(logits, nxt)
+            ours.extend(t1)
+            ours5.extend(t5)
+            lps.extend(lp)
+            mins.append(mem_available_gib())
+
+        eng.fw.reset()
+        tp = time.time()
+        eng.fw.prompt(ids, every=every)
+        sync()
+        prefill_s = time.time() - tp
+        per = period(ids)
+        pa = pt = fa = ft = 0
+        miss = []
+        for i in range(len(ids) - 1):
+            k = kit[i + 1]
+            if k < 0:
+                continue
+            hit = ours[i] == k
+            pa, pt = pa + hit, pt + 1
+            if not hit and a.rank == 0:
+                top = rec["prompts"][p]["positions"][i + 1]["top"]
+                miss.append([i + 1, k, ours[i], round(top[0][1] - top[1][1], 4) if len(top) > 1 else None,
+                             round(lps[i], 4)])
+            top5 += k in ours5[i]
+            errs.append(abs(lps[i] - rec["prompts"][p]["positions"][i + 1]["top"][0][1]) if a.rank == 0 else 0.0)
+            if i + 1 <= per:
+                fa, ft = fa + hit, ft + 1
+        agree, total, first_agree, first_total = agree + pa, total + pt, first_agree + fa, first_total + ft
+        reply: list[int] = []
+        stats = {"decode_tok_s": None}
+        if a.decode > 0:
+            stats = eng._run(ids[:1 + per], a.decode, None, False, lambda new: reply.extend(new) and False)
+        mins.append(mem_available_gib())
+        report["prompts"].append({"tokens": len(ids), "first_copy": per, "top1": pa / max(pt, 1),
+                                  "top1_first_copy": fa / max(ft, 1), "prefill_s": round(prefill_s, 2),
+                                  "prefill_tok_s": round(len(ids) / max(prefill_s, 1e-9), 1),
+                                  "greedy_reply": reply, "decode_tok_s": stats["decode_tok_s"],
+                                  "misses": miss})
+        if a.rank == 0:
+            print(f"prompt {p}: top-1 {pa / max(pt, 1):.4f} (first copy of {per}: {fa / max(ft, 1):.4f}), "
+                  f"prefill {prefill_s:.1f}s, decode {stats['decode_tok_s']} tok/s", flush=True)
+    # row invariance on the real weights: one prompt in windows of chunk / 8 / 1 rows
+    ids = eng._share(rec["prompts"][0]["ids"][:2 * eng.fw.chunk + 3] if a.rank == 0 else None)
+    if getattr(a, "invariance", True):
+        outs = []
+        for size in (eng.fw.chunk, 8, 1):
+            eng.fw.reset()
+            got = []
+            for s in range(0, len(ids), size):
+                got.append(eng.fw.step(ids[s:s + size]).clone())
+            outs.append(torch.cat(got))
+        same = [int(torch.equal(outs[0], outs[1])), int(torch.equal(outs[0], outs[2]))]
+        if not all(same):
+            for j, o in ((1, outs[1]), (2, outs[2])):
+                d = (o - outs[0]).abs().amax(-1)
+                bad = (d > 0).nonzero().flatten().tolist()
+                print(f"[rank {a.rank}] invariance: windows {(8, 1)[j - 1]}: {len(bad)} rows differ, first "
+                      f"{bad[:8]}, max |d| {float(d.max()):.3g}", flush=True)
+        both = eng._gather_ints(same)
+    else:
+        both = [[0, 0], [0, 0]]
+    invariant = all(both[0]) and all(both[1])
+    tok_s = [p["decode_tok_s"] for p in report["prompts"] if p["decode_tok_s"]]
+    report.update({
+        "top1_agreement": agree / max(total, 1), "top1_first_copy": first_agree / max(first_total, 1),
+        "kit_top1_in_our_top5": top5 / max(total, 1), "positions": total,
+        "median_abs_logprob_err": sorted(errs)[len(errs) // 2] if errs else None,
+        "row_invariance": {"windows_of_8": bool(both[0][0] and both[1][0]), "one_row": bool(both[0][1] and both[1][1]),
+                           "rows": len(ids)},
+        "decode_tok_s_median": sorted(tok_s)[len(tok_s) // 2] if tok_s else None,
+        "memory": {**mem, "peak_alloc_gib": round(torch.cuda.max_memory_allocated() / 2 ** 30, 2) if cuda else None,
+                   "peak_reserved_gib": round(torch.cuda.max_memory_reserved() / 2 ** 30, 2) if cuda else None,
+                   "workspace_peak_gib": round((torch.cuda.max_memory_allocated() - torch.cuda.memory_allocated())
+                                               / 2 ** 30, 2) if cuda else None,
+                   "mem_available_min_gib": round(min(mins), 2)},
+        "gates": {}})
+    mems = eng._gather_ints([int(report["memory"]["mem_available_min_gib"] * 100),
+                             int((report["memory"]["peak_reserved_gib"] or 0) * 100)])
+    report["memory"]["per_rank_mem_available_min_gib"] = [m[0] / 100 for m in mems]
+    report["memory"]["per_rank_peak_reserved_gib"] = [m[1] / 100 for m in mems]
+    if getattr(a, "kit_replies", "") and a.rank == 0:
+        kit_r = json.loads(Path(a.kit_replies).read_text())["replies"]
+        div = [first_divergence(p["greedy_reply"], k) for p, k in zip(report["prompts"], kit_r)]
+        full = [d >= min(len(p["greedy_reply"]), len(k)) for d, p, k in zip(div, report["prompts"], kit_r)]
+        report["greedy_vs_kit"] = {"first_divergence": div, "identical": full, "identical_n": sum(full)}
+    g = report["gates"]
+    g["top1"] = report["top1_agreement"] >= TOP1
+    g["row_invariance"] = invariant
+    g["decode_floor"] = (report["decode_tok_s_median"] or 0) >= DECODE_FLOOR
+    g["boot_le_90s"] = boot <= 90
+    g["boot_le_60s"] = boot <= 60
+    if "greedy_vs_kit" in report:
+        g["greedy_6_of_8"] = report["greedy_vs_kit"]["identical_n"] >= 6
+    report["pass"] = bool(g["top1"] and g["row_invariance"] and g["decode_floor"])
+    if a.rank == 0:
+        Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+        Path(a.out).write_text(json.dumps(report, indent=1))
+        print(json.dumps({k: v for k, v in report.items() if k != "prompts"}, indent=1), flush=True)
+    a.report = report
+    return 0 if report["pass"] else 1
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--rank", type=int, required=True)
+    ap.add_argument("--master", required=True)
+    ap.add_argument("--port", type=int, default=29561)
+    ap.add_argument("--capture", default="", help="the kit's oracle (rank 0)")
+    ap.add_argument("--out", default="m1-report.json")
+    ap.add_argument("--decode", type=int, default=256)
+    ap.add_argument("--prompts", type=int, default=8)
+    ap.add_argument("--context", type=int, default=4096)
+    ap.add_argument("--no-invariance", dest="invariance", action="store_false", help="skip gate 3 (A/B runs)")
+    ap.add_argument("--kit-replies", default="", help="the kit's greedy replies (oracle greedy capture), rank 0")
+    ap.add_argument("--profile", type=int, default=0, help="debugging: profile N serial decode steps")
+    ap.add_argument("--trace", default="", help="N:p,q debugging: save the streams after every block (rank 0)")
+    a = ap.parse_args(argv)
+    if a.rank == 0 and not a.capture:
+        ap.error("rank 0 needs --capture")
+    return run(a)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/src/tensorfold/families/deepseek_v41/cuda/gmbench.py b/src/tensorfold/families/deepseek_v41/cuda/gmbench.py
new file mode 100644
index 0000000..d0340a4
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/gmbench.py
@@ -0,0 +1,255 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Window G6's routed-expert prefill bench on one GPU: a real layer's routed experts (this rank's half, from the
+checkpoint) at prefill block widths, the three fast-prefill kernels side by side:
+
+- grouped: upstream's grouped kernels (the decode path's), 1,024-row blocks, the shared slot masked (``prefill_moe``);
+- tc: ``x3tc`` (Triton); gm: ``x3gm`` (CUDA, every configuration at the widest width);
+- per kernel: ms a call, TFLOP/s, trellis GB/s, the DRAM floor (``x3gm.floor_bytes`` at 235 GB/s) and its ratio;
+- gm's correctness on the real weights: vs grouped (rel max, the gate < 3e-3), a row subset == the same rows in the
+  block (row independence), repeats and every configuration bit for bit.
+
+    python -m tensorfold.families.deepseek_v41.cuda.gmbench --model DIR [--layers 3,20] [--rank 0]
+        [--rows 512,1024,2048,4096] [--iters 10] [--out gmbench.json]
+
+Rows come from the real router on random activations.
+
+G16 4K tile sweep (``--sweep``): every x3gm configuration (``x3gm.GU_TILES`` x ``DN_TILES`` that fit the layer's
+widths) at each row block (one block: ``rows`` = R), in the scratch arena the 4K path uses (``moe.arena_scratch``),
+bitwise against G6's pair at the same block, ms a call (median of ``--reps`` timings of ``--iters`` calls); the best
+pair a row block, and with ``--tune-out FILE`` the tuning table TF_DSV41_GM_TUNE reads (the 2,048-row entry stays
+G6's: the production numbers; the 4,096-row entry = the best pair over the layers, by total ms).
+
+    python -m tensorfold.families.deepseek_v41.cuda.gmbench --model DIR --sweep [--layers 3,20,30]
+        [--rows 2048,4096] [--tune-out gm_tune.json] [--out sweep.json]
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+GBPS = 235.0
+REL_GATE = 3e-3
+
+
+def _time(fn, iters: int) -> float:
+    import torch
+
+    fn()
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(iters):
+        fn()
+    b.record()
+    torch.cuda.synchronize()
+    return a.elapsed_time(b) / iters
+
+
+def bench_layer(model: str, layer: int, rank: int, rows, iters: int) -> dict:
+    import torch
+
+    from . import blocks as B
+    from . import experts as X
+    from . import router, x3gm, x3tc
+    from . import weights as W
+    from .config import Config
+
+    torch.cuda.set_device(0)
+    cfg = Config.from_file(Path(model) / "config.json")
+    m = W.Loader(cfg, W.Shards(model), rank, 2, "cuda").moe(layer, f"layers.{layer}")
+    block = B.gpu_experts(cfg, m, layer, 2, "cuda")
+    s = X.scratch(block, 1024)                     # the forward's shared scratch (1,024-row blocks, 7 slots)
+    _, topk = cfg.experts_of(layer)
+    E, lim = block.ex.count - block.geom.shared, cfg.swiglu_limit
+    shx = bool(torch.equal(m.w1.suh, m.w3.suh))
+    tbytes = sum(t.trellis.numel() * 2 for t in (m.w1, m.w3, m.w2))
+    gen = torch.Generator(device="cuda").manual_seed(200 + layer)
+    out: dict = {"layer": layer, "rank": rank, "k2_gu": x3gm.k2_of(m.w1.trellis), "k2_d": x3gm.k2_of(m.w2.trellis),
+                 "shx": shx, "trellis_gb": round(tbytes / 1e9, 3), "supported": x3gm.supported(m.w1, m.w3, m.w2),
+                 "rows": {}}
+    print(f"layer {layer} rank {rank}: K2 gu {out['k2_gu']} dn {out['k2_d']}, gate/up share suh: {shx}, "
+          f"routed trellis {out['trellis_gb']} GB", flush=True)
+    for R in rows:
+        x = (torch.randn((R, cfg.hidden_size), generator=gen, device="cuda") * 0.5).to(torch.bfloat16)
+        pick, wts = router.route(x, m.gate, m.bias, topk=topk, shared=True, scale=cfg.routed_scaling_factor)
+        pr, wr = pick[:, :topk].contiguous(), wts[:, :topk].float().contiguous()
+        pg, wg = pick.clone(), wts.clone()
+        pg[:, topk:] = block.ex.count
+        wg[:, topk:] = 0.0
+        cnt = torch.bincount(pr.reshape(-1).long(), minlength=E)
+
+        def grouped(x=x, pg=pg, wg=wg, R=R):
+            o = torch.empty((R, cfg.hidden_size), dtype=torch.float32, device="cuda")
+            for a in range(0, R, 1024):
+                b = min(R, a + 1024)
+                X.routed(x[a:b], pg[a:b], wg[a:b], block, s, o[a:b], b - a, limit=lim)
+            return o
+
+        def tc(x=x, pr=pr, wr=wr):
+            return x3tc.run(x, pr, wr, m.w1, m.w3, m.w2, lim, scratch=s)
+
+        def gm(c=None, x=x, pr=pr, wr=wr):
+            return x3gm.run(x, pr, wr, m.w1, m.w3, m.w2, lim, scratch=s, shx=shx, cfg=c)
+
+        floor = x3gm.floor_bytes(R, tbytes, topk, cfg.hidden_size, m.w1.trellis.shape[2] * 16, 1 if shx else 2)
+        row = {"members_mean": round(float(cnt.float().mean()), 1), "members_max": int(cnt.max()),
+               "floor_ms": round(floor / GBPS / 1e6, 3)}
+        ref = grouped()
+        got = gm()
+        row["gm_rel_vs_grouped"] = float((got - ref).abs().max() / ref.abs().max())
+        sub = torch.arange(0, R, 7, device="cuda")
+        row["gm_rows_independent"] = bool(torch.equal(
+            x3gm.run(x[sub], pr[sub], wr[sub], m.w1, m.w3, m.w2, lim, scratch=s, shx=shx), got[sub]))
+        row["gm_repeat"] = bool(torch.equal(gm(), got))
+        for name, fn in (("grouped", grouped), ("tc", tc), ("gm", gm)):
+            ms = _time(fn, iters if name != "tc" else max(2, iters // 4))
+            row[name] = {"ms": round(ms, 3), "tflops": round(x3gm.flops(R, topk) / ms / 1e9, 1),
+                         "trellis_gbps": round(tbytes / ms / 1e6, 1), "x_floor": round(ms / row["floor_ms"], 2)}
+        if R == max(rows):
+            row["gm_cfgs"] = {}
+            for gu in (0, 1):
+                for dn in (0, 1):
+                    for ticket in (True, False):
+                        c = dict(x3gm.config(), gu=gu, dn=dn, ticket=ticket)
+                        same = bool(torch.equal(gm(c), got))
+                        row["gm_cfgs"][f"{gu},{dn},{int(ticket)}"] = {"ms": round(_time(lambda c=c: gm(c), iters), 3),
+                                                                     "bitwise": same}
+        row["pass"] = (row["gm_rel_vs_grouped"] < REL_GATE and row["gm_rows_independent"] and row["gm_repeat"]
+                       and all(v["bitwise"] for v in row.get("gm_cfgs", {}).values()))
+        out["rows"][R] = row
+        print(f"[gmbench] L{layer} R={R}: members mean {row['members_mean']} max {row['members_max']}; floor "
+              f"{row['floor_ms']} ms; grouped {row['grouped']['ms']} ms, tc {row['tc']['ms']} ms, "
+              f"gm {row['gm']['ms']} ms "
+              f"({row['gm']['tflops']} TFLOP/s, {row['gm']['x_floor']}x floor); gm vs grouped rel "
+              f"{row['gm_rel_vs_grouped']:.2e}, rows {'==' if row['gm_rows_independent'] else 'DIFFER'}"
+              + (f"; cfgs {row['gm_cfgs']}" if "gm_cfgs" in row else ""), flush=True)
+    out["pass"] = all(r["pass"] for r in out["rows"].values())
+    return out
+
+
+def sweep_layer(model: str, layer: int, rank: int, rows, iters: int, reps: int = 3) -> dict:
+    """G16 4K: every configuration of the layer's widths at each row block, in the 4K arena (see the docstring)."""
+
+    import statistics
+
+    import torch
+
+    from . import blocks as B
+    from . import moe as MO
+    from . import router, x3gm
+    from . import weights as W
+    from .config import Config
+
+    torch.cuda.set_device(0)
+    cfg = Config.from_file(Path(model) / "config.json")
+    m = W.Loader(cfg, W.Shards(model), rank, 2, "cuda").moe(layer, f"layers.{layer}")
+    block = B.gpu_experts(cfg, m, layer, 2, "cuda")
+    _, topk = cfg.experts_of(layer)
+    lim = cfg.swiglu_limit
+    shx = bool(torch.equal(m.w1.suh, m.w3.suh))
+    k2gu, k2d = x3gm.k2_of(m.w1.trellis), x3gm.k2_of(m.w2.trellis)
+    D, I = cfg.hidden_size, m.w1.trellis.shape[2] * 16
+    need = max(sum(x3gm.need_bytes(R, topk, D, I, 1 if shx else 2)) for R in rows)
+    s = MO.arena_scratch(block, 1024, "cuda", need)        # the 4K path's scratch: 1,024-row grouped + the arena
+    tbytes = sum(t.trellis.numel() * 2 for t in (m.w1, m.w3, m.w2))
+    gen = torch.Generator(device="cuda").manual_seed(300 + layer)
+    out: dict = {"layer": layer, "rank": rank, "k2_gu": k2gu, "k2_d": k2d, "shx": shx, "rows": {}}
+    for R in rows:
+        x = (torch.randn((R, D), generator=gen, device="cuda") * 0.5).to(torch.bfloat16)
+        pick, wts = router.route(x, m.gate, m.bias, topk=topk, shared=True, scale=cfg.routed_scaling_factor)
+        pr, wr = pick[:, :topk].contiguous(), wts[:, :topk].float().contiguous()
+        cnt = torch.bincount(pr.reshape(-1).long(), minlength=block.ex.count - block.geom.shared)
+        g6 = (0 if shx else 1, 0)
+
+        def gm(gu, dn, x=x, pr=pr, wr=wr, R=R):
+            c = dict(x3gm.config(), gu=gu, dn=dn, rows=R)
+            return x3gm.run(x, pr, wr, m.w1, m.w3, m.w2, lim, scratch=s, shx=shx, cfg=c)
+
+        want = gm(*g6).clone()
+        cells = {}
+        for gu in x3gm.GU_TILES:
+            if not x3gm.fits("gu", gu, k2gu, 1 if shx else 2):
+                continue
+            for dn in x3gm.DN_TILES:
+                if not x3gm.fits("dn", dn, k2d):
+                    continue
+                same = bool(torch.equal(gm(gu, dn), want))
+                ms = statistics.median(_time(lambda gu=gu, dn=dn: gm(gu, dn), iters) for _ in range(reps))
+                cells[f"{gu},{dn}"] = {"ms": round(ms, 3), "bitwise": same,
+                                       "passes_gu": int(x3gm.plan(pr, cnt.numel(), x3gm.bm_of("gu", gu))[4][0]),
+                                       "trellis_gbps": round(tbytes / ms / 1e6, 1)}
+        best = min(cells, key=lambda k: cells[k]["ms"])
+        floor = x3gm.floor_bytes(R, tbytes, topk, D, I, 1 if shx else 2) / GBPS / 1e6
+        out["rows"][R] = {"members_mean": round(float(cnt.float().mean()), 1), "members_max": int(cnt.max()),
+                          "floor_ms": round(floor, 3), "g6": f"{g6[0]},{g6[1]}", "best": best, "cells": cells,
+                          "pass": all(c["bitwise"] for c in cells.values())}
+        print(f"[gmbench sweep] L{layer} R={R}: members mean {out['rows'][R]['members_mean']}; floor {floor:.2f} ms; "
+              f"G6 {g6} {cells[f'{g6[0]},{g6[1]}']['ms']} ms; best {best} {cells[best]['ms']} ms; bitwise "
+              f"{'all' if out['rows'][R]['pass'] else 'NOT ALL'}", flush=True)
+    out["pass"] = all(r["pass"] for r in out["rows"].values())
+    return out
+
+
+def tune_table(layers: list[dict], rows: int = 4096) -> dict:
+    """The tuning table over the swept layers: the 4,096-row pair with the least total ms (by shx: "shx:A/B" when the
+    layers differ), the 2,048-row entry G6's."""
+
+    tot: dict = {}
+    for lay in layers:
+        cells = lay["rows"].get(rows, lay["rows"].get(str(rows), {})).get("cells", {})
+        for k, v in cells.items():
+            if v["bitwise"]:
+                tot.setdefault((lay["shx"], k), []).append(v["ms"])
+    best = {}
+    for shx in (True, False):
+        cand = {k: sum(v) for (s, k), v in tot.items() if s == shx}
+        if cand:
+            best[shx] = min(cand, key=cand.get)
+    if not best:
+        raise ValueError(f"no bitwise configuration at {rows} rows")
+    dns = {int(v.split(",")[1]) for v in best.values()}
+    gu_of = {s: int(v.split(",")[0]) for s, v in best.items()}
+    a, b = gu_of.get(True, gu_of.get(False)), gu_of.get(False, gu_of.get(True))
+    dn = min(dns)
+    return {"tune": [[0, None, 0], [48, f"shx:{a}/{b}", dn]], "from": {f"shx={int(k)}": v for k, v in best.items()}}
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--layers", default="3,20")
+    ap.add_argument("--rank", type=int, default=0)
+    ap.add_argument("--rows", default="512,1024,2048,4096")
+    ap.add_argument("--iters", type=int, default=10)
+    ap.add_argument("--reps", type=int, default=3)
+    ap.add_argument("--sweep", action="store_true", help="G16 4K: every x3gm tile configuration (see above)")
+    ap.add_argument("--tune-out", default="", help="--sweep: write the tuning table (TF_DSV41_GM_TUNE) here")
+    ap.add_argument("--out", default="")
+    a = ap.parse_args(argv)
+    rows = [int(v) for v in a.rows.split(",") if v]
+    if a.sweep:
+        rep = {"layers": [sweep_layer(a.model, int(L), a.rank, rows, a.iters, a.reps)
+                          for L in a.layers.split(",") if L]}
+        rep["pass"] = all(r["pass"] for r in rep["layers"])
+        if a.tune_out and max(rows) >= 4096:
+            t = tune_table(rep["layers"], 4096)
+            rep["tune"] = t
+            Path(a.tune_out).parent.mkdir(parents=True, exist_ok=True)
+            Path(a.tune_out).write_text(json.dumps(t, indent=1))
+            print(f"[gmbench sweep] tuning table -> {a.tune_out}: {t}", flush=True)
+    else:
+        rep = {"layers": [bench_layer(a.model, int(L), a.rank, rows, a.iters) for L in a.layers.split(",") if L]}
+        rep["pass"] = all(r["pass"] for r in rep["layers"])
+    if a.out:
+        Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+        Path(a.out).write_text(json.dumps(rep, indent=1))
+    print(json.dumps({"pass": rep["pass"]}), flush=True)
+    return 0 if rep["pass"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/src/tensorfold/families/deepseek_v41/cuda/graphs.py b/src/tensorfold/families/deepseek_v41/cuda/graphs.py
new file mode 100644
index 0000000..6d0b067
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/graphs.py
@@ -0,0 +1,502 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""CUDA graphs for DeepSeek-V4.1-Flash verify windows (M2; GLM ``spark/graphs.py`` + patches/0050's lazy keys).
+
+A verify forward is replayed from a graph keyed by its **mix** (the (slot, rows) of each window in plan order: a
+slot's rings and page table are fixed addresses, so the slot is part of the key) and its **context bucket** (the
+indexer scores ``nvis_max`` keys, a host value fixed at capture: a graph serves every window whose longest context
+ends inside its bucket of ``TF_DSV41_GRAPH_BUCKET`` tokens, scoring up to the bucket's end; the keys past a row's
+own end score -inf and never reach its attention, whose rows are its own: the replay's bits are the eager run's).
+
+- **Warm-up** at boot (both ranks, the same keys in the same order): ``TF_DSV41_GRAPH_WARM`` = ``decode`` (default:
+  one slot at widths 1-6, DSpark's windows), ``all`` (also widths 8, 12, 16 and, with ``TF_DSV41_GRAPH_SLOTS`` > 1,
+  the mixes of equal widths) or ``none``, within ``TF_DSV41_GRAPH_BUDGET_S`` (15) seconds: the ranks agree after
+  each capture whether either is past the budget.
+- **Memory**: before a capture the ranks agree that MemAvailable is at least ``TF_DSV41_GRAPH_FLOOR_GIB`` (5.0: the
+  4 GiB hard floor + a capture's own growth); below it the cache evicts its least recently replayed quarter and
+  lowers its cap to what is left (down to ``MIN_KEEP``, then no more captures; the held ones stay). All graphs
+  share one memory pool (outputs are read before the next replay: the logits at once, the pending rows at the next
+  commit). Multi-slot mixes are eager by default (``TF_DSV41_GRAPH_SLOTS`` 1): their keys are combinatorial and a
+  4-slot round is GPU-bound (~200 ms against ~10 ms of launches).
+- **Persistent buffers**: a graph holds the addresses it captured. Every buffer a window reads or writes outside its
+  own allocations is allocated once (the slots' rings, page tables and ratio-2 carries are written in place; the
+  MoE scratch is one per geometry, sized for the forward's largest run: ``decode.DecodeForward``). If one is ever
+  reallocated (a run wider than the scratch), the fingerprint check before each replay drops every graph (G3's
+  illegal memory accesses and garbage draft ids: per-layer MoE scratch grown after capture, carries replaced by a
+  clone at every commit).
+- **First use**: a key met without a graph runs eagerly (its result is the round's), then is captured for the next
+  time; widths past 16 rows or more slots than captured mixes stay eager.
+- **Cap (LRU)**: at most ``TF_DSV41_GRAPHS_MAX`` (48) held; a capture past the cap first evicts the least recently
+  replayed graph. Each graph holds ~15 MiB of driver host memory plus its outputs in the pool, and the context
+  bucket is in the key, so long agent sessions walk through new keys: G16's soak held 132 graphs (+1.9 GiB glibc in
+  use, +1.4 GiB torch reserved) and parked MemAvailable on the floor. Both ranks meet the same keys in the same
+  order, so they evict the same graphs.
+- **Fallback**: a capture that fails on either rank (agreed through one int exchange) turns graphs off for the
+  rest of the run, both ranks alike; the step's result is the eager run's, so no reply changes.
+
+Inputs a replay reads from static buffers, staged on the host side before each replay (``Static``): the ids, the
+windows' positions (``Win.t`` / ``positions``), and the Engram rows: hashing and reads stay on the host, outside the
+graphs (``prefetch.py``), and land in the static rows with one copy a layer. The forward builds those through its
+hooks ``win_of`` / ``ids_of`` / ``_engram_inputs`` (``decode.DecodeForward`` points them at a ``Static``).
+
+``GraphCache`` (keys, budget, lazy capture, fallback) runs no CUDA: tests run it on the CPU with a fake capture.
+Knobs: TF_DSV41_GRAPHS (1; 0 = eager), TF_DSV41_GRAPH_BUDGET_S (15), TF_DSV41_GRAPHS_MAX (48),
+TF_DSV41_GRAPH_BUCKET (2048), TF_DSV41_GRAPH_SLOTS (1: the widest mix captured), TF_DSV41_GRAPH_WARM (decode),
+TF_DSV41_GRAPH_FLOOR_GIB (5.0), TF_DSV41_GRAPH_BUCKET_GROW (1.25: context buckets past the first 16 end 1.25x further;
+1 = equal steps).
+"""
+
+from __future__ import annotations
+
+import bisect
+import functools
+import os
+import sys
+import time
+from collections.abc import Callable, Sequence
+from dataclasses import dataclass, field
+from typing import Any
+
+from .csa2.backend import Win
+from .phases import PH
+
+WIDTHS = (1, 2, 3, 4, 5, 6, 8, 12, 16)
+DECODE_WIDTHS = (1, 2, 3, 4, 5, 6)
+MIX_WIDTHS = (6, 1, 4, 2, 3, 5)
+WARM = ("decode", "all", "none")
+MAX_ROWS = 16
+MIN_KEEP = 8                # under the memory floor the cache evicts down to this many, then stops capturing
+PAUSE = 64                  # after an eviction under the floor, this many capture attempts are skipped (no cascade)
+
+Key = tuple            # (((slot, rows), ...), bucket)
+
+
+class Recent:
+    """Rounds since the last round with prefill pieces, on this rank (``rounds.Executor.run`` notes every plan; both
+    ranks run the same plans, so both count alike). G19: a capture refused for memory within
+    ``TF_DSV41_GRAPH_DIP_ROUNDS`` (64) rounds of a prefill evicts nothing: a long prefill's transient comes back when
+    it ends (G18's 2,048-row soak walked the cap 48 -> 8 over seven such dips, one eviction each)."""
+
+    def __init__(self, rounds: int | None = None) -> None:
+        self.rounds = (int(os.environ.get("TF_DSV41_GRAPH_DIP_ROUNDS", "").strip() or 64) if rounds is None
+                       else int(rounds))
+        if self.rounds < 0:
+            raise ValueError(f"TF_DSV41_GRAPH_DIP_ROUNDS={self.rounds}: expected >= 0")
+        self.since = 1 << 30
+
+    def note(self, prefill: bool) -> None:
+        self.since = 0 if prefill else min(self.since + 1, 1 << 30)
+
+    def recent(self) -> bool:
+        return self.since <= self.rounds
+
+
+PREFILL = Recent()
+
+
+def env_settings() -> dict:
+    g = lambda k, d: os.environ.get(k, "").strip() or d
+    warm = g("TF_DSV41_GRAPH_WARM", "decode").lower()
+    if warm not in WARM:
+        raise ValueError(f"TF_DSV41_GRAPH_WARM={warm!r}: expected one of {', '.join(WARM)}")
+    return {"on": g("TF_DSV41_GRAPHS", "1") != "0", "budget_s": float(g("TF_DSV41_GRAPH_BUDGET_S", "15")),
+            "max_graphs": int(g("TF_DSV41_GRAPHS_MAX", "48")), "bucket": int(g("TF_DSV41_GRAPH_BUCKET", "2048")),
+            "slots": int(g("TF_DSV41_GRAPH_SLOTS", "1")), "warm": warm,
+            "floor_gib": float(g("TF_DSV41_GRAPH_FLOOR_GIB", "5.0"))}
+
+
+def room_for(floor_gib: float, meminfo=None) -> Callable[[], bool]:
+    """``GraphCache.room``: MemAvailable >= ``floor_gib`` (True where /proc/meminfo is missing)."""
+
+    def room() -> bool:
+        from tensorfold.families.glm5_next.spark import memsafe
+
+        mi = meminfo() if meminfo is not None else memsafe.read_meminfo()
+        avail = mi.get("MemAvailable")
+        return avail is None or avail >= floor_gib * 2 ** 30
+
+    return room
+
+
+def make_key(mix: Sequence[tuple[int, int, int]], bucket: int, limit: int, slots: int = 4) -> Key | None:
+    """``mix``: (slot, start, rows) of each window -> the key, or None (not graphable: a window past 16 rows, more
+    windows than ``slots``, a slot twice, a context past ``limit``)."""
+
+    if not mix or len(mix) > slots or len({m[0] for m in mix}) != len(mix):
+        return None
+    if any(not 1 <= r <= MAX_ROWS for _, _, r in mix):
+        return None
+    last = max(s + r - 1 for _, s, r in mix)
+    if last >= limit:
+        return None
+    return tuple((int(sl), int(r)) for sl, _, r in mix), bucket_of(last, bucket)
+
+
+LINEAR = 16                 # context buckets 0-15 are ``size`` tokens each; past them each ends GROW x further
+
+
+def _grow() -> float:
+    return float(os.environ.get("TF_DSV41_GRAPH_BUCKET_GROW", "").strip() or "1.25")
+
+
+@functools.lru_cache(maxsize=64)
+def _ends(size: int, grow: float, upto: int) -> tuple[int, ...]:
+    """Each bucket's end (exclusive) up to ``upto``: ``size`` steps for ``LINEAR`` buckets, then x ``grow`` rounded
+    up to ``size`` (grow <= 1: equal steps throughout)."""
+
+    ends = [size * (b + 1) for b in range(LINEAR)]
+    while ends[-1] < upto:
+        nxt = -(-int(ends[-1] * grow) // size) * size if grow > 1 else ends[-1] + size
+        ends.append(max(nxt, ends[-1] + size))
+    return tuple(ends)
+
+
+def bucket_of(last: int, size: int, grow: float | None = None) -> int:
+    """The context bucket of a window whose last position is ``last`` (G16: 2048-token steps to 32K, then 1.25x
+    apart, 26 buckets to 300K instead of 147; a graph scores its bucket's keys, those past a row's end masked)."""
+
+    g = _grow() if grow is None else grow
+    ends = _ends(size, g, last + 1)
+    return bisect.bisect_right(ends, last)
+
+
+def bucket_end(bucket: int, size: int, limit: int, grow: float | None = None) -> int:
+    """The last position a bucket's graphs score keys for."""
+
+    g = _grow() if grow is None else grow
+    ends = _ends(size, g, size * (bucket + 1))
+    while len(ends) <= bucket:
+        ends = _ends(size, g, ends[-1] * 2)
+    return min(ends[bucket] - 1, limit - 1)
+
+
+def warmup_keys(slots: int, max_slots: int = 4, warm: str = "all") -> list[Key]:
+    """The boot captures in priority order (bucket 0): slot 0 alone at the decode widths (``warm`` "decode") or at
+    every graph width then equal-width mixes of the first ``min(slots, max_slots)`` slots ("all"); "none": none."""
+
+    if warm == "none":
+        return []
+    keys: list[Key] = [(((0, w),), 0) for w in (DECODE_WIDTHS if warm == "decode" else WIDTHS)]
+    n = min(slots, max_slots)
+    if n > 1 and warm == "all":
+        keys += [(tuple((s, w) for s in range(n)), 0) for w in MIX_WIDTHS]
+    return keys
+
+
+@dataclass
+class GraphCache:
+    """The keys' graphs and the rules for making them. ``capture(key) -> entry | None`` (None: failed) is given
+    by the CUDA side; ``agree(ok) -> bool`` is every rank's verdict (all ok / any past the budget)."""
+
+    capture: Callable[[Key], Any]
+    budget_s: float = 15.0
+    max_graphs: int = 48
+    bucket: int = 2048
+    slots: int = 4
+    on: bool = True
+    agree_all: Callable[[bool], bool] = lambda ok: ok
+    agree_any: Callable[[bool], bool] = lambda flag: flag
+    clock: Callable[[], float] = time.monotonic
+    room: Callable[[], bool] = lambda: True         # memory for one more capture (``room_for``)
+    forget: Callable[[Key], None] = lambda key: None    # the CUDA side's own per-key state of an evicted graph
+    release: Callable[[], None] = lambda: None          # after an eviction under the floor: the freed pool back to the OS
+    pause: int = 0                                      # capture attempts still skipped after that eviction
+    prefill_recent: Callable[[], bool] = lambda: False  # G19: a prefill ran lately (``PREFILL.recent``): no eviction
+    graphs: dict = field(default_factory=dict)
+    full: bool = False                              # a capture was refused for memory: no more captures
+    stats: dict = field(default_factory=lambda: {"warm": 0, "lazy": 0, "replays": 0, "eager": 0, "failed": 0,
+                                                 "warm_s": 0.0, "full": 0, "dropped": 0,
+                                                 "evicted": 0})
+
+    def key(self, mix, limit: int) -> Key | None:
+        return make_key(mix, self.bucket, limit, self.slots) if self.on else None
+
+    def get(self, key: Key | None):
+        e = self.graphs.pop(key, None) if key is not None else None
+        if e is not None:
+            self.graphs[key] = e                        # most recently replayed last (the LRU order)
+            self.stats["replays"] += 1
+        else:
+            self.stats["eager"] += 1
+        return e
+
+    def wants(self, key: Key | None) -> bool:
+        return self.on and not self.full and key is not None and key not in self.graphs and self.max_graphs > 0
+
+    def drop(self) -> None:
+        """Every graph forgotten (a persistent buffer moved; both ranks see the same event)."""
+
+        if self.graphs:
+            self.stats["dropped"] += len(self.graphs)
+            self.graphs.clear()
+
+    def evict(self, n: int) -> None:
+        """The ``n`` least recently replayed graphs forgotten (their host and pool memory freed with them)."""
+
+        for key in list(self.graphs)[:max(0, n)]:
+            del self.graphs[key]
+            self.forget(key)
+            self.stats["evicted"] += 1
+
+    def _take(self, key: Key) -> bool:
+        if self.pause > 0:                            # G17 soak: one eviction a dip, not 48 -> 8 in 0.4 s (the freed
+            self.pause -= 1                           # graphs reach MemAvailable only after the release); both ranks
+            return False                              # count the same attempts, so they resume together
+        if self.agree_any(not self.room()):           # either rank under the floor: neither captures
+            held = len(self.graphs)
+            if self.prefill_recent():                 # G19: a prefill's transient; it returns when the prompt ends
+                self.stats["deferred"] = self.stats.get("deferred", 0) + 1
+                return False
+            if held > MIN_KEEP:
+                self.max_graphs = max(MIN_KEEP, held * 3 // 4)
+                self.evict(held - self.max_graphs)
+                self.release()
+                self.pause = PAUSE
+                print(f"[tensorfold] dsv41 CUDA graphs: memory under the capture floor; {held} held, the least "
+                      f"recent evicted, cap now {self.max_graphs}", file=sys.stderr, flush=True)
+                return False
+            self.full = True
+            self.stats["full"] += 1
+            print(f"[tensorfold] dsv41 CUDA graphs: memory under the capture floor; {held} held, no "
+                  "more captured", file=sys.stderr, flush=True)
+            return False
+        self.evict(len(self.graphs) - self.max_graphs + 1)
+        try:
+            entry = self.capture(key)
+        except Exception as exc:        # noqa: BLE001 - any capture failure: eager from here on
+            print(f"[tensorfold] dsv41 CUDA graph capture of {key} failed ({type(exc).__name__}: {exc})",
+                  file=sys.stderr, flush=True)
+            entry = None
+        if not self.agree_all(entry is not None):
+            self.on = False
+            self.graphs.clear()
+            self.stats["failed"] += 1
+            print("[tensorfold] dsv41 CUDA graphs off (a capture failed on a rank): windows run eagerly",
+                  file=sys.stderr, flush=True)
+            return False
+        self.graphs[key] = entry
+        return True
+
+    def lazy(self, key: Key | None) -> None:
+        """After an eager window: capture its key for the next time (both ranks meet the same keys in order)."""
+
+        if self.wants(key) and self._take(key):
+            self.stats["lazy"] += 1
+
+    def warmup(self, keys: Sequence[Key]) -> int:
+        """Capture ``keys`` in order within the budget; the number captured."""
+
+        t0 = self.clock()
+        n = 0
+        for key in keys:
+            if not self.wants(key):
+                continue
+            if self.agree_any(self.clock() - t0 > self.budget_s):
+                break
+            if not self._take(key):
+                break
+            n += 1
+        self.stats["warm"] += n
+        self.stats["warm_s"] = round(self.clock() - t0, 2)
+        return n
+
+    def describe(self) -> str:
+        s = self.stats
+        return (f"graphs {'on' if self.on else 'off'}: {len(self.graphs)} held ({s['warm']} at boot in "
+                f"{s['warm_s']} s, {s['lazy']} on first use), {s['replays']} replays, {s['eager']} eager windows"
+                + (f", {s['dropped']} dropped" if s["dropped"] else "")
+                + (f", {s['evicted']} evicted (cap {self.max_graphs})" if s["evicted"] else "")
+                + (f", {s['deferred']} captures deferred in prefill dips" if s.get("deferred") else "")
+                + (", memory full" if self.full else ""))
+
+
+# -- the CUDA side ---------------------------------------------------------------------------------------------------
+@dataclass
+class Static:
+    """One key's static inputs and the forward's outputs captured with it."""
+
+    key: Key
+    ids: Any                    # int64 [R]
+    t: list                     # int32 [1] a window (its start)
+    pos: list                   # int64 [n] a window
+    cap: int                    # the bucket's last position (the indexer's key range)
+    engram: dict = field(default_factory=dict)      # layer -> static rows [R, cols]
+    wins: list = field(default_factory=list)
+    graph: Any = None
+    out: Any = None
+    pend: dict = field(default_factory=dict)        # slot -> (proj, taps) of the captured run
+
+
+class CudaGraphs:
+    """Graphs of ``fw`` (``decode.DecodeForward``) windows: ``run(segs)`` replays, or runs eagerly and captures."""
+
+    def __init__(self, fw, *, agree_all=None, agree_any=None, settings: dict | None = None) -> None:
+        import torch
+
+        self.torch, self.fw = torch, fw
+        st = settings or env_settings()
+        self.pool = torch.cuda.graph_pool_handle()
+        self._pending_segs = None
+        self.warm = st.get("warm", "all")            # env_settings: "decode" unless TF_DSV41_GRAPH_WARM
+        self.cache = GraphCache(self._capture, st["budget_s"], st["max_graphs"], st["bucket"], st["slots"],
+                                st["on"], agree_all or (lambda ok: ok), agree_any or (lambda f: f),
+                                room=room_for(float(st.get("floor_gib", 5.0))), release=torch.cuda.empty_cache,
+                                prefill_recent=PREFILL.recent)
+        self._fp = self.fingerprint()
+
+    def fingerprint(self) -> tuple:
+        """The persistent buffers a captured window reads or writes (object identities / addresses): the MoE
+        scratch of every block, every slot's ratio-2 carries. Any change drops the graphs (``run``)."""
+
+        fw = self.fw
+        parts = [id(getattr(b.moe, "scratch", None)) for b in fw.blocks]
+        for s in fw.slots:
+            parts += [c.data_ptr() for c in s.carry.values()]
+        return tuple(parts)
+
+    def _mix(self, segs):
+        return [(sg.slot, sg.start, len(sg.ids)) for sg in segs]
+
+    def _static(self, key: Key, segs) -> Static:
+        torch, fw = self.torch, self.fw
+        dev = fw.device
+        R = sum(n for _, n in key[0])
+        cap = bucket_end(key[1], self.cache.bucket, fw.limit)
+        st = Static(key, torch.zeros((R,), dtype=torch.long, device=dev),
+                    [torch.zeros((1,), dtype=torch.int32, device=dev) for _ in key[0]],
+                    [torch.zeros((n,), dtype=torch.long, device=dev) for _, n in key[0]], cap)
+        st.wins = [StaticWin(0, n, t, p, cap) for (_, n), t, p in zip(key[0], st.t, st.pos)]
+        rows = fw.engram_inputs_eager(segs)
+        st.engram = {L: torch.empty_like(v) for L, v in rows.items()}
+        self._stage(st, segs, rows)
+        return st
+
+    def _stage(self, st: Static, segs, rows=None) -> None:
+        torch, fw = self.torch, self.fw
+        st.ids.copy_(torch.tensor([t for sg in segs for t in sg.ids], dtype=torch.long), non_blocking=False)
+        for sg, t, p, w in zip(segs, st.t, st.pos, st.wins):
+            t.fill_(int(sg.start))
+            p.copy_(torch.arange(sg.start, sg.start + len(sg.ids), dtype=torch.long))
+            w.p0 = int(sg.start)
+        rows = fw.engram_inputs_eager(segs) if rows is None else rows
+        for L, v in rows.items():
+            st.engram[L].copy_(v)
+
+    def _capture(self, key: Key) -> Static | None:
+        torch, fw = self.torch, self.fw
+        segs = self._pending_segs
+        saved = {sg.slot: fw.slots[sg.slot].pending for sg in segs}
+        hidden = getattr(fw, "hidden", None)
+        st = self._static(key, segs)
+        g = torch.cuda.CUDAGraph()
+        fw.static = st
+        try:
+            # the static path once eagerly (the same rows at the same positions: the same writes), so every Triton
+            # specialisation of the bucket's key range is compiled and loaded before the capture
+            fw.run(segs)
+            torch.cuda.synchronize()
+            with torch.cuda.graph(g, pool=self.pool, capture_error_mode="thread_local"):
+                out = fw.run(segs)
+        finally:
+            fw.static = None
+        st.graph, st.out = g, out
+        for sg in segs:
+            p = fw.slots[sg.slot].pending
+            st.pend[sg.slot] = (p.proj, p.taps)
+            fw.slots[sg.slot].pending = saved[sg.slot]
+        fw.hidden = hidden
+        return st
+
+    def run(self, segs):
+        """This rank's logits of the windows ``segs`` (``forward.Seg``), replayed or eager (+ captured)."""
+
+        from .forward import Pending
+
+        fw = self.fw
+        fp = self.fingerprint()
+        if fp != self._fp:
+            if self.cache.graphs:
+                print(f"[tensorfold] dsv41 CUDA graphs: a persistent buffer moved; {len(self.cache.graphs)} graphs "
+                      "dropped (captured again on use)", file=sys.stderr, flush=True)
+            self.cache.drop()
+            self._fp = fp
+        key = self.cache.key(self._mix(segs), fw.limit)
+        st = self.cache.get(key)
+        if st is not None:
+            with PH("graph.stage"):
+                self._stage(st, segs)
+            with PH("graph.replay"):
+                st.graph.replay()
+            from . import xmap as XM
+
+            XM.replayed(fw, segs, sum(len(sg.ids) for sg in segs))     # G15 TF_DSV41_XMAP_TRACE: the window's host note
+            for sg in segs:
+                proj, taps = st.pend[sg.slot]
+                fw.slots[sg.slot].pending = Pending(sg.start, list(sg.ids), proj, taps)
+            return st.out
+        out = fw.run(segs)
+        if self.cache.wants(key):
+            self._pending_segs = segs
+            try:
+                with PH("graph.capture"):
+                    self.cache.lazy(key)
+            finally:
+                self._pending_segs = None
+        return out
+
+    def warmup(self, slots: int, ensure: Callable[[int, int], None], bos: int = 0) -> int:
+        """Boot captures: slots at position 0 (``ensure(slot, rows)`` maps their pages), each key eagerly once
+        (Triton compiles) then captured; the slots are reset afterwards (the caller releases their pages)."""
+
+        from .forward import Seg
+
+        fw = self.fw
+        keys = warmup_keys(slots, self.cache.slots, self.warm)
+
+        def capture_key(key, inner=self.cache.capture):
+            segs = []
+            for sl, n in key[0]:
+                fw.reset(sl)
+                ensure(sl, n + 1)
+                segs.append(Seg(sl, 0, tuple([int(bos)] * n)))
+            fw.run(segs)
+            self._pending_segs = segs
+            try:
+                return inner(key)
+            finally:
+                self._pending_segs = None
+
+        real = self.cache.capture
+        self.cache.capture = capture_key
+        try:
+            n = self.cache.warmup(keys)
+        finally:
+            self.cache.capture = real
+            for s in range(slots):
+                fw.reset(s)
+        return n
+
+
+@dataclass
+class StaticWin(Win):
+    """A static window: ``t`` / ``positions`` are the key's buffers; ``last`` reaches the bucket's end (the
+    indexer's key range at capture)."""
+
+    cap: int = 0
+
+    @property
+    def last(self) -> int:
+        return max(self.p0 + self.n - 1, self.cap)
+
+
+__all__ = [
+    "WIDTHS",
+    "CudaGraphs",
+    "GraphCache",
+    "Static",
+    "StaticWin",
+    "bucket_end",
+    "env_settings",
+    "make_key",
+    "warmup_keys",
+]
