+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""router_gemv.cu builds for sm_121 (GB10) without torch headers (-DDSV41_RG_NO_TORCH): all 20 gemv_kernel and 20
+narrow_kernel instances, no register spills, static shared memory under 48 KiB; the narrow kernel issues its whole
+gate row (cp.async, LDGSTS) before its first FMA at R <= 4. Needs an nvcc that knows compute_121 (TF_NVCC, PATH or
+CUDA_HOME); skipped otherwise."""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from tensorfold.families.deepseek_v41.cuda import router_gemv as RG
+
+CU = Path(RG.__file__).with_name("router_gemv.cu")
+
+
+def _nvcc() -> str | None:
+    for cand in (os.environ.get("TF_NVCC"), shutil.which("nvcc"),
+                 os.path.join(os.environ.get("CUDA_HOME", "/usr/local/cuda"), "bin", "nvcc")):
+        if cand and os.path.exists(cand):
+            try:
+                archs = subprocess.run([cand, "--list-gpu-arch"], capture_output=True, text=True, timeout=60,
+                                       check=False).stdout
+            except (OSError, subprocess.SubprocessError):
+                continue
+            if "compute_121" in archs:
+                return cand
+    return None
+
+
+NVCC = _nvcc()
+pytestmark = pytest.mark.skipif(NVCC is None, reason="no nvcc with compute_121 (TF_NVCC)")
+
+
+def test_builds_for_sm121_without_spills(tmp_path):
+    src = tmp_path / "inst.cu"
+    src.write_text(f'#include "{CU.name}"\n' + "".join(
+        f"template cudaError_t dsv41_rg::by_rt<{nw}, {ew}>(const dsv41_rg::Args&, int, cudaStream_t);\n"
+        for nw, ew in RG.CFGS) + "".join(
+        f"template cudaError_t dsv41_rg::by_rt_narrow<{nw}>(const dsv41_rg::Args&, int, cudaStream_t);\n"
+        for nw in RG.NARROW_NW))
+    out = subprocess.run([NVCC, "-std=c++17", "-O3", "-DDSV41_RG_NO_TORCH", f"-I{CU.parent}",
+                          "-gencode=arch=compute_121,code=sm_121", "-Xptxas", "-v", "-c", str(src), "-o",
+                          str(tmp_path / "inst.o")], capture_output=True, text=True, timeout=600, check=False)
+    assert out.returncode == 0, out.stderr[-3000:]
+    log = out.stderr
+    entries = re.findall(r"Compiling entry function '(\S+)'", log)
+    assert len(entries) == (len(RG.CFGS) + len(RG.NARROW_NW)) * len(RG.TILES)
+    props = re.findall(r"Compiling entry function '(\S+)'.*?(\d+) bytes spill stores, (\d+) bytes spill loads", log, re.S)
+    assert len(props) == len(entries), log
+    # G13: the image's nvcc spills 4 B (one stack slot) in narrow_kernel<8, *>; NW 8 is not a production setting
+    # (TF_DSV41_RG_NARROW=2), so it may keep <= 8 B; every other instance must not spill
+    bad = [(f, a, b) for f, a, b in props
+           if (a, b) != ("0", "0") and not (f.startswith("_ZN8dsv41_rg13narrow_kernelILi8E") and int(a) <= 8 and int(b) <= 8)]
+    assert not bad, bad
+    regs = [int(r) for r in re.findall(r"Used (\d+) registers", log)]
+    smem = [int(s) for s in re.findall(r"(\d+) bytes smem", log)]
+    assert max(regs) <= 255 and max(smem) <= 48 * 1024
+    print(f"[G7] router_gemv sm_121: {len(entries)} instances, registers {min(regs)}..{max(regs)}, smem <= "
+          f"{max(smem)} B, no spills")
+    sass = _sass(tmp_path / "inst.o", "_ZN8dsv41_rg13narrow_kernelILi1ELi2EEEvNS_4ArgsE")
+    if sass is not None:                                             # cuobjdump found: the loads lead the FMAs
+        ops = re.findall(r"\b(LDGSTS|FFMA)\b", sass)
+        assert ops.count("LDGSTS") == RG.NV and ops.index("FFMA") > max(i for i, o in enumerate(ops) if o == "LDGSTS")
+
+
+def _sass(obj, fn):
+    cands = [os.environ.get("TF_CUOBJDUMP"), shutil.which("cuobjdump"), str(Path(NVCC).with_name("cuobjdump"))]
+    for c in cands:
+        if c and os.path.exists(c):
+            out = subprocess.run([c, "-sass", "-fun", fn, str(obj)], capture_output=True, text=True, timeout=120,
+                                 check=False)
+            if out.returncode == 0 and "FFMA" in out.stdout:
+                return out.stdout
+    return None
