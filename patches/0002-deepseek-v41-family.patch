+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16 ``TF_DSV41_PF_DENSE=fused`` on the GPU (collected only where PyTorch sees an NVIDIA GPU): ``pfdense.cuh``, the
+dense EXL3 prefill GEMM with the trellis decoded inside it, against the current path (upstream rot_in + unpack +
+Triton ``_gemm``, or dense3's lanes unpack + ``_gemm``):
+
+- decode: ``pfdense.dequant`` (the kernel's stage decode and fragment order) == ``lin.unpack()`` for every shape;
+- BITS: every dense shape of the model (q / kv / o groups: wq_a, wkv (5 and layer 0's 6 bits), compressor, wq_b,
+  indexer wq_b / wk, wo_a, wo_b, the shared expert's gate / up / down at 4 and 5 bits, Engram wkv at 4 and 5 bits) in
+  its serving layout (lanes under DENSE_V3, strips, stored), at M = 4,096 / 2,048 / 2,047 / 1,024 / 640 / 300 / 129 /
+  128 / 17 / 1, fp32 and bf16 outputs: fused == off, bit for bit, at the pick AND at every configuration (2,048 and
+  300 rows); a strided ``out`` view; a bias; rows independent of their segment;
+- SPEED (printed ``[G16D]``, the tile sweep): TFLOP/s of the current path (rot_in + unpack + GEMM, and the GEMM alone)
+  and of the fused GEMM at every configuration x raster group, at 2,048 and 1,024 rows (+ 300 for the small-row
+  pick). With TF_DSV41_PF_DENSE_SWEEP_OUT=<file.json> the best per shape is merged there: the tuning table
+  ``TF_DSV41_PF_DENSE_TABLE`` reads (scripts/windows/g16prefill.sh dsweep);
+- end to end on the synthetic checkpoint: a fast prefill with fused == off (logits, 3 decode steps);
+- optional, TF_DSV41_MODEL=<pack dir>: the real layer-1 matrices (lanes) fused == off at 2,048 rows.
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_pfdense_gpu.py (one GPU; ~10-20 min with the sweep).
+"""
+
+from __future__ import annotations
+
+import json
+import zlib
+import os
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.families.deepseek_v41.cuda import dense3 as D3  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import pfdense as PD  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import prefill_mm as PM  # noqa: E402
+
+DEV = "cuda"
+# name: (K, N, bits, layout) at one rank (TP = 2), the serving layout (prod: TF_DSV41_DENSE_V3=1 -> lanes)
+SHAPES = {
+    "wq_a": (5120, 1280, 5, "lanes"), "wq_a.L0": (5120, 1280, 6, "lanes"),
+    "wkv": (5120, 512, 5, "lanes"), "wkv.L0": (5120, 512, 6, "lanes"), "comp_wkv": (5120, 512, 5, "lanes"),
+    "wq_b": (1280, 16384, 5, "lanes"), "ix_wq_b": (1280, 4096, 5, "lanes"), "ix_wk": (512, 128, 8, "strips"),
+    "wo_a": (4096, 1024, 5, "lanes"), "wo_b": (4096, 5120, 5, "lanes"),
+    "sh_gate.4": (5120, 1152, 4, "stored"), "sh_gate.5": (5120, 1152, 5, "stored"),
+    "sh_down.4": (1152, 5120, 4, "stored"), "sh_down.5": (1152, 5120, 5, "stored"),
+    "engram.4": (6144, 25600, 4, "strips"), "engram.5": (6144, 25600, 5, "strips"),
+    "wq_b.strips": (1280, 16384, 5, "strips"), "wo_b.strips": (4096, 5120, 5, "strips"),     # DENSE_V3=0
+}
+ROWS = (2048, 2047, 1024, 640, 300, 129, 128, 17, 1)
+SWEEP_ROWS = (2048, 1024)
+GROUPS = (8, 1, 4, 16)
+
+
+def _bits(t):
+    return t.reshape(-1).contiguous().view(torch.uint8)
+
+
+def _ms(fn, reps: int = 10) -> float:
+    fn()
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(reps):
+        fn()
+    b.record()
+    torch.cuda.synchronize()
+    return a.elapsed_time(b) / reps
+
+
+_LINS: dict = {}
+
+
+def _lin(name: str, bias: bool = False):
+    key = (name, bias)
+    if key in _LINS:
+        return _LINS[key]
+    from tensorfold.cuda.exl3.linear import Exl3Linear
+
+    K, N, bits, layout = SHAPES[name]
+    g = np.random.default_rng(zlib.crc32(name.encode()))
+    t = torch.from_numpy(g.integers(-32768, 32768, size=(K // 16, N // 16, 16 * bits), dtype=np.int64)
+                         .astype(np.int16))
+    suh = torch.from_numpy(g.choice([-1.0, 1.0], size=K).astype(np.float16))
+    svh = torch.from_numpy(g.uniform(0.001, 0.002, size=N).astype(np.float16))
+    b = torch.from_numpy(g.uniform(-0.01, 0.01, size=N).astype(np.float16)) if bias else None
+    lin = Exl3Linear.from_tensors(t, suh, svh, "mul1", bias=b, device=DEV,
+                                  layout="stored" if layout == "stored" else "strips")
+    if layout == "lanes":
+        D3.to_lanes(lin)
+    _LINS.clear()                                       # keep one layer resident (Engram is 79-98 MB of words)
+    _LINS[key] = lin
+    return lin
+
+
+def _x(M: int, K: int, seed: int = 0):
+    g = torch.Generator(device="cpu").manual_seed(seed + M)
+    return (torch.randn((M, K), generator=g) * 0.3).to(torch.bfloat16).to(DEV)
+
+
+def _off(monkeypatch, lin, x, dtype):
+    monkeypatch.setenv(PD.ENV, "off")
+    monkeypatch.delenv("TF_DSV41_PREFILL_TILES", raising=False)
+    return PM.matmul(lin, x, dtype, PM.column_blocks(lin, PM.ws_limit()))
+
+
+def _on(monkeypatch, lin, x, dtype, cfg: str | None = None, out=None):
+    monkeypatch.setenv(PD.ENV, "fused")
+    if cfg is None:
+        monkeypatch.delenv(PD.CFG_ENV, raising=False)
+    else:
+        monkeypatch.setenv(PD.CFG_ENV, cfg)
+    return PM.matmul(lin, x, dtype, None, out=out)
+
+
+@pytest.mark.parametrize("name", list(SHAPES))
+def test_decode_equals_unpack(name):
+    lin = _lin(name)
+    assert PD.why_not(lin) is None
+    assert torch.equal(_bits(PD.dequant(lin)), _bits(lin.unpack()))
+
+
+@pytest.mark.parametrize("name", list(SHAPES))
+def test_fused_equals_current_path(monkeypatch, name):
+    lin = _lin(name)
+    K = lin.k
+    att = SHAPES[name][3] != "stored" and not name.startswith("engram")
+    dtypes = (torch.float32, torch.bfloat16) if att else (torch.float32,)
+    rows = ROWS if not name.startswith("engram") else (2048, 2047, 300, 1)
+    for M in rows:
+        x = _x(M, K)
+        for dt in dtypes:
+            want = _off(monkeypatch, lin, x, dt)
+            got = _on(monkeypatch, lin, x, dt)
+            assert torch.equal(_bits(got), _bits(want)), (name, M, dt, PD.pick(lin.k, lin.n, lin.k2, M))
+    for M in (2048, 300):
+        x = _x(M, K, 1)
+        want = _off(monkeypatch, lin, x, torch.float32)
+        for cfg in PD.CFGS:
+            if K % PD.stage_k(cfg):
+                continue
+            for group in (8, 1):
+                got = _on(monkeypatch, lin, x, torch.float32, f"{cfg},{group}")
+                assert torch.equal(_bits(got), _bits(want)), (name, M, cfg, group)
+
+
+def test_out_view_bias_and_row_independence(monkeypatch):
+    lin = _lin("wo_a")
+    x = _x(2048, lin.k)
+    want = _off(monkeypatch, lin, x, torch.bfloat16)
+    z = torch.zeros((2048, 4096), dtype=torch.bfloat16, device=DEV)
+    _on(monkeypatch, lin, x, torch.bfloat16, out=z[:, 1024:2048])
+    assert torch.equal(_bits(z[:, 1024:2048]), _bits(want))
+    assert not z[:, :1024].any() and not z[:, 2048:].any()
+    part = _on(monkeypatch, lin, x[700:1000].contiguous(), torch.bfloat16)
+    assert torch.equal(_bits(part), _bits(want[700:1000]))             # a row's bits do not depend on its segment
+    blin = _lin("ix_wq_b", bias=True)
+    xb = _x(300, blin.k)
+    assert torch.equal(_bits(_on(monkeypatch, blin, xb, torch.float32)),
+                       _bits(_off(monkeypatch, blin, xb, torch.float32)))
+
+
+def _unpack_ms(lin) -> float:
+    """The current path's W_q unpack alone (what fused removes), ms; nan for a layer too big to unpack whole here."""
+
+    if lin.k * lin.n * 2 > (512 << 20):
+        return float("nan")
+    wq = torch.empty((lin.k, lin.n), dtype=torch.float16, device=DEV)
+    return _ms(lambda: lin.unpack(wq), 5)
+
+
+def _merge_sweep(key: str, entry: dict) -> None:
+    path = os.environ.get("TF_DSV41_PF_DENSE_SWEEP_OUT", "").strip()
+    if not path:
+        return
+    p = Path(path)
+    cur = json.loads(p.read_text()) if p.is_file() else {}
+    old = cur.get(key)
+    if old is None or entry["ms"] < old.get("ms", float("inf")):
+        cur[key] = entry
+    p.write_text(json.dumps(cur, indent=1, sort_keys=True))
+
+
+@pytest.mark.parametrize("name", [n for n in SHAPES if not n.endswith(".strips")])
+def test_sweep_tflops(monkeypatch, name):
+    lin = _lin(name)
+    K, N = lin.k, lin.n
+    ws = PM.workspace(torch.device(DEV))
+    line, best_by_rows = [], {}
+    for M in SWEEP_ROWS + (300,):
+        x = _x(M, K)
+        flops = 2.0 * M * K * N
+        t_off = _ms(lambda x=x: _off(monkeypatch, lin, x, torch.float32), 5)
+        xh = ws._grow("xh", M * K, x.device)[:M * K].view(M, K)
+        out = torch.empty((M, N), dtype=torch.float32, device=DEV)
+        from tensorfold.cuda.exl3.linear import _ext as up
+
+        t_rot = _ms(lambda x=x, xh=xh: up().rot_in(x, lin.suh, xh), 10)
+        t_unpack = _unpack_ms(lin)
+        res = {}
+        for cfg in PD.CFGS:
+            if K % PD.stage_k(cfg):
+                continue
+            for group in GROUPS:
+                res[(cfg, group)] = _ms(lambda xh=xh, out=out, c=cfg, g=group: PD.gemm(lin, xh, out, c, g), 10)
+        (bc, bg), bt = min(res.items(), key=lambda kv: kv[1])
+        pc, pg = PD.pick(K, N, lin.k2, M)
+        t_pick = res.get((pc, pg), float("nan"))
+        best_by_rows[M] = res
+        line.append(f"M {M}: off {t_off:.3f} ms ({flops / t_off / 1e9:.0f} TFLOP/s; rot {t_rot:.3f}, unpack "
+                    f"{t_unpack:.3f}, GEMM ~{flops / max(t_off - t_rot - t_unpack, 1e-6) / 1e9:.0f}); fused best cfg "
+                    f"{bc} g{bg} {bt:.3f} ms ({flops / bt / 1e9:.0f}), pick {pc} g{pg} {t_pick:.3f} "
+                    f"({flops / t_pick / 1e9:.0f}); rot + fused {t_rot + bt:.3f} vs off {t_off:.3f} "
+                    f"(model {PD.expected_tflops(K, N, M, lin.k2):.0f})")
+        per_cfg = " ".join(f"{c}:{flops / min(v for (cc, _), v in res.items() if cc == c) / 1e9:.0f}"
+                           for c in sorted({c for c, _ in res}))
+        line.append(f"   cfg TFLOP/s at M {M}: {per_cfg}")
+    big = {k: sum(best_by_rows[M][k] for M in SWEEP_ROWS) for k in best_by_rows[SWEEP_ROWS[0]]}
+    (c, gr), ms = min(big.items(), key=lambda kv: kv[1])
+    (sc, _), _ = min(best_by_rows[300].items(), key=lambda kv: kv[1])
+    tfl = 2.0 * SWEEP_ROWS[0] * K * N / best_by_rows[SWEEP_ROWS[0]][(c, gr)] / 1e9
+    _merge_sweep(f"{K},{N}", {"cfg": c, "group": gr, "small": sc, "small_rows": 512, "ms": ms,
+                              "tflops_2048": round(tfl, 1), "name": name, "k2": lin.k2})
+    print(f"[G16D] pfdense sweep {name} {K}x{N} K2 {lin.k2} {SHAPES[name][3]}: pick -> cfg {c} g{gr} "
+          f"({tfl:.0f} TFLOP/s at {SWEEP_ROWS[0]}), small {sc}\n  " + "\n  ".join(line))
+
+
+def test_chunk_budget(monkeypatch):
+    """One rank's dense EXL3 work of a 2,048-row chunk at 40 layers (+ compressor / indexer / Engram), the current
+    path vs fused (rot_in included in both): the -150 to -220 ms the study budgets."""
+
+    per_layer = [("wq_a", 1), ("wkv", 1), ("wq_b", 1), ("wo_a", 4), ("wo_b", 1), ("sh_gate.5", 2), ("sh_down.5", 1)]
+    extra = [("comp_wkv", 7), ("ix_wq_b", 8), ("engram.5", 2)]
+    M = 2048
+    tot = {"off": 0.0, "fused": 0.0}
+    flop = 0.0
+    for name, n in [(a, b * 40) for a, b in per_layer] + extra:
+        lin = _lin(name)
+        x = _x(M, lin.k)
+        t_off = _ms(lambda lin=lin, x=x: _off(monkeypatch, lin, x, torch.float32), 3)
+        t_on = _ms(lambda lin=lin, x=x: _on(monkeypatch, lin, x, torch.float32), 3)
+        tot["off"] += n * t_off
+        tot["fused"] += n * t_on
+        flop += n * 2.0 * M * lin.k * lin.n
+    print(f"[G16D] pfdense chunk budget (2,048 rows, one rank): {flop / 1e12:.1f} TFLOP; off {tot['off']:.0f} ms "
+          f"({flop / tot['off'] / 1e9:.0f} TFLOP/s), fused {tot['fused']:.0f} ms ({flop / tot['fused'] / 1e9:.0f}); "
+          f"{tot['fused'] - tot['off']:+.0f} ms a chunk")
+
+
+def test_fast_prefill_fused_end_to_end(tmp_path_factory, monkeypatch):
+    import importlib.util
+
+    import dsv41_dspark_fakes as DF
+
+    spec = importlib.util.spec_from_file_location("dsv41_prefill_gpu_g16d", Path(__file__).with_name(
+        "test_dsv41_prefill_gpu.py"))
+    G5 = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(G5)
+    PROMPT, build, prompt = G5.PROMPT, G5.build, G5.prompt
+
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    monkeypatch.setenv("TF_DSV41_FAST_EXPERTS", "gm")
+    ck = DF.ckpt(tmp_path_factory.mktemp("dsv41g16d"))
+    monkeypatch.setenv(PD.ENV, "off")
+    off = prompt(build(ck, 1024), PROMPT)
+    monkeypatch.setenv(PD.ENV, "fused")
+    on = prompt(build(ck, 1024), PROMPT)
+    assert torch.equal(on, off)
+    assert torch.equal(prompt(build(ck, 96), PROMPT), on)
+
+
+@pytest.mark.skipif(not os.environ.get("TF_DSV41_MODEL"), reason="TF_DSV41_MODEL: the real pack's directory")
+@pytest.mark.parametrize("prefix", ["layers.1.attn.wq_a", "layers.1.attn.wq_b", "layers.1.attn.wo_a.slice.0",
+                                    "layers.1.attn.wo_b", "layers.1.ffn.shared_experts.w2", "layers.1.engram.wkv",
+                                    "layers.2.attn.indexer.wk"])
+def test_real_layer_bits(monkeypatch, prefix):
+    from tensorfold.cuda.exl3.linear import Exl3Linear
+
+    stored = "shared_experts" in prefix
+    lin = Exl3Linear.load(os.environ["TF_DSV41_MODEL"], prefix, layout="stored" if stored else "strips")
+    if ".attn." in prefix and "indexer.wk" not in prefix:
+        D3.to_lanes(lin)
+    x = _x(2048, lin.k)
+    for dt in (torch.float32, torch.bfloat16):
+        assert torch.equal(_bits(_on(monkeypatch, lin, x, dt)), _bits(_off(monkeypatch, lin, x, dt))), (prefix, dt)
+    print(f"[G16D] pfdense real {prefix} ({lin.k} x {lin.n}, K2 {lin.k2}, {lin.layout}): fused == off at 2,048 rows")
