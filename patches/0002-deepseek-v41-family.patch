@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+// Bindings of engram_gate.cu (engram_gate.py). Host buffers are passed as addresses (pinned, mapped under UVA).
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAException.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <cuda_runtime.h>
+#include <torch/extension.h>
+
+cudaError_t dsv41_engram_gate_copy(long long*, int, int, const unsigned char*, long long, unsigned char*, long long,
+                                   long long, int, cudaStream_t);
+
+// the device address of pinned host memory (the same value under UVA; cudaHostGetDevicePointer where it differs)
+int64_t device_ptr(int64_t host) {
+    void* d = nullptr;
+    if (cudaHostGetDevicePointer(&d, reinterpret_cast<void*>(host), 0) != cudaSuccess) {
+        (void)cudaGetLastError();
+        return host;
+    }
+    return reinterpret_cast<int64_t>(d);
+}
+
+void gate_copy(int64_t ctl, int64_t ready, int64_t err_slot, int64_t base, int64_t stride, at::Tensor dst,
+               int64_t nbytes, int64_t timeout_ns) {
+    TORCH_CHECK(dst.is_cuda() && dst.is_contiguous(), "engram_gate: dst must be a contiguous CUDA tensor");
+    TORCH_CHECK(nbytes >= 0 && nbytes <= dst.numel() * (int64_t)dst.element_size(), "engram_gate: dst too small");
+    c10::cuda::CUDAGuard guard(dst.device());
+    const bool vec = base % 16 == 0 && stride % 16 == 0 && reinterpret_cast<uintptr_t>(dst.data_ptr()) % 16 == 0;
+    C10_CUDA_CHECK(dsv41_engram_gate_copy(reinterpret_cast<long long*>(ctl), (int)ready, (int)err_slot,
+                                          reinterpret_cast<const unsigned char*>(base), (long long)stride,
+                                          static_cast<unsigned char*>(dst.data_ptr()), (long long)nbytes,
+                                          (long long)timeout_ns, vec ? 1 : 0, at::cuda::getCurrentCUDAStream()));
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("gate_copy", &gate_copy);
+    m.def("device_ptr", &device_ptr);
+}
diff --git a/src/tensorfold/families/deepseek_v41/cuda/engram_gate.cu b/src/tensorfold/families/deepseek_v41/cuda/engram_gate.cu
new file mode 100644
index 0000000..6c2e75a
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/engram_gate.cu
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+// The Engram gate (engram_gate.py): the GPU, not the host, waits for a round's Engram rows.
+//
+// ctl is a pinned host int64 array (mapped: the GPU reads it over UVA / NVLink-C2C): ctl[0] = the round the host
+// armed (written before the launches that read it), ctl[ready] = the last round whose rows of this layer the host
+// worker published (a release store after it wrote them into the pinned staging). Thread 0 of each CTA spins with an
+// acquire load until ctl[ready] >= ctl[0], then the CTA copies its share of the staging buffer of that round's parity
+// (base + (round & 1) * stride) into the device buffer the forward gathers. Inside a CUDA graph this is one kernel
+// node: no host round trip, no event recorded in the future. A wait past timeout_ns stores the layer's slot into
+// ctl[err] and copies whatever is there: the host raises after the window (engram_gate.Gate.check), never a reply.
+#include <cstdint>
+#include <cuda_runtime.h>
+
+namespace {
+
+__device__ __forceinline__ long long ld_acquire_sys(const long long* p) {
+    long long v;
+    asm volatile("ld.acquire.sys.s64 %0, [%1];" : "=l"(v) : "l"(p) : "memory");
+    return v;
+}
+
+__device__ __forceinline__ unsigned long long now_ns() {
+    unsigned long long t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t));
+    return t;
+}
+
+__global__ void gate_copy_kernel(long long* ctl, int ready, int err_slot, const unsigned char* base, long long stride,
+                                 unsigned char* dst, long long nbytes, long long timeout_ns, int vec) {
+    __shared__ long long want_s;
+    if (threadIdx.x == 0) {
+        const long long want = ld_acquire_sys(ctl);
+        const unsigned long long t0 = now_ns();
+        while (ld_acquire_sys(ctl + ready) < want) {
+            if ((long long)(now_ns() - t0) > timeout_ns) {
+                *reinterpret_cast<volatile long long*>(ctl + err_slot) = ready;
+                __threadfence_system();
+                break;
+            }
+            __nanosleep(256);
+        }
+        want_s = want;
+    }
+    __syncthreads();
+    const unsigned char* src = base + (want_s & 1) * stride;
+    const long long step = (long long)gridDim.x * blockDim.x;
+    const long long first = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    long long done = 0;
+    if (vec) {
+        const long long n16 = nbytes >> 4;
+        const uint4* s4 = reinterpret_cast<const uint4*>(src);
+        uint4* d4 = reinterpret_cast<uint4*>(dst);
+        for (long long i = first; i < n16; i += step) d4[i] = __ldcv(s4 + i);
+        done = n16 << 4;
+    }
+    for (long long i = done + first; i < nbytes; i += step) dst[i] = __ldcv(src + i);
+}
+
+}  // namespace
+
+cudaError_t dsv41_engram_gate_copy(long long* ctl, int ready, int err_slot, const unsigned char* base, long long stride,
+                                   unsigned char* dst, long long nbytes, long long timeout_ns, int vec,
+                                   cudaStream_t stream) {
+    const int threads = 256;
+    long long units = vec ? (nbytes + 15) >> 4 : nbytes;
+    long long blocks = (units + threads - 1) / threads;
+    if (blocks < 1) blocks = 1;
+    if (blocks > 64) blocks = 64;
+    gate_copy_kernel<<<(int)blocks, threads, 0, stream>>>(ctl, ready, err_slot, base, stride, dst, nbytes, timeout_ns,
+                                                          vec);
+    return cudaGetLastError();
+}
diff --git a/src/tensorfold/families/deepseek_v41/cuda/engram_gate.py b/src/tensorfold/families/deepseek_v41/cuda/engram_gate.py
new file mode 100644
index 0000000..5ec5af4
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/engram_gate.py
@@ -0,0 +1,491 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Engram reads off the critical path of decode (``TF_DSV41_ENGRAM_GATE=1``; docs/DECODE-ROOFLINE.md section 6).
+
+G7 (rank 0, 1-stream code under nsys): 4.0 of a round's 8.1 ms of GPU idle is the host in ``engram.wait`` inside
+``graph.stage``: the drafted rows' reads were issued after the draft pass and the host blocked on them (and on a
+synchronous H2D copy and an eager exchange) before replaying the window. With 2 / 4 streams (eager windows) the wait
+is 3.3 / 6.5 ms twice a round: the pageable ``.to(device)`` at layers 1 and 14 waits for every kernel queued before it.
+
+Here the GPU waits, not the host:
+
+- **Arm, then replay at once.** ``arm(segs)`` (at graph staging, or the eager forward's Engram inputs) hashes the
+  window, queues one *round job* on a worker thread (if the drafter-end ``issue`` did not already) and writes the
+  round's number into a pinned control word. No wait.
+- **The worker** (one thread; the reads' parallelism is in C) takes every row of the round, all slots and all Engram
+  layers, from its row cache or one native batched read (``engram_native.readv``: the persistent C pool,
+  ``TF_DSV41_ENGRAM_QD`` in flight), turns them into bf16 with a table built by torch's own dequant
+  (``engram_native.dequant``: byte for byte what ``blocks.engram_rows`` gives), writes them into pinned staging (two
+  buffers by the round's parity) and publishes the layer's ready flag with a release store, layer 1 first.
+- **The device side** (``engram_gate.cu``): right before a layer's Engram fusion, one kernel spins until the flag
+  reaches the armed round, then copies the staged rows into a persistent device buffer; the forward gathers the
+  ranks' heads from there (``gather_cols``) as before. In a CUDA graph it is one kernel node reading the control word
+  at run time, so a graph captured once serves every round; layer 14's reads overlap layers 0-13 entirely. CUDA
+  events cannot do this: a stream (or a graph's event-wait node) waits on the event's record made *before* the wait
+  is enqueued, and the worker records only after the replay is launched.
+- **Earlier issue.** At a commit the bonus token's rows (``warm``: cache only); at the end of the DSpark pass the rows
+  of every drafted position of every slot (``warm``); at drafter end the round job (``issue``). The chain picks its
+  tokens inside one graphed kernel, so the pass's end is the first moment the host knows any draft.
+- **Rows by window position.** Staging and device buffers are [rows of the window, this rank's heads x 256] in the
+  forward's row order, ``TF_DSV41_ENGRAM_GATE_ROWS`` (128) rows: a slot-agnostic graph over padded rows reads the
+  first ``rows`` of them (``GatedEngram.view(n)``); the rows past a window's own are stale, finite, and discarded
+  with the padded rows' outputs (every Engram kernel computes a row from that row alone).
+- **Safety.** A worker error still publishes the flags (the GPU never hangs) and is raised after the window
+  (``check``); a GPU wait past ``TF_DSV41_ENGRAM_GATE_TIMEOUT_S`` (30) marks the control word, also raised. Arming a
+  new round synchronizes the stream first (in serving it is idle there: the draft pass and the ids' copy synced it),
+  so a buffer is never rewritten under a running window.
+
+Not gated (the old path, ``decode.LazyEngram``): windows over ``TF_DSV41_ENGRAM_GATE_ROWS`` rows (prompt segments),
+float64 numerics, sources without packed records (``MemoryRows``), no C compiler, a CUDA extension that does not
+build. Knobs: TF_DSV41_ENGRAM_GATE (0; 1 = on), TF_DSV41_ENGRAM_GATE_ROWS (128), TF_DSV41_ENGRAM_GATE_CACHE (65,536
+records a layer, 17 MB; at least one window's), TF_DSV41_ENGRAM_QD (64), TF_DSV41_ENGRAM_GATE_TIMEOUT_S (30),
+TF_DSV41_ENGRAM_GATE_SPLIT (0; 1 = a read batch a layer: the first layer's flag does not wait for the later layers'
+reads), TF_DSV41_ENGRAM_PCACHE (0; rows a layer of projected ``wkv`` rows: ``engram_pcache``). ``describe`` reports
+the worker's ready times after queueing (first layer, all layers; p50 / p90 / p99): the GPU waits at layer 1 when
+the first exceeds the window's head start (G9 prose: layer 1 reached ~2.5-3.3 ms after the round's issue).
+"""
+
+from __future__ import annotations
+
+import os
+import queue
+import sys
+import threading
+import time
+from collections import OrderedDict
+from dataclasses import dataclass, field
+from functools import lru_cache
+
+import numpy as np
+import torch
+
+from . import engram_native as EN
+
+_now = time.perf_counter
+CTL_WANT, CTL_READY, CTL_ERR, CTL_N = 0, 1, 7, 8       # ready flags: CTL_READY + the layer's position (<= 6 layers)
+VALUES = 256                                            # a record's values, then its scale bytes
+
+
+def enabled() -> bool:
+    return (os.environ.get("TF_DSV41_ENGRAM_GATE", "0").strip() or "0") != "0"
+
+
+def _env(name: str, default: float) -> float:
+    raw = os.environ.get(name, "").strip()
+    return float(raw) if raw else default
+
+
+@lru_cache(maxsize=1)
+def bf16_lut() -> np.ndarray:
+    """uint16 [256 x 256]: entry ``scale << 8 | byte`` = the bf16 bits ``engram_host.dequant(...).to(bf16)`` gives
+    for that e4m3 byte under that UE8M0 scale byte (every pair, by torch itself: the forward's own rule)."""
+
+    from .engram_host import dequant
+
+    raw = torch.arange(256, dtype=torch.int32).to(torch.uint8).repeat(256, 1)         # [scale, byte]
+    sc = torch.arange(256, dtype=torch.int32).to(torch.uint8)[:, None].repeat(1, 8)
+    return dequant(raw, sc).to(torch.bfloat16).view(torch.int16).numpy().view(np.uint16).reshape(-1).copy()
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    from pathlib import Path
+
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tf_dsv41_engram_gate_v1", sources=[str(here / "engram_gate.cpp"), str(here / "engram_gate.cu")],
+                extra_cuda_cflags=["-O3", "-lineinfo"], verbose=False)
+
+
+class RowCache:
+    """One layer's records: an LRU over a fixed arena [cap, 264] (the worker thread's alone)."""
+
+    def __init__(self, cap: int, row_bytes: int) -> None:
+        self.cap = int(cap)
+        self.arena = np.zeros((self.cap, row_bytes), dtype=np.uint8)
+        self.where: OrderedDict[int, int] = OrderedDict()
+        self.free = list(range(self.cap - 1, -1, -1))
+
+    def find(self, rows: np.ndarray) -> np.ndarray:
+        """Arena slots of ``rows`` (-1: not cached); hits become the most recent."""
+
+        out = np.full(rows.size, -1, dtype=np.int64)
+        w = self.where
+        for k, r in enumerate(rows.tolist()):
+            s = w.get(r)
+            if s is not None:
+                w.move_to_end(r)
+                out[k] = s
+        return out
+
+    def put(self, rows: np.ndarray, recs: np.ndarray) -> np.ndarray:
+        out = np.empty(rows.size, dtype=np.int64)
+        for k, r in enumerate(rows.tolist()):
+            s = self.free.pop() if self.free else self.where.popitem(last=False)[1]
+            self.where[r] = s
+            out[k] = s
+        self.arena[out] = recs
+        return out
+
+
+@dataclass
+class Ticket:
+    seq: int                    # 0: a warm job (cache only)
+    key: tuple
+    n: int                      # rows of the window
+    idx: dict                   # layer -> global rows [n x heads] (row-major: row, head)
+    done: list = field(default_factory=list)        # threading.Event a layer (published)
+    finished: threading.Event = field(default_factory=threading.Event)
+    error: BaseException | None = None
+    reported: bool = False
+    queued: float = 0.0                             # perf_counter at the round job's queueing
+    keys: dict = field(default_factory=dict)        # layer -> [row keys] (the projected-row cache's, when on)
+    pc_new: dict = field(default_factory=dict)      # layer -> keys this round inserted into it (forgotten on failure)
+
+    def fail(self) -> None:
+        """Raise this round's read error once."""
+
+        if self.error is not None and not self.reported:
+            self.reported = True
+            raise RuntimeError(f"Engram gate: the reads of round {self.seq} failed") from self.error
+
+
+class Gate:
+    """One rank's gated Engram rows (``decode.DecodeForward.gate``). ``shards``: {layer: engram_host.ShardRows}.
+    ``reader(parts) -> [records]``: ``engram_native.readv`` (tests wrap it with delays)."""
+
+    def __init__(self, fw, shards: dict, *, rows: int | None = None, cache: int | None = None, reader=None,
+                 timeout_s: float | None = None) -> None:
+        cfg = fw.cfg
+        self.layers = [blk.index for blk in fw.blocks if blk.engram is not None]            # the forward's order
+        if not 0 < len(self.layers) <= CTL_ERR - CTL_READY:
+            raise ValueError(f"Engram gate: {len(self.layers)} Engram layers")
+        self.pos = {L: k for k, L in enumerate(self.layers)}
+        self.li = {L: cfg.engram_layer_ids.index(L) for L in self.layers}
+        self.src = {L: shards[L] for L in self.layers}
+        lay = fw.hasher.layout
+        self.heads = {L: lay.head_shard(self.li[L], fw.rank, fw.world)[2:] for L in self.layers}   # (h0, nh)
+        self.dim = int(self.src[self.layers[0]].dim)
+        nh = max(n for _, n in self.heads.values())
+        self.width = nh * self.dim
+        self.max_rows = int(rows or _env("TF_DSV41_ENGRAM_GATE_ROWS", 128))
+        self.device = fw.device
+        self.cuda = fw.device.type == "cuda"
+        L, R, W = len(self.layers), self.max_rows, self.width
+        self.staging = torch.zeros((2, L, R, W), dtype=torch.bfloat16, pin_memory=self.cuda)
+        self.stage_np = self.staging.view(torch.int16).numpy().view(np.uint16)
+        self.ctl = torch.zeros(CTL_N, dtype=torch.int64, pin_memory=self.cuda)
+        self.dev = torch.zeros((L, R, W), dtype=torch.bfloat16, device=fw.device)
+        self.lut = bf16_lut()
+        cap = int(_env("TF_DSV41_ENGRAM_GATE_CACHE", 65536) if cache is None else cache)
+        self.caches = {Lr: RowCache(max(cap, R * nh), self.src[Lr].header.row_bytes) for Lr in self.layers}
+        self.reader = reader or EN.readv
+        self.timeout_ns = int(1e9 * (timeout_s if timeout_s is not None else _env("TF_DSV41_ENGRAM_GATE_TIMEOUT_S", 30)))
+        self.ext = None
+        if self.cuda:
+            self.ext = _ext()
+            self.ctl_d = self.ext.device_ptr(self.ctl.data_ptr())
+            self.base_d = [self.ext.device_ptr(self.staging[0, k].data_ptr()) for k in range(L)]
+            self.stride = self.staging[1].data_ptr() - self.staging[0].data_ptr()
+        self.seq = 0
+        self.cur: Ticket | None = None          # the newest round job
+        self.armed: Ticket | None = None        # the round the control word names
+        self.synced = 0                         # every run armed with a round <= this one is complete
+        self.stats = {"rounds": 0, "warm": 0, "rows": 0, "cached": 0, "read": 0, "syncs": 0, "reissued": 0}
+        from . import engram_pcache as EP
+
+        self.pc = EP.make(fw, self.layers, self.max_rows)          # TF_DSV41_ENGRAM_PCACHE (default off)
+        self.split = (os.environ.get("TF_DSV41_ENGRAM_GATE_SPLIT", "0").strip() or "0") != "0"
+        self.lat: list = []                     # (layer 1 published, round done) ms after the job's queueing
+        self.q: queue.Queue = queue.Queue()
+        self.thread = threading.Thread(target=self._loop, name="dsv41-engram-gate", daemon=True)
+        self.thread.start()
+
+    # -- the main thread -------------------------------------------------------------------------------------------
+    def close(self) -> None:
+        self.q.put(None)
+        self.thread.join(timeout=10)
+
+    def _idx(self, fw, items, keys: dict | None = None) -> dict:
+        """items [(slot, ids, lookback)] -> {layer: this rank's rows [n x heads]} in window row order; ``keys``
+        (given): {layer: every head's row ids of each row, as bytes} (the projected-row cache's keys)."""
+
+        hashes = torch.cat([fw.hasher(torch.tensor([int(t) for t in ids], dtype=torch.long),
+                                      lookback=torch.tensor([int(t) for t in lb if t >= 0], dtype=torch.long))
+                            for _, ids, lb in items])
+        out = {}
+        for L in self.layers:
+            h0, nh = self.heads[L]
+            out[L] = np.ascontiguousarray(hashes[:, self.li[L], h0:h0 + nh].reshape(-1).numpy(), dtype=np.int64)
+            if keys is not None:
+                full = np.ascontiguousarray(hashes[:, self.li[L], :].numpy(), dtype=np.int64)
+                keys[L] = [r.tobytes() for r in full]
+        return out
+
+    @staticmethod
+    def items(fw, segs) -> list:
+        return [(sg.slot, tuple(int(t) for t in sg.ids), tuple(int(t) for t in fw.slots[sg.slot].tail if t >= 0))
+                for sg in segs]
+
+    def eligible(self, n: int) -> bool:
+        from . import numerics as N
+
+        return 0 < n <= self.max_rows and N.ACT is torch.bfloat16
+
+    def warm(self, fw, items) -> None:
+        """Cache-only reads of ``items`` [(slot, ids, lookback)] (a commit's bonus row, the drafted rows)."""
+
+        items = [(s, tuple(int(t) for t in ids), tuple(int(t) for t in lb if t >= 0)) for s, ids, lb in items if ids]
+        if items:
+            self.stats["warm"] += 1
+            self.q.put(Ticket(0, (), 0, self._idx(fw, items)))
+
+    def issue(self, fw, segs) -> Ticket | None:
+        """The round job of the window ``segs`` (the one already queued when its key matches), or None."""
+
+        items = self.items(fw, segs)
+        n = sum(len(ids) for _, ids, _ in items)
+        if not self.eligible(n):
+            return None
+        key = tuple(items)
+        if self.cur is not None and self.cur.key == key and self.cur.error is None:
+            return self.cur
+        if self.cur is not None and self.cur is not self.armed:
+            self.stats["reissued"] += 1
+        self.seq += 1
+        a = self.armed
+        if a is not None and a.seq > self.synced and (a.seq - self.seq) % 2 == 0:
+            self._sync()                        # a running window may still read the staging buffer of this parity
+        keys = {} if self.pc is not None else None
+        t = Ticket(self.seq, key, n, self._idx(fw, items, keys), [threading.Event() for _ in self.layers],
+                   keys=keys or {})
+        t.queued = _now()
+        self.cur = t
+        self.stats["rounds"] += 1
+        self.q.put(t)
+        return t
+
+    def _sync(self) -> None:
+        if self.cuda:
+            if torch.cuda.is_current_stream_capturing():
+                raise RuntimeError("Engram gate: a new round armed inside a CUDA graph capture")
+            torch.cuda.current_stream(self.device).synchronize()
+            self.stats["syncs"] += 1
+        self.synced = self.armed.seq if self.armed is not None else 0
+
+    def arm(self, fw, segs) -> Ticket | None:
+        t = self.issue(fw, segs)
+        if t is None or t is self.armed:
+            return t
+        if self.armed is not None:
+            self._sync()                        # every run armed before has read its rows
+            self.check()                        # ... and none of them read a failed round (a run without ``check``)
+        self.armed = t
+        if self.pc is not None:                 # the stream is idle here (synced above): plans are safe to rewrite
+            t.pc_new = self.pc.plan(t.keys)
+        self.ctl[CTL_WANT] = t.seq              # a host write before the launches that read it
+        return t
+
+    def inputs(self, fw, segs):
+        """The forward's Engram inputs of ``segs``: a ``GatedEngram``, or None (not gated: the old path)."""
+
+        t = self.arm(fw, segs)
+        return None if t is None else GatedEngram(self, fw, t.n)
+
+    def rows(self, fw, L: int, n: int) -> torch.Tensor:
+        """Layer ``L``'s gathered rows [n, world x heads x dim] bf16: on CUDA the gate kernel (the stream waits for the
+        armed round's flag), else the host waits for it."""
+
+        k = self.pos[L]
+        dst = self.dev[k, :n]
+        out = self._rows(fw, k, dst, n)
+        if self.pc is not None:
+            out.dsv41_pcache = (self.pc, k)     # ``blocks.engram`` projects through the cache
+        return out
+
+    def _rows(self, fw, k: int, dst: torch.Tensor, n: int) -> torch.Tensor:
+        if self.cuda:
+            self.ext.gate_copy(self.ctl_d, CTL_READY + k, CTL_ERR, self.base_d[k], self.stride, dst,
+                               n * self.width * 2, self.timeout_ns)
+        else:
+            t = self.armed
+            t.done[k].wait()
+            t.fail()
+            dst.copy_(self.staging[t.seq & 1, k, :n])
+        return fw.gather_cols(dst)
+
+    def check(self) -> None:
+        """After a window: a failed read or a timed-out GPU wait raises (the window's logits are not used); the
+        projected rows that window stored from stale rows are forgotten first."""
+
+        t = self.armed
+        try:
+            self._check()
+        except BaseException:
+            self._forget(t)
+            raise
+        if t is not None and t.error is not None:       # reported before (the CPU path raises inside the forward)
+            self._forget(t)
+
+    def _forget(self, t: Ticket | None) -> None:
+        if self.pc is not None and t is not None and t.pc_new:
+            self.pc.forget(t.pc_new)
+            t.pc_new = {}
+
+    def _check(self) -> None:
+        t = self.armed
+        if t is not None:
+            s = float(os.environ.get("TF_DSV41_ENGRAM_WAIT_S", "") or 300)
+            if not t.finished.wait(s if s > 0 else None):     # G12 bug 2: no round waits on the worker forever
+                alive = self.thread.is_alive()
+                raise RuntimeError(f"Engram gate: round {t.seq}'s reads not finished after {s:g} s "
+                                   f"(TF_DSV41_ENGRAM_WAIT_S; worker {'alive' if alive else 'dead'})")
+            t.fail()
+        if int(self.ctl[CTL_ERR]):
+            slot = int(self.ctl[CTL_ERR])
+            self.ctl[CTL_ERR] = 0
+            raise RuntimeError(f"Engram gate: the GPU waited past the timeout for layer {self.layers[slot - 1]}")
+
+    def describe(self) -> str:
+        s = self.stats
+        out = (f"Engram gate: {s['rounds']} rounds ({s['reissued']} reissued), {s['warm']} warm jobs, rows "
+               f"{s['rows']} ({s['cached']} cached, {s['read']} read), {s['syncs']} syncs")
+        if self.lat:
+            a = np.asarray(self.lat[-4096:])
+            p = np.percentile(a, [50, 90, 99], axis=0)
+            out += (f"; first layer ready p50/p90/p99 {p[0, 0]:.2f} / {p[1, 0]:.2f} / {p[2, 0]:.2f} ms, all "
+                    f"{p[0, 1]:.2f} / {p[1, 1]:.2f} / {p[2, 1]:.2f} ms after queueing")
+        return out + (f"; {self.pc.describe()}" if self.pc is not None else "")
+
+    # -- the worker --------------------------------------------------------------------------------------------------
+    def _loop(self) -> None:
+        while True:
+            t = self.q.get()
+            if t is None:
+                return
+            try:
+                self._job(t)
+            except BaseException as exc:        # noqa: BLE001  (raised on the main thread by ``check`` / ``rows``)
+                t.error = exc
+                print(f"[tensorfold] dsv41 Engram gate: round {t.seq} failed: {exc!r}", file=sys.stderr, flush=True)
+                if t.seq:
+                    for k in range(len(self.layers)):
+                        try:                    # the flags must go up (the GPU waits on them); the worker lives on
+                            self._publish(t, k)
+                        except BaseException as exc2:   # noqa: BLE001
+                            print(f"[tensorfold] dsv41 Engram gate: publish {k} of round {t.seq} failed: {exc2!r}",
+                                  file=sys.stderr, flush=True)
+            finally:
+                t.finished.set()
+
+    def _fill(self, t: Ticket, layers=None) -> dict:
+        """Every row of ``t`` (of ``layers``: all by default) in the caches (one batched read of the missing ones):
+        {layer: arena slot a row}."""
+
+        layers = self.layers if layers is None else layers
+        uniq, slots, parts, miss = {}, {}, [], []
+        for L in layers:
+            u = np.unique(t.idx[L])
+            s = self.caches[L].find(u)
+            uniq[L], slots[L] = u, s
+            m = u[s < 0]
+            if m.size:
+                h = self.src[L].header
+                parts.append((self.src[L].fd, m, h.lo, h.row_bytes, 4096, getattr(self.src[L], "gap", 4096)))
+                miss.append(L)
+            self.stats["rows"] += int(u.size)
+            self.stats["cached"] += int(u.size - m.size)
+        if parts:
+            for L, part, recs in zip(miss, parts, self.reader(parts)):
+                m = part[1]
+                if m.size and (m.min() < self.src[L].header.lo or m.max() >= self.src[L].header.hi):
+                    raise ValueError(f"{self.src[L].path}: rows outside this shard")
+                slots[L][slots[L] < 0] = self.caches[L].put(m, recs)
+                self.stats["read"] += int(m.size)
+        return {L: slots[L][np.searchsorted(uniq[L], t.idx[L])] for L in layers}
+
+    def _job(self, t: Ticket) -> None:
+        """A round: its rows read (one batch for every layer; ``TF_DSV41_ENGRAM_GATE_SPLIT=1``: a batch a layer, so
+        the first layer publishes before the later layers' reads), staged as bf16, each layer's flag published."""
+
+        if not t.seq:
+            self._fill(t)
+            return
+        at = {} if self.split else self._fill(t)
+        first = None
+        for k, L in enumerate(self.layers):
+            if self.split:
+                at.update(self._fill(t, [L]))
+            self._stage(t, k, at[L])
+            first = first if first is not None else _now()
+        if t.queued:
+            self.lat.append(((first - t.queued) * 1e3, (_now() - t.queued) * 1e3))
+            del self.lat[:-8192]
+
+    def _stage(self, t: Ticket, k: int, at: np.ndarray) -> None:
+        L = self.layers[k]
+        nh = self.heads[L][1]
+        if nh * self.dim != self.width:
+            raise ValueError("Engram gate: layers with different head counts")
+        out = self.stage_np[t.seq & 1, k, :t.n, :nh * self.dim].reshape(t.n * nh, self.dim)
+        EN.dequant(self.caches[L].arena, at, self.dim, VALUES, self.lut, out)
+        self._publish(t, k)
+
+    def _publish(self, t: Ticket, k: int) -> None:
+        EN.publish(self.ctl.data_ptr() + 8 * (CTL_READY + k), t.seq)
+        t.done[k].set()
+
+
+class GatedEngram:
+    """A window's Engram inputs through the gate: ``self[L]`` launches the gate and the gather when the forward
+    reaches layer L. ``items()`` is empty: nothing to stage before a replay (``graphs.CudaGraphs._stage``)."""
+
+    def __init__(self, gate: Gate, fw, n: int) -> None:
+        self.gate, self.fw, self.n = gate, fw, n
+
+    def view(self, n: int) -> GatedEngram:
+        """The same round over ``n`` rows (a graph over padded rows: the rows past the window's are discarded)."""
+
+        if not 0 < n <= self.gate.max_rows:
+            raise ValueError(f"Engram gate: {n} rows (at most {self.gate.max_rows})")
+        return GatedEngram(self.gate, self.fw, n)
+
+    def __getitem__(self, L: int) -> torch.Tensor:
+        return self.gate.rows(self.fw, L, self.n)
+
+    def __contains__(self, L) -> bool:
+        return L in self.gate.pos
+
+    def keys(self):
+        return list(self.gate.layers)
+
+    def items(self):
+        return []
+
+    def __len__(self) -> int:
+        return len(self.gate.layers)
+
+
+def make(fw, sources: dict) -> Gate | None:
+    """The gate when ``TF_DSV41_ENGRAM_GATE`` is on and every Engram layer reads a packed shard with the native
+    library (and on CUDA its extension) available; else None (the old path), saying why."""
+
+    if not enabled() or fw.hasher is None:
+        return None
+    why = None
+    shards = {L: getattr(s, "src", s) for L, s in sources.items()}
+    if not EN.available():
+        why = "no native Engram reader (C compiler)"
+    elif not all(hasattr(shards.get(blk.index), "header") for blk in fw.blocks if blk.engram is not None):
+        why = "Engram sources without packed records"
+    if why is None:
+        try:
+            return Gate(fw, shards)
+        except Exception as exc:                # noqa: BLE001  (the extension: the old path still serves)
+            why = repr(exc)[:200]
+    print(f"[tensorfold] dsv41 Engram gate off: {why}", file=sys.stderr, flush=True)
+    return None
+
+
+__all__ = ["Gate", "GatedEngram", "RowCache", "Ticket", "bf16_lut", "enabled", "make"]
