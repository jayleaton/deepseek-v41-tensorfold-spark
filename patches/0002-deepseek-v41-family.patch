+@pytest.mark.torch
+@pytest.mark.parametrize("slots", [2, 4])
+def test_joint_drafted_equals_serial(ck, slots, monkeypatch):
+    """2 and 4 slots decoding together with the joint depth (cheap shared rows: deep joint windows) give the serial
+    replies at T = 0 and T > 0; the joint depth off gives the same replies."""
+
+    import dsv41_dspark_fakes as DF
+
+    from tensorfold.families.deepseek_v41.cuda.batch import Job
+
+    ps, ss = _prompts(slots), _samplings(slots)
+    want = DF.run(DF.batcher(ck, DF.forward(ck, slots=slots, dspark=False), n=slots, depth=0),
+                  [Job(list(p), 20, s) for p, s in zip(ps, ss)])
+    got = {}
+    for on in ("1", "0"):
+        monkeypatch.setenv("TF_DSV41_DEPTH_JOINT", on)
+        fw = DF.forward(ck, slots=slots)
+        assert fw.depth.joint is (on == "1")
+        b = DF.batcher(ck, fw, n=slots)
+        costs = depth.Costs([30.0, 36.0] + [36.0 + 0.5 * r for r in range(1, 62)], 4.0, slot=5.0)
+        fw.set_costs(costs)
+        b.planner.costs = costs
+        jobs = [Job(list(p), 20, s) for p, s in zip(ps, ss)]
+        got[on] = DF.run(b, jobs)
+        assert got[on] == want
+        assert sum(j.stats["drafting"]["dspark_rounds"] for j in jobs) > 0
+        if on == "1":
+            assert fw.depth.stats.joint[0] > 0 and fw.depth.stats.joint[1] > 2 * fw.depth.stats.joint[0]
+        else:
+            assert fw.depth.stats.joint[0] == 0
+    assert got["1"] == got["0"]
+
+
+@pytest.mark.torch
+def test_measure_wide_buckets_on_four_slots(ck):
+    """``calib.measure`` with 4 slots: the table runs to 64 rows (24 / 32 / 48 / 64 on 2-4 slots), monotone, with
+    a slot overhead; the slots are left reset."""
+
+    import dsv41_dspark_fakes as DF
+
+    fw = DF.forward(ck, slots=4, limit=1024)
+    b = DF.batcher(ck, fw, n=4)
+    p = _prompts(1)[0] * 3
+    c = calib.measure(fw, p, ensure=lambda s, end: b.ex.slots[s].ensure(end), gather_max=lambda v: list(v),
+                      sync=lambda: None, reps=1, slots=4, max_rows=64)
+    assert len(c.verify) == 64 and c.slot >= 0.0 and c.draft > 0
+    assert all(y >= x for x, y in itertools.pairwise(c.verify))
+    one = calib.measure(fw, p, ensure=lambda s, end: b.ex.slots[s].ensure(end), gather_max=lambda v: list(v),
+                        sync=lambda: None, reps=1, slots=1)
+    assert len(one.verify) == 16 and one.slot == 0.0
