@@ -0,0 +1,205 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The e1 CUDA mHC boundary (families/deepseek_v41/cuda/mhc_cuda.cu, TF_DSV41_MHC_CUDA) on the CPU:
+
+- its numpy emulator (``mhc_cuda_emu``) == the bit-for-bit torch emulation of the Triton path (``dsv41_kref``):
+  new streams, collapsed row, taps, every partial and the normed input, at the model's D = 5,120: boundary (world
+  1 / 2, fn fp32 / bf16, bf16 / fp32 partials), site (stream 0 / the carried pre-mix), final; the coefficients within
+  the Triton tests' tolerance of torch (ex2.approx / div.full are modelled; the GPU test checks their bits);
+- row invariance: a row alone == the same row of a 5-row window, every output bit for bit;
+- the placement as data: every (row, chain) exactly once with <= 4 chains a thread, every partial staged exactly
+  once in ascending entry order within the 10 KiB stages, every coefficient row on 16 lanes of a warp < 4;
+- the kernel source agrees with the model (constants, the chunk rule, the PTX instructions it asks for), and the
+  dispatch (``why_not``) declines what it should.
+
+Run: python -m pytest -q tests/test_dsv41_mhc_cuda_emu.py
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+
+import dsv41_kref as KR
+
+from tensorfold.families.deepseek_v41.cuda import mhc_cuda as MC
+from tensorfold.families.deepseek_v41.cuda import mhc_cuda_emu as E
+
+D = 5120
+CU = Path(MC.__file__).with_name("mhc_cuda.cu")
+EPS, HC_EPS, ALPHA, ITERS = 1e-20, 1e-6, 2.0, 20
+
+
+def _case(R: int, world: int = 2, seed: int = 1, fn_dtype=torch.float32, gdtype=torch.bfloat16):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn((R, 4 * D), generator=g).to(torch.bfloat16)
+    gathered = (torch.randn((world, R, D), generator=g) * 0.7).to(torch.bfloat16).to(gdtype)
+    if gdtype == torch.float32:
+        gathered = gathered + torch.randn((world, R, D), generator=g) * 1e-3     # not bf16 values
+    comb = torch.rand((R, 4, 4), generator=g)
+    comb = (comb / comb.sum(1, keepdim=True)).reshape(R, 16).contiguous()
+    pre = torch.rand((R, 4), generator=g) + 0.1
+    post = torch.rand((R, 4), generator=g) * 2
+    fn = (torch.randn((24, 4 * D), generator=g) * 0.01).to(fn_dtype).contiguous()
+    base, scale = torch.randn(24, generator=g) * 0.5, torch.rand(3, generator=g) + 0.5
+    nw = (torch.rand(D, generator=g) + 0.5).to(torch.bfloat16)
+    return {"x": x, "gathered": gathered, "post": post, "comb": comb, "pre": pre, "fn": fn, "base": base,
+            "scale": scale, "nw": nw}
+
+
+def _np(t):
+    return None if t is None else t.float().numpy()
+
+
+def _emu(c: dict, collapse: int = 2, mix: bool = True, post_on: bool = True) -> dict:
+    return E.emulate(_np(c["x"]), _np(c["gathered"]) if post_on else None, _np(c["post"]), _np(c["comb"]),
+                     _np(c["pre"]), _np(c["fn"]), _np(c["base"]), _np(c["scale"]), _np(c["nw"]), collapse=collapse,
+                     mix=mix, eps=EPS, hc_eps=HC_EPS, post_alpha=ALPHA, iters=ITERS)
+
+
+def _ref(c: dict, collapse: int = 2, post_on: bool = True, mix: bool = True) -> dict:
+    r = KR.mhc_boundary(c["x"], c["gathered"] if post_on else None, c["post"], c["comb"],
+                        c["pre"] if collapse == 2 else None, collapse, c["fn"] if mix else None, E.NB)
+    r["out"] = KR.mhc_finish_norm(r["part"], r["c"], c["nw"], EPS)
+    if mix:
+        r["pre"], r["post"], r["comb"] = KR.mhc_coefficients(r["part"], c["base"], c["scale"], D, EPS, HC_EPS, ALPHA,
+                                                             ITERS)
+    return r
+
+
+def _same(a: np.ndarray, b, what: str):
+    b = b.float().numpy() if isinstance(b, torch.Tensor) else b
+    a = np.ascontiguousarray(a, dtype=np.float32)
+    b = np.ascontiguousarray(b, dtype=np.float32)
+    assert a.shape == b.shape, (what, a.shape, b.shape)
+    bad = np.flatnonzero(a.view(np.uint32) != b.view(np.uint32))
+    assert bad.size == 0, f"{what}: {bad.size} differ, first at {bad[0]}: {a.flat[bad[0]]} vs {b.flat[bad[0]]}"
+
+
+def _check_vs_ref(e: dict, r: dict, post_on: bool, mix: bool, what: str):
+    if post_on:
+        _same(e["x"], r["x"], f"{what} streams")
+        _same(e["tap"], r["tap"], f"{what} taps")
+    _same(e["c"], r["c"], f"{what} collapsed row")
+    _same(e["part"][:, 0, :, 25], r["part"][:, 0, :, 25], f"{what} collapsed square sums")
+    if mix:
+        _same(e["part"][..., :25], r["part"][..., :25], f"{what} partials")
+    _same(e["out"], r["out"], f"{what} normed input")
+    if mix:
+        tol = {"pre": (2e-6, 2e-6), "post": (2e-6, 2e-6), "comb": (1e-5, 2e-6)}
+        for k, (rt, at) in tol.items():
+            torch.testing.assert_close(torch.from_numpy(e[k]).view(r[k].shape), r[k], rtol=rt, atol=at)
+
+
+@pytest.mark.parametrize("R,world,fn_dtype,gdtype", [(1, 2, torch.bfloat16, torch.bfloat16),
+                                                     (3, 2, torch.float32, torch.bfloat16),
+                                                     (2, 1, torch.bfloat16, torch.float32)])
+def test_boundary_equals_kref(R, world, fn_dtype, gdtype):
+    c = _case(R, world, seed=10 + R, fn_dtype=fn_dtype, gdtype=gdtype)
+    _check_vs_ref(_emu(c), _ref(c), True, True, f"boundary R={R} world={world} fn={fn_dtype} g={gdtype}")
+
+
+@pytest.mark.parametrize("collapse", [1, 2])
+def test_site_equals_kref(collapse):
+    c = _case(2, seed=20 + collapse, fn_dtype=torch.bfloat16)
+    _check_vs_ref(_emu(c, collapse, post_on=False), _ref(c, collapse, post_on=False), False, True,
+                  f"site collapse={collapse}")
+
+
+def test_final_equals_kref():
+    c = _case(2, seed=31)
+    _check_vs_ref(_emu(c, mix=False), _ref(c, mix=False), True, False, "final")
+
+
+def test_row_invariance():
+    R = 5
+    c = _case(R, seed=44, fn_dtype=torch.bfloat16)
+    full = _emu(c)
+    for r in range(R):
+        one = dict(c)
+        for k in ("x", "post", "comb", "pre"):
+            one[k] = c[k][r:r + 1]
+        one["gathered"] = c["gathered"][:, r:r + 1]
+        a = _emu(one)
+        for k, v in a.items():
+            _same(v, full[k][r:r + 1], f"row {r} alone: {k}")
+
+
+@pytest.mark.parametrize("mix", [True, False])
+@pytest.mark.parametrize("lead", [True, False])
+def test_chain_slots_cover_every_chain_once(lead, mix):
+    if not (lead or mix):
+        return                                    # final's other CTAs do not exist (grid 40 x 1)
+    for R in range(1, E.MAXR + 1):
+        slots = E.chain_slots(R, lead, mix)
+        seen = [ch for th in slots for ch in th]
+        want = [(r, k if mix else 25) for r in range(R) for k in range(E.kinds(lead, mix))]
+        if not mix:
+            want = [(r, 25) for r in range(R)]
+        assert sorted(seen) == sorted(want) and len(seen) == len(set(seen)), (R, lead, mix)
+        assert max(len(th) for th in slots) <= 4
+        if mix:
+            assert all(k < 25 or lead for _, k in seen)
+
+
+def test_stage_map_covers_partials_in_order():
+    for R in range(1, E.MAXR + 1):
+        ch = E.chunk_entries(R)
+        assert E.NE % ch == 0 and ch % 5 == 0       # the summing loop is unrolled by 5
+        stages = E.stage_map(R)
+        assert all(len(s) <= E.STAGE4 for s in stages), R
+        got = [x for s in stages for x in s]
+        assert len(got) == len(set(got)) == R * E.NE * E.NQ
+        for r in range(R):                          # a row's entries arrive chunk by chunk, ascending
+            order = [e for s in stages for (rr, e, q) in s if rr == r and q == 0]
+            assert order == list(range(E.NE))
+        assert R * E.NQ <= E.NT                     # a summing thread a (row, quad)
+
+
+def test_coef_lanes():
+    for R in range(1, E.MAXR + 1):
+        m = E.coef_lanes(R)
+        assert sorted(m) == list(range(R)), R
+        assert all(w < 4 for w, _ in m.values())
+        assert len(set(m.values())) == len(m) or R > 8          # rows r and r + 8 share lanes on two passes
+
+
+def test_source_agrees_with_model():
+    src = CU.read_text()
+    consts = dict(re.findall(r"constexpr int (\w+) = ([^;]+);", src))
+    assert consts["D"] == "5120" and consts["NB"] == "40" and consts["MAXR"] == "16" and consts["NT"] == "128"
+    assert consts["NQ"] == "7" and consts["STAGE4"] == "640" and consts["ROWB"] == str(MC.ROWB)
+    assert E.NB == MC.NB == int(consts["NB"]) and MC.D == D and MC.MAX_ROWS == E.MAXR
+    m = re.search(r"chunk_entries\(int R\) \{[^\n]*\n\s*return ([^;]+);", src)
+    rule = m.group(1).replace("R <=", "R<=").replace(" ", "")
+    assert rule == "R<=1?80:R<=2?40:R<=4?20:R<=9?10:5"
+    assert '"ex2.approx.f32 %0, %1;"' in src and "approx.ftz" not in src
+    assert '"div.full.f32 %0, %1, %2;"' in src and '"cvt.rn.bf16.f32 %0, %1;"' in src
+    assert "0x3FB8AA3B" in src and "0xBFB8AA3B" in src
+    assert src.count("__fmaf_rn") == 1                          # the chains' one FMA; everything else rounds twice
+    for bad in ("__expf", "__fdividef", "fast_math", "use_fast_math", "rsqrtf"):
+        assert bad not in src, bad
+    from tensorfold.families.deepseek_v41.cuda import mhc
+
+    assert mhc.CONSTS == (EPS, HC_EPS, ALPHA, ITERS) and mhc.NB == E.NB
+
+
+def test_dispatch_declines(monkeypatch):
+    c = _case(1, seed=3)
+    args = (c["x"], torch.zeros_like(c["x"]), c["gathered"], None, c["pre"], None, c["nw"],
+            torch.zeros((1, D), dtype=torch.bfloat16), None, None, None, True, True)
+    monkeypatch.delenv("TF_DSV41_MHC_CUDA", raising=False)
+    assert MC.why_not(1, *args) == "off"
+    monkeypatch.setenv("TF_DSV41_MHC_CUDA", "1")
+    assert MC.why_not(17, *args) == "rows"
+    assert MC.why_not(1, *args) == "device or shape"           # CPU tensors: the Triton / torch path
+    monkeypatch.setenv("TF_DSV41_MHC_CUDA_ROWS", "4")
+    assert MC.max_rows() == 4 and MC.why_not(5, *args) == "rows"
+    monkeypatch.setenv("TF_DSV41_MHC_CUDA_ROWS", "17")
+    with pytest.raises(ValueError):
+        MC.max_rows()
