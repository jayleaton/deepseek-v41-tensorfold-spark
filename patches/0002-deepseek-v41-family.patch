+    from tensorfold.families.deepseek_v41.cuda.draft_graphs import pad_slots
+
+    assert [pad_slots(n) for n in (1, 2, 3, 4, 5, 8)] == [1, 2, 4, 4, 8, 8]
+    fw = DF.forward(ck, slots=3)
