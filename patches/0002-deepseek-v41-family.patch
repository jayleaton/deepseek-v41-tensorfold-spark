@@ -0,0 +1,124 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""dense3.cu (TF_DSV41_DENSE_V3) builds for sm_121 (GB10) without torch headers (-DDSV41_DENSE3_NO_TORCH): every
+instance the launcher dispatches (K2 4-12; 4 warps at 3 and 4 blocks an SM, 8 warps at 1 and 2), the lanes unpack
+and the two relayout kernels, with x3seg's flags. The default occupancy (dense3.minb: "3,1") has NO spills and no
+stack frame at every width; the 128-register sweep instances ("4,2") must fit their occupancy and their spills are
+printed. With a cuobjdump (TF_CUOBJDUMP, PATH, or Triton's bundled one) the SASS of K2 10 at 4 warps / 3 blocks is
+checked: the weights come in 16-byte LDG.E.128 (5 a lane a 2-step group, 5 more in the prologue), one SHFL.IDX a
+tile pair, 16 HMMA and 64 IDP.4A (decode) a k step, nothing in local memory. Needs an nvcc that knows compute_121
+(TF_NVCC, PATH or CUDA_HOME); skipped otherwise. Prints [G13] registers / spills."""
+
+from __future__ import annotations
+
+import glob
+import os
+import re
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+import tensorfold.cuda.exl3 as upstream
+from tensorfold.families.deepseek_v41.cuda import dense3 as D3
+
+CU = Path(D3.__file__).with_name("dense3.cu")
+OCC = ((4, 3), (4, 4), (8, 1), (8, 2))
+DEFAULT = {(4, 3), (8, 1)}
+CFGS = [(k2, wk, mb) for k2 in D3.K2S for wk, mb in OCC]
+KERNEL = "_ZN12dsv41_dense319lanes_linear_kernelILi10ELi2ELi4ELi3EEEvN11dsv41_x3seg8LinTableEii"
+
+
+def _nvcc() -> str | None:
+    for cand in (os.environ.get("TF_NVCC"), shutil.which("nvcc"),
+                 os.path.join(os.environ.get("CUDA_HOME", "/usr/local/cuda"), "bin", "nvcc")):
+        if cand and os.path.exists(cand):
+            try:
+                archs = subprocess.run([cand, "--list-gpu-arch"], capture_output=True, text=True, timeout=60, check=False).stdout
+            except (OSError, subprocess.SubprocessError):
+                continue
+            if "compute_121" in archs:
+                return cand
+    return None
+
+
+def _cuobjdump() -> str | None:
+    cands = [os.environ.get("TF_CUOBJDUMP"), shutil.which("cuobjdump")]
+    try:
+        import triton
+
+        cands += glob.glob(str(Path(triton.__file__).parent / "backends" / "nvidia" / "bin" / "cuobjdump"))
+    except ImportError:
+        pass
+    return next((c for c in cands if c and os.path.exists(c)), None)
+
+
+NVCC = _nvcc()
+pytestmark = pytest.mark.skipif(NVCC is None, reason="no nvcc with compute_121 (TF_NVCC)")
+
+
+@pytest.fixture(scope="module")
+def build(tmp_path_factory):
+    tmp = tmp_path_factory.mktemp("dense3")
+    src = tmp / "inst.cu"
+    lines = [f'#include "{CU.name}"\n']
+    for k2, wk, mb in CFGS:
+        lines.append(f"template __global__ void dsv41_dense3::lanes_linear_kernel<{k2}, 2, {wk}, {mb}>"
+                     "(const dsv41_x3seg::LinTable, int, int);\n")
+    for k2 in D3.K2S:
+        lines.append(f"template __global__ void dsv41_dense3::lanes_unpack_kernel<{k2}, 2>"
+                     "(const uint32_t*, half*, int, int64_t, int64_t);\n")
+    src.write_text("".join(lines))
+    inc = [f"-I{CU.parent}", f"-I{Path(upstream.__file__).parent}"]
+    if os.environ.get("TF_CUDA_INCLUDE"):
+        inc.append(f"-I{os.environ['TF_CUDA_INCLUDE']}")
+    obj = tmp / "inst.o"
+    out = subprocess.run([NVCC, "-std=c++17", "-O3", "--expt-relaxed-constexpr", "-DDSV41_DENSE3_NO_TORCH", *inc,
+                          "-gencode=arch=compute_121,code=sm_121", "-Xptxas", "-v", "-c", str(src), "-o", str(obj)],
+                         capture_output=True, text=True, timeout=1800, check=False)
+    assert out.returncode == 0, out.stderr[-3000:]
+    rows = {}
+    for block in out.stderr.split("Compiling entry function")[1:]:
+        name = re.match(r" '(\S+)'", block).group(1)
+        regs = int(re.search(r"Used (\d+) registers", block).group(1))
+        spill = int(re.search(r"(\d+) bytes spill stores", block).group(1))
+        stack = int(re.search(r"(\d+) bytes stack frame", block).group(1))
+        rows[name] = (regs, spill, stack)
+    return obj, rows
+
+
+def test_every_instance_builds_and_fits_its_occupancy(build):
+    _, rows = build
+    lin = {n: v for n, v in rows.items() if "lanes_linear_kernel" in n}
+    assert len(lin) == len(CFGS)
+    assert sum("lanes_unpack_kernel" in n for n in rows) == len(D3.K2S)
+    assert any("to_lanes_kernel" in n for n in rows) and any("to_strips_kernel" in n for n in rows)
+    lines = []
+    for name, (regs, spill, stack) in sorted(lin.items()):
+        k2, wk, mb = (int(v) for v in re.search(r"ILi(\d+)ELi2ELi(\d+)ELi(\d+)E", name).groups())
+        assert regs * 32 * wk * mb <= 65536 and regs <= 255, (k2, wk, mb, regs)
+        if (wk, mb) in DEFAULT:
+            assert spill == 0 and stack == 0, (k2, wk, mb, spill, stack)
+        lines.append(f"K2 {k2} WK {wk} MINB {mb}: {regs} regs, {spill} B spill")
+    for name, (regs, spill, stack) in rows.items():
+        if "lanes_linear_kernel" not in name:
+            assert spill == 0 and stack == 0, name
+    print("[G13] dense3 sm_121: " + "; ".join(lines))
+
+
+def test_sass_k2_10_loads_16_bytes_and_no_local_memory(build):
+    obj, _ = build
+    tool = _cuobjdump()
+    if tool is None:
+        pytest.skip("no cuobjdump (TF_CUOBJDUMP)")
+    sass = subprocess.run([tool, "-sass", "-fun", KERNEL, str(obj)], capture_output=True, text=True, timeout=600, check=False).stdout
+    count = lambda pat: len(re.findall(pat, sass))
+    ldg128 = count(r"LDG\.E\.128\.CONSTANT")
+    assert ldg128 == 10, ldg128                           # the prologue's group + the loop's next group: 5 + 5
+    assert count(r"SHFL\.IDX") == 8                       # 4 tile pairs a step, 2 steps a group
+    assert count(r"HMMA\.16816\.F32") == 32 and count(r"IDP\.4A") == 128
+    assert count(r"\bLDL") == 0 and count(r"\bSTL") == 0
+    small = count(r"LDG\.E\.CONSTANT")                    # input fragments: 4 + 4 a step (none are weights)
+    print(f"[G13] dense3 SASS K2 10 / 4 warps / 3 blocks: {ldg128} LDG.E.128 (weights), {small} LDG.E 4-byte "
+          f"(input fragments), 8 SHFL.IDX, 32 HMMA a 2-step group, no LDL / STL")
