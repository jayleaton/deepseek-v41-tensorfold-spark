new file mode 100644
index 0000000..8b9417e
--- /dev/null
+++ b/tests/test_dsv41_decode_glue_interp.py
@@ -0,0 +1,185 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G7 decode glue kernels in Triton's CPU interpreter (no GPU), with the ``gpu_like`` dot / cast model:
+
+- mHC ``_site`` SPLIT (a program a stream, boundaries out of place: ``TF_DSV41_MHC_SPLIT_ROWS``) == the 4-stream
+  program, bit for bit: every output (streams, collapsed row, taps, partials, normed input, pre / post / comb) of
+  boundary / site / final / post_only, world 1 and 2, fp32 and bf16 gathered partials, 1 / 3 / 17 / 33 rows;
+- ``_finish_k`` unrolled (``TF_DSV41_MHC_UNROLL``) == the rolled loops, bit for bit;
+- in place (xout is x) still runs the 4-stream program and equals out of place;
+- the fused float64 RMSNorm (``rmsnorm``, ``blocks.rms`` on CUDA) == torch's float64 form, bit for bit (bf16 / fp32 /
+  no weight; widths 1,280 and 512; rows spanning 2^26 in magnitude), and row-invariant.
+
+Run: python -m pytest -q tests/test_dsv41_decode_glue_interp.py
+"""
+
+from __future__ import annotations
+
+import os
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401
+
+interpret()
+
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+
+from tensorfold.families.deepseek_v41.cuda import mhc, rmsnorm  # noqa: E402
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1" and type(mhc._site).__name__ == "InterpretedFunction"
+pytestmark = [pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)"),
+              pytest.mark.usefixtures("gpu_like")]
+
+D = 1280                                  # a multiple of NB x BK (the kernels' 5,120 tested in tests/cuda)
+
+
+def _bits(t):
+    return t.reshape(-1).contiguous().view(torch.uint8)
+
+
+def _case(R: int, world: int, seed: int):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn((R, 4 * D), generator=g).to(torch.bfloat16)
+    gathered = (torch.randn((world, R, D), generator=g) * 0.7).to(torch.bfloat16).float()   # kit-rounded partials
+    comb = torch.rand((R, 4, 4), generator=g)
+    comb = (comb / comb.sum(1, keepdim=True)).reshape(R, 16).contiguous()
+    prev = mhc.Coefs(R, "cpu", pre=torch.rand((R, 4), generator=g) + 0.1, post=torch.rand((R, 4), generator=g) * 2,
+                     comb=comb)
+    hc = mhc.Hc(torch.randn((24, 4 * D), generator=g) * 0.01, torch.randn(24, generator=g) * 0.5,
+                torch.rand(3, generator=g) + 0.5)
+    nw = (torch.rand(D, generator=g) + 0.5).to(torch.bfloat16)
+    return x, gathered, prev, hc, nw
+
+
+def _all(x, gathered, prev, hc, nw, *, in_place: bool = False):
+    """boundary (taps; out of place unless ``in_place``), site with the carried pre-mix, entry site, final,
+    post_only: every output, the kernel partials included."""
+
+    R = gathered.shape[1]
+    out = {}
+    xb = x.clone()
+    xo = xb if in_place else torch.zeros_like(x)
+    o = torch.zeros((R, D), dtype=torch.bfloat16)
+    co = mhc.Coefs(R, "cpu")
+    sc = mhc.Scratch(R, "cpu", D)
+    tp = torch.zeros((R, 2 * D), dtype=torch.bfloat16)[:, D:]          # a row-strided view, as DSpark's taps
+    mhc.boundary(xb, xo, gathered, prev, hc, nw, o, co, sc, tap=tp)
+    out.update(bx=xo, bo=o, bpre=co.pre, bpost=co.post, bcomb=co.comb, bc=sc.c[:R].clone(), btap=tp,
+               bpart=sc.part[:R].clone())
+    for tag, pre_in in (("s", prev.pre), ("e", None)):
+        o2 = torch.zeros((R, D), dtype=torch.bfloat16)
+        co2 = mhc.Coefs(R, "cpu")
+        sc2 = mhc.Scratch(R, "cpu", D)
+        mhc.site(x, hc, nw, o2, co2, sc2, pre_in=pre_in)
+        out.update({tag + "o": o2, tag + "pre": co2.pre, tag + "post": co2.post, tag + "comb": co2.comb,
+                    tag + "part": sc2.part[:R].clone()})
+    xf = torch.zeros_like(x)
+    o3 = torch.zeros((R, D), dtype=torch.bfloat16)
+    sc3 = mhc.Scratch(R, "cpu", D)
+    mhc.final(x, xf, gathered, prev, nw, o3, sc3)
+    out.update(fx=xf, fo=o3, fc=sc3.c[:R].clone())
+    xp = x.clone()
+    mhc.post_only(xp, xp, gathered, prev)
+    out.update(px=xp)
+    return out
+
+
+def _same(got, want):
+    for k in want:
+        assert torch.equal(_bits(got[k]), _bits(want[k])), k
+
+
+@pytest.mark.parametrize("R,world", [(1, 2), (3, 1), (17, 2), (33, 2)])
+def test_split_equals_four_stream_program(monkeypatch, R, world):
+    x, gathered, prev, hc, nw = _case(R, world, R + world)
+    monkeypatch.setenv("TF_DSV41_MHC_SPLIT_ROWS", "0")
+    want = _all(x, gathered, prev, hc, nw)
+    monkeypatch.setenv("TF_DSV41_MHC_SPLIT_ROWS", "64")
+    assert mhc.out_of_place(R)
+    got = _all(x, gathered, prev, hc, nw)
+    _same(got, want)
+    got = _all(x, gathered.to(torch.bfloat16), prev, hc, nw)      # G7 decode: bf16 partials straight in
+    _same(got, want)
+
+
+def test_split_rows_default_and_off(monkeypatch):
+    monkeypatch.delenv("TF_DSV41_MHC_SPLIT_ROWS", raising=False)
+    assert mhc.split_rows() == 32 and mhc.out_of_place(1) and mhc.out_of_place(32) and not mhc.out_of_place(33)
+    monkeypatch.setenv("TF_DSV41_MHC_SPLIT_ROWS", "0")
+    assert not mhc.out_of_place(1)
+
+
+def test_in_place_boundary_keeps_the_four_stream_program(monkeypatch):
+    x, gathered, prev, hc, nw = _case(3, 2, 7)
+    monkeypatch.setenv("TF_DSV41_MHC_SPLIT_ROWS", "64")
+    want = _all(x, gathered, prev, hc, nw)
+    got = _all(x, gathered, prev, hc, nw, in_place=True)
+    _same(got, want)
+    assert mhc._overlap(x, x) and mhc._overlap(x, x[1:]) and not mhc._overlap(x, x.clone())
+
+
+def test_finish_unrolled_equals_rolled(monkeypatch):
+    x, gathered, prev, hc, nw = _case(5, 2, 11)
+    monkeypatch.setenv("TF_DSV41_MHC_UNROLL", "0")
+    assert not mhc.unroll()
+    want = _all(x, gathered, prev, hc, nw)
+    monkeypatch.setenv("TF_DSV41_MHC_UNROLL", "1")
+    _same(_all(x, gathered, prev, hc, nw), want)
+
+
+def test_split_row_invariance(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_MHC_SPLIT_ROWS", "64")
+    x, gathered, prev, hc, nw = _case(6, 2, 13)
+    whole = _all(x, gathered, prev, hc, nw)
+    one = _all(x[4:5].clone(), gathered[:, 4:5].contiguous(), mhc.Coefs(
+        1, "cpu", pre=prev.pre[4:5].clone(), post=prev.post[4:5].clone(), comb=prev.comb[4:5].clone()), hc, nw)
+    for k, v in one.items():
+        assert torch.equal(_bits(v), _bits(whole[k][4:5])), k
+
+
+# -- the fused float64 RMSNorm ---------------------------------------------------------------------------------------
+def _rms_torch(x, w, eps, dtype):
+    x = x.to(torch.float64)
+    y = x * torch.rsqrt(x.square().mean(-1, keepdim=True) + eps)
+    return (y if w is None else y * w.to(torch.float64)).to(dtype)
+
+
+def _rows(n: int, K: int, seed: int) -> torch.Tensor:
+    g = torch.Generator().manual_seed(seed)
+    scale = torch.logspace(-6, 2, K)[torch.randperm(K, generator=g)]       # squares spanning ~2^53: rounding sums
+    return (torch.randn((n, K), generator=g) * scale).to(torch.bfloat16)
+
+
+@pytest.mark.parametrize("K", [1280, 512])
+@pytest.mark.parametrize("wdt", [torch.bfloat16, torch.float32, None])
+def test_rms_equals_torch_float64(K, wdt):
+    x = _rows(9, K, K)
+    g = torch.Generator().manual_seed(1)
+    w = None if wdt is None else (torch.rand(K, generator=g) + 0.5).to(wdt)
+    for dt in (torch.bfloat16, torch.float32):
+        got = rmsnorm.rms(x, w, 1e-6, dt)
+        assert got.dtype == dt and got.shape == x.shape
+        assert torch.equal(_bits(got), _bits(_rms_torch(x, w, 1e-6, dt)))
+
+
+def test_rms_row_invariance_and_shapes():
+    x = _rows(7, 1280, 3)
+    w = (torch.rand(1280, generator=torch.Generator().manual_seed(2)) + 0.5).to(torch.bfloat16)
+    whole = rmsnorm.rms(x, w, 1e-6, torch.bfloat16)
+    for r in range(7):
+        assert torch.equal(_bits(rmsnorm.rms(x[r:r + 1], w, 1e-6, torch.bfloat16)), _bits(whole[r:r + 1]))
+    three = rmsnorm.rms(x.view(7, 1, 1280), w, 1e-6, torch.bfloat16)          # any leading shape
+    assert three.shape == (7, 1, 1280) and torch.equal(_bits(three), _bits(whole))
+    strided = torch.zeros((7, 2560), dtype=torch.bfloat16)
+    strided[:, 1280:] = x
+    assert torch.equal(_bits(rmsnorm.rms(strided[:, 1280:], w, 1e-6, torch.bfloat16)), _bits(whole))
+    assert rmsnorm.rms(x[:0], w, 1e-6, torch.bfloat16).shape == (0, 1280)
+
+
+def test_rms_knob_and_eligibility(monkeypatch):
+    x = _rows(2, 512, 4)
+    assert not rmsnorm.eligible(x, None, torch.bfloat16)                     # CPU tensors: torch's form
+    monkeypatch.setenv("TF_DSV41_RMS_TRITON", "0")
+    assert not rmsnorm.enabled()
