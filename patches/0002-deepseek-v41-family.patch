index 0000000..f4f38a5
--- /dev/null
+++ b/tests/test_dsv41_pctree.py
@@ -0,0 +1,198 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Parent-conditioned trees (``pctree.py``, TF_DSV41_TREE_PC), the confidence head's temperature scaling
+(``confcal.py``) and the policy simulator (``treesim.py``):
+
+- the planner: without width it is ``depth.best_k``; best-first order is prefix-closed with the main chain's first
+  draft first and at most B chains; chains, duplicated rows and the expert-union cost; the confidence head's value
+  for any parent from the main chain's; learning only from reached later children;
+- ``confcal``: the fit recovers a known temperature, identity before evidence, fixed temperatures, the knob;
+- ``treesim.synth`` reproduces G8's prose chain (~1.65 tokens a round, ~38 tok/s) and trees never accept less;
+- drafted == serial through the batcher with oracle children (the serial token as a 2nd child at depth 1 and 2), at
+  T = 0 and T > 0, on the CPU twin (minutes).
+"""
+
+from __future__ import annotations
+
+import math
+
+import numpy as np
+import pytest
+
+from tensorfold.families.deepseek_v41.cuda import confcal as CC
+from tensorfold.families.deepseek_v41.cuda import pctree as PC
+from tensorfold.families.glm5_next.spark.depth import best_k
+
+VERIFY = [29.5, 36.3, 40.25, 44.2, 48.15, 52.1, 56.1, 60.1] + [60.1 + 3.76 * i for i in range(1, 9)]
+rows_ms = lambda r: VERIFY[r - 1]
+
+
+class TableExp:
+    """children from a fixed table {(row, parent): [(token, p), ..]} (keyed order)."""
+
+    def __init__(self, table, mc=None):
+        self.t, self.mc = table, mc
+
+    def children(self, cand, base, i, prev, position, sampling, m, exclude=()):
+        return [(t, p) for t, p in self.t.get((i, prev), []) if t not in exclude][:m]
+
+    def hparts(self, conf, pending, main):
+        return None
+
+
+def _table(rng, n=5, width=3, pending=0):
+    tab, nxt = {}, [1]
+
+    def kids(i, prev):
+        if (i, prev) not in tab:
+            p = sorted(rng.dirichlet(np.ones(width + 1)), reverse=True)[:width]
+            tab[(i, prev)] = [(nxt[0] + j, float(p[j])) for j in range(width)]
+            nxt[0] += width
+        return tab[(i, prev)]
+    main, t = [], pending
+    for i in range(n):
+        tok, _ = kids(i, t)[0]
+        main.append(tok)
+        t = tok
+    for i in range(n):                              # the whole tree to depth n, width 3
+        for (ii, prev), ks in list(tab.items()):
+            if ii == i:
+                for tok, _ in ks:
+                    if i + 1 < n:
+                        kids(i + 1, tok)
+    return tab, main
+
+
+def test_select_without_width_is_best_k():
+    rng = np.random.default_rng(0)
+    for _ in range(400):
+        tab, main = _table(rng)
+        conf = [float(rng.random()) for _ in main]
+        lam = float(rng.random() * 0.1)
+        q = lambda j, p: min(p, PC.Q_MAX)
+        for least in (0, 1):
+            order = PC.grow(TableExp(tab), np.zeros((5, 1)), np.zeros((5, 1)), 0, 100, None, main, conf, q,
+                            lambda d, r, p: p, depths=1, width=2, rows=15, chains=1)
+            plan = PC.select(order, rows_ms, lam, least=least, dup_ms=0.4)
+            k, _ = best_k([q(j, c) for j, c in enumerate(conf)], VERIFY, lam, least=least)
+            assert plan.k == k and plan.chains == []
+
+
+def test_grow_order_prefix_closed_main_first_chain_cap():
+    rng = np.random.default_rng(1)
+    for t in range(300):
+        tab, main = _table(rng)
+        conf = [float(rng.random()) for _ in main]
+        B = 2 + t % 3
+        order = PC.grow(TableExp(tab), np.zeros((5, 1)), np.zeros((5, 1)), 0, 100, None, main, conf,
+                        lambda j, p: min(p, PC.Q_MAX), lambda d, r, p: min(p, PC.Q_MAX), depths=1 + t % 3, width=3,
+                        rows=15, chains=B)
+        assert order[0].main and order[0].tok == main[0]
+        for ix, nd in enumerate(order):
+            assert nd.parent < ix
+            if nd.parent >= 0:
+                assert nd.depth == order[nd.parent].depth + 1 and nd.v <= order[nd.parent].v + 1e-12
+            if nd.main:
+                assert nd.tok == main[nd.depth - 1]
+            if nd.rank:
+                assert nd.depth <= 1 + t % 3        # branches only at depths 1 .. TF_DSV41_TREE_DEPTHS
+        assert len(PC.chains_of(order)) <= B - 1
+
+
+def test_chains_dups_and_cost():
+    # pending -> a1 (main) -> a2 (main); b1 (2nd child of the pending); c2 (2nd child of a1)
+    nodes = [PC.Node(11, 1, -1, 0, 0.6, 0.6, True), PC.Node(12, 2, 0, 0, 0.5, 0.3, True),
+             PC.Node(21, 1, -1, 1, 0.3, 0.25, False), PC.Node(22, 2, 0, 1, 0.3, 0.2, False)]
+    ch = PC.chains_of(nodes)
+    assert [t for t, _ in ch] == [[21], [11, 22]]
+    plan = PC.select(nodes, rows_ms, 0.0, dup_ms=0.5, slot_ms=0.25)       # rate 0: everything pays
+    # unique rows: pending + 4 nodes; duplicated: chain [21] re-runs the pending (1), [11, 22] pending + a1 (2)
+    assert plan.k == 2 and len(plan.chains) == 2
+    assert abs(plan.ms - (VERIFY[4] + 0.5 * 3 + 0.25 * 2)) < 1e-9
+    assert abs(plan.expected - (1 + 0.6 + 0.3 + 0.25 + 0.2)) < 1e-9
+    half = PC.select(nodes, rows_ms, 0.0, dup_ms=0.5, slot_ms=0.25, sib_expert=0.5)
+    assert abs(half.ms - (VERIFY[2] + 0.5 * (VERIFY[4] - VERIFY[2]) + 1.5 + 0.5)) < 1e-9
+    assert PC.select(nodes, rows_ms, 0.0, max_rows=6).k == 2 and len(PC.select(nodes, rows_ms, 0.0,
+                                                                                 max_rows=6).chains) == 1
+
+
+def test_confidence_of_any_parent():
+    import torch
+
+    g = torch.Generator().manual_seed(0)
+    V, r, D = 50, 16, 32
+    w1 = torch.randn(V, r, generator=g).to(torch.bfloat16)
+    cw = torch.randn(D + r, generator=g) * 0.3
+    h = torch.randn(5, D, generator=g)
+    exp = PC.Expander(w1, w1, cw)
+    pending, main = 3, [7, 9, 11, 13, 15]
+    prev = [pending] + main
+    sig = lambda x: 1 / (1 + math.exp(-x))
+    conf = [sig(float(h[i] @ cw[:D] + w1[prev[i]].float() @ cw[D:])) for i in range(5)]
+    hp = exp.hparts(conf, pending, main)
+    for i in range(5):
+        for t in (0, 4, 20, 49):
+            want = sig(float(h[i] @ cw[:D] + w1[t].float() @ cw[D:]))
+            assert abs(exp.conf(hp[i], t) - want) < 1e-5
+
+
+def test_learn_only_reached_later_children():
+    nodes = [PC.Node(11, 1, -1, 0, 0.6, 0.6, True), PC.Node(21, 1, -1, 1, 0.3, 0.2, False),
+             PC.Node(31, 2, 1, 0, 0.5, 0.1, False), PC.Node(12, 2, 0, 0, 0.5, 0.3, True),
+             PC.Node(22, 2, 0, 1, 0.2, 0.1, False)]
+    cal = PC.Cal(3, 2)
+    PC.learn(cal, nodes, [11, 22, 5])               # main's 1st kept, then a1's 2nd child: kept
+    assert cal.kept[0][1] == 0.0 and cal.prob[0][1] == pytest.approx(0.3)      # b1 reached, rejected
+    assert cal.kept[1][1] == 1.0 and cal.prob[1][1] == pytest.approx(0.2)      # c2 reached, kept
+    cal2 = PC.Cal(3, 2)
+    PC.learn(cal2, nodes, [21, 31])                 # b1 kept; c2's parent a1 never reached
+    assert cal2.kept[0][1] == 1.0 and cal2.prob[1][1] == 0.0
+    assert PC.accepted_len([0, 11, 12, 13], [11, 12, 9, 1]) == 2
+
+
+def test_settings_validate(monkeypatch):
+    assert PC.settings({}) == {"pc": False, "depths": 3, "width": 2, "sib_expert": 1.0}
+    assert PC.settings({"TF_DSV41_TREE_PC": "1", "TF_DSV41_TREE_DEPTHS": "2"})["pc"]
+    with pytest.raises(ValueError):
+        PC.settings({"TF_DSV41_TREE_DEPTHS": "5"})
+    with pytest.raises(ValueError):
+        CC.env_mode({"TF_DSV41_CONF_CAL": "isotonic"})
+
+
+# -- confcal ---------------------------------------------------------------------------------------------------------
+def test_temperature_fit_recovers_and_tempcal_learns():
+    rng = np.random.default_rng(2)
+    T = 1.8                                          # an over-confident head: true logit = raw / 1.8
+    xs = rng.normal(0, 2.5, size=4000)
+    ys = (rng.random(4000) < 1 / (1 + np.exp(-xs / T))).astype(float)
+    a, b = CC.fit(xs.tolist(), ys.tolist(), bias=False, ridge=1.0, steps=25)
+    assert abs(1 / a - T) < 0.15 and b == 0.0
+    a2, b2 = CC.fit(xs.tolist(), (rng.random(4000) < 1 / (1 + np.exp(-(xs / T + 0.5)))).astype(float).tolist(),
+                    bias=True, ridge=1.0, steps=25)
+    assert abs(1 / a2 - T) < 0.25 and abs(b2 - 0.5) < 0.15
+    tc = CC.TempCal(3, "temp")
+    assert tc.q(0, 0.7) == pytest.approx(0.7)       # identity before evidence
+    for x, y in zip(xs[:1500], ys[:1500]):
+        p = 1 / (1 + math.exp(-x))
+        tc.record([p], 2 if y else 1)
+    assert abs(1 / tc.factor(0) - T) < 0.4
+    assert tc.q(1, 0.7) == pytest.approx(0.7)       # position 2 never verified
+    fixed = CC.make(5, {"TF_DSV41_CONF_TEMP": "2.0,1.5"})
+    assert fixed.q(0, 1 / (1 + math.exp(-2.0))) == pytest.approx(1 / (1 + math.exp(-1.0)))
+    assert fixed.factor(4) == pytest.approx(1 / 1.5)
+    from tensorfold.families.deepseek_v41.cuda.depth import Calibration
+
+    assert isinstance(CC.make(5, {}), Calibration)
+
+
+# -- treesim ---------------------------------------------------------------------------------------------------------
+def test_synth_reproduces_prose_and_trees_accept_more():
+    from tensorfold.families.deepseek_v41.cuda import treesim as TS
+
+    res = {r["policy"]: r for r in TS.synth(1500, s2=0.35, seed=3)}
+    ch = res["chain"]
+    assert 1.5 < ch["tokens_per_round"] < 1.8 and 36 < ch["tok_s"] < 41
+    for name, r in res.items():
+        assert r["tokens_per_round"] >= ch["tokens_per_round"] - 1e-9, name
+    cheap = {r["policy"]: r for r in TS.synth(1500, s2=0.35, seed=3, sib_expert=0.5)}
+    assert cheap["pctree d2 w2 B3"]["tok_s"] > cheap["chain"]["tok_s"]
