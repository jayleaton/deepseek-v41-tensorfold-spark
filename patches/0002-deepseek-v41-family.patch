--- /dev/null
+++ b/tests/test_dsv41_joint2.py
@@ -0,0 +1,261 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G15b: the joint DSpark depth's mode 2 (TF_DSV41_DEPTH_JOINT=2, ``joint.py``) and its simulation (``jointsim.py``):
+
+- optimality: ``joint.allocate`` with fairness weights and zero floors == brute force over every allocation, on the
+  measured (non-convex) window curve and on bumpy tables; ``weights`` keeps the rate's scale;
+- the policy: a shared slot may verify no draft (its pending row is its floor: every slot gets >= 1 row a round),
+  the counterfactual bonus calibrates it, mode 1 never goes below 1 draft, host time enters the rate, the knobs parse;
+- determinism: two policies fed the same inputs choose the same depths round after round (both ranks); the
+  simulation is seeded (no clock);
+- simulated multi-stream runs on G14's window curve and G13's acceptance: mode 2's steady aggregate over the
+  independent policy for C2 / C4 mixed and same-workload, and the slow stream of a mixed C2 kept near its speed;
+- exactness: drafted == serial with mode 2 at 2 and 4 slots (T = 0 and T > 0) with zero-depth shared slots, and
+  mode 2 == mode 0 replies.
+"""
+
+from __future__ import annotations
+
+import itertools
+import random
+
+import pytest
+
+from tensorfold.families.deepseek_v41.cuda import depth
+from tensorfold.families.deepseek_v41.cuda import joint as J
+from tensorfold.families.deepseek_v41.cuda import jointsim as S
+
+
+def _brute(qs, lo, top, shared, rows_ms, rate, max_rows, weight):
+    best, arg = float("-inf"), None
+    for ks in itertools.product(*[range(lo[s], max(lo[s], top[s]) + 1) for s in range(len(qs))]):
+        rows = shared + sum(1 + k for k in ks)
+        if rows > max_rows and any(k > lo[s] for s, k in enumerate(ks)):
+            continue
+        v = J.objective(qs, ks, lo, shared=shared, rows_ms=rows_ms, rate=rate, weight=weight)
+        if v > best:
+            best, arg = v, ks
+    return best, arg
+
+
+@pytest.mark.parametrize("table", ["g14", "v3", "bumpy"])
+def test_weighted_zero_floor_allocate_equals_brute_force(table):
+    rng = random.Random(11)
+    if table == "g14":
+        c = S.costs(S.ROWS_G14)
+    elif table == "v3":
+        c = S.costs(S.ROWS_V3)
+    else:
+        c = depth.Costs([20.0 + 3.0 * r + (4.0 if r % 4 == 2 else 0.0) for r in range(64)], 3.5)
+    for case in range(300):
+        n = rng.randint(2, 4)
+        qs = [[rng.choice([rng.random(), 0.85 + 0.14 * rng.random(), 0.05 * rng.random()]) for _ in range(5)]
+              for _ in range(n)]
+        top = [rng.randint(0, 5) for _ in range(n)]
+        lo = [rng.choice([0, 0, 1]) if t > 0 else 0 for t in top]
+        tpr = [rng.choice([None, 1.0 + 5.0 * rng.random()]) for _ in range(n)]
+        w = J.weights(tpr, rng.choice([0.0, 0.5, 1.0, 2.0]))
+        shared = rng.choice([0, 0, 1, 4])
+        rate = rng.choice([0.03, 0.06, 0.1, 0.15])
+        cap = rng.choice([64, 16, 10])
+        ks, val = J.allocate(qs, lo, top, shared=shared, rows_ms=c.rows_ms, rate=rate, max_rows=cap, weight=w)
+        assert all(lo[s] <= ks[s] <= max(lo[s], top[s]) for s in range(n)), (case, ks)
+        assert sum(1 + k for k in ks) >= n                          # every slot keeps its pending row
+        assert J.objective(qs, ks, lo, shared=shared, rows_ms=c.rows_ms, rate=rate, weight=w) == \
+            pytest.approx(val, abs=1e-9)
+        best, _ = _brute(qs, lo, top, shared, c.rows_ms, rate, cap, w)
+        assert val == pytest.approx(best, abs=1e-9), case
+
+
+def test_weights():
+    assert J.weights([3.8, 1.6], 0.0) == [1.0, 1.0]
+    assert J.weights([2.0, 2.0, 2.0], 0.5) == pytest.approx([1.0, 1.0, 1.0])
+    assert J.weights([None, None], 1.0) == pytest.approx([1.0, 1.0])
+    t = [3.8, 1.6, 5.7, 5.9]
+    for a in (0.5, 1.0, 2.0):
+        w = J.weights(t, a)
+        assert sum(x * y for x, y in zip(w, t)) == pytest.approx(sum(t))     # the rate's scale is kept
+        assert w[1] > w[0] > w[2] > w[3] > 0                                  # slower streams weigh more
+    assert J.weights(t, 1.0)[1] / J.weights(t, 1.0)[0] == pytest.approx(3.8 / 1.6)
+
+
+def test_env(monkeypatch):
+    for k in ("TF_DSV41_DEPTH_JOINT", "TF_DSV41_DEPTH_FAIR", "TF_DSV41_DEPTH_HOST_MS"):
+        monkeypatch.delenv(k, raising=False)
+    assert J.env_mode() == 1 and J.env_fair() == J.FAIR and J.env_host_ms() == J.HOST_MS
+    for v, m in (("0", 0), ("off", 0), ("1", 1), ("on", 1), ("2", 2)):
+        monkeypatch.setenv("TF_DSV41_DEPTH_JOINT", v)
+        assert J.env_mode() == m and J.env_on() is (m > 0)
+        d = depth.Depth()
+        assert d.joint_mode == m and d.joint is (m > 0)
+    monkeypatch.setenv("TF_DSV41_DEPTH_JOINT", "3")
+    with pytest.raises(ValueError):
+        J.env_mode()
+    monkeypatch.setenv("TF_DSV41_DEPTH_FAIR", "0")
+    monkeypatch.setenv("TF_DSV41_DEPTH_HOST_MS", "2.5")
+    assert J.env_fair() == 0.0 and J.env_host_ms() == 2.5
+    monkeypatch.setenv("TF_DSV41_DEPTH_FAIR", "-1")
+    with pytest.raises(ValueError):
+        J.env_fair()
+    with pytest.raises(ValueError):
+        depth.Depth(joint=5)
+
+
+def _pair(mode: int) -> depth.Depth:
+    d = depth.Depth(S.costs(), block=5, mode="cost", cap=5, skip=True, joint=mode, fair=0.5, host_ms=3.0)
+    for s in (0, 1):
+        d.slots[s] = depth._Slot()
+    d.slots[0].rounds.extend([(4, 50.0)] * 8)                   # a code stream: ~4 tokens a round
+    d.slots[1].rounds.extend([(2, 50.0), (1, 50.0)] * 4)        # a prose stream: ~1.5
+    d._agg[2] = depth.deque([(5, 50.0)] * 8, maxlen=16)        # 0.1 tokens a ms
+    return d
+
+
+def test_mode2_zero_depth_in_a_shared_window_and_its_counterfactual():
+    code, low = [0.97, 0.95, 0.93, 0.9, 0.9], [0.12, 0.3, 0.3, 0.3, 0.3]
+    one, two = _pair(1), _pair(2)
+    assert one.choose_joint([0, 1], [code, low], [5, 5], firsts=[5, 9])[1] == 1     # mode 1: the first draft always
+    ks = two.choose_joint([0, 1], [code, low], [5, 5], firsts=[5, 9])
+    assert ks[1] == 0 and ks[0] >= 3                            # 0.12 < 0.1 x ~4 ms: the pending row only
+    assert two.slots[1].first == (9, 0.12) and two.slots[1].drafted
+    assert two.stats.joint[3] == 1
+    kept0 = two.cal.kept[0]
+    two.record(0, ks[0] + 1, 3)
+    two.record(1, 1, 1)
+    two.bonus(1, 9)                                             # the window's choice == the draft: it would be kept
+    assert two.stats.zero == 1 and two.cal.kept[0] > kept0 * depth.DECAY
+    assert two.choose_joint([0, 1], [code, low], [5, 5], firsts=[None, None])[1] >= 1   # no first: no zero depth
+    nz = depth.Depth(S.costs(), block=5, mode="cost", cap=5, skip=False, joint=2)
+    assert min(nz.choose_joint([0, 1], [code, low], [5, 5], firsts=[5, 9])) >= 1      # TF_DSV41_DRAFT_SKIP=0
+    assert two.choose_joint([0, 1], [code, low], [5, 0], firsts=[5, 9])[1] == 0        # most 0: nothing to verify
+
+
+def test_mode2_host_time_and_fairness_shift_rows_to_the_slow_stream():
+    code, mid = [0.97, 0.95, 0.93, 0.9, 0.9], [0.7, 0.5, 0.45, 0.4, 0.4]
+    a = _pair(2)
+    a.fair = 0.0
+    b = _pair(2)
+    b.fair = 2.0
+    ka = a.choose_joint([0, 1], [code, mid], [5, 5], firsts=[5, 9])
+    kb = b.choose_joint([0, 1], [code, mid], [5, 5], firsts=[5, 9])
+    assert kb[1] >= ka[1] and (kb[1] > ka[1] or kb[0] < ka[0])
+    assert _pair(2).round_ms(4, 2, True) == pytest.approx(_pair(1).round_ms(4, 2, True) + 3.0)
+
+
+def _drive(d: depth.Depth, seed: int, rounds: int = 80) -> list[list[int]]:
+    rng = random.Random(seed)
+    out = []
+    for r in range(rounds):
+        n = 1 + r % 4
+        slots = list(range(n))
+        confs = [S.draw(rng, ("code", "prose", "struct")[(s + r) % 3]) for s in slots]
+        others = [1 + rng.randint(0, 6)] if r % 5 == 0 else []
+        ks = d.choose_joint(slots, confs, [5] * n, others=others, firsts=[11] * n)
+        out.append(ks)
+        for s, k in zip(slots, ks):
+            keep = 1 + sum(1 for _ in itertools.takewhile(lambda c: rng.random() < c, confs[s][:k]))
+            d.record(s, k + 1, keep)
+            d.bonus(s, 11 if rng.random() < 0.5 else 12)
+    return out
+
+
+def test_mode2_is_deterministic_like_two_ranks():
+    def mk():
+        return depth.Depth(S.costs(), block=5, mode="cost", cap=5, skip=True, joint=2, fair=0.5, host_ms=3.0)
+
+    a, b = mk(), mk()
+    ra, rb = _drive(a, 5), _drive(b, 5)
+    assert ra == rb and a.cal.kept == b.cal.kept and a.stats.report() == b.stats.report()
+    assert {n: list(v) for n, v in a._agg.items()} == {n: list(v) for n, v in b._agg.items()}
+    assert a.stats.joint[0] > 0 and a.stats.joint[3] > 0      # shared rounds with zero-depth slots happened
+    assert _drive(mk(), 5) == ra
+    assert S.run(("code", "prose"), joint=2, seed=3) == S.run(("code", "prose"), joint=2, seed=3)
+
+
+# -- the simulation: expected gains on G14's curve and G13's acceptance ------------------------------------------------
+@pytest.fixture(scope="module")
+def sim():
+    return S.compare(reps=40)
+
+
+def test_sim_workloads_match_the_measured_drafting():
+    """One stream alone, independent depth: the acceptance model commits what G13 measured a round."""
+
+    want = {"code": (3.80, 0.15), "prose": (1.62, 0.1), "struct": (5.8, 0.25)}
+    for kind, (tpr, tol) in want.items():
+        rs = [S.run((kind,), joint=0, seed=i) for i in range(10)]
+        got = sum(r["tpr"][0] for r in rs) / len(rs)
+        assert got == pytest.approx(tpr, abs=tol), kind
+
+
+@pytest.mark.parametrize("mix,least", [("C2 code", 0.5), ("C2 prose", 0.8), ("C4 code", 0.5), ("C4 prose", 2.5),
+                                       ("C2 mixed", 0.0), ("C4 mixed", 0.5)])
+def test_sim_mode2_steady_aggregate_beats_independent(sim, mix, least):
+    r = sim[mix]
+    gain = 100.0 * (r["joint2"]["steady"] / r["independent"]["steady"] - 1.0)
+    assert gain > least, (mix, gain)
+    assert r["joint2"]["steady"] >= r["joint1"]["steady"] - 0.5 or mix == "C2 mixed"
+
+
+def test_sim_fairness_keeps_the_slow_stream(sim):
+    """C2 mixed: alpha 0 buys aggregate by slowing prose; the default alpha keeps prose near its independent speed."""
+
+    r = sim["C2 mixed"]
+    prose = {p: v["per"][1] for p, v in r.items()}
+    assert prose["joint2 fair0"] < prose["independent"] * 0.97
+    assert prose["joint2"] >= prose["independent"] * 0.98
+    assert r["joint2 fair0"]["steady"] > r["joint2"]["steady"]
+    assert r["joint2"]["agg"] >= r["independent"]["agg"] * 0.995      # the old mixed cell does not regress
+
+
+# -- the real forward (CPU twin, synthetic checkpoint): drafted == serial ---------------------------------------------
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    pytest.importorskip("torch")
+    import dsv41_dspark_fakes as DF
+
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41joint2"))
+
+
+def _prompts(n):
+    import numpy as np
+
+    return [[int(t) for t in np.random.default_rng(70 + i).integers(3, 250, size=36 + 9 * i)] for i in range(n)]
+
+
+def _samplings(n):
+    from tensorfold.engine.exact_sampling import Sampling
+
+    return [None if i % 2 == 0 else Sampling(seed=9 + i, temperature=0.8, top_k=20, top_p=0.95) for i in range(n)]
+
+
+@pytest.mark.torch
+@pytest.mark.parametrize("slots", [2, 4])
+def test_mode2_drafted_equals_serial(ck, slots, monkeypatch):
+    """2 and 4 slots decoding together under mode 2 give the serial replies at T = 0 and T > 0, with zero-depth
+    shared slots among the rounds (dear rows), and the same replies as mode 0."""
+
+    import dsv41_dspark_fakes as DF
+
+    from tensorfold.families.deepseek_v41.cuda.batch import Job
+
+    ps, ss = _prompts(slots), _samplings(slots)
+    want = DF.run(DF.batcher(ck, DF.forward(ck, slots=slots, dspark=False), n=slots, depth=0),
+                  [Job(list(p), 20, s) for p, s in zip(ps, ss)])
+    got = {}
+    for mode in ("2", "0"):
+        monkeypatch.setenv("TF_DSV41_DEPTH_JOINT", mode)
+        fw = DF.forward(ck, slots=slots)
+        assert fw.depth.joint_mode == int(mode)
+        b = DF.batcher(ck, fw, n=slots)
+        costs = depth.Costs([30.0, 40.0] + [40.0 + 6.0 * r for r in range(1, 62)], 4.0, slot=1.0)
+        fw.set_costs(costs)
+        b.planner.costs = costs
+        jobs = [Job(list(p), 20, s) for p, s in zip(ps, ss)]
+        got[mode] = DF.run(b, jobs)
+        assert got[mode] == want
+        if mode == "2":
+            jr = fw.depth.stats.joint
+            assert jr[0] > 0 and jr[3] > 0, jr                  # shared rounds, some slots at zero depth
+            assert "joint 2" in fw.describe()
+    assert got["2"] == got["0"]
