@@ -0,0 +1,251 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Dense EXL3 linears v3: x3seg's programs over a load-geometry repack of the trellis (``TF_DSV41_DENSE_V3``,
+default 0; ``dense3.cu``). REWRITE-PLAN candidate #8 / f2.
+
+Why. G9 has the attention's dense EXL3 matrices at 157-201 GB/s in the engine against GB10's ~232 (~1.3 ms of a
+1-row window). antirez/ds4 found its GB10 dense gains in load geometry, not fusion (``cuda/mmq/ds4_mmq.cu``
+``q8_0_aligned_dense_vec``: the codes in an aligned SoA copy, 16-byte loads straight to registers, 16 warps a block
+on cc 12.1: +9-27% a GEMV). Our k step has the same disease: 24 4-byte loads a lane, each trellis word fetched by
+~2.4 lanes (a lane's 16-bit windows reach into the 3 words around its own bits), and the step's input fragment is
+loaded in the step that uses it. x3dn v1 / v2 tried other load paths but lost on their reductions (16-20 partials a
+strip, a smem ring); this keeps x3seg's reduction as it is.
+
+What. At Block build (``fused_proj.build`` -> ``mark``), the attention's EXL3 matrices are repacked IN PLACE (no
+extra memory; the worker's MemAvailable floor is ~3 GiB) into the "lanes" layout: a bit permutation inside each
+128-column strip that puts lane L's own 4 K2 bits of every tile of a 2-step group in 16-byte chunks at
+``(c * 32 + L) * 16`` bytes, so a warp's chunk is one coalesced 512-byte load and every byte is read once; the 16
+bits before a lane's own bits come from lane L - 1 by a shuffle. ``to_strips`` is the exact inverse. The kernel is
+x3seg's (``fused_proj.layout``'s tables, upstream's (SK, WK) plans, k ranges, mma chains, warp-order sums, Z
+partials, split-order last-arriver sums, epilogue) with the next group's chunks and the next step's input requested
+one ahead. The decoded values are the same integers, so **every output element has x3seg's bits** at any plan
+(TF_DSV41_PROJ_PLAN), row count and group: the gate, row invariance, batched == alone and drafted == serial are
+x3seg's.
+
+Every path that reads these matrices follows the layout: the fused groups (``fused_proj.Fused`` picks this
+extension), single calls (``Lanes.__call__``: ``linear.Exl3``'s ``wo_b``, the compressor's own pass, the drafter),
+and fast prefill (``prefill_mm`` -> ``prefill_matmul``: W_q decoded from the lanes layout, upstream's GEMM). x3dn
+(``TF_DSV41_DENSE``) cannot be on at the same time.
+
+Knobs (speed only, never a bit): ``TF_DSV41_DENSE_V3_MINB`` "B4,B8" = blocks an SM the 4-warp / 8-warp kernels'
+registers allow (default "3,1": 168 / 195-220 registers, no spills on sm_121; "4,2" caps at 128 registers, 8-196 B
+of spills, more warps in flight: G13's sweep).
+
+Expected (G9's in-engine rates, 1-row window, attention dense 9.32 ms): x 157 -> ~190 GB/s, o 184 -> ~210, wq_b 191
+-> ~215, q + ix 181 -> ~210, wo_b 201 -> ~220: ~-0.9 ms (range -0.6 to -1.2); G13 ``dense3`` measures it cold.
+"""
+
+from __future__ import annotations
+
+import os
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+from tensorfold.cuda.exl3.linear import Exl3Linear
+
+ENV = "TF_DSV41_DENSE_V3"
+K2S = (4, 6, 8, 10, 12)         # widths dense3.cu is built for (2-6 bits; the attention is 5 / 6, the drafter 4)
+ROWS = 128
+
+
+def _env(env):
+    return os.environ if env is None else env
+
+
+def enabled(env=None) -> bool:
+    v = (_env(env).get(ENV, "0").strip() or "0")
+    if v not in ("0", "1"):
+        raise ValueError(f"{ENV}={v!r}: expected 0 or 1")
+    return v == "1"
+
+
+def minb(wk: int, env=None) -> int:
+    """``TF_DSV41_DENSE_V3_MINB`` "B4,B8": blocks an SM for the 4-warp (3 or 4) and 8-warp (1 or 2) kernels."""
+
+    raw = (_env(env).get(ENV + "_MINB", "3,1").strip() or "3,1")
+    try:
+        b4, b8 = (int(v) for v in raw.split(","))
+    except ValueError:
+        raise ValueError(f"{ENV}_MINB={raw!r}: expected e.g. 3,1") from None
+    if b4 not in (3, 4) or b8 not in (1, 2):
+        raise ValueError(f"{ENV}_MINB={raw!r}: 4-warp blocks 3 or 4, 8-warp 1 or 2")
+    return b4 if wk == 4 else b8
+
+
+def group_steps(k2: int) -> int:
+    """k steps a load group (dense3.cu ``group_steps``): G K2 words a lane = whole 16-byte chunks (1 at K2 16:
+    the layout's rule; no kernel is built for 8 bits)."""
+
+    return 1 if k2 == 16 else 2
+
+
+def is_lanes(lin) -> bool:
+    return getattr(lin, "layout", "") == "lanes"
+
+
+def why_not(lin) -> str | None:
+    """None when this ``Exl3Linear`` can run here (strips or lanes layout), else why not."""
+
+    if lin is None or not hasattr(lin, "words"):
+        return "not an EXL3 linear on CUDA"
+    if getattr(lin, "layout", "strips") not in ("strips", "lanes") or lin.bias is not None:
+        return "layout / bias"
+    if lin.codebook != "mul1" or lin.k2 not in K2S:
+        return "codebook / width"
+    if lin.k % 128 or lin.n % 128:
+        return "shape"
+    sk, wk = lin.split
+    if wk not in (4, 8) or (lin.k // 16) % (sk * wk):
+        return "plan"
+    if (lin.k // 16 // (sk * wk)) % group_steps(lin.k2):
+        return f"plan: {lin.k // 16 // (sk * wk)} k steps a warp, not whole {group_steps(lin.k2)}-step groups"
+    return None
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    import tensorfold.cuda.exl3 as upstream
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    # x3seg's flags (its statements are compiled here again: the same contraction / codegen choices)
+    return load(name="tf_dsv41_dense3_v1", sources=[str(here / "dense3.cpp"), str(here / "dense3.cu")],
+                extra_include_paths=[str(here), str(Path(upstream.__file__).parent)],
+                extra_cuda_cflags=["-O3", "--expt-relaxed-constexpr"], verbose=False)
+
+
+# -- the layout (the CUDA kernels; tests/dsv41_dense3_emu.py holds the numpy reference) -------------------------
+def _relayout(lin, lanes: bool) -> None:
+    tmp = torch.empty_like(lin.words)
+    _ext().relayout(lin.words, tmp, lin.k2, lin.k, lanes)
+    lin.words.copy_(tmp)
+    del tmp
+
+
+class Lanes(Exl3Linear):
+    """An upstream ``Exl3Linear`` whose words are in the lanes layout (made by ``to_lanes``, never constructed)."""
+
+    @property
+    def strides(self) -> tuple[int, int]:
+        tw = 4 * self.k2
+        return 8 * tw, (self.k // 16) * 8 * tw
+
+    def single(self):
+        """The cached 1-segment group (made eagerly by ``to_lanes``; its counters must outlive any graph pool)."""
+
+        f = self.__dict__.get("_d3")
+        if f is None or f.lins[0] is not self:
+            if torch.cuda.is_current_stream_capturing():
+                raise RuntimeError("dense3: a lanes matrix first called inside a graph capture")
+            from . import fused_proj as FP
+
+            f = self._d3 = FP.Fused([self], part="single")
+        return f
+
+    def __call__(self, x, out=None, out_dtype=None, xh=None, z=None, skip=None):
+        if skip is not None:
+            raise ValueError("dense3: skip is not supported")
+        if x.dim() != 2 or x.shape[1] != self.k:
+            raise ValueError(f"x must be [M, {self.k}], got {tuple(x.shape)}")
+        if out is None:
+            out = torch.empty((x.shape[0], self.n), dtype=out_dtype or x.dtype, device=x.device)
+        f = self.single()
+        if not (x.stride(-1) == 1 and (x.stride(0) * x.element_size()) % 16 == 0 and x.data_ptr() % 16 == 0):
+            x = x.contiguous()
+        for a in range(0, x.shape[0], ROWS):
+            b = min(x.shape[0], a + ROWS)
+            f._block([x[a:b]], [out[a:b]])
+        return out
+
+    def unpack(self, out=None):
+        w = out if out is not None else torch.empty((self.k, self.n), dtype=torch.float16, device=self.words.device)
+        _ext().unpack(self.words, w, *self.strides, self.k2)
+        return w
+
+
+def to_lanes(lin) -> None:
+    """Repack ``lin`` (strips) in place into the lanes layout; ``lin`` becomes a ``Lanes``."""
+
+    why = why_not(lin)
+    if why is not None or is_lanes(lin):
+        raise ValueError(f"dense3.to_lanes: {why or 'already lanes'}")
+    _relayout(lin, True)
+    lin.layout = "lanes"
+    lin.__class__ = Lanes
+    lin.single()
+
+
+def to_strips(lin) -> None:
+    """The inverse of ``to_lanes`` (benches and tests: the matrix is upstream's again, bit for bit)."""
+
+    if not is_lanes(lin):
+        raise ValueError("dense3.to_strips: not a lanes matrix")
+    _relayout(lin, False)
+    lin.layout = "strips"
+    lin.__dict__.pop("_d3", None)
+    lin.__class__ = Exl3Linear
+
+
+def attn_lins(attn) -> list:
+    """The attention's EXL3 matrices (``dense.mark``'s set: every path that computes one follows its layout)."""
+
+    from .fused_proj import lin_of
+
+    objs = (attn.wq_a, attn.wkv, attn.comp_wkv, attn.comp_wgate, attn.wq_b, attn.ix_wq_b, attn.wo_b, *attn.wo_a)
+    return [lin for lin in (lin_of(x) for x in objs if x is not None) if lin is not None]
+
+
+_WARNED: set = set()
+
+
+def mark(attn, env=None) -> int:
+    """Under ``TF_DSV41_DENSE_V3=1``: repack the attention's matrices (all or none, so a fused group never mixes
+    layouts). Returns the matrices repacked."""
+
+    if not enabled(env):
+        return 0
+    from . import dense as D
+
+    if D.scope(env) != "0":
+        raise ValueError(f"{ENV}=1 and {D.ENV}={D.scope(env)}: x3dn and dense3 cannot both run")
+    lins = attn_lins(attn)
+    bad = [why_not(lin) for lin in lins if why_not(lin) is not None]
+    if bad:
+        if bad[0] not in _WARNED:
+            _WARNED.add(bad[0])
+            print(f"[tensorfold] dense3: an attention stays on x3seg: {bad[0]}", flush=True)
+        return 0
+    todo = [lin for lin in lins if not is_lanes(lin)]
+    for lin in todo:
+        to_lanes(lin)
+    return len(todo)
+
+
+def prefill_matmul(layer, x: torch.Tensor, out: torch.Tensor, ws) -> torch.Tensor:
+    """upstream ``exl3.prefill.matmul`` for a lanes matrix: W_q decoded from the lanes layout (the same values as
+    upstream's ``unpack``), then upstream's GEMM. Mirrors tensorfold/cuda/exl3/prefill.py's statements."""
+
+    import triton
+
+    from tensorfold.cuda.exl3 import prefill as P
+
+    m, k, n = x.shape[0], layer.k, layer.n
+    if x.shape[1] != k or out.shape != (m, n) or out.stride(1) != 1:
+        raise ValueError(f"prefill matmul: x {tuple(x.shape)} and out {tuple(out.shape)} do not match K={k}, N={n}")
+    xh = ws._grow("xh", m * k, x.device)[:m * k].view(m, k)
+    P._ext().rot_in(x.contiguous(), layer.suh, xh)
+    wq = ws._grow("w", k * n, x.device)[:k * n].view(k, n)
+    layer.unpack(wq)
+    bm, bk, warps, stages, group = P.tiles(k, n)
+    bias = layer.bias if layer.bias is not None else layer.svh
+    P._gemm[(triton.cdiv(m, bm) * (n // P.BN),)](xh, wq, ws.hadamard(x.device), layer.svh, bias, out, m,
+                                                 out.stride(0), K=k, N=n, BM=bm, BK=bk, GROUP=group,
+                                                 HAS_BIAS=layer.bias is not None, SCALE=P.HAD_SCALE,
+                                                 num_warps=warps, num_stages=stages)
+    return out
+
+
+__all__ = ["ENV", "K2S", "Lanes", "attn_lins", "enabled", "group_steps", "is_lanes", "mark", "minb",
+           "prefill_matmul", "to_lanes", "to_strips", "why_not"]
