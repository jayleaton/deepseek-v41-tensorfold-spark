+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The decode MoE chain, shortened (REWRITE-PLAN candidate b1, ``TF_DSV41_MOE_FUSED=1``; default off).
+
+Today (prod knobs: gemv narrow router, p85k pruning, kit rounding), a layer's MoE at R <= 16 rows is ten dependent
+launches: router -> prune -> fp16 cast -> cast back -> group -> rot_in -> x3ld gate/up -> gateup_epilogue -> x3ld
+down -> down_combine. G9's traces put the DRAM-idle part of that chain at ~54-58 us a layer at 1 row (the router's
+non-streaming ~15 us, five small kernels ~11, the epilogue and combine ~10, both x3ld ramps / tails ~16).
+
+Here (``moe_fused.cu``):
+
+main stream   fused_kernel ---------> x3ld gate/up (routed) -> gateup_epilogue (routed) -> x3ld down (routed) -> combine2
+                  logits | select + prune + kit + group | rot_in of the routed pairs          ^ join
+side stream   rot_in -> x3ld gate/up -> gateup_epilogue (shared) ...[after the routed gate/up]... x3ld down (shared)
+
+- ``fused_kernel``: the narrow router's logits (the same FMA chains, so the same bits as ``router_gemv``), then its
+  last CTA selects (``select_row``), prunes (``prune._prune``'s operations on lane 0), rounds the weights to fp16
+  (``pick.kit_weights``), groups the routed ids (upstream's ``group_kernel`` integers) and raises a flag; the CTAs
+  that arrived among the last ``help`` wait on that flag and, with the selecting CTA, run upstream's rot_in for every
+  routed pair (tasks claimed through a counter). Four launches and their gaps go (prune, two casts, group, rot_in).
+- The shared expert does not depend on routing, so it runs on a side stream forked before the router (graph-capture
+  safe: the fork / join are stream waits inside the capture, as L2PF's): upstream's rot_in, x3ld gate/up and
+  gateup_epilogue on compact buffers (row r at r), and its x3ld down after the routed gate/up (``_SDN=late``: it fills
+  the DRAM-idle routed epilogue; ``early``: right after its epilogue). Its bytes (~10 MB a layer a rank) stream under
+  the router's latency-bound time instead of inside the routed launches.
+- ``combine2``: upstream's ``down_combine`` with the shared slot's split partials read from the shared branch's Z.
+
+Exactness (the same bits as the production path, every row count 1..16, both geometries):
+- logits: the narrow kernel's statements; selection: ``select_row``'s; pruning: ``_prune``'s fp32 operations in its
+  order (sequential sums from 0, div.rn, rank by (f desc, slot asc), the exclusive mass, keep, the kept mass, the
+  1.5 x renormalization); kit: fp32 -> fp16 RN -> fp32 (torch's cast). Group: router_gemv's ``group_rows`` with the
+  routed table (ids < E): the routed x3ld launch sees the same experts and member rows, minus the shared entry.
+- rot_in: upstream's per-element arithmetic with nvcc's contraction for ``rot_in_kernel`` written out (the compile
+  test pins that SASS shape). The contraction cannot matter anyway: x bf16 times suh fp16 is exact in fp32 (<= 19
+  significant bits), so fused or not the first stage rounds once (normal-range products; the emulator test). A
+  pair's rotated input does not depend on which warp computes it.
+- x3ld: a member row's Z depends on its expert, its row of X and the K split only (never on the table position or the
+  other members), so the routed launch + the shared launch give today's Z for every pair; the epilogue is upstream's
+  kernel on each part; ``combine2`` is ``down_combine``'s arithmetic in slot order, and writes ``y`` for every
+  computed pair as it does (a pruned slot still reads the same stale finite ``y`` and adds 0).
+- Row invariance: every step is per row (the selection, the tail's pruning, rot_in) or per member row (x3ld); the
+  grouping only places rows. Batched == alone and drafted == serial hold as before.
+
+Knobs (read at import): ``TF_DSV41_MOE_FUSED`` 0 | 1 | rowsN (G14: only windows of >= N rows; smaller ones run the
+old sequence, the same bits either way); ``TF_DSV41_MOE_FUSED_HELP`` auto | n (waiting CTAs, capped at
+SMs - 1: speed only); ``TF_DSV41_MOE_FUSED_SDN`` late | early (speed only); G14's two below (speed only).
+
+G14 (G14a hardware traces, 1 row, a layer): the side branch does run beside the fused kernel but buys nothing: L2PF's
+site f already has the shared expert's gate / up in L2, so the routed-only gate/up takes the same 102.4 us as the old
+launch with the shared expert in it; and the fused kernel (36.4 us, with the side branch's x3ld beside it) is slower
+than the router + prune + casts + group + rot_in it replaces (29.6 us). Net +2.3 to +3.6 us a layer at 1 row, -2.6 to
+-4.1 at 2-4 rows. Variants, each bit for bit the production path:
+
+- ``TF_DSV41_MOE_FUSED=rowsN``: the fused chain only for windows of >= N rows (rows2: where b1 already wins).
+- ``TF_DSV41_MOE_FUSED_SHARED`` side (b1, default) | inline | after:
+  ``inline``: no side stream. The fused kernel groups the whole table (ids < E + 1) and rotates every slot's input,
+  the shared one included (rk = slots, ge = E + 1: what upstream's group_kernel + rot_in_kernel give the production
+  path); then the production path's own launches: x3ld gate/up (shared entry in it), gateup_epilogue, x3ld down,
+  down_combine. Six launches a layer instead of ten, no fork / join.
+  ``after``: no side stream; b1's routed chain, then the shared expert's rot_in / gate/up / epilogue / down on the main
+  stream, then combine2 (the side-branch launches serialized: tells the fork / join cost from the overlap).
+- ``TF_DSV41_MOE_FUSED_TAIL`` serial (b1, default) | fast: the selection's cross-lane argmax by redux.sync instead of
+  the shuffle butterfly; rot_in tasks by arrival rank (no claim atomics); the first task's x loaded before the wait.
+
+Every variant is taken only where the production path's bits are defined the same way: CUDA, 1..16 rows,
+``TF_DSV41_ROUTER=gemv`` without ``_ROUTER_CHECK``, no verify budget, one shared expert, D 5,120 and E <= 512 (inline:
+E + 1 <= 512); anything else runs ``moe.GpuMoE``'s old sequence.
+
+Cost model (GB10, 1 row, a layer): removed launches ~11-12 us; the tail grows by the pruning (lane 0, < 0.5 us) and
+rot_in (one DRAM round trip for the routed experts' suh, ~2-4 us); the shared expert's ~4 MB that fit in the
+router's idle DRAM time (~18 us of its ~32) and its down under the routed epilogue: -10 to -20 us. Expected DRAM-idle
+chain ~54-58 -> ~28-35 us a layer, i.e. ~0.8-1.1 ms a 1-row window over 40 layers (~0.4-0.9 ms after this
+project's in-engine discount); launches do not grow with rows, so every window gains about as much.
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass, field
+from functools import cache, lru_cache
+
+import torch
+
+ENV, ENV_HELP, ENV_SDN = "TF_DSV41_MOE_FUSED", "TF_DSV41_MOE_FUSED_HELP", "TF_DSV41_MOE_FUSED_SDN"
+ENV_SHARED, ENV_TAIL = "TF_DSV41_MOE_FUSED_SHARED", "TF_DSV41_MOE_FUSED_TAIL"
+OFF = ("", "0", "false", "no", "off")
+SDN = ("late", "early")
+SHARED = ("side", "inline", "after")
+TAIL = ("serial", "fast")
+ROWS = 16               # one row tile of the narrow kernel
+NB = 40                 # rot_in tasks a row (128-blocks of D = 5,120)
+NWS = (1, 2, 4, 8)
+NW_DEFAULT = 2          # the prod narrow setting (TF_DSV41_RG_NARROW=2)
+
+
+def parse(env: dict | None = None) -> dict:
+    """The knobs, validated (a bad value refuses to start)."""
+
+    env = os.environ if env is None else env
+    raw = env.get(ENV_HELP, "").strip().lower()
+    if raw in ("", "auto"):
+        hp = None
+    else:
+        try:
+            hp = int(raw)
+        except ValueError:
+            hp = -1
+        if hp < 0:
+            raise ValueError(f"{ENV_HELP}={raw!r}: auto or an int >= 0")
+    sdn = env.get(ENV_SDN, "").strip().lower() or "late"
+    if sdn not in SDN:
+        raise ValueError(f"{ENV_SDN}={sdn!r}: one of {SDN}")
+    shared = env.get(ENV_SHARED, "").strip().lower() or "side"
+    if shared not in SHARED:
+        raise ValueError(f"{ENV_SHARED}={shared!r}: one of {SHARED}")
+    tail = env.get(ENV_TAIL, "").strip().lower() or "serial"
+    if tail not in TAIL:
+        raise ValueError(f"{ENV_TAIL}={tail!r}: one of {TAIL}")
+    raw_on = env.get(ENV, "0").strip().lower()
+    min_rows = 1
+    if raw_on.startswith("rows"):                   # G14: rowsN, the fused chain for windows of >= N rows only
+        try:
+            min_rows = int(raw_on[4:])
+        except ValueError:
+            min_rows = 0
+        if not 1 <= min_rows <= ROWS:
+            raise ValueError(f"{ENV}={raw_on!r}: 0, 1 or rowsN with 1 <= N <= {ROWS}")
+    return {"on": raw_on not in OFF, "help": hp, "sdn": sdn, "shared": shared, "tail": tail, "min_rows": min_rows}
+
+
+CFG = parse()
+
+
+def narrow_nw() -> int:
+    from . import router_gemv as RG
+
+    return RG.NARROW if RG.NARROW in NWS else NW_DEFAULT
+
+
+def help_count(R: int, E: int, nw: int, sms: int, want: int | None = None) -> int:
+    """CTAs that wait for the selection and share rot_in: one rot_in task a warp (``R`` x 40 tasks, the selecting
+    CTA counts), at most SMs - 1 (deadlock freedom: moe_fused.cu) and fewer than the producer CTAs. (A task is a
+    (row, 128-block) whatever the pairs a row: ``inline`` adds the shared pair to each task, not tasks.)"""
+
+    nprod = -(-E // nw)
+    cap = max(0, min(sms - 1, nprod - 1))
+    if want is not None:
+        return min(int(want), cap)
+    return min(cap, max(0, -(-R * NB // nw) - 1))
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    from pathlib import Path
+
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tf_dsv41_moe_fused_v2", sources=[str(here / "moe_fused.cpp"), str(here / "moe_fused.cu")],
+                extra_include_paths=[str(here)], extra_cuda_cflags=["-O3", "-lineinfo"], verbose=False)
+
+
+@cache
+def _sms(device: int) -> int:
+    return int(torch.cuda.get_device_properties(device).multi_processor_count)
+
+
+@dataclass
+class Side:
+    """The shared expert's branch for one geometry on one device: its stream, compact buffers for ``ROWS`` rows
+    (row r at r) and its constant one-expert grouping; the fused kernel's counters (0 between launches)."""
+
+    stream: object
+    xg: torch.Tensor
+    xu: torch.Tensor
+    xd: torch.Tensor
+    z: torch.Tensor
+    ids: torch.Tensor           # [1] = E (the shared entry)
+    count: torch.Tensor         # [1] = 1
+    members: torch.Tensor       # [ROWS]: r * 32 (slot 0 of a 1-slot table)
+    pick: torch.Tensor          # [ROWS] = E
+    cnt: torch.Tensor           # [4] int32
+    event: object = field(default=None, repr=False)
+
+
+_SIDES: dict = {}
+
+
+def side_for(block, scratch, device) -> Side:
+    """Allocated once a (geometry, device), before any capture (``moe.GpuMoE.ensure``); never moved."""
+
+    key = (block.geom, str(device))
+    sd = _SIDES.get(key)
+    if sd is None:
+        ex = block.ex
+        D, I, E = ex.dims, ex.width, block.geom.experts
+        (_, _, sk_gu, _), (_, _, sk_d, _) = scratch.cfg_gu, scratch.cfg_d
+        dev = torch.device(device)
+        i32 = {"dtype": torch.int32, "device": dev}
+        sd = _SIDES[key] = Side(
+            torch.cuda.Stream(device=dev), torch.zeros((ROWS, D), dtype=torch.float16, device=dev),
+            torch.zeros((ROWS, D), dtype=torch.float16, device=dev),
+            torch.zeros((ROWS, I), dtype=torch.float16, device=dev),
+            torch.zeros((max(2 * sk_gu * I, sk_d * D) * ROWS,), dtype=torch.float32, device=dev),
+            torch.full((1,), E, **i32), torch.ones((1,), **i32), torch.arange(ROWS, **i32) * 32,
+            torch.full((ROWS,), E, **i32), torch.zeros((4,), **i32), torch.cuda.Event())
+    return sd
+
+
+def side_bytes_total() -> int:
+    return sum(sum(t.numel() * t.element_size() for t in (s.xg, s.xu, s.xd, s.z)) for s in _SIDES.values())
+
+
+def eligible(moe, x: torch.Tensor, plan) -> bool:
+    """Whether this call can take the fused chain with the production path's bits (else the old sequence)."""
+
+    from . import router
+    from . import router_gemv as RG
+
+    if not CFG["on"] or plan is not None or not x.is_cuda or not CFG.get("min_rows", 1) <= x.shape[0] <= ROWS:
+        return False
+    if router.MODE != "gemv" or router._CHECK or not RG.supports(x, moe.gate, moe.topk):
+        return False
+    blk, s = moe.block, moe.scratch
+    E = moe.gate.shape[0]
+    ge = E + 1 if CFG["shared"] == "inline" else E          # inline groups the shared entry too
+    return (s is not None and blk.geom.shared == 1 and blk.ex.count == E + 1 and ge <= RG.GE_MAX
+            and s.slots == moe.topk + 1 and x.shape[0] <= s.rows and moe.gate.is_contiguous())
+
+
+def _grouped(x0, x1, ptr0, ptr1, k20, k21, ids, count, members, z, mats, K, N, P, slots, cfg, ex, lo_hi, R,
+             pdl=None):
+    """experts.routed's launch choice for one grouped projection: x3pf, then x3ld, else upstream's kernel."""
+
+    from tensorfold.cuda.exl3 import experts as x3
+
+    from . import expert_loads as loads
+    from . import expert_prefill as prefill
+
+    nt, w, sk, pf = cfg
+    lo, hi = lo_hi
+    if prefill.grouped(x0, x1, ptr0, ptr1, k20, k21, ids, count, members, z, mats, K, N, P, sk, slots, ex.cb, w, lo,
+                       hi, rows=R):
+        return
+    if loads.grouped(x0, x1, ptr0, ptr1, k20, k21, ids, count, members, z, mats, K, N, P, sk, slots, ex.cb, w, lo,
+                     hi, pdl=pdl):
+        return
+    x3._ext().grouped(x0, x1, ptr0, ptr1, k20, k21, ids, count, members, z, mats, K, N, P, sk, slots, ex.cb, nt, w,
+                      pf, lo, hi)
+
+
+def _shared_gateup(x, ex, s, sd: Side, R: int, limit: float) -> None:
+    from tensorfold.cuda.exl3 import experts as x3
+
+    ext3 = x3._ext()
+    D, I, ET = ex.dims, ex.width, ex.count
+    pk, mem = sd.pick[:R], sd.members[:R].view(1, R)
+    ext3.rot_in(x, x.stride(0), pk, ex.suh_g, ex.suh_u, sd.xg, sd.xu, R, D, 1, ET)
+    _grouped(sd.xg, sd.xu, ex.gate_ptr, ex.up_ptr, ex.gate_k2, ex.up_k2, sd.ids, sd.count, mem, sd.z, 2, D, I, R, 1,
+             s.cfg_gu, ex, ex.k2_gu, R)
+    ext3.gateup_epilogue(sd.z, pk, ex.svh_g, ex.svh_u, ex.suh_d, sd.xd, R, R, I, s.cfg_gu[2], 1, ET, float(limit),
+                         x3.ACT_F32)
+
+
+def _shared_down(ex, s, sd: Side, R: int, pdl=None) -> None:
+    D, I = ex.dims, ex.width
+    _grouped(sd.xd, sd.xd, ex.down_ptr, ex.down_ptr, ex.down_k2, ex.down_k2, sd.ids, sd.count,
+             sd.members[:R].view(1, R), sd.z, 1, I, D, R, 1, s.cfg_d, ex, ex.k2_d, R, pdl=pdl)
+
+
+def route(moe, x: torch.Tensor, rule, *, help: int | None = None, nw: int | None = None, inline: bool | None = None,
+          fast: bool | None = None):
+    """The fused kernel alone: (pick, wts, pickr, ids, members) with the scratch's xg / xu written for the routed
+    pairs (``inline``: every pair, the shared one too, and the whole table grouped, in ``scratch.window``'s buffers;
+    default from ``TF_DSV41_MOE_FUSED_SHARED``); ``fast``: the G14 tail (default from ``TF_DSV41_MOE_FUSED_TAIL``).
+    Tests and ``forward``."""
+
+    from . import numerics as N
+    from . import prune as PR
+    from . import router_gemv as RG
+
+    s, ex = moe.scratch, moe.block.ex
+    R, E, K = x.shape[0], moe.gate.shape[0], moe.topk
+    slots = K + 1
+    dev = x.device
+    sd = side_for(moe.block, s, dev)
+    if x.stride(1) != 1 or x.stride(0) % 8 or x.data_ptr() % 16:
+        x = x.contiguous() if not x.is_contiguous() else x.clone()
+    bias = moe.bias if moe.bias.dtype == torch.float32 and moe.bias.is_contiguous() else moe.bias.float().contiguous()
+    pick = torch.empty((R, slots), dtype=torch.int32, device=dev)
+    wts = torch.empty((R, slots), dtype=torch.float32, device=dev)
+    pickr = torch.empty((R, slots), dtype=torch.int32, device=dev)
+    lg = torch.empty((R, E), dtype=torch.float32, device=dev)
+    inline = CFG["shared"] == "inline" if inline is None else bool(inline)
+    fast = CFG["tail"] == "fast" if fast is None else bool(fast)
+    if inline:                                      # the production path's grouping buffers, the shared entry in
+        rk, ge = slots, ex.count
+        ids, members = s.window(R)
+    else:
+        rk, ge = K, E
+        mu = min(R * K, E)
+        ids, members = s.ids[:mu], s.members_buf[:mu * R].view(mu, R)
+    nw = narrow_nw() if nw is None else nw
+    hp = help_count(R, E, nw, _sms(dev.index or 0), CFG["help"] if help is None else help)
+    on = rule is not None
+    topp = (rule.topp if 0.0 < rule.topp < 1.0 else PR.TOPP_OFF) if on else PR.TOPP_OFF
+    _ext().route(x, moe.gate, bias, pick, wts, pickr, lg, sd.cnt, K, slots, float(moe.scale), bool(N.KIT_ROUNDING),
+                 on, on and rule.renorm == "kept", rule.min_k if on else K, ex.count, rule.min_w if on else 0.0,
+                 float(topp), ids, s.count, members, ex.suh_g, ex.suh_u, s.xg, s.xu, RG.row_tile(R), nw, hp, rk, ge,
+                 fast)
+    return pick, wts, pickr, ids, members
+
+
+def forward(moe, x: torch.Tensor, rule) -> tuple[torch.Tensor, torch.Tensor]:
+    """The fused chain for one window of <= 16 rows: (this rank's fp32 partial [R, D], pick)."""
+
+    from tensorfold.cuda.exl3 import experts as x3
+
+    s, ex = moe.scratch, moe.block.ex
+    R, K = x.shape[0], moe.topk
+    slots, P = K + 1, R * (K + 1)
+    D, I, ET = ex.dims, ex.width, ex.count
+    if CFG["shared"] == "inline":
+        return _forward_inline(moe, x, rule)
+    if CFG["shared"] == "after":
+        return _forward_after(moe, x, rule)
+    sd = side_for(moe.block, s, x.device)
+    main = torch.cuda.current_stream()
+    sd.stream.wait_stream(main)                     # fork: the shared expert needs no routing
+    with torch.cuda.stream(sd.stream):
+        _shared_gateup(x, ex, s, sd, R, moe.limit)
+        if CFG["sdn"] == "early":
+            _shared_down(ex, s, sd, R)
+    pick, wts, pickr, ids, members = route(moe, x, rule)
+    _grouped(s.xg, s.xu, ex.gate_ptr, ex.up_ptr, ex.gate_k2, ex.up_k2, ids, s.count, members, s.z, 2, D, I, P,
+             slots, s.cfg_gu, ex, ex.k2_gu, R, pdl=False)  # PDL off: its prologue reads the group the kernel wrote
+    if CFG["sdn"] == "late":                        # the shared down fills the routed epilogue's idle DRAM
+        sd.event.record(main)
+        sd.stream.wait_event(sd.event)
+        with torch.cuda.stream(sd.stream):
+            _shared_down(ex, s, sd, R, pdl=False)
+    ext3 = x3._ext()
+    ext3.gateup_epilogue(s.z, pickr, ex.svh_g, ex.svh_u, ex.suh_d, s.xd, R, P, I, s.cfg_gu[2], slots, ET,
+                         float(moe.limit), x3.ACT_F32)
+    _grouped(s.xd, s.xd, ex.down_ptr, ex.down_ptr, ex.down_k2, ex.down_k2, ids, s.count, members, s.z, 1, I, D, P,
+             slots, s.cfg_d, ex, ex.k2_d, R)
+    main.wait_stream(sd.stream)                     # join (every call: a capture never holds an open fork)
+    out = torch.empty((R, D), dtype=torch.float32, device=x.device)
+    _ext().combine2(s.z, sd.z, pick, ex.svh_d, s.y, wts, out, R, P, R, D, s.cfg_d[2], slots, ET, K)
+    return out, pick
+
+
+def _forward_inline(moe, x: torch.Tensor, rule) -> tuple[torch.Tensor, torch.Tensor]:
+    """SHARED=inline: the fused kernel (whole-table grouping, every pair's rot_in), then ``experts.routed``'s own
+    launches after its rot_in, argument for argument: one stream, no fork."""
+
+    from tensorfold.cuda.exl3 import experts as x3
+
+    s, ex = moe.scratch, moe.block.ex
+    R, K = x.shape[0], moe.topk
+    slots, P = K + 1, R * (K + 1)
+    D, I, ET = ex.dims, ex.width, ex.count
+    pick, wts, _, ids, members = route(moe, x, rule, inline=True)
+    _grouped(s.xg, s.xu, ex.gate_ptr, ex.up_ptr, ex.gate_k2, ex.up_k2, ids, s.count, members, s.z, 2, D, I, P,
+             slots, s.cfg_gu, ex, ex.k2_gu, R, pdl=False)  # PDL off: its prologue reads the group the kernel wrote
+    ext3 = x3._ext()
+    ext3.gateup_epilogue(s.z, pick, ex.svh_g, ex.svh_u, ex.suh_d, s.xd, R, P, I, s.cfg_gu[2], slots, ET,
+                         float(moe.limit), x3.ACT_F32)
+    _grouped(s.xd, s.xd, ex.down_ptr, ex.down_ptr, ex.down_k2, ex.down_k2, ids, s.count, members, s.z, 1, I, D, P,
+             slots, s.cfg_d, ex, ex.k2_d, R)
+    out = torch.empty((R, D), dtype=torch.float32, device=x.device)
+    ext3.down_combine(s.z, pick, ex.svh_d, s.y, wts, out, R, P, D, s.cfg_d[2], slots, ET)
+    return out, pick
+
+
+def _forward_after(moe, x: torch.Tensor, rule) -> tuple[torch.Tensor, torch.Tensor]:
+    """SHARED=after: b1's routed chain, then the shared expert's four launches on the same stream, then combine2."""
+
+    from tensorfold.cuda.exl3 import experts as x3
+
+    s, ex = moe.scratch, moe.block.ex
+    R, K = x.shape[0], moe.topk
+    slots, P = K + 1, R * (K + 1)
+    D, I, ET = ex.dims, ex.width, ex.count
+    sd = side_for(moe.block, s, x.device)
+    pick, wts, pickr, ids, members = route(moe, x, rule, inline=False)
+    _grouped(s.xg, s.xu, ex.gate_ptr, ex.up_ptr, ex.gate_k2, ex.up_k2, ids, s.count, members, s.z, 2, D, I, P,
+             slots, s.cfg_gu, ex, ex.k2_gu, R, pdl=False)
+    ext3 = x3._ext()
+    ext3.gateup_epilogue(s.z, pickr, ex.svh_g, ex.svh_u, ex.suh_d, s.xd, R, P, I, s.cfg_gu[2], slots, ET,
+                         float(moe.limit), x3.ACT_F32)
+    _grouped(s.xd, s.xd, ex.down_ptr, ex.down_ptr, ex.down_k2, ex.down_k2, ids, s.count, members, s.z, 1, I, D, P,
+             slots, s.cfg_d, ex, ex.k2_d, R)
+    _shared_gateup(x, ex, s, sd, R, moe.limit)
+    _shared_down(ex, s, sd, R)
+    out = torch.empty((R, D), dtype=torch.float32, device=x.device)
+    _ext().combine2(s.z, sd.z, pick, ex.svh_d, s.y, wts, out, R, P, R, D, s.cfg_d[2], slots, ET, K)
+    return out, pick
+
+
+def describe() -> str:
+    if not CFG["on"]:
+        return "moe fused: off"
+    hp = "auto" if CFG["help"] is None else str(CFG["help"])
+    sdn = f", shared down {CFG['sdn']}" if CFG["shared"] == "side" else ""
+    return (f"moe fused: on (narrow NW {narrow_nw()}, help {hp}, shared {CFG['shared']}{sdn}, tail {CFG['tail']}, "
+            f"rows {CFG.get('min_rows', 1)}..{ROWS})")
+
+
+__all__ = [
+    "CFG",
+    "ROWS",
+    "Side",
+    "describe",
+    "eligible",
+    "forward",
+    "help_count",
+    "parse",
+    "route",
+    "side_bytes_total",
+    "side_for",
+]
