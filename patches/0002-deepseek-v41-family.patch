index 0000000..1e61d74
--- /dev/null
+++ b/tests/test_dsv41_pctree_e2e.py
@@ -0,0 +1,139 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Parent-conditioned trees (TF_DSV41_TREE_PC=1) and the drafting log (TF_DSV41_DRAFT_LOG) through the real forward
+and batcher, on the CPU twin and the synthetic DSpark checkpoint (``dsv41_dspark_fakes``):
+
+- drafted == serial with oracle children: the serial token offered as a later child at depth 1 (when the pass's
+  first draft is wrong) and at depth 2 (under a sibling whose own first child is wrong), so chains branching at the
+  pending row and at a sibling win and commit with 1-4 drafts, at T = 0 and T > 0;
+- the log of that run (``draftlog``) read back by ``draftsim.load``: every pass's serial continuation is the reply's,
+  its candidates are kept, and the analyses and ``treesim.replay_all`` run on it;
+- with the log on and no tree, replies and drafts are those of an unlogged run.
+
+Run: python -m pytest -q tests/test_dsv41_pctree_e2e.py (the CPU twin: minutes).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+pytestmark = pytest.mark.torch
+
+import dsv41_dspark_fakes as DF  # noqa: E402
+
+from tensorfold.engine.exact_sampling import Sampling  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.batch import Job  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.depth import Costs  # noqa: E402
+
+N_TOK = 12
+CAP = 640
+PROMPTS = [[int(t) for t in np.random.default_rng(70 + i).integers(3, 250, size=n)] for i, n in enumerate((260, 420))]
+SAMPLINGS = [None, Sampling(seed=5, temperature=0.9, top_k=16, top_p=0.95)]
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41pctree"))
+
+
+@pytest.fixture(scope="module")
+def serial(ck):
+    b = DF.batcher(ck, DF.forward(ck, limit=CAP, dspark=False), capacity=CAP, pool_tokens=3 * CAP, depth=0)
+    return DF.run(b, [Job(p, N_TOK, s) for p, s in zip(PROMPTS, SAMPLINGS)])
+
+
+class Oracle:
+    """Children that know the serial reply (``seqs``: prompt + reply, positions disjoint between jobs)."""
+
+    def __init__(self, seqs, prompts=PROMPTS):
+        self.seqs, self.lens = seqs, [len(p) for p in prompts]
+        self.depth2 = 0
+
+    def _seq(self, position):
+        return next((s for s, n in zip(self.seqs, self.lens) if n <= position < len(s)), None)
+
+    def children(self, cand, base, i, prev, position, sampling, m, exclude=()):
+        s = self._seq(position)
+        ex = {int(t) for t in exclude}
+        t = int(s[position]) if s is not None and int(s[position - 1]) == int(prev) else None
+        fill = [x for x in ((int(prev) * 7 + i * 13 + j * 31) % 240 + 3 for j in range(8)) if x != t and x not in ex]
+        if t is None or t in ex:
+            return [(x, 0.3) for x in fill][:m]
+        if i == 1 and not ex:                             # a sibling's first child wrong: the serial one 2nd
+            self.depth2 += 1
+            return [(fill[0], 0.5), (t, 0.45)] + [(x, 0.01) for x in fill[1:]][:max(0, m - 2)]
+        return ([(t, 0.9)] + [(x, 0.02) for x in fill])[:m]
+
+    def hparts(self, conf, pending, main):
+        return None
+
+
+def _run(ck, monkeypatch, *, tree: bool, log=None, oracle=True, serial=None):
+    monkeypatch.setenv("TF_DSV41_TREE", "3" if tree else "0")
+    monkeypatch.setenv("TF_DSV41_TREE_PC", "1" if tree else "0")
+    monkeypatch.setenv("TF_DSV41_TREE_DEPTHS", "2")
+    monkeypatch.setenv("TF_DSV41_DRAFT_SKIP", "0")
+    if log:
+        monkeypatch.setenv("TF_DSV41_DRAFT_LOG", str(log))
+    else:
+        monkeypatch.delenv("TF_DSV41_DRAFT_LOG", raising=False)
+    fw = DF.forward(ck, limit=CAP)
+    b = DF.batcher(ck, fw, capacity=CAP, pool_tokens=4 * CAP)
+    c = Costs([10.0] * 16, 1.0)                     # every node pays: trees every round
+    fw.set_costs(c)
+    b.planner.costs = c
+    orc = None
+    if tree and oracle:
+        orc = Oracle([p + r for p, r in zip(PROMPTS, serial)])
+        fw.tree._exp = orc
+    got = DF.run(b, [Job(p, N_TOK, s) for p, s in zip(PROMPTS, SAMPLINGS)])
+    if fw.dlog is not None:
+        fw.dlog.flush()
+    return fw, got, orc
+
+
+def test_pctree_drafted_equals_serial_and_logged(ck, serial, monkeypatch, tmp_path):
+    fw, got, orc = _run(ck, monkeypatch, tree=True, log=tmp_path / "log", serial=serial)
+    assert got == serial
+    st = fw.tree.stats
+    assert st["trees"] > 0 and st["sib_wins"] > 0 and st["sib_tokens"] > st["sib_wins"]
+    assert orc.depth2 > 0 and fw.tree.pcal.kept[1][1] > 0      # a depth-2 later child was verified and kept
+    from tensorfold.families.deepseek_v41.cuda import draftsim as DS
+    from tensorfold.families.deepseek_v41.cuda import treesim as TS
+
+    passes = DS.load(str(tmp_path / "log"))
+    assert passes and all(p.cand is not None and p.base is not None for p in passes)
+    seqs = [p + r for p, r in zip(PROMPTS, serial)]
+    for p in passes:
+        s = next(q for q in seqs if len(q) > p.start + len(p.serial) and q[p.start] == p.pending)
+        assert p.serial == s[p.start + 1:p.start + 1 + len(p.serial)] and len(p.serial) >= 1
+    w1, w2, cw = fw.drafter.w1.cpu(), fw.drafter.w2.cpu(), fw.drafter.cw.cpu()
+    pos = DS.positions(passes)
+    assert pos["passes"] == len(passes) and pos["reached"][0] >= pos["kept"][0]
+    assert DS.ranks(passes, w1, w2)["rows"][0] > 0
+    assert DS.near_ties(passes)["rejections"] >= 0
+    assert set(DS.markov_sweep(passes, w1, w2, (0.0, 1.0))) == {"0.0", "1.0"}
+    assert all(r["policy"] for r in TS.replay_all(passes, w1, w2, cw))
+
+
+def test_log_changes_nothing(ck, serial, monkeypatch, tmp_path):
+    fa, plain, _ = _run(ck, monkeypatch, tree=False)
+    monkeypatch.setenv("TF_DSV41_DRAFT_LOG_TAPS", "1")
+    fb, logged, _ = _run(ck, monkeypatch, tree=False, log=tmp_path / "log2")
+    assert plain == logged == serial
+    import glob
+    import pickle
+
+    ev = [e for f in sorted(glob.glob(str(tmp_path / "log2" / "*.pkl"))) for e in pickle.load(open(f, "rb"))["events"]]
+    taps = [e for k, e in ev if k == "t"]
+    D3 = len(fb.cfg.aux_layer_ids) * fb.cfg.hidden_size
+    assert taps and all(e["taps"].shape[1] == D3 for e in taps)
+    assert fa.depth.stats.report() == fb.depth.stats.report()     # the same drafts verified and kept
+    from tensorfold.families.deepseek_v41.cuda import draftsim as DS
+
+    passes = DS.load(str(tmp_path / "log2"))
+    assert len(passes) == fb.depth.stats.rounds and all(p.cand is not None for p in passes)
+    assert all(len(p.drafts) == fb.drafter.rows and 0 <= p.k <= len(p.drafts) for p in passes)
diff --git a/tests/test_dsv41_pdl.py b/tests/test_dsv41_pdl.py
