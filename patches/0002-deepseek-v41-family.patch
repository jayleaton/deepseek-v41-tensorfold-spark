--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/draftsim.py
@@ -0,0 +1,406 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Offline DSpark acceptance analysis of a drafting log (``draftlog``, TF_DSV41_DRAFT_LOG): no GPU, no model.
+
+A pass at position P is scored against the serial tokens the run committed at P + 1 .. P + N (T = 0: the greedy
+reply; T > 0: the keyed samples, which the keyed draft noise targets). Its base logits [N, C] do not depend on the
+drafted tokens (noise rows), so any rule over (base, Markov head) is re-scored exactly at every logged pass:
+
+- ``positions``: per draft position, drafts reached (their prefix serial) and kept, all N rows (not only the
+  depth's k): the conditional acceptance a deeper or wider policy would see;
+- ``ranks``: the serial token's rank in the draft distribution (keyed order) given the serial prefix (teacher
+  forced: the parent a tree node would have) and given the drafted prefix: recall@m tells what width buys;
+- ``near_ties``: at each first rejected draft whose row was verified, the target's top-2 (logged top-K) there: is the
+  draft the target's 2nd choice, and the target's logit margin (a near tie at T = 0 cannot be bought: the greedy
+  choice is exact; at T > 0 the keyed noise already shares the target's uniforms);
+- ``markov_sweep``: chain acceptance with the Markov bias scaled (z = base + alpha w2 . w1[prev]);
+- ``ngram_sweep``: chain acceptance with z += beta log p_ngram(c | the last two tokens), from the other sessions'
+  serial tokens (leave one out) or a corpus of token ids;
+- ``fit_temps``: per-position temperatures of the confidence head (TF_DSV41_CONF_TEMP), sequentially (position j on
+  the passes whose drafts 1 .. j - 1 were serial).
+
+``treesim.replay`` prices chains and parent-conditioned trees (``pctree``) on the same passes with a cost table.
+
+CLI: python -m tensorfold.families.deepseek_v41.cuda.draftsim LOGDIR --heads MODEL_DIR_OR_SHARD [--out x.json]
+"""
+
+from __future__ import annotations
+
+import argparse
+import glob
+import json
+import os
+import pickle
+from collections import defaultdict
+from dataclasses import dataclass, field
+
+import numpy as np
+
+
+@dataclass
+class Pass:
+    slot: int
+    start: int
+    pending: int
+    drafts: list
+    conf: list
+    k: int
+    noise: list
+    cand: np.ndarray | None = None
+    base: np.ndarray | None = None
+    hid: np.ndarray | None = None
+    serial: list = field(default_factory=list)      # committed tokens at start + 1 ..
+    target: tuple | None = None                     # (ids, values) [rows, K] of the slot's window at start
+    session: int = 0
+
+    @property
+    def sampling(self):
+        from .lookup import sampling_of
+
+        return sampling_of(self.noise) if self.noise else None
+
+
+def load(folder: str) -> list[Pass]:
+    """Every logged pass with its serial continuation and its window's target top-K rows."""
+
+    files = sorted(glob.glob(os.path.join(folder, "draftlog-*.pkl")),
+                   key=lambda f: (os.path.basename(f).split("-")[1], f))
+    events = []
+    for f in files:
+        with open(f, "rb") as fh:
+            events += pickle.load(fh)["events"]
+    sess = {}                                   # slot -> session id
+    nxt = 0
+    toks: dict = defaultdict(dict)              # session -> {position: token}
+    passes: list[Pass] = []
+    open_pass: dict = {}                        # (session, start) -> Pass
+    for kind, ev in events:
+        s = ev.get("slot")
+        if kind == "r":
+            sess[s] = nxt
+            nxt += 1
+        elif kind == "d":
+            if s not in sess:
+                sess[s] = nxt
+                nxt += 1
+            sid = sess[s]
+            p = Pass(s, ev["start"], ev["pending"], ev["drafts"], ev["conf"], ev["k"], ev["noise"], ev.get("cand"),
+                     ev.get("base"), ev.get("hid"), session=sid)
+            passes.append(p)
+            open_pass[(sid, p.start)] = p
+        elif kind == "w":
+            for g in ev["segs"]:
+                sid = sess.get(g["slot"])
+                p = open_pass.get((sid, g["start"])) if sid is not None else None
+                if p is not None and p.target is None and list(g["tokens"][:1]) == [p.pending]:
+                    p.target = (g["ids"], g["values"])
+        elif kind == "k":
+            sid = sess.get(s)
+            if sid is None or "bonus" not in ev or ev["start"] < 0:
+                continue
+            got = ev["tokens"][1:ev["accepted"] + 1] + [ev["bonus"]]
+            for i, t in enumerate(got):
+                toks[sid][ev["start"] + 1 + i] = int(t)
+    for p in passes:
+        m = toks.get(p.session, {})
+        out = []
+        for i in range(len(p.drafts)):
+            t = m.get(p.start + 1 + i)
+            if t is None:
+                break
+            out.append(t)
+        p.serial = out
+    return passes
+
+
+def streams(passes) -> dict[int, dict[int, int]]:
+    """Each session's serial tokens by position (from the passes' pending tokens and continuations)."""
+
+    by: dict = defaultdict(dict)
+    for p in passes:
+        by[p.session][p.start] = int(p.pending)
+        for i, t in enumerate(p.serial):
+            by[p.session][p.start + 1 + i] = t
+    return dict(by)
+
+
+def _kept(drafts, serial) -> int:
+    a = 0
+    for d, s in zip(drafts, serial):
+        if int(d) != int(s):
+            break
+        a += 1
+    return a
+
+
+def positions(passes, n: int = 5) -> dict:
+    reached, kept, verified = [0] * n, [0] * n, [0] * n
+    for p in passes:
+        a = _kept(p.drafts, p.serial)
+        for i in range(min(n, len(p.serial))):
+            if i <= a:
+                reached[i] += 1
+                kept[i] += int(i < a)
+            verified[i] += int(i < p.k)
+    cond = [round(k / r, 4) if r else None for k, r in zip(kept, reached)]
+    lens = [_kept(p.drafts, p.serial) for p in passes if len(p.serial) >= n]
+    return {"passes": len(passes), "reached": reached, "kept": kept, "conditional": cond, "verified": verified,
+            "chain_tokens_all_n": round(1 + float(np.mean(lens)), 4) if lens else None}
+
+
+def children_z(p: Pass, i: int, prev: int, w1, w2, alpha: float = 1.0, extra=None) -> tuple[np.ndarray, np.ndarray]:
+    """(ids, z) of row i after ``prev``: base + alpha x the Markov bias (+ ``extra(ids)``)."""
+
+    from .tree import markov_z
+
+    ids = p.cand[i]
+    z = p.base[i].astype(np.float32).copy() if alpha == 0.0 else None
+    if z is None:
+        mz = markov_z(p.base[i], ids, prev, w1, w2)
+        z = mz if alpha == 1.0 else (p.base[i] + alpha * (mz - p.base[i])).astype(np.float32)
+    if extra is not None:
+        z = z + extra(ids).astype(np.float32)
+    live = ids >= 0
+    return ids[live].astype(np.int64), z[live]
+
+
+def keyed_rank(ids, z, token: int, position: int, sampling, m: int = 8) -> int:
+    """The rank of ``token`` in the keyed order of (ids, z), m if not among the first m."""
+
+    from .tree import ranked
+
+    got = ranked(z, ids, position, sampling, m)
+    for r, (t, _) in enumerate(got):
+        if t == int(token):
+            return r
+    return m
+
+
+def ranks(passes, w1, w2, m: int = 4, n: int = 5) -> dict:
+    tf = np.zeros((n, m + 1), dtype=np.int64)       # teacher-forced prefix
+    dr = np.zeros((n, m + 1), dtype=np.int64)       # the drafted prefix, while it is serial (= tf) or not
+    outside = np.zeros(n, dtype=np.int64)
+    for p in passes:
+        if p.cand is None:
+            continue
+        smp = p.sampling
+        prev_t = prev_d = p.pending
+        for i in range(min(n, len(p.serial), p.cand.shape[0])):
+            ids, z = children_z(p, i, prev_t, w1, w2)
+            r = keyed_rank(ids, z, p.serial[i], p.start + 1 + i, smp, m)
+            tf[i, r] += 1
+            outside[i] += int(p.serial[i] not in set(ids.tolist()))
+            ids2, z2 = children_z(p, i, prev_d, w1, w2)
+            dr[i, keyed_rank(ids2, z2, p.serial[i], p.start + 1 + i, smp, m)] += 1
+            prev_t, prev_d = p.serial[i], p.drafts[i]
+
+    def recall(h):
+        tot = h.sum(1, keepdims=True).clip(min=1)
+        return np.round(np.cumsum(h[:, :m], 1) / tot, 4).tolist()
+
+    return {"teacher_forced_recall@1..m": recall(tf), "drafted_prefix_recall@1..m": recall(dr),
+            "outside_candidates": outside.tolist(), "rows": tf.sum(1).tolist()}
+
+
+def near_ties(passes) -> dict:
+    """First rejected drafts in a verified row: draft == target's 2nd choice, and the target's top-1 margin."""
+
+    n = second = 0
+    margins, margins_ok = [], []
+    for p in passes:
+        if p.target is None:
+            continue
+        ids, vals = p.target
+        a = _kept(p.drafts, p.serial)
+        for r in range(min(a, len(ids))):
+            if vals.shape[1] > 1:
+                margins_ok.append(float(vals[r, 0] - vals[r, 1]))
+        if a >= p.k or a >= len(ids) or p.sampling is not None:
+            continue                                # the mismatch row was not verified (or T > 0: keyed)
+        n += 1
+        if ids.shape[1] > 1:
+            second += int(int(ids[a, 1]) == int(p.drafts[a]))
+            margins.append(float(vals[a, 0] - vals[a, 1]))
+    mg = np.asarray(margins) if margins else np.zeros(0)
+    return {"rejections": n, "draft_is_target_2nd": round(second / n, 4) if n else None,
+            "margin_median": round(float(np.median(mg)), 3) if mg.size else None,
+            "margin_lt_0.5": round(float((mg < 0.5).mean()), 4) if mg.size else None,
+            "margin_lt_1.0": round(float((mg < 1.0).mean()), 4) if mg.size else None,
+            "accepted_rows_margin_median": round(float(np.median(margins_ok)), 3) if margins_ok else None}
+
+
+def chain(p: Pass, w1, w2, alpha: float = 1.0, extra_of=None, n: int = 5) -> list[int]:
+    """The chain's keyed drafts under z = base + alpha Markov (+ ``extra_of(prefix)(ids)``)."""
+
+    from tensorfold.engine.exact_sampling import choose
+
+    out, prev, smp = [], p.pending, p.sampling
+    hist = [p.pending]
+    for i in range(min(n, p.cand.shape[0])):
+        ids, z = children_z(p, i, prev, w1, w2, alpha, extra_of(hist) if extra_of else None)
+        if not ids.size:
+            break
+        tok = int(ids[np.lexsort((ids, -z))[0]]) if smp is None else choose(z, ids, p.start + 1 + i, smp)
+        out.append(tok)
+        hist.append(tok)
+        prev = tok
+    return out
+
+
+def accept_stats(passes, drafts_of, n: int = 5) -> dict:
+    lens, firsts = [], []
+    for p in passes:
+        if p.cand is None or len(p.serial) < n:
+            continue
+        d = drafts_of(p)
+        lens.append(_kept(d, p.serial))
+        firsts.append(int(bool(d) and d[0] == p.serial[0]))
+    return {"n": len(lens), "tokens_all_n": round(1 + float(np.mean(lens)), 4) if lens else None,
+            "first": round(float(np.mean(firsts)), 4) if firsts else None}
+
+
+def markov_sweep(passes, w1, w2, alphas=(0.0, 0.5, 0.75, 1.0, 1.25, 1.5, 2.0)) -> dict:
+    return {str(a): accept_stats(passes, lambda p, a=a: chain(p, w1, w2, a)) for a in alphas}
+
+
+class NGram:
+    """Counts of (t-2, t-1) -> next over token streams; ``logp(ctx)(ids)``: log p with add-k over the candidates
+    (0 where the context was never seen: no bias)."""
+
+    def __init__(self, order: int = 3) -> None:
+        self.order = order
+        self.tab: dict = defaultdict(lambda: defaultdict(int))
+
+    def add(self, toks) -> None:
+        o = self.order - 1
+        for i in range(o, len(toks)):
+            self.tab[tuple(toks[i - o:i])][int(toks[i])] += 1
+
+    def remove(self, toks) -> None:
+        o = self.order - 1
+        for i in range(o, len(toks)):
+            c = self.tab[tuple(toks[i - o:i])]
+            c[int(toks[i])] -= 1
+
+    def logp(self, hist, k: float = 0.1):
+        o = self.order - 1
+        c = self.tab.get(tuple(hist[-o:])) if len(hist) >= o else None
+        tot = sum(c.values()) if c else 0
+
+        def f(ids):
+            if not tot:
+                return np.zeros(len(ids), dtype=np.float32)
+            return np.log(np.asarray([c.get(int(t), 0) + k for t in ids], dtype=np.float64) / (tot + k * len(ids)))
+        return f
+
+
+def ngram_sweep(passes, w1, w2, betas=(0.0, 0.25, 0.5, 1.0), corpus: list | None = None) -> dict:
+    """Leave one session out: each session's chains see the other sessions' streams (and ``corpus``)."""
+
+    st = {s: [m[k] for k in sorted(m)] for s, m in streams(passes).items()}
+    pos = streams(passes)
+    ng = NGram()
+    for toks in st.values():
+        ng.add(toks)
+    for toks in corpus or []:
+        ng.add(toks)
+    out = {}
+    for b in betas:
+        res_l, firsts = [], []
+        for s, toks in st.items():
+            ng.remove(toks)
+            for p in passes:
+                if p.session != s or p.cand is None or len(p.serial) < 5:
+                    continue
+                pre = [t for t in (pos[s].get(p.start - 1), p.pending) if t is not None]   # the pending one last
+
+                def ext(hist, pre=pre, b=b):
+                    f = ng.logp(list(pre[:-1]) + list(hist))
+                    return lambda ids: b * f(ids)
+                d = chain(p, w1, w2, 1.0, ext if b else None)
+                res_l.append(_kept(d, p.serial))
+                firsts.append(int(d[0] == p.serial[0]))
+            ng.add(toks)
+        out[str(b)] = {"n": len(res_l), "tokens_all_n": round(1 + float(np.mean(res_l)), 4) if res_l else None,
+                       "first": round(float(np.mean(firsts)), 4) if firsts else None}
+    return out
+
+
+def fit_temps(passes, n: int = 5) -> dict:
+    """Sequential temperature scaling: T_j on the passes whose drafts before j were serial."""
+
+    from .confcal import _logit, fit
+
+    temps, ece = [], []
+    for j in range(n):
+        xs, ys = [], []
+        for p in passes:
+            if len(p.serial) > j and _kept(p.drafts, p.serial) >= j and j < len(p.conf):
+                xs.append(_logit(p.conf[j]))
+                ys.append(float(p.drafts[j] == p.serial[j]))
+        if len(xs) < 32:
+            temps.append(None)
+            ece.append(None)
+            continue
+        a, _ = fit(xs, ys, bias=False, ridge=1.0, steps=20)
+        temps.append(round(1.0 / a, 4))
+        ece.append((_ece(xs, ys, 1.0), _ece(xs, ys, a)))
+    return {"temps": temps, "ece_raw_vs_scaled": ece}
+
+
+def _ece(xs, ys, a: float, bins: int = 10) -> float:
+    p = 1.0 / (1.0 + np.exp(-a * np.asarray(xs)))
+    y = np.asarray(ys)
+    b = np.minimum((p * bins).astype(int), bins - 1)
+    return round(float(sum(abs(p[b == i].sum() - y[b == i].sum()) for i in range(bins)) / len(p)), 4)
+
+
+def heads(path: str):
+    """(w1 bf16 [V, r], w2 bf16 [V, r], cw fp32 [D + r] | None) from a checkpoint folder or one safetensors shard."""
+
+    import torch
+    from safetensors import safe_open
+
+    files = [path]
+    if os.path.isdir(path):
+        idx = json.load(open(os.path.join(path, "model.safetensors.index.json")))["weight_map"]
+        files = sorted({os.path.join(path, f) for k, f in idx.items() if "markov_head" in k or "confidence_head" in k})
+    got = {}
+    for f in files:
+        with safe_open(f, "pt") as fh:
+            for k in fh.keys():
+                if "markov_head" in k or "confidence_head" in k:
+                    got[k.split(".", 2)[2]] = fh.get_tensor(k)
+    cw = got.get("confidence_head.proj.weight")
+    return (got["markov_head.embed.weight"].to(torch.bfloat16), got["markov_head.head.weight"].to(torch.bfloat16),
+            None if cw is None else cw.float().reshape(-1))
+
+
+def report(passes, w1, w2) -> dict:
+    return {"positions": positions(passes), "ranks": ranks(passes, w1, w2), "near_ties": near_ties(passes),
+            "markov_sweep": markov_sweep(passes, w1, w2), "ngram_sweep": ngram_sweep(passes, w1, w2),
+            "fit_temps": fit_temps(passes)}
+
+
+def main(argv=None) -> None:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("log")
+    ap.add_argument("--heads", required=True, help="checkpoint folder or the safetensors shard of the DSpark heads")
+    ap.add_argument("--out", default="")
+    ap.add_argument("--costs", default="", help="verify ms of 1, 2, .. rows (default: G9's)")
+    a = ap.parse_args(argv)
+    passes = load(a.log)
+    w1, w2, cw = heads(a.heads)
+    rep = report(passes, w1, w2)
+    from . import treesim
+
+    costs = [float(x) for x in a.costs.split(",")] if a.costs else None
+    rep["replay"] = treesim.replay_all(passes, w1, w2, cw, verify=costs)
+    js = json.dumps(rep, indent=1, default=lambda o: o.tolist() if hasattr(o, "tolist") else str(o))
+    if a.out:
+        open(a.out, "w").write(js)
+    print(js)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/tensorfold/families/deepseek_v41/cuda/drafttrain.py b/src/tensorfold/families/deepseek_v41/cuda/drafttrain.py
