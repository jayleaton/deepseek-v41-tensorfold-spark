+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16 ``TF_DSV41_MHC_PF`` on the GPU (collected only where PyTorch sees an NVIDIA GPU): the prefill segment's mHC site
+as one CUDA pass (``mhc_pf.cu``) + Triton's finish == Triton's ``_site`` + finish, bit for bit, for every output
+(new streams, the next sublayer's input, pre / post / comb, the collapsed row, every PART entry the finish reads,
+the taps): boundary in place and out of place, site from stream 0, site with a carried pre-mix; 2,048 / 2,047 /
+300 rows (tile tails); fn bf16 (prod) and fp32 (strict); gathered bf16 (prod) and fp32; then the time of each path at
+2,048 rows (printed, ``[G16]``: the window's pass line is the CUDA boundary <= 0.6 x Triton's).
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_mhc_pf_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.families.deepseek_v41.cuda import mhc  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import mhc_pf as MP  # noqa: E402
+
+DEV = "cuda"
+D = 5120
+
+
+def _bits(t):
+    return t.reshape(-1).contiguous().view(torch.uint8)
+
+
+def _ms(fn, reps: int = 10) -> float:
+    fn()
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(reps):
+        fn()
+    b.record()
+    torch.cuda.synchronize()
+    return a.elapsed_time(b) / reps
+
+
+def _case(R: int, world: int = 2, fn16: bool = True, g16: bool = True, seed: int = 1):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn((R, 4 * D), generator=g).to(torch.bfloat16)
+    gathered = (torch.randn((world, R, D), generator=g) * 0.7).to(torch.bfloat16)
+    gathered = gathered if g16 else gathered.float()
+    comb = torch.rand((R, 4, 4), generator=g)
+    comb = (comb / comb.sum(1, keepdim=True)).reshape(R, 16)
+    prev = mhc.Coefs(R, DEV, pre=(torch.rand((R, 4), generator=g) + 0.1).to(DEV),
+                     post=(torch.rand((R, 4), generator=g) * 2).to(DEV), comb=comb.contiguous().to(DEV))
+    fn = torch.randn((24, 4 * D), generator=g) * 0.01
+    hc = mhc.Hc((fn.to(torch.bfloat16) if fn16 else fn).to(DEV), (torch.randn(24, generator=g) * 0.5).to(DEV),
+                (torch.rand(3, generator=g) + 0.5).to(DEV))
+    nw = (torch.rand(D, generator=g) + 0.5).to(torch.bfloat16).to(DEV)
+    return x.to(DEV), gathered.to(DEV), prev, hc, nw
+
+
+def _defined(part: torch.Tensor) -> torch.Tensor:
+    R = part.shape[0]
+    keep = torch.zeros((R, 4, 40, 32), dtype=torch.bool, device=part.device)
+    keep[..., :25] = True
+    keep[:, 0, :, 25] = True
+    return part[keep]
+
+
+def _boundary(x, gathered, prev, hc, nw, *, inplace: bool, tap: bool):
+    R = gathered.shape[1]
+    xs = x.clone()
+    xo = xs if inplace else torch.empty_like(x)
+    out = torch.empty((R, D), dtype=torch.bfloat16, device=DEV)
+    co = mhc.Coefs(R, DEV)
+    sc = mhc.Scratch(R, DEV, D)
+    tp = torch.empty((R, D), dtype=torch.bfloat16, device=DEV) if tap else None
+    mhc.boundary(xs, xo, gathered, prev, hc, nw, out, co, sc, tp)
+    got = [xo, out, co.pre, co.post, co.comb, sc.c[:R], _defined(sc.part[:R])]
+    return got + ([tp] if tap else [])
+
+
+def _site(x, prev, hc, nw, pre_in):
+    R = x.shape[0]
+    out = torch.empty((R, D), dtype=torch.bfloat16, device=DEV)
+    co = mhc.Coefs(R, DEV)
+    sc = mhc.Scratch(R, DEV, D)
+    mhc.site(x, hc, nw, out, co, sc, pre_in)
+    return [out, co.pre, co.post, co.comb, sc.c[:R], _defined(sc.part[:R])]
+
+
+def _both(monkeypatch, fn):
+    monkeypatch.setenv("TF_DSV41_MHC_PF", "0")
+    want = fn()
+    monkeypatch.setenv("TF_DSV41_MHC_PF", "1")
+    got = fn()
+    for i, (a, b) in enumerate(zip(got, want)):
+        assert torch.equal(_bits(a), _bits(b)), f"output {i}"
+
+
+@pytest.mark.parametrize("R", [2048, 2047, 300])
+@pytest.mark.parametrize("fn16,g16", [(True, True), (False, False), (False, True)])
+def test_boundary_same_bits(monkeypatch, R, fn16, g16):
+    monkeypatch.setenv("TF_DSV41_MHC_BM", "64")                 # prod's Triton tile (any tile: the same bits)
+    x, gathered, prev, hc, nw = _case(R, fn16=fn16, g16=g16, seed=R)
+    calls = []
+    real = MP._ext
+
+    def spy():
+        calls.append(1)
+        return real()
+
+    monkeypatch.setattr(MP, "_ext", spy)
+    for inplace, tap in ((True, False), (False, True)):
+        _both(monkeypatch, lambda i=inplace, t=tap: _boundary(x, gathered, prev, hc, nw, inplace=i, tap=t))
+    assert calls                                                # the CUDA path ran
+
+
+@pytest.mark.parametrize("R", [2048, 333])
+@pytest.mark.parametrize("fn16", [True, False])
+def test_site_same_bits(monkeypatch, R, fn16):
+    x, _, prev, hc, nw = _case(R, fn16=fn16, seed=7 + R)
+    _both(monkeypatch, lambda: _site(x, prev, hc, nw, None))           # model / DSpark entry: stream 0
+    _both(monkeypatch, lambda: _site(x, prev, hc, nw, prev.pre))       # after Engram: the carried pre-mix
+
+
+def test_decode_rows_untouched(monkeypatch):
+    """Windows under the row floor never take the CUDA prefill site (and a floor of 17 keeps 16-row windows out)."""
+
+    monkeypatch.setenv("TF_DSV41_MHC_PF", "1")
+    x, gathered, prev, hc, _ = _case(16)
+    assert MP.why_not(16, x, x, gathered, prev, prev.pre, hc, mhc.Scratch(16, DEV, D), None, True, 2, True) == "rows"
+
+
+@pytest.mark.parametrize("fn16", [True, False])
+def test_time_at_2048_rows(monkeypatch, fn16):
+    monkeypatch.setenv("TF_DSV41_MHC_BM", "64")
+    R = 2048
+    x, gathered, prev, hc, nw = _case(R, fn16=fn16)
+    xo = x.clone()
+    out = torch.empty((R, D), dtype=torch.bfloat16, device=DEV)
+    co = mhc.Coefs(R, DEV)
+    sc = mhc.Scratch(R, DEV, D)
+    run = (lambda: mhc.boundary(xo, xo, gathered, prev, hc, nw, out, co, sc))   # noqa: E731
+    monkeypatch.setenv("TF_DSV41_MHC_PF", "0")
+    t_tri = _ms(run)
+    t_tsite = _ms(lambda: mhc._launch(xo, xo, gathered, prev, prev.pre, hc, sc, None, R, D, True, 2, True))
+    monkeypatch.setenv("TF_DSV41_MHC_PF", "1")
+    t_cuda = _ms(run)
+    t_csite = _ms(lambda: mhc._launch(xo, xo, gathered, prev, prev.pre, hc, sc, None, R, D, True, 2, True))
+    gb = (2 * R * 4 * D * 2 + gathered.numel() * gathered.element_size() + R * D * 2) / 1e9
+    print(f"[G16] mhc boundary at {R} rows, fn {'bf16' if fn16 else 'fp32'}: Triton {t_tri:.3f} ms (site "
+          f"{t_tsite:.3f}), CUDA site + Triton finish {t_cuda:.3f} ms (site {t_csite:.3f}, {gb / t_csite * 1e3:.0f} "
+          f"GB/s of {gb * 1e3:.0f} MB); ratio {t_cuda / t_tri:.2f}")
