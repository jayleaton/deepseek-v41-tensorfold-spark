+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DSpark drafting log (``TF_DSV41_DRAFT_LOG=<dir>``): what offline acceptance work needs from a GPU run, written by
+rank 0 (both ranks hold the same drafts and candidates). Off by default; nothing here changes a token or a draft.
+
+Per round, as events (``draftsim.load`` reads them back):
+
+- ``r`` reset(slot): a request starts on the slot (its positions restart);
+- ``d`` draft: for every slot of the pass: start P, pending token, the pass's drafts and raw confidences (all N
+  rows), the drafts verified (the depth's k), the request's keyed noise, and the pass's gathered candidates and base
+  logits [N, C] (before the Markov bias: ``Drafter.last_tree``); with ``TF_DSV41_DRAFT_LOG_HID=1`` also the head
+  hidden [N, D] (bf16 bits as int16: the self-distillation features, ``drafttrain``);
+- ``w`` window: every segment verified (slot, start, tokens; tree siblings on their shadow slots too) and the
+  target's top ``TF_DSV41_DRAFT_LOG_TOPK`` (default 8) candidates of each row (ids, logits): the target's
+  top-2 at each verified row;
+- ``k`` commit: slot, drafts accepted, the chain presented (``tree``: 0 = the main chain), its start and tokens
+  ([pending, drafts ..]), then the bonus token.
+
+The committed tokens give the serial continuation after every pass (T = 0: exactly the greedy reply; T > 0: the
+keyed samples), so a pass's drafts, its whole draft distribution (base + any Markov rule) and any tree over it can
+be scored offline against the tokens the target chose, at every logged position.
+
+Cost: the pass's candidates are already kept for ``tree.py`` (one [N, C] copy to the host a pass); the window's
+top-K rows come from the candidates the sampler fetched anyway. Events are pickled every ``FLUSH`` rounds to
+``<dir>/draftlog-<pid>-<seq>.pkl`` (and at exit). Logging adds host time only, and the depth prices modelled
+costs, never clocks: drafts and acceptance are those of an unlogged run.
+
+- ``t`` taps (``TF_DSV41_DRAFT_LOG_TAPS=1``): every ingest's taps [n, 3 D] at its start position (30 KB a token): the
+  drafter's whole input, so another drafter (source-precision weights, a trained one) can be replayed offline
+  (``engine/reference``'s DSpark) on exactly these contexts and scored against the same serial tokens.
+
+Knobs: TF_DSV41_DRAFT_LOG (a directory; empty = off), TF_DSV41_DRAFT_LOG_HID (0 | 1), TF_DSV41_DRAFT_LOG_TOPK (8),
+TF_DSV41_DRAFT_LOG_TAPS (0 | 1).
+"""
+
+from __future__ import annotations
+
+import atexit
+import os
+import pickle
+import time
+
+import numpy as np
+
+FLUSH = 256
+
+
+def settings(env=None) -> tuple[str, bool, int, bool]:
+    env = os.environ if env is None else env
+    d = (env.get("TF_DSV41_DRAFT_LOG", "") or "").strip()
+    hid = (env.get("TF_DSV41_DRAFT_LOG_HID", "") or "0").strip() not in ("0", "off", "false")
+    taps = (env.get("TF_DSV41_DRAFT_LOG_TAPS", "") or "0").strip() not in ("0", "off", "false")
+    topk = int((env.get("TF_DSV41_DRAFT_LOG_TOPK", "") or "8").strip())
+    if not 1 <= topk <= 64:
+        raise ValueError(f"TF_DSV41_DRAFT_LOG_TOPK={topk}: expected 1 to 64")
+    return d, hid, topk, taps
+
+
+class DraftLog:
+    """The events of one process (rank 0), flushed to ``folder``."""
+
+    def __init__(self, folder: str, *, hid: bool = False, topk: int = 8) -> None:
+        self.folder, self.hid, self.topk = folder, bool(hid), int(topk)
+        os.makedirs(folder, exist_ok=True)
+        self.events: list = []
+        self.rounds = 0
+        self.seq = 0
+        self.t0 = time.time()
+        atexit.register(self.flush)
+
+    def taps(self, slot: int, start: int, t) -> None:
+        """The committed rows' taps (the drafter's context input, [n, 3 D]) at positions start .. (bf16 bits)."""
+
+        import torch
+
+        self.events.append(("t", {"slot": int(slot), "start": int(start),
+                                  "taps": t.detach().to(torch.bfloat16).view(torch.int16).cpu().numpy().copy()}))
+
+    def reset(self, slot: int) -> None:
+        self.events.append(("r", {"slot": int(slot)}))
+
+    def drafted(self, slots, pendings, starts, noises, drafts, conf, verified, tree, hid=None) -> None:
+        for i, s in enumerate(slots):
+            ev = {"slot": int(s), "start": int(starts[i]), "pending": int(pendings[i]),
+                  "drafts": [int(t) for t in drafts[i]], "conf": [float(c) for c in conf[i]],
+                  "k": len(verified[i]), "noise": list(noises[i]) if noises and noises[i] else []}
+            if tree is not None and i < len(tree):
+                c, v = tree[i]
+                ev["cand"], ev["base"] = np.asarray(c, dtype=np.int32).copy(), np.asarray(v, dtype=np.float32).copy()
+            if self.hid and hid is not None and i < len(hid):
+                import torch
+
+                ev["hid"] = hid[i].to(torch.bfloat16).view(torch.int16).numpy().copy()
+            self.events.append(("d", ev))
+
+    def window(self, segs, cand) -> None:
+        if cand is None:
+            return
+        k = min(self.topk, cand.ids.shape[1])
+        segs_out, a = [], 0
+        for g in segs:
+            toks = getattr(g, "ids", None) or getattr(g, "tokens")
+            n = len(toks)
+            segs_out.append({"slot": int(g.slot), "start": int(g.start), "tokens": [int(t) for t in toks],
+                             "ids": np.asarray(cand.ids[a:a + n, :k], dtype=np.int32).copy(),
+                             "values": np.asarray(cand.values[a:a + n, :k], dtype=np.float32).copy()})
+            a += n
+        self.events.append(("w", {"segs": segs_out}))
+
+    def commit(self, slot: int, accepted: int, chain: int, start: int = -1, tokens=()) -> None:
+        self.events.append(("k", {"slot": int(slot), "accepted": int(accepted), "chain": int(chain),
+                                  "start": int(start), "tokens": [int(t) for t in tokens]}))
+
+    def bonus(self, slot: int, token: int) -> None:
+        for kind, ev in reversed(self.events):
+            if kind == "k" and ev["slot"] == int(slot) and "bonus" not in ev:
+                ev["bonus"] = int(token)
+                break
+        self.rounds += 1
+        if self.rounds % FLUSH == 0:
+            self.flush()
+
+    def flush(self) -> None:
+        if not self.events:
+            return
+        path = os.path.join(self.folder, f"draftlog-{os.getpid()}-{self.seq:05d}.pkl")
+        with open(path + ".tmp", "wb") as f:
+            pickle.dump({"t0": self.t0, "events": self.events}, f, protocol=5)
+        os.replace(path + ".tmp", path)
+        self.seq += 1
+        self.events = []
+
+
+def make(fw) -> DraftLog | None:
+    """A ``DraftLog`` for ``fw`` (``decode.DecodeForward``) on rank 0 when TF_DSV41_DRAFT_LOG names a directory and
+    the forward drafts; it turns on the drafter's candidate copies (``keep_tree``) and, with _HID, the hidden."""
+
+    folder, hid, topk, taps = settings()
+    if not folder or getattr(fw, "drafter", None) is None or int(getattr(fw, "rank", 0)) != 0:
+        return None
+    fw.drafter.keep_tree = True
+    fw.drafter.keep_hid = hid
+    log = DraftLog(folder, hid=hid, topk=topk)
+    if taps:
+        fw.drafter.on_ingest = log.taps
+    return log
+
+
+__all__ = ["DraftLog", "make", "settings"]
