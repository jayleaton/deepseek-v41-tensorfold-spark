+    jobs = [Job(list(p), N_SHORT, None) for p in prompts] + [Job(list(prompts[0]), N_SHORT, SAMPLINGS[1])]
+    assert DF.run(b, jobs) == want
+    st = [j.stats["drafting"] for j in jobs]
+    assert all(s["lookup_rounds"] >= 1 for s in st)
+    deep = max(s["lookup_drafts"] / s["lookup_rounds"] for s in st)
+    assert deep >= (4 if dspark_on else 8)                       # deep windows (up to 16 rows) ran
+    if dspark_on:
+        assert sum(s["dspark_rounds"] for s in st) > 0
