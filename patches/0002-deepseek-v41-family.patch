+
+def _rand(rng, shape, scale=1.0, dtype=np.float16):
+    return (rng.standard_normal(shape) * scale).astype(dtype)
+
+
+def _case(rng, segs, m, shared_x: bool):
+    """Random inputs / W_q / scales for ``segs``; inputs shared by every segment of the same K when ``shared_x``."""
+
+    xs, by_k = [], {}
+    for s in segs:
+        if shared_x and s.k in by_k:
+            xs.append(by_k[s.k])
+            continue
+        x = _rand(rng, (m, s.k), 2.0).astype(np.float32)
+        by_k[s.k] = x
+        xs.append(x)
+    suh = [np.where(rng.random(s.k) < 0.5, -1.0, 1.0).astype(np.float16) for s in segs]
+    W = [_rand(rng, (s.k, s.n), 0.5).astype(np.float64) for s in segs]
+    svh = [(_rand(rng, (s.n,), 0.02) + np.float16(0.03)).astype(np.float32) for s in segs]
+    return xs, suh, W, svh
+
+
+def _compare(segs, xs, suh, W, svh, m, seeds=(0, 1, 2)):
+    widths: dict[int, int] = {}
+    for s in segs:
+        widths[s.out] = max(widths.get(s.out, 0), s.col + s.n)
+    lay = FP.layout(segs, m)
+    check_tiling(lay, segs)
+    want = [np.full((m, widths[b]), np.nan, dtype=np.float32) for b in sorted(widths)]
+    for i, s in enumerate(segs):
+        want[s.out][:, s.col:s.col + s.n] = E.upstream(xs[i], suh[i], W[i], svh[i], s.sk, s.wk, seed=i)
+    for seed in seeds:
+        got, mem = E.segmented(xs, suh, W, svh, segs, lay, [widths[b] for b in sorted(widths)], seed=seed)
+        for g, w in zip(got, want):
+            assert np.array_equal(g.view(np.uint32), w.view(np.uint32))
+        assert all((c == 1).all() for c in mem.writes) and not mem.counters.any()
+    return want
+
+
+@pytest.mark.parametrize("m", [1, 3, 16, 17, 40])
+def test_segments_equal_upstream_launches_bitwise(m):
+    rng = np.random.default_rng(100 + m)
+    segs = [FP.Seg(256, 256, 10, 2, 4, 0, 0),           # split-K
+            FP.Seg(512, 384, 10, 1, 8, 1, 0),           # 8 warps, one split
+            FP.Seg(256, 128, 10, 4, 4, 2, 0),           # 4 splits, 2 per_warp
+            FP.Seg(256, 128, 10, 1, 4, 2, 128),         # same buffer, next to it
+            FP.Seg(512, 256, 8, 2, 8, 3, 0)]            # another width: its own launch
+    xs, suh, W, svh = _case(rng, segs, m, shared_x=True)
+    _compare(segs, xs, suh, W, svh, m)
+
+
+def test_float64_sanity_of_the_emulator():
+    rng = np.random.default_rng(7)
+    s = FP.Seg(512, 256, 10, 2, 4)
+    xs, suh, W, svh = _case(rng, [s], 3, shared_x=False)
+    y = E.upstream(xs[0], suh[0], W[0], svh[0], s.sk, s.wk)
+    from tensorfold.cuda.exl3 import format as fmt
+
+    H = fmt.hadamard() / np.sqrt(128.0)
+    xr = (xs[0].astype(np.float64) * suh[0]).reshape(3, -1, 128) @ H
+    ref = (xr.reshape(3, -1) @ W[0]).reshape(3, -1, 128) @ H * svh[0].reshape(-1, 128).astype(np.float64)
+    ref = ref.reshape(3, -1)
+    assert np.abs(y - ref).max() / np.abs(ref).max() < 3e-3
