--- /dev/null
+++ b/tests/dsv41_pfdense_emu.py
@@ -0,0 +1,709 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""A numpy emulator (no GPU) of ``pfdense.cuh`` (TF_DSV41_PF_DENSE=fused) and of the program it must equal.
+
+- ``reference``: upstream ``prefill.matmul`` as Triton 3.8 lowers ``_gemm`` on sm_121 (test_triton_lowering_pins
+  checks these facts in the PTX): per output one chain of k16 MMAs in ascending K from +0, top / rest bf16, one
+  16-step bf16 chain with H from +0, ``* SCALE``, ``* svh`` (``fma`` with a bias), the RN cast. W_q is upstream's
+  ``format.unpack`` (what ``unpack_kernel`` / ``lanes_unpack_kernel`` write).
+- ``kernel``: the fused kernel transcribed statement by statement for every CTA, warp and lane: the raster, the
+  cp.async ring (addresses, swizzles, slot reuse, commit / wait counting; loads land at issue AND at the wait, so a
+  slot overwritten too early or read too soon changes the result), the stage decode from shared memory
+  (``decode.cuh``'s lane words / windows for strips, ``frag_lanes_pair`` for lanes) into the B-fragment buffers,
+  ``ldmatrix`` / ``ld.shared`` fragment loads, the MMAs, and the epilogue rounds (top / rest planes, H fragments from
+  ``had_base`` / ``had_frag``, the chain, the finish). Fragments become matrices by the PTX ISA's layouts alone
+  (``A_MAP`` / ``B_MAP`` / ``C_MAP``), never by the kernel's own indexing.
+- the MMA model is order-sensitive (fp32 C, then the 16 products added one at a time in k order), so a misplaced
+  operand, a k slice out of order or a split chain shows up as other bits; ``kernel == reference`` under it means
+  the two programs feed the same operands to the same chains, which is the GPU's bit equality (the MMA is a
+  deterministic function of C, an A row and a B column).
+- ``kernel_wq``: the kernel's decode for a whole matrix, vectorized (real-pack sizes): each tile through the stage
+  decode a warp runs, each fragment register read back to its (k, n) as the MMA consumes it.
+"""
+
+from __future__ import annotations
+
+from fractions import Fraction
+
+import numpy as np
+
+U32, U64 = np.uint32, np.uint64
+MUL1 = None                                  # fmt.codebook("mul1") as uint16 bits (lazy)
+HAD_SCALE = np.float32(0.08838834764831845)
+
+# id: (BM, WM, WN, KS, NST): pfdense_args.h DSV41_PFD_CFGS
+CFGS = {0: (128, 2, 4, 2, 3), 1: (128, 2, 4, 2, 4), 2: (128, 4, 2, 2, 3), 3: (64, 2, 2, 2, 4), 4: (64, 1, 4, 2, 4),
+        5: (128, 2, 4, 2, 2), 6: (32, 1, 4, 2, 4), 7: (256, 4, 2, 2, 3)}
+
+
+def codebook():
+    global MUL1
+    if MUL1 is None:
+        from tensorfold.cuda.exl3 import format as fmt
+
+        MUL1 = fmt.codebook("mul1").view(np.uint16).copy()
+    return MUL1
+
+
+class Geo:
+    """pfdense.cuh's Cfg / Lay constants for (cfg, K2, lanes)."""
+
+    def __init__(self, cfg: int, k2: int, lanes: bool):
+        self.BM, self.WM, self.WN, self.KS, self.NST = CFGS[cfg]
+        self.k2, self.lanes = k2, lanes
+        self.NW = self.WM * self.WN
+        self.THREADS = 32 * self.NW
+        self.MT = self.BM // (self.WM * 16)
+        self.NT = 8 // self.WN
+        self.CPR, self.LDA = 2 * self.KS, 16 * self.KS
+        self.EPR = self.BM // self.WM
+        self.GPW = self.MT // self.WN if self.MT >= self.WN else 1
+        self.NSPLIT = self.WN // self.MT if self.WN >= self.MT else 1
+        self.EN8 = 16 // self.NSPLIT
+        self.TW = 4 * k2
+        self.A_BYTES = self.BM * self.LDA * 2
+        self.W_BYTES = self.KS * 8 * self.TW * 4
+        self.STAGE = self.A_BYTES + self.W_BYTES
+        self.RING = self.NST * self.STAGE
+        self.BBUF = self.KS * 8 * 32 * 16
+        self.MAIN = self.RING + 2 * self.BBUF
+        self.EPI = self.EPR * 128 * 2 * 2
+        self.SMEM = max(self.MAIN, self.EPI)
+        self.TPW = self.KS * 8 // self.NW
+        self.MINB = 2 if 2 * (self.SMEM + 1024) <= 102400 else 1
+        assert self.BM % (self.WM * 16) == 0 and 8 % self.WN == 0
+        assert self.MT % self.WN == 0 or self.WN % self.MT == 0
+        assert (self.KS * 8) % self.NW == 0
+        assert not lanes or (self.TPW % 2 == 0 and self.KS % 2 == 0 and k2 % 2 == 0 and k2 <= 12)
+
+
+# -- PTX ISA fragment layouts (mma.m16n8k16, 16-bit inputs; ldmatrix.x4) --------------------------------------------
+LANE = np.arange(32)
+G_, T_ = LANE >> 2, LANE & 3
+
+
+def _a_map():
+    """[32 lanes, 4 regs, 2 halves] -> (row, col) of the 16 x 16 A tile."""
+
+    r = np.zeros((32, 4, 2), dtype=np.int64)
+    c = np.zeros((32, 4, 2), dtype=np.int64)
+    for i in range(4):
+        for h in range(2):
+            r[:, i, h] = G_ + 8 * (i & 1)
+            c[:, i, h] = 2 * T_ + h + 8 * (i >> 1)
+    return r, c
+
+
+def _b_map():
+    """[32, 2 regs, 2 halves] -> (k, n) of the 16 x 8 B tile."""
+
+    k = np.zeros((32, 2, 2), dtype=np.int64)
+    n = np.zeros((32, 2, 2), dtype=np.int64)
+    for i in range(2):
+        for h in range(2):
+            k[:, i, h] = 2 * T_ + h + 8 * i
+            n[:, i, h] = G_
+    return k, n
+
+
+def _c_map():
+    """[32, 4] -> (row, col) of the 16 x 8 C / D tile."""
+
+    r = np.zeros((32, 4), dtype=np.int64)
+    c = np.zeros((32, 4), dtype=np.int64)
+    for j in range(4):
+        r[:, j] = G_ + 8 * (j >> 1)
+        c[:, j] = 2 * T_ + (j & 1)
+    return r, c
+
+
+A_MAP, B_MAP, C_MAP = _a_map(), _b_map(), _c_map()
+
+
+def f16f(bits) -> np.ndarray:
+    return np.asarray(bits, dtype=np.uint16).view(np.float16).astype(np.float32)
+
+
+def bf16f(bits) -> np.ndarray:
+    return (np.asarray(bits, dtype=np.uint32) << U32(16)).view(np.float32)
+
+
+def bf16_rne(x: np.ndarray) -> np.ndarray:
+    """fp32 -> bf16 bits, round to nearest even (cvt.rn.bf16.f32 for finite values)."""
+
+    u = np.asarray(x, dtype=np.float32).view(np.uint32).astype(np.uint64)
+    return (((u + 0x7FFF + ((u >> 16) & 1)) >> 16) & 0xFFFF).astype(np.uint16)
+
+
+def halves(regs: np.ndarray) -> np.ndarray:
+    """uint32 registers [...] -> 16-bit halves [..., 2] (low first)."""
+
+    r = regs.astype(np.uint32)
+    return np.stack([r & 0xFFFF, r >> 16], axis=-1).astype(np.uint16)
+
+
+def mma_model(c: np.ndarray, a: np.ndarray, b: np.ndarray) -> np.ndarray:
+    """[16, 8] fp32 = C, then a[:, i] * b[i, :] added for i = 0..15 in order (fp32, products exact)."""
+
+    d = c.astype(np.float32).copy()
+    for i in range(16):
+        d = (d + a[:, i:i + 1] * b[i:i + 1, :]).astype(np.float32)
+    return d
+
+
+def mma_frag(acc: np.ndarray, af: np.ndarray, bf: np.ndarray, bf16: bool) -> np.ndarray:
+    """One mma.m16n8k16 on fragments: acc [32, 4] fp32, af [32, 4] uint32, bf [32, 2] uint32 -> the new acc."""
+
+    conv = bf16f if bf16 else f16f
+    A = np.zeros((16, 16), dtype=np.float32)
+    B = np.zeros((16, 8), dtype=np.float32)
+    C = np.zeros((16, 8), dtype=np.float32)
+    A[A_MAP[0], A_MAP[1]] = conv(halves(af))
+    B[B_MAP[0], B_MAP[1]] = conv(halves(bf))
+    C[C_MAP[0], C_MAP[1]] = acc
+    return mma_model(C, A, B)[C_MAP[0], C_MAP[1]]
+
+
+def fma_f32(a: float, b: float, c: float) -> np.float32:
+    """fp32 fma, one rounding (round to nearest even), exactly."""
+
+    exact = Fraction(float(a)) * Fraction(float(b)) + Fraction(float(c))
+    r = np.float32(float(exact))
+    best = None
+    for cand in (np.nextafter(r, np.float32(-np.inf)), r, np.nextafter(r, np.float32(np.inf))):
+        d = abs(Fraction(float(cand)) - exact)
+        key = (d, int(np.float32(cand).view(np.uint32)) & 1)
+        if best is None or key < best[0]:
+            best = (key, cand)
+    return np.float32(best[1])
+
+
+def finish(y: np.ndarray, sv: np.ndarray, bias: np.ndarray | None) -> np.ndarray:
+    """Triton's y * SCALE * svh (fma.rn with a bias), fp32."""
+
+    v = (y.astype(np.float32) * HAD_SCALE).astype(np.float32)
+    if bias is None:
+        return (v * sv.astype(np.float32)).astype(np.float32)
+    out = np.empty_like(v)
+    vb = np.broadcast_arrays(v, sv.astype(np.float32), bias.astype(np.float32))
+    flat = [x.reshape(-1) for x in vb]
+    res = np.array([fma_f32(p, q, r) for p, q, r in zip(*flat)], dtype=np.float32)
+    out[...] = res.reshape(v.shape)
+    return out
+
+
+def cast(v: np.ndarray, out: str) -> np.ndarray:
+    """fp32 -> the output's bits (uint32 for fp32, uint16 for bf16 / fp16)."""
+
+    if out == "f32":
+        return v.astype(np.float32).view(np.uint32)
+    if out == "bf16":
+        return bf16_rne(v)
+    return v.astype(np.float16).view(np.uint16)
+
+
+def hadamard() -> np.ndarray:
+    i = np.arange(128)
+    par = np.array([int(v).bit_count() & 1 for v in range(128)])
+    return np.where(par[i[:, None] & i[None, :]] == 1, -1.0, 1.0).astype(np.float32)
+
+
+# -- the program to equal (Triton's _gemm on sm_121) ----------------------------------------------------------------
+def reference(xh: np.ndarray, wq: np.ndarray, svh: np.ndarray, bias: np.ndarray | None, out: str) -> np.ndarray:
+    """xh fp16 [M, K], wq fp16 [K, N], svh / bias fp16 [N] -> the output's bits [M, N]."""
+
+    M, K = xh.shape
+    N = wq.shape[1]
+    x = xh.astype(np.float32)
+    w = wq.astype(np.float32)
+    acc = np.zeros((M, N), dtype=np.float32)
+    for k in range(K):                                       # k16 chains in ascending K, positions in order
+        acc = (acc + x[:, k:k + 1] * w[k:k + 1, :]).astype(np.float32)
+    top_b = bf16_rne(acc)
+    top = bf16f(top_b)
+    rest = bf16f(bf16_rne((acc - top).astype(np.float32)))
+    H = hadamard()
+    t3, r3 = top.reshape(M, N // 128, 128), rest.reshape(M, N // 128, 128)
+    y = np.zeros((M, N // 128, 128), dtype=np.float32)
+    for src in (t3, r3):                                     # one chain: top's 128 k, then rest's
+        for k in range(128):
+            y = (y + src[:, :, k:k + 1] * H[k][None, None, :]).astype(np.float32)
+    v = finish(y.reshape(M, N), svh.astype(np.float32)[None, :], None if bias is None else bias[None, :])
+    return cast(v, out)
+
+
+# -- decode.cuh, transcribed -----------------------------------------------------------------------------------------
+def stream_end(k2: int, p):
+    p = np.asarray(p)
+    return ((p + 1) * k2 - ((p + 1) & 1)) // 2 if k2 & 1 else (p + 1) * (k2 // 2)
+
+
+def lane_words_n(k2: int) -> int:
+    most = 0
+    for l in range(32):
+        first = (int(stream_end(k2, 8 * l)) - 16 + 128 * k2) % 32
+        need = first + int(stream_end(k2, 8 * l + 7)) - int(stream_end(k2, 8 * l)) + 16
+        most = max(most, need)
+    return (most + 31) // 32
+
+
+def lane_start(k2: int, lane):
+    first = 4 * lane * k2 + k2 // 2 - 16 + 128 * k2
+    return (first >> 5) % (4 * k2), first & 31
+
+
+def _fsl(lo, hi, s):
+    """__funnelshift_l(lo, hi, s): the high 32 bits of (hi:lo) << (s & 31)."""
+
+    x = (np.asarray(hi, dtype=U64) << U64(32)) | np.asarray(lo, dtype=U64)
+    return ((x << U64(int(s) & 31) if np.isscalar(s) else x << (np.asarray(s, dtype=U64) & U64(31))) >> U64(32)) \
+        & U64(0xFFFFFFFF)
+
+
+def _window16(hi, mid, lo, d: int):
+    if d <= 16:
+        return (hi >> U64(16 - d)) & U64(0xFFFF)
+    if d < 32:
+        return _fsl(mid, hi, d) >> U64(16)
+    if d <= 48:
+        return (mid >> U64(48 - d)) & U64(0xFFFF)
+    return _fsl(lo, mid, d - 32) >> U64(16)
+
+
+def strips_states(tiles: np.ndarray, k2: int) -> np.ndarray:
+    """``frag_strips``' integer work: tiles uint32 [..., TW] (a tile's words as staged) -> states [..., 32 lanes, 8]
+    (load_lane_words + lane_states)."""
+
+    TW, LW = 4 * k2, lane_words_n(k2)
+    word, offset = lane_start(k2, LANE)
+    idx = (word[:, None] + np.arange(LW)[None, :]) % TW                    # [32, LW]
+    w = tiles[..., idx].astype(U64)                                        # [..., 32, LW]
+    off = offset.astype(U64)
+    c = w[..., 2] if LW > 2 else np.zeros_like(w[..., 0])
+    hi = _fsl(w[..., 1], w[..., 0], off)
+    mid = _fsl(c, w[..., 1], off)
+    lo = (c << off) & U64(0xFFFFFFFF)
+    e0 = int(stream_end(k2, 0))
+    out = np.empty(w.shape[:-1] + (8,), dtype=np.uint32)
+    for j in range(8):
+        out[..., j] = _window16(hi, mid, lo, int(stream_end(k2, j)) - e0).astype(np.uint32)
+    return out
+
+
+def lanes_pair_states(grp: np.ndarray, k2: int, gs: int, j: int) -> np.ndarray:
+    """``frag_lanes_pair``' integer work: grp uint32 [..., 64 K2] (a 2-step group block as staged: lane L's word w
+    at ((w / 4) * 32 + L) * 4 + w % 4) -> states [..., 2 tiles, 32 lanes, 8]."""
+
+    n, GW = 4 * k2, 2 * k2
+    p = (gs * 8 + j) * n
+    wi, bo = p >> 5, p & 31
+    c0, off = wi >> 2, wi & 3
+    m64 = U64(0xFFFFFFFFFFFFFFFF)
+
+    def chunk(c):
+        if c >= GW // 4:
+            return np.zeros(grp.shape[:-1] + (32, 4), dtype=U64)
+        ix = (c * 32 + LANE)[:, None] * 4 + np.arange(4)[None, :]
+        return grp[..., ix].astype(U64)
+
+    u, v = chunk(c0), chunk(c0 + 1)
+    uv = np.concatenate([u, v], axis=-1)                                   # x_q = uv[off + q]
+    x = [uv[..., off + q] for q in range(4)]
+    hi = (x[0] << U64(32)) | x[1]
+    lo = (x[2] << U64(32)) | x[3]
+    sh = (((hi << U64(bo)) & m64) | (lo >> U64(64 - bo))) if bo else hi
+    sl = (lo << U64(bo)) & m64
+    o0 = sh >> U64(64 - n)
+    o1 = ((((sh << U64(n)) & m64) | (sl >> U64(64 - n))) & m64) >> U64(64 - n)
+    tails = (o0 & U64(0xFFFF)) | ((o1 & U64(0xFFFF)) << U64(16))
+    pre = np.roll(tails, 1, axis=-1)                                       # __shfl_sync(tails, (lane + 31) & 31)
+    out = np.empty(grp.shape[:-1] + (2, 32, 8), dtype=np.uint32)
+    for h in range(2):
+        o = o1 if h else o0
+        pp = (pre >> U64(16)) if h else (pre & U64(0xFFFF))
+        for q in range(8):
+            sft = (7 - q) * k2 // 2
+            w = o >> U64(sft)
+            if n - sft < 16:
+                w = w | ((pp << U64(n - sft)) & m64)
+            out[..., h, :, q] = (w & U64(0xFFFF)).astype(np.uint32)
+    return out
+
+
+def frags_of_states(st: np.ndarray) -> np.ndarray:
+    """states [..., 32, 8] -> the decoded B fragment registers [..., 32, 4] uint32 (decode2 pairs (0,1) (2,3) (4,5)
+    (6,7): b0[0], b0[1], b1[0], b1[1]); decode2 == the mul1 codebook (upstream's property, the same function the
+    current path's unpack runs)."""
+
+    v = codebook()[st.astype(np.int64)].astype(np.uint32)
+    return v[..., 0::2] | (v[..., 1::2] << 16)
+
+
+# -- the kernel's decode for a whole matrix --------------------------------------------------------------------------
+def kernel_wq(words: np.ndarray, k2: int, K: int, N: int, stride_k: int, stride_nb: int, lanes: bool,
+              strips_of: list | None = None) -> np.ndarray:
+    """W_q [K, N] fp16 bits as the fused kernel's MMAs consume it: the stage's raw tiles (contiguous 8 TW words a k
+    step at kt stride_k + pn stride_nb), the decode a warp runs on them, each B register to its (k, n)
+    (pfdense.cuh's main loop: tile j's uint4 = b0 (cols 16 j + g), b1 (cols 16 j + 8 + g)). ``strips_of``: the
+    128-column blocks to do (default all; others stay 0)."""
+
+    TW, KT = 4 * k2, K // 16
+    flat = np.ascontiguousarray(words).reshape(-1).view(np.uint32)
+    out = np.zeros((K, N), dtype=np.uint16)
+    kb, nb = B_MAP
+    for pn in (range(N // 128) if strips_of is None else strips_of):
+        base = pn * stride_nb + np.arange(KT)[:, None] * stride_k + np.arange(8 * TW)[None, :]
+        raw = flat[base]                                                   # [KT, 8 TW] as each stage holds it
+        if not lanes:
+            st = strips_states(raw.reshape(KT, 8, TW), k2)                 # [KT, 8, 32, 8]
+        else:
+            grp = raw.reshape(KT // 2, 2 * 8 * TW)                         # 2-step group blocks
+            st = np.empty((KT // 2, 2, 8, 32, 8), dtype=np.uint32)
+            for gs in range(2):
+                for j in range(0, 8, 2):
+                    st[:, gs, j:j + 2] = lanes_pair_states(grp, k2, gs, j)
+            st = st.reshape(KT, 8, 32, 8)
+        fr = frags_of_states(st)                                           # [KT, 8 tiles, 32, 4]
+        for h in range(2):                                                 # b0 then b1 (the tile's n8 halves)
+            hv = halves(fr[..., 2 * h:2 * h + 2])                          # [KT, 8, 32, 2 regs, 2 halves]
+            kk = (np.arange(KT)[:, None, None, None, None] * 16 + kb[None, None])
+            nn = (pn * 128 + np.arange(8)[None, :, None, None, None] * 16 + 8 * h + nb[None, None])
+            out[np.broadcast_to(kk, hv.shape), np.broadcast_to(nn, hv.shape)] = hv
+    return out
+
+
+# -- the kernel, lane by lane -----------------------------------------------------------------------------------------
+class _Smem:
+    def __init__(self, nbytes: int):
+        self.b = np.zeros(nbytes, dtype=np.uint8)
+
+    def u16(self):
+        return self.b.view(np.uint16)
+
+    def u32(self):
+        return self.b.view(np.uint32)
+
+
+def swz(cpr: int, r, c):
+    return c ^ ((r >> 1) & 3) if cpr == 4 else c ^ (r & 7)
+
+
+def esw(r, c):
+    return c ^ (r & 7)
+
+
+def raster(pid: int, M: int, NB: int, BM: int, group: int) -> tuple[int, int]:
+    nm = -(-M // BM)
+    per = group * NB
+    first = (pid // per) * group
+    rows = min(nm - first, group)
+    return first + (pid % per) % rows, (pid % per) // rows
+
+
+def kernel(xh: np.ndarray, words: np.ndarray, stride_k: int, stride_nb: int, svh: np.ndarray,
+           bias: np.ndarray | None, out: str, k2: int, lanes: bool, cfg: int, group: int = 8,
+           landing: str = "issue", trace: dict | None = None, fault: str = "") -> np.ndarray:
+    """The fused kernel's output bits [M, N] (every CTA of the grid). ``landing``: "issue" (a cp.async lands when
+    issued: catches slots refilled too early) or "wait" (when its cp.async.wait_group lets it: catches reads before
+    the wait). ``fault`` (tests of the emulator's own sensitivity): "kswap" (the two k8 halves of an A fragment
+    swapped), "tile" (a warp decodes its neighbour's tile), "slot" (the refill overwrites the slot being read), "wait"
+    (the loop waits one group too few), "hsign" (one H fragment's sign), "order" (rest's chain before top's), "split"
+    (the main chain restarted from +0 halfway and the halves added)."""
+
+    M, K = xh.shape
+    N = svh.shape[0]
+    geo = Geo(cfg, k2, lanes)
+    flat = np.ascontiguousarray(words).reshape(-1).view(np.uint32)
+    xbits = np.ascontiguousarray(xh).view(np.uint16)
+    res = np.full((M, N), 0xFFFFFFFF if out == "f32" else 0xFFFF, dtype=np.uint32 if out == "f32" else np.uint16)
+    stored = np.zeros((M, N), dtype=np.int32)
+    NB, nm = N // 128, -(-M // geo.BM)
+    for pid in range(nm * NB):
+        _cta(pid, geo, xbits, flat, stride_k, stride_nb, svh, bias, out, M, K, N, group, landing, res, stored, trace,
+             fault)
+    assert (stored == 1).all(), "every output stored exactly once"
+    return res
+
+
+def _cta(pid, geo: Geo, xbits, flat, stride_k, stride_nb, svh, bias, out, M, K, N, group, landing, res, stored,
+         trace, fault=""):
+    BM, KS, NST, CPR, LDA, MT, NT, TW = geo.BM, geo.KS, geo.NST, geo.CPR, geo.LDA, geo.MT, geo.NT, geo.TW
+    k2 = geo.k2
+    NB, S = N // 128, K // (16 * KS)
+    pm, pn = raster(pid, M, NB, BM, group)
+    m0 = pm * BM
+    sm = _Smem(geo.SMEM)
+    pending: list = []                                       # (group id, dst byte, 16 source bytes)
+    committed = [0]
+
+    def cp_async(dst: int, src16: np.ndarray):
+        assert dst % 16 == 0 and 0 <= dst and dst + 16 <= geo.SMEM
+        if landing == "issue":
+            sm.b[dst:dst + 16] = src16
+        else:
+            pending.append((committed[0], dst, src16.copy()))
+
+    def commit():
+        committed[0] += 1
+
+    def wait(n: int):
+        if landing == "issue":
+            return
+        done = committed[0] - n                              # groups 0 .. done - 1 complete
+        keep = []
+        for gid, dst, data in pending:
+            if gid < done:
+                sm.b[dst:dst + 16] = data
+            else:
+                keep.append((gid, dst, data))
+        pending[:] = keep
+
+    def load_a(s: int):
+        slot = s % NST
+        k0 = s * KS * 16
+        for i in range(BM * CPR):
+            r, c = divmod(i, CPR)
+            ok = m0 + r < M
+            row = m0 + r if ok else 0
+            src = xbits[row, k0 + c * 8:k0 + c * 8 + 8].view(np.uint8) if ok else np.zeros(16, np.uint8)
+            assert (row * K + k0 + c * 8) % 8 == 0               # 16-byte aligned source
+            cp_async(slot * geo.STAGE + (r * LDA + int(swz(CPR, r, c)) * 8) * 2, src)
+
+    def load_w(s: int, slot: int):
+        for i in range(KS * 8 * k2):
+            kk, q = divmod(i, 8 * k2)
+            src = pn * stride_nb + (s * KS + kk) * stride_k + q * 4
+            assert src % 4 == 0
+            cp_async(slot * geo.STAGE + geo.A_BYTES + (kk * 8 * TW + q * 4) * 4, flat[src:src + 4].view(np.uint8))
+
+    def words_of(slot: int) -> np.ndarray:
+        o = (slot * geo.STAGE + geo.A_BYTES) // 4
+        return sm.u32()[o:o + KS * 8 * TW]
+
+    def bbuf(b: int) -> int:
+        return (geo.RING + b * geo.BBUF) // 4                 # uint32 index
+
+    def decode_stage(slot: int, b: int):
+        W = words_of(slot).copy()
+        D = bbuf(b)
+        u32 = sm.u32()
+        for warp in range(geo.NW):
+            if not geo.lanes:
+                for i in range(geo.TPW):
+                    ti = warp * geo.TPW + i
+                    src = (ti + 1) % (KS * 8) if fault == "tile" and warp == 1 else ti
+                    fr = frags_of_states(strips_states(W[src * TW:(src + 1) * TW], k2))    # [32, 4]
+                    u32[D + (ti * 32 + LANE)[:, None] * 4 + np.arange(4)[None, :]] = fr
+            else:
+                for i in range(0, geo.TPW, 2):
+                    ti = warp * geo.TPW + i
+                    kk, j = ti >> 3, ti & 7
+                    st = lanes_pair_states(W[(kk >> 1) * 64 * k2:(kk >> 1) * 64 * k2 + 64 * k2], k2, kk & 1, j)
+                    fr = frags_of_states(st)                                               # [2, 32, 4]
+                    for h in range(2):
+                        u32[D + ((ti + h) * 32 + LANE)[:, None] * 4 + np.arange(4)[None, :]] = fr[h]
+
+    def ldsm4(addrs: np.ndarray) -> np.ndarray:
+        """ldmatrix.x4 (b16): addrs [32] byte addresses (lane 8q + r gives row r of matrix q) -> regs [32, 4]."""
+
+        assert (addrs % 16 == 0).all()
+        out_r = np.zeros((32, 4), dtype=np.uint32)
+        u32 = sm.u32()
+        for q in range(4):
+            rows = addrs[8 * q + G_]                         # lane (g, t) gets row g of matrix q, halves 2t, 2t + 1
+            out_r[:, q] = u32[(rows + 4 * T_) // 4]
+        return out_r
+
+    acc = [[[np.zeros((32, 4), dtype=np.float32) for _ in range(2 * NT)] for _ in range(MT)] for _ in range(geo.NW)]
+    split_at: dict = {}
+
+    load_w(0, NST - 1)
+    commit()
+    for s in range(NST - 1):
+        if s < S:
+            load_a(s)
+        if s + 1 < S:
+            load_w(s + 1, s)
+        commit()
+    wait(NST - 1)
+    decode_stage(NST - 1, 0)
+    for s in range(S):
+        wait(NST - 1 if fault == "wait" else NST - 2)
+        f = s + NST - 1
+        if f < S:
+            load_a(f)
+        if f + 1 < S:
+            load_w(f + 1, s % NST if fault == "slot" else f % NST)
+        commit()
+        if s + 1 < S:
+            decode_stage(s % NST, (s + 1) & 1)
+        abase = (s % NST) * geo.STAGE
+        D = bbuf(s & 1)
+        u32 = sm.u32()
+        for warp in range(geo.NW):
+            wm, wn = divmod(warp, geo.WN)
+            for kk in range(KS):
+                af = []
+                for mt in range(MT):
+                    r = (wm * MT + mt) * 16 + (LANE & 15)
+                    hk = (1 - (LANE >> 4)) if fault == "kswap" and s == 0 and kk == 0 else (LANE >> 4)
+                    af.append(ldsm4(abase + (r * LDA + swz(CPR, r, 2 * kk + hk) * 8) * 2))
+                for nt in range(NT):
+                    bb = u32[D + ((kk * 8 + wn * NT + nt) * 32 + LANE)[:, None] * 4 + np.arange(4)[None, :]]
+                    for mt in range(MT):
+                        a = acc[warp][mt]
+                        if fault == "split" and s == S // 2 and kk == 0:
+                            split_at.setdefault((warp, mt, nt), (a[2 * nt].copy(), a[2 * nt + 1].copy()))
+                            a[2 * nt] = np.zeros_like(a[2 * nt])
+                            a[2 * nt + 1] = np.zeros_like(a[2 * nt + 1])
+                        a[2 * nt] = mma_frag(a[2 * nt], af[mt], bb[:, 0:2], False)
+                        a[2 * nt + 1] = mma_frag(a[2 * nt + 1], af[mt], bb[:, 2:4], False)
+                        if trace is not None:
+                            trace.setdefault("mma", 0)
+                            trace["mma"] += 2
+    wait(0)
+    assert not pending
+    for (warp, mt, nt), (p0, p1) in split_at.items():
+        acc[warp][mt][2 * nt] = (acc[warp][mt][2 * nt] + p0).astype(np.float32)
+        acc[warp][mt][2 * nt + 1] = (acc[warp][mt][2 * nt + 1] + p1).astype(np.float32)
+
+    # epilogue rounds
+    u16 = sm.u16()
+    et, er = 0, geo.EPR * 128                                # bf16 element offsets of the two planes
+    H_P = _had_base()
+    for rnd in range(geo.WM):
+        for warp in range(geo.NW):
+            wm, wn = divmod(warp, geo.WN)
+            if wm != rnd:
+                continue
+            for mt in range(MT):
+                for j in range(2 * NT):
+                    col = 16 * (wn * NT + (j >> 1)) + 8 * (j & 1) + 2 * T_
+                    for hh in range(2):
+                        c0, c1 = acc[warp][mt][j][:, 2 * hh], acc[warp][mt][j][:, 2 * hh + 1]
+                        t0, t1 = bf16_rne(c0), bf16_rne(c1)
+                        r0 = bf16_rne((c0 - bf16f(t0)).astype(np.float32))
+                        r1 = bf16_rne((c1 - bf16f(t1)).astype(np.float32))
+                        row = mt * 16 + G_ + 8 * hh
+                        at = row * 128 + esw(row, col >> 3) * 8 + (col & 7)
+                        assert (at % 2 == 0).all()
+                        u16[et + at], u16[et + at + 1] = t0, t1
+                        u16[er + at], u16[er + at + 1] = r0, r1
+        for warp in range(geo.NW):
+            wm, wn = divmod(warp, geo.WN)
+            if wm != rnd:
+                continue
+            part = wn % geo.NSPLIT
+            for gi in range(geo.GPW):
+                grp = (wn // geo.NSPLIT) * geo.GPW + gi
+                y = [np.zeros((32, 4), dtype=np.float32) for _ in range(geo.EN8)]
+                for q in range(16):
+                    kb = q & 7
+                    row = grp * 16 + (LANE & 15)
+                    plane = (et if q < 8 else er) if fault != "order" else (er if q < 8 else et)
+                    af = ldsm4((plane + row * 128 + esw(row, 2 * kb + (LANE >> 4)) * 8) * 2)
+                    for e in range(geo.EN8):
+                        hf = _had_frag(H_P, kb, part * geo.EN8 + e)
+                        if fault == "hsign" and kb == 3 and part * geo.EN8 + e == 5:
+                            hf = hf ^ np.uint32(0x80000000)
+                        y[e] = mma_frag(y[e], af, hf, True)
+                for e in range(geo.EN8):
+                    col = pn * 128 + 8 * (part * geo.EN8 + e) + 2 * T_
+                    for hh in range(2):
+                        row = m0 + wm * geo.EPR + grp * 16 + G_ + 8 * hh
+                        ok = row < M
+                        if not ok.any():
+                            continue
+                        rr, cc = row[ok], col[ok]
+                        y0, y1 = y[e][ok, 2 * hh], y[e][ok, 2 * hh + 1]
+                        b0 = None if bias is None else bias[cc]
+                        b1 = None if bias is None else bias[cc + 1]
+                        v0 = finish(y0, svh[cc], b0)
+                        v1 = finish(y1, svh[cc + 1], b1)
+                        res[rr, cc] = cast(v0, out)
+                        res[rr, cc + 1] = cast(v1, out)
+                        stored[rr, cc] += 1
+                        stored[rr, cc + 1] += 1
+
+
+def _had_base() -> np.ndarray:
+    lo = np.where(np.array([int(v).bit_count() & 1 for v in (2 * T_) & G_]) == 1, 0xBF80, 0x3F80)
+    hi = np.where(np.array([int(v).bit_count() & 1 for v in (2 * T_ + 1) & G_]) == 1, 0xBF80, 0x3F80)
+    return (lo | (hi << 16)).astype(np.uint32)
+
+
+def _had_frag(P: np.ndarray, kb: int, nb: int) -> np.ndarray:
+    s = 0x80008000 if (kb & (nb >> 1)).bit_count() & 1 else 0
+    b0 = P ^ np.uint32(s)
+    b1 = b0 ^ np.uint32(0x80008000 if nb & 1 else 0)
+    return np.stack([b0, b1], axis=1).astype(np.uint32)
+
+
+# -- index-level checks (no numerics; real sizes) -------------------------------------------------------------------
+def store_map(M: int, N: int, cfg: int, group: int) -> np.ndarray:
+    """How many times the kernel's epilogue stores each output (raster x rounds x units x lanes)."""
+
+    geo = Geo(cfg, 10, False)
+    NB = N // 128
+    cnt = np.zeros((M, N), dtype=np.int32)
+    seen = set()
+    for pid in range(-(-M // geo.BM) * NB):
+        pm, pn = raster(pid, M, NB, geo.BM, group)
+        assert (pm, pn) not in seen
+        seen.add((pm, pn))
+        m0 = pm * geo.BM
+        for warp in range(geo.NW):
+            wm, wn = divmod(warp, geo.WN)
+            part = wn % geo.NSPLIT
+            for gi in range(geo.GPW):
+                grp = (wn // geo.NSPLIT) * geo.GPW + gi
+                for e in range(geo.EN8):
+                    col = pn * 128 + 8 * (part * geo.EN8 + e) + 2 * T_
+                    for hh in range(2):
+                        row = m0 + wm * geo.EPR + grp * 16 + G_ + 8 * hh
+                        ok = row < M
+                        np.add.at(cnt, (row[ok], col[ok]), 1)
+                        np.add.at(cnt, (row[ok], col[ok] + 1), 1)
+    assert len(seen) == -(-M // geo.BM) * NB
+    return cnt
+
+
+def bank_conflicts_ldsm(geo: Geo) -> int:
+    """The most 16-byte units an ldmatrix phase (8 rows) of the main loop shares a bank group with (1 = free)."""
+
+    worst = 1
+    for kk in range(geo.KS):
+        for mt in range(geo.MT):
+            for wm in range(geo.WM):
+                r = (wm * geo.MT + mt) * 16 + (LANE & 15)
+                addr = (r * geo.LDA + swz(geo.CPR, r, 2 * kk + (LANE >> 4)) * 8) * 2
+                for q in range(4):
+                    units = (addr[8 * q:8 * q + 8] // 16) % 8
+                    worst = max(worst, int(np.bincount(units).max()))
+    return worst
+
+
+def fmt_unpack_bits(trellis: np.ndarray) -> np.ndarray:
+    from tensorfold.cuda.exl3 import format as fmt
+
+    return fmt.unpack(trellis, fmt.bits_of(trellis.shape), "mul1").view(np.uint16)
+
+
+def words_of_trellis(trellis: np.ndarray, layout: str) -> tuple[np.ndarray, int, int]:
+    """(words uint32, stride_k, stride_nb) of an int16 trellis [K/16, N/16, 16 bits] in upstream's layouts."""
+
+    kt, nt, w16 = trellis.shape
+    tw = w16 // 2
+    words = np.ascontiguousarray(trellis).view(np.uint32).reshape(kt, nt, tw)
+    if layout == "stored":
+        return words.copy(), (nt) * tw, 8 * tw
+    strips = np.ascontiguousarray(words.reshape(kt, nt // 8, 8, tw).transpose(1, 0, 2, 3))
+    if layout == "lanes":
+        import dsv41_dense3_emu as E3
+
+        strips = E3.to_lanes(strips, w16 // 8)
+    return strips, 8 * tw, kt * 8 * tw
+
+
+__all__ = ["CFGS", "Geo", "bank_conflicts_ldsm", "fmt_unpack_bits", "kernel", "kernel_wq", "reference",
+           "store_map", "words_of_trellis"]
