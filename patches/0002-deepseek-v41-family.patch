+def test_prepared_folder_to_gpu(kshape, tmp_path):
+    from tensorfold.families.deepseek_v41.cuda import fastboot as FB
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+
+    root, cfg, _ = kshape
+    tree = W.Loader(cfg, W.Shards(root), 0, 2, DEV).load(4)
+    key = FB.weights_key(root, 0, 2)
+    d = FB.folder(tmp_path, key)
+    FB.save(tree, d, key)
+    back, st = FB.read(d, DEV)
+    assert st["chunks"] >= 1 and back.layers[2].moe.w1.trellis.is_cuda
+    assert torch.equal(back.layers[2].moe.w1.trellis, tree.layers[2].moe.w1.trellis)
+    assert torch.equal(back.embed, tree.embed) and back.nbytes() == tree.nbytes()
