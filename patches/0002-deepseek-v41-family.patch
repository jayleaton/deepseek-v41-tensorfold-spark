@@ -0,0 +1,164 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G15b: m2bench's fair multi-stream numbers (``m2bench.steady`` / ``concurrent`` / ``cell``), on the CPU with a fake
+batch: the steady aggregate counts only the span where every stream is live (a mixed cell's tail, the slowest stream
+alone, is left out), same-workload cells cycle one workload, ``--c-reps`` reports medians."""
+
+from __future__ import annotations
+
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from tensorfold.families.deepseek_v41.cuda import m2bench as M
+
+
+def _clock(times):
+    c = M.Clock()
+    c.times, c.toks = list(times), list(range(len(times)))
+    return c
+
+
+def test_steady_leaves_out_the_tail():
+    fast = _clock([1.0 + 0.01 * i for i in range(101)])           # 100 tokens a second, 1.0 .. 2.0 s
+    slow = _clock([1.1 + 0.04 * i for i in range(101)])           # 25 tokens a second, 1.1 .. 5.1 s
+    st = M.steady([fast, slow])
+    assert st["all_live_s"] == pytest.approx(0.9)
+    assert st["per_stream_steady_tok_s"][0] == pytest.approx(100.0, rel=0.02)
+    assert st["per_stream_steady_tok_s"][1] == pytest.approx(25.0, rel=0.06)
+    assert st["steady_tok_s"] == pytest.approx(125.0, rel=0.03)
+    # the old decode aggregate: 202 tokens over 4.1 s, mostly the slow stream alone
+    assert 202 / 4.1 < 0.4 * st["steady_tok_s"]
+    assert M.steady([fast])["steady_tok_s"] is None
+    assert M.steady([fast, _clock([3.0, 3.1])])["steady_tok_s"] is None     # never all live together
+
+
+class _Batch:
+    """``submit`` / ``collect`` of ``batch.Batcher``: each job emits its tokens at its workload's rate."""
+
+    RATE = {"code": 0.004, "prose": 0.010, "tweet": 0.003, "edit": 0.003}
+
+    def __init__(self):
+        self.seen = []
+
+    def submit(self, job):
+        self.seen.append(job)
+        return job
+
+    def collect(self, job, cb):
+        gap = self.RATE[job.kind]
+        for _ in range(job.max_tokens):
+            time.sleep(gap)
+            cb([1])
+        job.stats = {"drafting": {"windows": job.max_tokens}}
+
+
+@pytest.fixture
+def fake(monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda import batch
+
+    def job(ids, n, smp):
+        return SimpleNamespace(kind=ids[0], max_tokens=n, sampling=smp, stats={})
+
+    monkeypatch.setattr(batch, "Job", job)
+    wl = {k: (k, 40) for k in ("code", "prose", "tweet", "edit")}
+    return _Batch(), (lambda msg: [msg]), wl
+
+
+def test_concurrent_same_workload_and_mixed(fake):
+    b, ids, wl = fake
+    mixed = M.concurrent(b, ids, wl, 2, "hot", "mixed")
+    assert mixed["workloads"] == ["code", "prose"] and [j.sampling for j in b.seen] == [None, "hot"]
+    assert mixed["steady_tok_s"] > mixed["decode_aggregate_tok_s"]            # the prose tail is left out
+    assert 0.0 < mixed["all_live_frac"] < 0.8
+    b.seen.clear()
+    same = M.concurrent(b, ids, wl, 4, "hot", "greedy", order=("code",))
+    assert same["workloads"] == ["code"] * 4 and [j.kind for j in b.seen] == ["code"] * 4
+    assert same["all_live_frac"] > 0.6 and len(same["per_stream_steady_tok_s"]) == 4
+
+
+def test_cell_reps_report_medians(fake):
+    b, ids, wl = fake
+    c = M.cell(b, ids, wl, 2, "hot", "mixed", 3, ("prose",))
+    assert len(c["reps"]) == 3
+    for k in M.HEAD:
+        vals = sorted(r[k] for r in c["reps"])
+        assert c[k] == pytest.approx(vals[1], abs=0.01)
+    one = M.cell(b, ids, wl, 2, "hot", "mixed", 1)
+    assert "reps" not in one and one["steady_tok_s"] is not None
+
+
+def test_cli_knobs():
+    import argparse
+
+    seen = {}
+
+    def fake_parse(self, argv=None):
+        seen["actions"] = {a.dest for a in self._actions}
+        raise SystemExit(0)
+
+    orig = argparse.ArgumentParser.parse_args
+    argparse.ArgumentParser.parse_args = fake_parse
+    try:
+        with pytest.raises(SystemExit):
+            M.main([])
+    finally:
+        argparse.ArgumentParser.parse_args = orig
+    assert {"c_same", "c_reps", "streams", "c_sampling"} <= seen["actions"]
+
+
+def test_serial_check_per_stream(fake):
+    b, ids, wl = fake
+    cells = {"C2": M.concurrent(b, ids, wl, 2, "hot", "mixed"),
+             "C2-code": M.cell(b, ids, wl, 2, "hot", "mixed", 2, ("code",))}
+    assert cells["C2"]["keys"] == [["code", "t0", 40], ["prose", "t07", 40]]
+    calls = []
+
+    def generate(p, n, smp, cb, draft=True):
+        calls.append((p[0], smp, draft))
+        cb([1] * n)                                             # the fake's streams emit n ones: equal
+        return {}
+
+    b.generate = generate
+    assert M.serial_check(b, ids, wl, "hot", cells) is True
+    assert cells["C2"]["exact"] == [True, True] and cells["C2-code"]["exact"] == [True, True]
+    assert set(calls) == {("code", None, False), ("prose", "hot", False), ("code", "hot", False)} and len(calls) == 3
+    cells["C2-code"]["reps"][0]["reply_sha"][1] = "x"          # one run of one stream differs
+    assert M.serial_check(b, ids, wl, "hot", cells) is False and cells["C2-code"]["exact"] == [True, False]
+
+
+def test_distinct_same_workload_cells(fake):
+    """G17 ``--c-distinct``: C4-code runs four different code prompts (C4-code without it: one prompt four times,
+    two identical pairs under mixed sampling); the extra prompts are workloads but not timed alone."""
+
+    b, ids, wl = fake
+    assert M.distinct("code") == ("code", "code2", "code3", "code4")
+    assert M.distinct("prose") == ("prose", "prose2", "prose3", "prose4")
+    assert M.distinct("tweet") == ("tweet",)
+    full = M.workloads("x")
+    assert set(M.EXTRA) <= set(full) and len({full[w][0] for w in M.distinct("code")}) == 4
+    for w in M.EXTRA:
+        wl[w] = (w[:-1], 40)                    # the fake batch keys its rate on the prompt
+    c = M.concurrent(b, ids, wl, 4, "hot", "mixed", order=M.distinct("code"))
+    assert c["workloads"] == ["code", "code2", "code3", "code4"]
+    assert c["keys"] == [["code", "t0", 40], ["code2", "t07", 40], ["code3", "t0", 40], ["code4", "t07", 40]]
+
+
+def test_cli_distinct_flag():
+    import argparse
+
+    seen = {}
+
+    def fake_parse(self, argv=None):
+        seen["actions"] = {a.dest for a in self._actions}
+        raise SystemExit(0)
+
+    orig = argparse.ArgumentParser.parse_args
+    argparse.ArgumentParser.parse_args = fake_parse
+    try:
+        with pytest.raises(SystemExit):
+            M.main([])
+    finally:
+        argparse.ArgumentParser.parse_args = orig
+    assert "c_distinct" in seen["actions"]
