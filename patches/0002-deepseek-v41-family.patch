+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""CSA2's row writers: the kv-source compressors (ratio 2 pooling / ratio 1), the compressed-KV and SWA row stores,
+and the indexer key store.
+
+Math (vLLM ``deepseek_v41/compressor.py`` + ``fused_compress_quant_cache.py`` + ``indexer_k_store.py``, Apache-2.0;
+our arithmetic, our kernels):
+
+- ratio 2 (layers 2, 8, 14): a group closes at odd position q and pools rows q - 1, q of the fp32 projection
+  [kv | score] (1,024 wide): pooled_d = sum_i kv_i,d softmax_i(score_i,d) (a softmax over the 2 rows per dim);
+  ratio 1 (layer 20): pooled = kv (512 wide). Then latent = bf16(RMSNorm(pooled) * w) (eps 1e-20, mean over 512).
+- the compressed row: RoPE (GPT-J pairs, last 64 dims) at the group's first position (q // r * r, the
+  compress-RoPE table: YaRN x16, theta 160,000) of the bf16 latent, stored as ``rows`` records;
+- the SWA row of every layer: the same store from kv_norm(wkv x) at the token's own position, into the slot's ring;
+- the indexer key (kv-source layers): k = bf16(RMSNorm(wk(latent)) * w_k), RoPE on its last 64 of 128 dims at the
+  group's first position, rounded to bf16 and stored bf16 (128 wide: the keys decide the selection, so they stay
+  bf16 as GLM's index keys do).
+
+Window handling: the caller passes the window's projection rows with ONE leading carry row (the previous step's last
+row, position P - 1), so the pair of a group closing at q sits at buffer rows (q - P, q - P + 1). After a round the
+carry is the projection row of the last accepted position (row-invariant, so the window's own row). Snapshots sit on
+even positions (a 16-token grid), where no group is open: no carry is ever stored.
+
+Every program handles one row: nothing depends on other rows of the window (row invariance by construction).
+
+Row mode (``ROWS``, the slot-agnostic CUDA graphs: ``rowtab.py``): one launch over the rows of several slots. POS
+is then each row's position (int64 [n]) and SL each row's slot (int64 [n]; -1: a padding row, which writes
+nothing); an SWA row lands at ``SL * RING + q % RING`` of the slots' stacked rings, a compressed row / index key
+through the slot's row of the stacked page tables (``PT + SL * PTS``); ratio 2 pools ``BUF[PREV[r]]`` (the slot's
+carry or the row before) with ``BUF[OFF + r]``. The arithmetic of a row is the per-segment launch's: only the
+addresses come from the tables.
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+from .. import pdl as P
+from ..pdl import gdc_launch_dependents, gdc_wait
+from . import rows as R
+
+EPS = 1e-20
+
+
+@triton.jit
+def _pool_norm(BUF, b_stride, W, LAT, POS, n, EPS: tl.constexpr, RATIO: tl.constexpr, SL=None, PREV=None, OFF=0,
+               ROWS: tl.constexpr = False, PDL: tl.constexpr = False, CARRY=None, c_stride=0,
+               SPLIT: tl.constexpr = False):
+    """Program r (window row at position P + r): if a group closes there, LAT[r] = bf16(RMSNorm(pooled) * W).
+    BUF rows: [carry, row 0, row 1, ...] (ratio 2; fp32 [*, 1024]) or [row 0, ...] (ratio 1; fp32 [*, 512]).
+    ROWS: q = POS[r]; padding rows (SL[r] < 0) skip; ratio 2 pools BUF[PREV[r]] with BUF[OFF + r].
+    SPLIT (``branches``: no concatenation launch): BUF holds only the rows (fp32 or bf16: loads widen exactly) and
+    the carries are CARRY's rows; [carries | rows] index i is CARRY[i] below OFF (row mode: OFF carries; else the
+    one carry, OFF = 1), else BUF[i - OFF]: the values the concatenated buffer held."""
+
+    if PDL:                                   # G10 (pdl.py, TF_DSV41_PDL): wait for the kernels before, then
+        gdc_wait()                            # let the next launch start its prologue
+        gdc_launch_dependents()
+    r = tl.program_id(0)
+    if ROWS:
+        if tl.load(SL + r) < 0:
+            return
+        q = tl.load(POS + r).to(tl.int32)
+    else:
+        q = tl.load(POS) + r
+    d = tl.arange(0, 512)
+    if RATIO == 2:
+        if (q + 1) % 2 != 0:
+            return
+        if SPLIT:
+            if ROWS:
+                i = tl.load(PREV + r).to(tl.int64)
+            else:
+                i = r.to(tl.int64)                           # [carry | rows]: row r - 1 is index r
+            hit = i < OFF                                    # position q - 1 is a carry
+            ca = CARRY + tl.where(hit, i, 0) * c_stride
+            ra = BUF + tl.where(hit, 0, i - OFF) * b_stride
+            b = BUF + r.to(tl.int64) * b_stride
+            ka = tl.where(hit, tl.load(ca + d).to(tl.float32), tl.load(ra + d).to(tl.float32))
+            sa = tl.where(hit, tl.load(ca + 512 + d).to(tl.float32), tl.load(ra + 512 + d).to(tl.float32))
+        else:
+            if ROWS:
+                a = BUF + tl.load(PREV + r).to(tl.int64) * b_stride
+                b = BUF + (OFF + r).to(tl.int64) * b_stride
+            else:
+                a = BUF + r.to(tl.int64) * b_stride         # position q - 1 (row r - 1 of the window, or the carry)
+                b = a + b_stride                             # position q
+            ka = tl.load(a + d).to(tl.float32)
+            sa = tl.load(a + 512 + d).to(tl.float32)
+        kb = tl.load(b + d).to(tl.float32)
+        sb = tl.load(b + 512 + d).to(tl.float32)
+        peak = tl.maximum(sa, sb)
+        wa = tl.exp(sa - peak)
+        wb = tl.exp(sb - peak)
+        pooled = (ka * wa + kb * wb) / (wa + wb)
+    else:
+        pooled = tl.load(BUF + (OFF + r).to(tl.int64) * b_stride + d).to(tl.float32)
+    var = tl.sum(pooled * pooled, 0) / 512.0
+    y = pooled * tl.rsqrt(var + EPS) * tl.load(W + d).to(tl.float32)
+    tl.store(LAT + r.to(tl.int64) * 512 + d, y.to(tl.bfloat16))
+
+
+def pool_norm(buf: torch.Tensor, weight: torch.Tensor, pos: torch.Tensor, n: int, ratio: int,
+              out: torch.Tensor, *, slots=None, prev=None, carry=None) -> torch.Tensor:
+    """buf fp32 [n + 1, 1024] (ratio 2, carry first) or [n, 512] (ratio 1); out bf16 [n, 512] (rows where no group
+    closes are left as they are). ``pos`` int32 [1] on the device: the window's first position.
+
+    Row mode (``slots`` int64 [n], -1 = padding; ``pos`` int64 [n]): buf is [carries..., row 0, ...] with the rows
+    last (OFF = buf rows - n), ``prev`` int64 [n] (ratio 2) each row's previous row in buf.
+
+    ``carry`` (ratio 2; ``branches``): buf is the window's rows alone, fp32 or bf16 [n, 1024], and ``carry`` fp32 the
+    carries ([S, 1024] in row mode, ``prev`` indexing [carries | rows]; else the slot's one carry [1024] or [1, 1024]):
+    the same values as the concatenation, without its launch. bf16 rows (any mode) load widened: the values of
+    their fp32 copy."""
+
+    if carry is not None:
+        return _pool_split(buf, weight, pos, n, ratio, out, slots, prev, carry)
+    if ratio not in (1, 2) or buf.dtype not in (torch.float32, torch.bfloat16) or buf.stride(1) != 1:
+        raise ValueError("pool_norm: fp32 / bf16 rows, ratio 1 or 2")
+    rows = slots is not None
+    if buf.shape[1] != 512 * ratio or buf.shape[0] < n + (ratio == 2 and not rows):
+        raise ValueError(f"pool_norm: buf {tuple(buf.shape)} for {n} rows at ratio {ratio}")
+    if rows and ratio == 2 and prev is None:
+        raise ValueError("pool_norm: row mode at ratio 2 needs each row's previous row (prev)")
+    rk = dict(SL=slots, PREV=prev if prev is not None else slots, OFF=buf.shape[0] - n, ROWS=True) if rows else {}
+    _pool_norm[(n,)](buf, buf.stride(0), weight, out, pos, n, EPS=EPS, RATIO=ratio, num_warps=4, **rk, **P.triton_kw())
+    return out
+
+
+def _pool_split(buf, weight, pos, n, ratio, out, slots, prev, carry) -> torch.Tensor:
+    rows = slots is not None
+    carry = carry.view(1, -1) if carry.dim() == 1 else carry
+    if ratio != 2 or buf.dtype not in (torch.float32, torch.bfloat16) or buf.stride(1) != 1 or \
+            carry.dtype != torch.float32 or carry.stride(1) != 1:
+        raise ValueError("pool_norm: a carry at ratio 2, fp32 / bf16 rows, fp32 carries, unit-stride columns")
+    if buf.shape[1] != 1024 or carry.shape[1] != 1024 or buf.shape[0] < n or (not rows and carry.shape[0] != 1):
+        raise ValueError(f"pool_norm: rows {tuple(buf.shape)} and carries {tuple(carry.shape)} for {n} rows")
+    if rows and prev is None:
+        raise ValueError("pool_norm: row mode at ratio 2 needs each row's previous row (prev)")
+    rk = {"SL": slots, "PREV": prev, "ROWS": True} if rows else {}
+    _pool_norm[(n,)](buf, buf.stride(0), weight, out, pos, n, EPS=EPS, RATIO=2, num_warps=4, OFF=carry.shape[0],
+                     CARRY=carry, c_stride=carry.stride(0), SPLIT=True, **rk, **P.triton_kw())
+    return out
+
+
+def _row_paging(page_table, page_shift, slots) -> dict:
+    """Kernel arguments of the paging (a slot's table, or in row mode the slots' stacked tables [S, pages]) and of
+    row mode (``slots``)."""
+
+    pg = {}
+    if page_table is not None:
+        pg = dict(PT=page_table, PSH=page_shift)
+        if page_table.dim() == 2:
+            if slots is None:
+                raise ValueError("stacked page tables [S, pages] need row mode (slots)")
+            pg["PTS"] = page_table.stride(0)
+    if slots is not None:
+        pg.update(SL=slots, ROWS=True)
+    return pg
+
+
+@triton.jit
+def _kv_store(LAT, l_stride, CS, cs_stride, V, S, v_stride, s_stride, POS, RATIO: tl.constexpr, RING: tl.constexpr,
+              PT=None, PSH: tl.constexpr = 0, SL=None, PTS=0, ROWS: tl.constexpr = False, PDL: tl.constexpr = False):
+    """Program r: the row of window row r (position q = P + r). RATIO 0: an SWA row, RoPE at q, ring slot
+    q % RING. RATIO 1 / 2: a compressed row (only where a group closes), RoPE at the group's first position,
+    compressed row q // RATIO (paged through PT / PSH). ROWS: q = POS[r], the slot SL[r] (< 0: no write) picks the
+    ring (SL * RING + q % RING) and the page table row (PT + SL * PTS)."""
+
+    if PDL:                                   # G10 (pdl.py, TF_DSV41_PDL): wait for the kernels before, then
+        gdc_wait()                            # let the next launch start its prologue
+        gdc_launch_dependents()
+    r = tl.program_id(0)
+    if ROWS:
+        sl = tl.load(SL + r)
+        if sl < 0:
+            return
+        q = tl.load(POS + r).to(tl.int32)
+    else:
+        q = tl.load(POS) + r
+    if RATIO == 2:
+        if (q + 1) % 2 != 0:
+            return
+    d = tl.arange(0, 512)
+    x = tl.load(LAT + r.to(tl.int64) * l_stride + d).to(tl.float32)
+    if RATIO == 0:
+        at = q
+        row = (q % RING).to(tl.int64)
+        if ROWS:
+            row += sl.to(tl.int64) * RING
+    else:
+        at = q // RATIO * RATIO
+        if ROWS and PSH > 0:
+            row = R.prow((q // RATIO).to(tl.int64), PT + sl.to(tl.int64) * PTS, PSH, None)
+        else:
+            row = R.prow((q // RATIO).to(tl.int64), PT, PSH, None)
+    c, s = R.cos_sin(CS, at, cs_stride, 256, 32)
+    x = R.rope_pairs(x, c, s, False)
+    R.store_row(V, S, row, x, d, v_stride, s_stride)
+
+
+def kv_store(lat: torch.Tensor, cs: torch.Tensor, values, scales, pos: torch.Tensor, n: int, ratio: int,
+             ring: int = 0, page_table=None, page_shift: int = 0, slots=None) -> None:
+    """Window rows lat bf16 [n, 512] -> FP8 records: ratio 0 into an SWA ring of ``ring`` rows (a power of two),
+    ratio 1 / 2 into the compressed cache (``page_table`` / ``page_shift``: the slot's pages, None = contiguous).
+    Row mode (``slots`` int64 [n], -1 = padding; ``pos`` int64 [n]): the slots' stacked rings / page tables."""
+
+    if ratio == 0 and (ring <= 0 or ring & (ring - 1)):
+        raise ValueError("kv_store: an SWA ring needs a power-of-two size")
+    if values.shape[-1] != R.VB or scales.shape[-1] != R.SB or values.stride(-1) != 1 or scales.stride(-1) != 1:
+        raise ValueError("kv_store: (values [*, 576], scales [*, 8]) uint8, unit-stride columns")
+    pg = _row_paging(page_table, page_shift, slots)
+    _kv_store[(n,)](lat, lat.stride(0), cs, cs.stride(0), values, scales, values.stride(0), scales.stride(0), pos,
+                    RATIO=ratio, RING=max(ring, 1),
+                    num_warps=4, **pg, **P.triton_kw())
+
+
+@triton.jit
+def _index_k(KP, k_stride, W, CS, cs_stride, IK, POS, EPS: tl.constexpr, RATIO: tl.constexpr, PT=None,
+             PSH: tl.constexpr = 0, KFP8: tl.constexpr = False, SL=None, PTS=0, ROWS: tl.constexpr = False,
+             PDL: tl.constexpr = False):
+    """Program r: where a group closes at q = P + r, IK[q // RATIO] = bf16(rope(bf16(RMSNorm(KP[r]) * W))) (KFP8: as
+    the kit's per-token FP8 key, ``rows.store_key``). ROWS: as ``_kv_store``."""
+
+    if PDL:                                   # G10 (pdl.py, TF_DSV41_PDL): wait for the kernels before, then
+        gdc_wait()                            # let the next launch start its prologue
+        gdc_launch_dependents()
+    r = tl.program_id(0)
+    if ROWS:
+        sl = tl.load(SL + r)
+        if sl < 0:
+            return
+        q = tl.load(POS + r).to(tl.int32)
+    else:
+        q = tl.load(POS) + r
+    if RATIO == 2:
+        if (q + 1) % 2 != 0:
+            return
+    d = tl.arange(0, 128)
+    k = tl.load(KP + r.to(tl.int64) * k_stride + d).to(tl.float32)
+    var = tl.sum(k * k, 0) / 128.0
+    k = (k * tl.rsqrt(var + EPS) * tl.load(W + d).to(tl.float32)).to(tl.bfloat16).to(tl.float32)
+    c, s = R.cos_sin(CS, q // RATIO * RATIO, cs_stride, 64, 32)
+    even, odd = tl.split(tl.reshape(k, (64, 2)))
+    ne = (even * c - odd * s).to(tl.bfloat16)
+    no = (odd * c + even * s).to(tl.bfloat16)
+    if ROWS and PSH > 0:
+        row = R.prow((q // RATIO).to(tl.int64), PT + sl.to(tl.int64) * PTS, PSH, None)
+    else:
+        row = R.prow((q // RATIO).to(tl.int64), PT, PSH, None)
+    R.store_key(IK, row, tl.reshape(tl.join(ne, no), (128,)), d, 128, KFP8)
+
+
+def index_k(k_pre: torch.Tensor, weight: torch.Tensor, cs: torch.Tensor, ik: torch.Tensor, pos: torch.Tensor, n: int,
+            ratio: int, page_table=None, page_shift: int = 0, slots=None) -> None:
+    """k_pre bf16 [n, 128] (wk(latent) of the window's rows) -> index keys at compressed rows: bf16 [*, 128], or
+    the kit's per-token FP8 rows uint8 [*, 132] (``TF_DSV41_INDEX_KV=fp8``)."""
+
+    fp8 = ik.dtype == torch.uint8
+    if k_pre.shape[1] != 128 or ik.shape[-1] != (132 if fp8 else 128) or ik.dtype not in (torch.bfloat16, torch.uint8):
+        raise ValueError("index_k: 128-wide keys, bf16 [*, 128] or FP8 uint8 [*, 132]")
+    pg = _row_paging(page_table, page_shift, slots)
+    _index_k[(n,)](k_pre, k_pre.stride(0), weight, cs, cs.stride(0), ik, pos, EPS=EPS, RATIO=ratio, num_warps=1,
+                   KFP8=fp8, **pg, **P.triton_kw())
