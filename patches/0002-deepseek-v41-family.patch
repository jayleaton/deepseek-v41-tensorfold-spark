+# -- DSpark chain -------------------------------------------------------------------------------------------------
+def test_dspark_chain_on_gpu():
+    from tensorfold.engine.exact_sampling import Sampling
+
+    S, N, C, V, D = 64, 5, 128, 3000, 1024
+    g = torch.Generator().manual_seed(3)
+    cand = torch.stack([torch.stack([torch.randperm(V, generator=g)[:C] for _ in range(N)]) for _ in range(S)])
+    cand = cand.to(torch.int32).contiguous()
+    cval = (torch.randn((S, N, C), generator=g) * 3).contiguous()
+    w1 = torch.randn((V, 256), generator=g).to(torch.bfloat16)
+    w2 = (torch.randn((V, 256), generator=g) * 0.1).to(torch.bfloat16)
+    hid = torch.randn((S, N, D), generator=g).to(torch.bfloat16)
+    cw = torch.randn(D + 256, generator=g) * 0.02
+    anchor = torch.randint(0, V, (S,), generator=g, dtype=torch.int32)
+    sams = [None if s % 4 == 0 else Sampling(seed=1000 + s, temperature=0.5 + 0.02 * s, top_k=(0, 20, 50)[s % 3],
+                                            top_p=(1.0, 0.95, 0.8)[s % 3], min_p=0.02 * (s % 2)) for s in range(S)]
+    ip, fp = zip(*[dspark.sampling_params(sm, 5000 + 31 * i) for i, sm in enumerate(sams)])
+    ip, fp = torch.tensor(ip, dtype=torch.int64), torch.tensor(fp, dtype=torch.float32)
+    draft = torch.zeros((S, N), dtype=torch.int32, device=DEV)
+    conf = torch.zeros((S, N), device=DEV)
+    dspark.chain(cand.to(DEV), cval.clone().to(DEV), w1.to(DEV), w2.to(DEV), anchor.to(DEV), ip.to(DEV), fp.to(DEV),
+                 draft, hid=hid.to(DEV), cw=cw.to(DEV), conf=conf)
+    want, wconf = KR.dspark_chain(cand, cval, w1, w2, anchor, ip, fp, hid, cw)
+    bad = [(s, i) for s in range(S) for i in range(N) if int(draft[s, i]) != int(want[s, i])]
+    print(f"\nchain vs host: {len(bad)} of {S * N} drafts differ {bad[:4]}")
+    first = sorted({s for s, _ in bad})
+    assert len(first) <= 1                       # a near-tie in one slot at most (its later drafts follow it)
+    torch.testing.assert_close(conf.cpu(), wconf, rtol=1e-4, atol=1e-5)
+    d1 = torch.zeros((1, N), dtype=torch.int32, device=DEV)
+    dspark.chain(cand[5:6].to(DEV), cval[5:6].clone().to(DEV), w1.to(DEV), w2.to(DEV), anchor[5:6].to(DEV),
+                 ip[5:6].to(DEV), fp[5:6].to(DEV), d1)
+    assert torch.equal(d1[0].cpu(), draft[5].cpu())
+
