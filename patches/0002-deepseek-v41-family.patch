@@ -0,0 +1,203 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G8's slot-agnostic graphs on the CPU (no CUDA, no Triton): the row buckets and keys, the per-row metadata table
+and its padding rule (``rowtab``), the Engram mirror (``rowmode.Mirrored``), the stacked slot state after a pool
+bind (``rowmode.stack``: rings, carries and page tables are views of one tensor each, and the pool writes a slot's
+pages into the stack), and the DSpark pass's padded static inputs (``draft_graphs.DraftInputs``)."""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+from tensorfold.families.deepseek_v41.cuda import rowmode  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import rowtab as RT  # noqa: E402
+
+MIX = [(2, 41, 3), (0, 10, 1), (1, 119, 4)]
+
+
+# -- buckets and keys ------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("n,want", [(1, 1), (5, 5), (8, 8), (9, 12), (12, 12), (13, 16), (17, 24), (25, 32),
+                                    (33, 48), (49, 64), (64, 64), (65, None)])
+def test_bucket_rows(n, want):
+    assert RT.bucket_rows(n) == want
+
+
+def test_bucket_rows_respects_a_lower_cap():
+    assert RT.bucket_rows(20, (1, 2, 4, 8, 16)) is None and RT.bucket_rows(3, (1, 2, 4)) == 4
+
+
+def test_row_key():
+    assert RT.row_key(MIX, 2048, 4096) == (8, 0)
+    assert RT.row_key([(0, 2047, 2), (1, 5, 1)], 2048, 4096) == (3, 1)     # the longest context picks the bucket
+    assert RT.row_key([(3, 0, 16), (1, 0, 16), (2, 0, 16), (0, 0, 16)], 2048, 4096) == (64, 0)
+    for bad in ([], [(0, 0, 2), (0, 9, 1)], [(0, 0, 17)], [(0, 0, 0)], [(0, 4094, 3)],
+                [(s, 0, 16) for s in range(4)] + [(4, 0, 1)]):
+        assert RT.row_key(bad, 2048, 4096) is None, bad
+
+
+def test_bounds():
+    assert RT.bounds(MIX) == [(0, 3), (3, 4), (4, 8)]
+
+
+def test_warm_buckets():
+    assert RT.warm_buckets("decode") == (1, 2, 3, 4, 5, 6, 7, 8)
+    assert RT.warm_buckets("all") == RT.BUCKETS and RT.warm_buckets("none") == ()
+    with pytest.raises(ValueError):
+        RT.warm_buckets("some")
+
+
+# -- the table and its padding ---------------------------------------------------------------------------------------
+def test_plan_rows_columns():
+    ids = list(range(100, 108))
+    t = RT.plan_rows(MIX, ids, 12, carries=4)
+    assert t.shape == (RT.NCOL, 12) and t.dtype == np.int64
+    assert t[RT.IDS, :8].tolist() == ids
+    assert t[RT.POS, :8].tolist() == [41, 42, 43, 10, 119, 120, 121, 122]
+    assert t[RT.RSLOT, :8].tolist() == t[RT.WSLOT, :8].tolist() == [2, 2, 2, 0, 1, 1, 1, 1]
+    # a window's first row pools with its slot's carry (row s of [carries | rows]); the others with the row before
+    assert t[RT.PREV, :8].tolist() == [2, 4 + 0, 4 + 1, 0, 1, 4 + 4, 4 + 5, 4 + 6]
+    assert t[RT.SRC, :8].tolist() == list(range(8))
+
+
+def test_padding_mirrors_the_last_row_and_writes_nothing():
+    t = RT.plan_rows(MIX, list(range(8)), 12, carries=3)
+    for c in (RT.IDS, RT.POS, RT.RSLOT, RT.PREV, RT.SRC):
+        assert (t[c, 8:] == t[c, 7]).all(), RT.COLS[c]
+    assert (t[RT.WSLOT, 8:] == -1).all() and (t[RT.WSLOT, :8] >= 0).all()
+    assert (RT.plan_rows(MIX, list(range(8)), 8, carries=3)[RT.WSLOT] >= 0).all()   # an exact fit: no padding
+
+
+def test_plan_rows_rejects():
+    with pytest.raises(ValueError):
+        RT.plan_rows(MIX, list(range(7)), 8, carries=3)              # ids do not match the rows
+    with pytest.raises(ValueError):
+        RT.plan_rows(MIX, list(range(8)), 6, carries=3)              # more rows than the bucket
+    with pytest.raises(ValueError):
+        RT.plan_rows(MIX, list(range(8)), 8, carries=2)              # slot 2 past the stacked slots
+
+
+def test_row_table_stage_and_views():
+    tab = RT.RowTable(16, "cpu")
+    t = RT.plan_rows(MIX, list(range(8)), 12, carries=3)
+    tab.stage(t)
+    assert torch.equal(tab.dev[:, :12], torch.from_numpy(t))
+    w = tab.win(12, cap=2047)
+    assert w.rows and w.n == 12 and w.last == 2047 and w.t is w.positions
+    assert w.positions.data_ptr() == tab.dev[RT.POS].data_ptr()       # views: the graphs' addresses never move
+    assert w.wslot.tolist() == t[RT.WSLOT].tolist() and w.prev.tolist() == t[RT.PREV].tolist()
+    s = w.sub(4, 9)
+    assert s.n == 5 and s.positions.tolist() == t[RT.POS, 4:9].tolist() and s.last == 2047
+    assert tab.ids(12).tolist() == t[RT.IDS].tolist() and tab.src(12).tolist() == t[RT.SRC].tolist()
+    p = tab.ptr()
+    tab.stage(RT.plan_rows([(0, 3, 2)], [5, 6], 2, carries=3))
+    assert tab.ptr() == p and tab.dev[RT.POS, :2].tolist() == [3, 4]
+    with pytest.raises(ValueError):
+        tab.stage(np.zeros((RT.NCOL, 17), dtype=np.int64))
+
+
+# -- the Engram mirror -----------------------------------------------------------------------------------------------
+class _Gated:
+    """``engram_gate.GatedEngram``'s shape: ``view(n)`` gives the same round over ``n`` rows."""
+
+    def __init__(self, rows, n):
+        self.rows, self.n = rows, n
+
+    def view(self, n):
+        return _Gated(self.rows, n)
+
+    def __getitem__(self, L):
+        return self.rows[L][:self.n]
+
+    def __contains__(self, L):
+        return L in self.rows
+
+    def keys(self):
+        return list(self.rows)
+
+    def __len__(self):
+        return len(self.rows)
+
+
+def test_mirrored_engram_rows():
+    t = RT.plan_rows(MIX, list(range(8)), 12, carries=3)
+    src = torch.from_numpy(t[RT.SRC])
+    staged = torch.arange(12 * 3, dtype=torch.float32).view(12, 3)          # rows past 8: stale
+    m = rowmode.mirrored({1: staged}, 12, src)
+    got = m[1]
+    assert torch.equal(got[:8], staged[:8]) and torch.equal(got[8:], staged[7:8].expand(4, 3))
+    assert 1 in m and m.keys() == {1: 0}.keys() and len(m) == 1
+    g = rowmode.mirrored(_Gated({1: staged}, 8), 12, src)                   # the gate's rows over the graph's rows
+    assert g.inner.n == 12 and torch.equal(g[1], got)
+
+
+# -- the stacked slot state ------------------------------------------------------------------------------------------
+@pytest.fixture(scope="module")
