+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The DSpark pass on static buffers (``DraftInputs``) and its CUDA graphs (``DraftGraphs``), keyed by (slots
+padded, rows, head variant): the verify windows' scheme (``rowgraphs.py``) for the drafter.
+
+- **Static inputs** (``DraftInputs``, one set a key, eager and graphed alike): everything a pass reads that changes
+  between passes lives in two device arenas, staged from two host mirrors (pinned on CUDA) with two non-blocking
+  copies: int64 (block ids, positions, the chain's (seed, POS0, top_k, sampled), each row's read / write slot) and
+  int32 (each window's start, the ``attention_meta`` tables (ring rows, counts, lo, hi), the anchors, the chain's
+  (T, top_p, min_p) as fp32 bits). Outputs: drafts and confidences in one int32 [2, S, N] buffer (one D2H copy).
+- **Slot-agnostic (G8)**: the slots' context rings of a block are one stacked store (``drafter.Drafter.stacked``),
+  so on the Triton kernels a pass is row mode (``csa2.backend.RowWin``): one ``kv_store`` and one attention launch
+  a block over every slot's rows, each row's slot read from the int64 arena and its context list holding absolute
+  rows of the stacked ring (slot x ring + row). The key is the number of slots padded to a power of two
+  (1, 2, 4, ...), not the slots: a padded slot mirrors the pass's first slot and writes nothing (write slot -1); its
+  drafts are dropped. G7's multi-slot passes ran eagerly (graphs were captured for slot 0's keys only).
+- **Safety**: as ``graphs.CudaGraphs``: ``GraphCache``'s budget, its memory floor (``room_for``:
+  TF_DSV41_GRAPH_FLOOR_GIB), its cap (TF_DSV41_DRAFT_GRAPHS_MAX, 32), its all-ranks agreement on every capture and
+  its fallback (a capture failing on a rank turns draft graphs off on both). A fingerprint of the persistent buffers
+  a captured pass touches (the drafter blocks' MoE scratch, the CSA2 attention scratch, the stacked rings, the
+  draft head's tables) is checked before every replay; a change drops every draft graph. Draft graphs use their own
+  memory pool: their outputs are read at once (the drafts' D2H copy), and the verify graphs' pending rows, read at
+  the next commit, never share memory with them.
+- **First use**: a key met without a graph runs eagerly (its drafts are the pass's), then is captured. Boot
+  (``warmup``) captures 1, 2 and 4 padded slots for every head variant (slot 0 at position 0, the rest padding).
+
+Knobs: TF_DSV41_DRAFT_GRAPHS (default TF_DSV41_GRAPHS, 1; 0 = eager passes), TF_DSV41_DRAFT_GRAPHS_MAX (32),
+TF_DSV41_DRAFT_GRAPH_SLOTS (4: passes over more slots, padded, run eagerly).
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+
+import numpy as np
+import torch
+
+from .csa2.backend import RowWin, Win
+from .graphs import PREFILL, GraphCache, env_settings, room_for
+
+F32 = torch.float32
+
+
+def draft_settings(env=None) -> dict:
+    env = os.environ if env is None else env
+    st = env_settings()
+    g = lambda k, d: (env.get(k, "") or "").strip() or d
+    st["on"] = g("TF_DSV41_DRAFT_GRAPHS", "1" if st["on"] else "0") != "0"
+    st["max_graphs"] = int(g("TF_DSV41_DRAFT_GRAPHS_MAX", "32"))
+    return st
+
+
+def pad_slots(n: int) -> int:
+    """A pass's slots padded to a power of two (the draft graphs' key)."""
+
+    return 1 << max(0, int(n) - 1).bit_length()
+
+
+class DraftInputs:
+    """One key's static inputs and outputs (``key`` = (slots padded, rows, variant); the slots tuple itself where
+    the pass is not row mode) for ``drafter.Drafter``. ``rows``: row mode (``RowWin`` over every slot's rows)."""
+
+    def __init__(self, dr, key) -> None:
+        slots, n, _ = key
+        S = slots if isinstance(slots, int) else len(slots)
+        W, dev = dr.window, dr.dev
+        self.key, self.S, self.n, self.W = key, S, n, W
+        self.rows = bool(getattr(dr, "rowmode", False))
+        self.slots: tuple = tuple(range(S)) if isinstance(slots, int) else tuple(slots)
+        self.l64 = [S * n, S * n, S * 4, S * n, S * n]          # ids, positions, ipar, read / write slot a row
+        self.l32 = [S, S * n * W, S * n, S * n, S * n, S, S * 3]  # t, tokens, counts, lo, hi, anchor, fpar
+        pin = torch.device(dev).type == "cuda"
+        self.h64 = torch.zeros((sum(self.l64),), dtype=torch.int64, pin_memory=pin)
+        self.h32 = torch.zeros((sum(self.l32),), dtype=torch.int32, pin_memory=pin)
+        self.d64 = torch.zeros_like(self.h64, device=dev)
+        self.d32 = torch.zeros_like(self.h32, device=dev)
+        v64, v32 = self._split(self.d64, self.l64), self._split(self.d32, self.l32)
+        self.ids, self.positions, self.ipar = v64[0], v64[1], v64[2].view(S, 4)
+        t, tok, cnt, lo, hi, self.anchor, fpar = v32
+        self.fpar = fpar.view(F32).view(S, 3)
+        self.tok_all, self.cnt_all, self.lo_all, self.hi_all = tok.view(S * n, W), cnt, lo, hi
+        tok = tok.view(S, n, W)
+        self.wins = [Win(0, n, t[s:s + 1], self.positions[s * n:(s + 1) * n]) for s in range(S)]
+        self.metas = [(tok[s], cnt[s * n:(s + 1) * n], lo[s * n:(s + 1) * n], hi[s * n:(s + 1) * n])
+                      for s in range(S)]
+        self.rowwin = RowWin(S * n, self.positions, v64[3], v64[4], None, 0) if self.rows else None
+        self.out = torch.zeros((2, S, n), dtype=torch.int32, device=dev)
+        self.draft, self.conf = self.out[0], self.out[1].view(F32)
+        self.scr = torch.empty((S, 2, 128), dtype=torch.float64, device=dev)
+
+    @staticmethod
+    def _split(t, lens):
+        out, a = [], 0
+        for n in lens:
+            out.append(t[a:a + n])
+            a += n
+        return out
+
+    def stage(self, anchors, starts, valids, samplings, noise: int, ring: int, slots=None) -> None:
+        """The pass's values into the host mirrors, then two copies (non-blocking from pinned memory). ``slots``:
+        the pass's slots (default the key's); fewer than the key's padded count: the rest mirror the first slot and
+        write nothing. Row mode: the context lists hold rows of the stacked ring (slot x ``ring`` + row)."""
+
+        from . import dspark
+
+        S, n, W = self.S, self.n, self.W
+        slots = tuple(int(x) for x in (self.slots[:len(anchors)] if slots is None else slots))
+        if not 1 <= len(slots) <= S:
+            raise ValueError(f"a pass over {len(slots)} slots with {S} padded")
+        self.slots = slots
+        h64, h32 = self._split(self.h64.numpy(), self.l64), self._split(self.h32.numpy(), self.l32)
+        ids, pos, ipar = h64[0].reshape(S, n), h64[1].reshape(S, n), h64[2].reshape(S, 4)
+        rsl, wsl = h64[3].reshape(S, n), h64[4].reshape(S, n)
+        t, tok, cnt, lo, hi, anc, fpar = h32
+        tok, fpar = tok.reshape(S, n, W), fpar.view(np.float32).reshape(S, 3)
+        for s in range(S):
+            j = s if s < len(slots) else 0                  # a padded slot mirrors the first one
+            p, a = int(starts[j]), int(anchors[j])
+            ids[s] = noise
+            ids[s, 0] = a
+            pos[s] = np.arange(p, p + n)
+            ip, fp = dspark.sampling_params(samplings[j], p)
+            ipar[s], fpar[s] = ip, fp
+            c0 = max(p - W, int(valids[j]), 0)
+            ctx = np.arange(c0, p, dtype=np.int64) % ring
+            if self.rows:
+                ctx = ctx + slots[j] * ring
+            tok[s] = -1
+            tok[s, :, :ctx.size] = ctx
+            cnt[s * n:(s + 1) * n] = ctx.size
+            lo[s * n:(s + 1) * n] = p
+            hi[s * n:(s + 1) * n] = p + n - 1
+            t[s], anc[s] = p, a
+            rsl[s] = slots[j]
+            wsl[s] = slots[j] if s < len(slots) else -1
+            self.wins[s].p0 = p
+        nb = self.d64.is_cuda
+        self.d64.copy_(self.h64, non_blocking=nb)
+        self.d32.copy_(self.h32, non_blocking=nb)
+
+    def result(self, conf: bool) -> tuple[list[list[int]], list[list[float]] | None]:
+        """The real slots' drafts (and confidences): padded slots are dropped."""
+
+        k = len(self.slots)
+        o = self.out[:, :k].cpu()
+        d = o[0].tolist()
+        return d, (o[1].view(F32).tolist() if conf else None)
+
+
+class DraftGraphs:
+    """Graphs of ``dr`` (``drafter.Drafter``) passes: ``run(inputs, fn)`` replays the key's graph, or runs ``fn``
+    eagerly and captures it for the next time."""
+
+    def __init__(self, dr, *, agree_all=None, agree_any=None, settings: dict | None = None) -> None:
+        st = settings or draft_settings()
+        self.dr = dr
+        self.pool = torch.cuda.graph_pool_handle()
+        self.max_slots = int((os.environ.get("TF_DSV41_DRAFT_GRAPH_SLOTS", "") or "4").strip())
+        self.cache = GraphCache(self._capture, st["budget_s"], st["max_graphs"], st.get("bucket", 2048),
+                                self.max_slots, st["on"], agree_all or (lambda ok: ok), agree_any or (lambda f: f),
+                                room=room_for(float(st.get("floor_gib", 5.0))), prefill_recent=PREFILL.recent)
+        self._pending = None
+
+    def fingerprint(self, key) -> tuple:
+        dr = self.dr
+        parts = [id(getattr(b.moe, "scratch", None)) for b in dr.blocks]
+        parts.append(id(getattr(dr.fw.csa2, "scratch", None)))
+        for st in dr.stacked:                           # every slot's ring of a block: one stacked store
+            parts.append((st.values if hasattr(st, "values") else st.data).data_ptr())
+        h = dr.head
+        parts += [0 if t is None else t.data_ptr() for t in (h.packed, h.scales, h.ids)]
+        return tuple(parts)
+
+    def _capture(self, key):
+        inp, fn = self._pending
+        fn()                                            # every Triton specialisation compiled and loaded first
+        torch.cuda.synchronize()
+        g = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(g, pool=self.pool, capture_error_mode="thread_local"):
+            fn()
+        return g, self.fingerprint(key)
+
+    def run(self, inp: DraftInputs, fn) -> None:
+        key = inp.key
+        S = key[0] if isinstance(key[0], int) else len(key[0])
+        ok = self.cache.on and S <= self.max_slots
+        e = self.cache.get(key) if ok else None
+        if e is not None and e[1] != self.fingerprint(key):
+            print(f"[tensorfold] dsv41 draft graphs: a persistent buffer moved; {len(self.cache.graphs)} dropped "
+                  "(captured again on use)", file=sys.stderr, flush=True)
+            self.cache.drop()
+            e = None
+        if e is not None:
+            e[0].replay()
+            return
+        fn()
+        if ok and self.cache.wants(key):
+            self._pending = (inp, fn)
+            try:
+                self.cache.lazy(key)
+            finally:
+                self._pending = None
+
+    def warmup(self, bos: int = 0) -> int:
+        """Boot: 1, 2 and 4 padded slots (every head variant; slot 0 at position 0, the rest padding), eagerly once
+        then captured; slot 0 reset after. Without row mode (no Triton CSA2): slot 0's keys."""
+
+        dr = self.dr
+        counts = [S for S in (1, 2, 4) if S <= self.max_slots] if dr.rowmode else [(0,)]
+        keys = [(S, dr.rows, v) for v in dr.head.variants() for S in counts]
+
+        def capture_key(key, inner=self._capture):
+            dr.reset(0)
+            inp = dr.inputs(key)
+            inp.stage([bos], [0], [0], [None], dr.noise, dr.ring, slots=(0,))
+            fn = dr.pass_fn(inp, key[2])
+            fn()
+            self._pending = (inp, fn)
+            try:
+                return inner(key)
+            finally:
+                self._pending = None
+
+        real = self.cache.capture
+        self.cache.capture = capture_key
+        try:
+            return self.cache.warmup(keys)
+        finally:
+            self.cache.capture = real
+            dr.reset(0)
+
+    def describe(self) -> str:
+        return "draft " + self.cache.describe()
+
+
+__all__ = ["DraftGraphs", "DraftInputs", "draft_settings", "pad_slots"]
