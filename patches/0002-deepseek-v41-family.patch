index 0000000..dfeb359
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/pctree.py
@@ -0,0 +1,303 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Parent-conditioned draft trees for DSpark (``TF_DSV41_TREE_PC=1`` with ``TF_DSV41_TREE`` >= 2): branches at draft
+positions 1 .. ``TF_DSV41_TREE_DEPTHS``, each child scored by DSpark's Markov head given its own parent (PCTree,
+arXiv 2608.02123; no retraining). ``tree.py`` verifies the result: every leaf's path is a chain window on the slot
+(the main chain) or on a shadow slot, and the round presents the chain with the longest accepted prefix.
+
+**Children.** A pass gives, per draft row i, the base logits of its candidates (``Drafter.last_tree``; the noise
+rows', independent of the drafted tokens) and the Markov head biases them by the previous token only:
+z_i(c | t) = base_i[c] + w2[c] . w1[t]. So the children of any node (token t at depth i) are the keyed order of
+z_i(. | t) (``tree.ranked``: greedy (z desc, id asc), sampled ``choose``'s filters and the keyed Gumbel at the
+child's absolute position), with draft probabilities softmax(z) (T = 1 greedy, the request's T sampled). The main
+chain (the pass's drafts) is the keyed first child of the main path, taken from the kernel's drafts, not recomputed.
+
+**Node values.** A node's value is its path probability (the chance its whole path is the serial continuation):
+the parent's value times the child's conditional chance q:
+
+- a keyed first child: the confidence head given this parent. The head is sigmoid(cw_h . h_i + cw_m . w1[t]) and
+  only the second term depends on the parent, so h-part_i = logit(conf_i) - cw_m . w1[prev_i] from the main chain's
+  confidences and the head's value for any parent t is sigmoid(h-part_i + cw_m . w1[t]); then the depth's
+  calibration of position i (``depth.Calibration`` or ``confcal``);
+- a later child (rank r >= 1): its draft probability times a decayed (kept / summed p) factor per (depth, rank)
+  (``Cal``), learned on both ranks from the serial tokens of every verified tree.
+
+**Selection.** Best-first: a node joins in order of value (a child is never likelier than its parent, so every
+prefix of the order is a tree), the main chain's first draft first; each prefix is priced and the best surplus
+E - rate x ms is kept (``depth.best_k``'s objective; E = 1 + the sum of the nodes' values). Chains: a node whose
+parent already has a child starts a new chain (a shadow slot), at most ``branches`` chains a slot.
+
+**Cost (the expert-union term).** A unique row (a new token at its position) brings new routed experts: its cost is
+the cost table's marginal row (``Costs.rows_ms`` of the unique rows: the measured ~6 ms second row and ~4 ms later
+ones are mostly expert bytes, G9). A new chain re-runs its shared prefix (the pending row and its parent's path) on
+the shadow: the same tokens, positions and context, so the same routing: no new experts, only the dense /
+attention work of a row (``dup_ms``). Each further chain is a further segment of the window (``Costs.slot``). Rows
+off the main chain may share more experts with their siblings than a chain's next row does with its parent: their
+marginal row cost is scaled by ``TF_DSV41_TREE_SIB_EXPERT`` (default 1: priced like chain rows until measured).
+
+Exactness: unchanged from ``tree.py``: every chain is an ordinary chain window, the presented one is decided from
+the window's own keyed choices on both ranks, and every token is the serial token (``dspark.accept``).
+
+Knobs: TF_DSV41_TREE_PC (0 | 1, default 0: ``tree.py``'s first-position siblings), TF_DSV41_TREE_DEPTHS (1-4,
+default 3: the deepest draft position a branch may start at), TF_DSV41_TREE_WIDTH (2-4, default 2: children a node
+may offer), TF_DSV41_TREE_SIB_EXPERT (0-2, default 1).
+"""
+
+from __future__ import annotations
+
+import heapq
+import math
+import os
+from collections.abc import Callable, Sequence
+from dataclasses import dataclass, field
+
+import numpy as np
+
+PRIOR, F_MIN, F_MAX, Q_MAX, DECAY = 2.0, 0.05, 4.0, 0.95, 0.97
+
+
+def settings(env=None) -> dict:
+    env = os.environ if env is None else env
+    pc = (env.get("TF_DSV41_TREE_PC", "") or "0").strip() not in ("0", "off", "false")
+    depths = int((env.get("TF_DSV41_TREE_DEPTHS", "") or "3").strip())
+    width = int((env.get("TF_DSV41_TREE_WIDTH", "") or "2").strip())
+    sib = float((env.get("TF_DSV41_TREE_SIB_EXPERT", "") or "1").strip())
+    if not 1 <= depths <= 4 or not 2 <= width <= 4 or not 0.0 <= sib <= 2.0:
+        raise ValueError("TF_DSV41_TREE_DEPTHS 1-4, TF_DSV41_TREE_WIDTH 2-4, TF_DSV41_TREE_SIB_EXPERT 0-2")
+    return {"pc": pc, "depths": depths, "width": width, "sib_expert": sib}
+
+
+def _logit(p: float) -> float:
+    p = min(max(float(p), 1e-6), 1.0 - 1e-6)
+    return math.log(p / (1.0 - p))
+
+
+def _sigmoid(x: float) -> float:
+    return 1.0 / (1.0 + math.exp(-x)) if x >= 0 else math.exp(x) / (1.0 + math.exp(x))
+
+
+class Cal:
+    """Per (depth, rank >= 1): decayed kept and summed draft probabilities (``tree.SibCal`` by depth)."""
+
+    def __init__(self, depths: int, width: int) -> None:
+        self.kept = [[0.0] * width for _ in range(depths)]
+        self.prob = [[0.0] * width for _ in range(depths)]
+
+    def factor(self, d: int, r: int) -> float:
+        d, r = min(d, len(self.kept) - 1), min(r, len(self.kept[0]) - 1)
+        return min(max((self.kept[d][r] + PRIOR) / (self.prob[d][r] + PRIOR), F_MIN), F_MAX)
+
+    def q(self, d: int, r: int, p: float) -> float:
+        return min(max(float(p), 0.0) * self.factor(d, r), Q_MAX)
+
+    def record(self, d: int, r: int, p: float, kept: bool) -> None:
+        d, r = min(d, len(self.kept) - 1), min(r, len(self.kept[0]) - 1)
+        self.kept[d][r] = self.kept[d][r] * DECAY + float(kept)
+        self.prob[d][r] = self.prob[d][r] * DECAY + max(float(p), 0.0)
+
+
+class Expander:
+    """The draft distribution after any parent at any row of a pass (host, numpy / torch on the CPU)."""
+
+    def __init__(self, w1, w2, cw=None) -> None:
+        self.w1, self.w2 = w1, w2
+        self.mc = None
+        if cw is not None:                          # cw_m . w1[t] for every t: the confidence's parent term
+            r = w1.shape[1]
+            self.mc = (w1.float() @ cw[-r:].float().reshape(-1)).numpy().astype(np.float64)
+
+    def children(self, cand: np.ndarray, base: np.ndarray, i: int, prev: int, position: int, sampling, m: int,
+                 exclude=()) -> list[tuple[int, float]]:
+        from .tree import markov_z, ranked
+
+        z = markov_z(base[i], cand[i], prev, self.w1, self.w2)
+        return ranked(z, cand[i], position, sampling, m, exclude=exclude)
+
+    def hparts(self, conf: Sequence[float], pending: int, main: Sequence[int]) -> list[float] | None:
+        if self.mc is None:
+            return None
+        prev = [int(pending)] + [int(t) for t in main]
+        return [_logit(c) - float(self.mc[prev[i]]) for i, c in enumerate(conf[:len(prev)])]
+
+    def conf(self, hpart: float, parent: int) -> float:
+        return _sigmoid(hpart + float(self.mc[int(parent)]))
+
+
+@dataclass
+class Node:
+    tok: int
+    depth: int                  # 1 = the first draft position
+    parent: int                 # index in the order, -1 = the pending token
+    rank: int                   # 0 = the keyed first child of its parent
+    p: float                    # draft probability (softmax of z)
+    v: float                    # path value
+    main: bool = False          # on the main chain (the pass's drafts)
+    kids: int = 0
+
+
+@dataclass
+class Plan:
+    k: int                                          # main chain drafts
+    chains: list = field(default_factory=list)      # extra chains: (tokens after the pending one, node indices)
+    nodes: list = field(default_factory=list)       # the selected nodes (order)
+    ms: float = 0.0
+    expected: float = 1.0
+
+
+def grow(exp: Expander, cand, base, pending: int, start: int, sampling, main: Sequence[int], conf: Sequence[float],
+         qmain: Callable[[int, float], float], qsib: Callable[[int, int, float], float], *, depths: int, width: int,
+         rows: int, chains: int) -> list[Node]:
+    """The candidate nodes in best-first order (the main chain's first draft first), at most ``rows`` nodes and
+    ``chains`` chains (the main one included)."""
+
+    N = min(cand.shape[0], len(main))
+    hp = exp.hparts(conf, pending, main)
+    order: list[Node] = []
+    heap: list = []
+    seq = 0
+
+    def push(node: Node) -> None:
+        nonlocal seq
+        heapq.heappush(heap, (-node.v, seq, node))
+        seq += 1
+
+    def expand(ix: int) -> None:
+        par = order[ix] if ix >= 0 else None
+        i = 0 if par is None else par.depth          # the row giving the children
+        if i >= N:
+            return
+        tok = int(pending) if par is None else par.tok
+        pv = 1.0 if par is None else par.v
+        on_main = par is None or par.main
+        m = width if i < depths else 1
+        if on_main:
+            first = int(main[i])
+            kids = [(first, None)] + [(t, p) for t, p in exp.children(cand, base, i, tok, start + 1 + i, sampling,
+                                                                      m - 1, exclude=(first,))]
+        else:
+            kids = [(t, p) for t, p in exp.children(cand, base, i, tok, start + 1 + i, sampling, m)]
+        for r, (t, p) in enumerate(kids):
+            if r == 0:
+                c = conf[i] if on_main else (exp.conf(hp[i], tok) if hp is not None else p)
+                q = qmain(i, c)
+            else:
+                q = qsib(i, r, p)
+            if q > 0.0 or (par is None and r == 0):   # the main chain's first draft is always a candidate
+                push(Node(int(t), i + 1, ix, r, 1.0 if p is None else float(p), pv * q, on_main and r == 0))
+
+    expand(-1)
+    n_chains = 0
+    while heap and len(order) < rows:
+        _, _, node = heapq.heappop(heap)
+        if not order and not node.main:             # the main chain's first draft comes first
+            first = next(h for h in heap if h[2].main)
+            heap.remove(first)
+            heapq.heapify(heap)
+            push(node)
+            node = first[2]
+        par = order[node.parent] if node.parent >= 0 else None
+        new = new_chain(node, par, par.kids if par is not None else 0)
+        if new and n_chains + 1 >= chains:
+            continue                                # no shadow left: neither it nor its subtree
+        n_chains += int(new)
+        if par is not None:
+            par.kids += 1
+        order.append(node)
+        expand(len(order) - 1)
+    for o in order:
+        o.kids = 0
+    return order
+
+
+def new_chain(node: Node, par: Node | None, kids: int) -> bool:
+    """A node starts a chain (a shadow window) unless it continues one: the main chain's next draft, or the first
+    child of a node off the main chain."""
+
+    return not node.main and (par is None or par.main or kids > 0)
+
+
+def select(order: Sequence[Node], rows_ms: Callable[[int], float], rate: float, *, least: int = 1,
+           dup_ms: float = 0.4, slot_ms: float = 0.0, sib_expert: float = 1.0, max_rows: int = 16) -> Plan:
+    """The best prefix of ``order`` by E - rate x ms (module docstring); -> ``Plan``."""
+
+    kids = [0] * len(order)
+    e, n_main, n_other, extra, dups = 1.0, 0, 0, 0, 0
+    best: tuple | None = None
+    for n in range(len(order) + 1):
+        if n:
+            nd = order[n - 1]
+            par = order[nd.parent] if nd.parent >= 0 else None
+            if new_chain(nd, par, kids[nd.parent] if par is not None else 0):
+                extra += 1                          # the pending row and the parent's path again, on a shadow
+                dups += 1 + (0 if par is None else par.depth)
+            if par is not None:
+                kids[nd.parent] += 1
+            e += nd.v
+            n_main += int(nd.main)
+            n_other += int(not nd.main)
+        if 1 + n + dups > max_rows:
+            break
+        if n < least:
+            continue
+        a = rows_ms(1 + n_main)
+        ms = a + sib_expert * (rows_ms(1 + n) - a) + dup_ms * dups + slot_ms * extra
+        s = e - rate * ms
+        if best is None or s > best[0] + 1e-12:
+            best = (s, n, ms, e)
+    if best is None:
+        return Plan(0)
+    _, n, ms, e = best
+    sel = list(order[:n])
+    return Plan(sum(1 for o in sel if o.main), chains_of(sel), sel, ms, e)
+
+
+def chains_of(nodes: Sequence[Node]) -> list[tuple[list[int], list[int]]]:
+    """The extra chains of a selected tree: every leaf off the main chain's path, as (tokens from depth 1, node
+    indices), in order of the leaves."""
+
+    has_kid = [False] * len(nodes)
+    for nd in nodes:
+        if nd.parent >= 0:
+            has_kid[nd.parent] = True
+    out = []
+    for ix, nd in enumerate(nodes):
+        if has_kid[ix] or nd.main:
+            continue
+        path, j = [], ix
+        while j >= 0:
+            path.append(j)
+            j = nodes[j].parent
+        path.reverse()
+        out.append(([nodes[j].tok for j in path], path))
+    return out
+
+
+def accepted_len(tokens: Sequence[int], chosen: Sequence[int]) -> int:
+    """Drafts kept of a chain window [pending, d_1 ..] whose rows chose ``chosen``."""
+
+    a = 0
+    for d, c in zip(tokens[1:], chosen):
+        if int(d) != int(c):
+            break
+        a += 1
+    return a
+
+
+def learn(cal: Cal, nodes: Sequence[Node], serial: Sequence[int]) -> None:
+    """Every selected later child (rank >= 1) whose parent's path is the serial prefix: kept iff its token is the
+    serial token at its depth. ``serial``: the round's committed tokens after the pending one."""
+
+    for ix, nd in enumerate(nodes):
+        if nd.rank < 1 or nd.depth > len(serial):
+            continue
+        path, j = [], nd.parent
+        while j >= 0:
+            path.append(nodes[j].tok)
+            j = nodes[j].parent
+        path.reverse()
+        if path == [int(t) for t in serial[:nd.depth - 1]]:
+            cal.record(nd.depth - 1, nd.rank, nd.p, int(serial[nd.depth - 1]) == nd.tok)
+
+
+__all__ = ["Cal", "Expander", "Node", "Plan", "accepted_len", "chains_of", "grow", "learn", "new_chain", "select",
+           "settings"]
