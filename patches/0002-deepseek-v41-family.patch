+    src.mkdir()
+    bv = torch.randn(cfg.n_routed_experts)
+    save_file({"layers.3.ffn.gate.bias_vl": bv}, str(src / "model-00003-of-00048.safetensors"))
+    t = W.Loader(cfg, W.Shards(root), 0, 1, bias_vl=W.bias_vl_source({"TF_DSV41_BIAS_VL": str(src)})).load(4)
+    assert torch.equal(t.layers[3].moe.bias_vl, bv) and t.layers[2].moe.bias_vl is None
+    assert W.bias_vl_source({}) is None
+
+
+def test_refuses_splits_that_break_hadamard_blocks(ckpt):
+    root, cfg = ckpt
+    with pytest.raises(ValueError):
+        W.Loader(cfg, W.Shards(root), 0, 4).load(1)          # 2 heads over 4 ranks
+
+
+def test_roles_and_topology(ckpt):
+    root, cfg = ckpt
+    modes = [cfg.attention_mode(L) for L in range(cfg.num_hidden_layers)]
+    assert modes == ["swa", "swa", "full", "reuse", "full", "reuse", "reindex", "reuse"]
+    assert cfg.is_candidate_source(4) and cfg.uses_candidates(6) and not cfg.uses_candidates(4)
+    topo = topology.load(root)
+    assert topo.kv_sources == [2, 4] and topo.by_role("reindex") == [6]
+    assert [ly.kv_source for ly in topo.layers][2:] == [2, 2, 4, 4, 4, 4]
+    assert topo.layers[4].candidates == "write" and topo.layers[6].candidates == "read"
+    assert topo.layers[1].engram and len(topo.dspark) == 2 and topo.decoder_start == 4
+
+
+def test_real_config_roles():
+    """The checkpoint's own layer schedule (docs/ARCHITECTURE.md section 3.2) from Config's defaults."""
+
+    cfg = Config()
+    modes = [cfg.attention_mode(L) for L in range(40)]
+    assert modes[:2] == ["swa", "swa"] and [i for i, m in enumerate(modes) if m == "full"] == [2, 8, 14, 20]
+    assert [i for i, m in enumerate(modes) if m == "reindex"] == [24, 28, 32, 36]
+    assert cfg.kv_source(39) == 20 and cfg.index_source(39) == 36 and cfg.kv_source(13) == 8
+    assert cfg.compress_ratio(19) == 2 and cfg.compress_ratio(20) == 1 and cfg.compress_ratio(40) == 0
