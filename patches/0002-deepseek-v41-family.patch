+def test_host_buffers_reused_only_when_free(monkeypatch):
+    """``engram_host.HostBuffers``: a buffer comes back once every user of the rows is gone (a view of the tensor
+    keeps it), then the next segment reuses it (no mmap / munmap a segment); at most ``keep`` kept a size."""
+
+    import gc
+
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+
+    pool = EH.HostBuffers(1)
+    monkeypatch.setattr(EH, "BUFFERS", pool)
+    raw = torch.randint(0, 120, (5000, 256), dtype=torch.uint8)
+    scale = torch.full((5000, 8), 127, dtype=torch.uint8)
+    a = EH.dequant_host(raw, scale)
+    view = a[10:20]
+    ptr = a.data_ptr()
+    del a
+    gc.collect()
+    b = EH.dequant_host(raw, scale)                     # the view still holds the first buffer
+    other = b.data_ptr() != ptr
+    want = view.clone()
+    b.fill_(0)
+    intact = torch.equal(view, want)
+    del view, b                                          # (no assert names them: pytest keeps its operands)
+    gc.collect()
+    assert other and intact and pool.stats["new"] == 2 and pool.stats["reused"] == 0
+    assert pool.stats["dropped"] == 1, (pool.stats, {k: len(v) for k, v in pool.free.items()})  # keep 1
+    c = EH.dequant_host(raw[:4500], scale[:4500])       # another row count, the same bucket (8,192 rows)
+    assert pool.stats["reused"] == 1 and c.shape == (4500, 256)
+    assert torch.equal(c, EH.dequant(raw[:4500], scale[:4500]))
