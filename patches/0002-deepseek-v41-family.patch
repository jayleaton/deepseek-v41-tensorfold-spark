@@ -0,0 +1,327 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""moe_fused (TF_DSV41_MOE_FUSED, REWRITE-PLAN b1) on the GPU (collected only where PyTorch sees an NVIDIA GPU):
+
+- the fused kernel == the production sequence (narrow router -> prune -> kit casts -> group -> rot_in) bit for bit:
+  picks, weights, the routed groups (today's minus the shared entry) and every routed pair's rotated inputs; E 384
+  top-6 and E 128 top-3, R = 1..16, prune off / p85k / p85 / w10k, every narrow NW and helper count;
+- graph replays of the fused kernel == eager, its counters back to 0; it completes beside a GPU-filling kernel;
+- ``moe.GpuMoE`` with the knob on == off, bit for bit (outputs and picks), on random EXL3 blocks: x3ld on / off, the
+  router tail on / off, pruning on / off, the shared down late / early, R = 1..16; rows of a window == alone; a
+  captured graph (the side stream forked and joined inside the capture) replays == the old path eagerly;
+- the real weights (``TF_DSV41_TEST_MODEL``, rank ``TF_DSV41_TEST_RANK``, layers ``TF_DSV41_FP_LAYERS``, default
+  1,20,39): on == off for R = 1..16, prune p85k and off;
+- microbench (printed, cold L2 in a CUDA graph): the MoE call's us a layer, old vs fused, R = 1, 2, 4, 8, 16.
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_moe_fused_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.cuda.exl3 import experts as x3
+from tensorfold.families.deepseek_v41.cuda import expert_loads as loads
+from tensorfold.families.deepseek_v41.cuda import experts as X
+from tensorfold.families.deepseek_v41.cuda import moe as M
+from tensorfold.families.deepseek_v41.cuda import moe_fused as MF
+from tensorfold.families.deepseek_v41.cuda import pick as PK
+from tensorfold.families.deepseek_v41.cuda import prune as PR
+from tensorfold.families.deepseek_v41.cuda import router
+from tensorfold.families.deepseek_v41.cuda import router_gemv as RG
+
+DEV = "cuda"
+D = 5120
+RULES = {"off": None, "p85k": PR.Rule(topp=0.85, min_k=3, renorm="kept"), "p85": PR.Rule(topp=0.85, min_k=3),
+         "w10k": PR.Rule(min_w=0.1, min_k=4, renorm="kept")}
+P85K = {"TF_DSV41_EXPERT_TOPP": "0.85", "TF_DSV41_EXPERT_MIN_K": "3", "TF_DSV41_EXPERT_RENORM": "kept"}
+
+
+def _x(R, seed, scale=1.0):
+    g = torch.Generator(device=DEV).manual_seed(seed)
+    return (torch.randn((R, D), generator=g, device=DEV) * scale).to(torch.bfloat16)
+
+
+def _stand(E, K, seed):
+    """A route-only stand-in: the gate, bias, suh tables and an upstream Scratch of 16 rows (no trellis)."""
+
+    g = torch.Generator(device=DEV).manual_seed(seed)
+    gate = (torch.randn((E, D), generator=g, device=DEV) * 0.03).to(torch.bfloat16).contiguous()
+    bias = torch.randn(E, generator=g, device=DEV) * 0.01
+    suh = [((torch.rand((E + 1, D), generator=g, device=DEV) + 0.5) * 0.02).to(torch.float16) for _ in range(2)]
+    ex = SimpleNamespace(suh_g=suh[0], suh_u=suh[1], count=E + 1, dims=D, width=1152, cb=2)
+    geom = X.Geometry(experts=E, topk=K)
+    s = x3.Scratch(ex, 16, K + 1, *X.configs(geom), device=DEV)
+    return SimpleNamespace(gate=gate, bias=bias, block=SimpleNamespace(ex=ex, geom=geom), topk=K, scale=1.5,
+                           scratch=s, limit=10.0)
+
+
+def _production(m, x, rule, nw):
+    """Today's decode sequence for the same rows: (pick, wts, ids, count, members, xg, xu)."""
+
+    R, K, ex, s = x.shape[0], m.topk, m.block.ex, m.scratch
+    slots = K + 1
+    pick = torch.empty((R, slots), dtype=torch.int32, device=DEV)
+    wts = torch.empty((R, slots), dtype=torch.float32, device=DEV)
+    RG.route(x, m.gate, m.bias, K, slots, m.scale, pick, wts, narrow=nw)
+    if rule is not None:
+        PR.apply(pick, wts, K, rule, m.scale, ex.count)
+    wts = PK.kit_weights(wts)
+    ids, members = s.window(R)
+    ext = x3._ext()
+    ext.group(pick, ids, s.count, members, R, slots, ex.count)
+    xg = torch.zeros((R * slots, D), dtype=torch.float16, device=DEV)
+    xu = torch.zeros_like(xg)
+    ext.rot_in(x, x.stride(0), pick, ex.suh_g, ex.suh_u, xg, xu, R, D, slots, ex.count)
+    return pick, wts, ids.clone(), int(s.count[0]), members.clone(), xg, xu
+
+
+def _check_route(m, x, rule, nw, help=None):
+    K, E = m.topk, m.gate.shape[0]
+    pick0, wts0, ids0, n0, mem0, xg0, xu0 = _production(m, x, rule, nw)
+    m.scratch.xg.fill_(float("nan"))
+    m.scratch.xu.fill_(float("nan"))
+    pick, wts, pickr, ids, members = MF.route(m, x, rule, help=help, nw=nw, inline=False)   # b1's layout
+    torch.cuda.synchronize()
+    assert torch.equal(pick, pick0) and torch.equal(wts.view(torch.int32), wts0.view(torch.int32))
+    assert torch.equal(pickr[:, :K], pick[:, :K]) and bool((pickr[:, K] == -1).all())
+    n = int(m.scratch.count[0])
+    assert n == n0 - 1 and int(ids0[n0 - 1]) == E and torch.equal(ids[:n], ids0[:n])
+    assert torch.equal(members[:n], mem0[:n])
+    live = ((pick >= 0) & (pick < E)).reshape(-1).nonzero().reshape(-1)          # routed pairs
+    assert torch.equal(m.scratch.xg[live].view(torch.int16), xg0[live].view(torch.int16))
+    assert torch.equal(m.scratch.xu[live].view(torch.int16), xu0[live].view(torch.int16))
+    assert int(MF.side_for(m.block, m.scratch, x.device).cnt.abs().sum()) == 0     # counters back to 0
+    return pick
+
+
+@pytest.mark.parametrize("rule", list(RULES), ids=list(RULES))
+@pytest.mark.parametrize("E,K", [(384, 6), (128, 3)])
+def test_route_equals_production_sequence(rule, E, K):
+    m = _stand(E, K, E + K)
+    r = RULES[rule]
+    if r is not None and r.min_k >= K:
+        r = PR.Rule(r.min_w, r.topp, K - 1, r.renorm)
+    dropped = 0
+    for R in range(1, 17):
+        pick = _check_route(m, _x(R, 100 + R, 0.6), r, 2)
+        dropped += int((pick[:, :K] == E + 1).sum())
+    if r is not None and 0 < r.topp < 1 and K == 6:      # the model's geometry; the 128 / top-3 stand (min_k 2)
+        assert dropped > 0                                # rarely leaves 0.15 of its mass outside 2 slots (G13: 0)
+    print(f"\n[G13] moe_fused route == router -> prune -> kit -> group -> rot_in, E {E} top-{K} rule {rule}: "
+          f"R 1..16 bit for bit ({dropped} slots pruned)")
+
+
+@pytest.mark.parametrize("nw", MF.NWS)
+def test_route_any_nw_and_helper_count(nw):
+    m = _stand(384, 6, 7)
+    for R in (1, 3, 16):
+        x = _x(R, 50 + R, 0.6)
+        for hp in (0, 1, None, 47):
+            _check_route(m, x, RULES["p85k"], nw, help=hp)
+
+
+def test_route_graph_replays_and_busy_gpu():
+    m = _stand(384, 6, 8)
+    rule = RULES["p85k"]
+    xs = _x(4, 1, 0.6)
+    MF.route(m, xs, rule)                                       # build + counters outside the capture
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        out = MF.route(m, xs, rule)
+    for seed in (2, 3, 4):
+        xn = _x(4, seed, 0.6)
+        xs.copy_(xn)
+        graph.replay()
+        torch.cuda.synchronize()
+        want = _production(m, xn, rule, MF.narrow_nw())
+        assert torch.equal(out[0], want[0]) and torch.equal(out[1].view(torch.int32), want[1].view(torch.int32))
+    side = torch.cuda.Stream()
+    a = torch.randn((8192, 8192), device=DEV)
+    for _ in range(3):                                          # a GPU-filling neighbour on another stream
+        with torch.cuda.stream(side):
+            for _ in range(4):
+                a = a @ a.T * 1e-4
+        for R in (1, 16):
+            _check_route(m, _x(R, 9, 0.6), rule, 2, help=47)
+    torch.cuda.synchronize()
+
+
+# -- the whole MoE call on random EXL3 blocks ----------------------------------------------------------------------
+def _layer(seed, experts=64):
+    from test_dsv41_gpu import _random_layer
+
+    return _random_layer(6, 10, experts=experts, seed=seed)
+
+
+def _moe(monkeypatch, seed, experts=64, tail=False, prune_env=None):
+    monkeypatch.setattr(X, "EXPERTS", experts)                  # this block is the target (its prune rule)
+    monkeypatch.setattr(router, "MODE", "gemv")
+    monkeypatch.setattr(RG, "NARROW", 2)
+    monkeypatch.setattr(RG, "TAIL", bool(tail))
+    monkeypatch.setattr(PR, "CFG", PR.parse(prune_env or {}))
+    layer = _layer(seed, experts)
+    g = torch.Generator(device=DEV).manual_seed(seed + 1)
+    gate = (torch.randn((experts, D), generator=g, device=DEV) * 0.03).to(torch.bfloat16)
+    bias = torch.randn(experts, generator=g, device=DEV) * 0.01
+    return M.GpuMoE(gate, bias, layer, 6, 1.5, 10.0)
+
+
+def _both(monkeypatch, m, x, sdn="late"):
+    monkeypatch.setattr(MF, "CFG", MF.parse({}))
+    old = m(x).clone()
+    pold = m.last_pick.clone()
+    monkeypatch.setattr(MF, "CFG", MF.parse({"TF_DSV41_MOE_FUSED": "1", "TF_DSV41_MOE_FUSED_SDN": sdn}))
+    m.ensure()
+    new = m(x).clone()
+    pnew = m.last_pick.clone()
+    torch.cuda.synchronize()
+    return old, pold, new, pnew
+
+
+@pytest.mark.parametrize("ld", [False, True], ids=["upstream", "x3ld"])
+@pytest.mark.parametrize("tail", [False, True], ids=["notail", "tail"])
+@pytest.mark.parametrize("prune", [False, True], ids=["noprune", "p85k"])
+def test_moe_on_equals_off(monkeypatch, ld, tail, prune):
+    m = _moe(monkeypatch, 11, tail=tail, prune_env=P85K if prune else None)
+    saved = dict(loads.CFG)
+    try:
+        loads.CFG.update(on=ld)
+        for R in (1, 2, 3, 4, 6, 8, 11, 16):
+            x = _x(R, 200 + R, 0.6)
+            for sdn in ("late", "early"):
+                old, pold, new, pnew = _both(monkeypatch, m, x, sdn)
+                assert torch.equal(pnew, pold), (R, sdn)
+                assert torch.equal(new.view(torch.int32), old.view(torch.int32)), (R, sdn)
+    finally:
+        loads.CFG.clear()
+        loads.CFG.update(saved)
+
+
+def test_moe_rows_of_a_window_and_graph(monkeypatch):
+    m = _moe(monkeypatch, 12, prune_env=P85K)
+    monkeypatch.setattr(MF, "CFG", MF.parse({"TF_DSV41_MOE_FUSED": "1"}))
+    m.ensure()
+    x16 = _x(16, 5, 0.6)
+    whole = m(x16).clone()
+    for r in (0, 5, 15):
+        assert torch.equal(m(x16[r:r + 1].clone())[0], whole[r])
+    for R in (1, 4, 16):                                         # a captured window: fork / join inside the capture
+        xs = _x(R, 30 + R, 0.6)
+        m(xs)
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            out = m(xs)
+        for seed in (40, 41):
+            xn = _x(R, seed + R, 0.6)
+            xs.copy_(xn)
+            graph.replay()
+            torch.cuda.synchronize()
+            got = out.clone()
+            monkeypatch.setattr(MF, "CFG", MF.parse({}))
+            want = m(xn).clone()
+            monkeypatch.setattr(MF, "CFG", MF.parse({"TF_DSV41_MOE_FUSED": "1"}))
+            torch.cuda.synchronize()
+            assert torch.equal(got.view(torch.int32), want.view(torch.int32)), (R, seed)
+    side = next(iter(MF._SIDES.values()))
+    assert int(side.cnt.abs().sum()) == 0
+
+
+# -- the real weights and the microbench ---------------------------------------------------------------------------
+def _model() -> Path | None:
+    p = Path(os.environ.get("TF_DSV41_TEST_MODEL", "/model"))
+    return p if (p / "config.json").is_file() else None
+
+
+def _real(layer):
+    from tensorfold.families.deepseek_v41.cuda import blocks as B
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+    from tensorfold.families.deepseek_v41.cuda.config import Config
+
+    root = _model()
+    cfg = Config.from_file(root / "config.json")
+    rank = int(os.environ.get("TF_DSV41_TEST_RANK", "0"))
+    m = W.Loader(cfg, W.Shards(root), rank, 2, DEV).moe(layer, f"layers.{layer}")
+    _, topk = cfg.experts_of(layer)
+    block = B.gpu_experts(cfg, m, layer, 2, DEV)
+    return M.GpuMoE(m.gate, m.bias, block, topk, cfg.routed_scaling_factor, cfg.swiglu_limit)
+
+
+def _cold_us(fn, iters=20):
+    """us of fn() in a CUDA graph after a 64 MB write that evicts L2, minus the write alone."""
+
+    junk = torch.empty(16 << 20, dtype=torch.float32, device=DEV)
+    fn()
+    torch.cuda.synchronize()
+
+    def graph(with_fn):
+        g = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(g):
+            for _ in range(4):
+                junk.add_(1.0)
+                if with_fn:
+                    fn()
+        return g
+
+    def t(g):
+        g.replay()
+        torch.cuda.synchronize()
+        a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        a.record()
+        for _ in range(iters):
+            g.replay()
+        b.record()
+        b.synchronize()
+        return a.elapsed_time(b) * 1e3 / (iters * 4)
+
+    return t(graph(True)) - t(graph(False))
+
+
+def _bench(monkeypatch, m, tag):
+    m.ensure()
+    for R in (1, 2, 4, 8, 16):
+        x = _x(R, 900 + R, 0.6)
+        monkeypatch.setattr(MF, "CFG", MF.parse({}))
+        old = _cold_us(lambda x=x: m(x))
+        monkeypatch.setattr(MF, "CFG", MF.parse({"TF_DSV41_MOE_FUSED": "1"}))
+        m.ensure()
+        new = _cold_us(lambda x=x: m(x))
+        print(f"[G13] moe_fused bench {tag} R={R}: old {old:.1f} us, fused {new:.1f} us ({new - old:+.1f})",
+              flush=True)
+
+
+@pytest.mark.skipif(_model() is None, reason="TF_DSV41_TEST_MODEL: the checkpoint folder")
+def test_real_layers(monkeypatch):
+    monkeypatch.setattr(router, "MODE", "gemv")
+    monkeypatch.setattr(RG, "NARROW", 2)
+    monkeypatch.setattr(RG, "TAIL", True)
+    layers = [int(v) for v in os.environ.get("TF_DSV41_FP_LAYERS", "1,20,39").split(",")]
+    for L in layers:
+        m = _real(L)
+        for env in (P85K, {}):
+            monkeypatch.setattr(PR, "CFG", PR.parse(env))
+            for R in range(1, 17):
+                x = _x(R, 1000 * L + R, 0.6)
+                old, pold, new, pnew = _both(monkeypatch, m, x)
+                assert torch.equal(pnew, pold) and torch.equal(new.view(torch.int32), old.view(torch.int32)), (L, R)
+        monkeypatch.setattr(PR, "CFG", PR.parse(P85K))
+        _bench(monkeypatch, m, f"real layer {L} p85k")
+        print(f"[G13] moe_fused real layer {L}: on == off, R 1..16, p85k and off, bit for bit", flush=True)
+        del m
+        torch.cuda.empty_cache()
+
+
+@pytest.mark.skipif(_model() is not None, reason="the real-weight test benches instead")
+def test_bench_random_full_layer(monkeypatch):
+    m = _moe(monkeypatch, 21, experts=384, tail=True, prune_env=P85K)
+    _bench(monkeypatch, m, "random 384-expert layer p85k")
