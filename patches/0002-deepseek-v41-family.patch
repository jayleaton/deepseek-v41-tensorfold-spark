+# -- Engram ------------------------------------------------------------------------------------------------------
+def test_engram_on_gpu():
+    g = np.random.default_rng(1)
+    v = g.integers(0, 256, size=(5, 12, 256), dtype=np.uint8)
+    v[np.isin(v, (0x7F, 0xFF))] = 0x38
+    v[0, 0] = np.array([b for b in range(256) if b not in (0x7F, 0xFF)] + [0, 0], dtype=np.uint8)
+    s = g.integers(118, 136, size=(5, 12, 8), dtype=np.uint8)
+    s[0, 1] = [0, 1, 2, 127, 200, 250, 254, 3]
+    s[0, 2] = 1
+    raw = torch.from_numpy(np.concatenate([v, s], axis=2)).contiguous()
+    out = torch.zeros((5, 24 * 256), dtype=torch.bfloat16, device=DEV)
+    engram.dequant(raw.to(DEV), out, col0=12)
+    assert torch.equal(_bits(out[:, 12 * 256:]), _bits(KR.engram_dequant(raw)))
+    d = 5120
+    tg = torch.Generator().manual_seed(2)
+    x = torch.randn((7, 4 * d), generator=tg).to(torch.bfloat16)
+    kv = (torch.randn((7, 5 * d), generator=tg) * 0.5).to(torch.bfloat16)
+    qk = engram.qk_weights(torch.rand((4, d), generator=tg) + 0.5, torch.rand((4, d), generator=tg) + 0.5)
+    keep = torch.tensor([1.0, 1, 0, 1, 1, 1, 1])
+    xg = x.to(DEV)
+    gate = torch.zeros((7, 4), device=DEV)
+    engram.fuse(xg, kv.to(DEV), qk.to(DEV), keep.to(DEV), gate)
+    torch.testing.assert_close(gate.cpu(), KR.engram_gates(x, kv, qk, keep), rtol=1e-6, atol=1e-6)
+    assert torch.equal(_bits(xg), _bits(KR.engram_apply(x, kv, gate.cpu())))
+    for r in (0, 6):
+        one = x[r:r + 1].to(DEV)
+        engram.fuse(one, kv[r:r + 1].to(DEV), qk.to(DEV), keep[r:r + 1].to(DEV))
+        assert torch.equal(_bits(one), _bits(xg[r:r + 1]))
+
