+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The fused query RoPE (families/deepseek_v41/cuda/rope_fused.py) in Triton's CPU interpreter with the ``gpu_like``
+model: bit for bit ``rope.Table.apply``'s torch form (bf16 out) for the attention query ([T, 32, 512], compressed
+and window-only tables) and the index query ([T, 32, 128]), bf16 and fp32 inputs, ``inverse``, positions up to the
+table's end; a row alone == the row in a window.
+
+Run: python -m pytest -q tests/test_dsv41_rope_fused_interp.py
+"""
+
+from __future__ import annotations
+
+import os
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401
+
+interpret()
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+
+from tensorfold.families.deepseek_v41.cuda import rope as RP
+from tensorfold.families.deepseek_v41.cuda import rope_fused as RF
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1" and type(RF._rope).__name__ == "InterpretedFunction"
+pytestmark = [pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)"),
+              pytest.mark.usefixtures("gpu_like")]
+
+
+def _tables(max_pos: int = 4096):
+    plain = RP.inv_freq(64, 10000.0)
+    comp = RP.inv_freq(64, 160000.0, 16.0, 65536, 32.0, 1.0)
+    return RP.Table.build(plain, max_pos), RP.Table.build(comp, max_pos)
+
+
+def _bits(t):
+    return t.contiguous().view(-1).view(torch.int16)
+
+
+@pytest.mark.parametrize("heads,dh", [(32, 512), (32, 128), (5, 64)])
+@pytest.mark.parametrize("inverse", [False, True])
+def test_fused_rope_equals_torch(heads, dh, inverse):
+    g = torch.Generator().manual_seed(heads + dh + int(inverse))
+    for table in _tables():
+        T = 7
+        x = (torch.randn(T, heads, dh, generator=g) * 3).to(torch.bfloat16)
+        pos = torch.tensor([0, 1, 2047, 2048, 4095, 77, 3001])
+        want = table.apply(x.to(torch.float32), pos, inverse=inverse, dtype=torch.bfloat16)
+        for inp in (x, x.to(torch.float32)):
+            got = RF.apply(inp, table.cs, pos, 64, inverse)
+            assert got.dtype == torch.bfloat16 and torch.equal(_bits(got), _bits(want))
+
+
+def test_fused_rope_row_invariant():
+    _, table = _tables()
+    g = torch.Generator().manual_seed(3)
+    x = torch.randn(9, 32, 512, generator=g).to(torch.bfloat16)
+    pos = torch.arange(100, 109)
+    whole = RF.apply(x, table.cs, pos, 64)
+    for r in (0, 4, 8):
+        one = RF.apply(x[r:r + 1], table.cs, pos[r:r + 1], 64)
+        assert torch.equal(_bits(one), _bits(whole[r:r + 1]))
+
+
+def test_eligibility():
+    x = torch.zeros(2, 4, 512)
+    assert not RF.eligible(x, torch.zeros(2), 64, torch.bfloat16)                # CPU: the torch form
+    assert RF.eligible.__doc__ and RF.enabled()
