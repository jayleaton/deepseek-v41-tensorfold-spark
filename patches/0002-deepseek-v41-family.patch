new file mode 100644
index 0000000..aec3a9a
--- /dev/null
+++ b/tests/test_dsv41_prefill.py
@@ -0,0 +1,196 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Big prefill segments (``TF_DSV41_PREFILL_CHUNK``) on the CPU twin of the kernels, a tiny synthetic checkpoint with
+a 4-token window (so a segment of more than 5 rows already needs the staging ring):
+
+- chunked == unchunked: a prompt prefilled in one segment, in 8-row segments, in the verify size (4 rows, the
+  slot's own ring) and one row at a time (decode rows) gives the same logits and the same slot state (SWA rings as
+  stored bytes, compressed rows, index keys, ratio-2 carries, the Engram lookback), bit for bit, and the decode
+  steps after it agree;
+- several slots' pieces in one run (GLM 0560) == each slot alone, with the staging ring shared by the segments;
+- the Engram prefetch's runs are the forward's runs (``prefetch.piece_runs`` == ``slots.prefill_runs``).
+"""
+
+from __future__ import annotations
+
+import json
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import prefetch as PF  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.slots import SlotsForward, prefill_runs  # noqa: E402
+
+IDS = torch.randint(0, 256, (37,), generator=torch.Generator().manual_seed(23)).tolist()
+MORE = [5, 9, 17]
+
+
+@pytest.fixture(scope="module")
+def ckpt(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41pf"))
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg)
+
+
+def build(ckpt, chunk: int = 4, pchunk: int | None = None, slots: int = 1) -> SlotsForward:
+    root, cfg, table = ckpt
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), 0, 1).load(token_map=tmap)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    return SlotsForward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), limit=96, chunk=chunk,
+                        pchunk=pchunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap), slots=slots)
+
+
+def state(fw, slot: int = 0) -> dict:
+    """Everything a slot carries past a prompt: the bounded state (ring rows as stored, carries, lookback) and the
+    compressed rows / index keys of every position written so far."""
+
+    s = fw.slots[slot]
+    snap = fw.snapshot(slot)
+    out = {f"snap.{k}": torch.from_numpy(np.asarray(v)) for k, v in snap.arrays.items()}
+    for L, st in s.comp.items():
+        n = s.pos // next(b.ratio for b in fw.blocks if b.index == L)
+        rows = torch.arange(n)
+        out[f"comp.{L}"] = st.read(rows)
+        out[f"keys.{L}"] = s.ikeys[L].read(rows)
+    out["pos"] = torch.tensor([s.pos])
+    return out
+
+
+def prefill_then_decode(fw, ids, slot: int = 0) -> tuple[torch.Tensor, dict, torch.Tensor]:
+    """The prompt but its last token through ``prefill``, the last token and MORE as decode steps."""
+
+    fw.prefill([Piece(slot, 0, tuple(ids[:-1]))])
+    st = state(fw, slot)
+    out = [fw.step([ids[-1]], slot=slot)]
+    for t in MORE:
+        out.append(fw.step([t], slot=slot))
+    return torch.cat(out), st, fw.slots[slot].pos
+
+
+@pytest.mark.parametrize("pchunk", [36, 8, 6])
+def test_chunked_equals_unchunked(ckpt, pchunk):
+    """One 36-row segment, 8-row and 6-row segments (both on the staging ring) == the verify size (4 rows on the
+    slot's ring) == decode rows one at a time: logits and state bit for bit."""
+
+    want, want_st, _ = prefill_then_decode(build(ckpt, chunk=4), IDS)
+    fw = build(ckpt, chunk=4, pchunk=pchunk)
+    got, got_st, _ = prefill_then_decode(fw, IDS)
+    assert fw.stage is not None and fw.stage[1] >= pchunk + 3
+    assert torch.equal(got, want)
+    assert set(got_st) == set(want_st)
+    for k in want_st:
+        assert torch.equal(got_st[k], want_st[k]), k
+
+
+def test_prefill_rows_equal_decode_rows(ckpt):
+    """The exact prefill tag: a prompt prefilled in one big segment holds the state of one row at a time."""
+
+    fw = build(ckpt, chunk=4, pchunk=36)
+    fw.prefill([Piece(0, 0, tuple(IDS[:-1]))])
+    one = build(ckpt, chunk=1)
+    for t in IDS[:-1]:
+        one.step([t])
+    a, b = state(fw), state(one)
+    for k in a:
+        assert torch.equal(a[k], b[k]), k
+    assert torch.equal(fw.step([IDS[-1]]), one.step([IDS[-1]]))
+
+
+def test_prompt_uses_prefill_segments(ckpt):
+    fw = build(ckpt, chunk=4, pchunk=36)
+    calls = []
+    real = fw.run
+
+    def rec(segs, **kw):
+        calls.append((len(segs[0][2]) if isinstance(segs[0], tuple) else len(segs[0].ids), kw.get("prefill")))
+        return real(segs, **kw)
+
+    fw.run = rec
+    last = fw.prompt(IDS)
+    assert calls == [(36, True), (1, True)]
+    ref = build(ckpt, chunk=4)
+    assert torch.equal(last, ref.prompt(IDS))
+
+
+def test_multi_slot_pieces_equal_alone(ckpt):
+    """Two slots' pieces of different lengths in shared runs (and a piece starting mid-prompt) == each alone."""
+
+    p0, p1 = IDS, list(reversed(IDS))[:29]
+    fw = build(ckpt, chunk=4, pchunk=8, slots=2)
+    fw.prefill([Piece(0, 0, tuple(p0[:20])), Piece(1, 0, tuple(p1[:-1]))])
+    fw.prefill([Piece(0, 20, tuple(p0[20:-1]))])
+    for slot, p in ((0, p0), (1, p1)):
+        alone = build(ckpt, chunk=4)
+        alone.prefill([Piece(0, 0, tuple(p[:-1]))])
+        a, b = state(fw, slot), state(alone)
+        for k in b:
+            assert torch.equal(a[k], b[k]), (slot, k)
+        assert torch.equal(fw.step([p[-1]], slot=slot), alone.step([p[-1]]))
+
+
+def test_prefetch_runs_are_the_forward_runs(ckpt):
+    fw = build(ckpt, chunk=4, pchunk=8, slots=2)
+    pieces = [Piece(0, 0, tuple(IDS[:20])), Piece(1, 0, tuple(IDS[:11]))]
+    runs = prefill_runs(pieces, fw.pchunk)
+    got = PF.piece_runs(fw, pieces)
+    assert [[(s, ids) for s, ids, _ in r] for r in got] == [[(s, ids) for s, _, ids in r] for r in runs]
+    assert [len(r) for r in runs] == [2, 2, 1]
+    keep = fw.cfg.engram_max_ngram_size - 1
+    assert got[1][0][2] == list(IDS[8 - keep:8])    # slot 0's second segment sees the first one's last ids
+
+
+def test_prefill_exchanges_bf16_same_bits(ckpt):
+    """TP=2: a prefill segment's partials travel as bf16 (they are bf16 values under the kit's rounding); the logits
+    and both ranks' states equal fp32 exchanges' bit for bit (TF_DSV41_PREFILL_EXCHANGE=fp32)."""
+
+    from tensorfold.families.deepseek_v41.cuda import forward as FW
+
+    root, cfg, table = ckpt
+
+    def pair_run(bf16: bool):
+        pair = FK.ThreadPair()
+        comms = pair.comms()
+        tmap = FK.token_map(cfg)
+        fws = []
+        for r in range(2):
+            tree = W.Loader(cfg, W.Shards(root), r, 2).load(token_map=tmap)
+            rows = {L: EH.MemoryRows(a, b) for L, (a, b) in table.items()}
+            fw = SlotsForward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), comm=comms[r],
+                              limit=96, chunk=4, pchunk=36, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap))
+            fw.exchange_bf16 = bf16
+            fws.append(fw)
+        sent = []
+        real = FW.fast_gather
+
+        def spy(comm, send, recv):
+            sent.append(send.dtype)
+            return real(comm, send, recv)
+
+        def go(fw):
+            fw.prefill([Piece(0, 0, tuple(IDS[:-1]))])
+            return fw.step([IDS[-1]]), state(fw)
+
+        FW.fast_gather = spy
+        try:
+            return pair.run([lambda f=f: go(f) for f in fws]), sent
+        finally:
+            FW.fast_gather = real
+
+    got, sent = pair_run(True)
+    want, sent_fp32 = pair_run(False)
+    assert torch.bfloat16 in sent and sent.count(torch.bfloat16) > sent_fp32.count(torch.bfloat16)
+    for (lg, st), (lw, sw) in zip(got, want):
+        assert torch.equal(lg, lw)
+        for k in sw:
+            assert torch.equal(st[k], sw[k]), k
