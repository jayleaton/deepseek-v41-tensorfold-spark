+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""REWRITE-PLAN candidate 5 (e2 + e3): CSA2's decode attention core and the indexer's top-k as hand-written CUDA
+(``attn_cuda.cu``, ``topk_cuda.cu``), ``TF_DSV41_ATTN_CUDA=1`` (default 0: the Triton ``attn._chunks`` +
+``attn._merge`` pair and ``dtopk``).
+
+Why. G9's 1-row window spends ~1.3 ms in the attention core and ~0.6-0.9 ms in the indexer's top-k on GB10's 48 SMs
+while most SMs idle: ``_chunks`` is 10 CTAs at 1 row (5 chunks x 2 head tiles), each walking 4 tiles of 32 keys with
+three dependent global round trips a tile (selection entry, page table, rows) and no overlap; ``_merge`` is a
+second launch; ``dtopk`` is ONE CTA a row making up to 8 passes over 16K-75K keys (reindex 74 us, select 92 us at
+32K keys).
+
+Attention (``attention``; one launch, grid 5 chunks x H / 16 head tiles x R rows, 256 threads, 98.8 KB shared):
+- a CTA resolves its chunk's 128 keys -> physical rows at once (one round trip for the entries, one for the page
+  table), then issues every row's 576 + 8 bytes with cp.async (8-byte pieces, swizzled, masked keys zero-filled) in
+  one go, and builds q's mma fragments while they land;
+- S for the 4 tiles (16 chains of 32 mma.sync over K = 512, 2 interleaved a warp), the tile maxima, the running max
+  and alphas (16 threads), p / the row sums / bf16(p) fragments, then PV (8 n8 tiles a warp, 2 k steps a tile)
+  straight from the FP8 rows (dequantized in registers: e4m3 -> f16 -> x 2^(s - 127) -> bf16, exact);
+- the partials go to ``attn.Scratch`` (Triton's layout); the last CTA of a (row, head tile) to arrive (fence +
+  ticket, self-cleaning across graph replays) merges the chunks, the sink, 1 / l, the inverse RoPE: no second
+  launch. Chunks past the row's selection count exit at once (their partial is Triton's empty one).
+
+Bits: the SAME as the Triton pair. The operations are the ones Triton emits on sm_121 (``tests/dsv41_attn_ptx.py``
+reads them back): the mma k order of its kWidth dot-operand layout (``kwidth()`` compiles ``_chunks`` for this GPU
+and reads the layout; 4 on Triton 3.8: k {4t, 4t+1, 16+4t, 17+4t} of a 32-block in step 0), mul.f32 by 512^-0.5,
+ex2.approx.f32 of rn(x * log2 e) (not ftz), the row sums as (W0 + W2) + (W1 + W3) of the quad sums (a0 + a2) +
+(a1 + a3), fma(l, alpha, sum), rn(o * alpha) into the mma accumulator, the merge's fma chain (chunk 0: fma(b, co,
++0)), div.full.f32 and the RoPE fmas. So row invariance, batched == alone and drafted == serial hold as before and
+the M1 gate is unchanged (top-1 0.9963). An unknown Triton layout turns the attention part off (logged).
+
+Top-k (``select`` / ``blocks`` / ``gather_cand`` / ``select_blocks``; one launch, a CLUSTER of CL <= 8 CTAs a row,
+512 threads): the exact dtopk selection (index.py's unique keys: score image, then the lower position; positions
+ascending, -1 padded; the visible count) as a 32-bit radix select over the score images (scan order is ascending
+position in these modes), <= 4 passes of 8-bit digits with warp-aggregated shared histograms summed over the cluster
+through DSMEM, then the entries above the K-th image and the first equal ones in scan order. The candidate source's
+select + blocks run as the two jobs of one launch. Scores stay Triton's ``index._scores`` (a GPU-wide tensor-core
+kernel: at 32K keys it streams 8 MB of index keys, which a cluster of 8 SMs could not do faster); so this is the
+plan's "fused score + top-k" minus the scoring, whose bits it keeps.
+
+Cost model (GB10, 1 row, in a graph after a large predecessor):
+- attention a layer: launch ~2 us; entries + page table ~1 us; 75 KB of rows ~1.5 us (one SM, all in flight); S
+  ~0.6 us; softmax ~0.3 us; PV ~1 us; partial + ticket ~0.5 us; merge (last CTA, 160 KB of L2) ~1.2 us => ~7-8 us
+  (Triton today: _chunks 21 + _merge 2.2 + a launch gap). x 40 layers: -0.55 to -0.65 ms in isolation, R = 4
+  ~9-10 us (40 CTAs, one wave), R = 16 ~20 us (160 CTAs, 3.3 waves).
+- top-k a selection: launch ~2-3 us (cluster); images 1 read; a pass ~1-1.3 us (scan + cluster barrier + 8 x 256
+  DSMEM reads); compaction ~1 us => ~5-8 us at 16K-75K keys vs dtopk's 60-92 us; short rows (<= K valid) ~3 us.
+  Short prompts: the 4 reindex layers (16,384 candidate entries) dominate: ~-0.2 ms; 32K-key context: ~-0.6 ms.
+- window, after the transfer discount this project measures (50-70%): -0.4 to -0.9 ms (plan: -0.6 to -1.0).
+
+Knobs: ``TF_DSV41_ATTN_CUDA`` (0 / 1); ``TF_DSV41_ATTN_CUDA_PARTS`` (``attn,topk``: either alone for A/B);
+``TF_DSV41_ATTN_CUDA_ROWS`` (64: the largest window either part takes; bits are the same either side).
+"""
+
+from __future__ import annotations
+
+import os
+import re
+from functools import lru_cache
+
+NCH = 5
+BMQ = 16
+MAX_ROWS = 64
+TOPK_THREADS = 512
+MAX_CL = 8
+MAX_EPT = 31                      # entries a thread a CTA (odd: conflict-free runs); 512 x 31 x 4 B = 62 KB
+ENTRIES_A_CTA = 4096              # cluster size: one CTA a ~4K entries, up to 8
+
+
+def enabled() -> bool:
+    return (os.environ.get("TF_DSV41_ATTN_CUDA", "").strip() or "0") not in ("0", "off", "no", "false")
+
+
+def parts() -> set[str]:
+    v = (os.environ.get("TF_DSV41_ATTN_CUDA_PARTS", "").strip() or "attn,topk").replace(" ", "")
+    got = {p for p in v.split(",") if p}
+    if not got <= {"attn", "topk"}:
+        raise ValueError(f"TF_DSV41_ATTN_CUDA_PARTS={v!r}: attn and / or topk")
+    return got
+
+
+def max_rows() -> int:
+    n = int(os.environ.get("TF_DSV41_ATTN_CUDA_ROWS", "").strip() or MAX_ROWS)
+    if not 1 <= n <= MAX_ROWS:
+        raise ValueError(f"TF_DSV41_ATTN_CUDA_ROWS={n} (1..{MAX_ROWS})")
+    return n
+
+
+def on(part: str) -> bool:
+    return enabled() and part in parts()
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    from pathlib import Path
+
+    from tensorfold.cuda.build import CLUSTERS, load
+
+    here = Path(__file__).parent
+    return load(name="tf_dsv41_attn_cuda_v1", need=CLUSTERS,
+                sources=[str(here / "attn_cuda.cpp"), str(here / "attn_cuda.cu"), str(here / "topk_cuda.cu")],
+                extra_cuda_cflags=["-O3", "-lineinfo", "--fmad=false"], verbose=False)
+
+
+def info(device: int = 0) -> dict:
+    sms, optin, cl, blocks, smem = _ext().info(device)
+    return {"sms": sms, "smem_optin": optin, "cluster_launch": bool(cl), "attn_ctas_per_sm": blocks,
+            "attn_smem": smem}
+
+
+# ---- Triton's dot-operand layout of _chunks on this GPU (the k order of the mma chains) ---------------------------
+
+def parse_layout(ttgir: str) -> int | None:
+    """kWidth of _chunks' dot operands from its TTGIR, or None when the layout is not the one attn_cuda.cu mirrors
+    (nvidia_mma v2, warpsPerCTA [1, 8], instrShape [16, 8], bf16 operands with kWidth 2 or 4)."""
+
+    mma = re.findall(r"#ttg\.nvidia_mma<\{versionMajor = (\d+), versionMinor = \d+, warpsPerCTA = \[([0-9, ]+)\], "
+                     r"instrShape = \[([0-9, ]+)\]\}>", ttgir)
+    if len(mma) != 1 or mma[0][0] != "2" or mma[0][1].replace(" ", "") != "1,8" or \
+            mma[0][2].replace(" ", "") != "16,8":
+        return None
+    kw = set(re.findall(r"dot_op<\{opIdx = \d, parent = #mma, kWidth = (\d+)\}>", ttgir))
+    if len(kw) != 1 or not {"2", "4"} >= kw:
+        return None
+    return int(kw.pop())
+
+
+def chunks_ttgir(target=None) -> str:
+    """_chunks compiled for ``target`` (default: this GPU) with the decode constexprs (row mode, paged)."""
+
+    import triton
+    from triton.compiler import ASTSource
+
+    from . import attn as A
+
+    sig = {"Q": "*bf16", "CV": "*u8", "CSC": "*u8", "cvs": "i64", "css": "i64", "TOK": "*i32", "t_stride": "i32",
+           "CNT": "*i32", "SV": "*u8", "SSC": "*u8", "svs": "i64", "sss": "i64", "LO": "*i32", "HI": "*i32",
+           "POS": "*i64", "PO": "*fp32", "PM": "*fp32", "PL": "*fp32", "R": "i32", "PT": "*i32", "SL": "*i64",
+           "PTS": "i64"}
+    cst = dict(H=32, CH=A.CH, NCOMP=A.NCOMP, KT=A.KT, BMQ=A.BMQ, SCALE=A.D ** -0.5, RING=128, WINDOW=A.WINDOW,
+               HAS_HI=False, PSH=4, ROWS=True, PDL=False)
+    sig.update({k: "constexpr" for k in cst})
+    if target is None:
+        target = triton.runtime.driver.active.get_current_target()
+    k = triton.compile(ASTSource(fn=A._chunks, signature=sig, constexprs=cst), target=target,
+                       options={"num_warps": A.WARPS, "num_stages": A.STAGES})
+    return k.asm["ttgir"]
+
+
+_KW: dict = {}
+
+
+def kwidth() -> int | None:
+    """Triton's kWidth for _chunks on this GPU (cached; None: unknown layout or no compiler -> attention stays
+    Triton). ``TF_DSV41_ATTN_CUDA_KWIDTH`` (2 / 4) overrides, for tests."""
+
+    v = os.environ.get("TF_DSV41_ATTN_CUDA_KWIDTH", "").strip()
+    if v:
+        return int(v) if v in ("2", "4") else None
+    if "kw" not in _KW:
+        try:
+            _KW["kw"] = parse_layout(chunks_ttgir())
+        except Exception as e:  # noqa: BLE001 - no compiler for this target: keep Triton
+            print(f"[attn_cuda] Triton layout unknown ({type(e).__name__}: {str(e)[:120]}): attention stays Triton",
+                  flush=True)
+            _KW["kw"] = None
+    return _KW["kw"]
+
+
+# ---- attention -----------------------------------------------------------------------------------------------------
+
+class Ticket:
+    """The per-(row, head tile) counters of the last-arriver merge (zeroed once; each launch leaves them at 0)."""
+
+    def __init__(self, rows: int, heads: int, device) -> None:
+        import torch
+
+        self.t = torch.zeros((max(1, rows * heads // BMQ),), dtype=torch.int32, device=device)
+
+
+def _ok_rows(t, elems: int) -> bool:
+    return t.stride(-1) == 1 and t.data_ptr() % elems == 0 and t.stride(0) % elems == 0
+
+
+def why_not_attn(q, rows, tokens, counts, swa, lo, scratch, ticket, ring: int, page_table, slots, hi=None, cs=None,
+                 sink=None) -> str | None:
+    import torch
+
+    if not on("attn"):
+        return "off"
+    R, H, D = q.shape
+    if not 0 < R <= max_rows() or R > scratch.rows or H % BMQ or D != 512 or H != scratch.heads:
+        return "shape"
+    if q.device.type != "cuda" or q.dtype != torch.bfloat16 or not q.is_contiguous():
+        return "q"
+    if ticket is None or ticket.t.numel() < R * H // BMQ:
+        return "ticket"
+    if ring < 128 or ring & (ring - 1):
+        return "ring"
+    for v, s in [swa] + ([rows] if rows is not None else []):
+        if not (_ok_rows(v, 8) and _ok_rows(s, 8)):
+            return "row alignment"
+    if rows is not None:
+        if tokens is None or tokens.dtype != torch.int32 or tokens.stride(1) != 1 or tokens.shape[1] > 512 \
+                or counts is None or counts.dtype != torch.int32 or not counts.is_contiguous():
+            return "selection"
+        if page_table is not None and (page_table.dtype != torch.int32 or page_table.stride(-1) != 1):
+            return "page table"
+        if page_table is not None and page_table.dim() == 2 and slots is None:
+            return "stacked page tables without row mode"
+    if lo.dtype != torch.int32 or not lo.is_contiguous():
+        return "lo"
+    if hi is not None and (hi.dtype != torch.int32 or not hi.is_contiguous()):
+        return "hi"
+    if cs is not None and (cs.dtype != torch.float32 or cs.stride(1) != 1):
+        return "rope table"
+    if sink is not None and (sink.dtype != torch.float32 or not sink.is_contiguous()):
+        return "sink"
+    if kwidth() is None:
+        return "triton layout"
+    return None
+
+
+def attention(q, rows, tokens, counts, swa, lo, pos, sink, cs, out, scratch, ticket, *, ring: int, hi=None,
+              page_table=None, page_shift: int = 0, slots=None):
+    """``attn.attention``'s arguments (+ the ``Ticket``) -> ``out`` (the same bits), or None when the CUDA path does
+    not take the call (the caller runs Triton)."""
+
+    import torch
+
+    if why_not_attn(q, rows, tokens, counts, swa, lo, scratch, ticket, ring, page_table, slots, hi, cs,
+                    sink) is not None:
+        return None
+    R, H, _ = q.shape
+    n = NCH * R * H
+    e = torch.empty((0,), dtype=torch.int32, device=q.device)
+    cv, csc = rows if rows is not None else (e.view(torch.uint8), e.view(torch.uint8))
+    pt = page_table if (rows is not None and page_table is not None and page_shift > 0) else e
+    pts = page_table.stride(0) if (pt.numel() and page_table.dim() == 2) else 0
+    sl = slots.to(torch.int64) if slots is not None else e.to(torch.int64)
+    if slots is not None:
+        pos = pos.to(torch.int64)
+    elif pos.dtype != torch.int32:
+        pos = pos.to(torch.int32)
+    _ext().attn(q, cv, csc, tokens if rows is not None else e, counts if rows is not None else e, swa[0], swa[1],
+                lo, hi if hi is not None else e, pos, sl, pt, sink, cs, scratch.po[:n * 512], scratch.pm[:n],
+                scratch.pl[:n], out, ticket.t, ring, page_shift if pt.numel() else 0, pts, kwidth())
+    return out
+
+
+# ---- top-k ---------------------------------------------------------------------------------------------------------
+
+def plan(nk: int, cl: int | None = None) -> tuple[int, int] | None:
+    """(cluster CTAs, entries a thread) for ``nk`` entries; None past 8 x 512 x 31 (the Triton dtopk runs)."""
+
+    if cl is None:
+        cl = max(1, min(MAX_CL, -(-nk // ENTRIES_A_CTA)))
+    ept = max(1, -(-nk // (cl * TOPK_THREADS)))
+    ept += 1 - ept % 2                                          # odd: a thread's run is bank-conflict free
+    return (cl, ept) if ept <= MAX_EPT else None
+
+
+def _go(nk: int, R: int) -> bool:
+    return on("topk") and 0 < R <= max_rows() and plan(nk) is not None
+
+
+def _job(s, cand, k: int, mode: int, block: int, count: bool, cl: int):
+    import torch
+
+    R = s.shape[0]
+    nk = -(-s.shape[1] // block) if mode == 2 else s.shape[1]
+    out = torch.empty((R, k), dtype=torch.int32, device=s.device)
+    cnt = torch.empty((R,), dtype=torch.int32, device=s.device) if count else out[:0, 0]
+    return [s, cand, out, cnt, nk, k, mode, plan(nk, cl)[1]]
+
+
+def _run(jobs: list, pos, ratio: int, block: int, cl: int):
+    import torch
+
+    e = torch.empty((0,), dtype=torch.int32, device=jobs[0][0].device)
+    flat = []
+    for j in (jobs + jobs)[:2]:
+        s, cand, out, cnt = j[:4]
+        flat += [s, cand if cand is not None else e, out, cnt, *j[4:]]
+    _ext().topk(*flat, len(jobs), pos, ratio, block, jobs[0][0].shape[0], cl)
+
+
+def _checked(s) -> bool:
+    import torch
+
+    return s.dtype == torch.float32 and s.stride(1) == 1 and s.device.type == "cuda"
+
+
+def select(s, pos, ratio: int, topk: int, *, rows: bool = False):
+    """``dtopk.select``'s result (sel int32 [R, topk], visible counts [R]) or None (dtopk runs)."""
+
+    if not (_checked(s) and _go(s.shape[1], s.shape[0])):
+        return None
+    cl = plan(s.shape[1])[0]
+    job = _job(s, None, topk, 0, 1, True, cl)
+    _run([job], pos, ratio, 1, cl)
+    return job[2], job[3]
+
+
+def blocks(s, pos, ratio: int, topk_blocks: int, *, block: int = 8, rows: bool = False):
+    """``dtopk.blocks``' result (candidate blocks int32 [R, topk_blocks]) or None."""
+
+    nb = -(-s.shape[1] // block)
+    if not (_checked(s) and _go(nb, s.shape[0])):
+        return None
+    cl = plan(nb)[0]
+    job = _job(s, None, topk_blocks, 2, block, False, cl)
+    _run([job], pos, ratio, block, cl)
+    return job[2]
+
+
+def select_blocks(s, pos, ratio: int, topk: int, topk_blocks: int, *, block: int = 8, rows: bool = False):
+    """The candidate source's select + blocks over the same scores in ONE launch: (sel, counts, blocks) or None."""
+
+    if not (_checked(s) and _go(s.shape[1], s.shape[0])):
+        return None
+    cl = plan(s.shape[1])[0]
+    sj = _job(s, None, topk, 0, 1, True, cl)
+    bj = _job(s, None, topk_blocks, 2, block, False, cl)
+    _run([sj, bj], pos, ratio, block, cl)
+    return sj[2], sj[3], bj[2]
+
+
+def gather_cand(s, cand, pos, ratio: int, topk: int, *, block: int = 8, rows: bool = False):
+    """``dtopk.gather_cand``'s result (sel, counts) or None. ``cand``: ascending candidate blocks, -1 last."""
+
+    import torch
+
+    if not (_checked(s) and _go(s.shape[1], s.shape[0])) or cand.dtype != torch.int32 or cand.stride(1) != 1 \
+            or s.shape[1] != cand.shape[1] * block:
+        return None
+    cl = plan(s.shape[1])[0]
+    job = _job(s, cand, topk, 3, block, True, cl)
+    _run([job], pos, ratio, block, cl)
+    return job[2], job[3]
+
+
+__all__ = ["MAX_ROWS", "Ticket", "attention", "blocks", "enabled", "gather_cand", "info", "kwidth", "on", "parts",
+           "plan", "select", "select_blocks", "why_not_attn"]
