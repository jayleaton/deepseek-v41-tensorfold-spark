--- /dev/null
+++ b/tests/cuda/test_dsv41_dense3_gpu.py
@@ -0,0 +1,206 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G13 ``dense3``: the lanes-layout EXL3 linears (``dense3`` / ``dense3.cu``, TF_DSV41_DENSE_V3) on the GPU, bit for
+bit against x3seg (fused_proj on the same matrices in upstream's strips layout):
+
+- the relayout kernels == the numpy reference (``dsv41_dense3_emu``) and ``to_strips(to_lanes(w)) == w`` in place,
+  every width; the lanes unpack == upstream's ``unpack`` (fast prefill's W_q); ``prefill_mm.matmul`` over a lanes
+  matrix == over its strips twin (column blocks too);
+- random trellises at the real group shapes (x: wq_a + wkv + compressor; x2 at 6 bits; qr: the 8-warp wq_b + the
+  4-warp indexer in one launch; wo_a's 4 groups from column slices), R = 1..16, 64, 128, 130, bf16 and fp32, at both
+  occupancies (TF_DSV41_DENSE_V3_MINB 3,1 and 4,2): every output element == x3seg's; counters back at zero; a CUDA
+  graph replayed on new inputs; ``Lanes.__call__`` (wo_b's single launch) == upstream's ``Exl3Linear``;
+- the real weights (``TF_DSV41_TEST_MODEL``, default /model; rank ``TF_DSV41_TEST_RANK``; layers
+  ``TF_DSV41_D3_LAYERS``, default all): every dense output of ``blocks.attention`` with ``mark`` (V3 on) == x3seg's
+  at R = 1..16, the rows of a 16-row window == the rows alone, and ``to_strips`` gives the loaded words back;
+- [G13] lines: COLD-L2 us (densebench.cold_us: a 256 MB write before every call) x3seg -> dense3 a group at R = 1.
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA")
+
+BF, F32 = torch.bfloat16, torch.float32
+
+
+def _lin(k: int, n: int, k2: int, seed: int):
+    from tensorfold.cuda.exl3.linear import Exl3Linear
+
+    g = torch.Generator().manual_seed(seed)
+    tr = torch.randint(-32768, 32767, (k // 16, n // 16, 8 * k2), generator=g, dtype=torch.int32).to(torch.int16)
+    suh = torch.where(torch.rand(k, generator=g) < 0.5, -1.0, 1.0).to(torch.float16)
+    svh = (torch.rand(n, generator=g) * 0.02 + 0.01).to(torch.float16)
+    return Exl3Linear.from_tensors(tr, suh, svh, "mul1", device="cuda"), tr
+
+
+def _twin(lin):
+    """A strips copy of ``lin`` and a lanes copy (separate words), the same scales and plan."""
+
+    from dataclasses import replace
+
+    from tensorfold.families.deepseek_v41.cuda import dense3 as D3
+
+    a = replace(lin, words=lin.words.clone())
+    b = replace(lin, words=lin.words.clone())
+    D3.to_lanes(b)
+    return a, b
+
+
+@pytest.mark.parametrize("k2", [4, 6, 8, 10, 12])
+def test_relayout_unpack_and_prefill(k2):
+    import dsv41_dense3_emu as E
+
+    from tensorfold.families.deepseek_v41.cuda import dense3 as D3
+    from tensorfold.families.deepseek_v41.cuda import prefill_mm as PM
+
+    lin, tr = _lin(512, 640, k2, k2)
+    want = E.to_lanes(E.strips_of(tr.numpy()), k2)
+    s, ln = _twin(lin)
+    assert np.array_equal(ln.words.cpu().numpy().view(np.uint32), want)
+    assert torch.equal(s.unpack(), ln.unpack())                      # lanes W_q == upstream's W_q
+    x = torch.randn((37, 512), device="cuda").to(BF)
+    for limit in (1 << 30, 512 * 2 * 256):                            # whole, and 2-strip column blocks
+        ya = PM.matmul(s, x, F32, PM.column_blocks(s, limit))
+        yb = PM.matmul(ln, x, F32, PM.column_blocks(ln, limit))
+        assert torch.equal(ya, yb)
+    D3.to_strips(ln)
+    assert torch.equal(ln.words, lin.words) and type(ln) is type(lin)
+
+
+GROUPS = {
+    "x4": ([(5120, 1280, 10), (5120, 512, 10), (5120, 512, 10), (5120, 512, 10)], [0, 1, 2, 2]),
+    "x2_l0": ([(5120, 1280, 12), (5120, 512, 12)], [0, 1]),
+    "q": ([(1280, 16384, 10), (1280, 4096, 10)], [0, 1]),
+    "o": ([(4096, 1024, 10)] * 4, [0, 0, 0, 0]),
+}
+
+
+@pytest.fixture(scope="module")
+def groups():
+    from tensorfold.families.deepseek_v41.cuda import fused_proj as FP
+
+    out = {}
+    for i, (name, (shapes, outs)) in enumerate(GROUPS.items()):
+        pairs = [_twin(_lin(k, n, k2, 100 * i + j)[0]) for j, (k, n, k2) in enumerate(shapes)]
+        s, ln = [p[0] for p in pairs], [p[1] for p in pairs]
+        out[name] = (FP.Fused(s, outs), FP.Fused(ln, outs), ln)
+    return out
+
+
+def _inputs(name, k, R, gen):
+    if name == "o":
+        o = (torch.randn((R, 4 * 4096), generator=gen, device="cuda") * 0.3).to(BF)
+        return [o[:, g * 4096:(g + 1) * 4096] for g in range(4)]
+    return torch.randn((R, k), generator=gen, device="cuda").to(BF)
+
+
+@pytest.mark.parametrize("minb", ["3,1", "4,2"])
+@pytest.mark.parametrize("name", list(GROUPS))
+def test_groups_equal_x3seg(groups, name, minb, monkeypatch):
+    monkeypatch.setenv("TF_DSV41_DENSE_V3_MINB", minb)
+    ref, d3, _ = groups[name]
+    assert d3.lanes and not ref.lanes
+    gen = torch.Generator(device="cuda").manual_seed(3)
+    for R in [*range(1, 17), 64, 128, 130]:
+        xs = _inputs(name, GROUPS[name][0][0][0], R, gen)
+        for dtype in (BF, F32) if R in (1, 5, 16, 130) else (BF,):
+            got, want = d3(xs, dtype), ref(xs, dtype)
+            assert all(torch.equal(a, b) for a, b in zip(got, want)), (name, R, dtype, minb)
+    assert not (d3.counters != 0).any()
+
+
+def test_graph_replay_and_single_calls(groups):
+    from tensorfold.families.deepseek_v41.cuda import dense3 as D3
+
+    ref, d3, _ = groups["x4"]
+    gen = torch.Generator(device="cuda").manual_seed(4)
+    x = torch.randn((3, 5120), generator=gen, device="cuda").to(BF)
+    s = torch.cuda.Stream()
+    s.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(s):
+        d3(x, BF)
+    torch.cuda.current_stream().wait_stream(s)
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        ys = d3(x, BF)
+    for _ in range(3):
+        x.copy_(torch.randn((3, 5120), generator=gen, device="cuda").to(BF))
+        g.replay()
+        torch.cuda.synchronize()
+        assert all(torch.equal(a, b) for a, b in zip(ys, ref(x, BF)))
+        assert not (d3.counters != 0).any()
+    up, ln = _twin(_lin(4096, 5120, 10, 7)[0])                       # wo_b: linear.Exl3 -> Lanes.__call__
+    assert isinstance(ln, D3.Lanes)
+    for R in (1, 2, 7, 130):
+        z = torch.randn((R, 4096), generator=gen, device="cuda").to(BF)
+        # upstream's linear takes <= 128 rows a call (G13: R 130 raised there): the reference runs in 128-row pieces
+        want = torch.cat([up(z[i:i + 128], out_dtype=F32) for i in range(0, R, 128)], 0)
+        assert torch.equal(ln(z, out_dtype=F32), want)
+
+
+def test_cold_us_x3seg_vs_dense3(groups):
+    from tensorfold.families.deepseek_v41.cuda import densebench as DB
+
+    gen = torch.Generator(device="cuda").manual_seed(5)
+    for name, (ref, d3, lins) in groups.items():
+        xs = _inputs(name, GROUPS[name][0][0][0], 1, gen)
+        mb = sum(lin.words.numel() * 4 for lin in lins) / 1e6
+        a = DB.cold_us(lambda ref=ref, xs=xs: ref(xs, BF), 20)
+        b = DB.cold_us(lambda d3=d3, xs=xs: d3(xs, BF), 20)
+        print(f"[G13] dense3 {name} ({mb:.1f} MB, random weights) R=1 cold L2: x3seg {a:.1f} us {mb / a * 1e3:.0f} "
+              f"GB/s -> dense3 {b:.1f} us {mb / b * 1e3:.0f} GB/s")
+
+
+# -- the real weights -----------------------------------------------------------------------------------------------
+def _model() -> Path | None:
+    p = Path(os.environ.get("TF_DSV41_TEST_MODEL", "/model"))
+    return p if (p / "config.json").is_file() else None
+
+
+@pytest.mark.skipif(_model() is None, reason="TF_DSV41_TEST_MODEL: the checkpoint folder")
+def test_real_layers_dense3_equals_x3seg(monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda import dense3 as D3
+    from tensorfold.families.deepseek_v41.cuda import fused_proj as FP
+    from tensorfold.families.deepseek_v41.cuda import projbench as PB
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+    from tensorfold.families.deepseek_v41.cuda.config import Config
+
+    root = _model()
+    cfg = Config.from_file(root / "config.json")
+    rank = int(os.environ.get("TF_DSV41_TEST_RANK", "0"))
+    raw = os.environ.get("TF_DSV41_D3_LAYERS", "all")
+    layers = range(cfg.num_hidden_layers) if raw == "all" else [int(v) for v in raw.split(",")]
+    ld = W.Loader(cfg, W.Shards(root), rank, 2, "cuda")
+    gen = torch.Generator(device="cuda").manual_seed(rank)
+    repacked = 0
+    for L in layers:
+        A = PB.attn_of(cfg, ld, L, "cuda")
+        G0 = FP.build(A)                                              # x3seg (V3 off)
+        x16 = torch.randn((16, cfg.hidden_size), generator=gen, device="cuda").to(BF)
+        qr16 = torch.randn((16, cfg.q_lora_rank), generator=gen, device="cuda").to(BF)
+        o16 = (torch.randn((16, 16384), generator=gen, device="cuda") * 0.3).to(BF)
+        want = {R: PB.dense(A, G0, x16[:R], qr16[:R], o16[:R], True) for R in range(1, 17)}
+        loaded = [lin.words.clone() for lin in D3.attn_lins(A)]
+        monkeypatch.setenv(D3.ENV, "1")
+        G1 = FP.build(A)                                              # mark: repacked in place
+        monkeypatch.delenv(D3.ENV)
+        assert all(D3.is_lanes(lin) for lin in D3.attn_lins(A)), L
+        repacked += len(loaded)
+        whole = PB.dense(A, G1, x16, qr16, o16, True)
+        for R in range(1, 17):
+            got = PB.dense(A, G1, x16[:R], qr16[:R], o16[:R], True)
+            assert len(got) == len(want[R]) and all(torch.equal(a, b) for a, b in zip(got, want[R])), (L, R)
+            assert all(torch.equal(a, b[:R]) for a, b in zip(got, whole)), (L, R)
+        for lin, w in zip(D3.attn_lins(A), loaded):
+            D3.to_strips(lin)
+            assert torch.equal(lin.words, w), L
+        del A, G0, G1
+    print(f"[G13] dense3 real layers {next(iter(layers))}..{list(layers)[-1]} rank {rank}: {repacked} matrices repacked; "
+          f"every dense output == x3seg at R = 1..16, rows of a window == alone, to_strips == the loaded words")
