+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G8 tree verification on the GPU (``tree.py`` / ``shadow.py``, TF_DSV41_TREE; collected only where PyTorch sees an
+NVIDIA GPU), on the synthetic DSpark checkpoint with the Triton CSA2 / DSpark kernels and upstream's EXL3:
+
+- tree rounds by hand (the chain wins, sibling 1 wins, sibling 2 wins with 1-3 drafts kept, past a 256-token page
+  and position 2,048), three forwards: row graphs + tree, eager + tree, eager without the tree. The presented
+  branch's candidates are the same bits in all three (graph replay == eager; a branch == the chain run alone), and
+  after every commit the slot's committed state (SWA rings, compressed rows, index keys, carries, lookback) and the
+  next DSpark drafts are the same bytes: rejected branches never reach the slot;
+- replies through the batcher with the tree on (oracle siblings: the serial token as a sibling when the chain's first
+  draft is wrong), row + draft graphs, 4 slots and 1 slot, T = 0 and T > 0, past 2,048 tokens == serial;
+- ``[G8-tree]`` lines: the host ms of a tree round's fork + resolve.
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_tree_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import time
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+import dsv41_dspark_fakes as DF  # noqa: E402
+from test_dsv41_tree import _committed, _greedy, _oracle, _same  # noqa: E402
+
+from tensorfold.engine.exact_sampling import Sampling  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import draft_graphs as DG  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import rowgraphs as RG  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.batch import Job  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.depth import Costs  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.pool import Pool  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece, Rows, accepted  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.tree import Branches  # noqa: E402
+
+DEV = "cuda"
+LONG = 4096
+SAMPLINGS = [None, Sampling(seed=7, temperature=0.8, top_k=20, top_p=0.95), None,
+             Sampling(seed=11, temperature=1.1, top_k=0, top_p=0.9, min_p=0.02)]
+PROMPTS = [[int(t) for t in np.random.default_rng(90 + i).integers(3, 250, size=2030 + 5 * i)] for i in range(4)]
+N = 32
+SETTINGS = {"on": True, "budget_s": 300.0, "max_graphs": 128, "bucket": 2048, "slots": 4, "warm": "decode",
+            "floor_gib": 0.0}
+
+
+@pytest.fixture(autouse=True)
+def _torch_seams(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")       # the mHC / Engram kernels are laid out for D = 5,120
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41treegpu"))
+
+
+def _bound(ck, tree: bool, graphs: bool, monkeypatch):
+    monkeypatch.setenv("TF_DSV41_TREE", "3" if tree else "0")
+    fw = DF.forward(ck, slots=1, limit=LONG, device=DEV, chunk=128)
+    pool = Pool(ck[3], (LONG // 256 + 8) * 256, device=fw.device)
+    ps = [pool.new_slot(LONG)]
+    fw.bind(ps)
+    if graphs:
+        fw.graphs = RG.make(fw, settings=SETTINGS)
+        fw.graphs.warmup(1, lambda s, end: ps[s].ensure(end))
+    ps[0].ensure(LONG)
+    return fw
+
+
+def _truth(fw, P, pending, n):
+    out, toks = [], [pending]
+    for _ in range(n):
+        c = fw.window([Rows(0, P, tuple(toks))], count=4)
+        out.append(_greedy(c, len(toks) - 1, 1)[0])
+        toks.append(out[-1])
+    fw.slots[0].pending = None
+    return out
+
+
+def test_tree_rounds_graphs_eager_plain(ck, monkeypatch):
+    g, e, p = (_bound(ck, True, True, monkeypatch), _bound(ck, True, False, monkeypatch),
+               _bound(ck, False, False, monkeypatch))
+    prompt = PROMPTS[0][:2040]
+    for fw in (g, e, p):
+        fw.reset(0)
+        fw.prefill([Piece(0, 0, tuple(prompt[:-1]))], mode="full")
+    pending, wins, host = prompt[-1], [], []
+    for r in range(15):                                # 2,039 -> past 2,048 (context bucket 1) and page 8's boundary
+        P = g.slots[0].pos
+        t = _truth(p, P, pending, 3)
+        bad = [x for x in range(3 + r, 250) if x not in t][:3]
+        case = r % 3
+        if case == 0:
+            main, sibs = [pending, t[0], t[1], bad[0]], [[pending, bad[1], t[1]], [pending, bad[2]]]
+        elif case == 1:
+            main, sibs = [pending, bad[0]], [[pending, t[0], t[1], bad[1]], [pending, bad[2]]]
+        else:
+            main, sibs = [pending, bad[0], t[1]], [[pending, bad[1]], [pending, *t]]
+        cands = []
+        for fw in (g, e):
+            torch.cuda.synchronize()
+            t0 = time.perf_counter()
+            br = Branches(P, tuple(main))
+            for j, toks in enumerate(sibs, 1):
+                br.sib.append((j, fw.tree.shadows.fork(0, j, P, len(toks)), tuple(toks), 0.5))
+            fw.tree.plans = {0: br}
+            fw.depth.choose(0, [0.5] * (len(main) - 1), len(main) - 1)
+            cands.append(fw.window([Rows(0, P, tuple(main))], count=4))
+            shown = fw.took([Rows(0, P, tuple(main))])[0]
+            if fw is g:
+                host.append((time.perf_counter() - t0) * 1e3)
+        cp = p.window([shown], count=4)
+        for c in cands:
+            assert np.array_equal(c.ids, cp.ids) and np.array_equal(c.values, cp.values), r
+        chosen = _greedy(cp, 0, len(shown.tokens))
+        acc = accepted(shown.tokens, chosen)
+        wins.append((g.tree.won[0][0], acc))
+        for fw in (g, e, p):
+            fw.commit(0, acc)
+        ref = _committed(p)
+        _same(_committed(g), ref)
+        _same(_committed(e), ref)
+        d = [fw.drafter.propose([0], [chosen[acc]], [fw.slots[0].pos]) for fw in (g, e, p)]
+        assert d[0] == d[2] and d[1] == d[2]
+        pending = chosen[acc]
+    assert {w for w, _ in wins} == {0, 1, 2} and g.slots[0].pos > 2048
+    assert g.graphs.cache.stats["replays"] > 0
+    print(f"[G8-tree] tree rounds by hand: {len(wins)} rounds, wins {wins}; host ms (fork + window + resolve, "
+          f"graphs) median {np.median(host):.2f}")
+
+
+def _replies(ck, monkeypatch, slots, ix, serial):
+    monkeypatch.setenv("TF_DSV41_TREE", "3")
+    monkeypatch.setenv("TF_DSV41_TREE_ROWS", "3")
+    fw = DF.forward(ck, slots=slots, limit=LONG, device=DEV, chunk=128)
+    b = DF.batcher(ck, fw, n=slots, capacity=LONG, pool_tokens=(slots + 2) * LONG)
+    fw.graphs = RG.make(fw, settings=SETTINGS)
+    fw.graphs.warmup(slots, lambda s, end: b.ex.slots[s].ensure(end))
+    fw.drafter.graphs = DG.DraftGraphs(fw.drafter, settings=SETTINGS)
+    fw.drafter.graphs.warmup()
+    for s in b.ex.slots:
+        s.release()
+    c = Costs([10.0] * 16, 1.0)
+    fw.set_costs(c)
+    b.planner.costs = c
+    _oracle(fw, [PROMPTS[i] + serial[i] for i in ix])
+    t0 = time.perf_counter()
+    got = DF.run(b, [Job(PROMPTS[i], N, SAMPLINGS[i]) for i in ix])
+    assert got == [serial[i] for i in ix]
+    st = fw.tree.stats
+    assert st["trees"] > 0 and st["sib_wins"] > 0
+    assert fw.graphs.cache.stats["replays"] > 0 and fw.drafter.graphs.cache.stats["replays"] > 0
+    print(f"[G8-tree] replies == serial, {slots} slot(s), {time.perf_counter() - t0:.1f} s: {fw.tree.describe()}")
+
+
+@pytest.fixture(scope="module")
+def serial(ck):
+    with pytest.MonkeyPatch.context() as mp:
+        mp.setenv("TF_DSV41_SEAMS", "torch")
+        mp.setenv("TF_DSV41_TREE", "0")
+        bs = DF.batcher(ck, DF.forward(ck, slots=1, limit=LONG, dspark=False, device=DEV, chunk=128),
+                        capacity=LONG, pool_tokens=2 * LONG, depth=0)
+        return DF.run(bs, [Job(p, N, s) for p, s in zip(PROMPTS, SAMPLINGS)])
+
+
+def test_tree_replies_equal_serial_four_slots(ck, serial, monkeypatch):
+    _replies(ck, monkeypatch, 4, [0, 1, 2, 3], serial)
+
+
+def test_tree_replies_equal_serial_one_slot(ck, serial, monkeypatch):
+    _replies(ck, monkeypatch, 1, [1, 2], serial)
