@@ -0,0 +1,203 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Self-distillation data for DSpark from drafting logs (``draftlog`` with TF_DSV41_DRAFT_LOG_TAPS=1): a folder of
+per-session arrays that ``dsparktrain`` reads with memory maps.
+
+For every session (a request on a slot, between two ``r`` events) and every position q of its decode:
+
+- ``tok[q]``: the committed token (pending tokens and every commit's kept drafts + bonus);
+- ``taps[q]``: the drafter's input row at q (bf16 bits [3 D]: the streams' mean entering layers 37-39, the rows the
+  engine ingests into the DSpark rings), ``has_taps[q]``;
+- ``lab_ids[q]`` / ``lab_val[q]``: the target's top-K (ids, logits) of the token at q, from the verify row that
+  chose it (a row whose prefix was serial: rows 0 .. accepted of the window committed at that round), ``has_lab[q]``;
+- ``drafts[q]``: the engine's drafts of the pass logged at q (-1 when none): the baseline fidelity check.
+
+A training example is a position P with taps before it, its token and the labels of P + 1 .. P + N: the DSpark pass
+the engine would run there (block-parallel, teacher forced: the Markov head sees the serial tokens).
+
+CLI: python -m tensorfold.families.deepseek_v41.cuda.dsparkdata OUT LOGDIR [LOGDIR ...]
+"""
+
+from __future__ import annotations
+
+import glob
+import json
+import os
+import pickle
+import sys
+
+import numpy as np
+
+PAD_VAL = -60000.0
+
+
+def _files(folder: str) -> list[str]:
+    return sorted(glob.glob(os.path.join(folder, "draftlog-*.pkl")),
+                  key=lambda f: (os.path.basename(f).split("-")[1], f))
+
+
+class _Sess:
+    def __init__(self, sid: int) -> None:
+        self.sid = sid
+        self.tok: dict = {}
+        self.taps: dict = {}
+        self.lab: dict = {}
+        self.drafts: dict = {}
+        self.wins: dict = {}            # start -> (tokens, ids, values) of the slot's last window there
+
+
+def _flush(s: _Sess, out: str, K: int, meta: list, min_tokens: int = 8) -> None:
+    lab_pos = sorted(s.lab)
+    if len(lab_pos) < min_tokens or not s.taps:
+        return
+    lo = min(min(s.taps), min(s.tok))
+    hi = max(max(s.tok), max(lab_pos), max(s.taps), max(s.drafts, default=0)) + 1   # a tap / draft row past the last
+    # token or label (a session's final pass) must fit too (G11: IndexError at 400 of 400)
+    L = hi - lo
+    D3 = next(iter(s.taps.values())).shape[-1]
+    tok = np.full(L, -1, np.int32)
+    taps = np.zeros((L, D3), np.int16)
+    has_taps = np.zeros(L, bool)
+    lab_ids = np.full((L, K), -1, np.int32)
+    lab_val = np.full((L, K), PAD_VAL, np.float16)
+    has_lab = np.zeros(L, bool)
+    drafts = np.full((L, 5), -1, np.int32)
+    for q, t in s.tok.items():
+        tok[q - lo] = t
+    for q, row in s.taps.items():
+        taps[q - lo] = row
+        has_taps[q - lo] = True
+    for q, (ids, vals) in s.lab.items():
+        k = min(K, len(ids))
+        lab_ids[q - lo, :k] = ids[:k]
+        lab_val[q - lo, :k] = np.clip(vals[:k], -60000, 60000)
+        has_lab[q - lo] = True
+    for q, d in s.drafts.items():
+        drafts[q - lo, :min(5, len(d))] = d[:5]
+    name = f"s{s.sid:06d}"
+    np.save(os.path.join(out, f"{name}.taps.npy"), taps)
+    np.savez(os.path.join(out, f"{name}.npz"), tok=tok, has_taps=has_taps, lab_ids=lab_ids, lab_val=lab_val,
+             has_lab=has_lab, drafts=drafts, lo=np.int64(lo))
+    meta.append({"name": name, "lo": int(lo), "len": int(L), "labels": int(has_lab.sum()),
+                 "taps": int(has_taps.sum())})
+
+
+def build(out: str, logs: list[str], K: int = 32) -> dict:
+    """Every log folder's sessions -> ``out`` (``meta.json`` + per-session arrays)."""
+
+    os.makedirs(out, exist_ok=True)
+    meta: list = []
+    nxt = 0
+    for li, folder in enumerate(logs):
+        open_s: dict[int, _Sess] = {}
+        for f in _files(folder):
+            with open(f, "rb") as fh:
+                events = pickle.load(fh)["events"]
+            for kind, ev in events:
+                slot = ev.get("slot")
+                if kind == "r":
+                    if slot in open_s:
+                        _flush(open_s.pop(slot), out, K, meta)
+                    open_s[slot] = _Sess(nxt)
+                    nxt += 1
+                    continue
+                s = open_s.get(slot) if kind != "w" else None
+                if kind != "w" and s is None:
+                    s = open_s[slot] = _Sess(nxt)
+                    nxt += 1
+                if kind == "t":
+                    t = np.asarray(ev["taps"])
+                    for i in range(t.shape[0]):
+                        s.taps[ev["start"] + i] = t[i]
+                elif kind == "d":
+                    s.tok[ev["start"]] = int(ev["pending"])
+                    s.drafts[ev["start"]] = [int(x) for x in ev["drafts"]]
+                elif kind == "w":
+                    for g in ev["segs"]:
+                        ss = open_s.get(g["slot"])
+                        if ss is not None:
+                            ss.wins[g["start"]] = (list(g["tokens"]), g["ids"], g["values"])
+                elif kind == "k":
+                    if "bonus" not in ev or ev.get("start", -1) < 0:
+                        continue
+                    st, acc, toks = ev["start"], ev["accepted"], ev["tokens"]
+                    if toks:
+                        s.tok[st] = int(toks[0])
+                    got = list(toks[1:acc + 1]) + [ev["bonus"]]
+                    for i, t in enumerate(got):
+                        s.tok[st + 1 + i] = int(t)
+                    w = s.wins.pop(st, None)
+                    if w is not None and list(w[0][:acc + 1]) == list(toks[:acc + 1]):
+                        for r in range(min(acc + 1, len(w[1]))):
+                            s.lab[st + 1 + r] = (np.asarray(w[1][r]), np.asarray(w[2][r], np.float32))
+        for s in open_s.values():
+            _flush(s, out, K, meta)
+        print(f"[dsparkdata] {folder}: {len(meta)} sessions so far", flush=True)
+    info = {"K": K, "sessions": meta, "labels": sum(m["labels"] for m in meta), "logs": logs}
+    json.dump(info, open(os.path.join(out, "meta.json"), "w"), indent=1)
+    return info
+
+
+class Data:
+    """The folder's sessions (memory mapped taps) and the training examples (session, P)."""
+
+    def __init__(self, folder: str, n: int = 5, window: int = 128) -> None:
+        self.folder, self.n, self.window = folder, n, window
+        self.meta = json.load(open(os.path.join(folder, "meta.json")))
+        self.sess = []
+        for m in self.meta["sessions"]:
+            z = dict(np.load(os.path.join(folder, f"{m['name']}.npz")))
+            z["taps"] = np.load(os.path.join(folder, f"{m['name']}.taps.npy"), mmap_mode="r")
+            z["name"] = m["name"]
+            self.sess.append(z)
+
+    def examples(self, s: int) -> np.ndarray:
+        """Session-local P with a token, taps before, and labels (and tokens) at P + 1 .. P + n."""
+
+        z = self.sess[s]
+        L = len(z["tok"])
+        ok = (z["tok"] >= 0).copy()
+        cum = np.concatenate([[0], np.cumsum(z["has_taps"])])
+        for i in range(1, self.n + 1):
+            sh = np.zeros(L, bool)
+            sh[:L - i] = z["has_lab"][i:] & (z["tok"][i:] >= 0)
+            ok &= sh
+        before = cum[np.arange(L)] - cum[np.maximum(np.arange(L) - self.window, 0)]
+        return np.flatnonzero(ok & (before > 0))
+
+    def split(self, holdout: float = 0.1, seed: int = 0) -> tuple[list[int], list[int]]:
+        idx = np.random.default_rng(seed).permutation(len(self.sess))
+        k = max(1, int(round(len(idx) * holdout))) if len(idx) > 1 else 0
+        return sorted(idx[k:].tolist()), sorted(idx[:k].tolist())
+
+    def segments(self, sessions, S: int, rng: np.random.Generator | None = None) -> list[tuple[int, np.ndarray]]:
+        """(session, P array) chunks of at most S consecutive examples."""
+
+        out = []
+        for s in sessions:
+            ex = self.examples(s)
+            for a in range(0, len(ex), S):
+                out.append((s, ex[a:a + S]))
+        if rng is not None:
+            rng.shuffle(out)
+        return out
+
+    def batch(self, s: int, Ps: np.ndarray) -> dict:
+        """One segment: taps rows [a, b) (a = min P - window), the passes at Ps (indices into those rows)."""
+
+        z, n, W = self.sess[s], self.n, self.window
+        a = max(0, int(Ps.min()) - W)
+        b = int(Ps.max())
+        rows = np.arange(a, b)
+        return {"taps": np.ascontiguousarray(z["taps"][a:b]), "has_taps": z["has_taps"][a:b].copy(),
+                "pos": (rows + int(z["lo"])).astype(np.int64), "P": (Ps - a).astype(np.int64),
+                "Pabs": (Ps + int(z["lo"])).astype(np.int64), "anchor": z["tok"][Ps].astype(np.int64),
+                "serial": np.stack([z["tok"][Ps + 1 + i] for i in range(n)], 1).astype(np.int64),
+                "lab_ids": np.stack([z["lab_ids"][Ps + 1 + i] for i in range(n)], 1).astype(np.int64),
+                "lab_val": np.stack([z["lab_val"][Ps + 1 + i] for i in range(n)], 1).astype(np.float32),
+                "drafts": z["drafts"][Ps].astype(np.int64)}
+
+
+if __name__ == "__main__":
+    info = build(sys.argv[1], sys.argv[2:], K=int(os.environ.get("DSPARK_TOPK", "32")))
+    print(f"[dsparkdata] {len(info['sessions'])} sessions, {info['labels']} labelled positions -> {sys.argv[1]}")
