+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16 ``TF_DSV41_PF_DENSE=fused`` (``pfdense.cuh``: the dense EXL3 prefill GEMM with the trellis decoded inside it)
+on the CPU:
+
+- the kernel, emulated lane by lane (``tests/dsv41_pfdense_emu.py``), == the current path's program (Triton's
+  ``_gemm`` as lowered for sm_121 on upstream unpack's W_q) bit for bit under an order-sensitive MMA model: every
+  configuration, the strips / stored / lanes layouts, K2 8 / 10 / 12 / 16, fp32 / bf16 / fp16 outputs, with and
+  without a bias, partial row tiles, cp.async landing at issue and at the wait; the real pack's weights at their real
+  K (wq_b, wo_a, wkv 6-bit, shared down, indexer wk); seven injected faults are each caught;
+- the kernel's decode of whole matrices == upstream ``format.unpack``: random weights at every width and layout, and
+  every cached real-pack matrix (TF_DSV41_PACK_CACHE) in strips, lanes and stored form;
+- index level, the model's sizes: every output of M = 1 .. 4,096 (2,048, the partial 2,047 / 300, replay sizes) is
+  stored exactly once by every configuration and raster group; ldmatrix phases bank-conflict free; shared memory
+  within sm_121's 99 KB a block;
+- Triton's lowering, pinned: ``_gemm`` compiled for sm_121 (offline, Triton's own ptxas) at upstream's tiles and the
+  TF_DSV41_PREFILL_TILES sweep's: f16 MMA chains of BK / 16 links an iteration in place, the epilogue's 16-link bf16
+  chains from +0 (top's 8 then rest's 8 on the same H fragments), ``mul.f32`` by 1/sqrt(128) then svh, ``fma.rn``
+  with a bias, ``cvt.rn.bf16.f32``;
+- the knob, eligibility, the tuning table / override / heuristic, ``prefill_mm``'s routing;
+- sm_121 compile (nvcc): every kernel, 0 spills, no stack frame, registers within the launch bounds; SASS without
+  local memory, with HMMA f16 + bf16, LDGSTS and LDSM. Prints ``[G16D]``.
+
+Run: python -m pytest -q -s tests/test_dsv41_pfdense.py
+"""
+
+from __future__ import annotations
+
+import glob
+import hashlib
+import json
+import os
+import re
+import shutil
+import subprocess
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+
+import dsv41_pfdense_emu as E  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import pfdense as PD  # noqa: E402
+
+HERE = Path(PD.__file__).parent
+RNG = np.random.default_rng(20261004)
+
+
+def _case(K, N, M, bits, layout, seed=0, scale=0.5):
+    g = np.random.default_rng(seed)
+    tr = g.integers(-32768, 32768, size=(K // 16, N // 16, 16 * bits)).astype(np.int16)
+    xh = (g.standard_normal((M, K)) * scale).astype(np.float16)
+    svh = g.uniform(0.001, 0.002, N).astype(np.float16)
+    return tr, xh, svh
+
+
+def _ref(tr, xh, svh, bias, out):
+    return E.reference(xh, E.fmt_unpack_bits(tr).view(np.float16), svh, bias, out)
+
+
+# -- the configuration list -----------------------------------------------------------------------------------------
+def test_cfg_list_mirrors_the_header():
+    txt = (HERE / "pfdense_args.h").read_text()
+    got = {int(m[0]): tuple(int(v) for v in m[1:]) for m in
+           re.findall(r"X\((\d+),\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+)\)", txt)}
+    assert got == E.CFGS == PD.CFGS
+    assert int(re.search(r"#define DSV41_PFD_NCFG (\d+)", txt).group(1)) == len(got)
+
+
+@pytest.mark.parametrize("cfg", sorted(E.CFGS))
+def test_geometry_fits_sm121(cfg):
+    for k2, lanes in [(8, False), (10, False), (12, False), (16, False), (8, True), (10, True), (12, True)]:
+        g = E.Geo(cfg, k2, lanes)
+        assert g.SMEM <= 101376, (cfg, k2, g.SMEM)                 # sm_121's opt-in maximum a block
+        assert PD._blocks_an_sm(cfg, k2) == g.MINB
+        assert E.bank_conflicts_ldsm(g) == 1
+    assert all(g >= 1 for g in (E.Geo(cfg, 10, False).GPW, E.Geo(cfg, 10, False).NSPLIT))
+
+
+# -- index level ---------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("cfg", sorted(E.CFGS))
+def test_every_output_stored_once(cfg):
+    for M in (1, 17, 128, 300, 2047, 2048):
+        for N, group in ((128, 8), (512, 1), (1280, 8), (1280, 16)):
+            assert (E.store_map(M, N, cfg, group) == 1).all(), (M, N, group)
+    assert (E.store_map(4096, 640, cfg, 8) == 1).all()
+
+
+# -- the kernel == the current path, lane by lane --------------------------------------------------------------------
+CASES = [  # (K, N, M, bits, layout, cfg, out, bias, landing)
+    *[(128, 256, 37, 5, "lanes", c, "f32", False, "issue") for c in sorted(E.CFGS)],
+    *[(128, 256, 37, 5, "strips", c, "bf16", False, "wait") for c in sorted(E.CFGS)],
+    (128, 256, 37, 5, "stored", 0, "f32", False, "issue"),
+    (128, 256, 37, 5, "stored", 3, "f16", True, "wait"),
+    (128, 256, 37, 4, "lanes", 0, "bf16", False, "issue"),
+    (128, 256, 37, 6, "lanes", 3, "f32", True, "issue"),
+    (128, 256, 37, 4, "stored", 6, "f32", False, "wait"),
+    (128, 128, 21, 8, "strips", 0, "f32", False, "issue"),
+    (128, 128, 21, 8, "strips", 6, "bf16", False, "wait"),
+    (256, 256, 300, 5, "lanes", 3, "bf16", False, "issue"),      # several row tiles, the raster, a tail of 44
+    (192, 256, 70, 5, "strips", 1, "f32", False, "wait"),        # S = 6 stages over a 4-deep ring
+]
+
+
+@pytest.mark.parametrize("K,N,M,bits,layout,cfg,out,bias,landing", CASES)
+def test_kernel_equals_current_path(K, N, M, bits, layout, cfg, out, bias, landing):
+    tr, xh, svh = _case(K, N, M, bits, layout, seed=K + N + M + bits + cfg)
+    b = np.random.default_rng(cfg).uniform(-0.01, 0.01, N).astype(np.float16) if bias else None
+    words, sk, snb = E.words_of_trellis(tr, layout)
+    got = E.kernel(xh, words, sk, snb, svh, b, out, 2 * bits, layout == "lanes", cfg, landing=landing)
+    assert np.array_equal(got, _ref(tr, xh, svh, b, out))
+
+
+@pytest.mark.parametrize("fault,landing", [("kswap", "issue"), ("tile", "issue"), ("slot", "issue"),
+                                           ("wait", "wait"), ("hsign", "issue"), ("order", "issue"),
+                                           ("split", "issue")])
+def test_injected_faults_are_caught(fault, landing):
+    tr, xh, svh = _case(256, 256, 37, 5, "strips", seed=5)
+    words, sk, snb = E.words_of_trellis(tr, "strips")
+    got = E.kernel(xh, words, sk, snb, svh, None, "f32", 10, False, 0, landing=landing, fault=fault)
+    assert not np.array_equal(got, _ref(tr, xh, svh, None, "f32"))
