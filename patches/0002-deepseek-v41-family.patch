+@pytest.mark.parametrize("mode", ["split", "gemv"])
+def test_router_4096_rows_equal_halves(mode):
+    from tensorfold.families.deepseek_v41.cuda import router
+
+    g = torch.Generator().manual_seed(5)
+    x = (torch.randn(4096, 5120, generator=g) * 0.5).to(torch.bfloat16).to(DEV)
+    wt = (torch.randn(384, 5120, generator=g) * 0.02).to(torch.float16).to(DEV)
+    bias = (torch.randn(384, generator=g) * 0.01).to(torch.float16).to(DEV)
+    try:
+        pick, wts = router.route(x, wt, bias, mode=mode)
+    except (ValueError, RuntimeError) as e:                                     # a mode this build lacks
+        pytest.skip(f"router {mode}: {e}")
+    a = router.route(x[:2048].contiguous(), wt, bias, mode=mode)
+    b = router.route(x[2048:].contiguous(), wt, bias, mode=mode)
+    assert torch.equal(pick, torch.cat([a[0], b[0]])) and torch.equal(wts, torch.cat([a[1], b[1]]))
+
+
+def test_tile_timing_at_4096_rows():
+    """Every configuration at the target's widths, 4,096 rows over 384 experts (the sweep's numbers, printed)."""
+
+    E, D, I = 384, 5120, 1152
+    layer = _layer(E, D, I)
+    x, pick, w = _inputs(4096, E, D, 17, popular=False)
+    times = {}
+    for gu in x3gm.GU_TILES:
+        if not x3gm.fits("gu", gu, 6, 2):
+            continue
+        for dn in x3gm.DN_TILES:
+            c = _cfg(gu=gu, dn=dn, rows=4096)
+            x3gm.run(x, pick, w, *layer, 10.0, cfg=c)
+            torch.cuda.synchronize()
+            ev = [torch.cuda.Event(enable_timing=True) for _ in range(2)]
+            ev[0].record()
+            for _ in range(3):
+                x3gm.run(x, pick, w, *layer, 10.0, cfg=c)
+            ev[1].record()
+            torch.cuda.synchronize()
+            times[(gu, dn)] = ev[0].elapsed_time(ev[1]) / 3
+    best = min(times, key=times.get)
+    g6 = times[(1, 0)]
+    print(f"[G16 4K] x3gm 4,096 rows x 384 experts (3-bit, two inputs): G6 (1, 0) {g6:.2f} ms; best {best} "
+          f"{times[best]:.2f} ms; all " + ", ".join(f"{k}: {v:.2f}" for k, v in sorted(times.items())))
+
+
+# -- the whole forward ----------------------------------------------------------------------------------------------
+PROMPT = [int(t) for t in np.random.default_rng(97).integers(3, 250, size=4096 + 205)]
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    import dsv41_dspark_fakes as DF
+
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41c4kg"))
+
+
+def build(ck, pchunk: int, limit: int = 8192):
+    import dsv41_dspark_fakes as DF
+
+    from tensorfold.families.deepseek_v41.cuda import drafter as DR
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+    from tensorfold.families.deepseek_v41.cuda.csa2.backend import Triton
+    from tensorfold.families.deepseek_v41.cuda.decode import DecodeForward
+
+    root, cfg, table, _ = ck
+    tmap = DF.FK.token_map(cfg)
+    loader = W.Loader(cfg, W.Shards(root), 0, 1, DEV)
+    tree = loader.load(token_map=tmap)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    return DecodeForward(cfg, tree, csa2=Triton(128, cfg.num_attention_heads, DEV), limit=limit, chunk=128,
+                         pchunk=pchunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap), slots=1,
+                         dspark=DR.load(loader), device=DEV)
+
+
+def prompt(fw, ids, mode: str) -> torch.Tensor:
+    from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+
+    n = len(ids)
+    fw.prefill([Piece(0, 0, tuple(ids[:-1]))], mode=mode)
+    fw.finish_prompt(0, n - 1, tuple(ids[max(0, n - 128):n - 1]), mode=mode)
+    out = [fw.step([ids[-1]])]
+    for t in (5, 6, 7):
+        out.append(fw.step([t]))
+    return torch.cat(out).float().cpu()
+
+
+@pytest.mark.parametrize("mode", ["replay", "full"])
+def test_forward_4k_equals_2k(ck, monkeypatch, mode):
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")           # the mHC / Engram kernels are laid out for D = 5,120
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    monkeypatch.setenv("TF_DSV41_FAST_EXPERTS", "gm")
+    two = prompt(build(ck, 2048), PROMPT, mode)
+    one = prompt(build(ck, 1024), PROMPT, mode)
+    monkeypatch.setenv("TF_DSV41_PF_4K", "1")
+    monkeypatch.setenv("TF_DSV41_PF_4K_MEMORY_OK", "1")
+    from tensorfold.families.deepseek_v41.cuda import forward as FW
+    from tensorfold.families.deepseek_v41.cuda import pf4k
+
+    assert FW.prefill_chunk(128) == 4096 and pf4k.stash_trim() and pf4k.bulk_sub() > 0
+    fw = build(ck, 4096)
+    four = prompt(fw, PROMPT, mode)
+    assert fw.stage is not None and fw.stage[1] >= 4096 + 127
+    assert torch.isfinite(four).all()
+    assert torch.equal(four, two) and torch.equal(two, one)
