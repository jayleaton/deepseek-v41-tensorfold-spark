+                             "TF_DSV41_PF_4K", "TF_DSV41_PF_4K_MEMORY_OK", "TF_DSV41_GM_TUNE",
+                             "TF_DSV41_CED_STASH_TRIM", "TF_DSV41_ENGRAM_BULK_SUB",
+                             # G17 cone.py: full-mode prefill's decoder over its dependency cone (the same bits)
+                             "TF_DSV41_FULL_CONE")},
+    # G16 pfdense: the dense EXL3 prefill GEMM with the trellis decoded inside it (fast prefill runs only)
+    **{k: _PREFILL for k in ("TF_DSV41_PF_DENSE", "TF_DSV41_PF_DENSE_CFG", "TF_DSV41_PF_DENSE_TABLE")},
+    # G16 prefill levers: fast prefill runs only (PF_COPIES / PF_XOVL / PREFILL_TILES act under prefill_mm.active()
+    # and on segments over ``chunk`` rows; MHC_PF on >= 256-row sites): a decode window never takes them
+    **{k: _PREFILL for k in ("TF_DSV41_PF_COPIES", "TF_DSV41_PF_XOVL", "TF_DSV41_PF_XOVL_ROWS",
+                             "TF_DSV41_PREFILL_TILES", "TF_DSV41_MHC_PF", "TF_DSV41_MHC_PF_ROWS")},
+    # G16 host trims (64f65cc): malloc_trim after a round that finished a request, off the round thread
+    **{k: _HOST for k in ("TF_DSV41_HOST_TRIM_IDLE_S", "TF_DSV41_HOST_TRIM_IDLE_MIB", "TF_DSV41_HOST_TRIM_BUSY_S",
+                          "TF_DSV41_HOST_TRIM_BUSY_MIB", "TF_DSV41_HOST_TRIM_BG")},
+    "TF_DSV41_MEMPROBE_S": _DIAG,
+    **{k: _POLICY for k in ("TF_DSV41_CALIB", "TF_DSV41_DEPTH", "TF_DSV41_DRAFT_DEPTH", "TF_DSV41_DEPTH_JOINT",
+                            "TF_DSV41_DEPTH_FAIR", "TF_DSV41_DEPTH_HOST_MS",     # G15b joint depth mode 2
+                            "TF_DSV41_LOOKUP", "TF_DSV41_LOOKUP_MIN", "TF_DSV41_MAX_ROWS", "TF_DSV41_CONF_CAL",
+                            "TF_DSV41_CONF_TEMP", "TF_DSV41_NUCLEUS", "TF_DSV41_TREE", "TF_DSV41_TREE_DEPTHS",
+                            "TF_DSV41_TREE_DUP_MS", "TF_DSV41_TREE_PC", "TF_DSV41_TREE_ROWS",
+                            "TF_DSV41_TREE_SIB_EXPERT", "TF_DSV41_TREE_WIDTH", "TF_DSV41_DSPARK")},
+    **{k: _MEM for k in ("TF_DSV41_FLOOR_GIB", "TF_DSV41_FLOOR_HARD_GIB", "TF_DSV41_ADMIT_FREE_FLOOR_GIB",
+                         "TF_DSV41_GRAPH_FLOOR_GIB", "TF_DSV41_GRAPH_BUCKET_GROW", "TF_DSV41_ALLOC_CEIL_GIB",
+                         "TF_DSV41_FAILFAST", "TF_DSV41_FAILFAST_INJECT", "TF_DSV41_FAILFAST_GRACE_S", "TF_DSV41_FATE_PORT",
+                         "TF_DSV41_PEER_MEM_S", "TF_DSV41_FLOOR_PRICE", "TF_DSV41_FLOOR_PF_CHUNK_GIB", "TF_DSV41_FLOOR_PF_INDEX_GIB",
+                         "TF_DSV41_FLOOR_PF_HOST_GIB", "TF_DSV41_FLOOR_PF_OTHER_GIB", "TF_DSV41_FLOOR_PEER_STALE_S",
+                         "TF_DSV41_FLOOR_REFUSE_S", "TF_DSV41_NUMPY_HUGEPAGE", "TF_DSV41_PREPARED_DIRECT",
+                         "TF_DSV41_PREPARED_THREADS", "TF_DSV41_PREPARED_VERIFY", "TF_DSV41_PREPARED_WRITE",
+                         # G19: adaptive prefill rows (rank 0's plan; prefill is segmentation-invariant) and the graph
+                         # caches' prefill-dip rule: memory policy, not a decode window's timing
+                         "TF_DSV41_PREFILL_ADAPT", "TF_DSV41_PREFILL_ADAPT_GIB", "TF_DSV41_PREFILL_ADAPT_UP_GIB",
+                         "TF_DSV41_PREFILL_ADAPT_MIN", "TF_DSV41_PREFILL_ADAPT_RELEASE", "TF_DSV41_GRAPH_DIP_ROUNDS")},
+    **{k: _DIAG for k in ("TF_DSV41_PHASES", "TF_DSV41_HEALTH", "TF_DSV41_STALL_S", "TF_DSV41_STALL_EXIT_S",
+                          "TF_DSV41_MEMPROBE", "TF_DSV41_MEMPROBE_SMAPS", "TF_DSV41_MEMPROBE_TENSORS",
+                          "TF_DSV41_MEMPROBE_TRACE", "TF_DSV41_XMAP_TRACE", "TF_DSV41_XMAP_TRACE_PREGATE",
+                          "TF_DSV41_XMAP_TRACE_W", "TF_DSV41_DRAFT_LOG_HID", "TF_DSV41_DRAFT_LOG_TAPS",
+                          "TF_DSV41_DRAFT_LOG_TOPK", "TF_DSV41_INDEX_KEY_SIM", "TF_DSV41_LAUNCH_T0", "TF_DSV41_T0",
+                          "TF_DSV41_ENGRAM_GATE_TIMEOUT_S", "TF_DSV41_ENGRAM_WAIT_S", "TF_DSV41_GRAPH_BUDGET_S",
+                          "TF_DSV41_DENSE_FLUSH_MB", "GLM53_TF_ROCE_TIMEOUT_S", "GLM53_TF_ROCE_TRACE_DUMP",
+                          "GLM53_TF_ROCE_TRACE_DUMP_S")},
+    **{k: _IMAGES for k in ("TF_DSV41_IMAGES", "TF_DSV41_IMAGE_TEXT", "TF_DSV41_VISION_CACHE_MB",
+                            "TF_DSV41_VISION_FETCH", "TF_DSV41_VISION_FETCH_HTTP", "TF_DSV41_VISION_FETCH_PRIVATE",
+                            "TF_DSV41_VISION_FETCH_TIMEOUT", "TF_DSV41_VISION_FETCH_TOTAL_S",
+                            "TF_DSV41_VISION_MAX_BYTES", "TF_DSV41_VISION_MAX_IMAGES", "TF_DSV41_VISION_MAX_PIXELS",
+                            "TF_DSV41_VISION_MAX_TOKENS", "TF_DSV41_VISION_PREP_MB", "TF_DSV41_VISION_PREP_SLOTS")},
+    **{k: _HOST for k in ("TF_DSV41_ENGRAM_CACHE", "TF_DSV41_ENGRAM_PCACHE", "TF_DSV41_ENGRAM_QD",
+                          "TF_DSV41_ENGRAM_THREADS", "TF_DSV41_HASH_MEMO_ROWS", "TF_DSV41_HOST_BUFFERS")},
+}
+
+
+def method(env: dict | None = None) -> dict:
+    """The timing method (``TF_DSV41_CALIB_SHAPE`` / ``_REPS`` / ``_WARM`` / ``_STAT`` / ``_RECHECK`` / ``_CYCLE`` /
+    ``_DEEP_REPS``): see the module notes. The shape picks the other knobs' defaults."""
+
+    env = os.environ if env is None else env
+    shape = str(env.get("TF_DSV41_CALIB_SHAPE", "")).strip().lower() or "raw"
+    if shape not in SHAPES:
+        raise ValueError(f"TF_DSV41_CALIB_SHAPE={shape!r}: expected raw or fit")
+    dflt = DEFAULTS[shape]
+
+    def num(name: str, default: int, lo: int, hi: int) -> int:
+        raw = str(env.get(name, "")).strip()
+        v = int(raw) if raw else default
+        if not lo <= v <= hi:
+            raise ValueError(f"{name}={v}: expected {lo}..{hi}")
+        return v
+
+    stat = str(env.get("TF_DSV41_CALIB_STAT", "")).strip().lower() or "median"
+    if stat not in STATS:
+        raise ValueError(f"TF_DSV41_CALIB_STAT={stat!r}: expected median or min")
+    return {"reps": num("TF_DSV41_CALIB_REPS", 5, 1, 50), "warm": num("TF_DSV41_CALIB_WARM", dflt["warm"], 0, 20),
+            "stat": stat, "recheck": num("TF_DSV41_CALIB_RECHECK", dflt["recheck"], 0, EARLY), "shape": shape,
+            "cycle": num("TF_DSV41_CALIB_CYCLE", dflt["cycle"], 0, EARLY),
+            "deep": num("TF_DSV41_CALIB_DEEP_REPS", dflt["deep"], 1, 50)}
+
+
+def statistic(samples: Sequence[float], stat: str) -> float:
+    """The kept value of a window's timed runs: their median (the mean of the middle two when even) or minimum."""
+
+    xs = sorted(float(x) for x in samples)
+    if not xs:
+        raise ValueError("no timed runs")
+    if stat == "min":
+        return xs[0]
+    m = len(xs) // 2
+    return xs[m] if len(xs) % 2 else (xs[m - 1] + xs[m]) / 2
+
+
+def mode() -> str:
+    m = os.environ.get("TF_DSV41_CALIB", "cached").strip().lower() or "cached"
+    if m not in MODES:
+        raise ValueError(f"TF_DSV41_CALIB={m!r}: expected one of {', '.join(MODES)}")
+    return m
+
+
+def cache_dir() -> Path:
+    raw = os.environ.get("TF_DSV41_CALIB_DIR", "").strip()
+    return Path(raw) if raw else Path.home() / ".cache" / "tensorfold" / "dsv41-calib"
+
+
+def cache_key(image: str, shape: dict, env: dict | None = None) -> str:
+    env = os.environ if env is None else env
+    blob = json.dumps({"image": image, "knobs": {k: env.get(k, "") for k in KNOBS}, "shape": shape,
+                       "version": VERSION}, sort_keys=True)
+    return hashlib.sha256(blob.encode()).hexdigest()[:20]
+
+
+def load(key: str, root: Path | None = None) -> Costs | None:
+    f = (root or cache_dir()) / f"calib-{key}.json"
+    try:
+        d = json.loads(f.read_text())
+        c = Costs([float(v) for v in d["verify"]], float(d["draft"]), "cached", float(d.get("slot", 0.0)))
+        return c if len(c.verify) >= 2 else None
+    except (OSError, ValueError, KeyError, TypeError):
+        return None
+
+
+def save(key: str, costs: Costs, meta: dict, root: Path | None = None) -> Path | None:
+    d = root or cache_dir()
+    try:
+        d.mkdir(parents=True, exist_ok=True)
+        f = d / f"calib-{key}.json"
+        tmp = d / f".calib-{key}.{os.getpid()}.tmp"
+        tmp.write_text(json.dumps({"verify": costs.verify, "draft": costs.draft, "slot": costs.slot, "meta": meta},
+                                  indent=1))
+        tmp.replace(f)
+        return f
+    except OSError:
+        return None
+
+
+def fit(times: Sequence[float]) -> list[float]:
+    """Windows of 1 .. len(times) rows: 1 row as measured, 2-8 on their fitted line, 9+ on a line of their own
+    through the 8-row value (GLM ``calib.window_costs``), non-decreasing."""
+
+    from tensorfold.families.glm5_next.spark.calib import DEEP_FROM, fit_line
+
+    v = list(times)
+    if len(v) < 3:
+        return v
+    first = min(len(v), DEEP_FROM)
+    rows = list(range(2, first + 1))
+    base, slope = fit_line(rows, [v[r - 1] for r in rows])
+    table = [v[0]] + [base + slope * r for r in rows]
+    if len(v) > first:
+        deep = list(range(first, len(v) + 1))
+        _, slope2 = fit_line(deep, [v[r - 1] for r in deep])
+        table += [table[-1] + max(slope2, 0.0) * (r - first) for r in range(first + 1, len(v) + 1)]
+    for i in range(1, len(table)):
+        table[i] = max(table[i], table[i - 1])
+    return table
+
+
+def monotone(times: Sequence[float]) -> list[float]:
+    """Each row's measured value, made non-decreasing by pooling adjacent violators (the least-squares monotone fit:
+    a row timed below the row before it shares their mean; a curve already rising is returned as is)."""
+
+    blocks: list[list[float]] = []                      # [sum, count]
+    for x in times:
+        blocks.append([float(x), 1.0])
+        while len(blocks) > 1 and blocks[-2][0] / blocks[-2][1] > blocks[-1][0] / blocks[-1][1]:
+            s, n = blocks.pop()
+            blocks[-1][0] += s
+            blocks[-1][1] += n
+    out: list[float] = []
+    for s, n in blocks:
+        out += [s / n] * int(n)
+    return out
+
+
+def table_of(times: Sequence[float], shape: str = "raw") -> list[float]:
+    """The verify table (rows 1 .. len) from each row's measured window: ``raw`` = ``monotone``, ``fit`` = ``fit``."""
+
+    if shape not in SHAPES:
+        raise ValueError(f"table shape {shape!r}: expected raw or fit")
+    return monotone(times) if shape == "raw" else fit(times)
+
+
+def split(total: int, n: int) -> list[int]:
+    """``total`` rows over ``n`` slots, as even as can be (the first slots one more)."""
+
+    return [total // n + (1 if i < total % n else 0) for i in range(n)]
+
+
+def extend(table: Sequence[float], points: dict[int, float]) -> list[float]:
+    """``table`` (rows 1 .. len) continued to the widest of ``points`` (rows -> ms), linear between them, monotone."""
+
+    out = list(table)
+    if not out:
+        return out
+    xs = [len(out)] + sorted(r for r in points if r > len(out))
+    ys = [out[-1]] + [points[r] for r in xs[1:]]
+    for (x0, y0), (x1, y1) in zip(zip(xs, ys), zip(xs[1:], ys[1:])):
+        for r in range(x0 + 1, x1 + 1):
+            out.append(y0 + (y1 - y0) * (r - x0) / (x1 - x0))
+    for i in range(1, len(out)):
+        out[i] = max(out[i], out[i - 1])
+    return out
+
+
+def wide_buckets(slots: int, max_rows: int, rows: int = MAX_ROWS) -> list[int]:
+    """The wide buckets a calibration on ``slots`` slots can time (at most SLOT_ROWS rows a slot)."""
+
+    return [b for b in WIDE if rows < b <= min(int(max_rows), SLOT_ROWS * max(1, int(slots)))]
+
+
+def measure(fw, prompt: Sequence[int], *, ensure: Callable[[int, int], None], gather_max: Callable[[list], list],
+            sync: Callable[[], None], slot: int = 0, rows: int = MAX_ROWS, reps: int | None = None, slots: int = 1,
+            max_rows: int = 64, how: dict | None = None, report: dict | None = None) -> Costs:
+    """Both ranks: the table on ``fw`` (``decode.DecodeForward``) from ``prompt`` (shared ids). ``slots``: the slots
+    the calibration may use (``slot`` .. ``slot + slots - 1``) for the shared windows; ``max_rows`` the widest.
+    ``how``: ``method()``'s dict (default: from the environment); ``reps`` overrides its timed runs everywhere (tests).
+    ``report``: filled with this rank's samples (ms) a row, the recheck's, and the kept values."""
+
+    from .protocol import Piece, Rows
+
+    prompt = [int(t) for t in prompt]
+    wide = wide_buckets(slots, max_rows, rows)
+    n = min(max(1, int(slots)), max(2, -(-max(wide) // SLOT_ROWS) if wide else 2))     # slots the windows use
+    texts = []
+    for i in range(n):
+        cut = prompt[:len(prompt) - CUT * i] if len(prompt) > CUT * i + 8 else prompt
+        texts.append(cut)
+        ensure(slot + i, len(cut) - 1 + rows + 2)
+
+    def prefill():
+        for i, t in enumerate(texts):
+            fw.reset(slot + i)
+            fw.prefill([Piece(slot + i, 0, tuple(t[:-1]))], mode="full")
+
+    prefill()
+    conts = []
+    for i, t in enumerate(texts):
+        P, cont, pend = len(t) - 1, [], t[-1]
+        for j in range(rows - 1):               # the model's own greedy continuation
+            c = fw.window([Rows(slot + i, P + j, (pend,))], count=1)
+            fw.commit(slot + i, 0)
+            pend = int(c.ids[0, 0])
+            cont.append(pend)
+        conts.append(cont)
+    prefill()
+
+    def win(i: int, r: int):
+        return Rows(slot + i, len(texts[i]) - 1, tuple([texts[i][-1]] + conts[i][:r - 1]))
+
+    h = method() if how is None else {**method({"TF_DSV41_CALIB_SHAPE": how.get("shape", "raw")}), **how}
+    if reps is not None:                                # (a partial ``how``, tests: the rest from its shape's defaults)
+        h["reps"] = h["deep"] = int(reps)
+    stat = h["stat"]
+    full = (h["warm"], h["reps"])                       # rows 1..EARLY: per row, or as cycles of rows 1..cycle
+    deep = (1, h["deep"])                               # rows EARLY+1..
+    light = (1, REPS if reps is None else int(reps))    # the wide buckets and the DSpark pass
+    rep = report if report is not None else {}
+    rep.update({"method": h, "samples": {}, "recheck": {}})
+
+    def runs(call, plan) -> list[float]:
+        warm, n = plan
+        out = []
+        for k in range(warm + n):
+            sync()
+            t0 = time.perf_counter()
+            call()
+            sync()
+            if k >= warm:
+                out.append((time.perf_counter() - t0) * 1e3)
+        return out
+
+    def cycles(rs, plan) -> dict[int, list[float]]:
+        """Rows ``rs`` interleaved: ``warm`` discarded cycles, then ``n`` timed ones; each row's timed runs."""
+        warm, n = plan
+        out: dict[int, list[float]] = {r: [] for r in rs}
+        for k in range(warm + n):
+            for r in rs:
+                sync()
+                t0 = time.perf_counter()
+                fw.window([win(0, r)], count=1)
+                sync()
+                if k >= warm:
+                    out[r].append((time.perf_counter() - t0) * 1e3)
+        return out
+
+    def block(rs) -> dict[int, list[float]]:
+        """Rows ``rs`` (all <= EARLY), the full method: rows 1..cycle as interleaved cycles, the rest a row at a time."""
+        got = cycles([r for r in rs if r <= h["cycle"]], full)
+        for r in rs:
+            if r not in got:
+                got[r] = runs(lambda r=r: fw.window([win(0, r)], count=1), full)
+        return got
+
+    def timed(w, plan=light) -> float:
+        return statistic(runs(lambda: fw.window(w, count=1), plan), stat)
+
+    early = block(list(range(1, min(rows, EARLY) + 1)))
+    times = []
+    for r in range(1, rows + 1):
+        xs = early[r] if r <= EARLY else runs(lambda r=r: fw.window([win(0, r)], count=1), deep)
+        rep["samples"][r] = [round(x, 3) for x in xs]
+        times.append(statistic(xs, stat))
+    shared = [timed([win(0, 4), win(1, 4)])] if n >= 2 and rows >= 8 else []
+    for b in wide:
+        k = -(-b // SLOT_ROWS)
+        shared.append(timed([win(i, r) for i, r in enumerate(split(b, k))]))
+    again = block(list(range(1, min(h["recheck"], rows) + 1)))     # the early rows again, after the sweep
+    for r, xs in sorted(again.items()):                 # each row: the lower block wins
+        rep["recheck"][r] = [round(x, 3) for x in xs]
+        times[r - 1] = min(times[r - 1], statistic(xs, stat))
+    rep["kept"] = [round(x, 3) for x in times]
+    draft = 0.0
+    if getattr(fw, "drafter", None) is not None:
+        draft = statistic(runs(lambda: fw.drafter.propose([slot], [prompt[-1]], [P]), light), stat)
+    for i in range(n):
+        fw.reset(slot + i)
+    both = [v / 1000 for v in gather_max([round(x * 1000) for x in [draft, *times, *shared]])]
+    table = table_of(both[1:rows + 1], h["shape"])
+    rest = both[rows + 1:]
+    per_slot = max(0.0, rest[0] - table[7]) if n >= 2 and rows >= 8 else 0.0
+    rest = rest[1:] if n >= 2 and rows >= 8 else rest
+    points = {b: t - per_slot * (-(-b // SLOT_ROWS) - 1) for b, t in zip(wide, rest)}
+    return Costs(extend(table, points), both[0], "measured", per_slot)
+
+
+def costs_for(fw, eng, *, ensure, image: str, shape: dict, sync) -> Costs:
+    """The engine's table (both ranks): ``default``, or rank 0's cache entry shared, or a measurement (stored by
+    rank 0). ``eng``: the engine (``_share`` / ``_gather_ints``, ``model_dir``, ``rank``)."""
+
+    m = mode()
+    if m == "default":
+        return default_costs()
+    key = cache_key(image, shape)
+    got = load(key) if m == "cached" and eng.rank == 0 else None
+    ints = eng._share(got.encode() if got is not None else [] if eng.rank == 0 else None)
+    if ints:
+        return Costs.decode(ints, "cached")
+    from tensorfold.families.glm5_next.spark.calib import prompt_ids
+
+    ids = eng._share(prompt_ids(eng.model_dir, fw.vocab) if eng.rank == 0 else None)
+
+    def gather_max(vals: list) -> list:
+        both = eng._gather_ints(list(vals))
+        return [max(a, b) for a, b in zip(both[0], both[1])]
+
+    from .joint import rows_cap
+
+    rep: dict = {}
+    t0 = time.monotonic()
+    costs = measure(fw, ids, ensure=ensure, gather_max=gather_max, sync=sync, slots=int(shape.get("slots", 1) or 1),
+                    max_rows=rows_cap(), report=rep)
+    secs = time.monotonic() - t0                        # the boot's cost of the calibration (G15 compares methods)
+    if eng.rank == 0:
+        h = rep["method"]
+        one, again = rep["samples"].get(1, []), rep["recheck"].get(1, [])
+        kept = rep.get("kept") or []
+        cyc = f", rows 1-{h['cycle']} cycled" if h["cycle"] else ""
+        print(f"[tensorfold] dsv41 calib method: table {h['shape']}, {h['stat']} of {h['reps']} after {h['warm']} "
+              f"warm-up(s){cyc}, rows 1-{h['recheck']} rechecked, rows 9+ {h['deep']} runs; 1 row this rank: sweep "
+              f"{one} recheck {again} -> kept {kept[0] if kept else '-'} ms; rows 1-4 kept {kept[:4]} ms", flush=True)
+        f = save(key, costs, {"shape": shape, "image": image, "time": time.strftime("%Y-%m-%dT%H:%M:%S"),
+                              "method": h, "seconds": round(secs, 2), "samples_rank0": rep["samples"],
+                              "recheck_rank0": rep["recheck"]})
+        rs = [r for r in (1, 2, 4, 6, 8, 16, 24, 32, 48, 64) if r <= len(costs.verify)]
+        print(f"[tensorfold] dsv41 calibration: draft {costs.draft:.2f} ms, slot {costs.slot:.2f} ms, verify "
+              f"{'/'.join(str(r) for r in rs)} rows {', '.join(f'{costs.window_ms(r):.1f}' for r in rs)} ms, "
+              f"measured in {secs:.1f} s" + (f" (stored {f})" if f else ""), flush=True)
+    return costs
+
+
+__all__ = ["DEFAULTS", "KNOBS", "NOT_KNOBS", "SHAPES", "STATS", "VERSION", "WIDE", "cache_key", "costs_for", "extend",
+           "fit", "load", "measure", "method", "mode", "monotone", "save", "split", "statistic", "table_of",
+           "wide_buckets"]
