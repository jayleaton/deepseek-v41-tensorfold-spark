+#ifndef DSV41_MF_NO_TORCH
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAException.h>
+#include <torch/extension.h>
+
+void dsv41_mf_route_cuda(const at::Tensor& X, const at::Tensor& W, const at::Tensor& B, at::Tensor& pick,
+                         at::Tensor& wts, at::Tensor& pickr, at::Tensor& LG, at::Tensor& cnt, int64_t K, int64_t slots,
+                         double scale, bool kit, bool prune, bool kept, int64_t min_k, int64_t drop, double min_w,
+                         double topp, at::Tensor& gid, at::Tensor& gcnt, at::Tensor& gmem, const at::Tensor& suh_g,
+                         const at::Tensor& suh_u, at::Tensor& xg, at::Tensor& xu, int64_t rt, int64_t nw,
+                         int64_t help, int64_t rk, int64_t ge, bool fast) {
+    using namespace dsv41_mf;
+    const int64_t R = X.size(0), E = W.size(0);
+    TORCH_CHECK(X.size(1) == D && W.size(1) == D && suh_g.size(1) == D && xg.size(1) == D, "moe_fused: D must be ", D);
+    TORCH_CHECK(X.stride(1) == 1 && X.stride(0) % 8 == 0 && reinterpret_cast<uintptr_t>(X.data_ptr()) % 16 == 0,
+                "moe_fused: x rows must be unit-stride and 16-byte aligned");
+    TORCH_CHECK(R >= 1 && R <= rt && (rt == 1 || rt == 2 || rt == 4 || rt == 8 || rt == 16),
+                "moe_fused: one row tile of 1..16 rows");
+    TORCH_CHECK(E >= 1 && E <= 32 * EPL && E <= dsv41_rg::GE_MAX && K >= 1 && K <= KMAX && K <= E &&
+                slots == K + 1 && suh_g.size(0) > E, "moe_fused: E <= 512, 1 <= K <= 8, slots K + 1, a shared entry");
+    TORCH_CHECK(pick.numel() >= R * slots && wts.numel() >= R * slots && pickr.numel() >= R * slots &&
+                LG.numel() >= R * E && cnt.numel() >= 4 && xg.size(0) >= R * slots && xu.size(0) >= R * slots,
+                "moe_fused: buffers too small");
+    TORCH_CHECK((rk == K && ge == E) || (rk == slots && ge == E + 1 && suh_g.size(0) >= E + 1 &&
+                                         E + 1 <= dsv41_rg::GE_MAX),
+                "moe_fused: rk / ge: (K, E) routed only, or (slots, E + 1) with the shared entry");
+    TORCH_CHECK(gid.numel() >= std::min(R * rk, ge) && gmem.dim() == 2 && gmem.size(0) >= std::min(R * rk, ge) &&
+                gmem.size(1) == R && gcnt.numel() >= 1, "moe_fused: ids / members sized [min(R rk, ge), R]");
+    const int64_t nprod = (E + nw - 1) / nw;
+    TORCH_CHECK(help >= 0 && help < nprod, "moe_fused: help in [0, producer CTAs)");
+    dsv41_mf::Args a;
+    a.x = reinterpret_cast<const uint16_t*>(X.data_ptr());
+    a.xs = X.stride(0);
+    a.w = reinterpret_cast<const uint16_t*>(W.data_ptr());
+    a.bias = B.data_ptr<float>();
+    a.pick = pick.data_ptr<int>();
+    a.wts = wts.data_ptr<float>();
+    a.pickr = pickr.data_ptr<int>();
+    a.lg = LG.data_ptr<float>();
+    a.cnt = cnt.data_ptr<int>();
+    a.R = (int)R; a.E = (int)E; a.K = (int)K; a.slots = (int)slots; a.kit = kit ? 1 : 0;
+    a.scale = (float)scale;
+    a.prune = prune ? 1 : 0; a.kept = kept ? 1 : 0; a.min_k = (int)min_k; a.drop = (int)drop;
+    a.min_w = (float)min_w; a.topp = (float)topp;          // Triton's fp32 scalars (prune.py passes Python floats)
+    a.gid = gid.data_ptr<int>(); a.gcnt = gcnt.data_ptr<int>(); a.gmem = gmem.data_ptr<int>();
+    a.maxm = (int)gmem.size(1);
+    a.suh_g = reinterpret_cast<const __half*>(suh_g.data_ptr());
+    a.suh_u = reinterpret_cast<const __half*>(suh_u.data_ptr());
+    a.xg = reinterpret_cast<__half*>(xg.data_ptr());
+    a.xu = reinterpret_cast<__half*>(xu.data_ptr());
+    a.nprod = (int)nprod; a.help = (int)help;
+    a.rk = (int)rk; a.ge = (int)ge;
+    C10_CUDA_CHECK(dispatch(a, (int)rt, (int)nw, fast, at::cuda::getCurrentCUDAStream()));
+}
+
+void dsv41_mf_combine2_cuda(const at::Tensor& Z, const at::Tensor& Zs, const at::Tensor& pick, const at::Tensor& svh_d,
+                            at::Tensor& y, const at::Tensor& wts, at::Tensor& out, int64_t rows, int64_t P, int64_t Ps,
+                            int64_t Dm, int64_t SK, int64_t slots, int64_t E, int64_t ks) {
+    TORCH_CHECK(slots <= 32 && Dm % 128 == 0 && ks >= 0 && ks < slots && Ps >= rows, "moe_fused combine2: shapes");
+    dim3 grid((unsigned)rows, (unsigned)(Dm / 128));
+    dsv41_mf::combine2_kernel<<<grid, (unsigned)(32 * slots), 0, at::cuda::getCurrentCUDAStream()>>>(
+        Z.data_ptr<float>(), Zs.data_ptr<float>(), pick.data_ptr<int>(),
+        reinterpret_cast<const __half*>(svh_d.data_ptr()), y.data_ptr<float>(), wts.data_ptr<float>(),
+        out.data_ptr<float>(), (int)P, (int)Ps, (int)Dm, (int)SK, (int)E, (int)slots, (int)ks);
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+#endif
