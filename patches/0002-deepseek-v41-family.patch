+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16 4K exactness through the Triton CSA2 / mHC kernels in Triton's CPU interpreter (512-wide FP8 rows, 32 x 128
+index heads, a 128-token window), scaled: segments of 2P rows ("4K") against P rows ("2K"), P = 20, with every
+threshold that picks a path by WINDOW size set so the 2P windows cross it and the P windows (some of them) do not --
+the switches 4,096-row windows move at the real sizes:
+
+- the streaming top-k (``stream_min``: a window with more than 16 rows whose last row sees >= stream_min keys; at the
+  real sizes TF_DSV41_INDEX_STREAM_MIN), the materialised selection in row blocks under the index budget (at the
+  real sizes ~5,461 visible keys at 4,096 rows, 10,922 at 2,048), attention in blocks of the scratch's rows;
+- the mHC row tile (TF_DSV41_MHC_ROWS / _BM / _WARPS: windows of at least MHC_ROWS rows take the prefill tile);
+- the fast prefill kernels with the fused prefill attention (TF_DSV41_PREFILL_KERNELS=fast, _PREFILL_ATTN=fused).
+
+Logits (the last prompt token and a decode step) and the kv sources' compressed rows / index keys bit for bit."""
+
+from __future__ import annotations
+
+import json
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401
+
