+# -- streaming top-k ----------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("nkeys", [3000, 20000, 65536])
+def test_stream_topk_equals_materialised_on_gpu(nkeys):
+    g = torch.Generator(device=DEV).manual_seed(nkeys)
+    R = 8
+    P = nkeys - R
+    qi = torch.randn((R, 32, 128), generator=g, device=DEV).to(torch.bfloat16)
+    w = torch.randn((R, 32), generator=g, device=DEV)
+    ik = torch.randn((nkeys, 128), generator=g, device=DEV)
+    ik[100:140] = ik[7]
+    ik[300:900] = 0.0
+    ik = ik.to(torch.bfloat16)
+    pos = torch.tensor([P], dtype=torch.int32, device=DEV)
+    torch.cuda.synchronize()
+    t0 = time.perf_counter()
+    want = index.select(qi, w, ik, pos, R, nkeys, 1)
+    torch.cuda.synchronize()
+    t1 = time.perf_counter()
+    got = ST.select(qi, w, ik, pos, R, nkeys, 1)
+    torch.cuda.synchronize()
+    t2 = time.perf_counter()
+    assert torch.equal(got, want)
+    s = index.scores(qi, w, ik, pos, R, nkeys, 1)
+    wb = index.candidate_blocks(s, pos, R)
+    assert torch.equal(ST.candidate_blocks(qi, w, ik, pos, R, nkeys, 1), wb)
+    assert torch.equal(ST.reindex(qi, w, ik, pos, R, wb), index.reindex(qi, w, ik, pos, R, wb))
+    print(f"\n{nkeys} keys x {R} rows: materialised {1e3 * (t1 - t0):.2f} ms, streaming {1e3 * (t2 - t1):.2f} ms "
+          f"(first calls include compiles)")
