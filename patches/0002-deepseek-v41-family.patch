+def test_stack_after_bind(ck):
+    import dsv41_dspark_fakes as DF
+
+    from tensorfold.families.deepseek_v41.cuda.pool import Pool
+
+    fw = DF.forward(ck, slots=2)
+    L2 = next(b.index for b in fw.blocks if b.ratio == 2)
+    fw.slots[1].carry[L2].fill_(3.0)                                  # state before the bind is kept
+    pool = Pool(ck[3], 2048)
+    ps = [pool.new_slot(512) for _ in range(3)]
+    fw.bind(ps)
+    rs = fw.rowslot
+    assert len(fw.slots) == 3 and rs.ptab.shape == (3, ps[0].table.numel())
+    assert not rowmode.ready(fw)                                      # the CPU twin: row mode is Triton's
+    for i, s in enumerate(fw.slots):
+        for L, st in s.swa.items():
+            big = rs.swa[L]
+            data = big.values if hasattr(big, "values") else big.data
+            mine = st.values if hasattr(st, "values") else st.data
+            assert mine.data_ptr() == data[i * fw.ring].data_ptr()
+        assert s.carry[L2].data_ptr() == rs.carry[L2][i].data_ptr()
+    assert bool((rs.carry[L2][1] == 3.0).all()) and not bool(rs.carry[L2][0].any())
+    ps[1].ensure(300)                                                 # the pool maps pages into the stacked table
+    assert torch.equal(rs.ptab[1, :ps[1].table.numel()], ps[1].table)
+    assert ps[1].table.data_ptr() == rs.ptab[1].data_ptr() and int(rs.ptab[1, 0]) != int(pool.null)
+    fp = rowmode.fingerprint(fw)
+    fw.reset(1)                                                       # in place: the same addresses
+    assert rowmode.fingerprint(fw) == fp and not bool(rs.carry[L2][1].any())
+
