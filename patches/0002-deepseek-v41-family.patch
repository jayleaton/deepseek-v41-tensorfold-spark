+++ b/src/tensorfold/families/deepseek_v41/cuda/seams.py
@@ -0,0 +1,211 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The forward's seams for the Single-Pass mHC boundary kernels and the Engram fusion, with torch fallbacks.
+
+The forward calls ``hc_ops(device)`` (an object with the mHC interface below) and ``engram_fuse``. On CUDA they are
+the kernel modules ``cuda/mhc.py`` / ``cuda/engram.py`` when those exist (the development tree's (unpublished) engine/kernels/mhc and
+engram: one Triton pass a sublayer boundary), else the torch fallbacks here. The fallbacks follow engine/reference
+(hc.py, engram.py: vLLM ``kernels/mhc/torch.py`` and ``common/engram.py`` semantics) with float64 sums rounded at the
+reference's storage boundaries, so a row never depends on the other rows of its window (row invariance by
+construction, on any device).
+
+mHC interface (R rows, streams x [R, 4 D] bf16 viewed flat; D hidden; W ranks):
+
+    Hc(fn [24, 4 D] fp32, base [24], scale [3]);  Coefs(rows, device): pre / post fp32 [R, 4], comb fp32 [R, 16]
+    (comb[i, j] at 4 i + j);  Scratch(rows, device, dims): the collapsed row ``c`` [R, D] bf16 (+ the kernel's partials)
+    site(x, hc, norm_w, out, coefs, scratch, pre_in=None)
+        coefs = the site's mixes of x; out [R, D] = norm(collapse(x, pre_in)) (pre_in None: stream 0)
+    boundary(x, xout, gathered, prev, hc, norm_w, out, coefs, scratch, tap=None)
+        branch = bf16(the ranks' partials gathered fp32 [W, R, D] summed rank 0 first); xout = post(x, branch,
+        prev.post, prev.comb); out = norm(collapse(xout, prev.pre)); coefs = the next site's mixes of xout;
+        tap [R, D] = the mean of xout's streams (DSpark's taps)
+    post_only(x, xout, gathered, prev, tap=None)          the post alone (before an Engram layer)
+    final(x, xout, gathered, prev, norm_w, out, scratch, tap=None)
+        the last post; scratch.c = collapse(xout, prev.pre); out = norm(scratch.c) with the model's final norm
+
+Engram: ``fuse(x [R, 4 D] (updated in place), kv [R, 5 D] bf16, qk fp32 [4, D], keep fp32 [R] or None)``:
+``x_h += sigmoid(sign(dot) sqrt(max(|dot|, clamp))) value``, ``dot = sum(x_h qk_h key_h) rsqrt(ms(x_h) + eps)
+rsqrt(ms(key_h) + eps) / sqrt(D)``.
+
+``TF_DSV41_SEAMS=torch`` forces the fallbacks (A/B, debugging); ``describe()`` names what runs.
+"""
+
+from __future__ import annotations
+
+import importlib
+import os
+from dataclasses import dataclass
+from functools import cache
+
+import torch
+
+from . import numerics as N
+
+F64 = torch.float64
+ENV = "TF_DSV41_SEAMS"
+HC = 4
+
+
+# -- the torch fallback of the mHC boundary interface --------------------------------------------------------------
+@dataclass
+class Hc:
+    fn: torch.Tensor
+    base: torch.Tensor
+    scale: torch.Tensor
+
+
+class Coefs:
+    def __init__(self, rows: int, device, *, pre=None, post=None, comb=None) -> None:
+        z = lambda n: torch.zeros((rows, n), dtype=N.ACC, device=device)              # noqa: E731
+        self.pre = z(HC) if pre is None else pre
+        self.post = z(HC) if post is None else post
+        self.comb = z(HC * HC) if comb is None else comb
+
+
+class Scratch:
+    def __init__(self, rows: int, device, dims: int) -> None:
+        self.rows, self.dims = rows, dims
+        self.c = torch.empty((rows, dims), dtype=N.ACT, device=device)
+
+
+class TorchHc:
+    """engine/reference/hc.py's math on the boundary interface (any device, any width)."""
+
+    Hc, Coefs, Scratch = Hc, Coefs, Scratch
+
+    def __init__(self, rms_eps: float = 1e-20, norm_eps: float = 1e-20, hc_eps: float = 1e-6, alpha: float = 2.0,
+                 iters: int = 20) -> None:
+        self.rms_eps, self.norm_eps, self.hc_eps, self.alpha, self.iters = rms_eps, norm_eps, hc_eps, alpha, iters
+
+    @staticmethod
+    def _rms(x: torch.Tensor, eps: float) -> torch.Tensor:
+        return torch.rsqrt(x.square().mean(-1, keepdim=True) + eps)
+
+    def _mixes(self, x: torch.Tensor, hc: Hc, coefs: Coefs) -> None:
+        R = x.shape[0]
+        v = x.reshape(R, -1).to(F64)
+        mixes = (v @ hc.fn.to(F64).t()) * self._rms(v, self.rms_eps)
+        sc, bs = hc.scale.to(F64), hc.base.to(F64)
+        pre = torch.sigmoid(mixes[:, :HC] * sc[0] + bs[:HC]) + self.hc_eps
+        post = torch.sigmoid(mixes[:, HC:2 * HC] * sc[1] + bs[HC:2 * HC]) * self.alpha
+        comb = mixes[:, 2 * HC:].reshape(R, HC, HC) * sc[2] + bs[2 * HC:].reshape(1, HC, HC)
+        comb = torch.softmax(comb, dim=-1) + self.hc_eps
+        comb = comb / (comb.sum(dim=-2, keepdim=True) + self.hc_eps)
+        for _ in range(self.iters - 1):
+            comb = comb / (comb.sum(dim=-1, keepdim=True) + self.hc_eps)
+            comb = comb / (comb.sum(dim=-2, keepdim=True) + self.hc_eps)
+        coefs.pre[:R] = pre.to(coefs.pre.dtype)
+        coefs.post[:R] = post.to(coefs.post.dtype)
+        coefs.comb[:R] = comb.reshape(R, HC * HC).to(coefs.comb.dtype)
+
+    def _collapse(self, x: torch.Tensor, pre: torch.Tensor | None) -> torch.Tensor:
+        R = x.shape[0]
+        s = x.reshape(R, HC, -1)
+        if pre is None:
+            return s[:, 0].to(N.ACT)
+        return (pre[:R].to(F64).unsqueeze(-1) * s.to(F64)).sum(1).to(N.ACT)
+
+    def _norm(self, c: torch.Tensor, w: torch.Tensor, out: torch.Tensor) -> None:
+        c = c.to(F64)
+        out[:c.shape[0]] = (c * self._rms(c, self.norm_eps) * w.to(F64)).to(out.dtype)
+
+    def _post(self, x, xout, gathered, prev: Coefs, tap) -> None:
+        R = gathered.shape[1]
+        wide = torch.float32 if gathered.dtype == torch.bfloat16 else gathered.dtype     # bf16 partials (G7): widen
+        branch = gathered[0].to(wide, copy=True)
+        for r in range(1, gathered.shape[0]):
+            branch += gathered[r].to(wide)
+        branch = branch.to(N.ACT).to(F64)
+        s = x.reshape(R, HC, -1).to(F64)
+        comb = prev.comb[:R].to(F64).reshape(R, HC, HC)
+        mixed = torch.einsum("rij,rid->rjd", comb, s)
+        new = (mixed + prev.post[:R].to(F64).unsqueeze(-1) * branch.unsqueeze(1)).to(N.ACT)
+        xout.reshape(R, HC, -1).copy_(new.to(xout.dtype))
+        if tap is not None:
+            tap[:R] = new.to(N.ACC).mean(1).to(tap.dtype)
+
+    def site(self, x, hc, norm_w, out, coefs, scratch, pre_in=None) -> None:
+        c = self._collapse(x, pre_in)
+        self._mixes(x, hc, coefs)
+        self._norm(c, norm_w, out)
+
+    def boundary(self, x, xout, gathered, prev, hc, norm_w, out, coefs, scratch, tap=None) -> None:
+        if coefs is prev:
+            raise ValueError("boundary: the next site's coefficients need their own buffers")
+        self._post(x, xout, gathered, prev, tap)
+        self.site(xout, hc, norm_w, out, coefs, scratch, prev.pre)
+
+    def post_only(self, x, xout, gathered, prev, tap=None) -> None:
+        self._post(x, xout, gathered, prev, tap)
+
+    def final(self, x, xout, gathered, prev, norm_w, out, scratch, tap=None) -> None:
+        self._post(x, xout, gathered, prev, tap)
+        c = self._collapse(xout, prev.pre)
+        scratch.c[:c.shape[0]] = c.to(scratch.c.dtype)
+        self._norm(c, norm_w, out)
+
+
+def engram_fuse_torch(x, kv, qk, keep=None, *, eps: float = 1e-20, clamp: float = 1e-6):
+    R = x.shape[0]
+    s = x.reshape(R, HC, -1)
+    D = s.shape[2]
+    v = s.to(F64)
+    kv = kv.to(F64)
+    key = kv[:, :HC * D].reshape(R, HC, D)
+    value = kv[:, HC * D:HC * D + D]
+    dot = (v * qk.to(F64)[None] * key).sum(-1)
+    dot = dot * TorchHc._rms(v, eps).squeeze(-1) * TorchHc._rms(key, eps).squeeze(-1) / (D ** 0.5)
+    g = torch.sqrt(dot.abs().clamp(min=clamp))
+    gate = torch.sigmoid(torch.where(dot < 0, -g, g))
+    if keep is not None:
+        gate = gate * keep.to(device=gate.device, dtype=F64)[:, None]
+    s.copy_((v + gate.unsqueeze(-1) * value.unsqueeze(1)).to(N.ACT).to(x.dtype))
+    return x
+
+
+# -- resolution ----------------------------------------------------------------------------------------------------
+def _forced() -> bool:
+    return os.environ.get(ENV, "").strip().lower() == "torch"
+
+
+@cache
+def _kernel(mod_name: str, *names: str):
+    """The kernel module when it exists and has every name, else None."""
+
+    try:
+        mod = importlib.import_module(f"{__package__}.{mod_name}")
+    except ImportError:
+        return None
+    return mod if all(hasattr(mod, n) for n in names) else None
+
+
+MHC_NAMES = ("Hc", "Coefs", "Scratch", "site", "boundary", "post_only", "final")
+
+
+def hc_ops(device, cfg) -> object:
+    """The mHC boundary implementation for ``device`` (the kernel module on CUDA when present)."""
+
+    if torch.device(device).type == "cuda" and not _forced():
+        mod = _kernel("mhc", *MHC_NAMES)
+        if mod is not None and cfg.hidden_size == getattr(mod, "DIMS", cfg.hidden_size):
+            return mod                  # the kernels' column blocks are laid out for the model's 5,120
+    return TorchHc(cfg.rms_norm_eps, cfg.rms_norm_eps, cfg.hc_eps, cfg.hc_post_alpha, cfg.hc_sinkhorn_iters)
+
+
+def engram_fuse(x, kv, qk, keep=None, *, eps: float, clamp: float):
+    if x.device.type == "cuda" and not _forced():
+        dec = _kernel("engram_dec", "fuse", "supports")      # G9: the same bits with its loads in flight
+        if dec is not None and dec.supports(x, qk):
+            return dec.fuse(x, kv, qk, keep, eps=eps, clamp=clamp)
+        mod = _kernel("engram", "fuse")
+        if mod is not None:
+            return mod.fuse(x, kv, qk, keep, eps=eps, clamp=clamp)
+    return engram_fuse_torch(x, kv, qk, keep, eps=eps, clamp=clamp)
+
+
+def describe(device_type: str = "cuda") -> dict[str, str]:
+    """{seam: "kernel" | "torch"}: what the forward runs on this device."""
+
+    on = device_type == "cuda" and not _forced()
+    return {"mhc": "kernel" if on and _kernel("mhc", *MHC_NAMES) else "torch",
+            "engram.fuse": "kernel" if on and _kernel("engram", "fuse") else "torch"}
