+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DeepSeek-V4.1-Flash on the GPU (window G1; collected only where PyTorch sees an NVIDIA GPU):
+
+- the 0580 load path (x3ld) == upstream's grouped EXL3 kernel, bit for bit, on random mul1 experts of the real
+  geometry (5,120 <-> 1,152 a rank) at every width the pack uses and verify widths 1-16;
+- the router kernel against float64 routing, and a row alone == the row in a window (bit for bit);
+- the CSA2 kernels' rows alone == in windows (bit for bit) and against the float64 references;
+- the whole forward on the GPU (upstream's EXL3 linears and experts, CSA2 + router kernels) on a synthetic checkpoint
+  with the kernels' shapes: == the CPU twin to rounding, and its rows bit for bit the same in a prefill window, in
+  windows of 8 and one at a time (M1 gate 3 on synthetic weights);
+- a prepared folder read to the GPU == the tree it stored.
+
+Run: python -m pytest -q tests/cuda/test_dsv41_gpu.py (one GPU; ~2-5 min with the first extension builds).
+"""
+
+from __future__ import annotations
+
+import json
+import math
+
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import experts as X  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import expert_loads as loads  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
