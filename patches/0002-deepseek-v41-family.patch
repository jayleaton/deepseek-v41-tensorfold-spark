+++ b/src/tensorfold/families/deepseek_v41/cuda/router.py
@@ -0,0 +1,392 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DeepSeek-V4.1-Flash's MoE router on sm_121: logits, sqrt-softplus scores, top-6 by score + bias (``noaux_tc``),
+renormalized x 1.5, and the shared expert's slot (vLLM ``deepseek_v4`` routing semantics: scoring ``sqrtsoftplus``,
+``norm_topk_prob``, ``routed_scaling_factor`` 1.5; the bias only chooses, it never weighs).
+
+    logit_e = sum_k x_k W_e,k                      fp32, x bf16, W fp16 (the summation order: per path, below)
+    s_e     = sqrt(softplus(logit_e))              softplus(z) = z for z > 20 (torch's threshold), log(1 + e^z) on
+                                                   [-10, 20], e^z - e^2z / 2 below -10 (``_softplus``)
+    pick    = the 6 largest s_e + bias_e           ties to the lower expert id
+    w_i     = 1.5 * s_pick_i / (s_pick_0 + ... + s_pick_5)    (the sum in pick order)
+    slots   = [pick_0 .. pick_5, E]  weights [w_0 .. w_5, 1.0]   (E = the shared expert's table entry)
+
+Paths (``TF_DSV41_ROUTER``, read at import; ``route(mode=...)`` overrides):
+
+Default (G6): ``fused`` for decode / verify windows and exact prefill (they must share bits), ``split`` for fast
+prefill runs (``TF_DSV41_PREFILL_ROUTER``, ``prefill_moe``).
+- ``gemv``: ``router_gemv.cu`` (G7): a warp an expert streams the bf16 gate with 16-byte loads, per-lane fp32 FMA
+  chains of 160 k + a fixed xor butterfly a row, the selection fused in the last CTA of a row tile; every R (decode
+  and prefill rows alike). Cost model, design and the shared-expert note: ``router_gemv.py``. Falls back to ``split``
+  where it has no instance (D != 5,120, a gate not bf16, E > 512, top-k > 8); on CPU tensors it runs its numpy model.
+  ``TF_DSV41_RG_NARROW`` / ``TF_DSV41_RG_TAIL`` (router_gemv.py; ``route_fold``): the narrow decode kernel (the same
+  bits) and the kit rounding + upstream's grouping folded into its tail.
+- ``fused`` (default): ONE launch a layer. Grid (row block of 16, expert block of 16, slice s of SLICES = 8): a
+  program's partial is the fp32 FMA chain over its 640 k (``tl.dot`` ieee, k ascending, from 0), stored to a per-call
+  scratch [R, 8, E] fp32. It then bumps its row block's int32 counter (atomic acq_rel, gpu scope); the program that
+  arrives last sums the 8 partials in the FIXED order ((p0 + p1) + p2) + ... + p7 (``.cg`` loads) and runs the
+  selection (``_pick``), then resets the counter to 0 (self-cleaning: graph replays start from 0). Which program
+  arrives last never changes the bits. The chain is 640 + 7 roundings long instead of 5,120: its error bound is ~7x
+  smaller (tests: max |logit - float64| below the split path's).
+- ``split``: G4's two launches (``_logits`` over 5,120-long chains, then ``_select``): G4's bits exactly.
+
+G6 on the real weights (``routerbench``, the gate with ``TF_DSV41_ROUTER_CHECK``): fused is correct by construction
+(R = 1..16 invariance on all 43 routers, chunks, graph replays and counters bit for bit; picks == split on 99.998% of
+672,560 real rows, every differing row a float64 near-tie, margin <= 1e-6), but it is only 1.09x split at R <= 16
+(102 vs 112 us a layer: ~0.4 ms a verify window, not the 3.7 expected), 0.5x at 64+ rows (10.9 vs 5.6 ms a layer at
+2,048: prefill), and the M1 gate's top-1 vs the kit moved 99.61 -> 99.58% (first copy 97.34 -> 96.35%; split's
+long chains sit closer to the kit's rounding). The quality line is top-1 >= 96% vs the kit (TARGETS.md), so
+speed decides: fused for decode rows, split for fast prefill rows.
+- ``one``: the original single program per row block (the same bits as ``split``; 1.0 ms a layer, G2).
+
+Row invariance (every path): a logit is its row's own chains (tile-mates never enter an FMA chain), SLICES / BK /
+the reduction order are constants (never a function of R), and the selection reads only the row. A row's picks and
+weights are the same bits alone, in any window of any R and at any position of the tile: batched == alone, drafted ==
+serial, decode rows == exact-prefill rows. Rows above CHUNK = 2,048 run as consecutive chunks (rows independent: the
+same bits), so the scratch is at most 2,048 x 8 x 384 x 4 B = 24 MiB (E = 128: 8 MiB) and the counter buffer one
+fixed 128-int buffer a device (allocated once outside graph capture, never moved; a per-call zeroed buffer if the
+first call is being captured). Two streams of one device must not run the fused router concurrently (shared counters).
+
+Expected time (sm_121, R <= 16): the old ``_logits`` was 24 programs of 5,120-long serial chains, 108 us a layer
+(G4 nsys), + ``_select``. Fused: 192 programs at E = 384 (64 at E = 128) stream the 384 x 5,120 fp16 gate (3.9 MB) at
+~200 GB/s ~20 us, + the last program's 8 x [R, 384] partial sum and selection ~3-5 us: ~25 us. G4's 4.8 ms a window
+is ~44 calls (40 target layers + DSpark's blocks) of ~110 us: fused ~1.1 ms, saving ~3.7 ms a verify window.
+DSpark's blocks use the same kernels at E = 128, top-3.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+DIMS = 5120
+EXPERTS = 384
+TOPK = 6
+SCALE = 1.5
+BR = 16           # rows a program (tl.dot's minimum M)
+BE = 512          # experts padded to a power of two (split / one paths)
+BK = 32           # k a step (one path)
+WARPS = 8
+BEB = 16          # experts a logits program (split router): 16 x 32 programs at E = 384 instead of one (G2: the
+                  # one-program router took 1.0 ms a layer at R = 1, 55% of a decode step's GPU time; split 16 x 16
+                  # with k steps of 64: ~0.1 ms, the same bits for every tile shape tried)
+STAGES = 1        # one stage: the [BK, BE] fp32 weight tile is 64 KiB; Triton's default 3 stages need 132 KiB of shared
+                  # memory, over sm_121's 99 KiB (G1). Stages only overlap loads: every FMA chain is unchanged
+TINY = -10.0      # ``_softplus``'s literal: below it the series e^z - e^2z / 2 (relative error < e^2z / 3 < 1e-9)
+SLICES = 8        # fused: k slices (fixed, never a function of R: the row's bits are R-invariant)
+FBK = 64          # fused: k a step (a slice of 640 = 10 steps; D must be a multiple of SLICES x FBK = 512)
+FWARPS = 8        # fused: warps (the last program's [16, 512] selection tile, like ``_select``)
+FSTAGES = 3       # fused: x [16, 64] bf16 + W [64, 16] fp16 a stage, 4 KiB: far under 99 KiB
+CHUNK = 2048      # fused: rows a launch (scratch <= 24 MiB; the counter buffer is CHUNK / 16 ints)
+MODES = ("fused", "split", "one", "gemv")
+MODE = os.environ.get("TF_DSV41_ROUTER", "fused")      # G6: fused 1.09x split at decode rows (R <= 16)
+# fast prefill runs (prefill_moe) route with their own mode: fused is 0.5x split at 64+ rows (G6), and fast rows have
+# their own session tag, so the choice there never touches decode / exact-prefill bits
+PREFILL_MODE = os.environ.get("TF_DSV41_PREFILL_ROUTER", "split")
+if PREFILL_MODE not in MODES:
+    raise ValueError(f"TF_DSV41_PREFILL_ROUTER={PREFILL_MODE!r}: one of {MODES}")
+if MODE not in MODES:
+    raise ValueError(f"TF_DSV41_ROUTER={MODE!r}: one of {MODES}")
+_COUNTERS: dict = {}
+_CHECK = bool(os.environ.get("TF_DSV41_ROUTER_CHECK", "").strip())     # router_check.py (diagnostic, off)
+
+
+@triton.jit
+def _softplus(z):
+    """torch's ``softplus`` (log1p(e^z); z above 20) in fp32. On [-10, 20] the arithmetic is the one the kernels
+    always had (the same bits); below -10, where ``1 + e^z`` rounds away e^z's digits (exactly 1 below -16.6, so
+    s = 0), the series e - e^2 / 2 of log1p. G4: a hyper-concentrated row (one massive channel dominating the normed
+    input) can have every router logit below -16.6: s = 0 for all experts, weights 0 / 0 = NaN, a NaN MoE output and
+    all four mHC streams NaN after it (the suspected cause of prompt 5's row 44 at layer 37)."""
+
+    e = tl.exp(tl.minimum(z, 20.0))
+    tiny = e - 0.5 * (e * e)
+    return tl.where(z > 20.0, z, tl.where(z < -10.0, tiny, tl.log(1.0 + e)))
+
+
+@triton.jit
+def _pick(acc, rows, rok, e, eok, BIAS, PICK, WTS, E: tl.constexpr, K: tl.constexpr, SLOTS: tl.constexpr,
+          SCALE: tl.constexpr, BE: tl.constexpr):
+    """Logits [16, BE] (columns >= E ignored) -> sqrt-softplus scores, top-K by score + bias, weights, shared slot.
+    Every path's selection (the same bits for the same logits)."""
+
+    sp = _softplus(acc)
+    s = tl.sqrt(sp)
+    choice = tl.where(eok[None, :], s + tl.load(BIAS + e, mask=eok, other=0.0).to(tl.float32)[None, :],
+                      float("-inf"))
+    total = tl.zeros((16,), tl.float32)
+    for i in tl.static_range(K):
+        best = tl.max(choice, 1)
+        idx = tl.min(tl.where(choice == best[:, None], e[None, :], BE), 1)          # ties: the lower id
+        hit = e[None, :] == idx[:, None]
+        sv = tl.sum(tl.where(hit, s, 0.0), 1)
+        tl.store(PICK + rows * SLOTS + i, idx, mask=rok)
+        tl.store(WTS + rows * SLOTS + i, sv, mask=rok)
+        total = total + sv
+        choice = tl.where(hit, float("-inf"), choice)
+    for i in tl.static_range(K):
+        sv = tl.load(WTS + rows * SLOTS + i, mask=rok, other=0.0)
+        tl.store(WTS + rows * SLOTS + i, SCALE * (sv / total), mask=rok)
+    if SLOTS > K:
+        tl.store(PICK + rows * SLOTS + K, tl.full((16,), E, tl.int32), mask=rok)
+        tl.store(WTS + rows * SLOTS + K, tl.full((16,), 1.0, tl.float32), mask=rok)
+
+
+@triton.jit
+def _logits(X, x_stride, WG, LG, R, D: tl.constexpr, E: tl.constexpr, BE: tl.constexpr, BEB: tl.constexpr,
+            BK: tl.constexpr):
+    """Program (row block, expert block): logits [16, BEB] as fp32 FMA chains over k ascending (``tl.dot`` ieee:
+    each element's chain is its own, whatever the tile's width), stored to LG [R, BE]."""
+
+    pb = tl.program_id(0)
+    eb = tl.program_id(1)
+    rows = pb * 16 + tl.arange(0, 16)
+    rok = rows < R
+    e = eb * BEB + tl.arange(0, BEB)
+    eok = e < E
+    kk = tl.arange(0, BK)
+    acc = tl.zeros((16, BEB), tl.float32)
+    for k0 in range(0, D, BK):
+        x = tl.load(X + rows[:, None].to(tl.int64) * x_stride + (k0 + kk)[None, :], mask=rok[:, None],
+                    other=0.0).to(tl.float32)
+        w = tl.load(WG + e[None, :].to(tl.int64) * D + (k0 + kk)[:, None], mask=eok[None, :], other=0.0).to(
+            tl.float32)
+        acc = tl.dot(x, w, acc, input_precision="ieee")
+    tl.store(LG + rows[:, None].to(tl.int64) * BE + e[None, :], acc, mask=rok[:, None])
+
+
+@triton.jit
+def _select(LG, BIAS, PICK, WTS, R, E: tl.constexpr, K: tl.constexpr, SLOTS: tl.constexpr, SCALE: tl.constexpr,
+            BE: tl.constexpr):
+    """Program (row block): sqrt-softplus scores of the stored logits, top-K by score + bias, weights."""
+
+    pb = tl.program_id(0)
+    rows = pb * 16 + tl.arange(0, 16)
+    rok = rows < R
+    e = tl.arange(0, BE)
+    eok = e < E
+    acc = tl.load(LG + rows[:, None].to(tl.int64) * BE + e[None, :], mask=rok[:, None] & eok[None, :], other=0.0)
+    _pick(acc, rows, rok, e, eok, BIAS, PICK, WTS, E, K, SLOTS, SCALE, BE)
+
+
+@triton.jit
+def _route(X, x_stride, WG, BIAS, PICK, WTS, R, D: tl.constexpr, E: tl.constexpr, K: tl.constexpr,
+           SLOTS: tl.constexpr, SCALE: tl.constexpr, BE: tl.constexpr, BK: tl.constexpr):
+    pb = tl.program_id(0)
+    rows = pb * 16 + tl.arange(0, 16)
+    rok = rows < R
+    e = tl.arange(0, BE)
+    eok = e < E
+    kk = tl.arange(0, BK)
+    acc = tl.zeros((16, BE), tl.float32)
+    for k0 in range(0, D, BK):
+        x = tl.load(X + rows[:, None].to(tl.int64) * x_stride + (k0 + kk)[None, :], mask=rok[:, None],
+                    other=0.0).to(tl.float32)
+        w = tl.load(WG + e[None, :].to(tl.int64) * D + (k0 + kk)[:, None], mask=eok[None, :], other=0.0).to(
+            tl.float32)
+        acc = tl.dot(x, w, acc, input_precision="ieee")
+    _pick(acc, rows, rok, e, eok, BIAS, PICK, WTS, E, K, SLOTS, SCALE, BE)
+
+
+@triton.jit
+def _fused(X, x_stride, WG, BIAS, PICK, WTS, PART, CNT, LG, R, D: tl.constexpr, E: tl.constexpr, K: tl.constexpr,
+           SLOTS: tl.constexpr, SCALE: tl.constexpr, BE: tl.constexpr, BEB: tl.constexpr, BK: tl.constexpr,
+           S: tl.constexpr, KEEP: tl.constexpr):
+    """Program (row block, expert block, k slice): the partial [16, BEB] over k in [s D/S, (s + 1) D/S) ascending
+    (fp32 FMA chains from 0, ``tl.dot`` ieee) -> PART [R, S, E]; the row block's last-arriving program sums the S
+    partials in fixed order s = 0 .. S-1, selects (``_pick``) and resets the row block's counter. KEEP: the summed
+    logits also to LG [R, E] (tests)."""
+
+    pb = tl.program_id(0)
+    eb = tl.program_id(1)
+    sl = tl.program_id(2)
+    DS: tl.constexpr = D // S
+    rows = pb * 16 + tl.arange(0, 16)
+    rok = rows < R
+    e = eb * BEB + tl.arange(0, BEB)
+    eok = e < E
+    kk = tl.arange(0, BK)
+    acc = tl.zeros((16, BEB), tl.float32)
+    for k0 in range(sl * DS, sl * DS + DS, BK):
+        x = tl.load(X + rows[:, None].to(tl.int64) * x_stride + (k0 + kk)[None, :], mask=rok[:, None],
+                    other=0.0).to(tl.float32)
+        w = tl.load(WG + e[None, :].to(tl.int64) * D + (k0 + kk)[:, None], mask=eok[None, :], other=0.0).to(
+            tl.float32)
+        acc = tl.dot(x, w, acc, input_precision="ieee")
+    tl.store(PART + (rows[:, None].to(tl.int64) * S + sl) * E + e[None, :], acc, mask=rok[:, None] & eok[None, :])
+    tl.debug_barrier()                  # every thread's partial stored before the (one-thread) release below
+    old = tl.atomic_add(CNT + pb, 1, sem="acq_rel", scope="gpu")
+    if old == tl.num_programs(1) * S - 1:
+        ea = tl.arange(0, BE)
+        eaok = ea < E
+        m = rok[:, None] & eaok[None, :]
+        base = PART + rows[:, None].to(tl.int64) * (S * E) + ea[None, :]
+        lg = tl.load(base, mask=m, other=0.0, cache_modifier=".cg")
+        for s in tl.static_range(1, S):
+            lg = lg + tl.load(base + s * E, mask=m, other=0.0, cache_modifier=".cg")
+        if KEEP:
+            tl.store(LG + rows[:, None].to(tl.int64) * E + ea[None, :], lg, mask=m)
+        _pick(lg, rows, rok, ea, eaok, BIAS, PICK, WTS, E, K, SLOTS, SCALE, BE)
+        tl.atomic_xchg(CNT + pb, 0, sem="relaxed", scope="gpu")     # self-cleaning: the next launch starts at 0
+
+
+def _counters(device: torch.device) -> torch.Tensor:
+    """The device's fixed CHUNK / 16 int32 counters, all 0 between launches: allocated once outside graph capture
+    and never moved (graphs keep its address); a per-call zeroed buffer while capturing before the first eager call."""
+
+    key = (device.type, device.index)
+    cnt = _COUNTERS.get(key)
+    if cnt is None:
+        if device.type == "cuda" and torch.cuda.is_current_stream_capturing():
+            return torch.zeros(CHUNK // 16, dtype=torch.int32, device=device)
+        cnt = _COUNTERS[key] = torch.zeros(CHUNK // 16, dtype=torch.int32, device=device)
+    return cnt
+
+
+def _fused_launch(x, weight, bias, pick, wts, topk, slots, scale, keep=None):
+    R, D = x.shape
+    E = weight.shape[0]
+    if D % (SLICES * FBK):
+        raise ValueError(f"route: fused needs D % {SLICES * FBK} == 0 (D = {D})")
+    be = max(16, triton.next_power_of_2(E))
+    cnt = _counters(x.device)
+    part = torch.empty((min(R, CHUNK), SLICES, E), dtype=torch.float32, device=x.device)   # per call (G3)
+    for c0 in range(0, R, CHUNK):
+        c1 = min(R, c0 + CHUNK)
+        n = c1 - c0
+        lg = keep[c0:c1] if keep is not None else part
+        _fused[(triton.cdiv(n, 16), triton.cdiv(E, BEB), SLICES)](
+            x[c0:c1], x.stride(0), weight, bias, pick[c0:c1], wts[c0:c1], part, cnt, lg, n, D=D, E=E, K=topk,
+            SLOTS=slots, SCALE=scale, BE=be, BEB=BEB, BK=FBK, S=SLICES, KEEP=keep is not None, num_warps=FWARPS,
+            num_stages=FSTAGES)
+
+
+def route(x: torch.Tensor, weight: torch.Tensor, bias: torch.Tensor, *, topk: int = TOPK, shared: bool = True,
+          scale: float = SCALE, pick: torch.Tensor | None = None, wts: torch.Tensor | None = None,
+          split: bool | None = None, mode: str | None = None, keep: torch.Tensor | None = None):
+    """x bf16 [R, D], weight fp16 [E, D], bias fp16 [E] -> (pick int32 [R, topk + shared], wts fp32). ``mode``:
+    fused | split | one | gemv (default ``TF_DSV41_ROUTER``, else fused); ``split`` True / False is the old switch
+    (split / one). ``keep`` fp32 [R, E]: the logits the selection read, too (budget.py; gemv / fused write them
+    where they already go, split copies them, one recomputes them)."""
+
+    R, D = x.shape
+    E = weight.shape[0]
+    slots = topk + int(shared)
+    mode = mode or ({True: "split", False: "one"}.get(split) if split is not None else MODE)
+    if mode not in MODES:
+        raise ValueError(f"route: mode {mode!r} not in {MODES}")
+    if weight.shape[1] != D or not weight.is_contiguous() or x.stride(1) != 1 or E > BE:
+        raise ValueError("route: weight [E <= 512, D] contiguous, x unit-stride")
+    if pick is None:
+        pick = torch.empty((R, slots), dtype=torch.int32, device=x.device)
+    if wts is None:
+        wts = torch.empty((R, slots), dtype=torch.float32, device=x.device)
+    if R == 0:
+        return pick, wts
+    if mode == "gemv":
+        from . import router_gemv as RG
+
+        if not x.is_cuda:
+            if keep is not None:
+                keep.copy_(RG.logits(x, weight))
+            return RG.emulate(x, weight, bias, topk, shared, scale, pick, wts)
+        if RG.supports(x, weight, topk):
+            RG.route(x, weight, bias, topk, slots, scale, pick, wts, keep=keep)
+            if _CHECK:
+                from . import router_check
+
+                router_check.record(x, weight, bias, topk, shared, scale, pick, wts, mode="gemv")
+            return pick, wts
+        mode = "split"                              # no instance for this gate (a function of the weight only)
+    if mode == "fused" and D % (SLICES * FBK):
+        mode = "split"                              # widths the slices do not divide (synthetic test checkpoints, D
+                                                    # 128): G4's path, a function of D only (rows stay invariant)
+    if mode == "fused":
+        _fused_launch(x, weight, bias, pick, wts, topk, slots, scale, keep=keep)
+        if _CHECK:                                  # TF_DSV41_ROUTER_CHECK (G6 diagnostic): fused vs split, eager
+            from . import router_check
+
+            router_check.record(x, weight, bias, topk, shared, scale, pick, wts)
+    elif mode == "one":
+        _route[(triton.cdiv(R, 16),)](x, x.stride(0), weight, bias, pick, wts, R, D=D, E=E, K=topk, SLOTS=slots,
+                                      SCALE=scale, BE=BE, BK=BK, num_warps=WARPS, num_stages=STAGES)
+        if keep is not None:
+            keep.copy_(logits(x, weight, mode="split"))
+    else:
+        lg = torch.empty((R, BE), dtype=torch.float32, device=x.device)     # per call: graph-safe (G3)
+        _logits[(triton.cdiv(R, 16), triton.cdiv(E, BEB))](x, x.stride(0), weight, lg, R, D=D, E=E, BE=BE, BEB=BEB,
+                                                            BK=64, num_warps=4, num_stages=3)
+        _select[(triton.cdiv(R, 16),)](lg, bias, pick, wts, R, E=E, K=topk, SLOTS=slots, SCALE=scale, BE=BE,
+                                       num_warps=WARPS)
+        if keep is not None:
+            keep.copy_(lg[:, :E])
+    return pick, wts
+
+
+def route_fold(x: torch.Tensor, weight: torch.Tensor, bias: torch.Tensor, *, topk: int = TOPK, scale: float = SCALE,
+               kit: bool = False, group=None, mode: str | None = None, fold: bool | None = None):
+    """``route`` (shared slot on) with the expert path's next steps folded into the router's tail where it can
+    (``TF_DSV41_RG_TAIL=1`` or ``fold``, the gemv path on CUDA, no ``TF_DSV41_ROUTER_CHECK``): ``kit`` = the weights
+    rounded to fp16 in the selection (pick.kit_weights' two cast launches, the same bits); ``group`` = (ids, count,
+    members, GE) for upstream's grouping (the narrow kernel, R <= 16; router_gemv.py). Returns (pick, wts, kit_done,
+    grouped): the caller still applies ``kit_weights`` when not kit_done and runs ``group`` when not grouped."""
+
+    mode = mode or MODE
+    if fold is None:
+        from . import router_gemv as RG
+
+        fold = RG.TAIL
+    if not (fold and mode == "gemv" and x.is_cuda and not _CHECK) or x.shape[0] == 0:
+        pick, wts = route(x, weight, bias, topk=topk, shared=True, scale=scale, mode=mode)
+        return pick, wts, False, False
+    from . import router_gemv as RG
+
+    if not RG.supports(x, weight, topk) or weight.shape[1] != x.shape[1] or not weight.is_contiguous():
+        pick, wts = route(x, weight, bias, topk=topk, shared=True, scale=scale, mode=mode)
+        return pick, wts, False, False
+    R = x.shape[0]
+    pick = torch.empty((R, topk + 1), dtype=torch.int32, device=x.device)
+    wts = torch.empty((R, topk + 1), dtype=torch.float32, device=x.device)
+    grouped = RG.route(x, weight, bias, topk, topk + 1, scale, pick, wts, kit=kit, group=group)
+    return pick, wts, bool(kit), grouped
+
+
+def logits(x: torch.Tensor, weight: torch.Tensor, mode: str = "fused") -> torch.Tensor:
+    """The fp32 logits [R, E] a path selects from (tests: the fused sum vs ``split``'s 5,120-long chains)."""
+
+    R, D = x.shape
+    E = weight.shape[0]
+    if mode == "gemv":
+        from . import router_gemv as RG
+
+        if not x.is_cuda or RG.supports(x, weight, 1):
+            return RG.logits(x, weight)
+    if mode == "fused":
+        out = torch.empty((R, E), dtype=torch.float32, device=x.device)
+        bias = torch.zeros(E, dtype=torch.float16, device=x.device)
+        pick = torch.empty((R, 1), dtype=torch.int32, device=x.device)
+        wts = torch.empty((R, 1), dtype=torch.float32, device=x.device)
+        _fused_launch(x, weight, bias, pick, wts, 1, 1, SCALE, keep=out)
+        return out
+    lg = torch.empty((R, BE), dtype=torch.float32, device=x.device)
+    _logits[(triton.cdiv(R, 16), triton.cdiv(E, BEB))](x, x.stride(0), weight, lg, R, D=D, E=E, BE=BE, BEB=BEB,
+                                                        BK=64, num_warps=4, num_stages=3)
+    return lg[:, :E]
+
+
+def reference(x: torch.Tensor, weight: torch.Tensor, bias: torch.Tensor, topk: int = TOPK, scale: float = SCALE):
+    """Float64 routing: (pick [R, topk] by (score + bias desc, id asc), weights [R, topk])."""
+
+    logit = x.double() @ weight.double().T
+    s = torch.nn.functional.softplus(logit).sqrt()
+    choice = s + bias.double()
+    picks, ws = [], []
+    for r in range(x.shape[0]):
+        order = sorted(range(weight.shape[0]), key=lambda e: (-float(choice[r, e]), e))[:topk]
+        sv = s[r, order]
+        picks.append(order)
+        ws.append((scale * sv / sv.sum()).tolist())
+    return torch.tensor(picks, dtype=torch.int32), torch.tensor(ws, dtype=torch.float64)
diff --git a/src/tensorfold/families/deepseek_v41/cuda/router_check.py b/src/tensorfold/families/deepseek_v41/cuda/router_check.py
