@@ -0,0 +1,176 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The decode top-k (``csa2/dtopk.py``, TF_DSV41_INDEX_DTOPK) on the GPU (collected only where PyTorch sees an
+NVIDIA GPU), compiled kernels:
+
+- dense selections (top-512 of 2K .. 75K keys), candidate blocks (top-2,048 blocks) and candidate gathers (top-512
+  of 16,384 candidate positions) == the torch path (``index.sort_keys`` + ``index.top_positions`` +
+  ``backend.visible_counts``) bit for bit, at 1 / 2 / 4 / 16 / 64 rows, with ties, -inf rows and short rows;
+- inside a CUDA graph (captured once, replayed over new scores) == the torch path;
+- ``backend.Triton`` select / select_cand / reindex with the knob on == off over real index scores;
+- the time of old vs new a call (printed, ``[DTOPK]``), and of 8- vs 11-bit digits.
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_dtopk_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.families.deepseek_v41.cuda.csa2 import dtopk as DT  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import index  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.backend import Win, visible_counts  # noqa: E402
+
+DEV = "cuda"
+NINF = float("-inf")
+
+
+def _us(fn, reps: int = 50) -> float:
+    fn()
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(reps):
+        fn()
+    b.record()
+    torch.cuda.synchronize()
+    return 1000.0 * a.elapsed_time(b) / reps
+
+
+def _scores(R: int, n: int, P: int, ratio: int, seed: int) -> torch.Tensor:
+    g = torch.Generator().manual_seed(seed)
+    s = torch.randn((R, n), generator=g)
+    if n > 1000:
+        s[:, 10:60] = 0.0
+        s[:, 61:70] = -0.0
+        s[:, 100:n:7] = 1.5                       # ~n / 7 equal scores straddling the cut
+        s[:, n // 2] = float("nan")
+    for r in range(R):
+        s[r, (P + r + 1) // ratio:] = NINF
+    return s.to(DEV).contiguous()
+
+
+def _old_select(s, pos, win, ratio, k):
+    sel = index.top_positions(index.sort_keys(s), k)
+    return sel, visible_counts(sel, win, ratio)
+
+
+@pytest.mark.parametrize("R", [1, 2, 4, 16, 64])
+@pytest.mark.parametrize("n", [700, 2048, 16384, 75000])
+def test_select_equals_torch_path(R, n):
+    ratio = 4
+    P = n * ratio - R                                # the last row sees n keys
+    s = _scores(R, n, P, ratio, R * 7 + n)
+    win = Win.make(P, R, DEV)
+    want, wc = _old_select(s, win.t, win, ratio, 512)
+    got, gc = DT.select(s, win.t, ratio, 512)
+    assert torch.equal(got, want) and torch.equal(gc, wc)
+    got, gc = DT.select(s, win.positions, ratio, 512, rows=True)
+    assert torch.equal(got, want) and torch.equal(gc, wc)
+    if R > 1:                                        # a row alone == in the window
+        one, oc = DT.select(s[R - 1:].contiguous(), win.positions[R - 1:], ratio, 512, rows=True)
+        assert torch.equal(one[0], want[R - 1]) and int(oc[0]) == int(wc[R - 1])
+
+
+@pytest.mark.parametrize("R", [1, 4, 16])
+@pytest.mark.parametrize("n", [3000, 65536, 75000])
+def test_blocks_and_gather_equal_torch_path(R, n):
+    P = n - R
+    s = _scores(R, n, P, 1, n + R)
+    win = Win.make(P, R, DEV)
+    cand = index.candidate_blocks(s, win.t, R, 1, topk_blocks=2048)
+    assert torch.equal(DT.blocks(s, win.t, 1, 2048), cand)
+    assert torch.equal(DT.blocks(s, win.positions, 1, 2048, rows=True), cand)
+    keys = index.candidate_keys(cand)
+    g = torch.Generator().manual_seed(n)
+    s2 = torch.randn(keys.shape, generator=g).to(DEV)
+    s2[:, 50:3000:5] = 0.25
+    s2 = torch.where(keys >= 0, s2, torch.full_like(s2, NINF)).contiguous()
+    want = index.top_positions(index.sort_keys(s2, keys), 512)
+    wc = visible_counts(want, win, 1)
+    for got, gc in (DT.gather_cand(s2, cand, win.t, 1, 512), DT.gather(s2, keys, win.t, 1, 512)):
+        assert torch.equal(got, want) and torch.equal(gc, wc)
+
+
+def test_cuda_graph_replay_equals_torch_path():
+    R, n, ratio = 4, 16384, 4
+    P = n * ratio - R
+    win = Win.make(P, R, DEV)
+    s = _scores(R, n, P, ratio, 1)
+    cs = torch.empty((R, (n + 7) // 8 * 8), device=DEV)[:, :n]
+    cs.copy_(s)
+    DT.select(cs, win.t, ratio, 512)
+    DT.blocks(cs, win.t, ratio, 2048)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        sel, cnt = DT.select(cs, win.t, ratio, 512)
+        blk = DT.blocks(cs, win.t, ratio, 2048)
+    for seed in (2, 3, 4):
+        cs.copy_(_scores(R, n, P, ratio, seed))
+        graph.replay()
+        torch.cuda.synchronize()
+        want, wc = _old_select(cs, win.t, win, ratio, 512)
+        assert torch.equal(sel, want) and torch.equal(cnt, wc)
+        assert torch.equal(blk, index.candidate_blocks(cs, win.t, R, ratio, topk_blocks=2048))
+
+
+def test_backend_knob_on_equals_off():
+    from tensorfold.families.deepseek_v41.cuda.csa2.backend import Triton
+    from tensorfold.families.deepseek_v41.cuda.csa2.stores import Keys
+
+    R, ratio, nk = 4, 4, 30000
+    P = nk * ratio - R
+    g = torch.Generator().manual_seed(5)
+    qi = torch.randn((R, 32, 128), generator=g).to(torch.bfloat16).to(DEV)
+    w = torch.randn((R, 32), generator=g).to(DEV)
+    ik = torch.randn((nk, 128), generator=g)
+    ik[1000:1400] = 0.0
+    keys = Keys(ik.to(torch.bfloat16).to(DEV))
+    be = Triton(R, 64, DEV)
+    win = Win.make(P, R, DEV)
+    out = {}
+    for on in (False, True):
+        be.dtopk = on
+        sel, cand = be.select_cand(qi, w, keys, win, ratio, 512, 8, 2048)
+        rsel = be.reindex(qi, w, keys, win, cand, ratio, 512, 8)
+        out[on] = [sel, cand, rsel] + [visible_counts(x, win, ratio) for x in (sel, rsel)]
+    for a, b in zip(out[False], out[True]):
+        assert torch.equal(a, b)
+
+
+@pytest.mark.parametrize("n", [4096, 16384, 32768, 75000])
+def test_microbench(n, monkeypatch):
+    for R in (1, 4, 16):
+        ratio = 4
+        P = n * ratio - R
+        s = _scores(R, n, P, ratio, 9)
+        win = Win.make(P, R, DEV)
+        old = _us(lambda: _old_select(s, win.t, win, ratio, 512))
+        new = {}
+        for rb in (8, 11):
+            monkeypatch.setattr(DT, "RB", rb)
+            new[rb] = _us(lambda: DT.select(s, win.t, ratio, 512))
+        monkeypatch.setattr(DT, "RB", 8)
+        want = DT.select(s, win.t, ratio, 512)
+        cfg = []
+        for tile, warps in ((1024, 4), (2048, 8), (4096, 8), (4096, 16), (8192, 16)):
+            monkeypatch.setattr(DT, "TILE", tile)
+            monkeypatch.setattr(DT, "WARPS", warps)
+            assert torch.equal(DT.select(s, win.t, ratio, 512)[0], want[0])
+            cfg.append(f"{tile}/{warps}: {_us(lambda: DT.select(s, win.t, ratio, 512)):.1f}")
+        monkeypatch.undo()
+        print(f"\n[DTOPK] n={n} R={R}: select us by TILE/WARPS " + ", ".join(cfg))
+        ob = _us(lambda: index.candidate_blocks(s, win.t, R, ratio, topk_blocks=2048))
+        nb = _us(lambda: DT.blocks(s, win.t, ratio, 2048))
+        cand = index.candidate_blocks(s, win.t, R, ratio, topk_blocks=2048)
+        keys = index.candidate_keys(cand)
+        s2 = torch.randn(keys.shape, device=DEV)
+        og = _us(lambda: (index.top_positions(index.sort_keys(s2, index.candidate_keys(cand)), 512)))
+        ng = _us(lambda: DT.gather_cand(s2, cand, win.t, ratio, 512))
+        print(f"\n[DTOPK] n={n} R={R}: select old {old:.1f} us, new {new[8]:.1f} (RB 8) / {new[11]:.1f} (RB 11); "
+              f"blocks old {ob:.1f} new {nb:.1f}; reindex top-k old {og:.1f} new {ng:.1f}")
