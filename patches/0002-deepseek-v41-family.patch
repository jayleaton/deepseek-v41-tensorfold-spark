+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Image parts in chat requests (``TF_DSV41_IMAGES``), the app and the engine's request side, on the CPU:
+
+- every mode renders and runs a text-only request exactly as before (the same prompt text, the same ids to the
+  engine, no ``request.images``);
+- ``reject``: HTTP 400 "images are not served" (the old behaviour);
+- ``placeholder`` (default): each image part (user or tool message, any OpenAI / Anthropic shape) becomes the notice,
+  the reply runs, ``stats.images_omitted`` and a log line say how many;
+- ``native``: the rendering == DeepSeek's reference encoder (``<｜deepseek_image｜>``, the images in prompt order
+  even when tool results are re-sorted), each placeholder -> its span's virtual ids for the engine (``/tokenize``:
+  image tokens), ``check`` counts the span, the same image keys the same ids (session / prefix caches share it),
+  another image other ids;
+- ``<｜deepseek_image｜>`` typed as text (any field, any mode, beside real images or not) is plain text, never the
+  image id (the reference refuses it; a refusal would break an agent's conversation); the placeholder notice tells
+  the model not to guess;
+- ``engine.generate`` encodes the request's images on rank 0, holds their rows for exactly the request's life, and
+  refuses virtual ids without images.
+"""
+
+from __future__ import annotations
+
+import base64
+import copy
+import importlib.util
+import io
+import itertools
+import json
+import threading
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("PIL")
+from dsv41_serving_fakes import model_dir_fixture  # noqa: F401  (fixture)
+from test_dsv41_serving_app import ScriptEngine
+from test_dsv41_serving_template import TOOLS, cases
+
+from tensorfold.families.deepseek_v41.cuda import encoding, vision_prep
+from tensorfold.families.deepseek_v41.cuda.app import IMAGE_TEXT, Dsv41App
+
+pytestmark = pytest.mark.filterwarnings("ignore")
+_spec = importlib.util.spec_from_file_location("dsv41_encoding_ref",
+                                               Path(__file__).parent / "fixtures" / "dsv41_encoding_ref.py")
+ref = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(ref)
+
+
+def png_url(w: int, h: int, seed: int) -> str:
+    from PIL import Image
+
+    g = torch.Generator().manual_seed(seed)
+    arr = (torch.rand(h, w, 3, generator=g) * 255).to(torch.uint8).numpy()
+    buf = io.BytesIO()
+    Image.fromarray(arr, "RGB").save(buf, format="PNG")
+    return "data:image/png;base64," + base64.b64encode(buf.getvalue()).decode()
+
+
+A, B = png_url(120, 90, 1), png_url(60, 200, 2)
+
+
+def make_app(model_dir, monkeypatch, mode: str | None):
+    from tokenizers import Tokenizer
+
+    if mode is None:
+        monkeypatch.delenv("TF_DSV41_IMAGES", raising=False)
+    else:
+        monkeypatch.setenv("TF_DSV41_IMAGES", mode)
+    monkeypatch.delenv("TF_DSV41_BIAS_VL", raising=False)
+    eng = ScriptEngine(Tokenizer.from_file(str(model_dir / "tokenizer.json")))
+    return Dsv41App(eng, model_dir, "deepseek-v4.1-flash")
+
+
+@pytest.fixture(scope="module")
+def apps(model_dir):
+    mp = pytest.MonkeyPatch()
+    out = {m: make_app(model_dir, mp, m) for m in ("reject", "placeholder", "native")}
+    out["default"] = make_app(model_dir, mp, None)
+    mp.undo()
+    return out
+
+
+def run(app, body, script="ok</think>Fine."):
+    app.engine.script = script
+    res = app.run(copy.deepcopy(body), True, lambda d: True)
+    return res, app.engine.prompts[-1]
+
+
+def user(*parts):
+    return {"role": "user", "content": list(parts)}
+
+
+def img(url, shape="openai"):
+    if shape == "anthropic":
+        data = url.split(",", 1)[1]
+        return {"type": "image", "source": {"type": "base64", "media_type": "image/png", "data": data}}
+    if shape == "input_image":
+        return {"type": "input_image", "image_url": url}
+    return {"type": "image_url", "image_url": {"url": url}}
+
+
+def text(t):
+    return {"type": "text", "text": t}
+
+
+# -- text-only requests: unchanged in every mode -------------------------------------------------------------------
+def test_text_only_is_byte_identical_in_every_mode(apps):
+    for name, messages, tools in cases():
+        for thinking in (True, False):
+            body = {"messages": messages, "tools": tools, "chat_template_kwargs": {"enable_thinking": thinking}}
+            body = {k: v for k, v in body.items() if v is not None}
+            base = encoding.encode(copy.deepcopy(messages), tools=tools, thinking=thinking)
+            prompts = set()
+            for mode, app in apps.items():
+                assert app.render(copy.deepcopy(body))[0] == base, (name, mode)
+                res, prompt = run(app, body)
+                assert getattr(app.engine.request, "images", None) is None
+                assert "images_omitted" not in (res["stats"] or {})
+                prompts.add(tuple(prompt))
+            assert len(prompts) == 1, name
+            assert list(prompts.pop()) == apps["reject"].tok.encode(base, add_special_tokens=False).ids
+
+
+def test_default_mode_is_placeholder(apps):
+    assert apps["default"].images == "placeholder"
+
+
+# -- reject ---------------------------------------------------------------------------------------------------------
+def test_reject(apps):
+    app = apps["reject"]
+    problem = app.check({"messages": [user(text("look"), img(A))]})
+    assert problem and "images are not served" in problem
+    with pytest.raises(ValueError, match="images are not served"):
+        app.render({"messages": [user(img(A))]})
+
+
+# -- placeholder ----------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("shape", ["openai", "anthropic", "input_image"])
+def test_placeholder_keeps_the_turn_going(apps, shape, capsys):
+    app = apps["placeholder"]
+    msgs = [{"role": "system", "content": "sys"}, user(text("what is on screen?"), img(A, shape)),
+            {"role": "assistant", "content": None, "reasoning_content": "look",
+             "tool_calls": [{"id": "c1", "type": "function", "function": {"name": "screenshot", "arguments": "{}"}}]},
+            {"role": "tool", "tool_call_id": "c1", "content": [text("captured"), img(B, shape)]}]
+    body = {"messages": msgs, "tools": TOOLS}
+    assert app.check(copy.deepcopy(body)) is None
+    res, prompt = run(app, body)
+    rendered = app.render(copy.deepcopy(body))[0]
+    assert rendered.count(IMAGE_TEXT) == 2
+    assert f"what is on screen?\n\n{IMAGE_TEXT}" in rendered and f"<tool_result>captured\n\n{IMAGE_TEXT}" in rendered
+    assert res["content"] == "Fine." and res["stats"]["images_omitted"] == 2
+    assert prompt == app.tok.encode(rendered, add_special_tokens=False).ids
+    assert max(prompt) < vision_prep.VBASE and app.engine.request.images is None
+    assert "2 image part(s) replaced" in capsys.readouterr().out
+
+
+def test_placeholder_text_knob(model_dir, monkeypatch):
+    monkeypatch.setenv("TF_DSV41_IMAGE_TEXT", "[no image]")
+    app = make_app(model_dir, monkeypatch, "placeholder")
+    assert "a\n\n[no image]" in app.render({"messages": [user(text("a"), img(A))]})[0]
+
+
+# -- native ---------------------------------------------------------------------------------------------------------
+def test_native_matches_the_reference_encoder(apps):
+    app = apps["native"]
+    msgs = [user(text("first"), img(A), text("then"), img(B), text("compare?"))]
+    for thinking in (True, False):
+        body = {"messages": msgs, "chat_template_kwargs": {"enable_thinking": thinking}}
+        got, _, urls, omitted = app._render(copy.deepcopy(body))
+        want, media = ref.encode_messages(copy.deepcopy(msgs), thinking_mode="thinking" if thinking else "chat",
+                                          return_multi_modal_data=True)
+        assert got == want and urls == [r["url"] for r in media["images"]] == [A, B] and omitted == 0
+
+
+def test_native_prompt_ids_tokenize_and_check(apps):
+    app = apps["native"]
+    s = app.vision_host.s
+    body = {"messages": [user(text("first"), img(A), text("then"), img(B))]}
+    res, prompt = run(app, body)
+    imgs = app.engine.request.images
+    assert [len(i.vids) for i in imgs] == [i.tokens for i in imgs] and len(imgs) == 2
+    text_ids = app.tok.encode(app.render(copy.deepcopy(body))[0], add_special_tokens=False).ids
+    assert prompt == vision_prep.expand(text_ids, imgs, s)
+    assert res["prompt_tokens"] == len(prompt) == len(text_ids) - 2 + sum(i.tokens for i in imgs)
+    tok = app.tokenize(copy.deepcopy(body))
+    assert len(tok) == len(prompt) and tok.count(s.image_token) == sum(i.tokens for i in imgs)
+    assert max(tok) < vision_prep.VBASE
+    assert app.check(copy.deepcopy(body)) is None
+    big = dict(body, max_tokens=app.engine.limit - len(text_ids))     # fits without the span, not with it
