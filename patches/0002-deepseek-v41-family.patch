+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""``mhc_pf.cu``'s work placement and arithmetic in numpy (tests/test_dsv41_mhc_pf.py): the grid (column block b, a
+16-row tile), each thread's phase A items and phase B chains, the shared-memory staging of the new streams / the
+collapsed row / ``fn``, and every global store, with the kernel's index formulas. Values are exact (fp32, one
+rounding an operation, nearest even; ``mhc_cuda_emu``'s ``bf16r`` / ``fma32``); every store is counted, so a test sees
+an output written twice or never.
+
+``emulate`` takes ``mhc_cuda_emu``'s arrays (bf16 values held as float32; ``x`` [R, 4 D], ``gathered`` [world, R, D],
+``post`` / ``pre`` [R, 4], ``comb`` [R, 16], ``fn`` [24, 4 D]) and returns ``x`` (new streams, POST), ``c``, ``tap``,
+``part`` [R, 4, NB, 32] (entries the kernel never writes stay NaN) and ``writes`` (store counts a buffer).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+
+from tensorfold.families.deepseek_v41.cuda.mhc_cuda_emu import bf16r, fma32
+
+NB = 40
+NMIX = 24
+BM = 16
+NT = 128
+PW = 32
+F32 = np.float32
+
+
+def items(t: int, d: int) -> list[tuple[int, int]]:
+    """Thread t's phase A items (row in the tile, 8-column group): i = t + n NT for n < IPT."""
+
+    g8 = d // NB // 8
+    ipt = BM * g8 // NT
+    return [((t + n * NT) // g8, (t + n * NT) % g8) for n in range(ipt)]
+
+
+def chains(t: int) -> tuple[int, int, list[int]]:
+    """Thread t's phase B chains: (row in the tile, stream, kinds in slot order); kind 24 = the stream's square sum,
+    25 = the collapsed row's (stream 0, h 1)."""
+
+    rl, j, h = t % BM, (t // BM) % 4, t // (4 * BM)
+    if h == 0:
+        return rl, j, list(range(13))
+    return rl, j, list(range(13, 25)) + ([25] if j == 0 else [])
+
+
+def emulate(x, gathered, post, comb, pre, fn, *, post_on: bool, collapse: int, tap: bool = False) -> dict:
+    x = np.ascontiguousarray(x, dtype=F32)
+    R, d = x.shape[0], x.shape[1] // 4
+    cb = d // NB
+    fn = np.ascontiguousarray(fn, dtype=F32)
+    out = {"x": np.full_like(x, np.nan) if post_on else None, "c": np.full((R, d), np.nan, dtype=F32),
+           "tap": np.full((R, d), np.nan, dtype=F32) if tap else None,
+           "part": np.full((R, 4, NB, PW), np.nan, dtype=F32)}
+    writes = {k: np.zeros(v.shape, dtype=np.int32) for k, v in out.items() if v is not None}
+    for ty in range(-(-R // BM)):
+        r0 = ty * BM
+        for b in range(NB):
+            xs = np.zeros((4, BM, cb), dtype=F32)                    # the CTA's shared new streams
+            cs = np.zeros((BM, cb), dtype=F32)
+            fns = fn.reshape(NMIX, 4, d)[:, :, b * cb:(b + 1) * cb].transpose(1, 0, 2)   # [stream, mix, 128]
+            for t in range(NT):                                      # phase A
+                for rl, q in items(t, d):
+                    r, col = r0 + rl, b * cb + q * 8
+                    cols = slice(col, col + 8)
+                    if r < R:
+                        xv = [x[r, s * d + col:s * d + col + 8].copy() for s in range(4)]
+                    else:
+                        xv = [np.zeros(8, dtype=F32) for _ in range(4)]
+                    if post_on and r < R:
+                        br = np.asarray(gathered[0][r, cols], dtype=F32).copy()
+                        for w in range(1, len(gathered)):
+                            br = (br + np.asarray(gathered[w][r, cols], dtype=F32)).astype(F32)
+                        br = bf16r(br)
+                        y = []
+                        for i in range(4):
+                            c0, c1, c2, c3 = (F32(comb[r, 4 * k + i]) for k in range(4))
+                            m = ((c0 * xv[0] + c1 * xv[1]) + c2 * xv[2]) + c3 * xv[3]
+                            y.append(bf16r(F32(post[r, i]) * br + m))
+                        for s in range(4):
+                            out["x"][r, s * d + col:s * d + col + 8] = y[s]
+                            writes["x"][r, s * d + col:s * d + col + 8] += 1
+                        xv = y
+                    if collapse == 2 and r < R:
+                        q0, q1, q2, q3 = (F32(pre[r, k]) for k in range(4))
+                        cv = bf16r(((q0 * xv[0] + q1 * xv[1]) + q2 * xv[2]) + q3 * xv[3])
+                    else:
+                        cv = xv[0].copy()
+                    if r < R:
+                        out["c"][r, cols] = cv
+                        writes["c"][r, cols] += 1
+                        if post_on and tap:
+                            out["tap"][r, cols] = bf16r((((xv[0] + xv[1]) + xv[2]) + xv[3]) * F32(0.25))
+                            writes["tap"][r, cols] += 1
+                    for s in range(4):
+                        xs[s, rl, q * 8:q * 8 + 8] = xv[s]
+                    cs[rl, q * 8:q * 8 + 8] = cv
+            rows, js, kinds_, slot = [], [], [], []                  # phase B, every thread's chains at once
+            for t in range(NT):
+                rl, j, kinds = chains(t)
+                for s, k in enumerate(kinds):
+                    rows.append(rl)
+                    js.append(j)
+                    kinds_.append(k)
+                    slot.append(s)
+            rows, js, kinds_ = np.array(rows), np.array(js), np.array(kinds_)
+            src = np.where((kinds_ == 25)[:, None], cs[rows], xs[js, rows])              # [chains, 128]
+            wt = np.where((kinds_ < NMIX)[:, None], fns[js, np.minimum(kinds_, NMIX - 1)], src)
+            acc = np.zeros(len(rows), dtype=F32)
+            for k in range(cb):
+                acc = fma32(src[:, k], wt[:, k], acc)
+            for i in range(len(rows)):
+                r = r0 + rows[i]
+                if r < R:
+                    out["part"][r, js[i], b, kinds_[i]] = acc[i]
+                    writes["part"][r, js[i], b, kinds_[i]] += 1
+    out["writes"] = writes
+    return out
+
+
+__all__ = ["BM", "NB", "NT", "chains", "emulate", "items"]
