+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Slot-agnostic CUDA graphs for verify windows (G8, ``TF_DSV41_GRAPH_MODE=rows``, the default where row mode is
+possible): one graph per (padded total rows, context bucket) serves **any mix of slots**.
+
+G7 found 2- and 4-stream decode slower than 1 stream because a window mixing slots ran eagerly (graphs were keyed
+by the mix: (slot, rows) of each window), 23-34 ms of Python launches a round. Here a window of any slots is one
+row-mode run (``rowtab`` / ``rowmode``): every per-row value (id, position, the slot it reads and writes, ratio-2
+pooling's previous row, the Engram mirror row) is a column of one device table written by one non-blocking copy from
+pinned memory before the replay, and the slots' rings, carries and page tables are stacked, so a slot id is an
+offset. The rows are padded to a bucket (``rowtab.BUCKETS``: 1-8, 12, 16, 24, 32, 48, 64): padding rows mirror the
+last real row (the same arithmetic and experts) and write nothing; their logits are cut before the candidates.
+
+- **Key** (rows bucket, context bucket): the indexer scores ``nvis_max`` keys, a host value fixed at capture
+  (``graphs.bucket_end``; a row's keys past its own end score -inf and never reach its attention). A window of more
+  than 16 rows a slot, more than 64 rows or a slot twice runs eagerly.
+- **Boot** captures ``TF_DSV41_GRAPH_WARM`` (``decode``: 1-8 rows; ``all``: every bucket) at context bucket 0
+  within ``TF_DSV41_GRAPH_BUDGET_S``; the rest are captured on first use (that window runs eagerly, one launch
+  sequence a segment: its result is the round's). Memory floor, cap, both-ranks agreement and fallback are
+  ``graphs.GraphCache``'s.
+- **Exactness**: a row-mode run gives every real row the per-segment run's bits (each kernel's program computes a
+  row from that row, at the addresses the table names), so replay == eager, batched == alone, drafted == serial
+  (tests/test_dsv41_rowmode_interp.py, tests/cuda/test_dsv41_multistream_gpu.py).
+- **Fingerprint**: the MoE scratch, the stacked rings / carries / page tables and the row table; any change drops
+  every graph (captured again on use).
+- **Engram**: staged into persistent rows (``LazyEngram``: the host reads them) or, with ``TF_DSV41_ENGRAM_GATE=1``,
+  read by the gate kernel inside the graph (``engram_gate``: staging only arms the round); either way the padded
+  rows take their mirror's rows through one in-graph gather (``rowmode.Mirrored``).
+
+Knobs: TF_DSV41_GRAPH_MODE (rows; mix = the per-mix graphs of ``graphs.CudaGraphs``), TF_DSV41_GRAPH_ROWS_MAX (64:
+the largest bucket), and ``graphs.env_settings``'s.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+from dataclasses import dataclass, field
+from typing import Any
+
+from . import rowtab as RT
+from .graphs import PREFILL, GraphCache, bucket_end, env_settings, room_for
+from .phases import PH
+
+
+def mode() -> str:
+    m = (os.environ.get("TF_DSV41_GRAPH_MODE", "rows").strip() or "rows").lower()
+    if m not in ("rows", "mix"):
+        raise ValueError(f"TF_DSV41_GRAPH_MODE={m!r}: expected rows or mix")
+    return m
+
+
+def buckets(env=None) -> tuple[int, ...]:
+    env = os.environ if env is None else env
+    top = int((env.get("TF_DSV41_GRAPH_ROWS_MAX", "") or "64").strip())
+    out = tuple(b for b in RT.BUCKETS if b <= top)
+    if not out:
+        raise ValueError(f"TF_DSV41_GRAPH_ROWS_MAX={top}: below the smallest bucket")
+    return out
+
+
+@dataclass
+class RowView:
+    win: Any                    # csa2.backend.RowWin over the table's first R rows
+    src: Any                    # int64 [R]: each row's Engram source row
+
+
+@dataclass
+class RowStatic:
+    """What ``fw.static`` holds during a row-mode run: the ids, the staged Engram rows, the row view."""
+
+    ids: Any
+    engram: dict
+    rowv: RowView
+
+
+@dataclass
+class Entry:
+    key: tuple
+    graph: Any = None
+    out: Any = None             # logits [R, V / W] (graph memory)
+    proj: dict = field(default_factory=dict)        # ratio-2 layer -> [R, 2 D] (pending carries)
+    taps: dict = field(default_factory=dict)        # tap layer -> [R, D]
+
+
+class Rows:
+    """Row mode's inputs (no CUDA needed: the CPU interpreter tests drive it): the persistent row table, the staged
+    Engram rows and each key's ``RowStatic`` (what ``fw.static`` holds for a row-mode run)."""
+
+    def __init__(self, fw, rmax: int, bucket: int) -> None:
+        import torch
+
+        self.torch, self.fw, self.bucket = torch, fw, int(bucket)
+        self.tab = RT.RowTable(rmax, fw.device)
+        self.engram: dict = {}                      # layer -> persistent rows [R max, cols] (staged Engram)
+        self.statics: dict = {}
+
+    def static(self, key) -> RowStatic:
+        st = self.statics.get(key)
+        if st is None:
+            R = key[0]
+            cap = bucket_end(key[1], self.bucket, self.fw.limit)
+            st = self.statics[key] = RowStatic(self.tab.ids(R), {}, RowView(self.tab.win(R, cap), self.tab.src(R)))
+        st.engram = {L: buf[:key[0]] for L, buf in self.engram.items()}
+        return st
+
+    def stage(self, key, segs) -> None:
+        """The window's table (one copy) and Engram rows (the real rows; through the gate: armed only)."""
+
+        fw = self.fw
+        mix = [(sg.slot, sg.start, len(sg.ids)) for sg in segs]
+        self.tab.stage(RT.plan_rows(mix, [t for sg in segs for t in sg.ids], key[0], len(fw.slots)))
+        for L, v in fw.engram_inputs_eager(segs).items():
+            buf = self.engram.get(L)
+            if buf is None or buf.shape[1:] != v.shape[1:] or buf.dtype != v.dtype:
+                buf = self.engram[L] = self.torch.zeros((self.tab.rmax, *v.shape[1:]), dtype=v.dtype,
+                                                        device=fw.device)
+            buf[:v.shape[0]].copy_(v)
+
+    def run(self, key, segs):
+        """One row-mode run of ``segs`` padded to ``key``'s rows (eager): this rank's logits of the real rows."""
+
+        fw = self.fw
+        self.stage(key, segs)
+        fw.static = self.static(key)
+        try:
+            out = fw.run(segs)
+        finally:
+            fw.static = None
+        return out[:sum(len(sg.ids) for sg in segs)]
+
+
+class RowGraphs:
+    """Graphs of ``fw`` (``decode.DecodeForward``, bound to the pool: ``rowmode.ready``): ``run(segs)`` replays the
+    key's graph, or runs eagerly and captures it. The interface of ``graphs.CudaGraphs``."""
+
+    def __init__(self, fw, *, agree_all=None, agree_any=None, settings: dict | None = None) -> None:
+        import torch
+
+        self.torch, self.fw = torch, fw
+        st = settings or env_settings()
+        self.buckets = tuple(st.get("buckets") or buckets())
+        self.pool = torch.cuda.graph_pool_handle()
+        self.rows = Rows(fw, max(self.buckets), st["bucket"])
+        self.warm = st.get("warm", "decode")
+        self.cache = GraphCache(self._capture, st["budget_s"], st["max_graphs"], st["bucket"], 64, st["on"],
+                                agree_all or (lambda ok: ok), agree_any or (lambda f: f),
+                                room=room_for(float(st.get("floor_gib", 5.0))),
+                                forget=lambda key: self.rows.statics.pop(key, None), release=torch.cuda.empty_cache,
+                                prefill_recent=PREFILL.recent)
+        self._pending = None
+        self._fp = self.fingerprint()
+
+    def fingerprint(self) -> tuple:
+        from . import rowmode
+
+        fw = self.fw
+        return tuple([id(getattr(b.moe, "scratch", None)) for b in fw.blocks]) + rowmode.fingerprint(fw) + (
+            self.rows.tab.ptr(),)
+
+    def key(self, segs):
+        if not self.cache.on:
+            return None
+        return RT.row_key([(sg.slot, sg.start, len(sg.ids)) for sg in segs], self.cache.bucket, self.fw.limit,
+                          self.buckets)
+
+    def _capture(self, key) -> Entry:
+        torch, fw = self.torch, self.fw
+        segs = self._pending
+        saved = {sg.slot: fw.slots[sg.slot].pending for sg in segs}
+        self.rows.stage(key, segs)
+        st = self.rows.static(key)
+        e = Entry(key)
+        g = torch.cuda.CUDAGraph()
+        fw.static = st
+        try:
+            # once eagerly in row mode (the same rows at the same positions: the same writes), so every Triton
+            # specialisation of the key is compiled and loaded before the capture
+            fw.run(segs)
+            torch.cuda.synchronize()
+            from . import branches as BR
+
+            # TF_DSV41_BRANCHES: every graph captures on the blocks' driver's main stream (its priority set at build),
+            # so all of them fork from / join to the same two streams; off: None, torch's own capture stream
+            with torch.cuda.graph(g, pool=self.pool, stream=BR.capture_stream(fw), capture_error_mode="thread_local"):
+                e.out = fw.run(segs)
+            e.proj, e.taps = fw.row_out
+        finally:
+            fw.static = None
+            for sg in segs:
+                fw.slots[sg.slot].pending = saved[sg.slot]
+        e.graph = g
+        return e
+
+    def run(self, segs):
+        """This rank's logits of the windows ``segs`` (``forward.Seg``): replayed, or eager (+ captured)."""
+
+        from .forward import Pending
+
+        fw = self.fw
+        fp = self.fingerprint()
+        if fp != self._fp:
+            if self.cache.graphs:
+                print(f"[tensorfold] dsv41 row graphs: a persistent buffer moved; {len(self.cache.graphs)} graphs "
+                      "dropped (captured again on use)", file=sys.stderr, flush=True)
+            self.cache.drop()
+            self.rows.statics.clear()
+            self._fp = fp
+        key = self.key(segs)
+        e = self.cache.get(key)
+        if e is not None:
+            with PH("graph.stage"):
+                self.rows.stage(key, segs)
+            with PH("graph.replay"):
+                e.graph.replay()
+            from . import xmap as XM
+
+            XM.replayed(fw, segs, key[0])           # G15 TF_DSV41_XMAP_TRACE: the window's host note
+            spans = RT.bounds([(sg.slot, sg.start, len(sg.ids)) for sg in segs])
+            for sg, (a, b) in zip(segs, spans):
+                fw.slots[sg.slot].pending = Pending(sg.start, list(sg.ids), {L: p[a:b] for L, p in e.proj.items()},
+                                                    {L: t[a:b] for L, t in e.taps.items()})
+            return e.out[:spans[-1][1]]
+        out = fw.run(segs)
+        if self.cache.wants(key):
+            self._pending = segs
+            try:
+                with PH("graph.capture"):
+                    self.cache.lazy(key)
+            finally:
+                self._pending = None
+        return out
+
+    def warmup(self, slots: int, ensure, bos: int = 0) -> int:
+        """Boot captures at context bucket 0: slot 0 at position 0 with min(rows, 16) rows, padded to the bucket
+        (``ensure(slot, rows)`` maps its pages); slot 0 is reset afterwards (the caller releases its pages)."""
+
+        from .forward import Seg
+
+        fw = self.fw
+        keys = [(R, 0) for R in RT.warm_buckets(self.warm) if R in self.buckets]
+
+        def capture_key(key, inner=self._capture):
+            n = min(key[0], RT.SEG_MAX)
+            fw.reset(0)
+            ensure(0, n + 1)
+            self._pending = [Seg(0, 0, tuple([int(bos)] * n))]
+            try:
+                return inner(key)
+            finally:
+                self._pending = None
+
+        real = self.cache.capture
+        self.cache.capture = capture_key
+        try:
+            n = self.cache.warmup(keys)
+        finally:
+            self.cache.capture = real
+            fw.reset(0)
+        return n
+
+
+def make(fw, *, agree_all=None, agree_any=None, settings: dict | None = None):
+    """The verify windows' graphs: ``RowGraphs`` (``TF_DSV41_GRAPH_MODE=rows`` and row mode possible: the pool is
+    bound, Triton CSA2), else ``graphs.CudaGraphs`` (per mix)."""
+
+    from . import rowmode
+    from .graphs import CudaGraphs
+
+    if mode() == "rows" and rowmode.ready(fw):
+        return RowGraphs(fw, agree_all=agree_all, agree_any=agree_any, settings=settings)
+    return CudaGraphs(fw, agree_all=agree_all, agree_any=agree_any, settings=settings)
+
+
+__all__ = ["RowGraphs", "RowStatic", "Rows", "RowView", "buckets", "make", "mode"]
