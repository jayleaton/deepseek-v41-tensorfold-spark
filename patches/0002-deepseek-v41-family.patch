+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G14's moe_fused variants on the GPU (collected only where PyTorch sees an NVIDIA GPU; helpers from
+test_dsv41_moe_fused_gpu.py):
+
+- ``route(inline=True)`` == the production sequence (narrow router -> prune -> kit -> group -> rot_in) bit for bit over
+  the WHOLE table: picks, weights, the group ids / count / members including the shared entry, and every pair's
+  rotated inputs (the shared pair's too); E 384 top-6 and E 128 top-3, R 1..16, every rule, both tails;
+- TAIL=fast's route == the production sequence (side mode: b1's checks) for every NW and helper count, and on rows of
+  tied scores and -inf biases (the redux argmax's edges);
+- ``moe.GpuMoE`` on == off bit for bit for every variant (side late / early, inline, after, x the two tails), x3ld
+  on / off, pruning on / off, R = 1..16; graph replays of inline / after / inline+fast == the old path eagerly;
+- the real weights (``TF_DSV41_TEST_MODEL``; layers ``TF_DSV41_FP_LAYERS``, default 1,20,39): every variant == off
+  for R 1..16, prune p85k and off;
+- microbench a variant (printed, ``[G14]``): the MoE call's us a layer at R = 1, 2, 4, 8, 16, cold L2 (G13's) and
+  with prod's L2PF ``f`` site replayed first (router gate + the shared expert's gate / up into L2, 12 MiB): H1's test.
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_moe_fused_g14_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from test_dsv41_moe_fused_gpu import (P85K, RULES, _check_route, _model, _moe, _production, _real, _stand, _x)
+
+from tensorfold.families.deepseek_v41.cuda import expert_loads as loads
+from tensorfold.families.deepseek_v41.cuda import moe_fused as MF
+from tensorfold.families.deepseek_v41.cuda import prune as PR
+from tensorfold.families.deepseek_v41.cuda import router
+from tensorfold.families.deepseek_v41.cuda import router_gemv as RG
+
+DEV = "cuda"
+ON = {"TF_DSV41_MOE_FUSED": "1"}
+VARIANTS = {
+    "side": dict(ON),
+    "early": {**ON, "TF_DSV41_MOE_FUSED_SDN": "early"},
+    "inline": {**ON, "TF_DSV41_MOE_FUSED_SHARED": "inline"},
+    "after": {**ON, "TF_DSV41_MOE_FUSED_SHARED": "after"},
+    "fast": {**ON, "TF_DSV41_MOE_FUSED_TAIL": "fast"},
+    "inline_fast": {**ON, "TF_DSV41_MOE_FUSED_SHARED": "inline", "TF_DSV41_MOE_FUSED_TAIL": "fast"},
+    "after_fast": {**ON, "TF_DSV41_MOE_FUSED_SHARED": "after", "TF_DSV41_MOE_FUSED_TAIL": "fast"},
+    "inline_fast_rows2": {"TF_DSV41_MOE_FUSED": "rows2", "TF_DSV41_MOE_FUSED_SHARED": "inline",
+                          "TF_DSV41_MOE_FUSED_TAIL": "fast"},
+    "side_rows2": {"TF_DSV41_MOE_FUSED": "rows2"},
+}
+
+
+def _rule(name, K):
+    r = RULES[name]
+    if r is not None and r.min_k >= K:
+        r = PR.Rule(r.min_w, r.topp, K - 1, r.renorm)
+    return r
+
+
+def _check_inline(m, x, rule, nw, fast, help=None):
+    E, ET = m.gate.shape[0], m.block.ex.count
+    pick0, wts0, ids0, n0, mem0, xg0, xu0 = _production(m, x, rule, nw)
+    m.scratch.xg.fill_(float("nan"))
+    m.scratch.xu.fill_(float("nan"))
+    pick, wts, _, ids, members = MF.route(m, x, rule, help=help, nw=nw, inline=True, fast=fast)
+    torch.cuda.synchronize()
+    assert torch.equal(pick, pick0) and torch.equal(wts.view(torch.int32), wts0.view(torch.int32))
+    n = int(m.scratch.count[0])
+    assert n == n0 and int(ids[n - 1]) == E and torch.equal(ids[:n], ids0[:n])          # the shared entry in
+    assert torch.equal(members[:n], mem0[:n])
+    live = ((pick >= 0) & (pick < ET)).reshape(-1).nonzero().reshape(-1)               # every pair, shared too
+    assert torch.equal(m.scratch.xg[live].view(torch.int16), xg0[live].view(torch.int16))
+    assert torch.equal(m.scratch.xu[live].view(torch.int16), xu0[live].view(torch.int16))
+    assert int(MF.side_for(m.block, m.scratch, x.device).cnt.abs().sum()) == 0
+    return pick
+
+
+@pytest.mark.parametrize("fast", [False, True], ids=["serial", "fast"])
+@pytest.mark.parametrize("rule", list(RULES), ids=list(RULES))
+@pytest.mark.parametrize("E,K", [(384, 6), (128, 3)])
+def test_route_inline_equals_production_sequence(rule, E, K, fast):
+    m = _stand(E, K, E + K + 1)
+    r = _rule(rule, K)
+    for R in range(1, 17):
+        _check_inline(m, _x(R, 300 + R, 0.6), r, 2, fast)
+    print(f"\n[G14] moe_fused route inline ({'fast' if fast else 'serial'} tail) == router -> prune -> kit -> group -> "
+          f"rot_in over the whole table, E {E} top-{K} rule {rule}: R 1..16 bit for bit")
+
+
+@pytest.mark.parametrize("nw", MF.NWS)
+def test_route_fast_any_nw_and_helper_count(monkeypatch, nw):
+    monkeypatch.setattr(MF, "CFG", MF.parse({**ON, "TF_DSV41_MOE_FUSED_TAIL": "fast"}))
+    m = _stand(384, 6, 17)
+    for R in (1, 3, 16):
+        x = _x(R, 60 + R, 0.6)
+        for hp in (0, 1, None, 47):
+            _check_route(m, x, RULES["p85k"], nw, help=hp)
+            _check_inline(m, x, RULES["p85k"], nw, True, help=hp)
+
+
+def test_route_fast_on_ties_and_neg_inf_bias(monkeypatch):
+    """Every logit equal (a zero gate): the choice is the bias alone, with ties and -inf entries."""
+
+    monkeypatch.setattr(MF, "CFG", MF.parse({**ON, "TF_DSV41_MOE_FUSED_TAIL": "fast"}))
+    m = _stand(384, 6, 18)
+    m.gate.zero_()
+    b = torch.zeros(384, device=DEV)
+    b[5::7] = 0.25                                  # ties among the top: the lowest ids win
+    b[::11] = float("-inf")
+    m.bias = b
+    for R in (1, 2, 16):
+        for fast in (False, True):
+            _check_inline(m, _x(R, 70 + R, 0.6), None, 2, fast)
+        _check_route(m, _x(R, 80 + R, 0.6), None, 2)
+
+
+def _both(monkeypatch, m, x, env):
+    monkeypatch.setattr(MF, "CFG", MF.parse({}))
+    old = m(x).clone()
+    pold = m.last_pick.clone()
+    monkeypatch.setattr(MF, "CFG", MF.parse(env))
+    m.ensure()
+    new = m(x).clone()
+    pnew = m.last_pick.clone()
+    torch.cuda.synchronize()
+    return old, pold, new, pnew
+
+
+@pytest.mark.parametrize("ld", [False, True], ids=["upstream", "x3ld"])
+@pytest.mark.parametrize("prune", [False, True], ids=["noprune", "p85k"])
+def test_moe_variants_equal_off(monkeypatch, ld, prune):
+    m = _moe(monkeypatch, 13, tail=True, prune_env=P85K if prune else None)
+    saved = dict(loads.CFG)
+    try:
+        loads.CFG.update(on=ld)
+        for R in (1, 2, 3, 4, 6, 8, 11, 16):
+            x = _x(R, 400 + R, 0.6)
+            for name, env in VARIANTS.items():
+                old, pold, new, pnew = _both(monkeypatch, m, x, env)
+                assert torch.equal(pnew, pold), (R, name)
+                assert torch.equal(new.view(torch.int32), old.view(torch.int32)), (R, name)
+    finally:
+        loads.CFG.clear()
+        loads.CFG.update(saved)
+
+
+@pytest.mark.parametrize("name", ["inline", "after", "inline_fast"])
+def test_variant_graph_replays(monkeypatch, name):
+    m = _moe(monkeypatch, 14, prune_env=P85K)
+    env = VARIANTS[name]
+    monkeypatch.setattr(MF, "CFG", MF.parse(env))
+    m.ensure()
+    for R in (1, 4, 16):
+        xs = _x(R, 50 + R, 0.6)
+        m(xs)
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            out = m(xs)
+        for seed in (60, 61):
+            xn = _x(R, seed + R, 0.6)
+            xs.copy_(xn)
+            graph.replay()
+            torch.cuda.synchronize()
+            got = out.clone()
+            monkeypatch.setattr(MF, "CFG", MF.parse({}))
+            want = m(xn).clone()
+            monkeypatch.setattr(MF, "CFG", MF.parse(env))
+            torch.cuda.synchronize()
+            assert torch.equal(got.view(torch.int32), want.view(torch.int32)), (name, R, seed)
+    assert all(int(s.cnt.abs().sum()) == 0 for s in MF._SIDES.values())
+
+
+# -- the real weights and the microbench ---------------------------------------------------------------------------
+def _l2_table(m, budget=12 << 20):
+    """prod's L2PF site ``f`` for this block (l2pf.site_tensors / take: the router's gate, then the shared expert's
+    gate and up trellis, 12 MiB) as an l2pf.segments table; (None, 0) if the extension is not there."""
+
+    from types import SimpleNamespace
+
+    from tensorfold.families.deepseek_v41.cuda import l2pf as L2
+
+    tensors = L2.site_tensors(SimpleNamespace(moe=m), None, "f")
+    keep, ex = getattr(m.block, "keep", None), m.block.ex
+    if len(tensors) == 1 and keep and len(keep) == 3 and isinstance(keep[0], (list, tuple)):
+        tensors += [keep[0][-1][0], keep[1][-1][0]]                 # random blocks: keep = [gate, up, down] lists
+    spans = L2.take(tensors, budget)
+    if not spans:
+        return None, 0
+    try:
+        ext = L2._ext()
+    except Exception:                                               # noqa: BLE001 (a missing toolchain: cold only)
+        return None, 0
+    table = torch.tensor(spans, dtype=torch.int64, device=DEV).view(-1, 2)
+    nb = sum(b for _, b in spans)
+    sms = torch.cuda.get_device_properties(0).multi_processor_count
+    pieces = -(-nb // (32 << 10))                                   # Prefetcher.mark's launch shape
+    grid = max(1, min(sms, -(-pieces // 128)))
+    return (lambda: ext.segments(table, grid, 128, 32 << 10, True)), nb
+
+
+def _us(fn, pre=None, iters=20):
+    """us of fn() in a CUDA graph after a 64 MB write that evicts L2 (then ``pre``, e.g. the L2PF site), minus the
+    same graph without fn."""
+
+    junk = torch.empty(16 << 20, dtype=torch.float32, device=DEV)
+    fn()
+    torch.cuda.synchronize()
+
+    def graph(with_fn):
+        g = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(g):
+            for _ in range(4):
+                junk.add_(1.0)
+                if pre is not None:
+                    pre()
+                if with_fn:
+                    fn()
+        return g
+
+    def t(g):
+        g.replay()
+        torch.cuda.synchronize()
+        a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        a.record()
+        for _ in range(iters):
+            g.replay()
+        b.record()
+        b.synchronize()
+        return a.elapsed_time(b) * 1e3 / (iters * 4)
+
+    return t(graph(True)) - t(graph(False))
+
+
+def _bench(monkeypatch, m, tag):
+    m.ensure()
+    for name, env in VARIANTS.items():
+        monkeypatch.setattr(MF, "CFG", MF.parse(env))
+        m.ensure()
+    pre, nb = _l2_table(m)
+    for R in (1, 2, 4, 8, 16):
+        x = _x(R, 900 + R, 0.6)
+        for mode, p in (("cold", None), ("l2pf", pre)):
+            if mode == "l2pf" and p is None:
+                continue
+            row = {}
+            for name, env in {"off": {}, **VARIANTS}.items():
+                monkeypatch.setattr(MF, "CFG", MF.parse(env))
+                row[name] = _us(lambda x=x: m(x), p)
+            off = row.pop("off")
+            cells = ", ".join(f"{k} {v:.1f} ({v - off:+.1f})" for k, v in row.items())
+            print(f"[G14] moe_fused bench {tag} R={R} {mode}{f' {nb / 2**20:.1f} MiB' if p else ''}: off {off:.1f} us; "
+                  f"{cells}", flush=True)
+
+
+@pytest.mark.skipif(_model() is None, reason="TF_DSV41_TEST_MODEL: the checkpoint folder")
+def test_real_layers_variants(monkeypatch):
+    monkeypatch.setattr(router, "MODE", "gemv")
+    monkeypatch.setattr(RG, "NARROW", 2)
+    monkeypatch.setattr(RG, "TAIL", True)
+    layers = [int(v) for v in os.environ.get("TF_DSV41_FP_LAYERS", "1,20,39").split(",")]
+    for L in layers:
+        m = _real(L)
+        for env in (P85K, {}):
+            monkeypatch.setattr(PR, "CFG", PR.parse(env))
+            for R in range(1, 17):
+                x = _x(R, 1000 * L + R, 0.6)
+                for name, venv in VARIANTS.items():
+                    old, pold, new, pnew = _both(monkeypatch, m, x, venv)
+                    assert torch.equal(pnew, pold) and torch.equal(new.view(torch.int32), old.view(torch.int32)), \
+                        (L, R, name)
+        monkeypatch.setattr(PR, "CFG", PR.parse(P85K))
+        _bench(monkeypatch, m, f"real layer {L} p85k")
+        print(f"[G14] moe_fused real layer {L}: {', '.join(VARIANTS)} == off, R 1..16, p85k and off, bit for bit",
+              flush=True)
+        del m
+        torch.cuda.empty_cache()
+
+
+@pytest.mark.skipif(_model() is not None, reason="the real-weight test benches instead")
+def test_bench_random_full_layer(monkeypatch):
+    m = _moe(monkeypatch, 22, experts=384, tail=True, prune_env=P85K)
+    _bench(monkeypatch, m, "random 384-expert layer p85k")
+
