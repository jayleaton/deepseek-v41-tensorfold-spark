--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/router_gemv.py
@@ -0,0 +1,404 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DeepSeek-V4.1-Flash's MoE router as a bandwidth-bound CUDA GEMV with the selection fused (``TF_DSV41_ROUTER=gemv``;
+``router_gemv.cu``). The routing rule is router.py's (sqrt-softplus with the safe softplus, top-k by score + bias, ties
+to the lower id, renormalized x 1.5, the shared slot); only the logits' summation order is new, and it is fixed.
+
+Why (docs/DECODE-ROOFLINE.md, lever 2): split / fused stream the 3.9 MB bf16 gate [384, 5,120] at ~36 GB/s (~100 us a
+layer) because their inner loop is Triton's ``tl.dot`` in ieee fp32 over 16-row tiles. Here a warp owns an expert and
+reads its gate row with coalesced 16-byte loads, 8 in flight a lane; x is staged once a CTA in shared memory.
+
+The logit of (row, expert), the same bits for every R, row tile, config and CTA schedule (``model_logits`` is this
+order in numpy, bit for bit): lane l runs one fp32 FMA chain from +0.0 over k = 8 (l + 32 j) + i, j = 0..19, i = 0..7
+ascending (160 terms), then the xor butterfly a + shfl_xor(a, o), o = 16, 8, 4, 2, 1. Chains are 160 long instead of
+split's 5,120 (fused: 640 + 7): closer to float64 than either (tests).
+
+Launch: grid (E / (NW x EW) CTAs, row tiles of RT = 1 / 2 / 4 / 8 / 16 rows; RT the smallest power of two >= R, 16
+above). Each CTA writes its logits to a per-call [R, E] fp32 scratch and bumps its row tile's counter; the last CTA to
+arrive selects the tile's rows (a warp a row) and resets the counter (self-cleaning: graph replays start from 0).
+Rows above CHUNK = 2,048 run as consecutive launches; the counters are one fixed 128-int buffer a device, allocated
+once outside graph capture (a per-call zeroed buffer if the very first call is being captured). As with ``fused``, two
+streams of one device must not run the router at once (shared counters; decode and prefill use one stream).
+
+Cost model (GB10, 48 SMs, ~220 GB/s streamed by x3ld's load path), R <= 16, E = 384:
+- bytes: 384 x 5,120 x 2 = 3.93 MB -> 17.9 us at 220 GB/s, 19.7 at 200. In flight: 8 vectors x 512 B a warp, 8 warps
+  a CTA, 48 CTAs = 1.5 MB, ~7 us of DRAM latency covered (Little's law needs ~0.2-0.3 MB);
+- compute at R = 16: 31.5 M FMAs, each with one bf16 widen of x (an LDS.128 serves 8): ~2 issue slots an FMA, ~10K
+  cycles a SM (~5 us), overlapped with the stream (other warps, the ring); negligible at R <= 4 (decode's mean 2.6);
+- launch ramp ~2-3 us (graph node, first DRAM round trip); tail ~2-3 us: fence + atomic, the tile's logits from L2,
+  softplus of 12 experts a lane and 6 butterfly argmax rounds, 2 rows a warp at R = 16.
+=> ~22-24 us a layer at R <= 8, ~24-26 at R = 16 (target <= 25); E = 128 (DSpark, 1.31 MB, NW 4: 32 CTAs) ~9-11 us.
+vs split's ~108 us: 44 calls a verify window 4.75 -> ~1.0 ms (-3.7 ms of the 35 ms 1-row window).
+Selection in the last CTA rather than a second kernel: the same selection work either way; a second graph node adds a
+launch gap (~2-3 us on GB10) where the last-CTA step costs a fence and one atomic (~1 us).
+Prefill rows (> 16): the same kernel in row tiles of 16 with (NW, EW) = (8, 2) (an x element read from shared memory
+serves 2 experts): 2,048 rows are ~4 G FMAs (~0.5-0.7 ms on 48 SMs) plus 128 re-reads of the gate from L2, ~1 ms a
+layer vs split's 5.6 ms (G6). One kernel for every R also keeps decode rows == prefill rows bit for bit.
+
+The shared expert and the router (why they are NOT run concurrently). The shared expert is table entry E of the
+grouped launches (experts.routed: group, rot_in, gate/up, epilogue, down, combine all read the picks), at ~10.3 MB a
+layer a rank (3 x 5,120 x 1,152 at 5 / 4 bits), ~47 us at bandwidth. Both it and the router are bandwidth-bound, so
+overlap only reclaims the router's non-streaming time (ramp + tail, ~4-6 us a layer): at most ~0.2 ms a verify window
+(~0.6%). Taking it there needs the shared entry out of the grouped call: 4 more launches a layer on a second stream
+(rot_in, gate/up, epilogue, down with its own scratch) + fork / join events, one fewer unit in the routed launches
+(fewer CTAs in an already latency-bound R = 1 launch), and its partial added outside ``down_combine``, which changes the
+MoE output's bits (a new M1 gate). The expected net is <= 0.5% and may be negative: not implemented. PDL on the
+launch after the router is the cheaper way to take its tail (x3ld's TF_DSV41_EXPERT_LOADS_PDL pattern).
+
+Knobs: ``TF_DSV41_ROUTER=gemv`` (router.py; default ``split`` until the GPU window measures it);
+``TF_DSV41_ROUTER_GEMV_CFG`` "nw,ew" or "nw,ew/nw,ew" (rows <= 16 / prefill rows), (nw, ew) in {4, 8} x {1, 2}; default
+8,1 (E > 256) or 4,1 (DSpark) / 8,2. Every setting places work only: the bits never change.
+``TF_DSV41_RG_NARROW`` = NW in {1, 2, 4, 8} (default 0: off): rows <= 16 run ``narrow_kernel`` instead, E / NW CTAs
+of NW warps (a warp an expert, the same chains: the same bits, tests/cuda check it against gemv_kernel), the gate
+row's 20 vectors a lane in flight at once by cp.async (no register ring for ptxas to sink), x per lane from L1, no
+barrier in the main loop. Why: G9 measured gemv_kernel<1, 8, 1> (48 CTAs) at ~31.5 us a call vs the ~16 us DRAM
+floor; the SASS shows its 8-deep ring and a barrier a 512-k chunk. Expected ~17-20 us at R <= 4 (GPU window).
+``TF_DSV41_RG_TAIL=1`` (default 0; ``route_fold`` in router.py, used by moe.py): the selection writes the fp16-rounded
+weights (pick.kit_weights' float16_copy + direct_copy kernels, the same bits) and, narrow + R <= 16, the selecting
+CTA also runs upstream's group_kernel (ids / count / members, the same integers): three launches a layer fewer.
+Fallback to ``split`` (a function of the weight alone, so rows stay invariant): D != 5,120, a gate not bf16, E > 512,
+top-k > 8. On CPU tensors ``emulate`` runs this module's numpy model (interpreter suites).
+"""
+
+from __future__ import annotations
+
+import os
+from functools import lru_cache
+
+import numpy as np
+
+NV = 20                 # router_gemv.cu: 16-byte vectors a lane a gate row
+D = 32 * 8 * NV         # 5,120
+JC = 2                  # vectors a lane a chunk of staged x
+CK = 32 * 8 * JC        # k a chunk
+EPL = 16                # experts a lane in the selection: E <= 512
+KMAX = 8
+CHUNK = 2048            # rows a launch (counters: CHUNK / 16)
+TILES = (1, 2, 4, 8, 16)
+CFGS = ((8, 1), (4, 1), (8, 2), (4, 2))
+ENV_CFG = "TF_DSV41_ROUTER_GEMV_CFG"
+ENV_NARROW = "TF_DSV41_RG_NARROW"
+ENV_TAIL = "TF_DSV41_RG_TAIL"
+NARROW_NW = (1, 2, 4, 8)
+NARROW_ROWS = 16        # rows the narrow kernel takes (one row tile)
+GE_MAX = 512            # router_gemv.cu: table entries the folded grouping takes
+_COUNTERS: dict = {}
+
+
+def parse_narrow(text: str | None = None) -> int:
+    """``TF_DSV41_RG_NARROW``: warps a CTA of the narrow kernel (0: off, gemv_kernel for every R)."""
+
+    raw = (os.environ.get(ENV_NARROW, "") if text is None else text).strip().lower()
+    if raw in ("", "0", "off", "no", "false"):
+        return 0
+    try:
+        nw = int(raw)
+    except ValueError:
+        nw = -1
+    if nw not in NARROW_NW:
+        raise ValueError(f"{ENV_NARROW}={raw!r}: expected 0 or one of {NARROW_NW}")
+    return nw
+
+
+def parse_tail(text: str | None = None) -> bool:
+    raw = (os.environ.get(ENV_TAIL, "") if text is None else text).strip().lower()
+    return raw not in ("", "0", "off", "no", "false")
+
+
+NARROW = parse_narrow()
+TAIL = parse_tail()
+
+
+def ring_depth(ew: int) -> int:
+    """Vectors in flight a lane a gate row (router_gemv.cu's PD)."""
+
+    return 8 // ew
+
+
+def parse_cfg(text: str | None = None) -> tuple[tuple[int, int] | None, tuple[int, int] | None]:
+    """``TF_DSV41_ROUTER_GEMV_CFG``: (decode, prefill) settings, None = the default for E."""
+
+    raw = (os.environ.get(ENV_CFG, "") if text is None else text).strip()
+    if not raw:
+        return None, None
+    halves = raw.split("/")
+    out = []
+    for h in halves:
+        try:
+            c = tuple(int(p) for p in h.split(","))
+        except ValueError:
+            c = ()
+        if c not in CFGS:
+            raise ValueError(f"{ENV_CFG}={raw!r}: each half one of {', '.join(f'{a},{b}' for a, b in CFGS)}")
+        out.append(c)
+    if len(out) > 2:
+        raise ValueError(f"{ENV_CFG}={raw!r}: expected nw,ew or nw,ew/nw,ew")
+    return out[0], out[-1]
+
+
+CFG = parse_cfg()
+
+
+def config(E: int, rows: int, cfg=CFG) -> tuple[int, int]:
+    dec, pre = cfg
+    if rows > 16:
+        return pre or (8, 2)
+    return dec or ((8, 1) if E > 256 else (4, 1))
+
+
+def row_tile(rows: int) -> int:
+    return next(t for t in TILES if t >= min(rows, 16))
+
+
+def supports(x, weight, topk: int) -> bool:
+    import torch
+
+    E = weight.shape[0]
+    return (weight.dtype == torch.bfloat16 and x.dtype == torch.bfloat16 and x.shape[1] == D
+            and weight.shape[1] == D and 1 <= E <= 32 * EPL and 1 <= topk <= min(KMAX, E))
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    from pathlib import Path
+
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tf_dsv41_router_gemv_v2", sources=[str(here / "router_gemv.cpp"), str(here / "router_gemv.cu")],
+                extra_cuda_cflags=["-O3", "-lineinfo"], verbose=False)
+
+
+def _counters(device):
+    import torch
+
+    key = (device.type, device.index)
+    cnt = _COUNTERS.get(key)
+    if cnt is None:
+        if torch.cuda.is_current_stream_capturing():
+            return torch.zeros(CHUNK // 16, dtype=torch.int32, device=device)
+        cnt = _COUNTERS[key] = torch.zeros(CHUNK // 16, dtype=torch.int32, device=device)
+    return cnt
+
+
+def route(x, weight, bias, topk: int, slots: int, scale: float, pick, wts, keep=None, cfg=None, narrow=None,
+          kit: bool = False, group=None) -> bool:
+    """The CUDA router into ``pick`` [R, slots] int32 / ``wts`` fp32; ``keep`` [R, E] fp32: the logits too.
+    ``cfg`` (nw, ew) overrides ``config`` (bench sweeps; the bits are the same); ``narrow`` overrides
+    ``TF_DSV41_RG_NARROW`` (0: gemv_kernel; the bits are the same). ``kit``: weights rounded to fp16 (== pick.kit_weights
+    of the fp32 weights). ``group`` (ids, count, members [maxu, maxm], GE): upstream's grouping folded in, done only on
+    the narrow kernel with R <= 16 and GE <= 512; returns whether it was (else the caller runs ``group``)."""
+
+    import torch
+
+    R, E = x.shape[0], weight.shape[0]
+    if x.stride(1) != 1 or x.stride(0) % 8 or x.data_ptr() % 16:
+        x = x.contiguous() if not x.is_contiguous() else x.clone()
+    b = bias if bias.dtype == torch.float32 and bias.is_contiguous() else bias.float().contiguous()
+    cnt = _counters(x.device)
+    ext = _ext()
+    nwn = NARROW if narrow is None else narrow
+    use_narrow = nwn in NARROW_NW and 0 < R <= NARROW_ROWS and cfg is None
+    grouped = group is not None and use_narrow and 1 <= int(group[3]) <= GE_MAX
+    none = cnt[:0]
+    gid, gcnt, gmem, GE = group if grouped else (none, none, none.view(0, 1), 0)
+    for c0 in range(0, R, CHUNK):
+        c1 = min(R, c0 + CHUNK)
+        n = c1 - c0
+        nw, ew = (nwn, 0) if use_narrow else (cfg or config(E, n))
+        lg = keep[c0:c1] if keep is not None else torch.empty((n, E), dtype=torch.float32, device=x.device)
+        ext.route(x[c0:c1], weight, b, pick[c0:c1], wts[c0:c1], lg, cnt, topk, slots, float(scale), row_tile(n), nw,
+                  ew, True, bool(kit), gid, gcnt, gmem, int(GE), grouped)
+    return grouped
+
+
+def logits(x, weight, cfg=None, narrow=None):
+    """The fp32 logits [R, E] the gemv path selects from (CUDA tensors; CPU: ``model_logits``)."""
+
+    import torch
+
+    R, E = x.shape[0], weight.shape[0]
+    if not x.is_cuda:
+        return torch.from_numpy(model_logits(x, weight))
+    out = torch.empty((R, E), dtype=torch.float32, device=x.device)
+    pick = torch.empty((R, 1), dtype=torch.int32, device=x.device)
+    wts = torch.empty((R, 1), dtype=torch.float32, device=x.device)
+    route(x, weight, torch.zeros(E, dtype=torch.float32, device=x.device), 1, 1, 1.0, pick, wts, keep=out, cfg=cfg,
+          narrow=narrow)
+    return out
+
+
+# -- the model: router_gemv.cu's arithmetic in numpy -----------------------------------------------------------------
+def fma32(a, b, c):
+    """fp32 fma(a, b, c) rounded once (nearest even), elementwise: the product is exact in float64 and the float64
+    sum is rounded to odd before the final rounding to fp32 (dsv41_interp's helper)."""
+
+    p = a.astype(np.float64) * b.astype(np.float64)
+    c = np.broadcast_to(c.astype(np.float64), p.shape)
+    s = p + c
+    bb = s - p
+    err = (p - (s - bb)) + (c - bb)
+    even = (s.view(np.int64) & 1) == 0
+    fix = (err != 0) & even & np.isfinite(s)
+    if fix.any():
+        s = np.where(fix, np.nextafter(s, np.where(err > 0, np.inf, -np.inf)), s)
+    return s.astype(np.float32)
+
+
+def _f32(t) -> np.ndarray:
+    import torch
+
+    if isinstance(t, torch.Tensor):
+        return t.detach().to("cpu", torch.float32).numpy()
+    return np.asarray(t, dtype=np.float32)
+
+
+def lane_order(Dk: int = D) -> np.ndarray:
+    """k of lane l's chain, step by step: [32, Dk / 32] (k = 8 (l + 32 j) + i, j then i ascending)."""
+
+    nv = Dk // 256
+    j, lane, i = np.meshgrid(np.arange(nv), np.arange(32), np.arange(8), indexing="ij")
+    return (8 * (lane + 32 * j) + i).transpose(1, 0, 2).reshape(32, nv * 8)
+
+
+def model_logits(x, weight, rows_a_pass: int = 32) -> np.ndarray:
+    """router_gemv.cu's logits [R, E] in numpy, bit for bit: per lane an fp32 FMA chain from +0.0 in ``lane_order``,
+    then the xor butterfly (o = 16 .. 1). Any D that is a multiple of 256 (the kernel instance: 5,120)."""
+
+    xf, wf = _f32(x), _f32(weight)
+    R, Dk = xf.shape
+    E = wf.shape[0]
+    if Dk % 256:
+        raise ValueError(f"model_logits: D % 256 == 0 (D = {Dk})")
+    nv = Dk // 256
+    wl = wf.reshape(E, nv, 32, 8)
+    lanes = np.arange(32)
+    out = np.empty((R, E), np.float32)
+    for a in range(0, R, rows_a_pass):
+        xl = xf[a:a + rows_a_pass].reshape(-1, nv, 32, 8)
+        acc = np.zeros((xl.shape[0], E, 32), np.float32)
+        for j in range(nv):
+            for i in range(8):
+                acc = fma32(xl[:, None, j, :, i], wl[None, :, j, :, i], acc)
+        for o in (16, 8, 4, 2, 1):
+            acc = (acc + acc[..., lanes ^ o]).astype(np.float32)
+        out[a:a + rows_a_pass] = acc[..., 0]
+    return out
+
+
+def softplus32(z: np.ndarray) -> np.ndarray:
+    """router.py's safe softplus in fp32 numpy (exp / log are numpy's, not CUDA's: equal to ~1 ulp, not bitwise)."""
+
+    z = z.astype(np.float32)
+    with np.errstate(over="ignore", under="ignore"):
+        e = np.exp(np.minimum(z, np.float32(20.0)))
+        tiny = (e - np.float32(0.5) * (e * e)).astype(np.float32)
+        mid = np.log((np.float32(1.0) + e).astype(np.float32))
+    return np.where(z > 20.0, z, np.where(z < -10.0, tiny, mid)).astype(np.float32)
+
+
+def model_select(lg: np.ndarray, bias, topk: int, shared: bool, scale: float, kit: bool = False):
+    """The fused selection on fp32 logits [R, E]: (pick int32 [R, topk + shared], wts fp32); ``kit``: the routed
+    weights rounded to fp16 and back (pick.kit_weights, folded)."""
+
+    R, E = lg.shape
+    s = np.sqrt(softplus32(lg)).astype(np.float32)
+    ch = (s + _f32(bias)[None, :]).astype(np.float32)
+    order = np.argsort(-ch, axis=1, kind="stable")[:, :topk]           # stable: ties keep the lower id
+    sv = np.take_along_axis(s, order, 1)
+    total = np.zeros(R, np.float32)
+    for t in range(topk):
+        total = (total + sv[:, t]).astype(np.float32)
+    w = (np.float32(scale) * (sv / total[:, None]).astype(np.float32)).astype(np.float32)
+    if kit:
+        w = w.astype(np.float16).astype(np.float32)
+    if shared:
+        order = np.concatenate([order, np.full((R, 1), E)], 1)
+        w = np.concatenate([w, np.ones((R, 1), np.float32)], 1)
+    return order.astype(np.int32), w
+
+
+def emulate(x, weight, bias, topk: int, shared: bool, scale: float, pick=None, wts=None, kit: bool = False):
+    """The gemv router on CPU tensors (the model; interpreter suites): logits bitwise, selection to ~1 ulp."""
+
+    import torch
+
+    p, w = model_select(model_logits(x, weight), bias, topk, shared, scale, kit)
+    p, w = torch.from_numpy(p), torch.from_numpy(w)
+    if pick is not None:
+        pick.copy_(p)
+        wts.copy_(w)
+        return pick, wts
+    return p, w
+
+
+# -- the kernel's schedule, for the lane emulator test -----------------------------------------------------------------
+def schedule(rt: int, nw: int, ew: int) -> dict:
+    """router_gemv.cu's index arithmetic for one CTA, as data: per step j the gate vector each lane consumes, the ring
+    slot it comes from (and the step that loaded it), the shared-memory buffer / column of x it pairs with; per chunk
+    the (row, column) of x each thread stages. Tests check it covers k in each lane's chain order, with no slot
+    reused before it is consumed and no buffer overwritten while it is read."""
+
+    pd = ring_depth(ew)
+    nc = NV // JC
+    xu = rt * CK // 8
+    xt = -(-xu // (nw * 32))
+    steps = []
+    loaded = {s: s for s in range(pd)}                  # ring slot -> step whose vector it holds
+    for j in range(NV):
+        c, jj = divmod(j, JC)
+        slot = j % pd
+        steps.append({"j": j, "chunk": c, "buf": c & 1, "slot": slot, "slot_holds": loaded[slot],
+                      "vec": [j * 32 + lane for lane in range(32)],
+                      "col": [(jj * 32 + lane) * 8 for lane in range(32)]})
+        if j + pd < NV:
+            loaded[slot] = j + pd
+    stage = []
+    for c in range(nc):
+        cells = []
+        for t in range(nw * 32):
+            for q in range(xt):
+                u = t + nw * 32 * q
+                if u < xu:
+                    cells.append((t, u // (CK // 8), (u % (CK // 8)) * 8, c * CK + (u % (CK // 8)) * 8))
+        stage.append(cells)
+    return {"pd": pd, "nc": nc, "steps": steps, "stage": stage, "xt": xt}
+
+
+def narrow_depth(rt: int, nw: int) -> int:
+    """router_gemv.cu's narrow_kernel PD: gate vectors in flight a lane (shared-memory slots, cp.async groups)."""
+
+    return NV if nw <= 4 and rt <= 4 else NV // 2
+
+
+def narrow_schedule(rt: int, nw: int) -> list[dict]:
+    """narrow_kernel's cp.async pipeline, as data: per step j the wait_group count, the groups committed before it
+    (one a vector, in vector order), the slot read and the vector a refill after it loads (or None)."""
+
+    pd = narrow_depth(rt, nw)
+    steps, committed, slot_of = [], pd, {v: v % pd for v in range(pd)}
+    for j in range(NV):
+        st = {"j": j, "wait": min(NV - j - 1, pd - 1), "committed": committed, "slot": j % pd,
+              "slot_holds": [v for v, sl in slot_of.items() if sl == j % pd][-1], "refill": None}
+        if j + pd < NV:
+            st["refill"] = j + pd
+            slot_of[j + pd] = (j + pd) % pd
+            committed += 1
+        steps.append(st)
+    return steps
+
+
+def model_group(pick: np.ndarray, GE: int, maxm: int):
+    """Upstream's group_kernel (tensorfold/cuda/exl3/experts.cu), the integers it writes: (ids of the distinct picks
+    < GE in id order, their count, members [count, maxm]: row * 32 + slot in row-major pick order, -1 after)."""
+
+    pick = np.asarray(pick)
+    R, slots = pick.shape
+    flat = pick.reshape(-1)
+    ids = sorted({int(e) for e in flat if 0 <= e < GE})
+    mem = np.full((len(ids), maxm), -1, np.int32)
+    for p, e in enumerate(ids):
+        rows = [(i // slots) * 32 + i % slots for i in range(R * slots) if flat[i] == e][:maxm]
+        mem[p, :len(rows)] = rows
+    return np.array(ids, np.int32), len(ids), mem
+
