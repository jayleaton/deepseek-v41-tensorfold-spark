+# -- the hash memo ------------------------------------------------------------------------------------------------------
+def test_hash_memo_is_bounded_by_rows():
+    h = PF.CachedHasher(FakeHasher(), rows=8 * SEG)
+    rng = np.random.default_rng(0)
+    segs = [tuple(int(t) for t in rng.integers(3, 129000, size=SEG)) for _ in range(40)]
+    for s in segs:
+        h(torch.tensor(s), lookback=torch.tensor([1, 2, 3]))
+        assert h.held <= 8 * SEG and len(h.memo) <= 8
+    hits = h.stats["hits"]
+    h(torch.tensor(segs[-1]), lookback=torch.tensor([1, 2, 3]))       # the latest segment: still a hit
+    assert h.stats["hits"] == hits + 1
+    h(torch.tensor(segs[0]), lookback=torch.tensor([1, 2, 3]))        # long gone
+    assert h.stats["hits"] == hits + 1
+    big = PF.CachedHasher(FakeHasher(), rows=100)
+    big(torch.arange(101))                                             # more rows than the memo: hashed, not kept
+    assert not big.memo and big.held == 0
+    small = PF.CachedHasher(FakeHasher(), size=2)                     # the entry bound still holds (decode rows)
+    for t in range(5):
+        small(torch.tensor([t]))
+    assert len(small.memo) == 2 and small.held == 2
