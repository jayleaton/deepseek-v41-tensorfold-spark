index 0000000..7270bdc
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/routerbench.py
@@ -0,0 +1,387 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Window G6's router bench on one GPU: every real router of the checkpoint (40 target layers, E = 384, top-6;
+DSpark's blocks, E = 128, top-3), the fused router (``TF_DSV41_ROUTER=fused``) against G4's ``split``:
+
+- agree: picks fused == split (order and set) on real router inputs (``--samples``, router_check's capture of a gate
+  run) and on random rows; every differing row adjudicated by float64 (which path equals float64's picks, and
+  float64's margin there);
+- invariance: a row alone == the row in windows of R = 1..16 at tile offsets 0 / 7 / N - R, and a 4,100-row call
+  (chunks of 2,048) == the same rows in 16-row windows, picks and weights bit for bit;
+- graphs: route() captured at R = 1 / 3 / 16 (one layer and the 40-layer sweep, as decode does), replayed twice ==
+  eager bits, the counters back to 0 after every replay, new inputs copied in == eager on them; the same when the
+  first call ever is a capture (the per-call counter buffer);
+- time: us a layer over the 40-layer sweep (each layer's own gate: no L2 reuse between layers), eager and as one CUDA
+  graph, fused and split, at R = 1 / 2 / 4 / 8 / 16 / 64 / 2,048. ``--nsys`` brackets one graph-replayed sweep a mode
+  with cudaProfilerStart / Stop and NVTX ranges (nsys --capture-range=cudaProfilerApi).
+
+``--mode gemv`` (window G7): the candidate is ``router_gemv`` (TF_DSV41_ROUTER=gemv) instead of fused, in every check
+above (the report's "fused" keys are the candidate's), plus ``gemv``: on every router the kernel's logits == the numpy
+model of its summation order (bit for bit, real rows), the same bits under every (NW, EW) config, and picks vs float64
+on every real / random row (gemv's rate and split's).
+
+    python -m tensorfold.families.deepseek_v41.cuda.routerbench --model DIR [--mode gemv] [--samples X.pt] [--out J]
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+TIME_ROWS = (1, 2, 4, 8, 16, 64, 2048)
+MODE = "fused"          # the candidate path (--mode)
+GRAPH_ROWS = (1, 3, 16)
+
+
+def _gates(model: str):
+    import torch
+
+    from . import weights as W
+    from .config import Config
+
+    cfg = Config.from_file(Path(model) / "config.json")
+    src = W.Shards(model)
+    ld = W.Loader(cfg, src, 0, 2, "cuda")
+    out = []
+    names = [(L, f"layers.{L}.ffn") for L in range(cfg.num_hidden_layers)]
+    names += [(cfg.num_hidden_layers + i, f"mtp.{i}.ffn") for i in range(8) if f"mtp.{i}.ffn.gate.weight" in src]
+    for L, f in names:
+        _, topk = cfg.experts_of(L)
+        out.append({"layer": L, "topk": topk, "w": ld.native(f"{f}.gate.weight", torch.bfloat16, bf16_param=True),
+                    "b": ld.native(f"{f}.gate.bias"), "scale": cfg.routed_scaling_factor})
+    return cfg, out
+
+
+def _bits(p, w):
+    import torch
+
+    return p.clone(), w.view(torch.int32).clone()
+
+
+def _sample(samples, g):
+    """The real router inputs captured for this router (matched by the weight's fingerprint), or None."""
+
+    import torch
+
+    for s in samples or ():
+        if s["E"] == g["w"].shape[0] and torch.equal(s["fp"], g["w"][:2, :16].float().cpu()):
+            return s["x"].to("cuda", torch.bfloat16).contiguous()
+    return None
+
+
+def _route(g, x, mode=None, pick=None, wts=None):
+    from . import router
+
+    mode = mode or MODE
+    return router.route(x, g["w"], g["b"], topk=g["topk"], shared=True, scale=g["scale"], mode=mode, pick=pick,
+                        wts=wts)
+
+
+def agree(gates, samples, D: int, rows_random: int) -> dict:
+    import torch
+
+    gen = torch.Generator(device="cuda").manual_seed(7)
+    rep: dict = {}
+    for src in ("real", "random"):
+        tot = {"rows": 0, "same_order": 0, "same_set": 0, "diff": 0, "fused_f64": 0, "split_f64": 0, "neither": 0,
+               "margins": [], "max_logit_diff": 0.0, "max_w_diff": 0.0}
+        for g in gates:
+            if src == "real":
+                x = _sample(samples, g)
+                if x is None:
+                    continue
+            else:
+                x = torch.randn((rows_random, D), generator=gen, device="cuda").to(torch.bfloat16)
+            from . import router
+
+            pf, wf = _route(g, x, MODE)
+            ps, ws = _route(g, x, "split")
+            k = g["topk"]
+            pf, wf, ps, ws = pf[:, :k], wf[:, :k], ps[:, :k], ws[:, :k]
+            so = (pf == ps).all(1)
+            tot["rows"] += x.shape[0]
+            tot["same_order"] += int(so.sum())
+            tot["same_set"] += int((pf.sort(1).values == ps.sort(1).values).all(1).sum())
+            if bool(so.any()):
+                tot["max_w_diff"] = max(tot["max_w_diff"], float((wf[so] - ws[so]).abs().max()))
+            tot["max_logit_diff"] = max(tot["max_logit_diff"], float(
+                (router.logits(x, g["w"], MODE) - router.logits(x, g["w"], "split")).abs().max()))
+            for r in (~so).nonzero().flatten().tolist():
+                tot["diff"] += 1
+                s = torch.nn.functional.softplus(x[r:r + 1].double() @ g["w"].double().T).sqrt()[0]
+                ch = s + g["b"].double()
+                order = sorted(range(ch.numel()), key=lambda e: (-float(ch[e]), e))
+                ref = order[:k]
+                fa, sa = pf[r].tolist(), ps[r].tolist()
+                tot["fused_f64"] += int(fa == ref)
+                tot["split_f64"] += int(sa == ref)
+                tot["neither"] += int(fa != ref and sa != ref)
+                c = [float(ch[e]) for e in order[:k + 1]]
+                tot["margins"].append(min(c[j] - c[j + 1] for j in range(k)))
+        tot["agree_order"] = tot["same_order"] / max(1, tot["rows"])
+        tot["agree_set"] = tot["same_set"] / max(1, tot["rows"])
+        tot["margins"] = sorted(tot["margins"])[:50]
+        rep[src] = tot
+        print(f"[routerbench] agree {src}: {tot['rows']} rows, order {tot['agree_order']:.6f}, set "
+              f"{tot['agree_set']:.6f}; {tot['diff']} differ (fused == f64 {tot['fused_f64']}, split == f64 "
+              f"{tot['split_f64']}, neither {tot['neither']}); max |logit diff| {tot['max_logit_diff']:.2e}, "
+              f"max |w diff| {tot['max_w_diff']:.2e}", flush=True)
+    return rep
+
+
+def invariance(gates, samples, D: int) -> dict:
+    import torch
+
+    gen = torch.Generator(device="cuda").manual_seed(11)
+    bad = []
+    checked = 0
+    for g in gates:
+        x = torch.randn((40, D), generator=gen, device="cuda").to(torch.bfloat16)
+        real = _sample(samples, g)
+        if real is not None:                        # the real rows first (a capture may hold fewer than 40)
+            n = min(40, real.shape[0])
+            x[:n] = real[:n]
+        N = x.shape[0]
+        alone = [_bits(*_route(g, x[r:r + 1].contiguous())) for r in range(N)]
+        for R in range(1, 17):
+            for off in sorted({0, min(7, N - R), N - R}):
+                p, w = _bits(*_route(g, x[off:off + R].contiguous()))
+                for j in range(R):
+                    checked += 1
+                    if not (torch.equal(p[j], alone[off + j][0][0]) and torch.equal(w[j], alone[off + j][1][0])):
+                        bad.append((g["layer"], R, off, j))
+    # chunks: 4,100 rows in one call (3 launches of <= 2,048) == the same rows in 16-row windows
+    g = gates[0]
+    x = torch.randn((4100, D), generator=gen, device="cuda").to(torch.bfloat16)
+    whole = _bits(*_route(g, x))
+    parts = [_bits(*_route(g, x[a:a + 16].contiguous())) for a in range(0, 4100, 16)]
+    pp = torch.cat([p for p, _ in parts])
+    ww = torch.cat([w for _, w in parts])
+    chunk_ok = bool(torch.equal(whole[0], pp) and torch.equal(whole[1], ww))
+    rep = {"rows_checked": checked, "mismatches": len(bad), "first": bad[:10], "chunked_4100_eq_windows": chunk_ok,
+           "pass": not bad and chunk_ok}
+    print(f"[routerbench] invariance: {checked} row checks over {len(gates)} routers, R = 1..16: "
+          f"{len(bad)} mismatches; 4,100 rows in chunks == 16-row windows: {chunk_ok}", flush=True)
+    return rep
+
+
+def graphs(gates, D: int) -> dict:
+    import torch
+
+    from . import router
+    from . import router_gemv as RG
+
+    gen = torch.Generator(device="cuda").manual_seed(13)
+    dev = torch.device("cuda")
+    rep: dict = {"cases": []}
+
+    def case(name, R, gs, fresh_counters=False):
+        if fresh_counters:
+            router._COUNTERS.clear()
+            RG._COUNTERS.clear()
+        xs = torch.randn((R, D), generator=gen, device="cuda").to(torch.bfloat16)
+        outs = [(torch.empty((R, g["topk"] + 1), dtype=torch.int32, device=dev),
+                 torch.empty((R, g["topk"] + 1), dtype=torch.float32, device=dev)) for g in gs]
+        st = torch.cuda.Stream()
+        st.wait_stream(torch.cuda.current_stream())
+        if not fresh_counters:
+            with torch.cuda.stream(st):                     # warm-up (the counters exist before the capture)
+                for g, (p, w) in zip(gs, outs):
+                    _route(g, xs, pick=p, wts=w)
+            torch.cuda.current_stream().wait_stream(st)
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            for g, (p, w) in zip(gs, outs):
+                _route(g, xs, pick=p, wts=w)
+        eager = [_bits(*_route(g, xs)) for g in gs]
+        res = {"name": name, "R": R, "routers": len(gs)}
+        same = []
+        zero = []
+        for _ in range(2):
+            graph.replay()
+            torch.cuda.synchronize()
+            same.append(all(torch.equal(p, e[0]) and torch.equal(w.view(torch.int32), e[1])
+                            for (p, w), e in zip(outs, eager)))
+            cnt = (RG._COUNTERS if MODE == "gemv" else router._COUNTERS).get((dev.type, torch.cuda.current_device()))
+            zero.append(cnt is None or int(cnt.abs().sum()) == 0)
+        xs.copy_(torch.randn((R, D), generator=gen, device="cuda").to(torch.bfloat16))
+        graph.replay()
+        torch.cuda.synchronize()
+        eager2 = [_bits(*_route(g, xs)) for g in gs]
+        res["replay_eq_eager"] = same
+        res["counters_zero"] = zero
+        res["new_input_eq_eager"] = all(torch.equal(p, e[0]) and torch.equal(w.view(torch.int32), e[1])
+                                        for (p, w), e in zip(outs, eager2))
+        res["pass"] = all(same) and all(zero) and res["new_input_eq_eager"]
+        rep["cases"].append(res)
+        print(f"[routerbench] graph {name} R={R} x{len(gs)}: replays == eager {same}, counters 0 {zero}, "
+              f"new input == eager {res['new_input_eq_eager']}", flush=True)
+        del graph
+
+    case("capture-first", 3, gates[:1], fresh_counters=True)
+    for R in GRAPH_ROWS:
+        case("one-layer", R, gates[:1])
+        case("sweep", R, gates)
+    rep["pass"] = all(c["pass"] for c in rep["cases"])
+    return rep
+
+
+def timing(gates, D: int, iters: int, nsys: bool) -> dict:
+    import torch
+
+    gen = torch.Generator(device="cuda").manual_seed(17)
+    rep: dict = {}
+    if nsys:
+        torch.cuda.cudart().cudaProfilerStart()
+    for R in TIME_ROWS:
+        x = torch.randn((R, D), generator=gen, device="cuda").to(torch.bfloat16)
+        row = {}
+        for mode in ("split", MODE):
+            def sweep(mode=mode, x=x):
+                for g in gates:
+                    _route(g, x, mode)
+
+            sweep()
+            torch.cuda.synchronize()
+            a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+            n = iters if R <= 64 else max(3, iters // 10)
+            a.record()
+            for _ in range(n):
+                sweep()
+            b.record()
+            torch.cuda.synchronize()
+            eager_us = a.elapsed_time(b) * 1000 / n / len(gates)
+            graph_us = None
+            if R <= 64:
+                st = torch.cuda.Stream()
+                st.wait_stream(torch.cuda.current_stream())
+                with torch.cuda.stream(st):
+                    sweep()
+                torch.cuda.current_stream().wait_stream(st)
+                gr = torch.cuda.CUDAGraph()
+                with torch.cuda.graph(gr):
+                    sweep()
+                gr.replay()
+                torch.cuda.synchronize()
+                if nsys:
+                    torch.cuda.nvtx.range_push(f"router-{mode}-R{R}")
+                a.record()
+                for _ in range(n):
+                    gr.replay()
+                b.record()
+                torch.cuda.synchronize()
+                if nsys:
+                    torch.cuda.nvtx.range_pop()
+                graph_us = a.elapsed_time(b) * 1000 / n / len(gates)
+                del gr
+            row[mode] = {"eager_us_layer": round(eager_us, 2),
+                         "graph_us_layer": None if graph_us is None else round(graph_us, 2)}
+        sp, fu = row["split"], row[MODE]
+        key = "graph_us_layer" if fu["graph_us_layer"] is not None else "eager_us_layer"
+        row["speedup"] = round(sp[key] / fu[key], 2)
+        row["saved_ms_44_calls"] = round((sp[key] - fu[key]) * 44 / 1000, 3)
+        rep[str(R)] = row
+        print(f"[routerbench] time R={R}: split {sp} {MODE} {fu} -> x{row['speedup']}, "
+              f"{row['saved_ms_44_calls']} ms a 44-call window", flush=True)
+    if nsys:
+        torch.cuda.cudart().cudaProfilerStop()
+    return rep
+
+
+def gemv_checks(gates, samples, D: int, model_rows: int = 8) -> dict:
+    """router_gemv only: kernel logits == the numpy model (bit for bit) and every (NW, EW) config the same bits, on
+    each router's real rows (random where none); picks vs float64 (stable sort: ties to the lower id) on every real
+    and random row, gemv's rate and split's."""
+
+    import numpy as np
+    import torch
+
+    from . import router
+    from . import router_gemv as RG
+
+    gen = torch.Generator(device="cuda").manual_seed(19)
+    rep = {"model_mismatch": [], "cfg_mismatch": [], "f64": {}}
+    for g in gates:
+        real = _sample(samples, g)
+        x = real if real is not None else torch.randn((64, D), generator=gen, device="cuda").to(torch.bfloat16)
+        xm = x[:model_rows].contiguous()
+        got = RG.logits(xm, g["w"]).cpu().numpy()
+        want = RG.model_logits(xm.cpu(), g["w"].cpu())
+        if not np.array_equal(got.view(np.int32), want.view(np.int32)):
+            rep["model_mismatch"].append((g["layer"], int((got != want).sum())))
+        base = _bits(*_route(g, x, "gemv"))
+        for cfg in RG.CFGS:
+            p = torch.empty_like(base[0])
+            w = torch.empty((x.shape[0], g["topk"] + 1), dtype=torch.float32, device="cuda")
+            RG.route(x, g["w"], g["b"], g["topk"], g["topk"] + 1, g["scale"], p, w, cfg=cfg)
+            if not (torch.equal(p, base[0]) and torch.equal(w.view(torch.int32), base[1])):
+                rep["cfg_mismatch"].append((g["layer"], cfg))
+        for src, xs in (("real", real), ("random", torch.randn((512, D), generator=gen, device="cuda").to(
+                torch.bfloat16))):
+            if xs is None:
+                continue
+            k = g["topk"]
+            s = torch.nn.functional.softplus(xs.double() @ g["w"].double().T).sqrt()
+            ref = torch.sort(-(s + g["b"].double()), dim=1, stable=True).indices[:, :k].int()
+            t = rep["f64"].setdefault(src, {"rows": 0, "gemv": 0, "split": 0})
+            t["rows"] += xs.shape[0]
+            t["gemv"] += int((_route(g, xs, "gemv")[0][:, :k] == ref).all(1).sum())
+            t["split"] += int((router.route(xs, g["w"], g["b"], topk=k, mode="split")[0][:, :k] == ref).all(1).sum())
+    for src, t in rep["f64"].items():
+        t["gemv_rate"] = t["gemv"] / max(1, t["rows"])
+        t["split_rate"] = t["split"] / max(1, t["rows"])
+        print(f"[routerbench] gemv vs float64 picks ({src}): {t['rows']} rows, gemv {t['gemv_rate']:.6f}, split "
+              f"{t['split_rate']:.6f}", flush=True)
+    rep["pass"] = not rep["model_mismatch"] and not rep["cfg_mismatch"]
+    print(f"[routerbench] gemv: logits == model on {len(gates)} routers: {not rep['model_mismatch']} "
+          f"{rep['model_mismatch'][:5]}; configs {RG.CFGS} same bits: {not rep['cfg_mismatch']} "
+          f"{rep['cfg_mismatch'][:5]}", flush=True)
+    return rep
+
+
+def main(argv: list[str] | None = None) -> int:
+    import torch
+
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--samples", default="", help="router_check's <report>.samples.pt (real router inputs)")
+    ap.add_argument("--random-rows", type=int, default=2048)
+    ap.add_argument("--iters", type=int, default=50)
+    ap.add_argument("--nsys", action="store_true")
+    ap.add_argument("--mode", default="fused", choices=("fused", "gemv"), help="the candidate path (vs split)")
+    ap.add_argument("--only", default="agree,invariance,graphs,time,gemv")
+    ap.add_argument("--out", default="")
+    a = ap.parse_args(argv)
+    torch.cuda.set_device(0)
+    cfg, gates = _gates(a.model)
+    D = cfg.hidden_size
+    samples = torch.load(a.samples) if a.samples and Path(a.samples).exists() else None
+    print(f"[routerbench] {len(gates)} routers (E {sorted({int(g['w'].shape[0]) for g in gates})}), samples "
+          f"{0 if samples is None else len(samples)}", flush=True)
+    only = set(a.only.split(","))
+    global MODE
+    MODE = a.mode
+    rep: dict = {"routers": len(gates)}
+    if "agree" in only:
+        rep["agree"] = agree(gates, samples, D, a.random_rows)
+    if "invariance" in only:
+        rep["invariance"] = invariance(gates, samples, D)
+    if "graphs" in only:
+        rep["graphs"] = graphs(gates, D)
+    if "gemv" in only and MODE == "gemv":
+        rep["gemv"] = gemv_checks(gates, samples, D)
+    if "time" in only:
+        rep["time"] = timing(gates, D, a.iters, a.nsys)
+    rep["mode"] = MODE
+    rep["pass"] = all(rep[k]["pass"] for k in ("invariance", "graphs", "gemv") if k in rep)
+    if a.out:
+        Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+        Path(a.out).write_text(json.dumps(rep, indent=1))
+    print(json.dumps({"pass": rep["pass"]}), flush=True)
+    return 0 if rep["pass"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
