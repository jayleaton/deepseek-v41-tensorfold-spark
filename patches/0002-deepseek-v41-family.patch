+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16 ``TF_DSV41_PF_XOVL`` on one GPU (collected only where PyTorch sees an NVIDIA GPU): the side stream, its events
+and the caching allocator's cross-stream lifetimes, without a second GPU. Rank 0 of a 2-rank tree runs with a
+loopback communicator (its partial stands in for both ranks': not the model's math, but the same function with XOVL
+on and off), on the compiled kernels of the synthetic checkpoint: XOVL on == off bit for bit for a 2,301-token prompt
+(1,024-row segments: every exchange in halves) and the next decode steps; the side stream really ran the gathers.
+The TP=2 math is the CPU test's (tests/test_dsv41_xovl.py); the window measures the overlap (g16prefill.sh xovl).
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_xovl_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+import dsv41_dspark_fakes as DF  # noqa: E402
+
+DEV = "cuda"
+
+
+class Loopback:
+    """World 2 on one GPU: the 'other rank' sends what this one sends (an all-gather on the current stream)."""
+
+    rank, world = 0, 2
+
+    def __init__(self) -> None:
+        self.streams: list = []
+
+    def all_gather(self, send: torch.Tensor, recv: torch.Tensor) -> None:
+        self.streams.append(torch.cuda.current_stream().cuda_stream)
+        n = send.numel()
+        recv[:n].copy_(send)
+        recv[n:2 * n].copy_(send)
+
+
+def run(ck, monkeypatch, xovl: bool):
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+    from tensorfold.families.deepseek_v41.cuda import forward as FW
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+    from tensorfold.families.deepseek_v41.cuda.csa2.backend import Triton
+
+    monkeypatch.setenv("TF_DSV41_PF_XOVL", "1" if xovl else "0")
+    root, cfg, table, _ = ck
+    tmap = DF.FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), 0, 2, DEV).load(token_map=tmap)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    comm = Loopback()
+    fw = FW.Forward(cfg, tree, csa2=Triton(128, cfg.num_attention_heads, DEV), comm=comm, device=DEV, limit=4096,
+                    chunk=128, pchunk=1024, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap))
+    ids = [int(t) for t in torch.randint(3, 250, (2301,), generator=torch.Generator().manual_seed(91))]
+    out = [fw.prompt(ids[:-1])]
+    for t in (ids[-1], 5, 6):
+        out.append(fw.step([t]))
+    torch.cuda.synchronize()
+    return torch.cat(out).float().cpu(), comm.streams
+
+
+def test_xovl_one_gpu_loopback_same_bits(tmp_path_factory, monkeypatch):
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")       # the synthetic checkpoint's D is not the mHC kernels' 5,120
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    monkeypatch.setenv("TF_DSV41_FAST_EXPERTS", "gm")
+    monkeypatch.setenv("TF_DSV41_PREFILL_ATTN", "fused")
+    monkeypatch.setenv("TF_DSV41_PF_XOVL_ROWS", "256")
+    ck = DF.ckpt(tmp_path_factory.mktemp("dsv41xovl"))
+    off, s_off = run(ck, monkeypatch, False)
+    for copies in ("0", "1"):
+        monkeypatch.setenv("TF_DSV41_PF_COPIES", copies)
+        on, s_on = run(ck, monkeypatch, True)
+        assert torch.equal(on, off), f"PF_COPIES={copies}"
+        main = torch.cuda.current_stream().cuda_stream
+        assert any(s != main for s in s_on) and all(s == main for s in s_off)    # the side stream gathered
