@@ -0,0 +1,151 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""A trained DSpark delta on the serving drafter (``TF_DSV41_DSPARK_DELTA=<file.safetensors>``, default off;
+``dsparktrain.export_delta`` writes it). The pack is never modified: the delta is applied at load, on both ranks.
+
+- replacement vectors / tables, copied into the drafter's tensors in place (same shapes; graphs captured later read
+  them): ``mtp.0.main_norm``, ``mtp.{last}.norm``, the Markov head (``markov_head.embed`` / ``.head``), the confidence
+  head, and per block ``attn_norm`` / ``ffn_norm`` / ``attn.q_norm`` / ``attn.kv_norm``;
+- LoRA pairs ``<linear>.lora_A`` [r, K] / ``.lora_B`` [N, r] (scale folded): the linear becomes y = W x + B (A x)
+  (``LoraLin``: fp32 side path, rounded once to the caller's dtype), split like its matrix (``weights`` TP table):
+  ``main_proj`` / ``wq_a`` / ``wkv`` whole; ``wq_b`` (this rank's heads: rows of B); ``wo_a.slice.g`` (this rank's
+  groups); ``wo_b`` (this rank's input rows: columns of A; the partial sums still add up across ranks). A block with
+  a LoRA drops its fused projection path (``fused_proj``), which would bypass the wrapper.
+
+Drafts only propose (verification is exact): replies are serial whatever the delta is.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+
+ENV = "TF_DSV41_DSPARK_DELTA"
+F32 = torch.float32
+
+
+class LoraLin:
+    """``base(x, dtype)`` + B (A x)."""
+
+    def __init__(self, base, A: torch.Tensor, B: torch.Tensor) -> None:
+        self.base, self.A, self.B = base, A, B
+
+    @property
+    def k(self) -> int:
+        return self.base.k
+
+    @property
+    def n(self) -> int:
+        return self.base.n
+
+    def __call__(self, x: torch.Tensor, dtype: torch.dtype = F32) -> torch.Tensor:
+        y = self.base(x, F32)
+        d = (x.to(F32) @ self.A.t()) @ self.B.t()
+        return (y.to(F32) + d).to(dtype)
+
+
+def shard(kind: str, A: torch.Tensor, B: torch.Tensor, rank: int, world: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """This rank's (A, B) of a LoRA on a matrix split ``kind``: "" whole, "col" output columns, "row" input rows."""
+
+    if world <= 1 or kind == "":
+        return A, B
+    if kind == "col":
+        n = B.shape[0] // world
+        return A, B[rank * n:(rank + 1) * n]
+    if kind == "row":
+        k = A.shape[1] // world
+        return A[:, rank * k:(rank + 1) * k], B
+    raise ValueError(kind)
+
+
+def apply(dr, path: str, *, rank: int, world: int) -> dict:
+    """Load ``path`` into ``dr`` (``drafter.Drafter``) -> counts."""
+
+    from safetensors import safe_open
+
+    cfg = dr.cfg
+    nb = cfg.num_nextn_predict_layers
+    dev = dr.dev
+    got = {"vectors": 0, "lora": 0}
+    with safe_open(path, "pt") as fh:
+        keys = set(fh.keys())
+
+        def put(dst: torch.Tensor, k: str) -> None:
+            t = fh.get_tensor(k).reshape(dst.shape) if fh.get_tensor(k).numel() == dst.numel() else None
+            if t is None:
+                raise ValueError(f"{ENV}: {k} has the wrong size for {tuple(dst.shape)}")
+            dst.copy_(t.to(dtype=dst.dtype, device=dst.device))
+            got["vectors"] += 1
+
+        for k in keys:
+            if k.endswith("lora_A") or k.endswith("lora_B"):
+                continue
+            if k.endswith("main_norm.weight"):
+                put(dr.main_norm, k)
+            elif k.endswith("markov_head.embed.weight"):
+                put(dr.w1, k)
+            elif k.endswith("markov_head.head.weight"):
+                put(dr.w2, k)
+            elif k.endswith("confidence_head.proj.weight"):
+                if dr.cw is not None:
+                    put(dr.cw, k)
+            elif k.startswith("mtp.") and k.endswith(".norm.weight") and k.count(".") == 3:
+                put(dr.norm, k)
+            else:
+                parts = k.split(".")
+                b = int(parts[1])
+                if not 0 <= b < nb:
+                    raise ValueError(f"{ENV}: unknown block in {k}")
+                blk = dr.blocks[b]
+                if k.endswith("attn.q_norm.weight"):
+                    put(blk.attn.q_norm, k)
+                elif k.endswith("attn.kv_norm.weight"):
+                    put(blk.attn.kv_norm, k)
+                elif k.endswith(".attn_norm.weight"):
+                    put(blk.attn_norm, k)
+                elif k.endswith(".ffn_norm.weight"):
+                    put(blk.ffn_norm, k)
+                else:
+                    raise ValueError(f"{ENV}: unknown tensor {k}")
+        gl = cfg.o_groups // world
+        for k in sorted(keys):
+            if not k.endswith(".lora_A"):
+                continue
+            p = k[:-len(".lora_A")]
+            A = fh.get_tensor(k).to(device=dev, dtype=F32)
+            B = fh.get_tensor(f"{p}.lora_B").to(device=dev, dtype=F32)
+            if p.endswith("main_proj"):
+                dr.main_proj = LoraLin(dr.main_proj, *shard("", A, B, rank, world))
+                got["lora"] += 1
+                continue
+            parts = p.split(".")
+            blk = dr.blocks[int(parts[1])]
+            name = parts[3]
+            att = blk.attn
+            if name in ("wq_a", "wkv", "wq_b", "wo_b"):
+                kind = {"wq_a": "", "wkv": "", "wq_b": "col", "wo_b": "row"}[name]
+                setattr(att, name, LoraLin(getattr(att, name), *shard(kind, A, B, rank, world)))
+            elif name == "wo_a":
+                g = int(parts[5])
+                if not rank * gl <= g < (rank + 1) * gl:
+                    continue
+                att.wo_a[g - rank * gl] = LoraLin(att.wo_a[g - rank * gl], A, B)
+            else:
+                raise ValueError(f"{ENV}: unknown LoRA {p}")
+            blk.fused = None
+            got["lora"] += 1
+    return got
+
+
+def maybe_apply(dr, rank: int, world: int) -> dict | None:
+    path = os.environ.get(ENV, "").strip()
+    if not path:
+        return None
+    got = apply(dr, path, rank=rank, world=world)
+    if rank == 0:
+        print(f"[tensorfold] dsv41 DSpark delta {path}: {got['vectors']} tensors, {got['lora']} LoRA", flush=True)
+    return got
+
+
+__all__ = ["ENV", "LoraLin", "apply", "maybe_apply", "shard"]
