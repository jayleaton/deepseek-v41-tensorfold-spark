+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16 4K (``pf4k``): the guard, the knobs, the memory accounting and the 4K-only buffers, on the CPU.
+
+- the guard: prefill windows above 2,048 rows (TF_DSV41_PF_4K=1, TF_DSV41_PREFILL_CHUNK or TF_DSV41_PREFILL_ROWS)
+  REFUSE at boot without TF_DSV41_PF_4K_MEMORY_OK=1, saying how much memory and where to read first; above 4,096
+  always; the engine refuses before it loads anything, ``forward.prefill_chunk`` and the batcher's env path too;
+  nothing changes by default (2,048, no arena, x3gm's G6 block);
+- the accounting (``pf4k.terms``): every term's bytes a row from the target's shapes; the total the message prints;
+- the 4K-only buffers: ``moe.arena_scratch`` == upstream ``Scratch`` (attributes, shapes, dtypes, zeros), the float
+  buffers disjoint views of one arena; x3gm's block = the window under 4K.
+"""
+
+from __future__ import annotations
+
+import pytest
+import torch
+
+from tensorfold.families.deepseek_v41.cuda import forward as FW
+from tensorfold.families.deepseek_v41.cuda import pf4k
+from tensorfold.families.deepseek_v41.cuda import x3gm
+
+KNOBS = ("TF_DSV41_PF_4K", "TF_DSV41_PF_4K_MEMORY_OK", "TF_DSV41_PREFILL_CHUNK", "TF_DSV41_PREFILL_ROWS",
+         "TF_DSV41_GM_ROWS")
+
+
+@pytest.fixture(autouse=True)
+def clean(monkeypatch):
+    for k in KNOBS:
+        monkeypatch.delenv(k, raising=False)
+
+
+# -- the guard ------------------------------------------------------------------------------------------------------
+def test_default_is_2048_and_off():
+    assert pf4k.chunk({}) == 2048 and pf4k.window({}) == 2048
+    assert not pf4k.requested({}) and not pf4k.active({})
+    pf4k.check({})
+    assert FW.prefill_chunk() == 2048
+    assert pf4k.gm_rows({}) == 2048 and x3gm.config({})["rows"] == 2048
+    from tensorfold.families.deepseek_v41.cuda import experts as X
+
+    assert pf4k.gm_arena_bytes(X.MODEL, {}) == 0                 # no arena: upstream's separate buffers
+
+
+@pytest.mark.parametrize("env", [{"TF_DSV41_PF_4K": "1"}, {"TF_DSV41_PREFILL_CHUNK": "4096"},
+                                 {"TF_DSV41_PREFILL_ROWS": "4096"}, {"TF_DSV41_PREFILL_CHUNK": "3000"},
+                                 {"TF_DSV41_PF_4K": "1", "TF_DSV41_PF_4K_MEMORY_OK": "0"}])
+def test_refuses_without_the_acknowledgement(env):
+    assert pf4k.requested(env)
+    with pytest.raises(RuntimeError) as e:
+        pf4k.check(env)
+    msg = str(e.value)
+    assert "need about" in msg and "GiB more worker memory" in msg
+    assert "TF_DSV41_PF_4K_MEMORY_OK=1" in msg and "G16-RELEASE.md" in msg
+    assert "enable only after the memory cap/leak work" in msg
+    assert f"{pf4k.extra_gib(pf4k.window(env)):.2f} GiB" in msg
+    assert not pf4k.active(env)
+
+
+def test_acknowledged_4k_boots():
+    env = {"TF_DSV41_PF_4K": "1", "TF_DSV41_PF_4K_MEMORY_OK": "1"}
+    pf4k.check(env)
+    assert pf4k.active(env) and pf4k.chunk(env) == 4096 and pf4k.window(env) == 4096
+    assert pf4k.gm_rows(env) == 4096 and x3gm.config(env)["rows"] == 4096
+    assert x3gm.config({**env, "TF_DSV41_GM_ROWS": "2048"})["rows"] == 2048            # the knob still wins
+    from tensorfold.families.deepseek_v41.cuda import experts as X
+
+    assert pf4k.gm_arena_bytes(X.MODEL, env) == 559939584        # Y 503,316,480 + Xd 56,623,104 at 4,096 rows
+    assert pf4k.gm_arena_bytes(X.DSPARK, env) == 0               # the drafter's scratch: never x3gm
+
+
+def test_above_4096_and_contradictions_refuse():
+    for env in ({"TF_DSV41_PREFILL_CHUNK": "8192", "TF_DSV41_PF_4K_MEMORY_OK": "1"},
+                {"TF_DSV41_PREFILL_ROWS": "6144", "TF_DSV41_PF_4K_MEMORY_OK": "1"}):
+        with pytest.raises(RuntimeError, match="only 4096 is built"):
+            pf4k.check(env)
+    for env in ({"TF_DSV41_PF_4K": "1", "TF_DSV41_PREFILL_CHUNK": "2048"},
+                {"TF_DSV41_PF_4K": "1", "TF_DSV41_PREFILL_ROWS": "2048"}, {"TF_DSV41_PF_4K": "yes"}):
+        with pytest.raises(ValueError):
+            pf4k.check(env)
+    pf4k.check({"TF_DSV41_PREFILL_CHUNK": "1024", "TF_DSV41_PREFILL_ROWS": "1024"})     # the G16 cap: smaller, fine
+
+
+def test_prefill_chunk_refuses_from_the_environment(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_PREFILL_CHUNK", "4096")
+    with pytest.raises(RuntimeError, match="TF_DSV41_PF_4K_MEMORY_OK"):
+        FW.prefill_chunk()
+    monkeypatch.setenv("TF_DSV41_PF_4K_MEMORY_OK", "1")
+    assert FW.prefill_chunk() == 4096
+    monkeypatch.delenv("TF_DSV41_PREFILL_CHUNK")
+    monkeypatch.setenv("TF_DSV41_PF_4K", "1")
+    assert FW.prefill_chunk() == 4096
+
+
+def test_engine_refuses_before_loading(monkeypatch, tmp_path):
+    """The boot refuses with the message before reading the checkpoint (there is none here)."""
+
+    from tensorfold.families.deepseek_v41.cuda.engine import Dsv41Engine
+
+    monkeypatch.setenv("TF_DSV41_PF_4K", "1")
+    with pytest.raises(RuntimeError, match="GiB more worker memory"):
+        Dsv41Engine(tmp_path / "nothing", rank=0, master="127.0.0.1", port=1, device="cpu")
+    from pathlib import Path
+
+    text = Path(FW.__file__).with_name("engine.py").read_text()
+    assert text.index("pf4k.check()") < text.index("Config.from_file")
+
+
+def test_batcher_rows_refuse(monkeypatch):
+    from types import SimpleNamespace
+
+    from tensorfold.families.deepseek_v41.cuda.batch import Batcher
+
+    monkeypatch.setenv("TF_DSV41_PREFILL_ROWS", "4096")
+    stub = lambda *a, **k: None                                                          # noqa: E731
+    fwd = SimpleNamespace(pchunk=2048, vocab=256, **{m: stub for m in ("reset", "prefill", "finish_prompt",
+                                                                        "window", "commit", "snapshot", "restore")})
+    with pytest.raises(RuntimeError, match="GiB more worker memory"):
+        Batcher.__init__(Batcher.__new__(Batcher), fwd, None, n_slots=1, capacity=64, start=False)
+
+
+# -- the accounting -------------------------------------------------------------------------------------------------
+def test_terms_from_the_shapes():
+    t = pf4k.terms()                                          # the 4K path as built: stash trim + bulk sub-reads
+    assert t.rows - t.base == 2048
+    assert t.persistent["streams x [n, 4D] bf16"] == 4 * 5120 * 2
+    assert t.persistent["mHC scratch part [n, 4, 40, 32] fp32 + c [n, D] bf16"] == 20480 + 10240
+    assert t.exchange["receive [W, n, D] bf16"] == 2 * 5120 * 2                 # the 21 MB gather at 2,048 doubles
+    assert t.host == {"Engram fp32 row buffers kept (x6)": 6 * 12 * 256 * 4}
+    assert t.slots == {}
+    assert t.gm_naive == 559939584
+    assert t.device_row == 273796
+    assert t.extra_gib == pytest.approx(2048 * (273796 + 73728) / 2**30)        # 0.66 GiB
+    raw = pf4k.terms(trim=False, sub=False)                   # without the savings: stash x4 slots, read buffers
+    assert raw.slots == {"CED stash cat buffer [KEEP + n] x / out / coefs (x4 slots)": 4 * 51296}
+    assert raw.extra_gib == pytest.approx(t.extra_gib + 2048 * (4 * 51296 + 4 * 12 * 4096) / 2**30)
+    assert pf4k.terms(copies=True).device_gib < t.device_gib
+    tab = t.table()
+    assert "**total**" in tab and "arena" in tab and "saved: CED stash" in tab
+    assert f"{t.extra_gib:.2f} GiB more worker memory" in pf4k.message(4096)
+
+
+def test_savings_knobs():
+    on = {"TF_DSV41_PF_4K": "1", "TF_DSV41_PF_4K_MEMORY_OK": "1"}
+    assert not pf4k.stash_trim({}) and pf4k.bulk_sub({}) == 0                  # default: unchanged
+    assert pf4k.stash_trim(on) and pf4k.bulk_sub(on) == 24576                  # 4K: on
+    assert pf4k.stash_trim({"TF_DSV41_CED_STASH_TRIM": "1"})                    # alone, at any chunk
+    assert pf4k.bulk_sub({**on, "TF_DSV41_ENGRAM_BULK_SUB": "0"}) == 0
+    assert pf4k.bulk_sub({"TF_DSV41_ENGRAM_BULK_SUB": "4096"}) == 4096
+    with pytest.raises(ValueError):
+        pf4k.stash_trim({"TF_DSV41_CED_STASH_TRIM": "on"})
+
+
+def test_stash_trim_same_rows_one_buffer(monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda import replay as RP
+
+    def stash(lo, n, seed):
+        g = torch.Generator().manual_seed(seed)
+        r = lambda *s: torch.randn(*s, generator=g)                                    # noqa: E731
+        return RP.Stash(lo, r(n, 16).to(torch.bfloat16), r(n, 4).to(torch.bfloat16), r(n, 4), r(n, 4), r(n, 16),
+                        list(range(lo, lo + n)))
+
+    for have_n, got_n in ((0, 300), (50, 40), (100, 100), (127, 4096), (127, 3)):
+        have, got = stash(1000 - have_n, have_n, 1), stash(1000, got_n, 2)
+        monkeypatch.setenv("TF_DSV41_CED_STASH_TRIM", "0")
+        old = have.extend(got)
+        monkeypatch.setenv("TF_DSV41_CED_STASH_TRIM", "1")
+        new = have.extend(got)
+        assert (new.lo, new.ids) == (old.lo, old.ids) and len(new.ids) == min(RP.KEEP, have_n + got_n)
+        for k in ("x", "out", "pre", "post", "comb"):
+            a, b = getattr(old, k), getattr(new, k)
+            assert torch.equal(a, b), k
+            assert b.untyped_storage().nbytes() == b.numel() * b.element_size()      # exactly the kept rows
+        if have_n + got_n > RP.KEEP:                          # the old view keeps the whole concatenation alive
+            assert old.x.untyped_storage().nbytes() == (have_n + got_n) * 16 * 2
+
+
+def test_engram_bulk_sub_reads_same_bits(monkeypatch):
+    import numpy as np
+
+    from tensorfold.families.deepseek_v41.cuda import prefetch as PF
+    from tensorfold.families.deepseek_v41.cuda.engram_host import VALUES
+
+    class Src:                                                # a packed shard's records: FP8 values + UE8M0 scales
+        dim = 64
+
+        def __init__(self):
+            rng = np.random.default_rng(3)
+            self.rec = rng.integers(0, 256, size=(500, 264), dtype=np.uint8)
+            self.rec[:, :64] &= 0x7E                          # finite FP8 (no NaN codes)
+            self.rec[:, VALUES:VALUES + 2] = rng.integers(110, 140, size=(500, 2), dtype=np.uint8)
+            self.calls = []
+
+        def raw(self, index):
+            idx = np.asarray(index.reshape(-1).numpy())
+            self.calls.append(idx.size)
+            return self.rec[idx]
+
+    src = Src()
+    index = torch.from_numpy(np.random.default_rng(4).integers(0, 500, size=1000))
+    monkeypatch.setenv("TF_DSV41_ENGRAM_BULK_SUB", "0")
+    one = PF.bulk_rows(src, index).clone()
+    assert src.calls == [1000]
+    monkeypatch.setenv("TF_DSV41_ENGRAM_BULK_SUB", "300")
+    src.calls = []
+    sub = PF.bulk_rows(src, index)
+    assert src.calls == [300, 300, 300, 100]
+    assert torch.equal(sub.view(torch.int32), one.view(torch.int32))
+
+
+# -- 4K-only buffers ------------------------------------------------------------------------------------------------
+class _Ex:
+    dims, width, count = 256, 128, 9
+
+
+class _Geom:
+    slots = 3
+
+
+def test_arena_scratch_is_upstreams_scratch(monkeypatch):
+    from tensorfold.cuda.exl3 import experts as x3
+    from tensorfold.families.deepseek_v41.cuda import experts as X
+    from tensorfold.families.deepseek_v41.cuda import moe
+
+    cfgs = ((8, 4, 2, 1), (8, 4, 1, 1))
+    monkeypatch.setattr(X, "configs", lambda geom: cfgs)
+    block = type("B", (), {"ex": _Ex(), "geom": _Geom()})()
+    want = x3.Scratch(_Ex(), 16, 3, *cfgs, device="cpu")
+    got = moe.arena_scratch(block, 16, "cpu", min_bytes=0)
+    names = set(vars(want)) | {"arena"}
+    assert set(vars(got)) == names
+    for k, v in vars(want).items():
+        g = getattr(got, k)
+        if isinstance(v, torch.Tensor):
+            assert g.shape == v.shape and g.dtype == v.dtype and torch.equal(g, v), k
+        else:
+            assert g == v, k
+    spans = sorted((t.data_ptr(), t.data_ptr() + t.numel() * t.element_size())
+                   for t in (got.z, got.y, got.xg, got.xu, got.xd))
+    lo, hi = got.arena.data_ptr(), got.arena.data_ptr() + got.arena.numel()
+    assert spans[0][0] == lo and spans[-1][1] <= hi
+    assert all(a[1] <= b[0] for a, b in zip(spans, spans[1:]))               # disjoint
+    assert got.arena.numel() == moe.arena_bytes(16, 3, 256, 128, 2, 1)
+    big = moe.arena_scratch(block, 16, "cpu", min_bytes=got.arena.numel() + 4096)
+    assert big.arena.numel() == got.arena.numel() + 4096
