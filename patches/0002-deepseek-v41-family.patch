+def fused_only(calls: list):
+    """``scaled_dot_product_attention`` as CUDA's fused kernels take it, so the CPU sees the GPU's rules: the call
+    must come with the math path off and flash / memory-efficient on (``sdpa_kernel(SDPA_BACKENDS)``), and q / k / v
+    must be 4-D ("All fused kernels requires query, key and value to be 4 dimensional"; with no math fallback that is
+    "No available kernel": every image failed so on 7954c1d, G15a)."""
+
+    real = torch.nn.functional.scaled_dot_product_attention
+    cuda = torch.backends.cuda
+
+    def sdpa(q, k, v, *a, **kw):
+        if cuda.math_sdp_enabled() or not (cuda.flash_sdp_enabled() or cuda.mem_efficient_sdp_enabled()):
+            raise AssertionError("vision attention outside sdpa_kernel(flash, memory-efficient): an N^2 math path")
+        if q.dim() != 4 or k.dim() != 4 or v.dim() != 4:
+            raise RuntimeError(f"No available kernel. Aborting execution. (fused kernels need 4-D, got q {q.dim()}-D)")
+        calls.append(tuple(q.shape))
+        return real(q, k, v, *a, **kw)
+
+    return sdpa
+
+
+def test_sdpa_meets_the_fused_kernels_contract(ref_vit, monkeypatch):
+    tower, vit, al = small_tower(ref_vit)
+    patches = torch.randn(6 * 9, 3, 14, 14)
+    with torch.no_grad():
+        want = al(vit(patches, 6, 9), 6, 9)                   # the reference, before the stand-in goes in
+    calls: list = []
+    sdpa = fused_only(calls)
+    monkeypatch.setattr(torch.nn.functional, "scaled_dot_product_attention", sdpa)
+    q = torch.randn(4, 10, 16)
+    from torch.nn.attention import SDPBackend, sdpa_kernel
+
+    with sdpa_kernel([SDPBackend.FLASH_ATTENTION, SDPBackend.EFFICIENT_ATTENTION]), \
+            pytest.raises(RuntimeError, match="No available kernel"):
+        sdpa(q, q, q)                                         # 7954c1d's call: 3-D q / k / v
+    with pytest.raises(AssertionError, match="math"):
+        sdpa(q[None], q[None], q[None])                       # outside the restriction
+    out = V._sdpa(q, q, q)
+    assert out.shape == q.shape and calls == [(1, 4, 10, 16)]
+    with pytest.raises(ValueError, match=r"\[heads, n, hd\]"):
+        V._sdpa(q[None], q[None], q[None])
+    calls.clear()                                             # the whole tower through the same contract
+    got = tower.align(tower.vit(patches, 6, 9), 6, 9)
+    assert calls == [(1, 4, 54, 16)] * tower.layers
+    assert torch.allclose(got, want, atol=1e-5, rtol=1e-5)
+    rows = tower.span(VP.Prepared(torch.randn(54, 3, 14, 14).to(torch.bfloat16), 6, 9, 2, 3, b"c", (1, 1)))
+    assert rows.shape == (VP.span_len(2, 3), 128) and rows.dtype == torch.bfloat16 and rows.float().isfinite().all()
+
