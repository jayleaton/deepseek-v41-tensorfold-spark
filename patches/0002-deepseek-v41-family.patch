@@ -0,0 +1,295 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G14 on ONE GPU: the paced L2 prefetch (``l2pace.cu``, TF_DSV41_L2PF_PACE_GBPS), the prefetch's placement against an
+exchange, and the RoCE host mailbox (TF_DSV41_PLAN_LINK=rdma). The RoCE peer is ``roce.cpp``'s loop-back thread
+(``Runtime(loop_xor=K)``): the GPU side of an exchange (staging stores, the flag poll, the copy-out's system-scope
+loads) is the real one, so what a prefetch does to it shows here too.
+
+- paced kernel: 12 MiB at 100 / 200 GB/s takes ~the paced time (a [G14] line), and the bytes it read are unchanged;
+- exchange beside a prefetch: per variant (none, G10's burst segments_kernel, paced 150 / 250 GB/s; classic and fast
+  RoCE kernel), 81 exchanges of 10 KiB each with a fresh 12 MiB site forked right before it (DRAM-cold), the trace
+  ring's stage / copy / total p50 / p90 ([G14] lines, not asserted: the window A/B is g14comm.sh's); bits exact;
+- the engine: the synthetic checkpoint's windows through ``CudaGraphs`` with TF_DSV41_L2PF=1 paced, and with AT=after,
+  == L2PF off, logits bit for bit;
+- AFTER_GATHER inside a capture: a side-stream fork from the hook after a RoCE gather, joined, replayed: bits exact;
+- mailbox: send / recv round trips (0 B .. 600 KiB, multi-chunk with credits) over the loop's echo, and RoceLink over
+  it with a real TCP pair.
+
+    pytest -q tests/cuda/test_dsv41_g14_gpu.py   (inside the image; ~3 min)
+"""
+
+from __future__ import annotations
+
+import socket
+import statistics as st
+import threading
+
+import numpy as np
+import pytest
+import torch
+
+if not torch.cuda.is_available() or torch.cuda.get_device_capability()[0] < 9:
+    pytest.skip("needs an sm_90+ NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.cuda import comm as C  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import l2pf as L2  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import planlink as PL  # noqa: E402
+from tensorfold.families.glm5_next.spark import roce, roce_split  # noqa: E402
+
+KEY = 0x2D
+MB = 2**20
+KNOBS = ("TF_DSV41_L2PF", "TF_DSV41_L2PF_PACE_GBPS", "TF_DSV41_L2PF_AT", "TF_DSV41_L2PF_MB", "TF_DSV41_PDL")
+
+
+@pytest.fixture(autouse=True)
+def _knobs_off(monkeypatch):
+    for k in KNOBS:
+        monkeypatch.delenv(k, raising=False)
+
+
+def _rt(fast=False, trace=0):
+    s = roce.Settings(max_bytes=1024 * 1024, timeout_s=10.0, fast=fast, pollers=1, trace=trace)
+    return roce.Runtime(rank=0, world=2, hcas=[], n_hca=2, s=s, loop_xor=KEY)
+
+
+def _table(t: torch.Tensor, nbytes: int) -> torch.Tensor:
+    return torch.tensor([[t.data_ptr(), nbytes]], dtype=torch.int64, device="cuda")
+
+
+def test_paced_kernel_rate_and_read_only():
+    pace = L2._pace_ext()
+    buf = torch.randint(-2**31, 2**31 - 1, (12 * MB // 4,), dtype=torch.int32, device="cuda")
+    ref = buf.clone()
+    tab = _table(buf, 12 * MB)
+    flush = torch.empty(64 * MB, dtype=torch.uint8, device="cuda")
+    for gbps in (100.0, 200.0):
+        s = L2.settings({L2.ENV: "1", L2.ENV + "_PACE_GBPS": str(gbps)})
+        ns, delay = L2.pace_args(s, 32 * 1024)
+        ts = []
+        for _ in range(5):
+            flush.fill_(1)                                    # evict the site from L2
+            a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+            a.record()
+            pace.paced(tab, 2, 32 * 1024, ns, delay)
+            b.record()
+            b.synchronize()
+            ts.append(a.elapsed_time(b) * 1e3)
+        us = st.median(ts)
+        want = 12 * MB / (gbps * 1e3)
+        print(f"[G14] l2pace 12 MiB at {gbps:g} GB/s: kernel {us:.1f} us (paced {want:.1f} us)")
+        assert 0.8 * want < us < 2.5 * want, (gbps, us, want)
+    assert torch.equal(buf, ref)
+
+
+def _p(v, q):
+    return float(np.percentile(np.asarray(v), q)) if v else 0.0
+
+
+@pytest.mark.parametrize("fast", [False, True], ids=["classic", "fast"])
+def test_exchange_beside_prefetch(fast):
+    rt = _rt(fast=fast, trace=4096)
+    try:
+        ext, pace = L2._ext(), L2._pace_ext()
+        sites = [torch.empty(12 * MB, dtype=torch.uint8, device="cuda") for _ in range(6)]   # 72 MiB: DRAM-cold
+        tabs = [_table(t, 12 * MB) for t in sites]
+        side = torch.cuda.Stream()
+        x = torch.randn(5120, device="cuda").to(torch.bfloat16)
+        y = torch.empty(2 * x.numel(), dtype=torch.bfloat16, device="cuda")
+        work = torch.empty(4 * MB, dtype=torch.float32, device="cuda")
+
+        def run(variant: str, n: int = 81):
+            for i in range(n):
+                cur = torch.cuda.current_stream()
+                if variant != "none":
+                    side.wait_stream(cur)
+                    with torch.cuda.stream(side):
+                        if variant == "burst":
+                            ext.segments(tabs[i % 6], 3, 128, 32 * 1024, True)
+                        else:
+                            ns, delay = L2.pace_args(L2.settings({L2.ENV: "1", L2.ENV + "_PACE_GBPS": variant}),
+                                                     32 * 1024)
+                            pace.paced(tabs[i % 6], 2, 32 * 1024, ns, delay)
+                rt.gather(x, y)
+                work.mul_(1.0)                                # ~a decode segment's glue after the exchange
+                cur.wait_stream(side)
+
+        rows = {}
+        for variant in ("none", "burst", "150", "250"):
+            run(variant, 20)
+            torch.cuda.synchronize()
+            first = int(rt.ctrl[roce.CTRL_COMPLETED]) + 1
+            run(variant)
+            torch.cuda.synchronize()
+            rt.check()
+            comps = [roce_split.components(r) for r in rt.trace_rows(range(first, first + 81))]
+            comps = [c for c in comps if c]
+            rows[variant] = comps
+            print(f"[G14] exchange beside prefetch ({'fast' if fast else 'classic'} kernel, {variant}): "
+                  f"stage p50 {_p([c['stage'] for c in comps], 50):.2f} p90 {_p([c['stage'] for c in comps], 90):.2f}, "
+                  f"copy p50 {_p([c['copy'] for c in comps], 50):.2f} p90 {_p([c['copy'] for c in comps], 90):.2f}, "
+                  f"total p50 {_p([c['total'] for c in comps], 50):.2f} p90 {_p([c['total'] for c in comps], 90):.2f} us")
+            assert len(comps) >= 70
+        want = torch.cat([x.view(torch.uint8), x.view(torch.uint8) ^ KEY]).view(torch.bfloat16)
+        assert torch.equal(y.view(torch.int16), want.view(torch.int16))
+    finally:
+        torch.cuda.synchronize()
+        rt.close()
+
+
+def test_after_gather_hook_inside_a_capture(monkeypatch):
+    rt = _rt(fast=True)
+    try:
+        comm = roce.RoceComm(type("B", (), {"rank": 0, "world": 2})(), rt, 1024 * 1024)
+        side = torch.cuda.Stream()
+        site = torch.empty(4 * MB, dtype=torch.uint8, device="cuda")
+        tab = _table(site, 4 * MB)
+        ext = L2._ext()
+        forks = []
+
+        def hook():
+            cur = torch.cuda.current_stream()
+            side.wait_stream(cur)
+            with torch.cuda.stream(side):
+                ext.segments(tab, 1, 128, 32 * 1024, True)
+            forks.append(1)
+
+        monkeypatch.setattr(C, "AFTER_GATHER", [hook])
+        x = torch.randn(2560, device="cuda")
+        y = torch.empty(2 * x.numel(), device="cuda")
+        z = torch.empty_like(y)
+
+        def body():
+            for _ in range(8):
+                C.fast_gather(comm, x, y)
+                z.copy_(y * 3)
+            torch.cuda.current_stream().wait_stream(side)
+
+        s = torch.cuda.Stream()
+        s.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(s):
+            body()
+        torch.cuda.current_stream().wait_stream(s)
+        torch.cuda.synchronize()
+        g = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(g):
+            body()
+        for _ in range(10):
+            x.normal_()
+            g.replay()
+            torch.cuda.synchronize()
+            want = torch.cat([x.view(torch.uint8), x.view(torch.uint8) ^ KEY]).view(torch.float32)
+            assert torch.equal(y.view(torch.int32), want.view(torch.int32)) and torch.equal(z, y * 3)
+        assert len(forks) == 16 and comm.fast_ops == 16
+    finally:
+        torch.cuda.synchronize()
+        rt.close()
+
+
+@pytest.mark.parametrize("variant", [{"TF_DSV41_L2PF_PACE_GBPS": "150"},
+                                     {"TF_DSV41_L2PF_PACE_GBPS": "200", "TF_DSV41_L2PF_PACE_SITES": "x,o,f"},
+                                     {"TF_DSV41_L2PF_AT": "after"}], ids=["pace150", "pace200all", "after"])
+def test_engine_windows_l2pf_variant_equals_off(monkeypatch, tmp_path, variant):
+    import dsv41_dspark_fakes as DF
+
+    from tensorfold.families.deepseek_v41.cuda import graphs as G
+    from tensorfold.families.deepseek_v41.cuda.forward import Seg
+    from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")
+    monkeypatch.setenv("TF_DSV41_EXPERT_LOADS", "1")
+    ck = DF.ckpt(tmp_path / "ck")
+    settings = {"on": True, "budget_s": 120.0, "max_graphs": 64, "bucket": 2048, "slots": 2}
+    prompts = [[int(t) for t in np.random.default_rng(40 + i).integers(3, 250, size=300 + 17 * i)] for i in range(2)]
+    on_env = {"TF_DSV41_L2PF": "1", **variant}
+
+    def apply(on: bool):
+        for k in set(KNOBS) | set(on_env):
+            monkeypatch.delenv(k, raising=False)
+        if on:
+            for k, v in on_env.items():
+                monkeypatch.setenv(k, v)
+
+    def build(on: bool):
+        apply(on)
+        fw = DF.forward(ck, slots=2, limit=4096, dspark=False, device="cuda", chunk=128)
+        b = DF.batcher(ck, fw, n=2, capacity=4096, pool_tokens=3 * 4096)
+        fw.graphs = G.CudaGraphs(fw, settings=settings)
+        fw.graphs.warmup(2, lambda s, end: b.ex.slots[s].ensure(end))
+        for s in range(2):
+            b.ex.slots[s].ensure(4096)
+            fw.reset(s)
+            fw.prefill([Piece(s, 0, tuple(prompts[s]))], mode="full")
+        return fw
+
+    on, off = build(True), build(False)
+    pfs = [getattr(blk, "l2pf", None) for blk in on.blocks]
+    assert any(p is not None for p in pfs)
+    rng = np.random.default_rng(5)
+    for step in range(8):
+        widths = [int(rng.choice(G.WIDTHS)) for _ in range(2)]
+        segs = [Seg(s, off.slots[s].pos, tuple(int(t) for t in rng.integers(3, 250, size=widths[s])))
+                for s in range(2) if step % 3 or s == 0]
+        out = {}
+        for name, fw in (("on", on), ("off", off)):
+            apply(name == "on")
+            out[name] = fw.graphs.run(segs).clone()
+        assert torch.equal(out["on"], out["off"]), (step, widths)
+        for sg in segs:
+            for fw in (on, off):
+                fw.keep(sg.slot, len(sg.ids) // 2)
+    pf = next(p for p in pfs if p is not None)
+    if "TF_DSV41_L2PF_PACE_GBPS" in variant:
+        assert pf.stats.paced > 0
+    print(f"[G14] engine l2pf {variant}: launches {pf.stats.launches}, paced {pf.stats.paced}, deferred "
+          f"{pf.stats.deferred}, dropped {pf.stats.dropped}")
+
+
+def test_mailbox_round_trips():
+    rt = _rt()
+    try:
+        box = rt.mailbox()
+        rng = np.random.default_rng(1)
+        sizes = [0, 1, 7, 100, 65 * 1024, 64 * 1024 - 16, 600 * 1024, 3000]
+        for n in sizes:
+            data = rng.integers(0, 256, n, dtype=np.uint8).tobytes()
+            got = {}
+            th = threading.Thread(target=lambda: got.__setitem__("ok", box.send(data, 10.0)))
+            th.start()                                        # > MSG_SLOTS chunks need the receiver's acks: a thread
+            back = box.recv(1, 1000.0, 20.0, -1, 10.0)
+            th.join()
+            assert got["ok"] and back == data, n
+        assert box.sent() == box.received() and box.sent() >= len(sizes)
+    finally:
+        torch.cuda.synchronize()
+        rt.close()
+
+
+def test_roce_link_over_the_mailbox():
+    rt = _rt()
+    try:
+        with socket.socket() as s:
+            s.bind(("127.0.0.1", 0))
+            port = s.getsockname()[1]
+        out = {}
+        th = threading.Thread(target=lambda: out.__setitem__(0, PL.TcpLink(0, "127.0.0.1", port, timeout_s=10)))
+        th.start()
+        t1 = PL.TcpLink(1, "127.0.0.1", port, timeout_s=10)
+        th.join()
+        box = rt.mailbox()
+        r1 = {}
+        th = threading.Thread(target=lambda: r1.__setitem__(1, PL.RoceLink(1, t1, box, spin_us=200, nap_us=20)))
+        th.start()
+        l0 = PL.RoceLink(0, out[0], box, spin_us=200, nap_us=20)
+        th.join()
+        l1 = r1[1]
+        # the loop echoes this rank's sends as "rank 1's" messages: recv(src=1) reads them; RoceLink reads src 0, so
+        # read through the box directly here and check the frame format RoceLink writes
+        for plan in ([1, 2, 3], list(range(20000)), []):
+            l0.send(plan)
+            raw = box.recv(1, 1000.0, 20.0, -1, 10.0)
+            assert np.frombuffer(raw, dtype="<i8").tolist() == plan
+        l0.close()
+        l1.close()
+    finally:
+        torch.cuda.synchronize()
+        rt.close()
