+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16 ``TF_DSV41_MHC_PF`` (the prefill segment's mHC site in CUDA, ``mhc_pf.cu``) on the CPU:
+
+- placement (``tests/dsv41_mhc_pf_emu.py``): a CTA's phase A items cover its 16 rows x 128 columns once; its
+  chains are every (row, stream, kind 0-24) once plus the collapsed row's (stream 0) once; every global output of a
+  segment (new streams, collapsed row, taps, every PART entry Triton's ``_site`` writes) is stored exactly once, the
+  tile tail included;
+- arithmetic: the emulated kernel == ``tests/dsv41_kref.py``'s ``mhc_boundary`` (the model Triton's ``_site`` is
+  tested against) bit for bit: boundary with / without taps, site from stream 0, site with a carried pre-mix; fn
+  bf16 and fp32; gathered partials bf16 and fp32; 2 ranks;
+- the gate: off by default, the row floor, post_only / final / CPU tensors fall back to Triton (``why_not``), and the
+  Triton results do not change with the knob on;
+- sm_121 compile (nvcc, ``-DDSV41_MHC_PF_NO_TORCH``): every instance, 0 spills, the registers printed ``[G16]``.
+
+Run: python -m pytest -q tests/test_dsv41_mhc_pf.py
+"""
+
+from __future__ import annotations
+
+import glob
+import os
+import re
+import shutil
+import subprocess
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+
+import dsv41_kref as KR  # noqa: E402
+import dsv41_mhc_pf_emu as EMU  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import mhc_pf as MP  # noqa: E402
+
+D = 5120
+
+
+def test_items_and_chains_cover_a_cta_once():
+    seen = np.zeros((EMU.BM, D // EMU.NB // 8), dtype=np.int32)
+    for t in range(EMU.NT):
+        for rl, q in EMU.items(t, D):
+            seen[rl, q] += 1
+    assert (seen == 1).all()
+    kinds = np.zeros((EMU.BM, 4, 26), dtype=np.int32)
+    most = 0
+    for t in range(EMU.NT):
+        rl, j, ks = EMU.chains(t)
+        most = max(most, len(ks))
+        for k in ks:
+            kinds[rl, j, k] += 1
+    assert (kinds[:, :, :25] == 1).all()
+    assert (kinds[:, 0, 25] == 1).all() and (kinds[:, 1:, 25] == 0).all()
+    assert most == 13                                   # mhc_pf.cu's NS
+
+
+def _case(R: int, world: int, seed: int, fn16: bool, g16: bool):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn((R, 4 * D), generator=g).to(torch.bfloat16)
+    gathered = (torch.randn((world, R, D), generator=g) * 0.7).to(torch.bfloat16)
+    gathered = gathered if g16 else gathered.float()
+    comb = torch.rand((R, 4, 4), generator=g)
+    comb = (comb / comb.sum(1, keepdim=True)).reshape(R, 16).contiguous()
+    pre = torch.rand((R, 4), generator=g) + 0.1
+    post = torch.rand((R, 4), generator=g) * 2
+    fn = torch.randn((24, 4 * D), generator=g) * 0.01
+    fn = fn.to(torch.bfloat16) if fn16 else fn
+    return x, gathered, post, comb, pre, fn
+
+
+def _f(t):
+    return None if t is None else t.float().numpy()
+
+
+@pytest.mark.parametrize("mode,fn16,g16,tap", [("boundary", True, True, False), ("boundary", False, False, True),
+                                                ("site1", True, True, False), ("site2", False, True, False)])
+def test_emulated_kernel_equals_the_reference(mode, fn16, g16, tap):
+    R = 37                                              # 2 full tiles and a tail of 5
+    x, gathered, post, comb, pre, fn = _case(R, 2, {"boundary": 1, "site1": 2, "site2": 3}[mode], fn16, g16)
+    post_on = mode == "boundary"
+    collapse = 1 if mode == "site1" else 2
+    got = EMU.emulate(_f(x), _f(gathered) if post_on else None, _f(post), _f(comb), _f(pre), _f(fn),
+                      post_on=post_on, collapse=collapse, tap=tap)
+    want = KR.mhc_boundary(x, gathered if post_on else None, post if post_on else None, comb if post_on else None,
+                           pre if collapse == 2 else None, collapse, fn.float(), EMU.NB)
+    w = got["writes"]
+    if post_on:
+        assert (w["x"] == 1).all()
+        assert np.array_equal(got["x"].view(np.uint32), want["x"].float().numpy().view(np.uint32))
+    assert (w["c"] == 1).all()
+    assert np.array_equal(got["c"].view(np.uint32), want["c"].float().numpy().view(np.uint32))
+    if tap:
+        assert (w["tap"] == 1).all()
+        assert np.array_equal(got["tap"].view(np.uint32), want["tap"].float().numpy().view(np.uint32))
+    defined = np.zeros((R, 4, EMU.NB, 32), dtype=bool)
+    defined[..., :25] = True
+    defined[:, 0, :, 25] = True                         # what Triton's _site stores (the finish reads no more)
+    assert (w["part"][defined] == 1).all() and (w["part"][~defined] == 0).all()
+    assert np.array_equal(got["part"][defined].view(np.uint32), want["part"].numpy()[defined].view(np.uint32))
+
+
+def test_the_gate(monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda import mhc
+
+    monkeypatch.delenv("TF_DSV41_MHC_PF", raising=False)
+    assert not MP.enabled()
+    x = torch.zeros((300, 4 * D), dtype=torch.bfloat16)
+    sc = mhc.Scratch(300, "cpu")
+    hc = mhc.Hc(torch.zeros((24, 4 * D)), torch.zeros(24), torch.ones(3))
+    args = (x, x, torch.zeros((2, 300, D), dtype=torch.bfloat16), mhc.Coefs(300, "cpu"), torch.zeros((300, 4)), hc,
+            sc, None)
+    assert MP.why_not(300, *args, True, 2, True) == "off"
+    monkeypatch.setenv("TF_DSV41_MHC_PF", "1")
+    assert MP.why_not(255, *args, True, 2, True) == "rows"
+    assert MP.why_not(300, *args, True, 0, False) == "kind"         # post_only
+    assert MP.why_not(300, *args, True, 2, False) == "kind"         # final
+    assert MP.why_not(300, *args, True, 2, True) == "device or shape"
+    assert not MP.run(*args[:7], None, 300, True, 2, True)
+    monkeypatch.setenv("TF_DSV41_MHC_PF_ROWS", "8")
+    with pytest.raises(ValueError):
+        MP.min_rows()
+
+
+# -- sm_121 compile -------------------------------------------------------------------------------------------------
+CU = Path(MP.__file__).with_name("mhc_pf.cu")
+
+
+def _nvcc() -> str | None:
+    for cand in (os.environ.get("TF_NVCC"), shutil.which("nvcc"),
+                 os.path.join(os.environ.get("CUDA_HOME", "/usr/local/cuda"), "bin", "nvcc")):
+        if cand and os.path.exists(cand):
+            try:
+                archs = subprocess.run([cand, "--list-gpu-arch"], capture_output=True, text=True, timeout=60,
+                                       check=False).stdout
+            except (OSError, subprocess.SubprocessError):
+                continue
+            if "compute_121" in archs:
+                return cand
+    return None
+
+
+def _cuobjdump() -> str | None:
+    cands = [os.environ.get("TF_CUOBJDUMP"), shutil.which("cuobjdump")]
+    try:
+        import triton
+
+        cands += glob.glob(str(Path(triton.__file__).parent / "backends" / "nvidia" / "bin" / "cuobjdump"))
+    except ImportError:
+        pass
+    return next((c for c in cands if c and os.path.exists(c)), None)
+
+
+@pytest.mark.skipif(_nvcc() is None, reason="no nvcc with compute_121 (TF_NVCC)")
+def test_sm121_compile_no_spills(tmp_path):
+    cubin = tmp_path / "mhc_pf.cubin"
+    out = subprocess.run([_nvcc(), "-std=c++17", "-O3", "--fmad=false", "-DDSV41_MHC_PF_NO_TORCH",
+                          "-gencode=arch=compute_121,code=sm_121", "-Xptxas", "-v", "-cubin", str(CU), "-o",
+                          str(cubin)], capture_output=True, text=True, timeout=1800, check=False)
+    assert out.returncode == 0, out.stderr[-3000:]
+    funcs = re.findall(r"Compiling entry function '(\w+)'", out.stderr)
+    regs = [int(v) for v in re.findall(r"Used (\d+) registers", out.stderr)]
+    spills = re.findall(r"(\d+) bytes spill stores, (\d+) bytes spill loads", out.stderr)
+    assert len(funcs) == 8 and len(regs) == 8, out.stderr[-2000:]
+    assert all(s == ("0", "0") for s in spills), spills
+    assert max(regs) <= 255                             # launch bounds (128, 2)
+    print(f"[G16] mhc_pf sm_121: {len(funcs)} kernels, registers {min(regs)}-{max(regs)}, 0 spills")
+    dump = _cuobjdump()
+    if dump is None:
+        return
+    sass = subprocess.run([dump, "-sass", str(cubin)], capture_output=True, text=True, timeout=300, check=False).stdout
+    assert "LDL" not in sass and "STL" not in sass       # no local memory
+    assert "FFMA" in sass and "F2F.BF16.F32" in sass     # the chains, the bf16 roundings (cvt.rn.bf16.f32)
