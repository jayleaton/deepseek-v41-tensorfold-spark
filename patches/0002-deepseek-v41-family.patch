index 0000000..6e55b00
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/kbench.py
@@ -0,0 +1,256 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Window G1's expert bench on one GPU: a real layer's routed + shared experts (this rank's half, from the
+checkpoint), upstream's grouped EXL3 kernel against our 0580 load path (``x3ld``) at verify widths R = 1-16:
+
+- bitwise: the layer's output with ``TF_DSV41_EXPERT_LOADS`` on == off, every R and every load setting;
+- speed: ms and GB/s of trellis bytes read (the distinct experts the router picked + the shared entry);
+- the load path alone (probe 3: no decode, no mma) on the gate/up launch: the 0580 gate is >= 220 GB/s.
+
+    python -m tensorfold.families.deepseek_v41.cuda.kbench --model DIR [--layer 3] [--rank 0] [--out kbench.json]
+    ... kbench --model DIR --chunk 2048       a 2,048-row window through GpuMoE (row blocks) == 128-row windows
+
+Rows come from the real router on random activations (the bench's U(R) is the router's, not uniform picks).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+ROWS = (1, 2, 4, 6, 8, 12, 16)
+PF_ROWS = (16, 64, 128, 256, 512, 768, 1024)      # upstream's group_kernel cannot launch at 2,048 x 7 picks (G1)
+PROBE_GATE = 220.0
+
+
+def _time(fn, iters: int) -> float:
+    import torch
+
+    for _ in range(3):
+        fn()
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(iters):
+        fn()
+    b.record()
+    torch.cuda.synchronize()
+    return a.elapsed_time(b) / iters
+
+
+def bench(model: str, layer: int, rank: int, iters: int, rows=ROWS) -> dict:
+    import torch
+
+    from . import blocks as B
+    from . import expert_loads as loads
+    from . import experts as X
+    from . import router
+    from . import weights as W
+    from .config import Config
+
+    torch.cuda.set_device(0)
+    cfg = Config.from_file(Path(model) / "config.json")
+    ld = W.Loader(cfg, W.Shards(model), rank, 2, "cuda")
+    m = ld.moe(layer, f"layers.{layer}")
+    block = B.gpu_experts(cfg, m, layer, 2, "cuda")
+    ex = block.ex
+    plan_k2 = {w: [int(v) for v in getattr(ex, f"{n}_k2").tolist()] for w, n in (("w1", "gate"), ("w3", "up"),
+                                                                                 ("w2", "down"))}
+    plan = X.LayerPlan(block.geom, plan_k2)
+    s = X.scratch(block, max(rows))
+    _, topk = cfg.experts_of(layer)
+    gen = torch.Generator(device="cuda").manual_seed(layer)
+    out: dict = {"layer": layer, "rank": rank, "k2_gu": list(ex.k2_gu), "k2_d": list(ex.k2_d), "rows": {}}
+    saved = dict(loads.CFG)
+    try:
+        for R in rows:
+            x = (torch.randn((R, cfg.hidden_size), generator=gen, device="cuda") * 0.5).to(torch.bfloat16)
+            pick, wts = router.route(x, m.gate, m.bias, topk=topk, shared=True, scale=cfg.routed_scaling_factor)
+            distinct = sorted(set(pick[:, :topk].reshape(-1).tolist()))
+            nbytes = sum(plan.entry_bytes(e) for e in distinct) + sum(
+                plan.entry_bytes(e) for e in range(block.geom.experts, block.geom.table))
+
+            def call():
+                return X.routed(x, pick, wts, block, s, None, R, limit=cfg.swiglu_limit)
+
+            loads.CFG.update(on=False)
+            ref = call().clone()
+            ms_up = _time(call, iters)
+            row = {"distinct": len(distinct), "bytes": nbytes, "upstream_ms": round(ms_up, 4),
+                   "upstream_gbps": round(nbytes / ms_up / 1e6, 1), "x3ld": {}}
+            for cfg_ld in loads.CFGS:
+                loads.CFG.update(on=True, gu=cfg_ld, dn=cfg_ld)
+                got = call().clone()
+                ms = _time(call, iters)
+                row["x3ld"][f"{cfg_ld[0]},{cfg_ld[1]}"] = {"bitwise": bool(torch.equal(got, ref)), "ms": round(ms, 4),
+                                                         "gbps": round(nbytes / ms / 1e6, 1)}
+            row["probe3_gu_gbps"] = probe3(block, s, x, pick, R, plan, distinct, iters)
+            out["rows"][R] = row
+            print(f"R={R}: {len(distinct)} experts, upstream {row['upstream_gbps']} GB/s, x3ld "
+                  + ", ".join(f"{k} {v['gbps']} GB/s {'==' if v['bitwise'] else 'DIFFERS'}"
+                              for k, v in row["x3ld"].items()) + f", probe 3 {row['probe3_gu_gbps']} GB/s",
+                  flush=True)
+    finally:
+        loads.CFG.clear()
+        loads.CFG.update(saved)
+    out["bitwise"] = all(v["bitwise"] for r in out["rows"].values() for v in r["x3ld"].values())
+    best = max((r["probe3_gu_gbps"] or 0) for r in out["rows"].values())
+    out["probe3_best_gbps"] = best
+    out["pass"] = out["bitwise"] and best >= PROBE_GATE
+    return out
+
+
+def bench_prefill(model: str, layer: int, rank: int, iters: int, rows=PF_ROWS) -> dict:
+    """x3pf (``expert_prefill``) against upstream's grouped kernel on the real layer: the layer's output bit for bit
+    and ms a call at prefill widths (router picks on random activations)."""
+
+    import torch
+
+    from . import blocks as B
+    from . import expert_loads as loads
+    from . import expert_prefill as PF
+    from . import experts as X
+    from . import router
+    from . import weights as W
+    from .config import Config
+
+    torch.cuda.set_device(0)
+    cfg = Config.from_file(Path(model) / "config.json")
+    m = W.Loader(cfg, W.Shards(model), rank, 2, "cuda").moe(layer, f"layers.{layer}")
+    block = B.gpu_experts(cfg, m, layer, 2, "cuda")
+    _, topk = cfg.experts_of(layer)
+    gen = torch.Generator(device="cuda").manual_seed(100 + layer)
+    out: dict = {"layer": layer, "rank": rank, "k2_gu": list(block.ex.k2_gu), "k2_d": list(block.ex.k2_d), "rows": {}}
+    saved_l, saved_p = dict(loads.CFG), dict(PF.CFG)
+    try:
+        loads.CFG.update(on=False)
+        for R in rows:
+            x = (torch.randn((R, cfg.hidden_size), generator=gen, device="cuda") * 0.5).to(torch.bfloat16)
+            pick, wts = router.route(x, m.gate, m.bias, topk=topk, shared=True, scale=cfg.routed_scaling_factor)
+            s = X.scratch(block, R)         # a scratch a width (G1: 1,024 rows failed to group in a 2,048-row one)
+
+            def call():
+                return X.routed(x, pick, wts, block, s, None, R, limit=cfg.swiglu_limit)
+
+            PF.CFG.update(on=False)
+            ref = call().clone()
+            ms_up = _time(call, iters)
+            row = {"upstream_ms": round(ms_up, 4), "x3pf": {}}
+            for c in PF.CFGS:
+                PF.CFG.update(on=True, gu=c, dn=c, rows=1)
+                got = call().clone()
+                ms = _time(call, iters)
+                row["x3pf"][f"{c[0]},{c[1]}"] = {"bitwise": bool(torch.equal(got, ref)), "ms": round(ms, 4),
+                                                 "speedup": round(ms_up / ms, 3)}
+            out["rows"][R] = row
+            print(f"x3pf R={R}: upstream {ms_up:.3f} ms, " + ", ".join(
+                f"{k} {v['ms']:.3f} ms x{v['speedup']} {'==' if v['bitwise'] else 'DIFFERS'}"
+                for k, v in row["x3pf"].items()), flush=True)
+    finally:
+        loads.CFG.clear()
+        loads.CFG.update(saved_l)
+        PF.CFG.clear()
+        PF.CFG.update(saved_p)
+    out["bitwise"] = all(v["bitwise"] for r in out["rows"].values() for v in r["x3pf"].values())
+    return out
+
+
+def bench_chunk(model: str, layer: int, rank: int, rows: int = 2048, window: int = 128) -> dict:
+    """A ``rows``-row prefill window through ``moe.GpuMoE`` (expert passes of ``moe.expert_block`` rows: upstream's
+    ``group`` takes 1,750 at 7 picks) == the same rows in ``window``-row windows, bit for bit, on the real layer."""
+
+    import time
+
+    import torch
+
+    from . import blocks as B
+    from . import moe as M
+    from . import weights as W
+    from .config import Config
+
+    torch.cuda.set_device(0)
+    cfg = Config.from_file(Path(model) / "config.json")
+    m = W.Loader(cfg, W.Shards(model), rank, 2, "cuda").moe(layer, f"layers.{layer}")
+    _, topk = cfg.experts_of(layer)
+    moe = M.GpuMoE(m.gate, m.bias, B.gpu_experts(cfg, m, layer, 2, "cuda"), topk, cfg.routed_scaling_factor,
+                   cfg.swiglu_limit)
+    gen = torch.Generator(device="cuda").manual_seed(200 + layer)
+    x = (torch.randn((rows, cfg.hidden_size), generator=gen, device="cuda") * 0.5).to(torch.bfloat16)
+    torch.cuda.synchronize()
+    t = time.perf_counter()
+    whole = moe(x).clone()
+    torch.cuda.synchronize()
+    ms = (time.perf_counter() - t) * 1e3
+    parts = torch.cat([moe(x[a:a + window]).clone() for a in range(0, rows, window)])
+    out = {"layer": layer, "rank": rank, "rows": rows, "block": M.expert_block(moe.block.geom.slots),
+           "scratch_rows": moe.scratch.rows, "ms": round(ms, 2), "bitwise": bool(torch.equal(whole, parts)),
+           "peak_alloc_gib": round(torch.cuda.max_memory_allocated() / 2 ** 30, 2)}
+    print(f"chunk {rows} rows (expert passes of {out['block']}): {ms:.1f} ms, "
+          f"{'==' if out['bitwise'] else 'DIFFERS FROM'} {window}-row windows", flush=True)
+    return out
+
+
+def probe3(block, s, x, pick, R: int, plan, distinct, iters: int) -> float | None:
+    """The gate/up launch through x3ld's load path alone (probe 3), GB/s of gate + up trellis bytes."""
+
+    from tensorfold.cuda.exl3 import experts as x3
+
+    from . import expert_loads as loads
+
+    ex = block.ex
+    ext = x3._ext()
+    ids, members = s.window(R)
+    ext.group(pick, ids, s.count, members, R, s.slots, ex.count)
+    ext.rot_in(x, x.stride(0), pick, ex.suh_g, ex.suh_u, s.xg, s.xu, R, ex.dims, s.slots, ex.count)
+    nt, w, sk, pf = s.cfg_gu
+    cfg = loads.PROBE_CFGS[0]
+    if not loads.fits(ex.dims, ex.width, sk, w, cfg):
+        return None
+    gu_bytes = sum(ex.dims * ex.width // 256 * 16 * (plan.k2["w1"][e] + plan.k2["w3"][e])
+                   for e in [*distinct, *range(block.geom.experts, block.geom.table)])
+
+    def call():
+        loads.grouped(s.xg, s.xu, ex.gate_ptr, ex.up_ptr, ex.gate_k2, ex.up_k2, ids, s.count, members, s.z, 2,
+                      ex.dims, ex.width, R * s.slots, sk, s.slots, ex.cb, w, ex.k2_gu[0], ex.k2_gu[1], probe=3,
+                      cfg=cfg)
+
+    ms = _time(call, iters)
+    return round(gu_bytes / ms / 1e6, 1)
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--layer", type=int, default=3)
+    ap.add_argument("--rank", type=int, default=0)
+    ap.add_argument("--iters", type=int, default=50)
+    ap.add_argument("--out", default="")
+    ap.add_argument("--prefill", action="store_true", help="x3pf vs upstream at prefill widths (16-2,048 rows)")
+    ap.add_argument("--chunk", type=int, default=0, help="a CHUNK-row window through GpuMoE == 128-row windows")
+    a = ap.parse_args(argv)
+    if a.chunk:
+        rep = bench_chunk(a.model, a.layer, a.rank, a.chunk)
+        if a.out:
+            Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+            Path(a.out).write_text(json.dumps(rep, indent=1))
+        print(json.dumps(rep), flush=True)
+        return 0 if rep["bitwise"] else 1
+    if a.prefill:
+        rep = bench_prefill(a.model, a.layer, a.rank, max(3, a.iters // 5))
+        if a.out:
+            Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+            Path(a.out).write_text(json.dumps(rep, indent=1))
+        print(json.dumps({k: v for k, v in rep.items() if k != "rows"}), flush=True)
+        return 0 if rep["bitwise"] else 1
+    rep = bench(a.model, a.layer, a.rank, a.iters)
+    if a.out:
+        Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+        Path(a.out).write_text(json.dumps(rep, indent=1))
+    print(json.dumps({k: v for k, v in rep.items() if k != "rows"}), flush=True)
+    return 0 if rep["pass"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
