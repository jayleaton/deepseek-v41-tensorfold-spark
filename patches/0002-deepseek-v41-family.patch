+++ b/src/tensorfold/families/deepseek_v41/cuda/batch.py
@@ -0,0 +1,704 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The V4.1 Batcher (``--parallel`` slots on one engine): GLM's batcher protocol (``glm5_next/spark/batch.py``: a job
+queue, rank 0 plans each round and shares it, both ranks execute, cancellation by plan, tokens back through each
+job's queue) driving the V4.1 ``Forward`` (``protocol.py``).
+
+A round (rank 0, ``step``): plan (``_plan``), share (``Link.send``), execute (``rounds.Executor``), sample and emit
+(``_sample``). Rank 1 runs ``follow``: receive, execute. The plan carries everything rank 1 needs (``plan.py``).
+
+- **Admission**: foreground before background, FIFO; a request needs a free slot, its pool pages (prompt +
+  max_tokens + slack, GLM ``kvpool.need_tokens``; a RAM session hit's full pages are shared, not new), and the
+  memory floor (``memory.Floor``, GLM 0550's ``memsafe``). When the pool is short, the coldest session entries are
+  parked to NVMe (or dropped) first (``Store.plan_spill``, GLM ``batchplan.pool_spills``). A prompt resumes from the
+  longest stored prefix (RAM or NVMe, ``sessions.Store.find``). Long prefills are staggered: a prompt with more
+  than ``TF_DSV41_LONG_PROMPT`` (32,768) tokens to prefill waits in the queue while ``TF_DSV41_PREFILL_CONCURRENT``
+  (1; 0 = no limit) such prompts are admitted and not yet decoding; shorter prompts behind it admit as before (G4's
+  stress: four long prompts admitted together dipped the worker under 5 GiB). Like every admission decision it is
+  rank 0's, from its queue and slots, and travels in the plan: rank 1 never decides.
+- **Prefill**: pieces on the 16-token grid, ``TF_DSV41_PREFILL_ROWS`` rows a round shared by the prefilling slots
+  (GLM 0560 multi-slot prefill: one ``Forward.prefill`` over every slot's piece); one piece ends at the replay point
+  (a prompt snapshot there, GLM 0540); decoding slots run every round beside the pieces.
+- **Decode**: one ``Forward.window`` over every decoding slot (batched == alone: row-invariant kernels); DSpark
+  drafts of ``TF_DSV41_DRAFT_DEPTH`` when the forward drafts (``Forward.draft``) and the request allows;
+  tokens chosen by ``exact_sampling.choose_rows`` keyed by (seed, position, id), kept up to the first draft that
+  differs (``drafting.accepted``): drafted == serial, batched == alone.
+- **Structured output**: the request's grammar (GLM 0610 ``Grammars`` / ``Constraint``; DSML tools through
+  ``structured.py``) cuts each window and masks its rows on both ranks.
+- **Cancellation** (GLM 0600): ``on_tokens`` returning True, or ``on_tokens.cancelled()`` turning true while the
+  request waits, prefills or decodes, ends it at the next plan (no snapshot of a cancelled turn).
+- **Memory** (G16's two holes, fixed): admission prices each prompt's prefill transient (``memory.prefill_price``:
+  the window's buffers, the indexer's row blocks below 32K positions, host) and checks it, plus what admitted prompts
+  have not materialised yet (``Price.outstanding``), against BOTH ranks' usable memory (rank 1's from its fate-channel
+  reports, ``failfast``) and the hard floor. A prompt that does not fit waits (FIFO, as before); only when nothing is
+  live and it has waited ``TF_DSV41_FLOOR_REFUSE_S`` (30 s) and still cannot fit is it refused (503, the numbers).
+- **Failures** (``failfast``, ``TF_DSV41_FAILFAST``=1): an exception in a round's execution or the plan link on
+  either rank ends the pair (every request 500, exit 70 on both ranks within ~1 s); one while rank 0 plans or samples
+  fails the requests concerned and serving goes on (nothing of it was shared).
+"""
+
+from __future__ import annotations
+
+import collections
+import itertools
+import os
+import queue
+import threading
+import time
+import traceback
+from collections.abc import Callable, Sequence
+from dataclasses import dataclass, field
+from typing import Any
+
+import numpy as np
+
+from tensorfold.engine.exact_sampling import MARGIN, choose_rows
+from tensorfold.families.glm5_next.spark.batchplan import Fairness
+
+from . import nucleus as NU
+from .lookup import Planner, noise_of
+from .phases import PH
+from .plan import Admit, Plan, WindowSpec, piece_end
+from .pool import PAGE, Pool
+from .protocol import GRID, LocalLink, accepted, check_forward
+from .rounds import Executor, take_rows
+from .sessions import snapshot_point
+
+_ids = itertools.count(1)
+
+
+def _env_int(name: str, default: int) -> int:
+    raw = os.environ.get(name, "").strip()
+    return int(raw) if raw else default
+
+
+@dataclass
+class Job:
+    prompt: list[int]
+    max_tokens: int
+    sampling: Any = None                       # exact_sampling.Sampling, None = greedy
+    stop_eos: bool = True
+    draft: bool = True
+    grammar: Any = None                        # GLM grammar.Bound
+    background: bool = False
+    out: queue.SimpleQueue = field(default_factory=queue.SimpleQueue)
+    cancel: bool = False
+    id: int = field(default_factory=lambda: next(_ids))
+    submitted: float = field(default_factory=time.monotonic)
+    stats: dict = field(default_factory=dict)
+
+
+@dataclass
+class Seq:
+    job: Job
+    slot: int
+    done: int                                  # prompt tokens in the slot's state (prefill progress)
+    save_at: int | None                        # the replay point still to snapshot at
+    pos: int = 0                               # decode: the pending token's position
+    pending: int = 0
+    decoding: bool = False
+    out: list[int] = field(default_factory=list)
+    t0: float = field(default_factory=time.monotonic)
+    plan: Any = None                           # lookup.Request: the request's drafting state (rank 0)
+    long: bool = False                         # a long prefill (``Batcher.long_prompt``): staggered admission
+    price: Any = None                          # ``memory.Price``: its prefill transient (the floor's reservation)
+
+    @property
+    def stepper(self):
+        """GLM health's view: not None while decoding (``/health``'s decoding / prefilling counts)."""
+
+        return self if self.decoding else None
+
+
+class Batcher:
+    def __init__(self, fwd, pool: Pool, *, n_slots: int = 4, capacity: int, eos: Sequence[int] = (1,), store=None,
+                 link=None, rank: int = 0, grammars=None, floor=None, mode: str = "full", tag: int = 0,
+                 prefill_rows: int | None = None, depth: int | None = None, session_min: int = 64,
+                 poll_s: float = 0.05, start: bool = True, long_prompt: int | None = None,
+                 prefill_concurrent: int | None = None) -> None:
+        check_forward(fwd)
+        self.fwd = fwd
+        self.n = int(n_slots)
+        self.capacity = int(capacity)
+        self.eos = frozenset(int(t) for t in eos)
+        self.store, self.pool, self.kvp = store, pool, pool
+        self.link = link or LocalLink()
+        self.rank = rank
+        self.floor = floor
+        self.mode, self.tag = mode, int(tag)
+        # rows of prompt a round (default: the forward's prefill segment, so a round is one expert pass)
+        self.prefill_rows = prefill_rows or _env_int("TF_DSV41_PREFILL_ROWS", max(2048, getattr(fwd, "pchunk", 0)))
+        if prefill_rows is None and self.prefill_rows > 2048:      # G16 4K: rounds above 2,048 rows need the ack
+            from . import pf4k
+
+            pf4k.check(pchunk=getattr(fwd, "pchunk", None))
+        can_draft = callable(getattr(fwd, "draft", None))
+        from .depth import env_mode
+
+        self.depth = (env_mode()[1] if depth is None else int(depth)) if can_draft else 0
+        # M2 (``lookup.Planner``): suffix lookup drafts, DSpark depth caps, the keyed draft noise (rank 0's plan)
+        self.planner = Planner(getattr(fwd, "costs", None), dspark=self.depth > 0, cap=self.depth, eos=self.eos)
+        # top-p without top-k from TF_DSV41_NUCLEUS candidates a row when the forward supports it (``nucleus.py``)
+        self.nucleus = NU.candidates() if getattr(fwd, "nucleus", False) else 0
+        dl = getattr(fwd, "dlog", None)
+        self.log_topk = int(dl.topk) if dl is not None else 0      # more candidates fetched: the same choices
+        self.poll_s = poll_s
+        # GLM 0120 / 0200: prefill pieces take at most this share of the time while others decode; prompts with at
+        # most ``short`` tokens left go at once
+        self.fair = Fairness(float(os.environ.get("TF_DSV41_PREFILL_SHARE", "") or 0.5))
+        self.short = _env_int("TF_DSV41_BATCH_SHORT", 512)
+        # staggered long prefills: at most ``prefill_concurrent`` prompts with more than ``long_prompt`` tokens to
+        # prefill admitted and not yet decoding (0: no limit)
+        self.long_prompt = _env_int("TF_DSV41_LONG_PROMPT", 32768) if long_prompt is None else int(long_prompt)
+        self.prefill_concurrent = (_env_int("TF_DSV41_PREFILL_CONCURRENT", 1) if prefill_concurrent is None
+                                   else int(prefill_concurrent))
+        if self.long_prompt < 1 or self.prefill_concurrent < 0:
+            raise ValueError(f"TF_DSV41_LONG_PROMPT={self.long_prompt} (>= 1) / TF_DSV41_PREFILL_CONCURRENT="
+                             f"{self.prefill_concurrent} (>= 0)")
+        self.ex = Executor(fwd, pool, self.n, capacity, store=store, grammars=grammars, tag=tag, mode=mode,
+                           rank=rank, session_min=session_min)
+        from .stall import Watch
+
+        # G12: a round past TF_DSV41_STALL_S is reported (phase, plan, the forward's waits, every thread's stack)
+        self.watch = Watch(rank, info=self._stall_info)
+        self.ex.watch = self.watch
+        self._plan_now: Plan | None = None
+        self.queue: collections.deque[Job] = collections.deque()
+        self.cv = threading.Condition()
+        self.seqs: list[Seq | None] = [None] * self.n
+        self.commits: list[tuple[int, int, int]] = []
+        self.finishes: list[tuple[int, bool, bool]] = []
+        self.rounds = 0
+        self.stopping = False
+        self.in_round = False
+        self.counts = collections.Counter()
+        self.thread = None
+        self.fate = None                       # ``failfast.Fate`` (the engine attaches it; None: the old behaviour)
+        self.dead: str | None = None           # set when the pair goes down: new requests get a 503
+        from . import failfast
+
+        self.ex.inject = failfast.Inject.from_env(rank)        # TF_DSV41_FAILFAST_INJECT (the GPU test plan's hook)
+        from . import memory
+
+        # G19 adaptive prefill rows (``memory.Adapt``): rank 0 picks each round's rows from the tighter rank's memory
+        self.adapt = memory.Adapt.from_env() if floor is not None else None
+        if self.adapt is not None and not self.adapt.on:
+            self.adapt = None
+        self.rows_now: int | None = None       # the rows of the last prefill round (adaptive rows)
+        if rank == 0 and start:
+            self.begin()
+
+    def begin(self) -> None:
+        """Rank 0: start the round thread (the engine calls it once its own boot exchanges are done: the thread
+        shares the communicator)."""
+
+        self.thread = threading.Thread(target=self._serve, name="dsv41-batch", daemon=True)
+        self.thread.start()
+
+    # -- the request side (HTTP threads, rank 0) -------------------------------------------------------------------
+    def submit(self, job: Job) -> Job:
+        if self.dead is not None:
+            from tensorfold.server.errors import CapacityError
+
+            raise CapacityError(f"the server is restarting after a failure ({self.dead}); retry shortly")
+        n = len(job.prompt)
+        if n < 1:
+            raise ValueError("an empty prompt")
+        if n + max(job.max_tokens, 1) > self.capacity:
+            raise ValueError(f"prompt {n} + max_tokens {job.max_tokens} is past the slot capacity {self.capacity}")
+        with self.cv:
+            self.queue.append(job)
+            self.cv.notify_all()
+        return job
+
+    def cancel(self, job: Job) -> None:
+        with self.cv:
+            job.cancel = True
+            self.cv.notify_all()
+
+    def generate(self, prompt: list[int], max_tokens: int, sampling, on_tokens: Callable[[list[int]], bool],
+                 draft: bool = True, *, grammar=None, stop_eos: bool = True, background: bool = False) -> dict:
+        job = self.submit(Job(list(prompt), int(max_tokens), sampling, stop_eos, draft, grammar, background))
+        return self.collect(job, on_tokens)
+
+    def generate_request(self, prompt: list[int], max_tokens: int, sampling, on_tokens, draft: bool = True, *,
+                         request=None, host=None) -> dict:
+        """The body of the engine's ``generate`` (M1's ``Dsv41Engine``): the app's per-thread fields
+        (``engine.request``: stop_eos, grammar as (spec, compiled), background) applied; ``host``:
+        ``structured.Host``."""
+
+        grammar = host.bind(getattr(request, "grammar", None), prompt) if host is not None else None
+        return self.generate(prompt, max_tokens, sampling, on_tokens, draft, grammar=grammar,
+                             stop_eos=getattr(request, "stop_eos", True),
+                             background=bool(getattr(request, "background", False)))
+
+    def collect(self, job: Job, on_tokens: Callable[[list[int]], bool]) -> dict:
+        """Tokens to ``on_tokens`` until the job ends; its stats. Raises the job's failure (ValueError: the client's)."""
+
+        gone = getattr(on_tokens, "cancelled", None)
+        while True:
+            try:
+                item = job.out.get(timeout=self.poll_s)
+            except queue.Empty:
+                if gone is not None and not job.cancel and gone():
+                    self.cancel(job)
+                continue
+            if item is None:
+                return dict(job.stats)
+            if isinstance(item, BaseException):
+                raise item
+            try:
+                stop = on_tokens(item)
+            except BaseException:
+                self.cancel(job)
+                raise
+            if stop and not job.cancel:
+                self.cancel(job)
+
+    def stop(self) -> None:
+        with self.cv:
+            self.stopping = True
+            self.cv.notify_all()
+        if self.thread is not None:
+            self.thread.join(timeout=10)
+        self.watch.close()
+
+    # -- the round loop (rank 0) -----------------------------------------------------------------------------------
+    def _serve(self) -> None:
+        while not self.stopping and self.dead is None:
+            self.step(block=True)
+
+    def busy(self) -> bool:
+        return bool(self.in_round or self.queue or self.commits or self.finishes
+                    or any(s is not None for s in self.seqs))
+
+    def step(self, block: bool = False) -> bool:
+        """One round; False when there was nothing to do."""
+
+        with self.cv:
+            while block and not self.stopping and self.dead is None and not self._work():
+                self.cv.wait(timeout=0.5)
+            if self.dead is not None:
+                return False
+            t0 = time.perf_counter()
+            self.watch.begin(self.rounds, "plan")
+            try:
+                if self.ex.inject is not None:
+                    self.ex.inject(self.ex.rounds + 1, "plan")
+                with PH("plan"):
+                    plan = self._plan()
+            except Exception as exc:            # noqa: BLE001  nothing was shared: this round's requests fail
+                self.watch.end()
+                traceback.print_exc()
+                self._fail_all(exc)
+                self.rounds += 1
+                return True
+            if plan.empty():
+                self.watch.end()
+                return False
+            self.in_round = True
+        self._plan_now = plan
+        phase = "share"
+        try:
+            self.watch.phase("share")
+            with PH("share"):
+                self.link.send(plan.encode())
+            phase = "execute"
+            self.watch.phase("execute")
+            with PH("execute"):
+                res = self.ex.run(plan)
+            phase = "sample"
+            self.watch.phase("sample")
+            with PH("sample"):
+                self._sample(plan, res)
+            self.fair.after(res.piece_s, res.window_s,
+                            any(s is not None and not s.decoding for s in self.seqs))
+        except Exception as exc:                # noqa: BLE001
+            if self.fate is not None and phase != "sample":
+                # rank 1 executed (or waits inside) this plan: the ranks may be apart. The pair goes down now
+                # (``failfast``) instead of rank 1 waiting out an exchange and rank 0 the plan link
+                self.fate.fatal(exc, f"round {self.ex.rounds} ({phase}{self._where()})")
+                return True
+            traceback.print_exc()               # every running request fails; the loop goes on
+            self._fail_all(exc)
+        finally:
+            self.in_round = False
+            self.watch.end()
+            self._plan_now = None
+            if PH.on:
+                PH.add("round", time.perf_counter() - t0)
+        self.rounds += 1
+        return True
+
+    def _where(self) -> str:
+        return f": {self.ex.now}" if self.ex.now != "idle" else ""
+
+    def fail_everything(self, msg: str) -> None:
+        """The pair is going down (``failfast``, from any thread): every admitted and queued request ends with
+        ``RuntimeError(msg)`` (HTTP 500), new ones get a 503. The round thread may be stuck in an exchange holding
+        nothing; the lock is taken when it can be (planning holds it for milliseconds)."""
+
+        self.dead = msg
+        got = self.cv.acquire(timeout=2.0)
+        try:
+            jobs = [s.job for s in list(self.seqs) if s is not None]
+            try:
+                jobs += list(self.queue)
+            except RuntimeError:                # mutated meanwhile (no lock): the next look sees it
+                jobs += list(self.queue)
+            if got:
+                self.queue.clear()
+                self.cv.notify_all()
+        finally:
+            if got:
+                self.cv.release()
+        err = RuntimeError(msg)
+        for job in {id(j): j for j in jobs}.values():
+            job.stats.update(finish="failed")
+            job.out.put(err)
+
+    def _work(self) -> bool:
+        if self.commits or self.finishes:
+            return True
+        if any(s is not None for s in self.seqs):
+            return True
+        return bool(self.queue) and any(s is None for s in self.seqs)
+
+    def _plan(self) -> Plan:
+        plan = Plan(round=self.rounds, mode=self.mode)
+        plan.commits, self.commits = self.commits, []
+        plan.finishes, self.finishes = self.finishes, []
+        for s in self.seqs:                     # cancelled while running: no turn snapshot
+            if s is not None and s.job.cancel:
+                self._end(s, plan, cancelled=True)
+        for job in [j for j in self.queue if j.cancel]:
+            self.queue.remove(job)
+            job.stats.update(finish="cancelled", cached=0)
+            job.out.put(None)
+        self._admit(plan)
+        self._pieces(plan)
+        self._decode(plan)
+        return plan
+
+    def _admit(self, plan: Plan) -> None:
+        free = [i for i, s in enumerate(self.seqs) if s is None]
+        if not free or not self.queue:
+            return
+        order = sorted(self.queue, key=lambda j: (j.background, j.submitted))
+        new_pages = 0
+        used: list[str] = []
+        longs = sum(1 for s in self.seqs if s is not None and s.long and not s.decoding)
+        from . import memory
+
+        # what admitted prompts still prefilling have not materialised (``Price.outstanding``): reserved
+        owed = sum(s.price.outstanding(s.done) for s in self.seqs if s is not None and s.price is not None
+                   and not s.decoding)
+        for job in order:
+            if not free:
+                break
+            n = len(job.prompt)
+            tier, key, cached = "", "", 0
+            hit = self.store.find(job.prompt, self.tag) if self.store is not None else None
+            if hit is not None:
+                tier, key = hit
+                cached = self.store.length(tier, key)
+            long = n - cached > self.long_prompt
+            if long and self.prefill_concurrent and longs >= self.prefill_concurrent:
+                self.counts["long_waits"] += 1
+                continue                        # behind the long prefill in flight; shorter prompts still go
+            price = None
+            if self.floor is not None:
+                price = memory.prefill_price(n, cached, rows=self._price_rows())
+                if not self.floor.check(owed + price.total, queued=len(self.queue)):
+                    self.counts["mem_waits"] += 1
+                    if self._never_fits(job, price, plan):
+                        continue
+                    break                       # FIFO: running requests end, prefills materialise, memory returns
+                job.stats.pop("mem_wait_since", None)
+            need = self.pool.need_pages(n, job.max_tokens, self.capacity)
+            shared = cached // PAGE if tier == "ram" else 0
+            want = need - shared + new_pages
+            if need > self.pool.npages:
+                self.queue.remove(job)
+                job.out.put(ValueError(f"the request needs {need} KV pool pages, the pool has {self.pool.npages}"))
+                continue
+            spills: list[str] | None = []
+            if self.pool.available() < want:
+                spills = self.store.plan_spill(want, keep=used + [key]) if self.store is not None else None
+                if spills is None or plan.spills:
+                    self.counts["pool_waits"] += 1
+                    break                       # running requests free pages as they end
+            plan.spills += spills
+            used.append(key)
+            longs += int(long)
+            new_pages = want
+            owed += price.total if price is not None else 0
+            slot = free.pop(0)
+            self.queue.remove(job)
+            from tensorfold.families.glm5_next.spark import grammar as gm
+
+            plan.admits.append(Admit(slot, list(job.prompt), job.max_tokens, tier, key, cached, need,
+                                     gm.pack(job.grammar) if job.grammar is not None else None, job.id))
+            s_at = snapshot_point(n)
+            save_at = s_at if self.store is not None and s_at > cached and s_at >= self.ex.session_min else None
+            self.seqs[slot] = Seq(job, slot, cached, save_at, plan=self.planner.start(job.prompt), long=long,
+                                  price=price)
+            job.stats.update(prompt=n, cached=cached, tier=tier or "none", slot=slot,
+                             wait_s=round(time.monotonic() - job.submitted, 4))
+
+    def _never_fits(self, job: Job, price, plan: Plan) -> bool:
+        """A prompt the floor holds back: refused (503) only when nothing is live (no request admitted, none admitted
+        this round) and it has waited ``floor.refuse_s`` while its price still exceeds the binding rank's usable
+        memory less the hard floor; otherwise it waits. -> True when refused (the caller looks at the next job)."""
+
+        if any(s is not None for s in self.seqs) or plan.admits:
+            job.stats.pop("mem_wait_since", None)
+            return False
+        since = job.stats.setdefault("mem_wait_since", time.monotonic())
+        if time.monotonic() - since < self.floor.refuse_s or self.floor.fits_idle(price.total):
+            return False
+        from tensorfold.server.errors import CapacityError
+
+        from .memory import GiB
+
+        rank, usable, _ = self.floor.last
+        self.queue.remove(job)
+        job.stats.pop("mem_wait_since", None)
+        self.counts["mem_refused"] += 1
+        msg = (f"the prompt's prefill needs ~{price.total / GiB:.2f} GiB (TF_DSV41_FLOOR_PF_*: {len(job.prompt)} tokens, "
+               f"{self.prefill_rows}-row windows) and rank {rank} has {usable / GiB:.2f} GiB usable with nothing else "
+               f"running, under the {self.floor.hard_gib:g} GiB hard floor (TF_DSV41_FLOOR_HARD_GIB) after "
+               f"{self.floor.refuse_s:g} s: it cannot fit on this server now")
+        print(f"[tensorfold] admission refused a request: {msg}", flush=True)
+        job.out.put(CapacityError(msg))
+        return True
+
+    def _pieces(self, plan: Plan) -> None:
+        """This round's prefill pieces: prompts with at most ``short`` tokens left always; the others, fewest tokens
+        left first, when the fair share allows (GLM ``batchplan.Fairness``), as many as the rows budget holds
+        (GLM 0560: several slots' pieces in one forward)."""
+
+        live = [s for s in self.seqs if s is not None and not s.job.cancel]
+        waiting = [s for s in live if not s.decoding and s.done < len(s.job.prompt) - 1]
+        allow = self.fair.allow(any(s.decoding for s in live))
+        budget = self._round_rows(waiting, plan) if waiting else self.prefill_rows
+        for s in sorted(waiting, key=lambda s: (len(s.job.prompt) - 1 - s.done, s.job.submitted)):
+            left = len(s.job.prompt) - 1 - s.done
+            if budget <= 0 or (left > self.short and not allow):
+                continue
+            target = s.save_at if s.save_at is not None and s.done < s.save_at else len(s.job.prompt) - 1
+            end = piece_end(s.done, target, budget, GRID)
+            plan.pieces.append((s.slot, s.done, end))
+            budget -= end - s.done
+            s.done = end
+            if s.save_at is not None and end == s.save_at:
+                plan.saves.append(s.slot)
+                s.save_at = None
+        for s in live:
+            last = len(s.job.prompt) - 1
+            if not s.decoding and s.done == last:
+                plan.finals.append(s.slot)
+                s.decoding, s.pos, s.pending = True, last, int(s.job.prompt[-1])
+
+    def _price_rows(self) -> int:
+        """The rows admission prices a prompt's transient at: the smallest adaptive step (the rounds drop to it
+        when memory is tight), else ``prefill_rows``."""
+
+        return self.adapt.steps(self.prefill_rows, GRID)[-1] if self.adapt is not None else self.prefill_rows
+
+    def _round_rows(self, waiting: list[Seq], plan: Plan) -> int:
+        """This round's prompt rows (G19, ``memory.Adapt``): ``prefill_rows`` while the tighter rank's usable memory
+        covers the round's priced transient (``memory.round_need``) with ``adapt.gib`` to spare, else a smaller step.
+        A step down sets ``plan.release`` (both ranks return torch's cached blocks of the larger rows). Rank 0's
+        decision; the pieces carry it to rank 1."""
+
+        if self.adapt is None:
+            return self.prefill_rows
+        from . import memory
+
+        left = [(len(s.job.prompt), s.done) for s in waiting]
+        try:
+            rank, usable = self.floor.tight()
+        except Exception:                       # noqa: BLE001 - accounting must never stop serving: the full rows
+            return self.prefill_rows
+        rows = self.adapt.choose(self.prefill_rows, usable, lambda r: memory.round_need(r, left), self.rows_now,
+                                 GRID)
+        if self.rows_now is not None and rows != self.rows_now:
+            self.counts["rows_down" if rows < self.rows_now else "rows_up"] += 1
+            if rows < self.rows_now and self.adapt.release:
+                plan.release = True
+            print(f"[tensorfold] prefill rows {self.rows_now} -> {rows} (rank {rank} usable "
+                  f"{usable / memory.GiB:.2f} GiB, the round's transient at {rows} rows "
+                  f"{memory.round_need(rows, left) / memory.GiB:.2f} GiB, keep {self.adapt.gib:g})", flush=True)
+        self.counts[f"rows_{rows}"] += 1
+        self.rows_now = rows
+        return rows
+
+    def _decode(self, plan: Plan) -> None:
+        count = 1
+        for s in self.seqs:
+            if s is None or not s.decoding or s.job.cancel:
+                continue
+            left = s.job.max_tokens - len(s.out)
+            depth, drafts = self.planner.window(s.plan, left, s.job.draft, s.job.stop_eos)
+            sp = s.job.sampling
+            nuc = NU.spec(sp) if self.nucleus else []
+            plan.windows.append(WindowSpec(s.slot, s.pos, s.pending, depth, drafts,
+                                           noise_of(sp) if depth else [], nuc))
+            if sp is None:
+                k = 1 + MARGIN
+            elif sp.top_k:
+                k = int(sp.top_k) + MARGIN
+            else:                               # top-p alone: the nucleus' candidates (``nucleus.py``), else all
+                k = self.nucleus if nuc else self.fwd.vocab
+            count = max(count, min(k, self.fwd.vocab))
+        if self.log_topk:                       # TF_DSV41_DRAFT_LOG: the target's top-K of every row (``draftlog``)
+            count = max(count, min(self.log_topk, self.fwd.vocab))
+        plan.count = count
+
+    # -- after the forward (rank 0) --------------------------------------------------------------------------------
+    def _sample(self, plan: Plan, res) -> None:
+        for slot in res.skipped:
+            s = self.seqs[slot]
+            if s is not None:                   # a damaged NVMe entry: prefill from the start
+                s.done, s.pos = 0, 0
+                s.decoding = False
+                s.long = len(s.job.prompt) > self.long_prompt
+                s.save_at = snapshot_point(len(s.job.prompt)) if self.store is not None else None
+                s.job.stats.update(cached=0, tier="none")
+        for slot, exc in res.errors.items():
+            s = self.seqs[slot]
+            if s is not None:
+                s.job.out.put(exc)
+                self._end(s, None, cancelled=True)
+        if res.cand is None:
+            return
+        for r, c in zip(res.rows, take_rows(res.cand, res.rows)):
+            s = self.seqs[r.slot]
+            if s is None:
+                continue
+            positions = [r.start + 1 + i for i in range(len(r.tokens))]
+            try:
+                if self.ex.inject is not None:
+                    self.ex.inject(self.ex.rounds, "sample")
+                chosen = self._choose(c, positions, s.job.sampling)
+            except Exception as exc:            # noqa: BLE001  rank 0's own: this request alone fails, its slot is
+                traceback.print_exc()           # finished in the next plan (rank 1 never sees a sample)
+                s.job.out.put(RuntimeError(f"sampling failed: {type(exc).__name__}: {exc}"))
+                self._end(s, None, cancelled=True)
+                continue
+            acc = accepted(r.tokens, chosen)
+            out = chosen[:acc + 1]
+            done = False
+            if s.job.stop_eos:
+                for i, t in enumerate(out):
+                    if t in self.eos:
+                        out, done = out[:i + 1], True
+                        break
+            left = s.job.max_tokens - len(s.out)
+            if len(out) >= left:
+                out, done = out[:left], True
+            self.commits.append((r.slot, len(out) - 1, out[-1]))
+            self.planner.observe(s.plan, len(r.tokens), acc, out)
+            s.pos, s.pending = r.start + len(out), out[-1]
+            if not s.out:
+                s.job.stats["ttft_s"] = round(time.monotonic() - s.job.submitted, 4)
+            s.out += out
+            self.counts["rows"] += len(r.tokens)
+            self.counts["drafts_kept"] += len(out) - 1
+            s.job.out.put(list(out))
+            if done:
+                self._end(s, None, cancelled=False)
+
+    def _choose(self, c, positions: list[int], sampling) -> list[int]:
+        values, ids = c.values.astype(np.float32), c.ids.astype(np.int64)
+        if sampling is not None and getattr(c, "nucleus", None):
+            return NU.choose(values, ids, positions, sampling, c.nucleus)
+        if sampling is None:                    # greedy: the largest logit, ties to the lower id: the first
+            return [int(t) for t in ids[:, 0]]  # candidate (``Candidates`` rows are sorted so, ``vsample.merge``)
+        return choose_rows(values, ids, positions, sampling)
+
+    def _end(self, s: Seq, plan: Plan | None, *, cancelled: bool) -> None:
+        save = self.store is not None and not cancelled
+        if plan is not None:
+            plan.finishes.append((s.slot, save, cancelled))
+        else:
+            self.finishes.append((s.slot, save, cancelled))
+        self.seqs[s.slot] = None
+        dt = time.monotonic() - s.t0
+        s.job.stats.update(finish="cancelled" if cancelled else "done", completion=len(s.out),
+                           decode_s=round(dt, 4), rounds=self.rounds)
+        if s.plan is not None:
+            s.job.stats["drafting"] = self.planner.report(s.plan)
+        s.job.out.put(None)
+
+    def _fail_all(self, exc: BaseException) -> None:
+        for s in list(self.seqs):
+            if s is not None:
+                s.job.out.put(RuntimeError(f"{type(exc).__name__}: {exc}"))
+                self._end(s, None, cancelled=True)
+        self.commits = []
+
+    # -- rank 1 ----------------------------------------------------------------------------------------------------
+    def follow(self) -> None:
+        """Rank 1: execute rank 0's plans until a stop plan."""
+
+        while True:
+            try:
+                plan = Plan.decode(self.link.recv())   # idle here is not a stall: the watch is armed per plan
+            except Exception as exc:            # noqa: BLE001  rank 0 gone or the link broken
+                if self.fate is None:
+                    raise
+                # already going down (the fate thread saw rank 0 hang up first): ``fatal`` waits for its exit (70)
+                # instead of this thread raising and the process exiting 1 before the grace ends (G17 B2)
+                self.fate.fatal(exc, "the plan link")
+                return
+            if plan.stop:
+                if self.fate is not None:
+                    self.fate.close()
+                self.watch.close()
+                return
+            t0 = time.perf_counter()
+            self.watch.begin(self.rounds, "execute")
+            self._plan_now = plan
+            try:
+                with PH("execute"):
+                    self.ex.run(plan)
+            except Exception as exc:            # noqa: BLE001  rank 0 waits inside this round's exchanges
+                if self.fate is None:
+                    raise
+                self.fate.fatal(exc, f"round {self.ex.rounds} ({self.ex.now})")
+                return
+            finally:
+                self.watch.end()
+                self._plan_now = None
+            if PH.on:
+                PH.add("round", time.perf_counter() - t0)
+            self.rounds += 1
+
+    def _stall_info(self) -> list[str]:
+        """The stall report's batcher part (``stall.Watch``): the round's plan, the slots, the forward's waits."""
+
+        from .stall import forward_info
+
+        p = self._plan_now
+        out = []
+        if p is not None:
+            out.append(f"plan: round {p.round}, mode {p.mode}, admits {[(a.slot, len(a.prompt)) for a in p.admits]}, "
+                       f"pieces {p.pieces}, saves {p.saves}, finals {p.finals}, windows "
+                       f"{[(w.slot, w.start, w.depth) for w in p.windows]}, commits {len(p.commits)}")
+        out.append(f"slots: {self.ex.describe()}; queue {len(self.queue)}")
+        return out + forward_info(self.fwd)
+
+    def send_stop(self) -> None:
+        if self.fate is not None:
+            self.fate.close()
+        self.link.send(Plan(stop=True).encode())
+
+    def describe(self) -> str:
+        s = f"{self.n} slot(s) x {self.capacity} tokens; {self.ex.describe()}"
+        if self.prefill_concurrent:
+            s += f"; long prefills (> {self.long_prompt} tokens) {self.prefill_concurrent} at a time"
+        if self.store is not None:
+            s += f"; sessions: {self.store.describe()}"
+        return s
