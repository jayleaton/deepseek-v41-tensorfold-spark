diff --git a/zig/src/families/deepseek_v41/engram_preflight.zig b/zig/src/families/deepseek_v41/engram_preflight.zig
new file mode 100644
index 0000000000000000000000000000000000000000..7497531fa4cf0ae27df8a63cce7ed6b87188e6b5
--- /dev/null
+++ b/zig/src/families/deepseek_v41/engram_preflight.zig
@@ -0,0 +1,47 @@
+//! CPU-only rank agreement before Engram validation can refuse CUDA startup.
+const std = @import("std");
+const tp = @import("tp");
+const guard = @import("engram_validate.zig");
+const hash = @import("engram_hash.zig");
+
+pub fn fromEnv(io: std.Io, cfg: tp.Config) !?tp.Bootstrap {
+    const raw = if (std.c.getenv("TF_DSV41_ENGRAM_VALIDATE")) |v| std.mem.span(v) else null;
+    const dir = if (std.c.getenv("TF_DSV41_ENGRAM_DIR")) |v| std.mem.span(v) else null;
+    var diagnostic: guard.Diagnostic = .{};
+    return start(io, raw, dir, cfg, &hash.layers, &diagnostic) catch |err| {
+        if (diagnostic.len != 0) std.log.err("Engram preflight: {s}", .{diagnostic.text()});
+        return err;
+    };
+}
+
+/// The returned sockets continue into Session.openBootstrapped; off does not open files or sockets.
+pub fn start(io: std.Io, raw: ?[]const u8, dir: ?[]const u8, cfg: tp.Config, layers: []const hash.Layer, diagnostic: *guard.Diagnostic) !?tp.Bootstrap {
+    if (!(guard.enabled(raw) catch true)) return null;
+    const local: ?anyerror = blk: {
+        guard.applyDiagnostic(io, raw, dir, cfg.rank, cfg.world, layers, diagnostic) catch |err| {
+            if (diagnostic.len == 0) {
+                const message = try std.fmt.bufPrint(&diagnostic.bytes, "rank {d}: {s}", .{ cfg.rank, @errorName(err) });
+                diagnostic.len = message.len;
+            }
+            break :blk err;
+        };
+        break :blk null;
+    };
+    var b = try tp.Bootstrap.open(cfg);
+    errdefer b.close();
+    try agree(&b, local, diagnostic);
+    return b;
+}
+
+pub fn agree(b: *tp.Bootstrap, local: ?anyerror, diagnostic: *guard.Diagnostic) !void {
+    var bytes: [tp.bootstrap.max_ranks * 8192]u8 = undefined;
+    var blobs: [tp.bootstrap.max_ranks][]const u8 = undefined;
+    const all = try b.allGather(if (local != null) diagnostic.text() else "", &bytes, &blobs);
+    if (local) |err| return err;
+    for (all) |message| if (message.len != 0) {
+        if (message.len > diagnostic.bytes.len) return error.TooLarge;
+        @memcpy(diagnostic.bytes[0..message.len], message);
+        diagnostic.len = message.len;
+        return error.PeerEngramValidationFailed;
+    };
+}
diff --git a/zig/src/families/deepseek_v41/engram_preflight_test.zig b/zig/src/families/deepseek_v41/engram_preflight_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f361e5f91a426df760591ad19c53ed6c2066133c
--- /dev/null
+++ b/zig/src/families/deepseek_v41/engram_preflight_test.zig
@@ -0,0 +1,88 @@
+//! Rank-local malformed shards must stop both ranks before the GPU startup seam.
+const std = @import("std");
+const t = std.testing;
+const tp = @import("tp");
+const guard = @import("engram_validate.zig");
+const preflight = @import("engram_preflight.zig");
+const fixtures = @import("engram_validate_test.zig");
+
+const Result = struct {
+    err: ?anyerror = null,
+    diagnostic: guard.Diagnostic = .{},
+    startup_reached: bool = false,
+};
+
+fn rankStart(cfg: tp.Config, root: []const u8, result: *Result) void {
+    const metas = .{ fixtures.metadata(1), fixtures.metadata(14) };
+    var boot = preflight.start(t.io, "1", root, cfg, &metas, &result.diagnostic) catch |err| {
+        result.err = err;
+        return;
+    };
+    defer if (boot) |*b| b.close();
+    result.startup_reached = true;
+    // Session startup consumes these same sockets; a host-only continuation verifies their ownership.
+    if (boot) |*b| b.agree("session continuation", "test") catch |err| {
+        result.err = err;
+    };
+}
+
+test "Engram preflight refuses both ranks for either rank-local failure before CUDA startup" {
+    for ([_]?u32{ 0, 1, 2, null }) |bad_rank| {
+        var dirs = [_]t.TmpDir{ t.tmpDir(.{}), t.tmpDir(.{}) };
+        defer for (&dirs) |*dir| dir.cleanup();
+        var roots: [2][:0]const u8 = undefined;
+        for (&dirs, 0..) |*dir, rank| {
+            roots[rank] = try dir.dir.realPathFileAlloc(t.io, ".", t.allocator);
+            for ([_]u32{ 1, 14 }) |layer| {
+                if (bad_rank == 2 and rank == 1 and layer == 14) continue;
+                const invalid = bad_rank == @as(u32, @intCast(rank)) or (bad_rank == 2 and rank == 0);
+                const hi: u64 = (rank + 1) * 24 - @intFromBool(invalid and layer == 14);
+                try fixtures.shard(dir.dir, fixtures.metadata(layer), @intCast(rank), rank * 24, hi, 48, layer);
+            }
+        }
+        defer for (roots) |root| t.allocator.free(root);
+        const listener = try tp.bootstrap.testListener();
+        tp.sock.close(listener.fd);
+        const cfg: tp.Config = .{ .world = 2, .rank = 0, .link_port = listener.port, .connect_timeout_ns = 2 * std.time.ns_per_s };
+        var follower = cfg;
+        follower.rank = 1;
+        var results: [2]Result = .{ .{}, .{} };
+        const before = tp.sock.nowNs();
+        const thread = try std.Thread.spawn(.{}, rankStart, .{ follower, roots[1], &results[1] });
+        rankStart(cfg, roots[0], &results[0]);
+        thread.join();
+        try t.expect(tp.sock.nowNs() - before < 2 * std.time.ns_per_s);
+        if (bad_rank == 2) {
+            try t.expectEqual(error.BadEngramShard, results[0].err.?);
+            try t.expectEqual(error.FileNotFound, results[1].err.?);
+            for (&results, 0..) |*result, rank| {
+                try t.expect(!result.startup_reached);
+                try t.expect(std.mem.indexOf(u8, result.diagnostic.text(), roots[rank]) != null);
+                try t.expect(std.mem.indexOf(u8, result.diagnostic.text(), @errorName(result.err.?)) != null);
+            }
+        } else if (bad_rank) |bad| {
+            for (&results) |*result| {
+                try t.expect(result.err != null);
+                try t.expect(!result.startup_reached);
+                try t.expect(std.mem.indexOf(u8, result.diagnostic.text(), roots[bad]) != null);
+                try t.expect(std.mem.indexOf(u8, result.diagnostic.text(), "expected total >= 48") != null);
+                try t.expect(std.mem.indexOf(u8, result.diagnostic.text(), "actual layer 14") != null);
+            }
+            try t.expectEqual(error.BadEngramShard, results[bad].err.?);
+            try t.expectEqual(error.PeerEngramValidationFailed, results[1 - bad].err.?);
+            try t.expectEqualStrings(results[0].diagnostic.text(), results[1].diagnostic.text());
+        } else {
+            for (results) |result| {
+                try t.expectEqual(@as(?anyerror, null), result.err);
+                try t.expect(result.startup_reached);
+            }
+        }
+    }
+}
+
+test "Engram preflight off avoids rendezvous even with an absent peer and invalid world" {
+    var diagnostic: guard.Diagnostic = .{};
+    for ([_]?[]const u8{ null, "", "0", " 0 " }) |raw| {
+        try t.expect(try preflight.start(t.io, raw, "missing", .{ .world = 0 }, &.{}, &diagnostic) == null);
+    }
+}
diff --git a/zig/src/families/deepseek_v41/engram_validate.zig b/zig/src/families/deepseek_v41/engram_validate.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8e2b0931147bf8cf4e83bc09b54dcf6fde33c455
--- /dev/null
+++ b/zig/src/families/deepseek_v41/engram_validate.zig
@@ -0,0 +1,89 @@
+//! Opt-in startup checks that each packed Engram shard covers the hasher's rank-owned rows.
+const std = @import("std");
+const format = @import("engram_rows.zig");
+const hash = @import("engram_hash.zig");
+
+pub const Diagnostic = struct {
+    bytes: [8192]u8 = undefined,
+    len: usize = 0,
+
+    pub fn text(d: *const Diagnostic) []const u8 {
+        return d.bytes[0..d.len];
+    }
+
+    fn set(d: *Diagnostic, path: []const u8, rank: u32, meta: hash.Layer, bounds: Bounds, h: ?format.Header, err: anyerror) void {
+        const actual = h orelse format.Header{ .layer = 0, .total = 0, .lo = 0, .hi = 0, .row_bytes = 0 };
+        const message = std.fmt.bufPrint(
+            &d.bytes,
+            "{s}: rank {d} layer {d}: {s}; expected total >= {d}, rows [{d}, {d}); actual {s}layer {d}, total {d}, rows [{d}, {d})",
+            .{ path, rank, meta.layer_id, @errorName(err), meta.rows, bounds.lo, bounds.hi, if (h == null) "unavailable: " else "", actual.layer, actual.total, actual.lo, actual.hi },
+        ) catch unreachable;
+        d.len = message.len;
+    }
+};
+
+pub fn enabled(raw: ?[]const u8) !bool {
+    const mode = std.mem.trim(u8, raw orelse "", " \t\r\n");
+    if (mode.len == 0 or std.mem.eql(u8, mode, "0")) return false;
+    if (!std.mem.eql(u8, mode, "1")) return error.BadKnob;
+    return true;
+}
+
+/// Checks only metadata; table bytes and the served read/arithmetic paths are unchanged.
+pub fn apply(io: std.Io, raw: ?[]const u8, dir: ?[]const u8, rank: u32, world: u32, layers: []const hash.Layer) !void {
+    var diagnostic: Diagnostic = .{};
+    try applyDiagnostic(io, raw, dir, rank, world, layers, &diagnostic);
+}
+
+pub fn applyDiagnostic(io: std.Io, raw: ?[]const u8, dir: ?[]const u8, rank: u32, world: u32, layers: []const hash.Layer, diagnostic: *Diagnostic) !void {
+    diagnostic.len = 0;
+    if (!try enabled(raw)) return;
+    if (world == 0 or rank >= world) return error.BadEngramShard;
+    const root = dir orelse return error.MissingEngramDirectory;
+    for (layers) |meta| {
+        var buf: [4096]u8 = undefined;
+        const path = try std.fmt.bufPrint(&buf, "{s}/engram-l{d}-r{d}of{d}.bin", .{ root, meta.layer_id, rank, world });
+        try checkFile(io, path, meta, rank, world, diagnostic);
+    }
+}
+
+fn checkFile(io: std.Io, path: []const u8, meta: hash.Layer, rank: u32, world: u32, diagnostic: *Diagnostic) !void {
+    var actual: ?format.Header = null;
+    checkShard(io, path, meta, rank, world, &actual) catch |err| {
+        diagnostic.set(path, rank, meta, required(meta, rank, world), actual, err);
+        return err;
+    };
+}
+
+fn checkShard(io: std.Io, path: []const u8, meta: hash.Layer, rank: u32, world: u32, actual: *?format.Header) !void {
+    const file = try std.Io.Dir.cwd().openFile(io, path, .{});
+    defer file.close(io);
+    var bytes: [48]u8 = undefined;
+    if (try file.readPositionalAll(io, &bytes, 0) != bytes.len) return error.BadEngramShard;
+    actual.* = .{
+        .layer = std.mem.readInt(u64, bytes[8..16], .little),
+        .lo = std.mem.readInt(u64, bytes[16..24], .little),
+        .hi = std.mem.readInt(u64, bytes[24..32], .little),
+        .total = std.mem.readInt(u64, bytes[32..40], .little),
+        .row_bytes = std.mem.readInt(u64, bytes[40..48], .little),
+    };
+    const header = try format.Header.parse(&bytes, try file.length(io));
+    try coverage(header, meta, rank, world);
+}
+
+pub const Bounds = struct { lo: u64, hi: u64 };
+
+pub fn required(meta: hash.Layer, rank: u32, world: u32) Bounds {
+    const part = (hash.columns + @as(u64, world) - 1) / world;
+    const first: usize = @intCast(@min(rank * part, hash.columns));
+    const end: usize = @intCast(@min(first + part, hash.columns));
+    if (first == end) return .{ .lo = meta.rows, .hi = meta.rows };
+    return .{ .lo = meta.offsets[first], .hi = @as(u64, meta.offsets[end - 1]) + meta.primes[end - 1] };
+}
+
+pub fn coverage(header: format.Header, meta: hash.Layer, rank: u32, world: u32) !void {
+    if (header.layer != meta.layer_id or header.total < meta.rows) return error.BadEngramShard;
+    const bounds = required(meta, rank, world);
+    if (bounds.lo == bounds.hi) return;
+    if (header.lo > bounds.lo or header.hi < bounds.hi) return error.BadEngramShard;
+}
diff --git a/zig/src/families/deepseek_v41/engram_validate_test.zig b/zig/src/families/deepseek_v41/engram_validate_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..474d76dd4847636d6fe83a1b8aeb3c52576699de
--- /dev/null
+++ b/zig/src/families/deepseek_v41/engram_validate_test.zig
@@ -0,0 +1,173 @@
+//! Packed files with internally valid headers can still omit rows the rank's hasher will request.
+const std = @import("std");
+const t = std.testing;
+const guard = @import("engram_validate.zig");
+const format = @import("engram_rows.zig");
+const hash = @import("engram_hash.zig");
+const portable = @import("engram_rows_portable.zig");
+
+pub fn metadata(id: u32) hash.Layer {
+    var meta: hash.Layer = .{ .layer_id = id, .rows = 48, .multipliers = @splat(1), .primes = @splat(2), .offsets = undefined };
+    for (&meta.offsets, 0..) |*x, i| x.* = @intCast(2 * i);
+    return meta;
+}
+
+pub fn shard(dir: std.Io.Dir, meta: hash.Layer, rank: u32, lo: u64, hi: u64, total: u64, id: u32) !void {
+    var bytes: [4096 + 48 * 264]u8 = @splat(0);
+    for ([_]u64{ format.magic, id, lo, hi, total, format.row_bytes }, 0..) |x, i|
+        std.mem.writeInt(u64, bytes[i * 8 ..][0..8], x, .little);
+    for (0..@as(usize, @intCast(hi - lo))) |row| for (0..264) |col| {
+        bytes[4096 + row * 264 + col] = if (col < 256) @intCast((row * 7 + col * 3 + id) % 120) else 127;
+    };
+    var name: [64]u8 = undefined;
+    try dir.writeFile(t.io, .{
+        .sub_path = try std.fmt.bufPrint(&name, "engram-l{d}-r{d}of2.bin", .{ meta.layer_id, rank }),
+        .data = bytes[0..@intCast(format.header_bytes + (hi - lo) * format.row_bytes)],
+    });
+}
+
+fn decoded(root: []const u8, rank: u32, out: *[1536]u16) !void {
+    const rows = try portable.Rows.openWithIo(t.allocator, t.io, root, rank, 2, &.{ 1, 14 }, 4);
+    defer rows.close();
+    const base: i64 = @as(i64, rank) * 24;
+    const ids = [_]i64{ base, base + 12, base + 23 };
+    try rows.rows(0, &ids, 256, out[0..768]);
+    try rows.rows(1, &ids, 256, out[768..]);
+}
+
+test "Engram startup validation is opt in and off never opens a shard" {
+    for ([_]?[]const u8{ null, "", "0", " 0 " }) |raw|
+        try guard.apply(t.io, raw, "no-such-engram-directory", 0, 2, &.{metadata(1)});
+    try guard.apply(t.io, null, null, 0, 0, &.{});
+    try t.expectError(error.BadKnob, guard.apply(t.io, "on", null, 0, 2, &.{}));
+    try t.expectError(error.BadKnob, guard.apply(t.io, "2", null, 0, 2, &.{}));
+    try t.expectError(error.MissingEngramDirectory, guard.apply(t.io, "1", null, 0, 2, &.{}));
+    try t.expectError(error.BadEngramShard, guard.apply(t.io, "1", ".", 2, 2, &.{}));
+    try t.expectError(error.BadEngramShard, guard.apply(t.io, "1", ".", 0, 0, &.{}));
+}
+
+test "Engram startup validation accepts both ranks and leaves packed bytes unchanged" {
+    var tmp = t.tmpDir(.{});
+    defer tmp.cleanup();
+    const root = try tmp.dir.realPathFileAlloc(t.io, ".", t.allocator);
+    defer t.allocator.free(root);
+    const metas = [_]hash.Layer{ metadata(1), metadata(14) };
+    for (metas) |meta| {
+        try shard(tmp.dir, meta, 0, 0, 24, 48, meta.layer_id);
+        try shard(tmp.dir, meta, 1, 24, 48, 48, meta.layer_id);
+    }
+    const before = try tmp.dir.readFileAlloc(t.io, "engram-l1-r0of2.bin", t.allocator, .limited(1 << 20));
+    defer t.allocator.free(before);
+    for (0..2) |rank| {
+        var plain: [1536]u16 = undefined;
+        var checked: [1536]u16 = undefined;
+        try guard.apply(t.io, "0", root, @intCast(rank), 2, &metas);
+        try decoded(root, @intCast(rank), &plain);
+        try guard.apply(t.io, "1", root, @intCast(rank), 2, &metas);
+        try decoded(root, @intCast(rank), &checked);
+        try t.expectEqualSlices(u16, &plain, &checked);
+    }
+    const after = try tmp.dir.readFileAlloc(t.io, "engram-l1-r0of2.bin", t.allocator, .limited(1 << 20));
+    defer t.allocator.free(after);
+    try t.expectEqualSlices(u8, before, after);
+    try guard.apply(t.io, "0", root, 0, 2, &metas);
+    try guard.apply(t.io, "1", root, 0, 2, &metas);
+}
+
+test "internally valid Engram headers missing global or rank-owned rows fail before serving" {
+    var tmp = t.tmpDir(.{});
+    defer tmp.cleanup();
+    const root = try tmp.dir.realPathFileAlloc(t.io, ".", t.allocator);
+    defer t.allocator.free(root);
+    const meta = metadata(1);
+    const cases = [_]struct { rank: u32, lo: u64, hi: u64, total: u64, id: u32 }{
+        .{ .rank = 0, .lo = 0, .hi = 24, .total = 47, .id = 1 },
+        .{ .rank = 0, .lo = 1, .hi = 24, .total = 48, .id = 1 },
+        .{ .rank = 0, .lo = 0, .hi = 23, .total = 48, .id = 1 },
+        .{ .rank = 1, .lo = 25, .hi = 48, .total = 48, .id = 1 },
+        .{ .rank = 1, .lo = 24, .hi = 47, .total = 48, .id = 1 },
+        .{ .rank = 0, .lo = 0, .hi = 24, .total = 48, .id = 14 },
+    };
+    for (cases) |c| {
+        try shard(tmp.dir, meta, c.rank, c.lo, c.hi, c.total, c.id);
+        var name: [64]u8 = undefined;
+        const path = try std.fmt.bufPrint(&name, "engram-l1-r{d}of2.bin", .{c.rank});
+        const bytes = try tmp.dir.readFileAlloc(t.io, path, t.allocator, .limited(1 << 20));
+        defer t.allocator.free(bytes);
+        _ = try format.Header.parse(bytes[0..48], bytes.len);
+        try guard.apply(t.io, "0", root, c.rank, 2, &.{meta});
+        try t.expectError(error.BadEngramShard, guard.apply(t.io, "1", root, c.rank, 2, &.{meta}));
+    }
+}
+
+test "Engram startup validation checks every layer and refuses truncated files" {
+    var tmp = t.tmpDir(.{});
+    defer tmp.cleanup();
+    const root = try tmp.dir.realPathFileAlloc(t.io, ".", t.allocator);
+    defer t.allocator.free(root);
+    const metas = [_]hash.Layer{ metadata(1), metadata(14) };
+    try shard(tmp.dir, metas[0], 0, 0, 24, 48, 1);
+    try shard(tmp.dir, metas[1], 0, 0, 24, 47, 14);
+    try t.expectError(error.BadEngramShard, guard.apply(t.io, "1", root, 0, 2, &metas));
+    try tmp.dir.writeFile(t.io, .{ .sub_path = "engram-l1-r0of2.bin", .data = "short" });
+    try t.expectError(error.BadEngramShard, guard.apply(t.io, "1", root, 0, 2, &metas));
+}
+
+test "Engram refusal diagnostics retain file and expected versus actual geometry" {
+    var tmp = t.tmpDir(.{});
+    defer tmp.cleanup();
+    const root = try tmp.dir.realPathFileAlloc(t.io, ".", t.allocator);
+    defer t.allocator.free(root);
+    var diagnostic: guard.Diagnostic = .{};
+    const meta = metadata(1);
+    try shard(tmp.dir, meta, 0, 0, 24, 47, 1);
+    try t.expectError(error.BadEngramShard, guard.applyDiagnostic(t.io, "1", root, 0, 2, &.{meta}, &diagnostic));
+    for ([_][]const u8{ root, "engram-l1-r0of2.bin", "rank 0 layer 1", "expected total >= 48, rows [0, 24)", "actual layer 1, total 47, rows [0, 24)" }) |part|
+        try t.expect(std.mem.indexOf(u8, diagnostic.text(), part) != null);
+    try shard(tmp.dir, meta, 1, 25, 48, 48, 1);
+    try t.expectError(error.BadEngramShard, guard.applyDiagnostic(t.io, "1", root, 1, 2, &.{meta}, &diagnostic));
+    for ([_][]const u8{ "engram-l1-r1of2.bin", "expected total >= 48, rows [24, 48)", "actual layer 1, total 48, rows [25, 48)" }) |part|
+        try t.expect(std.mem.indexOf(u8, diagnostic.text(), part) != null);
+    try tmp.dir.writeFile(t.io, .{ .sub_path = "engram-l1-r0of2.bin", .data = "short" });
+    try t.expectError(error.BadEngramShard, guard.applyDiagnostic(t.io, "1", root, 0, 2, &.{meta}, &diagnostic));
+    try t.expect(std.mem.indexOf(u8, diagnostic.text(), "engram-l1-r0of2.bin") != null);
+    try t.expect(std.mem.indexOf(u8, diagnostic.text(), "actual unavailable") != null);
+    try t.expectError(error.FileNotFound, guard.applyDiagnostic(t.io, "1", root, 0, 2, &.{metadata(14)}, &diagnostic));
+    try t.expect(std.mem.indexOf(u8, diagnostic.text(), "engram-l14-r0of2.bin") != null);
+    try shard(tmp.dir, meta, 0, 0, 24, 48, 1);
+    const file = try tmp.dir.openFile(t.io, "engram-l1-r0of2.bin", .{ .mode = .read_write });
+    defer file.close(t.io);
+    try file.setLength(t.io, 48);
+    try t.expectError(error.BadEngramShard, guard.applyDiagnostic(t.io, "1", root, 0, 2, &.{meta}, &diagnostic));
+    try t.expect(std.mem.indexOf(u8, diagnostic.text(), "actual layer 1, total 48, rows [0, 24)") != null);
+}
+
+test "canonical Engram unequal buckets accept padding and reject inward edges" {
+    for (hash.layers, 0..) |meta, layer_index| {
+        const tp2_boundary: u64 = if (layer_index == 0) 192001740 else 192007016;
+        try t.expectEqual(tp2_boundary, guard.required(meta, 0, 2).hi);
+        try t.expectEqual(tp2_boundary, guard.required(meta, 1, 2).lo);
+        for ([_]u32{ 2, 5 }) |world| for (0..world) |r| {
+            const rank: u32 = @intCast(r);
+            const first = @min(rank * ((24 + world - 1) / world), 24);
+            const end = @min(first + ((24 + world - 1) / world), 24);
+            var lo: u64 = 0;
+            var hi: u64 = 0;
+            for (meta.primes[0..end], 0..) |prime, col| {
+                hi += prime;
+                if (col < first) lo += prime;
+            }
+            var header: format.Header = .{ .layer = meta.layer_id, .total = meta.rows, .lo = lo, .hi = hi, .row_bytes = format.row_bytes };
+            try guard.coverage(header, meta, rank, world);
+            header.lo = lo -| 1;
+            header.hi = hi + 1;
+            header.total += 1;
+            try guard.coverage(header, meta, rank, world);
+            header.lo = lo + 1;
+            try t.expectError(error.BadEngramShard, guard.coverage(header, meta, rank, world));
+            header.lo = lo;
+            header.hi = hi - 1;
+            try t.expectError(error.BadEngramShard, guard.coverage(header, meta, rank, world));
+        };
+    }
+}
