+++ b/zig/src/server/compute_segments.zig
@@ -0,0 +1,274 @@
+//! A lane reply's segments: at each held EOS its built-in calls run, their result turn is forced in, it goes on.
+const std = @import("std");
+const api = @import("engine_api");
+const json = @import("json");
+const chat = @import("chat.zig");
+const reply_text = @import("reply_text.zig");
+const tool_parse = @import("tool_parse.zig");
+const tool_stream = @import("tool_stream.zig");
+const prompt_mod = @import("prompt.zig");
+const turns = @import("compute_turns.zig");
+const log = @import("log.zig");
+const Generation = @import("generation.zig").Generation;
+const Server = @import("server.zig").Server;
+const lane = api.compute_lane;
+const Value = json.Value;
+const Cx = @import("errors.zig").Cx;
+const Allocator = std.mem.Allocator;
+
+/// Tokens the reply keeps free after an inserted result, so the model can still answer.
+const answer_room = 16;
+
+/// What the earlier segments of a reply said and did, merged into its last segment's reply.
+const Merge = struct {
+    content: std.ArrayList(u8) = .empty,
+    reasoning: std.ArrayList(u8) = .empty,
+    completion: usize = 0,
+    reasoning_tokens: usize = 0,
+    ids: std.ArrayList(u32) = .empty, // the engine's whole continuation: segments and inserted results
+    inserted: usize = 0,
+    calls: std.ArrayList(Value) = .empty, // one report a call
+    history: std.ArrayList(Value) = .empty, // the request's messages, then each segment's call turn and results
+};
+
+/// Continues a reply whose first segment `first` ended held at its EOS, until the engine ends it.
+pub fn rest(first: *Generation, cx: *Cx, p: chat.Prepared, filter: *turns.Filter, gone: anytype) chat.Failure!chat.Reply {
+    const a = cx.a;
+    const srv = first.srv;
+    const cfg = srv.info.compute.?;
+    var m: Merge = .{};
+    if (p.input.messages == .array) try m.history.appendSlice(a, p.input.messages.array);
+    var g = first;
+    var run_calls: u32 = 0;
+    while (g.held) {
+        const used = m.ids.items.len + g.collected.items.len;
+        const answer = try segmentAnswer(g);
+        const calls = builtInOnly(answer.calls);
+        var plan: ?[]const u32 = null;
+        var assistant: Value = .null;
+        var reports: []Value = &.{};
+        if (calls.len > 0 and used + answer_room < p.request.max_tokens) {
+            assistant = try assistantTurn(a, answer.prose, answer.reasoning, calls);
+            reports = try runAll(a, srv, cfg, calls, &run_calls, gone);
+            plan = try suffix(srv, cx, p, &m.history, assistant, calls, reports);
+            if (plan) |s| if (used + s.len + answer_room > p.request.max_tokens) {
+                plan = null;
+            };
+        }
+        const s = plan orelse {
+            // no call to run, a client's call, or no room: the reply ends at this EOS as it would without the lane
+            _ = srv.engine.resumeHeld(g.id, .{ .tokens = &.{} });
+            g.held = false;
+            try g.loop(gone);
+            for (reports) |r| {
+                try r.object.put(a, "inserted", .{ .bool = false });
+                try m.calls.append(a, r);
+            }
+            return merge(a, &m, try finish(g, cx, p), g.collected.items);
+        };
+        _ = srv.engine.resumeHeld(g.id, .{ .tokens = s, .think_open = p.thinking });
+        const seg = try finish(g, cx, p);
+        try note(a, &m, g, seg, s);
+        try m.history.append(a, assistant);
+        for (calls, reports) |c, r| try m.history.append(a, try toolTurn(a, c, r.get("output").?.string));
+        for (reports) |r| {
+            try r.object.put(a, "inserted", .{ .bool = true });
+            try m.calls.append(a, r);
+            if (g.sink != null) filter.direct(try reportDelta(a, r)) catch return error.Cancelled;
+        }
+        g = try next(g, s, p.request.max_tokens - (used + s.len));
+        filter.nextSegment();
+        try g.loop(gone);
+    }
+    return merge(a, &m, try finish(g, cx, p), g.collected.items);
+}
+
+fn finish(g: *Generation, cx: *Cx, p: chat.Prepared) chat.Failure!chat.Reply {
+    return g.finish(cx, p.prompt_len, p.received, p.thinking, p.effort, p.sampled, p.drafts);
+}
+
+/// The segment after an inserted result: the same reply, its first tokens the result's, its own text and calls.
+fn next(g: *Generation, inserted: []const u32, left: usize) chat.Failure!*Generation {
+    const n = try g.a.create(Generation);
+    n.* = .{ .srv = g.srv, .a = g.a, .box = g.box, .id = g.id, .reply_id = g.reply_id, .seed = g.seed, .sink = g.sink, .thinking = g.thinking, .stops = g.stops, .ignore_eos = g.ignore_eos, .max_tokens = @intCast(left), .tools = g.tools, .token_ids = g.token_ids, .loop_stop = g.loop_stop, .hold = true, .skip = inserted, .consumed = g.consumed, .chunk_index = g.chunk_index, .first_ns = g.first_ns, .wrote_ns = g.wrote_ns };
+    if (g.calls != null) n.calls = try tool_stream.Streamer.init(g.a, g.tools);
+    return n;
+}
+
+/// The segment's calls when every one is the built-in tool's (a client's call ends the reply for its client).
+fn builtInOnly(calls: ?[]Value) []Value {
+    const all = calls orelse return &.{};
+    for (all) |c| if (!turns.isBuiltInCall(c)) return &.{};
+    return all;
+}
+
+const Answer = struct { prose: []const u8, reasoning: ?[]const u8, calls: ?[]Value };
+
+/// The segment's answer as `Generation.finish` reads it: stops, a call closed at the EOS, the think split, the calls.
+fn segmentAnswer(g: *Generation) chat.Failure!Answer {
+    const a = g.a;
+    const tokens = reply_text.stripTrailing(g.collected.items, g.srv.eos);
+    const visible = g.stops.visible(try g.srv.text.decode(a, tokens), false);
+    const close = try tool_parse.closeCall(a, visible, g.tools);
+    const text = if (close.len > 0) try std.mem.concat(a, u8, &.{ visible, close }) else visible;
+    var answer = text;
+    var reasoning: ?[]const u8 = null;
+    if (g.thinking) {
+        const split = reply_text.splitThinkingTokens(a, reply_text.decodeText, g.srv.text, text, true, g.srv.markers, tokens, g.srv.close_id) catch return error.OutOfMemory;
+        answer = split.answer;
+        const r = reply_text.pyStrip(split.reasoning);
+        if (r.len > 0) reasoning = r;
+    }
+    const parsed = try tool_parse.parse(a, answer, g.tools, null);
+    return .{ .prose = parsed.content, .reasoning = reasoning, .calls = parsed.calls };
+}
+
+/// Runs each call in order (results stay in call order); past the reply's call cap a call gets that note instead.
+fn runAll(a: Allocator, srv: *Server, cfg: lane.Config, calls: []const Value, ran: *u32, gone: anytype) chat.Failure![]Value {
+    const Watch = struct {
+        gone: @TypeOf(gone),
+        fn left(ctx: *anyopaque) bool {
+            const w: *@This() = @ptrCast(@alignCast(ctx));
+            return w.gone.check();
+        }
+    };
+    var watch: Watch = .{ .gone = gone };
+    const out = try a.alloc(Value, calls.len);
+    for (calls, out) |c, *slot| {
+        const code = try codeOf(a, c);
+        var o: lane.Outcome = .{ .status = .unavailable, .stderr = "the call has no string argument \"code\"" };
+        var body: []const u8 = undefined;
+        if (ran.* >= cfg.max_calls) {
+            body = "[call limit reached: answer without running more code]";
+        } else {
+            if (code) |src| o = try srv.compute.?.run(a, src, .{ .ctx = &watch, .gone = Watch.left });
+            if (o.status == .cancelled) return error.Cancelled;
+            body = try lane.runner.body(a, o, cfg.max_ms, cfg.max_output_bytes);
+            ran.* += 1;
+        }
+        slot.* = try report(a, c, code orelse "", o, try capTokens(a, srv, body, cfg.max_result_tokens));
+    }
+    return out;
+}
+
+/// The call's "code" argument, its arguments a JSON object or a JSON string; null when missing or not a string.
+fn codeOf(a: Allocator, call: Value) Allocator.Error!?[]const u8 {
+    const f = call.get("function") orelse return null;
+    const args = f.get("arguments") orelse return null;
+    const obj: Value = if (args == .string) switch (try json.parseText(a, args.string)) {
+        .ok => |v| v,
+        .err => return null,
+    } else args;
+    const code = obj.strField("code") orelse return null;
+    return if (std.mem.trim(u8, code, " \t\r\n").len > 0) code else null;
+}
+
+/// The result text cut to `max` tokens (decoded back at a character boundary), with a note when cut.
+fn capTokens(a: Allocator, srv: *Server, body: []const u8, max: u32) Allocator.Error![]const u8 {
+    const ids = srv.text.encodePlain(a, body) catch return body;
+    if (ids.len <= max) return body;
+    var n: usize = max;
+    while (n > 0) : (n -= 1) {
+        const text = try srv.text.decode(a, ids[0..n]);
+        if (std.unicode.utf8ValidateSlice(text)) return std.fmt.allocPrint(a, "{s}\n[output truncated at {d} tokens]", .{ text, max });
+    }
+    return std.fmt.allocPrint(a, "[output truncated at {d} tokens]", .{max});
+}
+
+fn report(a: Allocator, call: Value, code: []const u8, o: lane.Outcome, output: []const u8) Allocator.Error!Value {
+    const r = try json.newObject(a);
+    try r.put(a, "name", .{ .string = turns.name });
+    try r.put(a, "id", call.get("id") orelse .null);
+    try r.put(a, "code", .{ .string = code });
+    try r.put(a, "status", .{ .string = @tagName(o.status) });
+    try r.put(a, "exit_code", if (o.exit_code) |x| try json.intValue(a, x) else .null);
+    try r.put(a, "exec_ms", .{ .float = @as(f64, @floatFromInt(o.exec_ns)) / 1e6 });
+    try r.put(a, "output", .{ .string = output });
+    return .{ .object = r };
+}
+
+fn reportDelta(a: Allocator, r: Value) Allocator.Error!Value {
+    const d = try json.newObject(a);
+    try d.put(a, "compute", r);
+    return .{ .object = d };
+}
+
+/// The assistant turn the segment wrote, as a client would send it back: its prose, reasoning and calls.
+fn assistantTurn(a: Allocator, prose: []const u8, reasoning: ?[]const u8, calls: []Value) Allocator.Error!Value {
+    const o = try json.newObject(a);
+    try o.put(a, "role", .{ .string = "assistant" });
+    try o.put(a, "content", .{ .string = prose });
+    if (reasoning) |r| try o.put(a, "reasoning_content", .{ .string = r });
+    try o.put(a, "tool_calls", .{ .array = calls });
+    return .{ .object = o };
+}
+
+fn toolTurn(a: Allocator, call: Value, output: []const u8) Allocator.Error!Value {
+    const o = try json.newObject(a);
+    try o.put(a, "role", .{ .string = "tool" });
+    try o.put(a, "tool_call_id", call.get("id") orelse .null);
+    try o.put(a, "content", .{ .string = output });
+    return .{ .object = o };
+}
+
+/// The template's tokens after the held EOS: render(history + call turn + results) past render(history + call turn).
+fn suffix(srv: *Server, cx: *Cx, p: chat.Prepared, history: *const std.ArrayList(Value), assistant: Value, calls: []const Value, reports: []const Value) chat.Failure!?[]const u32 {
+    const a = cx.a;
+    var with: std.ArrayList(Value) = .empty;
+    try with.appendSlice(a, history.items);
+    try with.append(a, assistant);
+    const before = prompt_mod.renderIds(srv, cx, .{ .array = try a.dupe(Value, with.items) }, p.input.tools, p.thinking, p.effort, false) catch |e| return lost(e);
+    for (calls, reports) |c, r| try with.append(a, try toolTurn(a, c, r.get("output").?.string));
+    const after = prompt_mod.renderIds(srv, cx, .{ .array = with.items }, p.input.tools, p.thinking, p.effort, true) catch |e| return lost(e);
+    // the history must end at the model's own EOS and stand unchanged under the results: else no exact insert exists
+    const ends = before.len > 0 and std.mem.indexOfScalar(u32, srv.eos, before[before.len - 1]) != null;
+    if (!ends or after.len <= before.len or !std.mem.eql(u32, after[0..before.len], before)) {
+        log.line("warning: compute lane: this template's tool-result turn does not extend the call turn; the reply ends at the call", .{});
+        return null;
+    }
+    return after[before.len..];
+}
+
+fn lost(e: anyerror) chat.Failure!?[]const u32 {
+    if (e == error.OutOfMemory) return error.OutOfMemory;
+    log.line("warning: compute lane: the tool-result turn did not render ({t}); the reply ends at the call", .{e});
+    return null;
+}
+
+/// A finished held segment into the merge: its words, its tokens and the result inserted after it.
+fn note(a: Allocator, m: *Merge, g: *const Generation, seg: chat.Reply, inserted: []const u32) Allocator.Error!void {
+    try m.content.appendSlice(a, (try tool_parse.parse(a, seg.content, g.tools, null)).content);
+    if (seg.reasoning) |r| try m.reasoning.appendSlice(a, r);
+    m.completion += seg.completion_tokens;
+    m.reasoning_tokens += seg.reasoning_tokens;
+    try m.ids.appendSlice(a, g.collected.items);
+    try m.ids.appendSlice(a, inserted);
+    m.inserted += inserted.len;
+}
+
+/// The last segment's reply with the earlier segments' words, counts, calls and tokens in front.
+fn merge(a: Allocator, m: *Merge, last: chat.Reply, last_ids: []const u32) chat.Failure!chat.Reply {
+    var r = last;
+    if (m.content.items.len > 0) r.content = try std.mem.concat(a, u8, &.{ m.content.items, last.content });
+    if (m.reasoning.items.len > 0) r.reasoning = try std.mem.concat(a, u8, &.{ m.reasoning.items, last.reasoning orelse "" });
+    r.completion_tokens += m.completion;
+    r.reasoning_tokens += m.reasoning_tokens;
+    if (m.calls.items.len == 0 and m.inserted == 0) return r;
+    const rt = r.runtime.object;
+    const tail = if (rt.get("token_ids")) |t| t.array else &[_]Value{};
+    const full = try a.alloc(Value, m.ids.items.len + tail.len);
+    for (m.ids.items, full[0..m.ids.items.len]) |t, *slot| slot.* = try json.intValue(a, t);
+    @memcpy(full[m.ids.items.len..], tail);
+    if (rt.get("token_ids") != null) try rt.put(a, "token_ids", .{ .array = full });
+    // the shas hash the same whole continuation the ids list, inserted results included
+    const all = try std.mem.concat(a, u32, &.{ m.ids.items, last_ids });
+    const tokens = @import("tokens.zig");
+    try rt.put(a, "token_sha", .{ .string = try a.dupe(u8, &tokens.tokenSha(all)) });
+    try rt.put(a, "token_sha256", .{ .string = try a.dupe(u8, &tokens.tokenSha256(all)) });
+    const c = try json.newObject(a);
+    try c.put(a, "calls", .{ .array = m.calls.items });
+    try c.put(a, "inserted_tokens", try json.intValue(a, m.inserted));
+    try c.put(a, "prefix_tokens", try json.intValue(a, m.ids.items.len));
+    try rt.put(a, "compute", .{ .object = c });
+    return r;
+}
diff --git a/zig/src/server/compute_turns.zig b/zig/src/server/compute_turns.zig
new file mode 100644
index 0000000000000000000000000000000000000000..50550500fe2129a106c182f7a6acb76dcc3bbed6
--- /dev/null
+++ b/zig/src/server/compute_turns.zig
@@ -0,0 +1,182 @@
+//! The compute lane's request side: the built-in `python` tool a request opts into, arming, and the client's view.
+const std = @import("std");
+const api = @import("engine_api");
+const json = @import("json");
+const errors = @import("errors.zig");
+const chat = @import("chat.zig");
+const tool_specs = @import("tool_specs.zig");
+const Server = @import("server.zig").Server;
+const lane = api.compute_lane;
+const Value = json.Value;
+const Cx = errors.Cx;
+const Allocator = std.mem.Allocator;
+
+/// The built-in tool's name, the type a request lists to opt in, and its description (which marks it as ours).
+pub const name = "python";
+pub const opt_in = "code_interpreter";
+const description = "Run Python 3 code in a sandbox with no network, no files and no installs, and get its stdout and " ++
+    "stderr. print() what you need; the value of a final bare expression is printed too.";
+const definition =
+    \\{"type":"function","function":{"name":"python","description":"
+++ description ++
+    \\","parameters":{"type":"object","properties":{"code":{"type":"string","description":"Python 3 source to run"}},"required":["code"]}}}
+;
+
+/// The server's sandbox pool for an engine that serves the lane; boot fails when an opted-in sandbox cannot run.
+pub fn open(srv: *Server, cfg: lane.Config) !lane.Pool {
+    if (srv.engine.vtable.resume_held == null) {
+        std.log.err("compute lane: this engine cannot hold a reply for a tool result", .{});
+        return error.ComputeLaneUnsupported;
+    }
+    var pool = lane.Pool.init(cfg, &.{ "/proc/self/exe", "__compute_sandbox" });
+    var arena: std.heap.ArenaAllocator = .init(srv.gpa);
+    defer arena.deinit();
+    pool.selfTest(arena.allocator()) catch |e| {
+        std.log.err("compute lane: the sandbox self-test failed ({t}); unset the compute lane flag or fix the sandbox", .{e});
+        return error.ComputeLaneUnavailable;
+    };
+    std.log.info("compute lane: {s} in a sandbox, {d} at a time, {d} ms, {d} MiB, results up to {d} tokens, {d} calls a reply", .{ cfg.python, cfg.workers, cfg.max_ms, cfg.mem_mb, cfg.max_result_tokens, cfg.max_calls });
+    return pool;
+}
+
+/// The request's tools as tool_specs reads them, with `{"type": "code_interpreter"}` turned into the built-in tool.
+pub fn tools(srv: *Server, cx: *Cx, raw: ?Value, choice: ?Value) errors.Refused![]Value {
+    const list = (raw orelse return tool_specs.active(cx, raw, choice));
+    if (list != .array) return tool_specs.active(cx, raw, choice);
+    var rest: std.ArrayList(Value) = .empty;
+    var asked = false;
+    for (list.array) |t| {
+        const kind = if (t == .object) t.strField("type") orelse "" else "";
+        if (std.mem.eql(u8, kind, opt_in)) asked = true else try rest.append(cx.a, t);
+    }
+    if (!asked) return tool_specs.active(cx, raw, choice);
+    if (srv.compute == null) return cx.other("code_interpreter is not enabled on this server");
+    const specs = try tool_specs.active(cx, .{ .array = rest.items }, choice);
+    for (specs) |t| if (std.mem.eql(u8, toolName(t), name)) return cx.other("a request with code_interpreter cannot also offer a function named python");
+    // only an automatic choice lets the model call it: "none", "required" and a named function leave it out
+    if (choice) |c| if (!(c == .null or (c == .string and std.mem.eql(u8, c.string, "auto")))) return specs;
+    const built = switch (try json.parse(cx.a, definition)) {
+        .ok => |v| v,
+        .err => unreachable,
+    };
+    return std.mem.concat(cx.a, Value, &.{ specs, &.{built} });
+}
+
+fn toolName(t: Value) []const u8 {
+    const f = t.get("function") orelse return "";
+    return f.strField("name") orelse "";
+}
+
+/// Whether `t` is the built-in tool (its name and our description), as `tools` added it.
+pub fn isBuiltIn(t: Value) bool {
+    const f = t.get("function") orelse return false;
+    return std.mem.eql(u8, f.strField("name") orelse "", name) and std.mem.eql(u8, f.strField("description") orelse "", description);
+}
+
+/// Whether a call names the built-in tool.
+pub fn isBuiltInCall(call: Value) bool {
+    return std.mem.eql(u8, toolName(call), name);
+}
+
+/// Whether a prepared request holds at its EOS for the lane: offered the tool, nothing that forced rows would break.
+pub fn arms(srv: *const Server, input: chat.Input, r: *const api.Request) bool {
+    if (srv.compute == null or r.eos.len == 0 or r.background or r.max_tokens == 0) return false;
+    if (r.structure != null or r.call != null or r.logprobs != null or r.prompt_logprobs != null) return false;
+    for (input.tools) |t| if (isBuiltIn(t)) return true;
+    return false;
+}
+
+/// A lane reply as the client streams it: built-in calls stay hidden; client calls number on across segments.
+pub const Filter = struct {
+    a: Allocator,
+    inner: chat.Sink,
+    base: i64 = 0, // client calls earlier segments showed
+    seen: i64 = 0, // client calls this segment showed
+    map: std.AutoHashMapUnmanaged(i64, ?i64) = .empty, // this segment's call index -> the client's (null: built-in)
+
+    pub fn sink(f: *Filter) chat.Sink {
+        return .{ .ctx = f, .call = call, .begin = if (f.inner.begin != null) begin else null };
+    }
+
+    /// A resumed segment numbers its calls from 0 again.
+    pub fn nextSegment(f: *Filter) void {
+        f.base += f.seen;
+        f.seen = 0;
+        f.map.clearRetainingCapacity();
+    }
+
+    /// A delta straight to the client (the lane's own reports).
+    pub fn direct(f: *Filter, delta: Value) error{Closed}!void {
+        return f.inner.call(f.inner.ctx, delta);
+    }
+
+    fn begin(ctx: *anyopaque, prompt_len: usize) error{Closed}!void {
+        const f: *Filter = @ptrCast(@alignCast(ctx));
+        return f.inner.begin.?(f.inner.ctx, prompt_len);
+    }
+
+    fn call(ctx: *anyopaque, delta: Value) error{Closed}!void {
+        const f: *Filter = @ptrCast(@alignCast(ctx));
+        const list = if (delta == .object) delta.get("tool_calls") else null;
+        if (list == null or list.? != .array) return f.inner.call(f.inner.ctx, delta);
+        var kept: std.ArrayList(Value) = .empty;
+        for (list.?.array) |one| {
+            const at = (one.get("index") orelse continue).int64() orelse continue;
+            if (one.get("function")) |fun| if (fun.strField("name")) |n| if (!f.map.contains(at)) {
+                const client: ?i64 = if (std.mem.eql(u8, n, name)) null else f.base + f.seen;
+                if (client != null) f.seen += 1;
+                f.map.put(f.a, at, client) catch return error.Closed;
+            };
+            const to = (f.map.get(at) orelse continue) orelse continue;
+            if (one != .object) continue;
+            one.object.put(f.a, "index", json.intValue(f.a, to) catch return error.Closed) catch return error.Closed;
+            kept.append(f.a, one) catch return error.Closed;
+        }
+        if (kept.items.len == 0) return;
+        delta.object.put(f.a, "tool_calls", .{ .array = kept.items }) catch return error.Closed;
+        return f.inner.call(f.inner.ctx, delta);
+    }
+};
+
+test "the filter drops built-in call deltas and numbers client calls on across segments" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const Seen = struct {
+        out: std.ArrayList([]const u8) = .empty,
+        a: Allocator,
+        fn call(ctx: *anyopaque, delta: Value) error{Closed}!void {
+            const s: *@This() = @ptrCast(@alignCast(ctx));
+            s.out.append(s.a, json.stringify(s.a, delta, .{}) catch return error.Closed) catch return error.Closed;
+        }
+    };
+    var seen: Seen = .{ .a = a };
+    var f: Filter = .{ .a = a, .inner = .{ .ctx = &seen, .call = Seen.call } };
+    const s = f.sink();
+    const deltas = [_][]const u8{
+        \\{"tool_calls":[{"index":0,"id":"a","type":"function","function":{"name":"python","arguments":""}}]}
+        ,
+        \\{"tool_calls":[{"index":0,"function":{"arguments":"print(1)"}}]}
+        ,
+        \\{"tool_calls":[{"index":1,"id":"b","type":"function","function":{"name":"lookup","arguments":"{}"}}]}
+        ,
+    };
+    for (deltas) |d| try s.call(s.ctx, (try json.parse(a, d)).ok);
+    try s.call(s.ctx, .{ .string = "prose" });
+    f.nextSegment();
+    try s.call(s.ctx, (try json.parse(a, deltas[2])).ok);
+    try std.testing.expectEqual(@as(usize, 3), seen.out.items.len);
+    try std.testing.expect(std.mem.indexOf(u8, seen.out.items[0], "\"index\": 0") != null);
+    try std.testing.expect(std.mem.indexOf(u8, seen.out.items[0], "lookup") != null);
+    try std.testing.expectEqualStrings("\"prose\"", seen.out.items[1]);
+    try std.testing.expect(std.mem.indexOf(u8, seen.out.items[2], "\"index\": 1") != null);
+}
+
+test "the built-in definition parses and is recognized; another function named python is not" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const built = (try json.parse(arena.allocator(), definition)).ok;
+    try std.testing.expect(isBuiltIn(built));
+    const other = (try json.parse(arena.allocator(), "{\"type\":\"function\",\"function\":{\"name\":\"python\"}}")).ok;
+    try std.testing.expect(!isBuiltIn(other));
+}
diff --git a/zig/src/server/generation.zig b/zig/src/server/generation.zig
new file mode 100644
index 0000000000000000000000000000000000000000..6bf62b0e056bfd50187095daa15c99210832b18d
--- /dev/null
+++ b/zig/src/server/generation.zig
@@ -0,0 +1,384 @@
+//! The token loop of one reply segment and the text it streams (chat.zig submits; compute_turns.zig resumes).
+const std = @import("std");
+const api = @import("engine_api");
+const json = @import("json");
+const errors = @import("errors.zig");
+const reply_text = @import("reply_text.zig");
+const tool_stream = @import("tool_stream.zig");
+const tool_parse = @import("tool_parse.zig");
+const tool_lfm2 = @import("tool_lfm2.zig");
+const log = @import("log.zig");
+const clock = @import("clock.zig");
+const chat = @import("chat.zig");
+const Server = @import("server.zig").Server;
+const Mailbox = @import("mailbox.zig").Mailbox;
+const Value = json.Value;
+const Cx = errors.Cx;
+const Allocator = std.mem.Allocator;
+const Sink = chat.Sink;
+const Reply = chat.Reply;
+const Failure = chat.Failure;
+const deltaOf = chat.deltaOf;
+const nowNs = clock.nowNs;
+const seconds = clock.seconds;
+
+/// The token loop and the text it streams.
+pub const Generation = struct {
+    srv: *Server,
+    a: Allocator,
+    box: *Mailbox,
+    id: api.Id,
+    reply_id: []const u8, // the id the client gets, which the done line prints
+    seed: ?u64 = null,
+    sink: ?Sink,
+    thinking: bool,
+    stops: reply_text.Stops,
+    ignore_eos: bool,
+    max_tokens: u32,
+    token_ids: bool, // "return_token_ids": the response's tensorfold block carries the reply's token ids
+    tools: []const Value,
+    calls: ?tool_stream.Streamer = null,
+    collected: std.ArrayList(u32) = .empty,
+    visible: reply_text.Incremental = .{},
+    hidden: std.ArrayList(u8) = .empty, // reused for the answer without its call blocks
+    streamed: reply_text.Shown = .{}, // what content streamed, kept apart from the decode buffer that grows under slices
+    streamed_reasoning: reply_text.Shown = .{},
+    streaming_done: bool = false,
+    wrote_ns: ?i96 = null,
+    first_ns: ?i96 = null,
+    last_ns: ?i96 = null,
+    reason: ?[]const u8 = null, // the server ended the reply (a stop string, the length) before the engine said so
+    engine_done: bool = false,
+    consumed: usize = 0,
+    chunk_index: usize = 0,
+    lp: ?@import("logprobs.zig").Stream = null, // the request asked for logprobs: its rows, copied with each round
+    loop_stop: bool = false, // --loop-guard-stop: the engine ends the reply where the loop guard fires
+    hold: bool = false, // the engine holds the reply at an EOS (Request.hold_eos): this segment ends there
+    held: bool = false, // it did: the engine has not finished, and compute_turns.zig resumes or ends it
+    skip: []const u32 = &.{}, // a resumed segment's first tokens: the inserted tool result, checked and not shown
+
+    fn eos(g: *const Generation, t: u32) bool {
+        return !g.ignore_eos and std.mem.indexOfScalar(u32, g.srv.eos, t) != null;
+    }
+
+    /// Close a tool call left open at the model end token, except when another stop condition ended the reply.
+    fn closeCall(g: *const Generation, text: []const u8) Allocator.Error![]const u8 {
+        const t = g.collected.items;
+        if (g.tools.len == 0 or t.len == 0 or !g.eos(t[t.len - 1])) return "";
+        return tool_parse.closeCall(g.a, text, g.tools);
+    }
+
+    /// The engine's stop check, here: the newest tokens' text holds a stop string.
+    fn stopHit(g: *Generation) Allocator.Error!bool {
+        if (g.stops.strings.len == 0) return false;
+        const t = g.collected.items;
+        const tail = t[t.len -| g.stops.tail()..];
+        const text = try g.srv.text.decode(g.a, tail);
+        for (g.stops.strings) |s| if (std.mem.indexOf(u8, text, s) != null) return true;
+        return false;
+    }
+
+    /// Commits a round's tokens as ``LaneStream.commit`` would, then streams what they add.
+    fn commit(g: *Generation, chunk: []const u32) Failure!void {
+        var landed: usize = 0;
+        for (chunk) |t| {
+            if (g.reason != null) break;
+            try g.collected.append(g.a, t);
+            landed += 1;
+            if (g.eos(t)) {
+                g.reason = "stop";
+                g.held = g.hold;
+            } else if (try g.stopHit()) {
+                g.reason = "stop";
+                g.srv.engine.cancel(g.id); // the engine ends EOS and length itself; a stop string is the server's
+            } else if (g.collected.items.len >= g.max_tokens) g.reason = "length";
+        }
+        if (landed == 0) return;
+        const arrived = nowNs(g.srv.io);
+        if (g.first_ns == null) g.first_ns = arrived;
+        g.last_ns = arrived;
+        const sink = g.sink orelse return;
+        if (g.streaming_done) return;
+        var fresh: std.ArrayList(u32) = .empty;
+        for (chunk[0..landed]) |t| {
+            if (g.eos(t)) {
+                g.streaming_done = true;
+                break;
+            }
+            try fresh.append(g.a, t);
+        }
+        const all = try g.visible.extend(g.a, g.srv.text, reply_text.decodeText, fresh.items);
+        const text = g.stops.visible(all, true);
+        if (g.visible.pending()) return; // a character still split across tokens
+        var answer = text;
+        if (g.thinking) {
+            const close = try g.visible.closeOf(g.a, reply_text.decodeText, g.srv.text, g.srv.close_id);
+            const split = try reply_text.splitThinkingAt(g.a, text, false, g.srv.markers, close);
+            const piece = g.streamed_reasoning.after(split.reasoning, true);
+            if (piece.len > 0) {
+                try g.streamed_reasoning.set(g.a, split.reasoning, piece);
+                try g.emit(sink, try deltaOf(g.a, "reasoning_content", piece));
+            }
+            answer = split.answer;
+        }
+        answer = try tool_lfm2.dsml(g.a, answer, g.tools, false); // the answer only, so a call the reasoning mentions is not made
+        const shown = if (g.calls != null) try reply_text.hideInto(g.a, &g.hidden, answer, false, true) else answer;
+        const vis = reply_text.heldBack(reply_text.streamingVisible(shown), g.calls != null);
+        const copied = @intFromPtr(vis.ptr) >= @intFromPtr(g.hidden.items.ptr) and @intFromPtr(vis.ptr) <= @intFromPtr(g.hidden.items.ptr) + g.hidden.items.len;
+        const delta = g.streamed.after(vis, !copied);
+        if (delta.len > 0) {
+            try g.streamed.set(g.a, vis, delta);
+            try g.emit(sink, if (g.lp) |*l| (try l.delta(g.srv, g.a, g.thinking, g.ignore_eos, g.collected.items, delta, g.streamed.text.items.len, false)).? else .{ .string = delta });
+        }
+        if (g.calls) |*c| {
+            var out: std.ArrayList(Value) = .empty;
+            try c.feed(answer, &out); // never the reasoning: a call it mentions is not made
+            for (out.items) |d| try g.emit(sink, d);
+        }
+    }
+
+    fn emit(g: *Generation, sink: Sink, delta: Value) Failure!void {
+        sink.call(sink.ctx, delta) catch {
+            g.cancel();
+            return error.Cancelled;
+        };
+        g.wrote_ns = nowNs(g.srv.io);
+    }
+
+    /// End the request and wait for the engine; unfinished requests count as disconnects.
+    pub fn cancel(g: *Generation) void {
+        if (!g.engine_done) g.srv.engine.cancel(g.id);
+        g.drain();
+        if (g.box.reason == .cancelled and g.reason == null) g.srv.metrics.disconnected(g.srv.io);
+    }
+
+    /// Waits for the engine's own end, so the request it holds may be freed.
+    pub fn drain(g: *Generation) void {
+        const m = g.box;
+        m.mutex.lockUncancelable(m.io);
+        defer m.mutex.unlock(m.io);
+        while (!m.finished) m.cond.waitUncancelable(m.io, &m.mutex);
+        g.engine_done = true;
+    }
+
+    /// Takes rounds until the reply ends; a client that leaves cancels it.
+    pub fn loop(g: *Generation, gone: anytype) Failure!void {
+        const Gone = switch (@typeInfo(@TypeOf(gone))) {
+            .pointer => |p| p.child,
+            else => @TypeOf(gone),
+        };
+        const m = g.box;
+        while (true) {
+            m.mutex.lockUncancelable(m.io);
+            var chunk: ?[]u32 = null;
+            var ended = false;
+            if (g.chunk_index < m.chunks.items.len) {
+                const end = m.chunks.items[g.chunk_index];
+                chunk = g.a.dupe(u32, m.tokens.items[g.consumed..end]) catch |e| {
+                    m.mutex.unlock(m.io);
+                    return e;
+                };
+                if (g.lp) |*l| l.rows.appendSlice(g.a, m.rows.items[g.consumed..end]) catch |e| {
+                    g.a.free(chunk.?);
+                    m.mutex.unlock(m.io);
+                    return e;
+                };
+                g.chunk_index += 1;
+                g.consumed = end;
+            } else if (m.finished) {
+                ended = true;
+            } else {
+                m.cond.waitTimeout(m.io, &m.mutex, .{ .duration = .{ .raw = .fromMilliseconds(50), .clock = .awake } }) catch {};
+            }
+            m.mutex.unlock(m.io);
+            if (ended) {
+                g.engine_done = true;
+                return;
+            }
+            if (gone.check()) {
+                g.cancel();
+                return error.Cancelled;
+            }
+            if (chunk == null and @hasDecl(Gone, "beat")) {
+                // queueing and a long prefill send nothing: a client that times out a silent stream would leave
+                const now = nowNs(g.srv.io);
+                const since = g.wrote_ns orelse now;
+                if (g.wrote_ns == null) g.wrote_ns = now;
+                if (gone.beat(now - since) catch {
+                    g.cancel();
+                    return error.Cancelled;
+                }) g.wrote_ns = now;
+            }
+            const tokens = try g.skipInserted(chunk orelse continue);
+            if (g.reason == null) try g.commit(tokens);
+            if (g.held) return;
+        }
+    }
+
+    /// Drops the inserted result that opens a resumed segment; a different token there fails the reply.
+    fn skipInserted(g: *Generation, tokens: []u32) Failure![]u32 {
+        const n = @min(tokens.len, g.skip.len);
+        if (!std.mem.eql(u32, tokens[0..n], g.skip[0..n])) {
+            log.line("error: {s}: the engine's tokens after a tool result are not the result it was given", .{g.reply_id});
+            g.cancel();
+            return error.Failed;
+        }
+        g.skip = g.skip[n..];
+        return tokens[n..];
+    }
+
+    pub fn finish(g: *Generation, cx: *Cx, prompt_len: usize, received: i96, thinking: bool, effort: ?[]const u8, exact: bool, drafts: bool) Failure!Reply {
+        const a = g.a;
+        const m = g.box;
+        if (!g.engine_done and !g.held) g.drain();
+        const ended: []const u8 = g.reason orelse switch (m.reason) {
+            .stop => "stop",
+            .length => "length",
+            .silence => return cx.other("the text engine returned a speech-only finish reason"),
+            .cancelled => "cancelled",
+            .failed => return cx.other(if (m.message.len > 0) try a.dupe(u8, m.message) else "the reply failed"),
+        };
+        const stopped: ?u32 = if (g.loop_stop) m.stats.loop_period else null;
+        const reason = if (stopped != null) @import("loop_stop.zig").finish_reason else ended;
+        const finished_ns = nowNs(g.srv.io);
+        const content_tokens = if (g.ignore_eos) g.collected.items else reply_text.stripTrailing(g.collected.items, g.srv.eos);
+        const raw = try g.srv.text.decode(a, content_tokens);
+        const visible = g.stops.visible(raw, false);
+        // closed before the think split, so a call ending an unclosed think block is the answer
+        const close = try g.closeCall(visible);
+        const text = if (close.len > 0) try std.mem.concat(a, u8, &.{ visible, close }) else visible;
+        var content: []const u8 = text;
+        var reasoning: ?[]const u8 = null;
+        if (g.thinking) {
+            const split = try reply_text.splitThinkingTokens(a, reply_text.decodeText, g.srv.text, text, true, g.srv.markers, content_tokens, g.srv.close_id);
+            const r = reply_text.pyStrip(split.reasoning);
+            reasoning = if (r.len > 0) r else null;
+            content = split.answer;
+        } else {
+            const h = reply_text.parseHarmony(text);
+            content = h.content;
+            reasoning = h.reasoning;
+        }
+        content = try tool_lfm2.dsml(a, content, g.tools, true);
+        if (g.sink) |sink| {
+            const thought = g.streamed_reasoning.text.items;
+            if (reasoning) |r| if (std.mem.startsWith(u8, r, thought) and r.len > thought.len)
+                try g.emit(sink, try deltaOf(a, "reasoning_content", r[thought.len..]));
+            const shown = if (g.calls != null) try tool_stream.endProse(a, content, if (g.thinking) content else text, g.tools, reason) else content;
+            const sent = g.streamed.text.items;
+            const rest = if (std.mem.startsWith(u8, shown, sent) and shown.len > sent.len) shown[sent.len..] else "";
+            if (g.lp) |*l| (if (try l.delta(g.srv, a, g.thinking, g.ignore_eos, g.collected.items, rest, shown.len, true)) |d| try g.emit(sink, d)) else if (rest.len > 0) try g.emit(sink, .{ .string = rest });
+            if (g.calls) |*c| if (close.len > 0 or std.mem.eql(u8, reason, "length")) {
+                // the streamer reads the closers as markup the model wrote, so the call ends with the same deltas
+                var out: std.ArrayList(Value) = .empty;
+                try c.finishCut(if (g.thinking) content else text, &out); // a cut value sends its held bytes
+                for (out.items) |d| try g.emit(sink, d);
+            };
+        }
+        const prefilled = m.prefilled_ns;
+        const decode_s: f64 = if (prefilled) |p| @max(0, seconds(finished_ns - p)) else 0;
+        const decode_tokens = g.collected.items.len -| 1;
+        const runtime = try json.newObject(a);
+        try runtime.put(a, "enable_thinking", .{ .bool = thinking });
+        try runtime.put(a, "reasoning_effort", if (!thinking) .{ .string = "none" } else if (effort) |e| .{ .string = e } else .null);
+        try runtime.put(a, "engine", .{ .string = g.srv.info.name });
+        try runtime.put(a, "tokens_per_second", .{ .float = if (decode_s > 0) @as(f64, @floatFromInt(decode_tokens)) / decode_s else 0 });
+        try runtime.put(a, "seconds", .{ .float = @max(0, decode_s) }); // the reply's decode seconds, as tokens_per_second divides them
+        if (m.stats.gpu_seconds) |gpu| try runtime.put(a, "gpu_seconds", .{ .float = gpu }); // TF_Q27_PROFILE only
+        try runtime.put(a, "prefill_seconds", if (m.stats.prefill_seconds) |p| .{ .float = p } else .null);
+        const widths = try a.alloc(Value, m.widths.len);
+        for (m.widths, widths) |w, *slot| slot.* = try json.intValue(a, w);
+        try runtime.put(a, "prefill_widths", .{ .array = widths });
+        const raised = try a.alloc(Value, m.raised.len);
+        for (m.raised, raised) |r, *slot| slot.* = .{ .bool = r };
+        try runtime.put(a, "prefill_raised", .{ .array = raised });
+        try runtime.put(a, "time_to_first_token", if (g.first_ns) |t| .{ .float = seconds(t - received) } else .null);
+        try runtime.put(a, "sampling", .{ .string = if (exact) "exact" else "greedy" });
+        try runtime.put(a, "drafts", .{ .bool = drafts });
+        const sha = @import("tokens.zig").tokenSha(g.collected.items);
+        try runtime.put(a, "token_sha", .{ .string = try a.dupe(u8, &sha) });
+        const sha256 = @import("tokens.zig").tokenSha256(g.collected.items);
+        try runtime.put(a, "token_sha256", .{ .string = try a.dupe(u8, &sha256) });
+        // "return_token_ids": the reply's tokens, the same slice the shas above hash, so ids and sha cannot disagree
+        if (g.token_ids) {
+            const reply_ids = try a.alloc(Value, g.collected.items.len);
+            for (g.collected.items, reply_ids) |t, *slot| slot.* = try json.intValue(a, t);
+            try runtime.put(a, "token_ids", .{ .array = reply_ids });
+        }
+        try runtime.put(a, "min_rows", try json.intValue(a, m.stats.min_rows));
+        if (m.stats.loop_period) |period| {
+            const loop_field = try json.newObject(a);
+            try loop_field.put(a, "period", try json.intValue(a, period));
+            if (stopped != null) try loop_field.put(a, "stopped", .{ .bool = true });
+            try runtime.put(a, "loop", .{ .object = loop_field });
+        }
+        const s = m.stats;
+        const spec = try json.newObject(a);
+        try spec.put(a, "rounds", try json.intValue(a, s.rounds));
+        try spec.put(a, "drafted", try json.intValue(a, s.drafted));
+        try spec.put(a, "accepted", try json.intValue(a, s.accepted));
+        try spec.put(a, "acceptance_rate", .{ .float = if (s.drafted > 0) @as(f64, @floatFromInt(s.accepted)) / @as(f64, @floatFromInt(s.drafted)) else 0 });
+        try spec.put(a, "tokens_per_round", .{ .float = if (s.rounds > 0) @as(f64, @floatFromInt(g.collected.items.len)) / @as(f64, @floatFromInt(s.rounds)) else 0 });
+        const counters = try a.dupe(u8, m.telemetry); // parsed strings point into it: it outlives the box
+        if (counters.len > 0) switch (try json.parse(a, counters)) {
+            .ok => |v| try spec.put(a, "proposer", v),
+            .err => {},
+        };
+        const think_end: ?u32 = if (thinking) g.srv.text.tokenId(g.srv.markers.close) else null;
+        const reply: Reply = .{
+            .content = content,
+            .stop_sequence = g.stops.matched(raw),
+            .reasoning = reasoning,
+            .tool_calls_streamed = g.calls != null and g.calls.?.streamed,
+            .finish_reason = reason,
+            .prompt_tokens = prompt_len,
+            .cached_tokens = m.cached orelse 0,
+            .completion_tokens = g.collected.items.len,
+            .reasoning_tokens = reply_text.reasoningCount(g.collected.items, think_end),
+            .runtime = .{ .object = runtime },
+            .speculative = .{ .object = spec },
+            .thinking = thinking,
+            .effort = effort,
+            .logprobs = if (g.lp) |l| try @import("logprobs.zig").value(g.srv, cx, a, g.thinking, content_tokens, l.rows.items) else null,
+            .prompt_logprobs = if (m.prompt_rows) |r| try @import("logprobs.zig").promptValue(g.srv, a, r) else null,
+            .loop_stop = stopped,
+        };
+        if (std.mem.eql(u8, reason, "length") and thinking and reply_text.pyStrip(content).len == 0)
+            log.line("warning: a reply reached max_tokens while still thinking, so its content is empty and its text is all in reasoning_content; raise max_tokens, or send chat_template_kwargs {{\"enable_thinking\": false}} (server: --no-thinking)", .{});
+        var cycle_text: [32]u8 = undefined;
+        const cycle = if (s.loop_period) |period| std.fmt.bufPrint(&cycle_text, " loop=period:{d}", .{period}) catch "" else "";
+        const done_ns = nowNs(g.srv.io);
+        const ttft_s = if (g.first_ns) |at| @max(0, seconds(at - received)) else 0;
+        const decode_log_s = if (g.first_ns) |at| @max(0, seconds(done_ns - at)) else 0;
+        var seed_text: [32]u8 = undefined;
+        const seed = if (g.seed) |v| std.fmt.bufPrint(&seed_text, " seed={d}", .{v}) catch unreachable else "";
+        const rate = if (decode_log_s > 0) @as(f64, @floatFromInt(decode_tokens)) / decode_log_s else 0;
+        log.line("done {s} prompt={d} cached={d} thinking={s} effort={s} tokens={d} sha={s} finish={s}{s} rounds={d} accepted={d}/{d} ttft={d:.3} decode={d:.3} elapsed={d:.3} queued={d:.3} tok/s={d:.1}{s}", .{ g.reply_id, prompt_len, reply.cached_tokens, if (thinking) "True" else "False", if (thinking) effort orelse "none" else "none", g.collected.items.len, sha, reason, cycle, s.rounds, s.accepted, s.drafted, ttft_s, decode_log_s, @max(0, seconds(done_ns - received)), s.queued_seconds, rate, seed });
+        return reply;
+    }
+};
+
+test "Server recovery: token staging allocation failure ends the loop without consuming tokens" {
+    for (0..2) |fail_index| {
+        var m: Mailbox = .{ .io = std.testing.io, .gpa = std.testing.allocator, .finished = true };
+        defer m.deinit();
+        try m.tokens.append(std.testing.allocator, 42);
+        try m.chunks.append(std.testing.allocator, 1);
+        try m.rows.append(std.testing.allocator, .{ .token = 42, .logprob = -1 });
+        var failing = std.testing.FailingAllocator.init(std.testing.allocator, .{ .fail_index = fail_index });
+        var g: Generation = undefined;
+        g.a = failing.allocator();
+        g.box = &m;
+        g.chunk_index = 0;
+        g.consumed = 0;
+        g.lp = .{};
+        const Gone = struct {
+            pub fn check(_: @This()) bool {
+                return false;
+            }
+        };
+        try std.testing.expectError(error.OutOfMemory, g.loop(Gone{}));
+        try std.testing.expectEqual(@as(usize, 0), g.consumed);
+        try std.testing.expectEqual(@as(usize, 0), g.chunk_index);
+    }
+}
