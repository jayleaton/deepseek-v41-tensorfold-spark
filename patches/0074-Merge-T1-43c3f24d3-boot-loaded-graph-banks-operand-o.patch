index 0000000000000000000000000000000000000000..a5dab82a66639cab3ae86ece146be90005f73a0e
--- /dev/null
+++ b/zig/src/core/runner_graph.zig
@@ -0,0 +1,192 @@
+//! Bounded graph workers over a boot-loaded bank; the engine thread never waits for a running job.
+const std = @import("std");
+const api = @import("runner_api.zig");
+pub const Bank = @import("runner_graph_bank.zig").Bank;
+pub const Machine = @import("runner_graph_machine.zig").Machine;
+pub const Packet = @import("runner_graph_packet.zig").Packet;
+pub const Op = @import("runner_graph_packet.zig").Op;
+pub const Plan = @import("runner_graph_packet.zig").Plan;
+pub const Builder = @import("runner_graph_packet.zig").Builder;
+pub const id = "graph";
+
+const Allocator = std.mem.Allocator;
+
+const Job = struct {
+    id: api.JobId,
+    stream: u64,
+    program: []u8,
+    graph: bool,
+    budget: u64,
+    thread: ?std.Thread = null,
+    done: std.atomic.Value(bool) = .init(false),
+    cancel: std.atomic.Value(bool) = .init(false),
+    result: api.Result = .{ .status = .abstain, .abstain = .unsupported },
+    out: std.ArrayList(u8) = .empty,
+};
+
+const Cpu = struct {
+    gpa: Allocator,
+    bank: *const Bank,
+    workers: u8,
+    next_id: api.JobId = 1,
+    jobs: std.ArrayList(*Job) = .empty,
+    dropped: std.ArrayList(*Job) = .empty,
+    delivered: std.ArrayList(*Job) = .empty,
+
+    fn live(c: *Cpu) usize {
+        return c.jobs.items.len + c.dropped.items.len;
+    }
+
+    fn free(c: *Cpu, j: *Job) void {
+        if (j.thread) |t| t.join();
+        j.out.deinit(c.gpa);
+        c.gpa.free(j.program);
+        c.gpa.destroy(j);
+    }
+
+    /// Joins and frees cancelled jobs whose worker has stopped.
+    fn reap(c: *Cpu) void {
+        var i: usize = 0;
+        while (i < c.dropped.items.len) {
+            const j = c.dropped.items[i];
+            if (!j.done.load(.acquire)) {
+                i += 1;
+                continue;
+            }
+            _ = c.dropped.swapRemove(i);
+            c.free(j);
+        }
+    }
+
+    /// `out` of a stream's previous result stays valid only until the next call for that stream.
+    fn forget(c: *Cpu, stream: u64) void {
+        var i: usize = 0;
+        while (i < c.delivered.items.len) {
+            if (c.delivered.items[i].stream != stream) {
+                i += 1;
+                continue;
+            }
+            c.free(c.delivered.swapRemove(i));
+        }
+    }
+
+    fn find(c: *Cpu, job_id: api.JobId) ?usize {
+        for (c.jobs.items, 0..) |j, i| if (j.id == job_id) return i;
+        return null;
+    }
+
+    fn drop(c: *Cpu, i: usize) void {
+        const j = c.jobs.swapRemove(i);
+        j.cancel.store(true, .release);
+        c.dropped.appendAssumeCapacity(j);
+    }
+};
+
+fn work(c: *Cpu, j: *Job) void {
+    var began: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &began);
+    defer {
+        var ended: std.c.timespec = undefined;
+        _ = std.c.clock_gettime(.MONOTONIC, &ended);
+        const ns = (ended.sec - began.sec) * std.time.ns_per_s + ended.nsec - began.nsec;
+        j.result.exec_ns = @intCast(@max(0, ns));
+        j.done.store(true, .release);
+    }
+    if (!j.graph) return;
+    var m = Machine.boot(c.gpa, c.bank, j.program) catch return;
+    defer m.deinit();
+    const end = m.run(j.budget, &j.out, &j.cancel) catch {
+        j.out.clearRetainingCapacity();
+        j.result = .{ .status = .abstain, .abstain = .unsupported, .steps = m.steps };
+        return;
+    };
+    j.result = .{
+        .status = switch (end.end) {
+            .halted => .ok,
+            .budget => .budget,
+            .fault => .fault,
+            .cancelled => .abstain,
+        },
+        .steps = end.steps,
+        .abstain = if (end.end == .cancelled) .unsupported else null,
+    };
+}
+
+fn start(ctx: *anyopaque, stream: u64, program: api.Program, budget: u64) error{ OutOfMemory, Busy }!api.JobId {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    c.reap();
+    c.forget(stream);
+    if (c.live() >= c.workers) return error.Busy;
+    const j = try c.gpa.create(Job);
+    errdefer c.gpa.destroy(j);
+    const valid = std.mem.eql(u8, @tagName(program.kind), id) and
+        program.bytes.len <= @import("runner_graph_packet.zig").max_packet;
+    const bytes = try c.gpa.dupe(u8, if (valid) program.bytes else "");
+    errdefer c.gpa.free(bytes);
+    j.* = .{ .id = c.next_id, .stream = stream, .program = bytes, .graph = valid, .budget = budget };
+    try c.jobs.ensureUnusedCapacity(c.gpa, 1);
+    j.thread = std.Thread.spawn(.{}, work, .{ c, j }) catch return error.Busy;
+    c.jobs.appendAssumeCapacity(j);
+    c.next_id += 1;
+    return j.id;
+}
+
+fn poll(ctx: *anyopaque, job_id: api.JobId) api.Poll {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    c.reap();
+    const i = c.find(job_id) orelse return .{ .done = .{ .status = .abstain, .abstain = .unsupported } };
+    const j = c.jobs.items[i];
+    if (!j.done.load(.acquire)) return .running;
+    _ = c.jobs.swapRemove(i);
+    if (j.thread) |t| t.join();
+    j.thread = null;
+    c.forget(j.stream);
+    c.delivered.append(c.gpa, j) catch {
+        c.free(j);
+        return .{ .done = .{ .status = .abstain, .abstain = .unsupported } };
+    };
+    var r = j.result;
+    r.out = j.out.items;
+    return .{ .done = r };
+}
+
+fn cancel(ctx: *anyopaque, job_id: api.JobId) void {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    if (c.find(job_id)) |i| c.drop(i);
+    c.reap();
+}
+
+fn release(ctx: *anyopaque, stream: u64) void {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    var i: usize = 0;
+    while (i < c.jobs.items.len) {
+        if (c.jobs.items[i].stream == stream) c.drop(i) else i += 1;
+    }
+    c.forget(stream);
+    c.reap();
+}
+
+const vtable: api.Backend.VTable = .{ .start = start, .poll = poll, .cancel = cancel, .release = release };
+
+/// Runs at most workers jobs over a bank the caller keeps alive; gpa must support worker-thread allocations.
+pub fn backend(gpa: Allocator, bank: *const Bank, workers: u8) !api.Backend {
+    if (workers == 0) return error.NoWorkers;
+    const c = try gpa.create(Cpu);
+    errdefer gpa.destroy(c);
+    c.* = .{ .gpa = gpa, .bank = bank, .workers = workers };
+    try c.dropped.ensureTotalCapacity(gpa, workers);
+    errdefer c.dropped.deinit(gpa);
+    try c.jobs.ensureTotalCapacity(gpa, workers);
+    return .{ .ctx = c, .vtable = &vtable };
+}
+
+/// Cancels every job, waits for the workers and frees the backend.
+pub fn destroy(b: api.Backend) void {
+    const c: *Cpu = @ptrCast(@alignCast(b.ctx));
+    for (c.jobs.items) |j| j.cancel.store(true, .release);
+    for ([_]*std.ArrayList(*Job){ &c.jobs, &c.dropped, &c.delivered }) |list| {
+        for (list.items) |j| c.free(j);
+        list.deinit(c.gpa);
+    }
+    c.gpa.destroy(c);
+}
diff --git a/zig/src/core/runner_graph_bank.zig b/zig/src/core/runner_graph_bank.zig
new file mode 100644
index 0000000000000000000000000000000000000000..3a67b24a7982cee3eecd1aba9642afebe0b5aca2
--- /dev/null
+++ b/zig/src/core/runner_graph_bank.zig
@@ -0,0 +1,164 @@
+//! Boot-loaded immutable prepared weights, logical table slots and validated named binding plans.
+const std = @import("std");
+const model = @import("runner_circuit_model.zig");
+const binary = @import("runner_graph_binary.zig");
+const packet = @import("runner_graph_packet.zig");
+const Allocator = std.mem.Allocator;
+const missing = std.math.maxInt(u32);
+pub const Slots = [packet.max_arity][2]u32;
+
+pub const Template = struct {
+    name: []const u8,
+    width: u8,
+    circuit: model.Circuit,
+    inputs: u8,
+    outputs: u8,
+    in_slots: Slots,
+    out_slots: Slots,
+};
+
+const Descriptor = struct {
+    name: []const u8,
+    width: u8,
+    path: []const u8,
+    inputs: ?u8 = null,
+    outputs: ?u8 = null,
+};
+pub const PreparedPlan = struct {
+    name: []const u8,
+    inputs: u32,
+    ops: []const packet.Op,
+    result: u32,
+    constants: []const packet.Value,
+    total_values: usize,
+};
+
+const Manifest = struct {
+    version: u32,
+    templates: []const Descriptor,
+    plans: []const packet.Plan = &.{},
+};
+
+pub const Bank = struct {
+    gpa: Allocator,
+    arena: std.heap.ArenaAllocator,
+    templates: []Template,
+    plans: []const PreparedPlan,
+
+    pub fn load(a: Allocator, path: []const u8) !Bank {
+        var threaded: std.Io.Threaded = .init_single_threaded;
+        const bytes = try std.Io.Dir.cwd().readFileAlloc(threaded.io(), path, a, .limited(32 << 20));
+        defer a.free(bytes);
+        var arena = std.heap.ArenaAllocator.init(a);
+        errdefer arena.deinit();
+        const doc = try std.json.parseFromSliceLeaky(Manifest, arena.allocator(), bytes, .{ .allocate = .alloc_always });
+        if (doc.version != 1 or doc.templates.len == 0 or doc.templates.len > 256) return error.GraphManifest;
+        const templates = try arena.allocator().alloc(Template, doc.templates.len);
+        var loaded: usize = 0;
+        errdefer for (templates[0..loaded]) |*t| t.circuit.deinit(a);
+        for (doc.templates, templates) |d, *t| {
+            if (!packet.widthValid(d.width) or d.name.len == 0) return error.GraphTemplate;
+            for (templates[0..loaded]) |prior| if (prior.width == d.width and std.mem.eql(u8, prior.name, d.name))
+                return error.GraphDuplicateTemplate;
+            const resolved = if (std.fs.path.isAbsolute(d.path)) try a.dupe(u8, d.path) else try std.fs.path.join(a, &.{ std.fs.path.dirname(path) orelse ".", d.path });
+            defer a.free(resolved);
+            t.* = .{ .name = d.name, .width = d.width, .circuit = try binary.load(a, resolved, d.name, d.width), .inputs = 0, .outputs = 0, .in_slots = @splat(@splat(missing)), .out_slots = @splat(@splat(missing)) };
+            loaded += 1;
+            try slots(t);
+            if (d.inputs) |n| if (n != t.inputs) return error.GraphSlotArity;
+            if (d.outputs) |n| if (n != t.outputs) return error.GraphSlotArity;
+        }
+        const plans = try arena.allocator().alloc(PreparedPlan, doc.plans.len);
+        var bank: Bank = .{ .gpa = a, .arena = arena, .templates = templates, .plans = plans };
+        for (doc.plans, 0..) |p, i| {
+            if (p.name.len == 0) return error.GraphPlan;
+            for (doc.plans[0..i]) |prior| if (std.mem.eql(u8, prior.name, p.name)) return error.GraphDuplicatePlan;
+            if (p.inputs > packet.max_values or p.literals.len > packet.max_values - p.inputs)
+                return error.GraphPlanSize;
+            const constants = try arena.allocator().alloc(packet.Value, p.literals.len);
+            for (p.literals, constants) |text, *v| v.* = try packet.literal(text);
+            plans[i] = .{ .name = p.name, .inputs = p.inputs, .ops = p.ops, .result = p.result, .constants = constants, .total_values = try bank.validate(p.inputs + p.literals.len, p.ops, p.result) };
+        }
+        const emitter = bank.find("emit", 62) orelse return error.GraphEmitMissing;
+        if (emitter.inputs != 1 or emitter.outputs != 1) return error.GraphSlotArity;
+        bank.arena = arena;
+        return bank;
+    }
+
+    pub fn deinit(b: *Bank) void {
+        for (b.templates) |*t| t.circuit.deinit(b.gpa);
+        b.arena.deinit();
+        b.* = undefined;
+    }
+
+    pub fn find(b: *const Bank, name: []const u8, width: u8) ?*const Template {
+        for (b.templates) |*t| if (t.width == width and std.mem.eql(u8, t.name, name)) return t;
+        return null;
+    }
+
+    pub fn plan(b: *const Bank, name: []const u8) ?*const PreparedPlan {
+        for (b.plans) |*p| if (std.mem.eql(u8, p.name, name)) return p;
+        return null;
+    }
+
+    pub fn validate(b: *const Bank, inputs: usize, ops: []const packet.Op, result: u32) !usize {
+        if (inputs > packet.max_values or ops.len > packet.max_ops) return error.GraphPlanSize;
+        var count = inputs;
+        for (ops) |op| {
+            if (op.outputs == 0 or op.outputs > packet.max_arity or count + op.outputs > packet.max_values)
+                return error.GraphPlanSize;
+            if (std.mem.eql(u8, op.op, "bind")) {
+                if (op.outputs != 1 or op.copies.len > 128 or op.args != null or op.b != null)
+                    return error.GraphBinding;
+                for (op.copies) |c| if (c.ref >= count or c.from > 62 or c.to > 62 or
+                    c.digits > 62 - c.from or c.digits > 62 - c.to) return error.GraphBinding;
+                if (op.flags) |r| if (r >= count) return error.GraphReference;
+            } else {
+                if (std.mem.eql(u8, op.op, "emit") or op.copies.len != 0 or op.flags != null)
+                    return error.GraphTemplate;
+                const t = b.find(op.op, op.width) orelse return error.GraphTemplate;
+                if (t.outputs != op.outputs) return error.GraphSlotArity;
+                if (op.args) |args| {
+                    if (args.len != t.inputs) return error.GraphSlotArity;
+                    for (args) |r| if (r >= count) return error.GraphReference;
+                } else {
+                    if (t.inputs != 1 + @as(usize, @intFromBool(op.b != null)) or op.a >= count)
+                        return error.GraphSlotArity;
+                    if (op.b) |r| if (r >= count) return error.GraphReference;
+                }
+            }
+            count += op.outputs;
+        }
+        if (result >= count) return error.GraphReference;
+        return count;
+    }
+};
+
+fn slots(t: *Template) !void {
+    if (t.circuit.program.a_bit != packet.bit_scale or t.circuit.program.a_ref != packet.reference_scale)
+        return error.GraphValueScale;
+    if (t.circuit.tables.len != t.circuit.table_names.len) return error.GraphSlots;
+    for (t.circuit.table_names, 0..) |name, table| {
+        if (std.mem.eql(u8, name, "output.cursor")) continue;
+        const input = std.mem.startsWith(u8, name, "in");
+        const output = std.mem.startsWith(u8, name, "out");
+        if (!input and !output) continue;
+        const prefix: usize = if (input) 2 else 3;
+        const dot = std.mem.indexOfScalarPos(u8, name, prefix, '.') orelse return error.GraphSlots;
+        const logical = std.fmt.parseInt(u8, name[prefix..dot], 10) catch return error.GraphSlots;
+        const offset = std.fmt.parseInt(u8, name[dot + 1 ..], 10) catch return error.GraphSlots;
+        if (logical >= packet.max_arity or (offset != 0 and offset != 31)) return error.GraphSlots;
+        if (offset >= t.width) return error.GraphSlots;
+        const target = if (input) &t.in_slots else &t.out_slots;
+        const group = offset / 31;
+        if (target[logical][group] != missing) return error.GraphSlots;
+        if (t.circuit.tables[table].rows.len != 128 * 128) return error.GraphSlots;
+        target[logical][group] = @intCast(table);
+        const arity = if (input) &t.inputs else &t.outputs;
+        arity.* = @max(arity.*, logical + 1);
+    }
+    if (t.inputs == 0 or t.outputs == 0) return error.GraphSlots;
+    const groups: usize = if (t.width > 31) 2 else 1;
+    for (t.in_slots[0..t.inputs]) |s| for (s[0..groups]) |idx| if (idx == missing) return error.GraphSlots;
+    for (t.out_slots[0..t.outputs]) |s| for (s[0..groups]) |idx| if (idx == missing) return error.GraphSlots;
+}
diff --git a/zig/src/core/runner_graph_binary.zig b/zig/src/core/runner_graph_binary.zig
new file mode 100644
index 0000000000000000000000000000000000000000..de591cbfb153ca2bc4ea2c55a6fbd9bb124e96f2
--- /dev/null
+++ b/zig/src/core/runner_graph_binary.zig
@@ -0,0 +1,263 @@
+//! Offline prepared circuit encoding; boot restores exact runtime fields without compiling graph IR.
+const std = @import("std");
+const builtin = @import("builtin");
+const model = @import("runner_circuit_model.zig");
+const Allocator = std.mem.Allocator;
+const Hash = std.crypto.hash.sha2.Sha256;
+const header = 80;
+const max_bytes = 1 << 30;
+const Prepared = struct { name: []const u8, width: u8, circuit: model.Circuit };
+
+fn schema(comptime T: type, h: *Hash) void {
+    switch (@typeInfo(T)) {
+        .@"struct" => |s| {
+            h.update("struct{");
+            inline for (s.field_names, s.field_types) |name, Field| {
+                if (comptime T == model.Circuit and std.mem.eql(u8, name, "arena")) continue;
+                h.update(name);
+                schema(Field, h);
+            }
+            h.update("}");
+        },
+        .@"union" => |u| {
+            h.update("union{");
+            schema(u.tag_type.?, h);
+            inline for (u.field_names, u.field_types) |name, Field| {
+                h.update(name);
+                schema(Field, h);
+            }
+            h.update("}");
+        },
+        .pointer => |p| {
+            h.update(if (p.size == .slice) "slice" else "pointer");
+            schema(p.child, h);
+        },
+        .optional => |o| {
+            h.update("optional");
+            schema(o.child, h);
+        },
+        .array => |a| {
+            h.update(std.fmt.comptimePrint("array{d}", .{a.len}));
+            schema(a.child, h);
+        },
+        .@"enum" => |e| {
+            h.update("enum");
+            inline for (e.field_names, e.field_values) |name, value|
+                h.update(std.fmt.comptimePrint("{s}={d};", .{ name, value }));
+        },
+        else => h.update(@typeName(T)),
+    }
+}
+
+pub fn schemaHash() [32]u8 {
+    var h = Hash.init(.{});
+    h.update("runner-graph-prepared-v1-rle:");
+    h.update(builtin.zig_version_string);
+    h.update(@embedFile("runner_circuit_model.zig"));
+    h.update(@embedFile("runner_circuit_state.zig"));
+    h.update(@embedFile("runner_circuit_eval.zig"));
+    schema(Prepared, &h);
+    return h.finalResult();
+}
+
+fn leaf(comptime T: type) bool {
+    return switch (@typeInfo(T)) {
+        .int, .float => true,
+        else => false,
+    };
+}
+
+fn equalBits(comptime T: type, a: T, b: T) bool {
+    return std.mem.eql(u8, std.mem.asBytes(&a), std.mem.asBytes(&b));
+}
+
+const Encoder = struct {
+    a: Allocator,
+    bytes: std.ArrayList(u8) = .empty,
+
+    fn putLeaf(e: *Encoder, comptime T: type, values: []const T) anyerror!void {
+        var runs: usize = 0;
+        for (values, 0..) |v, i| {
+            if (i == 0 or !equalBits(T, v, values[i - 1])) runs += 1;
+        }
+        const compressed = runs * (4 + @sizeOf(T)) < values.len * @sizeOf(T);
+        try e.put(u8, @intFromBool(compressed));
+        if (!compressed) {
+            if (comptime builtin.cpu.arch.endian() == .little) {
+                try e.bytes.appendSlice(e.a, std.mem.sliceAsBytes(values));
+            } else for (values) |v| try e.put(T, v);
+            return;
+        }
+        var i: usize = 0;
+        while (i < values.len) {
+            var end = i + 1;
+            while (end < values.len and end - i < std.math.maxInt(u32) and equalBits(T, values[i], values[end]))
+                end += 1;
+            try e.put(u32, @intCast(end - i));
+            try e.put(T, values[i]);
+            i = end;
+        }
+    }
+
+    fn put(e: *Encoder, comptime T: type, value: T) anyerror!void {
+        switch (@typeInfo(T)) {
+            .bool => try e.bytes.append(e.a, @intFromBool(value)),
+            .int => {
+                var b: [@sizeOf(T)]u8 = undefined;
+                std.mem.writeInt(T, &b, value, .little);
+                try e.bytes.appendSlice(e.a, &b);
+            },
+            .float => {
+                const U = @Int(.unsigned, @bitSizeOf(T));
+                try e.put(U, @bitCast(value));
+            },
+            .@"enum" => try e.put(u32, @intCast(@backingInt(value))),
+            .optional => |o| {
+                try e.put(bool, value != null);
+                if (value) |v| try e.put(o.child, v);
+            },
+            .pointer => |p| {
+                if (p.size == .slice) {
+                    try e.put(u64, @intCast(value.len));
+                    if (comptime leaf(p.child)) {
+                        try e.putLeaf(p.child, value);
+                    } else for (value) |v| try e.put(p.child, v);
+                } else if (p.size == .one) try e.put(p.child, value.*) else @compileError("unsupported pointer");
+            },
+            .array => |ar| for (value) |v| try e.put(ar.child, v),
+            .@"struct" => |s| inline for (s.field_names, s.field_types) |name, Field| {
+                if (comptime T == model.Circuit and std.mem.eql(u8, name, "arena")) continue;
+                try e.put(Field, @field(value, name));
+            },
+            .@"union" => |u| {
+                const tag = std.meta.activeTag(value);
+                try e.put(u.tag_type.?, tag);
+                inline for (u.field_names, u.field_types) |name, Field| if (std.mem.eql(u8, name, @tagName(tag))) {
+                    try e.put(Field, @field(value, name));
+                };
+            },
+            else => @compileError("unsupported prepared field: " ++ @typeName(T)),
+        }
+    }
+};
+
+const Decoder = struct {
+    a: Allocator,
+    bytes: []const u8,
+    at: usize = 0,
+    allocated: usize = 0,
+
+    fn take(d: *Decoder, n: usize) ![]const u8 {
+        if (n > d.bytes.len - d.at) return error.GraphPackTruncated;
+        defer d.at += n;
+        return d.bytes[d.at..][0..n];
+    }
+
+    fn getLeaf(d: *Decoder, comptime T: type, out: []T) anyerror!void {
+        const mode = try d.get(u8);
+        if (mode == 0) {
+            if (comptime builtin.cpu.arch.endian() == .little) {
+                @memcpy(std.mem.sliceAsBytes(out), try d.take(out.len * @sizeOf(T)));
+            } else for (out) |*v| v.* = try d.get(T);
+        } else if (mode == 1) {
+            var i: usize = 0;
+            while (i < out.len) {
+                const n = try d.get(u32);
+                if (n == 0 or n > out.len - i) return error.GraphPackRun;
+                @memset(out[i..][0..n], try d.get(T));
+                i += n;
+            }
+        } else return error.GraphPackEncoding;
+    }
+
+    fn get(d: *Decoder, comptime T: type) anyerror!T {
+        return switch (@typeInfo(T)) {
+            .bool => switch ((try d.take(1))[0]) {
+                0 => false,
+                1 => true,
+                else => error.GraphPackBoolean,
+            },
+            .int => std.mem.readInt(T, (try d.take(@sizeOf(T)))[0..@sizeOf(T)], .little),
+            .float => @bitCast(try d.get(@Int(.unsigned, @bitSizeOf(T)))),
+            .@"enum" => std.enums.fromInt(T, try d.get(u32)) orelse return error.GraphPackTag,
+            .optional => |o| if (try d.get(bool)) try d.get(o.child) else null,
+            .pointer => |p| blk: {
+                const n: usize = if (p.size == .slice) std.math.cast(usize, try d.get(u64)) orelse
+                    return error.GraphPackSize else 1;
+                if (n > max_bytes / @max(1, @sizeOf(p.child))) return error.GraphPackSize;
+                const size = n * @sizeOf(p.child);
+                if (size > max_bytes - d.allocated) return error.GraphPackSize;
+                d.allocated += size;
+                if (p.size == .slice) {
+                    const out = try d.a.alloc(p.child, n);
+                    if (comptime leaf(p.child)) {
+                        try d.getLeaf(p.child, out);
+                    } else for (out) |*v| v.* = try d.get(p.child);
+                    break :blk out;
+                } else if (p.size == .one) {
+                    const out = try d.a.create(p.child);
+                    out.* = try d.get(p.child);
+                    break :blk out;
+                } else @compileError("unsupported pointer");
+            },
+            .array => |ar| blk: {
+                var out: T = undefined;
+                for (&out) |*v| v.* = try d.get(ar.child);
+                break :blk out;
+            },
+            .@"struct" => |s| blk: {
+                var out: T = undefined;
+                inline for (s.field_names, s.field_types) |name, Field| {
+                    if (comptime T == model.Circuit and std.mem.eql(u8, name, "arena")) continue;
+                    @field(out, name) = try d.get(Field);
+                }
+                break :blk out;
+            },
+            .@"union" => |u| blk: {
+                const tag = try d.get(u.tag_type.?);
+                inline for (u.field_names, u.field_types) |name, Field| if (std.mem.eql(u8, name, @tagName(tag))) {
+                    break :blk @unionInit(T, name, try d.get(Field));
+                };
+                return error.GraphPackTag;
+            },
+            else => @compileError("unsupported prepared field: " ++ @typeName(T)),
+        };
+    }
+};
+
+pub fn encode(a: Allocator, c: model.Circuit, name: []const u8, width: u8) ![]u8 {
+    var e: Encoder = .{ .a = a };
+    errdefer e.bytes.deinit(a);
+    try e.bytes.appendNTimes(a, 0, header);
+    try e.put(Prepared, .{ .name = name, .width = width, .circuit = c });
+    @memcpy(e.bytes.items[0..8], "TFGRPH01");
+    std.mem.writeInt(u64, e.bytes.items[8..16], e.bytes.items.len - header, .little);
+    @memcpy(e.bytes.items[16..48], &schemaHash());
+    Hash.hash(e.bytes.items[header..], e.bytes.items[48..80], .{});
+    return e.bytes.toOwnedSlice(a);
+}
+
+pub fn decode(a: Allocator, bytes: []const u8, name: []const u8, width: u8) !model.Circuit {
+    if (bytes.len < header or !std.mem.eql(u8, bytes[0..8], "TFGRPH01")) return error.GraphPackMagic;
+    if (std.mem.readInt(u64, bytes[8..16], .little) != bytes.len - header) return error.GraphPackSize;
+    if (!std.mem.eql(u8, bytes[16..48], &schemaHash())) return error.GraphPackSchema;
+    var digest: [32]u8 = undefined;
+    Hash.hash(bytes[header..], &digest, .{});
+    if (!std.mem.eql(u8, bytes[48..80], &digest)) return error.GraphPackChecksum;
+    var arena = std.heap.ArenaAllocator.init(a);
+    errdefer arena.deinit();
+    var d: Decoder = .{ .a = arena.allocator(), .bytes = bytes[header..] };
+    const prepared = try d.get(Prepared);
+    if (prepared.width != width or !std.mem.eql(u8, prepared.name, name)) return error.GraphPackIdentity;
+    var out = prepared.circuit;
+    if (d.at != d.bytes.len) return error.GraphPackTrailing;
+    out.arena = arena;
+    return out;
+}
+
+pub fn load(a: Allocator, path: []const u8, name: []const u8, width: u8) !model.Circuit {
+    var threaded: std.Io.Threaded = .init_single_threaded;
+    const bytes = try std.Io.Dir.cwd().readFileAlloc(threaded.io(), path, a, .limited(max_bytes));
+    defer a.free(bytes);
+    return decode(a, bytes, name, width);
+}
diff --git a/zig/src/core/runner_graph_machine.zig b/zig/src/core/runner_graph_machine.zig
new file mode 100644
index 0000000000000000000000000000000000000000..605442b1b45ee3887b36a2b7c5cc13f342a5104e
--- /dev/null
+++ b/zig/src/core/runner_graph_machine.zig
@@ -0,0 +1,143 @@
+//! A fresh binding machine replays immutable template calls and transfers raw typed tensor rows.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const State = @import("runner_circuit_state.zig").State;
+const eval = @import("runner_circuit_eval.zig");
+const bank_mod = @import("runner_graph_bank.zig");
+const packet = @import("runner_graph_packet.zig");
+const Allocator = std.mem.Allocator;
+
+pub const Machine = struct {
+    gpa: Allocator,
+    bank: *const bank_mod.Bank,
+    parsed: std.json.Parsed(packet.Packet),
+    values: []packet.Value,
+    ops: []const packet.Op,
+    result: u32,
+    initial: usize,
+    steps: u64 = 0,
+    used: bool = false,
+    trace: ?*std.ArrayList(u32) = null,
+
+    pub fn boot(a: Allocator, bank: *const bank_mod.Bank, bytes: []const u8) !Machine {
+        if (bytes.len > packet.max_packet) return error.GraphPacketSize;
+        const parsed = try std.json.parseFromSlice(packet.Packet, a, bytes, .{});
+        errdefer parsed.deinit();
+        const p = parsed.value;
+        if (p.version != 1 or p.values.len > packet.max_values) return error.GraphPacket;
+        var ops = p.ops;
+        var result = p.result;
+        var constants: []const packet.Value = &.{};
+        var prepared_count: ?usize = null;
+        if (p.plan) |name| {
+            if (p.ops.len != 0 or p.result != 0) return error.GraphNamedPlanOverride;
+            const plan = bank.plan(name) orelse return error.GraphPlan;
+            if (p.values.len != plan.inputs) return error.GraphSlotArity;
+            ops = plan.ops;
+            result = plan.result;
+            constants = plan.constants;
+            prepared_count = plan.total_values;
+        }
+        if (constants.len > packet.max_values - p.values.len) return error.GraphPlanSize;
+        const initial = p.values.len + constants.len;
+        const count = prepared_count orelse try bank.validate(initial, ops, result);
+        const values = try a.alloc(packet.Value, count);
+        errdefer a.free(values);
+        for (p.values, values[0..p.values.len]) |text, *v| v.* = try packet.literal(text);
+        @memcpy(values[p.values.len..initial], constants);
+        return .{ .gpa = a, .bank = bank, .parsed = parsed, .values = values, .ops = ops, .result = result, .initial = initial };
+    }
+
+    pub fn deinit(m: *Machine) void {
+        m.gpa.free(m.values);
+        m.parsed.deinit();
+        m.* = undefined;
+    }
+
+    pub fn run(m: *Machine, budget: u64, out: *std.ArrayList(u8), cancel: ?*const std.atomic.Value(bool)) !api.RunEnd {
+        if (m.used) return error.GraphMachineAlreadyRun;
+        m.used = true;
+        var count = m.initial;
+        for (m.ops) |op| {
+            if (cancelled(cancel)) return .{ .end = .cancelled, .steps = m.steps };
+            if (std.mem.eql(u8, op.op, "bind")) {
+                var v: packet.Value = @splat(@splat(0));
+                for (op.copies) |c| packet.copyBits(&v, &m.values[c.ref], c);
+                if (op.flags) |ref| @memcpy(v[0][126..128], m.values[ref][0][126..128]);
+                m.values[count] = v;
+            } else {
+                const t = m.bank.find(op.op, op.width).?;
+                var refs: [packet.max_arity]u32 = undefined;
+                const args = if (op.args) |args| args else blk: {
+                    refs[0] = op.a;
+                    if (op.b) |b| refs[1] = b;
+                    break :blk refs[0..t.inputs];
+                };
+                const end = try m.invoke(t, args, count, budget, out, cancel, false);
+                if (end != .halted) return .{ .end = end, .steps = m.steps };
+            }
+            count += op.outputs;
+        }
+        const emitter = m.bank.find("emit", 62) orelse return error.GraphEmitMissing;
+        const end = try m.invoke(emitter, &.{m.result}, 0, budget, out, cancel, true);
+        return .{ .end = end, .steps = m.steps };
+    }
+
+    fn invoke(m: *Machine, t: *const bank_mod.Template, refs: []const u32, dest: usize, budget: u64, out: *std.ArrayList(u8), cancel: ?*const std.atomic.Value(bool), emit: bool) !End {
+        if (refs.len != t.inputs) return error.GraphSlotArity;
+        if (m.steps >= budget) return .budget;
+        if (cancelled(cancel)) return .cancelled;
+        for (refs) |ref| try fits(&m.values[ref], t.width);
+        var state = try State.init(m.gpa, &t.circuit);
+        defer state.deinit();
+        const groups: usize = if (t.width > 31) 2 else 1;
+        for (refs, 0..) |ref, logical| for (0..groups) |group| {
+            const table = t.in_slots[logical][group];
+            try state.own(table);
+            var row: [128]f32 = undefined;
+            @memcpy(&row, state.row(table, 0));
+            @memcpy(row[2..128], m.values[ref][group][2..128]);
+            try state.writeRow(table, 0, &row);
+        };
+        var token = t.circuit.go;
+        while (token != t.circuit.halt) {
+            if (cancelled(cancel)) return .cancelled;
+            if (m.steps >= budget) return .budget;
+            token = try eval.step(&state, token);
+            m.steps += 1;
+            if (m.trace) |trace| try trace.append(m.gpa, token);
+            const fam, const payload = t.circuit.split(token) orelse return error.GraphOutputToken;
+            if (t.circuit.fault_family) |fault| if (fam == fault) return .fault;
+            if (fam == t.circuit.byte_family) {
+                if (!emit or payload > 255) return error.GraphUnexpectedByte;
+                if (out.items.len >= 256) return error.GraphOutputSize;
+                try out.append(m.gpa, @intCast(payload));
+            }
+        }
+        if (!emit) {
+            for (0..t.outputs) |logical| {
+                var v: packet.Value = @splat(@splat(0));
+                for (0..groups) |group| {
+                    const table = t.out_slots[logical][group];
+                    if (!state.rowPresent(table, 0)) return error.GraphOutputAbsent;
+                    @memcpy(&v[group], state.row(table, 0));
+                }
+                m.values[dest + logical] = v;
+            }
+        }
+        return .halted;
+    }
+};
+
+const End = @FieldType(api.RunEnd, "end");
+
+fn cancelled(flag: ?*const std.atomic.Value(bool)) bool {
+    return if (flag) |f| f.load(.acquire) else false;
+}
+
+fn fits(v: *const packet.Value, width: u8) !void {
+    for (width..62) |digit| {
+        const bits = v[digit / 31][2 + digit % 31 * 4 ..][0..4];
+        for (bits) |bit| if (bit != 0) return error.GraphNarrowBinding;
+    }
+}
diff --git a/zig/src/core/runner_graph_pack.zig b/zig/src/core/runner_graph_pack.zig
new file mode 100644
index 0000000000000000000000000000000000000000..16d081bc8c828dce23d9c45b729e83b226eb428b
--- /dev/null
+++ b/zig/src/core/runner_graph_pack.zig
@@ -0,0 +1,48 @@
+//! Offline CLI: runner-graph-pack INPUT.tfimr OUTPUT.tfgp; runtime never uses this compiler path.
+const std = @import("std");
+const model = @import("runner_circuit_model.zig");
+const binary = @import("runner_graph_binary.zig");
+const loader = @import("runner_circuit_load.zig");
+const Identity = struct { experimental: struct { kind: []const u8, contract: struct { op: []const u8, width: u8 } } };
+
+pub fn main(init: std.process.Init) !void {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len != 3) return error.ExpectedInputAndOutputPaths;
+    const source = try std.Io.Dir.cwd().readFileAlloc(init.io, args[1], init.gpa, .limited(1 << 30));
+    defer init.gpa.free(source);
+    const payload, _ = try loader.payload(source);
+    const identity = try std.json.parseFromSlice(Identity, init.gpa, payload, .{ .ignore_unknown_fields = true });
+    defer identity.deinit();
+    const contract = identity.value.experimental.contract;
+    if (!std.mem.eql(u8, identity.value.experimental.kind, "graph_template") or
+        !@import("runner_graph_packet.zig").widthValid(contract.width)) return error.ExpectedGraphTemplate;
+    var circuit = try loader.fromBytes(init.gpa, source);
+    defer circuit.deinit(init.gpa);
+    try requireGraph(&circuit);
+    circuit.program.image.rom = &.{};
+    circuit.program.image.drom = &.{};
+    circuit.program.image.ram = &.{};
+    circuit.program.ram_tables = @splat(std.math.maxInt(u32));
+    circuit.program.input_address = 0;
+    circuit.program.input_capacity = 0;
+    circuit.program.kind = .elf;
+    const bytes = try binary.encode(init.gpa, circuit, contract.op, contract.width);
+    defer init.gpa.free(bytes);
+    try std.Io.Dir.cwd().writeFile(init.io, .{ .sub_path = args[2], .data = bytes });
+}
+
+fn requireGraph(c: *const model.Circuit) !void {
+    var input = false;
+    var output = false;
+    for (c.table_names) |name| {
+        if (std.mem.eql(u8, name, "output.cursor")) continue;
+        if (std.mem.eql(u8, name, "in0.0")) input = true;
+        if (std.mem.eql(u8, name, "out0.0")) output = true;
+        const prefix: usize = if (std.mem.startsWith(u8, name, "in")) 2 else if (std.mem.startsWith(u8, name, "out")) 3 else continue;
+        const dot = std.mem.indexOfScalarPos(u8, name, prefix, '.') orelse return error.ExpectedGraphTemplate;
+        const logical = std.fmt.parseInt(u32, name[prefix..dot], 10) catch return error.ExpectedGraphTemplate;
+        const offset = std.fmt.parseInt(u32, name[dot + 1 ..], 10) catch return error.ExpectedGraphTemplate;
+        if (logical >= 16 or (offset != 0 and offset != 31)) return error.ExpectedGraphTemplate;
+    }
+    if (!input or !output) return error.ExpectedGraphTemplate;
+}
diff --git a/zig/src/core/runner_graph_packet.zig b/zig/src/core/runner_graph_packet.zig
new file mode 100644
index 0000000000000000000000000000000000000000..90efb27157de99bb718f0c318fd8067b2dca1ecf
--- /dev/null
+++ b/zig/src/core/runner_graph_packet.zig
@@ -0,0 +1,151 @@
+//! Bounded literal binding packets and pure frontend serialization; operations contain no executable graph IR.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+pub const max_packet = 1 << 20;
+pub const max_ops = 4096;
+pub const max_values = 8192;
+pub const max_arity = 16;
+pub const Value = [2][128]f32;
+pub const bit_scale: f32 = 128;
+pub const reference_scale: f32 = 16777216;
+
+pub const Copy = struct {
+    ref: u32,
+    from: u8 = 0,
+    to: u8 = 0,
+    digits: u8 = 62,
+};
+
+pub const Op = struct {
+    op: []const u8,
+    width: u8 = 62,
+    a: u32 = 0,
+    b: ?u32 = null,
+    args: ?[]const u32 = null,
+    outputs: u8 = 1,
+    copies: []const Copy = &.{},
+    flags: ?u32 = null,
+};
+
+pub const Packet = struct {
+    version: u32 = 1,
+    values: []const []const u8,
+    plan: ?[]const u8 = null,
+    ops: []const Op = &.{},
+    result: u32 = 0,
+};
+
+pub const Plan = struct {
+    name: []const u8,
+    inputs: u32,
+    literals: []const []const u8 = &.{},
+    ops: []const Op,
+    result: u32,
+};
+
+pub const Family = enum { add, sub, mul, div, mod, pow };
+pub const Shape = enum { sum, squares, factorial, fib, list_sum };
+
+pub const Builder = struct {
+    pub fn encode(a: Allocator, packet: Packet) ![]u8 {
+        if (packet.version != 1 or packet.values.len > max_values or packet.ops.len > max_ops)
+            return error.GraphPacketSize;
+        const bytes = try std.json.Stringify.valueAlloc(a, packet, .{});
+        errdefer a.free(bytes);
+        if (bytes.len > max_packet) return error.GraphPacketSize;
+        return bytes;
+    }
+
+    pub fn named(a: Allocator, name: []const u8, values: []const []const u8) ![]u8 {
+        return encode(a, .{ .values = values, .plan = name });
+    }
+
+    /// Selects a preloaded plan from operand metadata without evaluating its answer.
+    pub fn binary(a: Allocator, family: Family, lhs: []const u8, rhs: []const u8) ![]u8 {
+        _ = try literal(lhs);
+        _ = try literal(rhs);
+        const wa = lhs.len - @intFromBool(lhs[0] == '-' or lhs[0] == '+');
+        const wb = rhs.len - @intFromBool(rhs[0] == '-' or rhs[0] == '+');
+        if (family == .pow) {
+            const exponent = std.fmt.parseInt(i16, rhs, 10) catch return error.GraphExponent;
+            if (exponent < 0 or exponent > 999) return error.GraphExponent;
+            const name = try std.fmt.allocPrint(a, "pow-{d}-62", .{exponent});
+            defer a.free(name);
+            return named(a, name, &.{lhs});
+        }
+        const needed = switch (family) {
+            .add, .sub => @max(wa, wb) + 1,
+            .mul => wa + wb,
+            .div, .mod => @max(wa, wb),
+            .pow => unreachable,
+        };
+        const width = for ([_]u8{ 1, 2, 4, 8, 16, 32, 62 }) |n| {
+            if (n >= @min(62, needed)) break n;
+        } else unreachable;
+        const name = try std.fmt.allocPrint(a, "{s}-{d}", .{ @tagName(family), width });
+        defer a.free(name);
+        return named(a, name, &.{ lhs, rhs });
+    }
+
+    /// Binds a recognized bounded-loop shape to its offline control schedule.
+    pub fn loop(a: Allocator, shape: Shape, bound: u16, values: []const []const u8) ![]u8 {
+        if (bound > 128 or values.len != (if (shape == .list_sum) @as(usize, bound) else 0))
+            return error.GraphLoop;
+        for (values) |value| _ = try literal(value);
+        const name = try std.fmt.allocPrint(a, "loop-{s}-{d}-62", .{ @tagName(shape), bound });
+        defer a.free(name);
+        return named(a, name, values);
+    }
+};
+
+pub fn widthValid(n: u8) bool {
+    return switch (n) {
+        1, 2, 4, 8, 16, 32, 62 => true,
+        else => false,
+    };
+}
+
+pub fn literal(text: []const u8) !Value {
+    if (text.len == 0) return error.GraphLiteral;
+    const signed = text[0] == '-' or text[0] == '+';
+    const digits = text[@intFromBool(signed)..];
+    if (digits.len == 0 or digits.len > 62) return error.GraphLiteral;
+    var value: Value = @splat(@splat(0));
+    for (&value) |*row| {
+        row[0] = reference_scale;
+        row[1] = reference_scale;
+    }
+    value[0][126] = if (text[0] == '-') bit_scale else 0;
+    for (digits, 0..) |ch, i| {
+        if (ch < '0' or ch > '9') return error.GraphLiteral;
+        const digit = digits.len - i - 1;
+        for (0..4) |bit| value[digit / 31][2 + digit % 31 * 4 + bit] =
+            if ((ch - '0') >> @as(u3, @intCast(bit)) & 1 != 0) bit_scale else 0;
+    }
+    return value;
+}
+
+pub fn copyBits(out: *Value, source: *const Value, c: Copy) void {
+    for (0..c.digits) |i| {
+        const src = @as(usize, c.from) + i;
+        const dst = @as(usize, c.to) + i;
+        @memcpy(out[dst / 31][2 + dst % 31 * 4 ..][0..4], source[src / 31][2 + src % 31 * 4 ..][0..4]);
+    }
+}
+
+test "frontend binding selects offline plans and rejects invalid controls" {
+    const t = std.testing;
+    const sum = try Builder.binary(t.allocator, .add, "-999", "1");
+    defer t.allocator.free(sum);
+    try t.expect(std.mem.indexOf(u8, sum, "add-4") != null);
+    const power = try Builder.binary(t.allocator, .pow, "2", "100");
+    defer t.allocator.free(power);
+    try t.expect(std.mem.indexOf(u8, power, "pow-100-62") != null);
+    try t.expectError(error.GraphExponent, Builder.binary(t.allocator, .pow, "2", "-1"));
+    try t.expectError(error.GraphLiteral, Builder.binary(t.allocator, .mul, "12x", "3"));
+    const squares = try Builder.loop(t.allocator, .squares, 10, &.{});
+    defer t.allocator.free(squares);
+    try t.expect(std.mem.indexOf(u8, squares, "loop-squares-10-62") != null);
+    try t.expectError(error.GraphLoop, Builder.loop(t.allocator, .squares, 129, &.{}));
+    try t.expectError(error.GraphLoop, Builder.loop(t.allocator, .list_sum, 2, &.{"1"}));
+}
