+                      "license": "MIT", "credit": "Divyansh Agrawal", "license_text": (root / "LICENSE").read_text()},
+           "stats": c.stats(), "constants": {"one_dim": 0, "head_dim": ir.HD, "a_ref": float(ir.A_REF),
