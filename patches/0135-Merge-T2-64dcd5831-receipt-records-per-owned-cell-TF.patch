diff --git a/zig/src/core/runner_receipt.zig b/zig/src/core/runner_receipt.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9d648bc322f73f8824712bbb8654fc4d36be6121
--- /dev/null
+++ b/zig/src/core/runner_receipt.zig
@@ -0,0 +1,145 @@
+//! A reply's runner receipt (runtime.runner): cell counts, holds and a record per owned cell's span, route and write.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+/// A span longer than this is recorded as its sha256 and length: the reply holds it in full.
+const span_max = 512;
+
+/// One owned cell's write as it landed in the reply.
+const Record = struct {
+    cell: u32,
+    content: bool, // its field: content (after the think end), else reasoning
+    at: u64, // the field's bytes before the write
+    token: u32, // the reply's tokens before the write
+    round: u32, // the session's ticks when the cell was owned
+    want: []u32, // the result's tokens (gpa)
+    landed: u32 = 0, // of them, committed in order (fewer: the reply's budget cut them, or another token came)
+    drafted: u32 = 0, // of those, committed in the trigger's own commit: the model's verify agreed (sync, never held)
+    sync: bool = false, // settled at its trigger (sync_graph), else held and forced after the hold
+    value: std.ArrayList(u8) = .empty, // the landed tokens' bytes
+};
+
+/// The records and the counters they need; every committed token passes through `token` (Session.feed).
+pub const Log = struct {
+    on: bool = true,
+    tokens: u32 = 0,
+    bytes: [2]u64 = .{ 0, 0 }, // per field: reasoning, content
+    content: bool = false, // the last token's field
+    rounds: u32 = 0, // Session.tick calls: one per engine round
+    writing: bool = false, // the last record's tokens are still landing
+    records: std.ArrayList(Record) = .empty,
+    out: std.ArrayList(u8) = .empty, // the receipt JSON (write)
+
+    /// A committed token: counted in its field, and matched against a write still landing.
+    pub fn token(l: *Log, gpa: Allocator, id: u32, bytes: []const u8, think_open: bool) Allocator.Error!void {
+        if (!l.on) return;
+        l.content = !think_open;
+        defer {
+            l.tokens += 1;
+            l.bytes[@intFromBool(l.content)] += bytes.len;
+        }
+        if (!l.writing) return;
+        const r = &l.records.items[l.records.items.len - 1];
+        l.writing = r.want[r.landed] == id;
+        if (!l.writing) return;
+        try r.value.appendSlice(gpa, bytes);
+        r.landed += 1;
+        if (r.sync and l.rounds == r.round) r.drafted += 1;
+        l.writing = r.landed < r.want.len;
+    }
+
+    /// Cell `cell` owned with `ids` to force after the token just fed (copied).
+    pub fn owned(l: *Log, gpa: Allocator, cell: u32, ids: []const u32) Allocator.Error!void {
+        if (!l.on) return;
+        l.writing = false;
+        const want = try gpa.dupe(u32, ids);
+        errdefer gpa.free(want);
+        try l.records.append(gpa, .{ .cell = cell, .content = l.content, .at = l.bytes[@intFromBool(l.content)], .token = l.tokens, .round = l.rounds, .want = want });
+        l.writing = ids.len > 0;
+    }
+
+    /// The record just owned settled at its trigger (sync_graph): its tokens in this commit are the model's own drafts.
+    pub fn synced(l: *Log) void {
+        if (l.records.items.len > 0) l.records.items[l.records.items.len - 1].sync = true;
+    }
+
+    pub fn deinit(l: *Log, gpa: Allocator) void {
+        for (l.records.items) |*r| {
+            gpa.free(r.want);
+            r.value.deinit(gpa);
+        }
+        l.records.deinit(gpa);
+        l.out.deinit(gpa);
+    }
+};
+
+/// Session `s`'s receipt JSON (runner.Session), in its log's buffer until the session is destroyed ("": out of memory).
+pub fn write(s: anytype) []const u8 {
+    const l = &s.rec;
+    l.out.clearRetainingCapacity();
+    put(s.cells.items, l, s.r.gpa, s.held_ms, s.resume_ms) catch return "";
+    return l.out.items;
+}
+
+const form_names = [_][]const u8{ "fence", "repl", "inline", "trace" };
+
+fn put(cells: anytype, l: *Log, gpa: Allocator, held_ms: u64, resume_ms: u64) Allocator.Error!void {
+    var forms = std.mem.zeroes([4][4]u32);
+    var kinds = std.mem.zeroes([3]u32);
+    for (cells) |c| {
+        const f = &forms[if (c.stated != null) 3 else @backingInt(c.form)];
+        f[0] += 1;
+        switch (c.told) {
+            .none => {},
+            .owned => {
+                f[1] += 1;
+                f[3] += c.owned_tokens;
+                if (c.translation == .program) kinds[@backingInt(c.translation.program.kind)] += 1;
+            },
+            .abstained => f[2] += 1,
+        }
+    }
+    const o = &l.out;
+    try o.append(gpa, '{');
+    for (forms, form_names) |f, name|
+        try o.print(gpa, "\"{s}\":{{\"closed\":{d},\"owned\":{d},\"abstained\":{d},\"owned_tokens\":{d}}},", .{ name, f[0], f[1], f[2], f[3] });
+    try o.print(gpa, "\"owned_by\":{{\"calc\":{d},\"elf\":{d},\"graph\":{d}}},\"held_ms\":{d},\"resume_ms\":{d}", .{ kinds[0], kinds[1], kinds[2], held_ms, resume_ms });
+    if (l.on) {
+        try o.appendSlice(gpa, ",\"cells\":[");
+        for (l.records.items, 0..) |r, i| {
+            const c = cells[r.cell];
+            if (i > 0) try o.append(gpa, ',');
+            const route = if (c.translation == .program) @tagName(c.translation.program.kind) else "none";
+            const status = if (c.result) |res| @tagName(res.status) else "none";
+            try o.print(gpa, "{{\"cell\":{d},\"form\":\"{s}\",\"route\":\"{s}\",\"status\":\"{s}\",", .{ r.cell, form_names[if (c.stated != null) 3 else @backingInt(c.form)], route, status });
+            try text(o, gpa, "lang", c.lang);
+            if (c.code.len <= span_max) try text(o, gpa, "span", c.code) else {
+                var digest: [32]u8 = undefined;
+                std.crypto.hash.sha2.Sha256.hash(c.code, &digest, .{});
+                try o.print(gpa, "\"span_sha256\":\"{s}\",\"span_len\":{d},", .{ std.fmt.bytesToHex(digest, .lower), c.code.len });
+            }
+            if (c.stated) |st| try text(o, gpa, "display", st.display);
+            try text(o, gpa, "value", r.value.items);
+            try o.print(gpa, "\"field\":\"{s}\",\"at\":{d},\"token\":{d},\"ids\":{d},\"landed\":{d},\"drafted\":{d},\"forced\":{d},\"path\":\"{s}\"}}", .{ if (r.content) "content" else "reasoning", r.at, r.token, r.want.len, r.landed, r.drafted, r.landed - r.drafted, if (r.sync) "sync" else "held" });
+        }
+        try o.append(gpa, ']');
+    }
+    try o.append(gpa, '}');
+}
+
+/// `"name":"bytes",` as a JSON string; bytes that are not UTF-8 (a cut mid-character) go as `"name_hex"` instead.
+fn text(o: *std.ArrayList(u8), gpa: Allocator, name: []const u8, bytes: []const u8) Allocator.Error!void {
+    if (!std.unicode.utf8ValidateSlice(bytes)) {
+        try o.print(gpa, "\"{s}_hex\":\"", .{name});
+        for (bytes) |b| try o.print(gpa, "{x:0>2}", .{b});
+        return o.appendSlice(gpa, "\",");
+    }
+    try o.print(gpa, "\"{s}\":\"", .{name});
+    for (bytes) |b| switch (b) {
+        '"' => try o.appendSlice(gpa, "\\\""),
+        '\\' => try o.appendSlice(gpa, "\\\\"),
+        0...0x1f, 0x7f => try o.print(gpa, "\\u{x:0>4}", .{b}),
+        else => try o.append(gpa, b),
+    };
+    try o.appendSlice(gpa, "\",");
+}
diff --git a/zig/src/core/runner_receipt_test.zig b/zig/src/core/runner_receipt_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..1206529fa7992bd8f97ac67d869120e592f35135
--- /dev/null
+++ b/zig/src/core/runner_receipt_test.zig
@@ -0,0 +1,136 @@
+//! The receipt's per-cell records: end to end on a lane host (held results), and the log's drafted/forced/cut rules.
+const std = @import("std");
+const rapi = @import("runner_api.zig");
+const scan = @import("runner_scan.zig");
+const records = @import("runner_receipt.zig");
+const rt = @import("runner_test.zig");
+
+const gpa = std.testing.allocator;
+
+/// The first record of a receipt, parsed.
+const Rec = struct { cell: u32, form: []const u8, route: []const u8, status: []const u8, lang: []const u8, span: []const u8, value: []const u8, field: []const u8, at: u64, token: u32, ids: u32, landed: u32, drafted: u32, forced: u32, path: []const u8 };
+
+const Receipt = struct { cells: []const Rec };
+
+fn first(receipt: []const u8) !std.json.Parsed(Receipt) {
+    return std.json.parseFromSlice(Receipt, gpa, receipt, .{ .ignore_unknown_fields = true, .allocate = .alloc_always });
+}
+
+test "runner receipt: a held fence result records its span, route and the bytes that landed after the header" {
+    var back: rt.Back = .{};
+    defer back.deinit();
+    var m = [_]rt.Model{.{ .lead = rt.mul_cell }};
+    var sums: [1][]u8 = undefined;
+    const texts = try rt.replies(&m, .{ .summaries = &sums }, &back);
+    defer rt.freeAll(texts);
+    defer gpa.free(sums[0]);
+    const p = try first(sums[0]);
+    defer p.deinit();
+    try std.testing.expectEqual(1, p.value.cells.len);
+    const r = p.value.cells[0];
+    try std.testing.expectEqualStrings("fence", r.form);
+    try std.testing.expectEqualStrings("calc", r.route);
+    try std.testing.expectEqualStrings("ok", r.status);
+    try std.testing.expectEqualStrings("python", r.lang);
+    try std.testing.expectEqualStrings("print(123456789012345678901234567890 * 987654321098765432109876543210)\n", r.span);
+    // one token a character: the write starts at the header's newline (the result's), its bytes are the reply's there
+    try std.testing.expectEqualStrings("content", r.field);
+    try std.testing.expectEqual(rt.mul_cell.len - 1, r.at);
+    try std.testing.expectEqual(rt.mul_cell.len - 1, r.token);
+    try std.testing.expectEqualStrings(texts[0][r.at..][0..r.value.len], r.value);
+    try std.testing.expect(std.mem.startsWith(u8, r.value, "\n" ++ rt.product));
+    try std.testing.expectEqual(r.ids, r.landed);
+    try std.testing.expectEqual(0, r.drafted);
+    try std.testing.expectEqual(r.landed, r.forced);
+    try std.testing.expectEqualStrings("held", r.path);
+}
+
+test "runner receipt: an inline value records the parsed expression and the value after `=`" {
+    var back: rt.Back = .{};
+    defer back.deinit();
+    const lead = "Exact: 1.5+2.25 =";
+    var m = [_]rt.Model{.{ .lead = lead }};
+    var sums: [1][]u8 = undefined;
+    const texts = try rt.replies(&m, .{ .summaries = &sums, .inline_math = true }, &back);
+    defer rt.freeAll(texts);
+    defer gpa.free(sums[0]);
+    const p = try first(sums[0]);
+    defer p.deinit();
+    const r = p.value.cells[0];
+    try std.testing.expectEqualStrings("inline", r.form);
+    try std.testing.expectEqualStrings("1.5+2.25", std.mem.trim(u8, r.span, " "));
+    try std.testing.expectEqualStrings(" 3.75", r.value);
+    try std.testing.expectEqual(lead.len, r.at);
+    try std.testing.expectEqualStrings(" 3.75", texts[0][r.at..][0..r.value.len]);
+}
+
+/// The fields records.write reads off a runner.Session and its cells.
+const FakeCell = struct {
+    form: rapi.Form = .repl,
+    stated: ?scan.Stated = null,
+    told: enum { none, owned, abstained } = .owned,
+    owned_tokens: u32 = 0,
+    translation: rapi.Translation = .{ .program = .{ .kind = .graph, .bytes = "" } },
+    result: ?rapi.Result = .{ .status = .ok },
+    lang: []const u8 = "python",
+    code: []const u8 = "2**8",
+};
+
+const FakeSession = struct {
+    r: struct { gpa: std.mem.Allocator = gpa } = .{},
+    cells: struct { items: []const *FakeCell },
+    held_ms: u64 = 0,
+    resume_ms: u64 = 0,
+    rec: records.Log = .{},
+};
+
+test "runner receipt: a sync write is drafted within its trigger's commit and forced after a round; a cut lands less" {
+    var cell: FakeCell = .{};
+    var s: FakeSession = .{ .cells = .{ .items = &.{&cell} } };
+    defer s.rec.deinit(gpa);
+    try s.rec.token(gpa, 1, "x", true);
+    try s.rec.owned(gpa, 0, &.{ 7, 8, 9 });
+    s.rec.synced();
+    try s.rec.token(gpa, 7, "25", true); // the trigger's commit: the model's verify had the result's token
+    s.rec.rounds += 1;
+    try s.rec.token(gpa, 8, "6", true); // forced in the next round
+    try s.rec.token(gpa, 5, "?", true); // not the result's: the write is cut there
+    try s.rec.token(gpa, 9, "!", true);
+    const p = try first(records.write(&s));
+    defer p.deinit();
+    const r = p.value.cells[0];
+    try std.testing.expectEqualStrings("256", r.value);
+    try std.testing.expectEqual(3, r.ids);
+    try std.testing.expectEqual(2, r.landed);
+    try std.testing.expectEqual(1, r.drafted);
+    try std.testing.expectEqual(1, r.forced);
+    try std.testing.expectEqualStrings("sync", r.path);
+    try std.testing.expectEqualStrings("reasoning", r.field);
+    try std.testing.expectEqual(1, r.at);
+    try std.testing.expectEqual(1, r.token);
+    try std.testing.expectEqualStrings("graph", r.route);
+}
+
+test "runner receipt: escapes, a long span as sha256, bytes cut mid-character as hex, and no records when off" {
+    const long: [600]u8 = @splat('x');
+    var cell: FakeCell = .{ .code = &long };
+    var s: FakeSession = .{ .cells = .{ .items = &.{&cell} } };
+    defer s.rec.deinit(gpa);
+    try s.rec.token(gpa, 0, "", false); // the think end: content from here
+    try s.rec.owned(gpa, 0, &.{ 1, 2 });
+    try s.rec.token(gpa, 1, "\"a\\\n", false);
+    try s.rec.token(gpa, 2, "\xcf", false);
+    const got = records.write(&s);
+    try std.testing.expect(std.mem.indexOf(u8, got, "\"span_len\":600,") != null);
+    try std.testing.expect(std.mem.indexOf(u8, got, "\"value_hex\":\"22615c0acf\",") != null);
+    try std.testing.expect(std.mem.indexOf(u8, got, "\"field\":\"content\",\"at\":0,") != null);
+    cell.code = "say \"hi\"\n";
+    s.rec.records.items[0].value.items.len = 4;
+    const esc = records.write(&s);
+    try std.testing.expect(std.mem.indexOf(u8, esc, "\"span\":\"say \\\"hi\\\"\\u000a\",\"value\":\"\\\"a\\\\\\u000a\",") != null);
+    var off: FakeSession = .{ .cells = .{ .items = &.{&cell} }, .rec = .{ .on = false } };
+    defer off.rec.deinit(gpa);
+    try off.rec.owned(gpa, 0, &.{1});
+    try off.rec.token(gpa, 1, "1", false);
+    try std.testing.expect(std.mem.endsWith(u8, records.write(&off), "\"resume_ms\":0}"));
+}
