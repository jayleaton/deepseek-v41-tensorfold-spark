+
+test "idle carry: a park drops S3's executor, whose runner the engine's close frees, and a reload takes the new engine's" {
+    var h: Harness = .{};
+    defer h.deinit();
+    try h.setup(3600);
+    h.srv.?.compute_exec = .{ .frontend = undefined, .backend = undefined, .max_steps = 1, .cfg = .{} };
+    h.expire();
+    try h.waitParked(2000);
+    try t.expect(h.srv.?.compute_exec == null);
+    var problem: []const u8 = "";
+    try h.reload(&problem);
+    try t.expect(h.srv.?.compute_exec == null); // the fake engine opens no S3
+}
