 //! Release a stopped native CUDA host in ownership order.
 const failed_load = @import("cuda_load_gpu.zig");
 const kv_pages = @import("cuda_kv_pool.zig");
+const runner = @import("engine_api").runner;
 pub fn close(h: anytype) void {
     h.host.stop();
