diff --git a/zig/src/core/runner_close_test.zig b/zig/src/core/runner_close_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..cf3119051cf75da325a48f720b79d437db97548f
--- /dev/null
+++ b/zig/src/core/runner_close_test.zig
@@ -0,0 +1,41 @@
+//! runner_open.close at an engine's close: its runners free all they loaded, the bank's lazily prepared templates too.
+const std = @import("std");
+const ropen = @import("runner_open.zig");
+const s3 = @import("compute_circuit.zig");
+
+/// div_big-04 (compute_circuit_armd.json): floor division and divmod, a graph sequence over the bank's templates.
+const div_cell = "a=-23777868243178464\nb=-41832496\nprint(a//b, a%b)\nprint(a/b)\nprint(divmod(a,b))\n";
+
+test "runner proof: close frees the lazily prepared bank templates and the load blocks of a cells runner and its S3" {
+    const circuit = std.c.getenv("TF_RUNNER_CIRCUIT") orelse return skip("TF_RUNNER_CIRCUIT");
+    const bank = std.c.getenv("TF_RUNNER_GRAPH_BANK") orelse return skip("TF_RUNNER_GRAPH_BANK");
+    // its own leak checker: what the runners hold is counted apart from the test's allocations
+    var debug: std.heap.DebugAllocator(.{ .enable_memory_limit = true }) = .init;
+    const gpa = debug.allocator();
+    const cfg: ropen.Config = .{ .circuit = std.mem.span(circuit), .backend = .graph, .graph_bank = std.mem.span(bank), .workers = 1, .compile = false };
+    const cells = try ropen.open(gpa, cfg);
+    const lane = try ropen.openSharing(gpa, cfg, cells); // S3's, as the engines open it
+    const b = ropen.bank(cells).?;
+    try std.testing.expect(ropen.bank(lane).? == b);
+    const prepared = b.preparedCount();
+    const loaded = debug.total_requested_bytes;
+    var e: s3.Exec = .init(.{ .runner = lane, .cfg = .{ .wall_ms = 600_000 } });
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const got = try e.run(arena.allocator(), div_cell, null);
+    try std.testing.expect(got == .owned);
+    // the cell prepared templates on the shared bank, the cells runner's own
+    try std.testing.expect(b.preparedCount() > prepared);
+    try std.testing.expect(debug.total_requested_bytes > loaded);
+    std.debug.print("runner close proof: {d} templates prepared by the cell, {d} bytes held after load, {d} after the cell\n", .{ b.preparedCount() - prepared, loaded, debug.total_requested_bytes });
+    ropen.close(lane);
+    ropen.close(cells);
+    try std.testing.expectEqual(@as(usize, 0), debug.total_requested_bytes);
+    try std.testing.expectEqual(@as(usize, 0), debug.detectLeaks());
+    try std.testing.expectEqual(std.heap.Check.ok, debug.deinit());
+}
+
+fn skip(knob: []const u8) error{SkipZigTest} {
+    std.debug.print("skip runner close proof: {s} unset\n", .{knob});
+    return error.SkipZigTest;
+}
diff --git a/zig/src/core/runner_open.zig b/zig/src/core/runner_open.zig
index a35b675b32fa6b3dbcc9be8ac8922f12414e9750..f5ab0a04fe354b59d7414643c1edf59e266eb231 100644
--- a/zig/src/core/runner_open.zig
+++ b/zig/src/core/runner_open.zig
@@ -31,6 +31,7 @@ const Opened = struct {
     quick: route.Quick = undefined, // cfg.sync_graph: routed's engine-thread part
     dispatch: route.Dispatch = undefined,
     threaded: std.Io.Threaded = undefined, // a configured frontend's engine-lifetime io
+    has_threaded: bool = false,
     configured_frontend: frontend_mod.Context = undefined,
     compiles: bool = true, // the frontend may build an ELF (clang); false under cfg.compile false
 };
@@ -43,6 +44,29 @@ pub fn compiles(r: *Runner) bool {
     return o.compiles;
 }
 
+/// The graph bank `r` runs on (its own or shared); null without the graph backend.
+pub fn bank(r: *Runner) ?*const graph.Bank {
+    const o: *Opened = @alignCast(@fieldParentPtr("runner", r));
+    return if (o.has_bank) o.bank else null;
+}
+
+/// At engine close, after its thread stops: frees backends, jobs, the bank's prepared templates; sharers close first.
+pub fn close(r: *Runner) void {
+    const o: *Opened = @alignCast(@fieldParentPtr("runner", r));
+    const gpa = r.gpa;
+    if (o.has_bank) {
+        o.dispatch.deinit(); // cancels its sequences' graph jobs
+        graph.destroy(o.dispatch.graph);
+        @import("runner_circuit_backend.zig").destroy(o.dispatch.circuit);
+        if (o.bank == &o.own_bank) o.own_bank.deinit();
+    } else {
+        @import("runner_circuit_backend.zig").destroy(r.backend);
+    }
+    if (o.circuit == &o.own_circuit) o.own_circuit.deinit(gpa);
+    if (o.has_threaded) o.threaded.deinit();
+    gpa.destroy(o);
+}
+
 /// Circuit and graph-bank files this process has loaded (each open that shares nothing adds one or two).
 pub fn loaded() u32 {
     return loads.load(.monotonic);
@@ -81,6 +105,7 @@ pub fn openSharing(gpa: Allocator, cfg: Config, with: ?*Runner) !*Runner {
     if (!cfg.compile or cfg.compile_steps != 10522) {
         // Empty scratch root prevents new compiler runs; S3 also refuses cached ELF when disabled.
         o.threaded = .init(gpa, .{});
+        o.has_threaded = true;
         o.configured_frontend = .{ .io = o.threaded.io() };
         o.configured_frontend.compiler.step_budget = cfg.compile_steps;
         if (!cfg.compile) o.configured_frontend.compiler.scratch_root = "";
