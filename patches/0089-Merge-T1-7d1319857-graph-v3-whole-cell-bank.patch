+        ops = []
+        for original in self.ops:
+            row = dict(original)
+            for key in ("a", "b"):
+                if key in row:
+                    row[key] = reference(row[key])
+            ops.append(row)
+        prints = []
+        for original in self.prints:
+            row = dict(original)
+            for key in ("ref", "second"):
+                if key in row:
+                    row[key] = reference(row[key])
+            prints.append(row)
+        return {"version": 1, "values": self.values, "ops": ops, "prints": prints}
+
+
+def compile_program(source):
