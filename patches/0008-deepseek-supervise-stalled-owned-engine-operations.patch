+
+test "model supervisor: the owned fatal callback exits a real child with fail-fast status 70" {
+    if (comptime @import("builtin").os.tag != .linux) return error.SkipZigTest;
+    const platform = @import("sys");
+    const pid = platform.c.fork();
+    if (pid < 0) return error.ForkFailed;
+    if (pid == 0) {
+        const Exit = struct {
+            fn fail(_: *anyopaque, _: anyerror) void {
+                std.c._exit(70);
+            }
+        };
+        var c: Case = .{};
+        var p: @import("round_progress.zig").Progress = .{ .io = t.io };
+        var work = p.beginAt(.round, 0);
+        defer work.end();
+        var s = c.supervisor();
+        s.progress = &p;
+        s.stall_ns = 1;
+        s.fail = Exit.fail;
+        _ = s.check();
+        std.c._exit(71);
+    }
+    var status: c_int = 0;
+    try t.expectEqual(pid, platform.c.waitpid(pid, &status, 0));
+    try t.expectEqual(@as(c_int, 0), status & 127);
+    try t.expectEqual(@as(c_int, 70), (status >> 8) & 255);
+}
+
+test "model supervisor: fatal transport reports preserve the first error and withdraw readiness before notification" {
+    var c: Case = .{};
+    var s = c.supervisor();
+    s.report(error.BackendFailed);
+    s.report(error.CudaFailed);
+    try t.expect(s.failed.load(.acquire));
+    try t.expectEqual(@as(u32, 0), c.calls.load(.acquire));
+    try t.expect(s.check());
+    try t.expect(s.check());
+    try t.expectEqual(error.BackendFailed, c.failure.?);
+    try t.expectEqual(@as(u32, 1), c.calls.load(.acquire));
+}
diff --git a/zig/src/families/deepseek_v41/round_progress.zig b/zig/src/families/deepseek_v41/round_progress.zig
new file mode 100644
index 0000000000000000000000000000000000000000..14cea94e2287ee1fcffa2a84cca6df70ff96f1e4
--- /dev/null
+++ b/zig/src/families/deepseek_v41/round_progress.zig
@@ -0,0 +1,68 @@
+//! Owned work scopes and completed operations distinguish a blocked round from an idle or advancing engine.
+const std = @import("std");
+
+pub const Phase = enum { round, snapshot, kv_union, follower };
+pub const Progress = struct {
+    io: std.Io,
+    mutex: std.atomic.Mutex = .unlocked,
+    active: u32 = 0,
+    last_ns: u64 = 0,
+    phase: Phase = .round,
+
+    pub const Scope = struct {
+        owner: ?*Progress,
+        previous: Phase = .round,
+        pub fn end(s: *Scope) void {
+            const p = s.owner orelse return;
+            p.lock();
+            defer p.mutex.unlock();
+            std.debug.assert(p.active > 0);
+            p.active -= 1;
+            p.phase = s.previous;
+            s.owner = null;
+        }
+    };
+
+    pub fn begin(p: *Progress, phase: Phase) Scope {
+        return p.beginAt(phase, p.now());
+    }
+    pub fn beginAt(p: *Progress, phase: Phase, now_ns: u64) Scope {
+        p.lock();
+        defer p.mutex.unlock();
+        const previous = p.phase;
+        if (p.active == 0) p.last_ns = now_ns;
+        p.active += 1;
+        p.phase = phase;
+        return .{ .owner = p, .previous = previous };
+    }
+    pub fn touch(p: *Progress) void {
+        p.touchAt(p.now());
+    }
+    pub fn touchAt(p: *Progress, now_ns: u64) void {
+        p.lock();
+        defer p.mutex.unlock();
+        if (p.active > 0) p.last_ns = @max(p.last_ns, now_ns);
+    }
+    pub fn stalled(p: *Progress, limit_ns: u64) ?Phase {
+        return p.stalledAt(limit_ns, p.now());
+    }
+    pub fn stalledAt(p: *Progress, limit_ns: u64, now_ns: u64) ?Phase {
+        p.lock();
+        defer p.mutex.unlock();
+        if (limit_ns == 0 or p.active == 0 or now_ns -| p.last_ns < limit_ns) return null;
+        return p.phase;
+    }
+    fn lock(p: *Progress) void {
+        while (!p.mutex.tryLock()) std.atomic.spinLoopHint();
+    }
+    fn now(p: *const Progress) u64 {
+        return @intCast(@max(0, std.Io.Clock.awake.now(p.io).toNanoseconds()));
+    }
+};
+
+/// Seconds, default off. Overflow and malformed operator settings refuse before boot.
+pub fn timeoutNs(value: ?[]const u8) !u64 {
+    const text = value orelse return 0;
+    const seconds = std.fmt.parseInt(u64, text, 10) catch return error.BadStallTimeout;
+    return std.math.mul(u64, seconds, std.time.ns_per_s) catch error.BadStallTimeout;
+}
diff --git a/zig/src/families/deepseek_v41/round_progress_test.zig b/zig/src/families/deepseek_v41/round_progress_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..4a3d5a8265c58ceea6fcbea134a3b1c987ce5a11
--- /dev/null
+++ b/zig/src/families/deepseek_v41/round_progress_test.zig
@@ -0,0 +1,50 @@
+//! A progressing long prefill is not a stalled native call; stopped and idle scopes never expire.
+const std = @import("std");
+const progress = @import("round_progress.zig");
+const t = std.testing;
+
+test "round progress: idle waits and completed work never trigger; nested native waits retain ownership" {
+    var p: progress.Progress = .{ .io = t.io };
+    try t.expect(p.stalledAt(10, 1_000_000) == null);
+    var outer = p.beginAt(.round, 100);
+    var inner = p.beginAt(.follower, 101);
+    try t.expect(p.stalledAt(10, 109) == null);
+    try t.expectEqual(progress.Phase.follower, p.stalledAt(10, 110).?);
+    inner.end();
+    try t.expectEqual(progress.Phase.round, p.stalledAt(10, 110).?);
+    outer.end();
+    outer.end();
+    try t.expect(p.stalledAt(10, 1_000_000) == null);
+    try t.expectEqual(@as(u32, 0), p.active);
+}
+test "round progress: advancing prefill can exceed the timeout many times without a false exit" {
+    var p: progress.Progress = .{ .io = t.io };
+    var scope = p.beginAt(.round, 0);
+    defer scope.end();
+    for (1..1000) |i| {
+        const at = i * 9;
+        try t.expect(p.stalledAt(10, at) == null);
+        p.touchAt(at);
+    }
+    try t.expectEqual(progress.Phase.round, p.stalledAt(10, 999 * 9 + 10).?);
+    try t.expect(p.stalledAt(0, 1_000_000) == null);
+}
+test "round progress: the next operation owns a fresh deadline and stale touches cannot reverse progress" {
+    var p: progress.Progress = .{ .io = t.io };
+    var first = p.beginAt(.round, 10);
+    p.touchAt(25);
+    p.touchAt(20);
+    try t.expect(p.stalledAt(10, 34) == null);
+    first.end();
+    var next = p.beginAt(.follower, 1000);
+    defer next.end();
+    try t.expect(p.stalledAt(10, 1009) == null);
+    try t.expectEqual(progress.Phase.follower, p.stalledAt(10, 1010).?);
+}
+test "round progress: stall timeout is opt-in, checked and independent of health configuration" {
+    try t.expectEqual(@as(u64, 0), try progress.timeoutNs(null));
+    try t.expectEqual(@as(u64, 0), try progress.timeoutNs("0"));
+    try t.expectEqual(@as(u64, 300) * std.time.ns_per_s, try progress.timeoutNs("300"));
+    for ([_][]const u8{ "", "-1", "no", "18446744074", "18446744073709551616" }) |text|
+        try t.expectError(error.BadStallTimeout, progress.timeoutNs(text));
+}
