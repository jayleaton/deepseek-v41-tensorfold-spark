diff --git a/zig/src/core/compute_circuit_proof_test.zig b/zig/src/core/compute_circuit_proof_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..a09a26eb8d7a90957a75838d3fd311f40338bcfe
--- /dev/null
+++ b/zig/src/core/compute_circuit_proof_test.zig
@@ -0,0 +1,133 @@
+//! S3 on recorded arm-d calls (imr-measure-20261101T155322Z): real frontend, CPU circuit, graph first given a bank.
+const std = @import("std");
+const s3 = @import("compute_circuit.zig");
+const circuit = @import("runner_circuit.zig");
+const backend = @import("runner_circuit_backend.zig");
+const frontend = @import("runner_frontend.zig");
+const graph = @import("runner_graph.zig");
+const route = @import("runner_graph_route.zig");
+const ropen = @import("runner_open.zig");
+
+const gpa = std.testing.allocator;
+const Recorded = struct { task: []const u8, call: u32, code: []const u8, status: []const u8, output: []const u8 };
+const File = struct { source: []const u8, calls: []const Recorded };
+
+/// Calls each route must own, so the proof is never empty: calc lowers these on any backend.
+const calc_owned = [_][]const u8{ "add30-06", "add30-11", "add30-22", "add30-23", "add30-25", "add30-30", "add30-33", "add30-40", "mul30-14", "mul30-16", "mul_big-05", "mul_big-30", "mul_big-40", "bignum-18" };
+/// Two prints: one graph sequence on the bank; the circuit route declines it, ELF or not.
+const bank_owned = [_][]const u8{"bignum-10"};
+/// Floor division with divmod and Fraction, Decimal: the graph bank's, or an ELF's when compiling.
+const graph_owned = [_][]const u8{ "div_big-04", "div_big-08", "div_big-20", "div_big-23", "div_big-32", "div_big-36", "mul_big-08", "mul_big-17", "mul_big-18" };
+/// MBPP functions only an ELF runs.
+const elf_owned = [_][]const u8{ "mbpp-56", "mbpp-66", "mbpp-80", "mbpp-86" };
+
+test "compute runner proof: served S3 (no ELF): owned calls print the sandbox's bytes, never as an ELF" {
+    try proof(false);
+}
+
+test "compute runner proof: S3 with ELF programs: owned calls print the sandbox's bytes" {
+    try proof(true);
+}
+
+fn listed(list: []const []const u8, task: []const u8) bool {
+    for (list) |t| if (std.mem.eql(u8, t, task)) return true;
+    return false;
+}
+
+fn proof(elf: bool) !void {
+    const path = std.c.getenv("TF_RUNNER_CIRCUIT") orelse {
+        std.debug.print("skip compute runner proof: TF_RUNNER_CIRCUIT unset\n", .{});
+        return error.SkipZigTest;
+    };
+    var c = try circuit.Circuit.load(gpa, std.mem.span(path));
+    defer c.deinit(gpa);
+    const b = try backend.backend(gpa, &c, 2);
+    defer backend.destroy(b);
+    var ctx: frontend.Context = .{ .io = std.testing.io };
+    if (std.c.getenv("TF_RUNNER_LLD")) |l| ctx.compiler.linker = std.mem.span(l);
+    if (!elf) ctx.compiler.scratch_root = ""; // runner_open's no-compile frontend (TF_DSV41_COMPUTE_LANE_RUNNER_ELF=0)
+    var e: s3.Exec = .{ .frontend = ctx.frontend(), .backend = b, .max_steps = 4_000_000, .cfg = .{ .wall_ms = 600_000, .elf = elf } };
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    // TF_RUNNER_GRAPH_BANK: the served graph backend's route (runner_open), T1's bank first and the circuit behind it
+    var bank: graph.Bank = undefined;
+    var routed: route.Routed = undefined;
+    var dispatch: route.Dispatch = undefined;
+    const with_bank = std.c.getenv("TF_RUNNER_GRAPH_BANK");
+    if (with_bank) |g| {
+        bank = try graph.Bank.load(gpa, std.mem.span(g));
+        routed = .{ .inner = e.frontend, .bank = &bank };
+        dispatch = .{ .gpa = gpa, .circuit = b, .graph = try graph.backend(gpa, &bank, 2) };
+        e.frontend = routed.frontend();
+        e.backend = dispatch.backend();
+    }
+    defer if (with_bank != null) {
+        const on_graph = dispatch.graph;
+        dispatch.deinit();
+        graph.destroy(on_graph);
+        bank.deinit();
+    };
+    std.debug.print("compute runner proof: backend {s}, ELF {s}\n", .{ if (with_bank != null) "graph, circuit behind it" else "circuit", if (elf) "on" else "off" });
+    const file = try std.json.parseFromSliceLeaky(File, a, @embedFile("compute_circuit_armd.json"), .{});
+    var owned: u32 = 0;
+    var wrong: u32 = 0;
+    for (file.calls) |r| {
+        const got = try e.run(a, r.code, null);
+        switch (got) {
+            .owned => |w| {
+                owned += 1;
+                std.debug.print("{s}#{d}: in-model runner ({t}, {d} steps, {d} us)\n", .{ r.task, r.call, w.kind, w.steps, w.exec_ns / 1000 });
+                // only a call the sandbox ran ok can match: its recorded body is then the same bytes
+                if (!std.mem.eql(u8, r.status, "ok") or !std.mem.eql(u8, r.output, w.body)) {
+                    std.debug.print("  DIFFERS: sandbox {s} [{s}], circuit [{s}]\n", .{ r.status, r.output, w.body });
+                    wrong += 1;
+                }
+                if (!elf and w.kind == .elf) {
+                    std.debug.print("  ELF: built with the compile off\n", .{});
+                    wrong += 1;
+                }
+            },
+            .declined => |why| std.debug.print("{s}#{d}: code tool ({t})\n", .{ r.task, r.call, why }),
+        }
+        const must = listed(&calc_owned, r.task) or (listed(&bank_owned, r.task) and with_bank != null) or
+            (listed(&graph_owned, r.task) and (with_bank != null or elf)) or (listed(&elf_owned, r.task) and elf);
+        if (must and got != .owned) {
+            std.debug.print("  MUST OWN: {s} went to the code tool\n", .{r.task});
+            wrong += 1;
+        }
+    }
+    std.debug.print("compute runner proof: {d} of {d} recorded calls ran on the circuit\n", .{ owned, file.calls.len });
+    try std.testing.expectEqual(@as(u32, 0), wrong);
+}
+
+test "compute runner proof: S3 beside the cell runner loads the circuit (and graph bank) once and runs on it" {
+    const path = std.c.getenv("TF_RUNNER_CIRCUIT") orelse return error.SkipZigTest;
+    // a runner lives as long as the engine (no deinit, workers idle on its memory): this test never frees them
+    const p = std.heap.page_allocator;
+    var cfg: ropen.Config = .{ .circuit = std.mem.span(path), .workers = 1 };
+    if (std.c.getenv("TF_RUNNER_GRAPH_BANK")) |g| {
+        cfg.backend = .graph;
+        cfg.graph_bank = std.mem.span(g);
+    }
+    const files: u32 = if (cfg.backend == .graph) 2 else 1;
+    const before = ropen.loaded();
+    const cells = try ropen.open(p, cfg);
+    try std.testing.expectEqual(before + files, ropen.loaded());
+    var lane_cfg = cfg;
+    lane_cfg.compile = false; // as served: S3's runner never compiles
+    const lane = try ropen.openSharing(p, lane_cfg, cells);
+    try std.testing.expectEqual(before + files, ropen.loaded());
+    try std.testing.expect(ropen.compiles(cells) and !ropen.compiles(lane));
+    var e = s3.Exec.init(.{ .runner = lane, .cfg = .{ .wall_ms = 600_000 } });
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const got = try e.run(arena.allocator(), "a = 6\nb = 7\nprint(a * b)", null);
+    try std.testing.expect(got == .owned);
+    try std.testing.expectEqualStrings("42", got.owned.body);
+    // another path to the same file is another file to this rule: it loads (strings compare, never inodes)
+    var other = cfg;
+    other.circuit = try std.fmt.allocPrint(p, "/{s}", .{cfg.circuit});
+    _ = try ropen.openSharing(p, other, cells);
+    try std.testing.expectEqual(before + files + 1, ropen.loaded());
+}
diff --git a/zig/src/core/compute_circuit_test.zig b/zig/src/core/compute_circuit_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..79e4ccc637efece189fdc207239be8df4ceff2d0
--- /dev/null
+++ b/zig/src/core/compute_circuit_test.zig
@@ -0,0 +1,198 @@
+//! S3 (core/compute_circuit.zig) with a scripted frontend and backend (the arm-d proof: compute_circuit_proof_test).
+const std = @import("std");
+const api = @import("runner_api.zig");
+const s3 = @import("compute_circuit.zig");
+const lane = @import("compute_lane.zig");
+
+const gpa = std.testing.allocator;
+
+/// Code "abstain:<reason>" abstains; other code is a calc program whose bytes are the code (the backend's script).
+const Front = struct {
+    cells: u32 = 0,
+    last: api.Cell = .{ .form = .repl, .lang = "", .code = "" },
+
+    fn frontend(f: *Front) api.Frontend {
+        return .{ .ctx = f, .translate = translate };
+    }
+
+    fn translate(ctx: ?*anyopaque, a: std.mem.Allocator, cell: api.Cell) std.mem.Allocator.Error!api.Translation {
+        _ = a;
+        const f: *Front = @ptrCast(@alignCast(ctx.?));
+        f.cells += 1;
+        f.last = cell;
+        if (std.mem.startsWith(u8, cell.code, "abstain:")) return .{ .abstain = std.meta.stringToEnum(api.Abstain, cell.code["abstain:".len..]).? };
+        if (std.mem.startsWith(u8, cell.code, "elf:")) return .{ .program = .{ .kind = .elf, .bytes = cell.code["elf:".len..] } };
+        return .{ .program = .{ .kind = .calc, .bytes = cell.code } };
+    }
+};
+
+/// Program bytes script the run: ok:<out>, budget:<out>, fault:<out>, abstain, forever, else ok; `busy` refuses starts.
+const Back = struct {
+    busy: u32 = 0,
+    started: u32 = 0,
+    cancelled: u32 = 0,
+    released: u32 = 0,
+    script: []const u8 = "",
+
+    fn backend(b: *Back) api.Backend {
+        return .{ .ctx = b, .vtable = &.{ .start = start, .poll = poll, .cancel = cancel, .release = release } };
+    }
+
+    fn start(ctx: *anyopaque, stream: u64, p: api.Program, budget: u64) error{ OutOfMemory, Busy }!api.JobId {
+        _ = .{ stream, budget };
+        const b: *Back = @ptrCast(@alignCast(ctx));
+        if (b.busy > 0) {
+            b.busy -= 1;
+            return error.Busy;
+        }
+        b.started += 1;
+        b.script = p.bytes;
+        return b.started;
+    }
+
+    fn poll(ctx: *anyopaque, job: api.JobId) api.Poll {
+        _ = job;
+        const b: *Back = @ptrCast(@alignCast(ctx));
+        const colon = std.mem.findScalar(u8, b.script, ':') orelse b.script.len;
+        const out = if (colon < b.script.len) b.script[colon + 1 ..] else "";
+        const head = b.script[0..colon];
+        if (std.mem.eql(u8, head, "forever")) return .running;
+        if (std.mem.eql(u8, head, "abstain")) return .{ .done = .{ .status = .abstain, .abstain = .too_big } };
+        const status = std.meta.stringToEnum(api.Status, head) orelse .ok; // a real cell: runs ok
+        return .{ .done = .{ .status = status, .out = out, .steps = 7, .exec_ns = 1000 } };
+    }
+
+    fn cancel(ctx: *anyopaque, job: api.JobId) void {
+        _ = job;
+        const b: *Back = @ptrCast(@alignCast(ctx));
+        b.cancelled += 1;
+    }
+
+    fn release(ctx: *anyopaque, stream: u64) void {
+        _ = stream;
+        const b: *Back = @ptrCast(@alignCast(ctx));
+        b.released += 1;
+    }
+};
+
+const Fixture = struct {
+    front: Front = .{},
+    back: Back = .{},
+    arena: std.heap.ArenaAllocator = .init(gpa),
+
+    fn exec(f: *Fixture, cfg: s3.Config) s3.Exec {
+        return .{ .frontend = f.front.frontend(), .backend = f.back.backend(), .max_steps = 1000, .cfg = cfg };
+    }
+
+    fn run(f: *Fixture, cfg: s3.Config, code: []const u8, hook: ?lane.Cancel) !s3.Outcome {
+        var e = f.exec(cfg);
+        return e.run(f.arena.allocator(), code, hook);
+    }
+};
+
+fn expectOwned(want: []const u8, got: s3.Outcome) !void {
+    try std.testing.expect(got == .owned);
+    try std.testing.expectEqualStrings(want, got.owned.body);
+}
+
+fn expectDeclined(want: s3.Decline, got: s3.Outcome) !void {
+    try std.testing.expect(got == .declined);
+    try std.testing.expectEqual(want, got.declined);
+}
+
+test "compute runner: a run that halts ok is the lane's body: one trailing newline cut, nothing printed is [no output]" {
+    var f: Fixture = .{};
+    defer f.arena.deinit();
+    try expectOwned("42", try f.run(.{}, "ok:42\n", null));
+    try expectOwned("1\n2", try f.run(.{}, "ok:1\n2\n", null));
+    try expectOwned("[no output]", try f.run(.{}, "ok:", null));
+    // the sandbox's own rule on the same stdout gives the same bytes
+    const sandbox = try lane.runner.body(f.arena.allocator(), .{ .status = .ok, .stdout = "830876824090243401591366835513\n" }, 0, 0);
+    try expectOwned(sandbox, try f.run(.{}, "ok:830876824090243401591366835513\n", null));
+    const o = try f.run(.{}, "ok:x\n", null);
+    try std.testing.expectEqual(s3.Kind.calc, o.owned.kind);
+    try std.testing.expectEqual(@as(u64, 7), o.owned.steps);
+}
+
+test "compute runner: an ELF program runs only with _ELF on; off, it declines as elf and starts nothing" {
+    var f: Fixture = .{};
+    defer f.arena.deinit();
+    try expectDeclined(.elf, try f.run(.{}, "elf:ok:42\n", null));
+    try std.testing.expectEqual(@as(u32, 0), f.back.started);
+    const o = try f.run(.{ .elf = true }, "elf:ok:42\n", null);
+    try expectOwned("42", o);
+    try std.testing.expectEqual(s3.Kind.elf, o.owned.kind);
+}
+
+test "compute runner: a lane call is a fresh python fence cell: no earlier call's names" {
+    var f: Fixture = .{};
+    defer f.arena.deinit();
+    _ = try f.run(.{}, "ok:1\n", null);
+    _ = try f.run(.{}, "ok:2\n", null);
+    try std.testing.expectEqual(api.Form.fence, f.front.last.form);
+    try std.testing.expectEqualStrings("python", f.front.last.lang);
+    try std.testing.expectEqual(@as(usize, 0), f.front.last.prior.len);
+}
+
+test "compute runner: every frontend abstain declines with its reason and starts nothing" {
+    var f: Fixture = .{};
+    defer f.arena.deinit();
+    inline for (@typeInfo(api.Abstain).@"enum".field_names) |name| {
+        try expectDeclined(@field(s3.Decline, name), try f.run(.{}, "abstain:" ++ name, null));
+    }
+    try std.testing.expectEqual(@as(u32, 0), f.back.started);
+}
+
+test "compute runner: backend abstain, budget and fault decline; their partial output is never a body" {
+    var f: Fixture = .{};
+    defer f.arena.deinit();
+    try expectDeclined(.too_big, try f.run(.{}, "abstain", null));
+    try expectDeclined(.budget, try f.run(.{}, "budget:12", null));
+    try expectDeclined(.fault, try f.run(.{}, "fault:12", null));
+    try std.testing.expectEqual(@as(u32, 3), f.back.released);
+}
+
+test "compute runner: a busy backend is retried until a slot frees; past busy_ms the call declines busy" {
+    var f: Fixture = .{};
+    defer f.arena.deinit();
+    f.back.busy = 3;
+    try expectOwned("5", try f.run(.{}, "ok:5\n", null));
+    f.back.busy = 1 << 30;
+    try expectDeclined(.busy, try f.run(.{ .busy_ms = 5 }, "ok:5\n", null));
+    try std.testing.expectEqual(@as(u32, 1), f.back.started);
+}
+
+test "compute runner: a run past wall_ms is cancelled and declines wall; a gone client declines cancelled" {
+    var f: Fixture = .{};
+    defer f.arena.deinit();
+    try expectDeclined(.wall, try f.run(.{ .wall_ms = 5 }, "forever", null));
+    try std.testing.expectEqual(@as(u32, 1), f.back.cancelled);
+    const Gone = struct {
+        fn yes(ctx: *anyopaque) bool {
+            _ = ctx;
+            return true;
+        }
+    };
+    var dummy: u8 = 0;
+    try expectDeclined(.cancelled, try f.run(.{}, "forever", .{ .ctx = &dummy, .gone = Gone.yes }));
+    try std.testing.expectEqual(@as(u32, 2), f.back.cancelled);
+    try std.testing.expectEqual(@as(u32, 2), f.back.released);
+}
+
+test "compute runner: S3 knobs: defaults, values and bad values" {
+    const Env = struct {
+        var pairs: []const [2][]const u8 = &.{};
+        fn get(name: []const u8) ?[]const u8 {
+            for (pairs) |p| if (std.mem.eql(u8, p[0], name)) return p[1];
+            return null;
+        }
+    };
+    Env.pairs = &.{};
+    try std.testing.expectEqual(s3.Config{}, try s3.Config.parse(Env.get, "X"));
+    Env.pairs = &.{ .{ "X_WALL_MS", "50" }, .{ "X_BUSY_MS", "0" }, .{ "X_VERIFY", "1" }, .{ "X_ELF", "1" } };
+    try std.testing.expectEqual(s3.Config{ .wall_ms = 50, .busy_ms = 0, .verify = true, .elf = true }, try s3.Config.parse(Env.get, "X"));
+    Env.pairs = &.{.{ "X_VERIFY", "2" }};
+    try std.testing.expectError(error.BadKnob, s3.Config.parse(Env.get, "X"));
+    Env.pairs = &.{.{ "X_WALL_MS", "0" }};
+    try std.testing.expectError(error.BadKnob, s3.Config.parse(Env.get, "X"));
+}
