+
+test "a second frame header is refused before it allocates another coefficient image" {
+    const sof_hdr = [_]u8{ 0xff, 0xc0, 0x00, 0x0b, 0x08, 0x00, 0x01, 0x00, 0x01, 0x01, 0x01, 0x11, 0x00 };
