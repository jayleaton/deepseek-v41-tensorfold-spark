From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Sun, 1 Nov 2026 19:52:20 +0700
Subject: [PATCH 069/207] In-model runner: ^ is a power in exact inline math;
 Python cells keep XOR

Inline spans use math notation, so 2^10 lowers like 2**10. With exact inline off, ^ abstains;
code cells never lower ^ as a power.
---
 zig/src/core/runner_frontend_inline.zig       |  8 +++--
 .../core/runner_frontend_notation_test.zig    | 36 ++++++++++++++++++-
 zig/src/core/runner_frontend_test.zig         |  2 +-
 zig/src/core/runner_scan.zig                  |  1 +
 4 files changed, 42 insertions(+), 5 deletions(-)

diff --git a/zig/src/core/runner_frontend_inline.zig b/zig/src/core/runner_frontend_inline.zig
index 5b34d452a4876bc09910654b9d99629e70aa3f4c..f0d6a808b329fa35c869a905babb95692309f258 100644
--- a/zig/src/core/runner_frontend_inline.zig
+++ b/zig/src/core/runner_frontend_inline.zig
@@ -7,6 +7,8 @@ const Failure = Allocator.Error || ast.Invalid;
 // Proof values select a format and admission only; emitted expressions retain source arithmetic.
 pub fn lower(a: Allocator, code: []const u8, exact: bool) Allocator.Error!?[]u8 {
     if (code.len == 0 or code.len > 1024) return null;
+    // `^` is a power in math notation (Python's XOR), so only exact inline math takes it
+    if (!exact and std.mem.indexOfScalar(u8, code, '^') != null) return null;
     var arena = std.heap.ArenaAllocator.init(a);
     defer arena.deinit();
     const scratch = arena.allocator();
@@ -48,11 +50,11 @@ fn normalize(a: Allocator, code: []const u8) Allocator.Error!?[]u8 {
     var pos: usize = 0;
     while (pos < code.len) {
         var replaced = false;
-        const symbols = [_][]const u8{ "×", "÷", "−" };
-        const operators = "*/-";
+        const symbols = [_][]const u8{ "×", "÷", "−", "^" };
+        const operators = [_][]const u8{ "*", "/", "-", "**" };
         for (symbols, operators) |symbol, op| {
             if (std.mem.startsWith(u8, code[pos..], symbol)) {
-                try out.append(a, op);
+                try out.appendSlice(a, op);
                 pos += symbol.len;
                 replaced = true;
                 break;
