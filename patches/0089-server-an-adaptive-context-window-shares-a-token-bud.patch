diff --git a/zig/src/server/context_window.zig b/zig/src/server/context_window.zig
new file mode 100644
index 0000000..ae42196
--- /dev/null
+++ b/zig/src/server/context_window.zig
@@ -0,0 +1,217 @@
+//! The adaptive context window: a request's cap is a share of a token budget among the active chats, above a floor.
+const std = @import("std");
+const environment = @import("sys").environment;
+
+/// The window moves in whole pages of this many tokens.
+pub const page: u64 = 256;
+/// Distinct chats remembered; past it the least recently seen gives way (the in-flight count still bounds the share).
+pub const capacity = 64;
+/// Opening tokens past the shared system prefix that name a chat.
+pub const key_tokens = 512;
+
+pub const Settings = struct {
+    /// Tokens the active chats share (TENSORFOLD_CONTEXT_BUDGET); 0 keeps the static window.
+    budget: u64 = 0,
+    /// The least window any request gets while the budget is on (TENSORFOLD_CONTEXT_FLOOR), never above the static one.
+    floor: u64 = 0,
+    /// A chat counts as active this long after its last request began (TENSORFOLD_CONTEXT_HOLD_S).
+    hold_s: u32 = 300,
+
+    /// TENSORFOLD_CONTEXT_*, each else its DeepSeek-V4.1 name TF_DSV41_CONTEXT_* (what its launchers forward).
+    pub fn fromEnv() environment.Error!Settings {
+        return .{
+            .budget = try either(u64, "TENSORFOLD_CONTEXT_BUDGET", "TF_DSV41_CONTEXT_BUDGET", 0),
+            .floor = try either(u64, "TENSORFOLD_CONTEXT_FLOOR", "TF_DSV41_CONTEXT_FLOOR", 0),
+            .hold_s = try either(u32, "TENSORFOLD_CONTEXT_HOLD_S", "TF_DSV41_CONTEXT_HOLD_S", 300),
+        };
+    }
+
+    fn either(comptime T: type, comptime name: [:0]const u8, comptime alias: [:0]const u8, default: T) environment.Error!T {
+        if (try environment.read(?T, name, null)) |v| return v;
+        return environment.read(T, alias, default);
+    }
+
+    pub fn enabled(s: Settings) bool {
+        return s.budget > 0;
+    }
+
+    /// The window for `active` chats under a static `window` (0: unbounded, left as it is).
+    pub fn windowFor(s: Settings, window: u64, active: u32) u64 {
+        if (!s.enabled() or window == 0) return window;
+        const share = s.budget / @max(1, active) / page * page;
+        return @min(window, @max(@min(s.floor, window), share));
+    }
+};
+
+/// A chat's key: its opening tokens past the system prefix (agents share the system prompt, not the first turn).
+pub fn chatKey(ids: []const u32, system_len: usize) u64 {
+    const start = @min(system_len, ids.len);
+    const end = @min(ids.len, start + key_tokens);
+    return std.hash.Wyhash.hash(0x636861745f6b6579, std.mem.sliceAsBytes(ids[start..end]));
+}
+
+/// A request's window and the chats it was shared among.
+pub const Now = struct { window: u64, active: u32 };
+
+/// Chats seen in the hold, each counted from its second request (one-shots shrink no one); window/peek take `mutex`.
+pub const Adaptive = struct {
+    settings: Settings = .{},
+    mutex: std.Io.Mutex = .init,
+    keys: [capacity]u64 = undefined,
+    seen: [capacity]i96 = undefined,
+    again: [capacity]bool = undefined,
+    len: usize = 0,
+
+    fn expire(a: *Adaptive, now: i96) void {
+        const hold: i96 = @as(i96, a.settings.hold_s) * std.time.ns_per_s;
+        var i: usize = 0;
+        while (i < a.len) {
+            if (now - a.seen[i] >= hold) {
+                a.len -= 1;
+                a.keys[i] = a.keys[a.len];
+                a.seen[i] = a.seen[a.len];
+                a.again[i] = a.again[a.len];
+            } else i += 1;
+        }
+    }
+
+    fn chats(a: *const Adaptive) u32 {
+        var n: u32 = 0;
+        for (a.again[0..a.len]) |x| n += @intFromBool(x);
+        return n;
+    }
+
+    /// Records `key` as seen at `now` (null: count only) and returns the chats active within the hold.
+    pub fn note(a: *Adaptive, key: ?u64, now: i96) u32 {
+        a.expire(now);
+        const k = key orelse return a.chats();
+        for (a.keys[0..a.len], 0..) |x, i| if (x == k) {
+            a.seen[i] = now;
+            a.again[i] = true;
+            return a.chats();
+        };
+        var slot = a.len;
+        if (a.len == capacity) {
+            slot = 0;
+            for (a.seen[0..a.len], 0..) |t, i| if (t < a.seen[slot]) {
+                slot = i;
+            };
+        } else a.len += 1;
+        a.keys[slot] = k;
+        a.seen[slot] = now;
+        a.again[slot] = false;
+        return a.chats();
+    }
+
+    /// The window a new request gets: `key` noted (background requests pass null), at least `inflight` chats active.
+    pub fn window(a: *Adaptive, io: std.Io, static: u64, key: ?u64, inflight: u32, now: i96) Now {
+        if (!a.settings.enabled()) return .{ .window = static, .active = inflight };
+        a.mutex.lockUncancelable(io);
+        defer a.mutex.unlock(io);
+        const active = @max(@max(1, inflight), a.note(key, now));
+        return .{ .window = a.settings.windowFor(static, active), .active = active };
+    }
+
+    /// The chats active now and the window a request would get, for status readers (no chat is noted).
+    pub fn peek(a: *Adaptive, io: std.Io, static: u64, inflight: u32, now: i96) Now {
+        return a.window(io, static, null, inflight, now);
+    }
+};
+
+const testing = std.testing;
+const sec = std.time.ns_per_s;
+const jj: Settings = .{ .budget = 4 << 20, .floor = 256 << 10, .hold_s = 300 };
+
+test "context window: off by default, the static window whatever the load" {
+    const off: Settings = .{};
+    try testing.expect(!off.enabled());
+    try testing.expectEqual(@as(u64, 1 << 20), off.windowFor(1 << 20, 16));
+    try testing.expectEqual(@as(u64, 0), jj.windowFor(0, 8));
+}
+
+test "context window: 1-4 chats get the whole 1M, more get a page-rounded share, never under the floor" {
+    for ([_]u32{ 0, 1, 2, 3, 4 }) |n| try testing.expectEqual(@as(u64, 1 << 20), jj.windowFor(1 << 20, n));
+    try testing.expectEqual(@as(u64, 838_656), jj.windowFor(1 << 20, 5));
+    try testing.expectEqual(@as(u64, 698_880), jj.windowFor(1 << 20, 6));
+    try testing.expectEqual(@as(u64, 524_288), jj.windowFor(1 << 20, 8));
+    try testing.expectEqual(@as(u64, 262_144), jj.windowFor(1 << 20, 16));
+    try testing.expectEqual(@as(u64, 262_144), jj.windowFor(1 << 20, 64));
+    for (1..65) |n| try testing.expectEqual(@as(u64, 0), jj.windowFor(1 << 20, @intCast(n)) % page);
+    // a floor above the static window is the static window
+    const high: Settings = .{ .budget = 1 << 20, .floor = 1 << 22 };
+    try testing.expectEqual(@as(u64, 1 << 20), high.windowFor(1 << 20, 8));
+    // the pool as the budget: eight chats fit at once (2,100,224 / 8 = 262,528, rounded down to whole pages)
+    const pool: Settings = .{ .budget = 2_100_224, .floor = 256 << 10 };
+    try testing.expectEqual(@as(u64, 262_400), pool.windowFor(1 << 20, 8));
+    try testing.expect(8 * pool.windowFor(1 << 20, 8) <= 2_100_224);
+}
+
+test "context window: a chat's key skips the system prefix and reads only its opening tokens" {
+    var a: [2000]u32 = undefined;
+    var b: [2000]u32 = undefined;
+    for (&a, &b, 0..) |*x, *y, i| {
+        x.* = @intCast(i);
+        y.* = @intCast(i);
+    }
+    b[3] = 99_999; // a different system prompt
+    try testing.expectEqual(chatKey(&a, 100), chatKey(&b, 100));
+    try testing.expect(chatKey(&a, 0) != chatKey(&b, 0));
+    b[1500] = 7; // a later turn of the same chat
+    try testing.expectEqual(chatKey(&a, 100), chatKey(&b, 100));
+    b[200] = 7; // a different opening turn: another chat
+    try testing.expect(chatKey(&a, 100) != chatKey(&b, 100));
+    try testing.expectEqual(chatKey(a[0..50], 100), chatKey(a[0..60], 100));
+}
+
+test "context window: chats count from their second request, once each, stay through the hold, then age out" {
+    var ad: Adaptive = .{ .settings = jj };
+    try testing.expectEqual(@as(u32, 0), ad.note(1, 0));
+    try testing.expectEqual(@as(u32, 1), ad.note(1, 10 * sec));
+    try testing.expectEqual(@as(u32, 1), ad.note(1, 11 * sec));
+    for (0..2) |_| for (2..9) |k| {
+        _ = ad.note(k, 20 * sec);
+    };
+    try testing.expectEqual(@as(u32, 8), ad.note(null, 30 * sec));
+    try testing.expectEqual(@as(u64, 524_288), ad.settings.windowFor(1 << 20, ad.note(null, 30 * sec)));
+    // chat 1 was refreshed at 11 s, the rest at 20 s: at 315 s only the seven remain, at 320 s none
+    try testing.expectEqual(@as(u32, 7), ad.note(null, 315 * sec));
+    try testing.expectEqual(@as(u32, 0), ad.note(null, 320 * sec));
+    try testing.expectEqual(@as(u32, 0), ad.note(9, 321 * sec));
+    try testing.expectEqual(@as(u32, 1), ad.note(9, 322 * sec));
+}
+
+test "context window: a burst of one-shot requests does not shrink a long chat's window" {
+    var ad: Adaptive = .{ .settings = jj };
+    const io = testing.io;
+    _ = ad.window(io, 1 << 20, 1, 1, 0);
+    try testing.expectEqual(@as(u64, 1 << 20), ad.window(io, 1 << 20, 1, 1, sec).window);
+    // twenty distinct one-shot requests (a benchmark, quick API calls), one after another
+    for (100..120) |k| _ = ad.window(io, 1 << 20, k, 1, 2 * sec);
+    const w = ad.window(io, 1 << 20, 1, 1, 3 * sec);
+    try testing.expectEqual(@as(u32, 1), w.active);
+    try testing.expectEqual(@as(u64, 1 << 20), w.window);
+    // while they run they count (in flight); one that comes back is a conversation and counts after it finishes
+    try testing.expectEqual(@as(u64, 524_288), ad.window(io, 1 << 20, 1, 8, 4 * sec).window);
+    _ = ad.window(io, 1 << 20, 100, 1, 5 * sec);
+    try testing.expectEqual(@as(u32, 2), ad.peek(io, 1 << 20, 0, 6 * sec).active);
+}
+
+test "context window: past capacity the least recently seen chat gives way" {
+    var ad: Adaptive = .{ .settings = jj };
+    for (0..capacity) |k| _ = ad.note(k, @intCast(k));
+    try testing.expectEqual(@as(u32, 0), ad.note(1000, 100));
+    for (ad.keys[0..ad.len]) |k| try testing.expect(k != 0);
+    for (0..capacity) |k| _ = ad.note(k + 1, @intCast(200 + k));
+    try testing.expectEqual(@as(u32, capacity - 1), ad.note(null, 300));
+}
+
+test "context window: the in-flight count is a lower bound, background requests are not noted" {
+    var ad: Adaptive = .{ .settings = jj };
+    const io = testing.io;
+    const w = ad.window(io, 1 << 20, null, 8, 0);
+    try testing.expectEqual(@as(u32, 8), w.active);
+    try testing.expectEqual(@as(u64, 524_288), w.window);
+    try testing.expectEqual(@as(usize, 0), ad.len);
+    try testing.expectEqual(@as(u64, 1 << 20), ad.window(io, 1 << 20, 5, 1, 0).window);
+    try testing.expectEqual(@as(u64, 1 << 20), ad.peek(io, 1 << 20, 0, 1).window);
+}
diff --git a/zig/src/server/context_window_test.zig b/zig/src/server/context_window_test.zig
new file mode 100644
index 0000000..2dde3ac
--- /dev/null
+++ b/zig/src/server/context_window_test.zig
@@ -0,0 +1,145 @@
+//! Chat preparations under TENSORFOLD_/TF_DSV41_CONTEXT_*: one-shots do not count, a second chat halves, a floor holds.
+const std = @import("std");
+const api = @import("engine_api");
+const json = @import("json");
+const errors = @import("errors.zig");
+const fixture = @import("control_tokens_fixture.zig");
+const HfText = @import("hf_text.zig").HfText;
+const Server = @import("server.zig").Server;
+const chat = @import("chat.zig");
+const openai = @import("openai.zig");
+const env = @import("sys").env;
+const t = std.testing;
+
+const Fake = struct {
+    window: u32,
+    fn engine(f: *@This()) api.Engine {
+        return .{ .ctx = f, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+    fn info(ptr: *anyopaque) api.Info {
+        const f: *@This() = @ptrCast(@alignCast(ptr));
+        return .{ .context_window = f.window, .prefill_step = 4096 };
+    }
+    fn submit(_: *anyopaque, _: api.Id, _: *const api.Request, _: api.Sink) api.SubmitError!void {
+        return error.Closed;
+    }
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+const Never = struct {
+    pub fn check(_: @This()) bool {
+        return false;
+    }
+};
+
+fn message(a: std.mem.Allocator, role: []const u8, content: []const u8) !json.Value {
+    const out = try json.newObject(a);
+    try out.put(a, "role", .{ .string = role });
+    try out.put(a, "content", .{ .string = content });
+    return .{ .object = out };
+}
+
+/// One chat request: `opening` names the chat, `background` marks it as a side request; its prompt tokens, or null.
+fn ask(srv: *Server, a: std.mem.Allocator, opening: []const u8, background: bool, cx: *errors.Cx) !?usize {
+    const body = try json.newObject(a);
+    try body.put(a, "messages", .{ .array = try a.dupe(json.Value, &.{try message(a, "user", opening)}) });
+    try body.put(a, "max_tokens", try json.intValue(a, 1));
+    if (background) try body.put(a, "priority", .{ .string = "background" });
+    const input = try openai.chatInput(srv, cx, .{ .object = body });
+    const prepared = chat.prepare(srv, cx, input, Never{}) catch |e| switch (e) {
+        error.Refused => return null,
+        else => return e,
+    };
+    srv.release(prepared.preparing, prepared.request);
+    return prepared.prompt_len;
+}
+
+const names = [2][3][:0]const u8{
+    .{ "TENSORFOLD_CONTEXT_BUDGET", "TENSORFOLD_CONTEXT_FLOOR", "TENSORFOLD_CONTEXT_HOLD_S" },
+    .{ "TF_DSV41_CONTEXT_BUDGET", "TF_DSV41_CONTEXT_FLOOR", "TF_DSV41_CONTEXT_HOLD_S" },
+};
+
+/// One case: the settings under `set` (0: TENSORFOLD_, 1: TF_DSV41_); `decoy`: a TF_DSV41_ floor at the budget too.
+const Case = struct { set: usize, floor_is_budget: bool, decoy: bool = false };
+
+fn setAll(c: Case, budget: [:0]const u8) void {
+    _ = env.setenv(names[c.set][0], budget, 1);
+    _ = env.setenv(names[c.set][1], if (c.floor_is_budget) budget else "256", 1);
+    _ = env.setenv(names[c.set][2], "3600", 1);
+    // a DeepSeek-V4.1 floor at the budget would hold the whole window; the TENSORFOLD_ name set must win over it
+    if (c.decoy) _ = env.setenv(names[1][1], budget, 1);
+}
+
+fn unsetAll() void {
+    for (names) |set| for (set) |name| {
+        _ = env.unsetenv(name);
+    };
+}
+
+test "context window: one chat gets the whole window, one-shot and background requests do not count, a second chat halves it" {
+    defer unsetAll();
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var files = try fixture.Fixture.init(a, 0);
+    defer files.deinit();
+    var problem: []const u8 = "";
+    const hf = try HfText.load(a, t.io, files.path, null, a, &problem);
+    defer hf.deinit();
+    const long = try a.alloc(u8, 3000);
+    for (long, 0..) |*c, i| c.* = "abcdefgh "[i % 9];
+    // measure the long chat's prompt on a static server
+    unsetAll();
+    var probe: Fake = .{ .window = 1 << 20 };
+    const n = blk: {
+        const srv = try Server.init(a, t.io, probe.engine(), hf.text(), .{ .served_name = "m", .model_ids = &.{"m"}, .enable_thinking = false }, null);
+        defer srv.deinit();
+        var cx: errors.Cx = .{ .a = a };
+        break :blk (try ask(srv, a, long, false, &cx)).?;
+    };
+    try t.expect(n > 600);
+    // the static window and budget are 2p + 1 pages: one chat gets them all, two get p pages each, not above n
+    const p: u32 = @intCast(n / 256);
+    const window: u32 = (2 * p + 1) * 256;
+    var f: Fake = .{ .window = window };
+    const budget = try std.fmt.allocPrintSentinel(a, "{d}", .{window}, 0);
+    const cases = [_]Case{ .{ .set = 0, .floor_is_budget = false }, .{ .set = 1, .floor_is_budget = false }, .{ .set = 0, .floor_is_budget = false, .decoy = true }, .{ .set = 0, .floor_is_budget = true } };
+    for (cases) |c| {
+        unsetAll();
+        setAll(c, budget);
+        const srv = try Server.init(a, t.io, f.engine(), hf.text(), .{ .served_name = "m", .model_ids = &.{"m"}, .enable_thinking = false }, null);
+        defer srv.deinit();
+        var cx: errors.Cx = .{ .a = a };
+        // alone (with a background side request beside it): the whole window
+        try t.expect(try ask(srv, a, long, false, &cx) != null);
+        try t.expect(try ask(srv, a, "Generate a title", true, &cx) != null);
+        try t.expect(try ask(srv, a, long, false, &cx) != null);
+        // a burst of one-shot chats does not count once each is done: the long chat keeps the whole window
+        for (0..6) |i| {
+            var buf: [32]u8 = undefined;
+            try t.expect(try ask(srv, a, try std.fmt.bufPrint(&buf, "a one-shot request {d}", .{i}), false, &cx) != null);
+        }
+        try t.expect(try ask(srv, a, long, false, &cx) != null);
+        // a second chat that comes back: each gets half the budget, under the long prompt, unless the floor holds
+        try t.expect(try ask(srv, a, "a different chat", false, &cx) != null);
+        try t.expect(try ask(srv, a, "a different chat", false, &cx) != null);
+        const held = c.floor_is_budget;
+        var refused: errors.Cx = .{ .a = a };
+        const again = try ask(srv, a, long, false, &refused);
+        try t.expectEqual(held, again != null);
+        if (!held) {
+            try t.expectEqual(errors.Kind.context_length, refused.kind);
+            try t.expect(std.mem.startsWith(u8, refused.message, errors.context_limit));
+            var want_buf: [64]u8 = undefined;
+            try t.expect(std.mem.indexOf(u8, refused.message, try std.fmt.bufPrint(&want_buf, " {d} tokens while this server serves several chats", .{p * 256})) != null);
+            // short requests of either chat still fit the lowered window
+            try t.expect(try ask(srv, a, "a different chat", false, &cx) != null);
+        }
+    }
+}
