From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Mon, 2 Nov 2026 21:50:46 +0700
Subject: [PATCH 134/207] integer def test: the list golden runs graph programs
 on the graph backend (table scripts are not machine packets)

---
 .../core/runner_frontend_integer_def_test.zig | 20 ++++++++++++-------
 1 file changed, 13 insertions(+), 7 deletions(-)

diff --git a/zig/src/core/runner_frontend_integer_def_test.zig b/zig/src/core/runner_frontend_integer_def_test.zig
index dabe20357a5b22532f8060a6f34a782de7a648ed..0cb03711396e08a2d33fcbbf4e84c38248661a6a 100644
--- a/zig/src/core/runner_frontend_integer_def_test.zig
+++ b/zig/src/core/runner_frontend_integer_def_test.zig
@@ -171,15 +171,21 @@ test "runner frontend integer def: the served graph route refuses each list prog
     var context: @import("runner_frontend.zig").Context = .{ .io = std.testing.io, .compiler = .{ .clang = "/nonexistent-list-clang" } };
     var routed: route.Routed = .{ .inner = context.frontend(), .bank = &bank };
     const f = routed.frontend();
-    for (lists) |c| {
+    const backend = try graph.backend(gpa, &bank, 2);
+    defer graph.destroy(backend);
+    var d: route.Dispatch = .{ .gpa = gpa, .circuit = Never.backend(), .graph = backend };
+    defer d.deinit();
+    const b = d.backend();
+    for (lists, 0..) |c, i| {
         const result = try f.translate(f.ctx, gpa, .{ .form = .fence, .lang = "python", .code = c[0] });
         defer if (result == .program) gpa.free(result.program.bytes);
         if (result != .program or result.program.kind != .graph) continue;
-        var machine = try @import("runner_graph_machine.zig").Machine.boot(gpa, &bank, result.program.bytes);
-        defer machine.deinit();
-        var out: std.ArrayList(u8) = .empty;
-        defer out.deinit(gpa);
-        const end = try machine.run(4_000_000, &out, null);
-        if (end.end == .halted) try std.testing.expectEqualStrings(c[1], out.items);
+        const job = try b.start(i + 1, result.program, 50_000_000);
+        const r = while (true) switch (b.poll(job)) {
+            .running => std.Thread.yield() catch {},
+            .done => |x| break x,
+        };
+        defer b.release(i + 1);
+        if (r.status == .ok) try std.testing.expectEqualStrings(c[1], r.out);
     }
 }
