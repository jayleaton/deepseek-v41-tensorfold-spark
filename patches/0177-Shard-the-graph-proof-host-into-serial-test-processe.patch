+--- /dev/null
++++ b/zig/build/runner_proof_shards.zig
+@@ -0,0 +1,27 @@
++//! One compiled proof population, executed in serial singleton server processes.
++const std = @import("std");
++
++pub fn steps(b: *std.Build, api_fast: *std.Build.Module) void {
++    const tests = b.addTest(.{
++        .root_module = api_fast,
++        .filters = &.{"runner proof:"},
++        .test_runner = .{ .path = b.path("zig/runner_proof_shard_runner.zig"), .mode = .server },
++    });
++    const all = b.step("test-runner-proof-host", "Multiply and loop replies on the real frontend and CPU circuit (TF_RUNNER_CIRCUIT)");
++    const catalog = b.addRunArtifact(tests);
++    catalog.setName("runner proof catalog");
++    catalog.stdio = .inherit;
++    catalog.addArg("--proof-catalog");
++    catalog.has_side_effects = true;
++    b.step("test-runner-proof-list", "List the compiled proof population without executing tests").dependOn(&catalog.step);
++    var previous: *std.Build.Step = &catalog.step;
++    for (0..256) |index| {
++        const run = b.addRunArtifact(tests);
++        run.setName(b.fmt("runner proof shard {d}", .{index}));
++        run.addArg(b.fmt("--proof-shard-index={d}", .{index}));
++        run.has_side_effects = true;
++        run.step.dependOn(previous);
++        previous = &run.step;
++    }
++    all.dependOn(previous);
++}
+diff --git a/zig/runner_proof_shard_runner.zig b/zig/runner_proof_shard_runner.zig
+new file mode 100644
+--- /dev/null
++++ b/zig/runner_proof_shard_runner.zig
+@@ -0,0 +1,192 @@
++//! Singleton metadata over Zig 0.17's test server protocol; original indices are emitted on stderr.
++
++// Allocator, IO, result flags and logging adapted from Zig's MIT-licensed compiler/test_runner.zig.
++
++// Copyright (c) Zig contributors; see LICENSES/Zig-MIT.txt.
++const std = @import("std");
++const builtin = @import("builtin");
++const testing = std.testing;
++const Io = std.Io;
++const Results = std.zig.Server.Message.TestResults;
++const limit = 256;
++const runner_io: Io = Io.Threaded.global_single_threaded.io();
++
++pub const std_options: std.Options = .{ .logFn = log };
++var log_err_count: usize = 0;
++var args_buffer: [8192]u8 = undefined;
++
++comptime {
++    if (!std.mem.eql(u8, builtin.zig_version_string, "0.17.0")) @compileError("proof runner requires Zig 0.17.0");
++    if (builtin.fuzz) @compileError("proof sharding does not support fuzz mode");
++}
++
++pub fn main(init: std.process.Init.Minimal) void {
++    @disableInstrumentation();
++    run(init) catch |err| std.debug.panic("proof shard runner: {t}", .{err});
++}
++
++fn run(init: std.process.Init.Minimal) !void {
++    if (builtin.test_functions.len == 0) return error.EmptyProofPopulation;
++    if (builtin.test_functions.len > limit) return error.ProofPopulationExceedsShardLimit;
++    var fba: std.heap.FixedBufferAllocator = .init(&args_buffer);
++    const args = try init.args.toSlice(fba.allocator());
++    var selected: ?usize = null;
++    var listen = false;
++    var catalog = false;
++    for (args[1..]) |arg| {
++        if (std.mem.startsWith(u8, arg, "--proof-shard-index=")) {
++            if (selected != null) return error.DuplicateProofShard;
++            selected = try std.fmt.parseUnsigned(usize, arg["--proof-shard-index=".len..], 10);
++            if (selected.? >= limit) return error.InvalidProofShard;
++        } else if (std.mem.eql(u8, arg, "--proof-catalog")) {
++            if (catalog) return error.DuplicateProofCatalog;
++            catalog = true;
++        } else if (std.mem.eql(u8, arg, "--listen=-")) {
++            if (listen) return error.DuplicateProofListen;
++            listen = true;
++        } else if (std.mem.startsWith(u8, arg, "--seed=")) {
++            testing.random_seed = try std.fmt.parseUnsigned(u32, arg["--seed=".len..], 0);
++        } else if (std.mem.startsWith(u8, arg, "--cache-dir=")) {
++            continue;
++        } else return error.UnknownProofArgument;
++    }
++    if (catalog) {
++        if (listen or selected != null) return error.InvalidProofCatalogArguments;
++        try emit(.{ .event = "catalog_begin", .total = builtin.test_functions.len, .limit = limit });
++        for (builtin.test_functions, 0..) |test_fn, index| {
++            try emit(.{ .event = "catalog", .index = index, .name = test_fn.name });
++        }
++        try emit(.{ .event = "catalog_end", .total = builtin.test_functions.len });
++        return;
++    }
++    if (!listen or selected == null) return error.MissingProofShardArguments;
++    try mainServer(init, selected.?);
++}
++
++fn mainServer(init: std.process.Init.Minimal, selected: usize) !void {
++    @disableInstrumentation();
++    var in_buffer: [4096]u8 = undefined;
++    var out_buffer: [4096]u8 = undefined;
++    var reader: Io.File.Reader = .initStreaming(.stdin(), runner_io, &in_buffer);
++    var writer: Io.File.Writer = .initStreaming(.stdout(), runner_io, &out_buffer);
++    var server: std.zig.Server = .{ .in = &reader.interface, .out = &writer.interface };
++    try server.serveStringMessage(.zig_version, builtin.zig_version_string);
++    var metadata_sent = false;
++    var executed = false;
++    const active = selected < builtin.test_functions.len;
++    while (true) {
++        const header = try server.receiveMessage();
++        switch (header.tag) {
++            .exit => {
++                if (header.bytes_len != 0) return error.InvalidProofMessageLength;
++                if (metadata_sent and active and !executed) return error.MissingProofExecution;
++                // The SDK can restart after a crash only to send exit, retaining its previous metadata.
++                if (!metadata_sent) std.process.exit(0);
++                if (!active) try emit(.{ .event = "empty", .index = selected, .total = builtin.test_functions.len });
++                std.process.exit(0);
++            },
++            .query_test_metadata => {
++                if (header.bytes_len != 0) return error.InvalidProofMessageLength;
++                if (metadata_sent) return error.DuplicateProofMetadata;
++                try metadata(&server, selected);
++                metadata_sent = true;
++            },
++            .run_test => {
++                if (header.bytes_len != @sizeOf(u32)) return error.InvalidProofMessageLength;
++                const local_index = try server.receiveBody_u32();
++                if (local_index != 0 or !active) return error.InvalidProofTestIndex;
++                if (!metadata_sent) return error.MissingProofMetadata;
++                if (executed) return error.DuplicateProofExecution;
++                executed = true;
++                try execute(&server, init, selected);
++            },
++            else => return error.UnsupportedProofMessage,
++        }
++    }
++}
++
++fn metadata(server: *std.zig.Server, selected: usize) !void {
++    if (selected >= builtin.test_functions.len) {
++        return server.serveTestMetadata(.{ .names = &.{}, .expected_panic_msgs = &.{}, .string_bytes = &.{0} });
++    }
++    var sa: std.heap.SafeAllocator = .init(std.heap.page_allocator, .{});
++    defer if (sa.deinit() != 0) @panic("internal proof runner memory leak");
++    const a = sa.allocator();
++    const name = builtin.test_functions[selected].name;
++    const bytes = try a.alloc(u8, name.len + 2);
++    defer a.free(bytes);
++    bytes[0] = 0;
++    @memcpy(bytes[1 .. name.len + 1], name);
++    bytes[name.len + 1] = 0;
++    try server.serveTestMetadata(.{ .names = &.{1}, .expected_panic_msgs = &.{0}, .string_bytes = bytes });
++}
++
++fn execute(server: *std.zig.Server, init: std.process.Init.Minimal, selected: usize) !void {
++    @disableInstrumentation();
++    const test_fn = builtin.test_functions[selected];
++    try emit(.{ .event = "start", .index = selected, .name = test_fn.name, .total = builtin.test_functions.len });
++    testing.environ = init.environ;
++    testing.allocator_instance = .init(std.heap.page_allocator, .{
++        .canary = 0xc3a701ba,
++        .check_write_after_free = true,
++    });
++    testing.io_instance = .init(testing.allocator, .{ .argv0 = .init(init.args), .environ = init.environ });
++    log_err_count = 0;
++    try server.serveStringMessage(.test_started, &.{});
++    const status: Results.Status = if (test_fn.func()) |v| s: {
++        v;
++        break :s .pass;
++    } else |err| switch (err) {
++        error.SkipZigTest => .skip,
++        else => s: {
++            if (@errorReturnTrace()) |trace| std.debug.dumpErrorReturnTrace(trace);
++            break :s .fail;
++        },
++    };
++    testing.io_instance.deinit();
++    const leak_count = testing.allocator_instance.deinit();
++    try emit(.{
++        .event = "result",
++        .index = selected,
++        .name = test_fn.name,
++        .total = builtin.test_functions.len,
++        .status = @tagName(status),
++        .log_err_count = log_err_count,
++        .leak_count = leak_count,
++    });
++    try server.serveTestResults(.{
++        .index = 0,
++        .flags = .{
++            .status = status,
++            .fuzz = false,
++            .log_err_count = std.math.lossyCast(@FieldType(Results.Flags, "log_err_count"), log_err_count),
++            .leak_count = std.math.lossyCast(@FieldType(Results.Flags, "leak_count"), leak_count),
++        },
++    });
++}
++
++fn emit(row: anytype) !void {
++    const stderr = std.debug.lockStderr(&.{}).terminal();
++    defer std.debug.unlockStderr();
++    try stderr.writer.writeAll("\nPROOF_SHARD ");
++    try std.json.Stringify.value(row, .{}, stderr.writer);
++    try stderr.writer.writeByte('\n');
++}
++
++pub fn log(comptime level: std.log.Level, comptime scope: @EnumLiteral(), comptime format: []const u8, args: anytype) void {
++    @disableInstrumentation();
++    if (@backingInt(level) <= @backingInt(std.log.Level.err)) log_err_count +|= 1;
++    if (@backingInt(level) <= @backingInt(testing.log_level)) {
++        std.debug.print("[" ++ @tagName(scope) ++ "] (" ++ @tagName(level) ++ "): " ++ format ++ "\n", args);
++    }
++}
++
++pub fn fuzz(
++    context: anytype,
++    comptime testOne: fn (@TypeOf(context), *std.testing.Smith) anyerror!void,
++    options: testing.FuzzInputOptions,
++) anyerror!void {
++    _ = testOne;
++    _ = options;
++    return error.ProofFuzzUnsupported;
++}
