index 0000000000000000000000000000000000000000..6dd670ed3588ea89faa3ffca4a5930c5a787a988
--- /dev/null
+++ b/zig/src/core/runner_circuit_eval.zig
@@ -0,0 +1,152 @@
+//! Exact CPU evaluation of one circuit step: token features, SwiGLU units, one-hot DeltaNet heads, output code.
+const std = @import("std");
+const model = @import("runner_circuit_model.zig");
+const State = @import("runner_circuit_state.zig").State;
+
+const Scalar = model.Scalar;
+const hd = model.hd;
+
+/// The residual a token starts from: dim 0 is one, each feature dim a function of the token's family and payload.
+pub fn embed(c: *const model.Circuit, token: u32, x: []Scalar) !void {
+    const fam, const pay = c.split(token) orelse return error.CircuitUnknownToken;
+    @memset(x, 0);
+    x[0] = 1;
+    for (c.features) |f| x[f.dim] = f.value(fam, pay, c.family_bits);
+}
+
+/// Feeds one token through every batch in stored node order and returns the token the output code names.
+pub fn step(s: *State, token: u32) !u32 {
+    const c = s.circuit;
+    try embed(c, token, s.x);
+    for (c.batches) |*b| switch (b.*) {
+        .ffn => |*f| ffn(f, s.x, s.work),
+        .heads => |*h| try heads(s, h),
+    };
+    s.steps += 1;
+    return decode(c, s.x);
+}
+
+fn commit(outs: []const model.Out, values: []const Scalar, x: []Scalar) void {
+    for (outs, values) |o, v| x[o.dim] = if (o.into) x[o.dim] + v else v;
+}
+
+fn ffn(f: *const model.Ffn, x: []Scalar, work: []Scalar) void {
+    const t = f.terms;
+    const up = work[0..t];
+    const gate = work[t .. 2 * t];
+    const y = work[2 * t ..][0..f.outs.len];
+    @memset(work[0 .. 2 * t + f.outs.len], 0);
+    f.up.apply(x, up);
+    f.gate.apply(x, gate);
+    for (f.coef, f.slot, up, gate) |c, s, u, g| y[s] += c * u * @max(g, 0);
+    commit(f.outs, y, x);
+}
+
+fn heads(s: *State, h: *const model.Heads) !void {
+    const width = h.proj.outputs;
+    const p = s.work[0..width];
+    const values = s.work[width..][0..h.outs.len];
+    const rest = s.work[width + h.outs.len ..];
+    const keys = rest[0..hd];
+    const query = rest[hd .. 2 * hd];
+    const v = rest[2 * hd .. 3 * hd];
+    const z = rest[3 * hd .. 4 * hd];
+    const o = rest[4 * hd .. 5 * hd];
+    @memset(p, 0);
+    h.proj.apply(s.x, p);
+    for (p[0..h.channels], h.taps, 0..) |*e, t, i| {
+        const past = s.channelHistory(h.first_channel + @as(u32, @intCast(i)));
+        const now = e.*;
+        e.* = @max(t[0] * now + t[1] * past[0] + t[2] * past[1] + t[3] * past[2], 0);
+        past.* = .{ now, past[0], past[1] };
+    }
+    for (h.heads) |*head| {
+        scatter(head.k, p, keys, false);
+        scatter(head.q, p, query, false);
+        const key = try oneHot(keys);
+        for (head.value_heads) |*vh| {
+            if (vh.a) |col| try decay(s, vh.table, p[col]);
+            if (key) |r| if (try writeEnabled(vh.beta, p)) {
+                scatter(vh.v, p, v, false);
+                try s.writeRow(vh.table, r, v);
+            };
+            try read(s, vh.table, query, o);
+            scatter(vh.z, p, z, true);
+            for (vh.out_cols, vh.out_w, values[vh.out_first..][0..vh.out_cols.len]) |col, w, *y| y.* = o[col] * z[col] * w;
+        }
+    }
+    commit(h.outs, values, s.x);
+}
+
+fn scatter(picks: []const model.Pick, p: []const Scalar, into: []Scalar, rectify: bool) void {
+    @memset(into, 0);
+    for (picks) |k| into[k.at] = if (rectify) @max(p[k.column], 0) else p[k.column];
+}
+
+/// The row a key selects, null when no entry is positive; more than one positive entry is not a one-hot key.
+fn oneHot(keys: []const Scalar) !?u32 {
+    var found: ?u32 = null;
+    for (keys, 0..) |k, r| if (k > 0) {
+        if (found != null) return error.CircuitKeyNotOneHot;
+        found = @intCast(r);
+    };
+    return found;
+}
+
+/// beta: absent is 1; 1 writes, an integer <= 0 does not, anything else breaks the circuit's exact range.
+fn writeEnabled(beta: ?u32, p: []const Scalar) !bool {
+    const b = p[beta orelse return true];
+    if (b == 1) return true;
+    if (b <= 0 and b == @round(b)) return false;
+    return error.CircuitWriteGate;
+}
+
+fn decay(s: *State, table: u32, selector: Scalar) !void {
+    if (selector == model.keep_selector) return;
+    if (!s.writable(table)) return error.CircuitTableReadOnly;
+    if (selector == model.halve_selector) {
+        var live = s.present[table];
+        while (live != 0) : (live &= live - 1) {
+            for (s.row(table, @ctz(live))) |*e| e.* *= 0.5;
+        }
+        return;
+    }
+    if (selector != model.clear_selector) return error.CircuitDecaySelector;
+    @memset(s.tables[table], 0);
+    s.present[table] = 0;
+}
+
+/// Sum of the rows a multi-hot query selects, normalized by the ballast: o / sqrt((o0^2 + o1^2) / hd).
+fn read(s: *State, table: u32, query: []const Scalar, o: []Scalar) !void {
+    @memset(o, 0);
+    var any = false;
+    for (query, 0..) |q, r| {
+        if (q <= 0 or !s.rowPresent(table, @intCast(r))) continue;
+        for (o, s.row(table, @intCast(r))) |*a, b| a.* += b;
+        any = true;
+    }
+    if (!any) return;
+    const ref = o[0] * o[0] + o[1] * o[1];
+    if (ref == 0) {
+        for (o) |a| if (a != 0) return error.CircuitReadBallast;
+        return;
+    }
+    const norm = @sqrt(ref / @as(Scalar, hd));
+    for (o) |*a| a.* /= norm;
+}
+
+/// The output code: family bits then 16 payload bits, each the sign of a code dim (+kappa is 1, -kappa is 0).
+pub fn decode(c: *const model.Circuit, x: []const Scalar) !u32 {
+    var code: u64 = 0;
+    for (c.code_dims, 0..) |d, i| {
+        if (x[d] == 0 or !std.math.isFinite(x[d])) return error.CircuitOutputCode;
+        code |= @as(u64, @intFromBool(x[d] > 0)) << @intCast(i);
+    }
+    const mask = (@as(u64, 1) << @intCast(c.family_bits)) - 1;
+    const fam = code & mask;
+    const pay: u32 = @intCast(code >> @intCast(c.family_bits));
+    if (fam >= c.families.len) return error.CircuitOutputFamily;
+    const f = c.families[@intCast(fam)];
+    if (pay >= f.size) return error.CircuitOutputPayload;
+    return f.base + pay;
+}
diff --git a/zig/src/core/runner_circuit_golden_test.zig b/zig/src/core/runner_circuit_golden_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f29d59dc953682933ca95ded933baba10dc0e2bb
--- /dev/null
+++ b/zig/src/core/runner_circuit_golden_test.zig
@@ -0,0 +1,146 @@
+//! T1's reference traces against the CPU circuit: every token, step count and output byte (TF_RUNNER_CIRCUIT/GOLDENS).
+const std = @import("std");
+const rc = @import("runner_circuit.zig");
+
+const gpa = std.testing.allocator;
+
+const Checkpoint = struct { token_count: u64, prefix_sha256: []const u8 };
+const Case = struct {
+    id: []const u8,
+    kind: []const u8,
+    input: struct { bytes_hex: ?[]const u8 = null, elf: ?[]const u8 = null },
+    trace_token_count: u64,
+    generated_steps: u64,
+    token_offset_bytes: u64,
+    trace_sha256: []const u8,
+    final_output_hex: []const u8,
+    checkpoints: []const Checkpoint,
+};
+
+fn env(name: [:0]const u8) ?[]const u8 {
+    const v = std.c.getenv(name) orelse return null;
+    return std.mem.span(v);
+}
+
+fn readFile(dir: []const u8, name: []const u8) ![]u8 {
+    var threaded: std.Io.Threaded = .init_single_threaded;
+    const path = try std.fs.path.join(gpa, &.{ dir, name });
+    defer gpa.free(path);
+    return std.Io.Dir.cwd().readFileAlloc(threaded.io(), path, gpa, .limited(1 << 32));
+}
+
+fn hex(bytes: []const u8) [64]u8 {
+    var d: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(bytes, &d, .{});
+    return std.fmt.bytesToHex(d, .lower);
+}
+
+fn gunzip(bytes: []const u8) ![]u8 {
+    var in: std.Io.Reader = .fixed(bytes);
+    const window = try gpa.alloc(u8, std.compress.flate.max_window_len);
+    defer gpa.free(window);
+    var d: std.compress.flate.Decompress = .init(&in, .gzip, window);
+    return d.reader.allocRemaining(gpa, .unlimited);
+}
+
+/// Every data file's size and SHA-256 must match manifest.json before any row is trusted.
+fn checked(dir: []const u8, manifest: std.json.Value, name: []const u8) ![]u8 {
+    const bytes = try readFile(dir, name);
+    errdefer gpa.free(bytes);
+    const want = manifest.object.get("files").?.object.get(name) orelse return error.GoldenManifest;
+    if (want.object.get("bytes").?.integer != bytes.len) return error.GoldenManifest;
+    if (!std.mem.eql(u8, want.object.get("sha256").?.string, &hex(bytes))) return error.GoldenManifest;
+    return bytes;
+}
+
+test "golden: the CPU circuit reproduces every reference trace token, step count and output byte" {
+    const circuit_path = env("TF_RUNNER_CIRCUIT") orelse {
+        std.debug.print("skip golden: TF_RUNNER_CIRCUIT unset\n", .{});
+        return error.SkipZigTest;
+    };
+    const dir = env("TF_RUNNER_GOLDENS") orelse {
+        std.debug.print("skip golden: TF_RUNNER_GOLDENS unset\n", .{});
+        return error.SkipZigTest;
+    };
+    const limit = if (env("TF_RUNNER_GOLDEN_LIMIT")) |l| try std.fmt.parseInt(u64, l, 10) else std.math.maxInt(u64);
+    var circuit = try rc.Circuit.load(gpa, circuit_path);
+    defer circuit.deinit(gpa);
+    const manifest_bytes = try readFile(dir, "manifest.json");
+    defer gpa.free(manifest_bytes);
+    var manifest = try std.json.parseFromSlice(std.json.Value, gpa, manifest_bytes, .{});
+    defer manifest.deinit();
+    const cases_gz = try checked(dir, manifest.value, "cases.jsonl.gz");
+    defer gpa.free(cases_gz);
+    const tokens_gz = try checked(dir, manifest.value, "tokens.leu32.gz");
+    defer gpa.free(tokens_gz);
+    const lines = try gunzip(cases_gz);
+    defer gpa.free(lines);
+    const blob = try gunzip(tokens_gz);
+    defer gpa.free(blob);
+    var totals: struct { cases: u64 = 0, steps: u64 = 0, ns: u64 = 0, skipped: u64 = 0 } = .{};
+    var it = std.mem.tokenizeScalar(u8, lines, '\n');
+    var calc_seen: u64 = 0;
+    while (it.next()) |line| {
+        var parsed = try std.json.parseFromSlice(Case, gpa, line, .{ .ignore_unknown_fields = true });
+        defer parsed.deinit();
+        const case = parsed.value;
+        const is_calc = std.mem.eql(u8, case.kind, "calc");
+        if (is_calc and std.mem.startsWith(u8, case.id, "calc-")) {
+            calc_seen += 1;
+            if (calc_seen > limit) continue;
+        }
+        const want = blob[case.token_offset_bytes..][0 .. 4 * case.trace_token_count];
+        try std.testing.expectEqualStrings(case.trace_sha256, &hex(want));
+        var input: []u8 = undefined;
+        if (is_calc) {
+            const h = case.input.bytes_hex.?;
+            input = try gpa.alloc(u8, h.len / 2);
+            _ = try std.fmt.hexToBytes(input, h);
+            input = input[0 .. input.len - 1];
+        } else input = try readFile(dir, case.input.elf.?);
+        defer gpa.free(input.ptr[0 .. input.len + @intFromBool(is_calc)]);
+        var m = rc.Machine.boot(gpa, &circuit, .{ .kind = if (is_calc) .calc else .elf, .bytes = input }) catch |e| {
+            if (e != error.CircuitElfUnsupported) return e;
+            std.debug.print("golden {s}: skipped, ELF boot not built yet\n", .{case.id});
+            totals.skipped += 1;
+            continue;
+        };
+        defer m.deinit(gpa);
+        var out: std.ArrayList(u8) = .empty;
+        defer out.deinit(gpa);
+        var trace: std.ArrayList(u32) = .empty;
+        defer trace.deinit(gpa);
+        try trace.append(gpa, circuit.go);
+        var cancel: std.atomic.Value(bool) = .init(false);
+        const t0 = rc.nowNs();
+        const end = m.run(case.generated_steps + 1, &out, &trace, &cancel) catch |e| {
+            std.debug.print("golden {s}: {s} at step {d}\n", .{ case.id, @errorName(e), m.state.steps });
+            return e;
+        };
+        totals.ns += rc.nowNs() - t0;
+        for (trace.items, 0..) |t, i| {
+            if (i * 4 >= want.len) return error.GoldenTraceLonger;
+            const w = std.mem.readInt(u32, want[4 * i ..][0..4], .little);
+            if (t != w) {
+                std.debug.print("golden {s}: token {d} is {d}, reference {d}\n", .{ case.id, i, t, w });
+                return error.GoldenTokenMismatch;
+            }
+        }
+        try std.testing.expectEqual(case.trace_token_count, trace.items.len);
+        try std.testing.expectEqual(case.generated_steps, end.steps);
+        try std.testing.expect(end.end == .halted);
+        const want_out = try gpa.alloc(u8, case.final_output_hex.len / 2);
+        defer gpa.free(want_out);
+        _ = try std.fmt.hexToBytes(want_out, case.final_output_hex);
+        try std.testing.expectEqualStrings(want_out, out.items);
+        for (case.checkpoints) |cp| {
+            const prefix = std.mem.sliceAsBytes(trace.items[0..cp.token_count]);
+            try std.testing.expectEqualStrings(cp.prefix_sha256, &hex(prefix));
+        }
+        totals.cases += 1;
+        totals.steps += end.steps;
+    }
+    const rate = if (totals.ns == 0) 0 else totals.steps * std.time.ns_per_s / totals.ns;
+    std.debug.print("golden: {d} cases token-exact, {d} steps, {d} steps/s, {d} skipped\n", .{ totals.cases, totals.steps, rate, totals.skipped });
+    try std.testing.expect(totals.cases > 0);
+}
diff --git a/zig/src/core/runner_circuit_load.zig b/zig/src/core/runner_circuit_load.zig
new file mode 100644
index 0000000000000000000000000000000000000000..c6cb4f048750ebcc5e4ee4358bdaf2f5d87cf31c
--- /dev/null
+++ b/zig/src/core/runner_circuit_load.zig
@@ -0,0 +1,400 @@
+//! Reads a TFIMR001 circuit container (CIRCUIT-FORMAT.md v1) into batched, hazard-checked runtime form.
+const std = @import("std");
+const model = @import("runner_circuit_model.zig");
+
+const Scalar = model.Scalar;
+const hd = model.hd;
+const header_bytes = 64;
+
+const Term = struct { u32, f64 };
+const Expr = []const Term;
+const Chan = struct { expr: Expr, taps: [model.lags]f64 };
+const ChanAt = struct { u32, Chan };
+const ExprAt = struct { u32, Expr };
+const OutAt = struct { u32, u32, f64 };
+const InitRow = struct { u32, []const Term };
+const JValueHead = struct { v: []const ChanAt, a: Expr, beta: ?Expr, z: []const ExprAt, out: []const OutAt, into: bool, init: []const InitRow };
+const JNode = struct {
+    kind: []const u8,
+    name: []const u8 = "",
+    out: ?u32 = null,
+    into: ?bool = null,
+    terms: ?[]const struct { f64, Expr, Expr } = null,
+    n_cols: ?u32 = null,
+    levels: ?[]const u8 = null,
+    q: ?[]const ChanAt = null,
+    k: ?[]const ChanAt = null,
+    value_heads: ?[]const JValueHead = null,
+};
+const JFeature = struct { dim: u32, kind: []const u8, family: ?u32 = null, bit: ?u32 = null, digit: ?u32 = null, qs_family: ?u32 = null, qd_family: ?u32 = null, family_bits: ?u32 = null, amplitude: ?f64 = null };
+const JFamily = struct { name: []const u8, base: u32, size: u32 };
+const Doc = struct {
+    format: []const u8,
+    version: u32,
+    stats: struct { dims: u32 },
+    constants: struct { one_dim: u32, head_dim: u32, a_ref: f64, a_bit: f64, ref_cols: [2]u32 },
+    dims: []const struct { name: []const u8 },
+    features: []const JFeature,
+    nodes: []const JNode,
+    tokens: struct { vocab: u32, families: []const JFamily, go: u32, halt: u32, byte_family: u32 },
+    output: struct { family_bits: u32, payload_bits: u32, code_dims: []const u32, families: []const JFamily },
+    program: struct { kind: []const u8, input_address: u32, input_capacity: u32 },
+};
+
+/// The checked JSON payload of a container: magic, version, sizes, flags and SHA-256 all as the format requires.
+pub fn payload(bytes: []const u8) !struct { []const u8, [32]u8 } {
+    if (bytes.len < header_bytes) return error.CircuitTruncated;
+    if (!std.mem.eql(u8, bytes[0..8], "TFIMR001")) return error.CircuitMagic;
+    const r = std.mem.readInt;
+    if (r(u32, bytes[8..12], .little) != 1 or r(u32, bytes[12..16], .little) != header_bytes) return error.CircuitVersion;
+    if (r(u32, bytes[24..28], .little) != 0 or r(u32, bytes[28..32], .little) != 0) return error.CircuitFlags;
+    if (r(u64, bytes[16..24], .little) != bytes.len - header_bytes) return error.CircuitTruncated;
+    const body = bytes[header_bytes..];
+    var digest: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(body, &digest, .{});
+    if (!std.mem.eql(u8, &digest, bytes[32..64])) return error.CircuitChecksum;
+    return .{ body, digest };
+}
+
+/// Reads a container file; at most 1 GiB.
+pub fn fromPath(gpa: std.mem.Allocator, path: []const u8) !model.Circuit {
+    var threaded: std.Io.Threaded = .init_single_threaded;
+    const io = threaded.io();
+    const bytes = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 30));
+    defer gpa.free(bytes);
+    return fromBytes(gpa, bytes);
+}
+
+/// Parses and compiles a whole container; the circuit owns everything through its arena.
+pub fn fromBytes(gpa: std.mem.Allocator, bytes: []const u8) !model.Circuit {
+    const body, const digest = try payload(bytes);
+    var parse_arena = std.heap.ArenaAllocator.init(gpa);
+    defer parse_arena.deinit();
+    const doc = std.json.parseFromSliceLeaky(Doc, parse_arena.allocator(), body, .{ .ignore_unknown_fields = true }) catch
+        return error.CircuitJson;
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    errdefer arena.deinit();
+    var c = try compile(arena.allocator(), parse_arena.allocator(), &doc);
+    c.payload_sha256 = digest;
+    c.arena = arena;
+    return c;
+}
+
+fn exact(v: f64) !Scalar {
+    if (!std.math.isFinite(v)) return error.CircuitNumber;
+    const s: Scalar = @floatCast(v);
+    if (@as(f64, s) != v) return error.CircuitNotExact;
+    return s;
+}
+
+fn compile(a: std.mem.Allocator, tmp: std.mem.Allocator, doc: *const Doc) !model.Circuit {
+    if (!std.mem.eql(u8, doc.format, "tensorfold.runner.p2") or doc.version != 1) return error.CircuitVersion;
+    const dims: u32 = @intCast(doc.dims.len);
+    const k = doc.constants;
+    if (dims == 0 or dims != doc.stats.dims or k.one_dim != 0 or k.head_dim != hd) return error.CircuitDims;
+    if (k.ref_cols[0] != 0 or k.ref_cols[1] != 1) return error.CircuitDims;
+    const families = try a.alloc(model.Family, doc.tokens.families.len);
+    var end: u32 = 0;
+    for (doc.tokens.families, doc.output.families, families) |f, g, *out| {
+        if (f.base != end or f.size == 0 or f.size > 1 << 16 or f.base != g.base or f.size != g.size) return error.CircuitFamilies;
+        out.* = .{ .base = f.base, .size = f.size };
+        end += f.size;
+    }
+    if (doc.tokens.families.len != doc.output.families.len or end != doc.tokens.vocab) return error.CircuitFamilies;
+    const o = doc.output;
+    if (o.family_bits == 0 or o.family_bits > 16 or o.payload_bits != 16 or o.code_dims.len != o.family_bits + 16) return error.CircuitOutputCode;
+    if (@as(usize, 1) << @intCast(o.family_bits) < families.len) return error.CircuitOutputCode;
+    for (o.code_dims) |d| if (d >= dims) return error.CircuitIndex;
+    if (doc.tokens.go >= end or doc.tokens.halt >= end or doc.tokens.byte_family >= families.len) return error.CircuitTokens;
+    var b: Builder = .{ .a = a, .tmp = tmp, .dims = dims };
+    for (doc.nodes) |*n| try b.node(n);
+    try b.flush();
+    return .{
+        .dims = dims,
+        .batches = b.batches.items,
+        .features = try features(a, doc, dims, @intCast(families.len)),
+        .families = families,
+        .family_bits = o.family_bits,
+        .code_dims = try a.dupe(u32, o.code_dims),
+        .go = doc.tokens.go,
+        .halt = doc.tokens.halt,
+        .byte_family = doc.tokens.byte_family,
+        .fault_family = for (doc.tokens.families, 0..) |f, i| {
+            if (std.mem.eql(u8, f.name, "FLT")) break @intCast(i);
+        } else null,
+        .tables = b.tables.items,
+        .table_names = b.names.items,
+        .channels = b.channels,
+        .nodes = @intCast(doc.nodes.len),
+        .program = try program(doc, b.names.items, b.tables.items),
+        .payload_sha256 = undefined,
+        .arena = undefined,
+    };
+}
+
+fn features(a: std.mem.Allocator, doc: *const Doc, dims: u32, n_families: u32) ![]model.Feature {
+    const out = try a.alloc(model.Feature, doc.features.len);
+    for (doc.features, out) |f, *g| {
+        if (f.dim == 0 or f.dim >= dims) return error.CircuitFeatures;
+        const kind = std.meta.stringToEnum(model.Feature.Kind, f.kind) orelse return error.CircuitFeatures;
+        g.* = .{ .dim = f.dim, .kind = kind };
+        switch (kind) {
+            .family, .payload_bit => {
+                g.family = f.family orelse return error.CircuitFeatures;
+                if (kind == .payload_bit) g.bit = f.bit orelse return error.CircuitFeatures;
+                if (g.family >= n_families or g.bit >= 16) return error.CircuitFeatures;
+            },
+            .next_digit => {
+                g.digit = f.digit orelse return error.CircuitFeatures;
+                g.family = f.qs_family orelse return error.CircuitFeatures;
+                g.qd_family = f.qd_family orelse return error.CircuitFeatures;
+                if (g.digit >= 8 or g.family >= n_families or g.qd_family >= n_families) return error.CircuitFeatures;
+            },
+            .code_bit => {
+                g.bit = f.bit orelse return error.CircuitFeatures;
+                g.amplitude = try exact(f.amplitude orelse return error.CircuitFeatures);
+                if (f.family_bits != doc.output.family_bits or g.bit >= doc.output.family_bits + 16) return error.CircuitFeatures;
+            },
+        }
+    }
+    return out;
+}
+
+fn program(doc: *const Doc, names: []const []const u8, tables: []const model.Table) !model.Program {
+    const p = doc.program;
+    var out: model.Program = .{
+        .kind = if (std.mem.eql(u8, p.kind, "calc")) .calc else if (std.mem.eql(u8, p.kind, "elf")) .elf else return error.CircuitProgram,
+        .input_address = p.input_address,
+        .input_capacity = p.input_capacity,
+        .ram_tables = @splat(std.math.maxInt(u32)),
+        .a_ref = try exact(doc.constants.a_ref),
+        .a_bit = try exact(doc.constants.a_bit),
+    };
+    for (names, 0..) |name, t| {
+        if (!std.mem.startsWith(u8, name, "ram")) continue;
+        const h = std.fmt.parseInt(u5, name[3..], 10) catch continue;
+        if (out.ram_tables[h] == std.math.maxInt(u32)) out.ram_tables[h] = @intCast(t);
+    }
+    for (out.ram_tables) |t| {
+        if (t == std.math.maxInt(u32)) continue;
+        if (t + 1 >= tables.len or !tables[t].writable or !tables[t + 1].writable) return error.CircuitProgram;
+    }
+    return out;
+}
+
+/// Accumulates nodes into batches: a batch ends at a kind change or at a read of a dim the batch already wrote.
+const Builder = struct {
+    a: std.mem.Allocator,
+    tmp: std.mem.Allocator,
+    dims: u32,
+    batches: std.ArrayList(model.Batch) = .empty,
+    tables: std.ArrayList(model.Table) = .empty,
+    names: std.ArrayList([]const u8) = .empty,
+    channels: u32 = 0,
+    pending: std.ArrayList(*const JNode) = .empty,
+    pending_heads: bool = false,
+    written: std.DynamicBitSetUnmanaged = .{},
+
+    fn node(b: *Builder, n: *const JNode) !void {
+        if (b.written.bit_length == 0) b.written = try .initEmpty(b.tmp, b.dims);
+        const is_head = std.mem.eql(u8, n.kind, "head");
+        if (!is_head and !std.mem.eql(u8, n.kind, "ffn")) return error.CircuitNodeKind;
+        var reads: std.ArrayList(u32) = .empty;
+        var writes: std.ArrayList(u32) = .empty;
+        if (is_head) try headDims(b, n, &reads, &writes) else try ffnDims(b, n, &reads, &writes);
+        var hazard = b.pending.items.len > 0 and is_head != b.pending_heads;
+        for (reads.items) |d| hazard = hazard or b.written.isSet(d);
+        if (hazard) try b.flush();
+        b.pending_heads = is_head;
+        try b.pending.append(b.tmp, n);
+        for (writes.items) |d| b.written.set(d);
+    }
+
+    fn check(b: *Builder, e: Expr, reads: *std.ArrayList(u32)) !void {
+        for (e, 0..) |t, i| {
+            if (t[0] >= b.dims) return error.CircuitIndex;
+            for (e[0..i]) |u| if (u[0] == t[0]) return error.CircuitDuplicateDim;
+            _ = try exact(t[1]);
+            try reads.append(b.tmp, t[0]);
+        }
+    }
+
+    fn ffnDims(b: *Builder, n: *const JNode, reads: *std.ArrayList(u32), writes: *std.ArrayList(u32)) !void {
+        const out = n.out orelse return error.CircuitNode;
+        if (out >= b.dims or n.into == null) return error.CircuitIndex;
+        for (n.terms orelse return error.CircuitNode) |t| {
+            _ = try exact(t[0]);
+            try b.check(t[1], reads);
+            try b.check(t[2], reads);
+        }
+        try writes.append(b.tmp, out);
+    }
+
+    fn headDims(b: *Builder, n: *const JNode, reads: *std.ArrayList(u32), writes: *std.ArrayList(u32)) !void {
+        if (n.n_cols != hd) return error.CircuitHeadShape;
+        for ([_]?[]const ChanAt{ n.q, n.k }) |chans| for (chans orelse return error.CircuitNode) |ch| try b.channel(ch, reads);
+        for (n.value_heads orelse return error.CircuitNode) |*vh| {
+            const own = writes.items.len;
+            var mine: std.ArrayList(u32) = .empty;
+            for (vh.v) |ch| try b.channel(ch, &mine);
+            try b.check(vh.a, &mine);
+            if (vh.beta) |e| try b.check(e, &mine);
+            for (vh.z) |z| {
+                if (z[0] >= hd) return error.CircuitIndex;
+                try b.check(z[1], &mine);
+            }
+            for (mine.items) |d| for (writes.items[0..own]) |w| if (d == w) return error.CircuitHazard;
+            try reads.appendSlice(b.tmp, mine.items);
+            for (vh.out) |t| {
+                if (t[0] >= hd or t[1] >= b.dims) return error.CircuitIndex;
+                _ = try exact(t[2]);
+                try writes.append(b.tmp, t[1]);
+            }
+        }
+    }
+
+    fn channel(b: *Builder, ch: ChanAt, reads: *std.ArrayList(u32)) !void {
+        if (ch[0] >= hd) return error.CircuitIndex;
+        try b.check(ch[1].expr, reads);
+        for (ch[1].taps) |t| _ = try exact(t);
+    }
+
+    fn flush(b: *Builder) !void {
+        if (b.pending.items.len == 0) return;
+        const batch: model.Batch = if (b.pending_heads) .{ .heads = try b.headBatch() } else .{ .ffn = try b.ffnBatch() };
+        try b.batches.append(b.a, batch);
+        b.pending.clearRetainingCapacity();
+        b.written.unsetAll();
+    }
+
+    fn ffnBatch(b: *Builder) !model.Ffn {
+        var src: std.ArrayList(u32) = .empty;
+        var dst: std.ArrayList(u32) = .empty;
+        var w: std.ArrayList(Scalar) = .empty;
+        var gsrc: std.ArrayList(u32) = .empty;
+        var gdst: std.ArrayList(u32) = .empty;
+        var gw: std.ArrayList(Scalar) = .empty;
+        var coef: std.ArrayList(Scalar) = .empty;
+        var slot: std.ArrayList(u32) = .empty;
+        const outs = try b.a.alloc(model.Out, b.pending.items.len);
+        for (b.pending.items, outs, 0..) |n, *out, s| {
+            out.* = .{ .dim = n.out.?, .into = n.into.? };
+            for (n.terms.?) |t| {
+                const term: u32 = @intCast(coef.items.len);
+                try coef.append(b.a, try exact(t[0]));
+                try slot.append(b.a, @intCast(s));
+                for (t[1]) |e| try triple(b.tmp, &src, &dst, &w, e[0], term, e[1]);
+                for (t[2]) |e| try triple(b.tmp, &gsrc, &gdst, &gw, e[0], term, e[1]);
+            }
+        }
+        const terms: u32 = @intCast(coef.items.len);
+        return .{
+            .terms = terms,
+            .up = try model.sparse(b.a, b.dims, terms, src.items, dst.items, w.items),
+            .gate = try model.sparse(b.a, b.dims, terms, gsrc.items, gdst.items, gw.items),
+            .coef = coef.items,
+            .slot = slot.items,
+            .outs = outs,
+        };
+    }
+
+    fn headBatch(b: *Builder) !model.Heads {
+        var src: std.ArrayList(u32) = .empty;
+        var dst: std.ArrayList(u32) = .empty;
+        var w: std.ArrayList(Scalar) = .empty;
+        var taps: std.ArrayList([model.lags]Scalar) = .empty;
+        for (b.pending.items) |n| {
+            for ([_][]const ChanAt{ n.q.?, n.k.? }) |chans| for (chans) |ch| try b.addChannel(&src, &dst, &w, &taps, ch[1]);
+            for (n.value_heads.?) |vh| for (vh.v) |ch| try b.addChannel(&src, &dst, &w, &taps, ch[1]);
+        }
+        const channels: u32 = @intCast(taps.items.len);
+        var column = channels;
+        var chan: u32 = 0;
+        var outs: std.ArrayList(model.Out) = .empty;
+        const heads = try b.a.alloc(model.Head, b.pending.items.len);
+        for (b.pending.items, heads) |n, *h| {
+            const q = try b.picks(n.q.?, &chan);
+            const kk = try b.picks(n.k.?, &chan);
+            const vhs = try b.a.alloc(model.ValueHead, n.value_heads.?.len);
+            for (n.value_heads.?, vhs) |*jv, *vh| {
+                const table: u32 = @intCast(b.tables.items.len);
+                try b.tables.append(b.a, try initTable(b.a, jv, kk.len > 0 or jv.a.len > 0));
+                try b.names.append(b.a, try b.a.dupe(u8, n.name));
+                vh.* = .{ .table = table, .v = try b.picks(jv.v, &chan), .a = null, .beta = null, .z = &.{}, .out_first = @intCast(outs.items.len), .out_cols = &.{}, .out_w = &.{} };
+                if (jv.a.len > 0) vh.a = try plain(b.tmp, &src, &dst, &w, jv.a, &column);
+                if (jv.beta) |e| vh.beta = try plain(b.tmp, &src, &dst, &w, e, &column);
+                const z = try b.a.alloc(model.Pick, jv.z.len);
+                for (jv.z, z) |e, *p| p.* = .{ .at = e[0], .column = try plain(b.tmp, &src, &dst, &w, e[1], &column) };
+                vh.z = z;
+                const cols = try b.a.alloc(u32, jv.out.len);
+                const ws = try b.a.alloc(Scalar, jv.out.len);
+                for (jv.out, cols, ws) |t, *c, *x| {
+                    c.* = t[0];
+                    x.* = try exact(t[2]);
+                    try outs.append(b.a, .{ .dim = t[1], .into = jv.into });
+                }
+                vh.out_cols = cols;
+                vh.out_w = ws;
+            }
+            h.* = .{ .q = q, .k = kk, .value_heads = vhs };
+        }
+        const first = b.channels;
+        b.channels += channels;
+        return .{
+            .proj = try model.sparse(b.a, b.dims, column, src.items, dst.items, w.items),
+            .channels = channels,
+            .first_channel = first,
+            .taps = taps.items,
+            .heads = heads,
+            .outs = outs.items,
+        };
+    }
+
+    fn addChannel(b: *Builder, src: *std.ArrayList(u32), dst: *std.ArrayList(u32), w: *std.ArrayList(Scalar), taps: *std.ArrayList([model.lags]Scalar), ch: Chan) !void {
+        const column: u32 = @intCast(taps.items.len);
+        for (ch.expr) |e| try triple(b.tmp, src, dst, w, e[0], column, e[1]);
+        var t: [model.lags]Scalar = undefined;
+        for (&t, ch.taps) |*x, v| x.* = try exact(v);
+        try taps.append(b.a, t);
+    }
+
+    fn picks(b: *Builder, chans: []const ChanAt, next: *u32) ![]model.Pick {
+        const out = try b.a.alloc(model.Pick, chans.len);
+        for (chans, out, 0..) |ch, *p, i| {
+            for (chans[0..i]) |prev| if (prev[0] == ch[0]) return error.CircuitDuplicateChannel;
+            p.* = .{ .at = ch[0], .column = next.* };
+            next.* += 1;
+        }
+        return out;
+    }
+};
+
+fn triple(a: std.mem.Allocator, src: *std.ArrayList(u32), dst: *std.ArrayList(u32), w: *std.ArrayList(Scalar), s: u32, d: u32, v: f64) !void {
+    try src.append(a, s);
+    try dst.append(a, d);
+    try w.append(a, try exact(v));
+}
+
+fn plain(a: std.mem.Allocator, src: *std.ArrayList(u32), dst: *std.ArrayList(u32), w: *std.ArrayList(Scalar), e: Expr, column: *u32) !u32 {
+    const at = column.*;
+    for (e) |t| try triple(a, src, dst, w, t[0], at, t[1]);
+    column.* += 1;
+    return at;
+}
+
+fn initTable(a: std.mem.Allocator, vh: *const JValueHead, writable: bool) !model.Table {
+    const rows = try a.alloc(Scalar, hd * hd);
+    @memset(rows, 0);
+    var present: u128 = 0;
+    for (vh.init) |r| {
+        if (r[0] >= hd) return error.CircuitIndex;
+        const bit = @as(u128, 1) << @intCast(r[0]);
+        if (present & bit != 0) return error.CircuitDuplicateRow;
+        present |= bit;
+        for (r[1]) |cv| {
+            if (cv[0] >= hd) return error.CircuitIndex;
+            rows[r[0] * hd + cv[0]] = try exact(cv[1]);
+        }
+    }
+    return .{ .present = present, .rows = rows, .writable = writable };
+}
diff --git a/zig/src/core/runner_circuit_model.zig b/zig/src/core/runner_circuit_model.zig
new file mode 100644
index 0000000000000000000000000000000000000000..429b44ec57b52f698a37e6bd4fc22873a5579969
--- /dev/null
+++ b/zig/src/core/runner_circuit_model.zig
@@ -0,0 +1,224 @@
+//! A compiled circuit in memory: batched SwiGLU units and one-hot DeltaNet heads in stored node order.
+const std = @import("std");
+
+/// Evaluation precision; the loader refuses any weight or state value this type cannot hold exactly.
+pub const Scalar = f32;
+/// Key/value head width and the rows a one-hot key can address.
+pub const hd: u32 = 128;
+/// Conv taps of a q/k/v channel: projections at t, t-1, t-2, t-3.
+pub const lags: u32 = 4;
+/// Decay selectors (Qwenputer's DECAY with dt_bias -110): keep, halve, clear.
+pub const keep_selector: Scalar = 0;
+pub const halve_selector: Scalar = 110;
+pub const clear_selector: Scalar = 238;
+
+/// y[dst] += x[src] * w over the nonzeros, stored by source so zero inputs cost nothing.
+pub const Sparse = struct {
+    sources: u32,
+    outputs: u32,
+    starts: []const u32,
+    dst: []const u32,
+    w: []const Scalar,
+
+    pub fn apply(m: *const Sparse, x: []const Scalar, y: []Scalar) void {
+        for (x, 0..) |v, i| {
+            if (v == 0) continue;
+            for (m.starts[i]..m.starts[i + 1]) |e| y[m.dst[e]] += v * m.w[e];
+        }
+    }
+
+    pub fn nonzeros(m: *const Sparse) usize {
+        return m.dst.len;
+    }
+};
+
+/// Where a node's value lands: x[dim] = value, or x[dim] += value when `into`.
+pub const Out = struct { dim: u32, into: bool };
+
+/// Consecutive FFN nodes with no read of a dim written earlier in the batch: y = sum c * up * max(gate, 0).
+pub const Ffn = struct {
+    terms: u32,
+    up: Sparse,
+    gate: Sparse,
+    coef: []const Scalar,
+    slot: []const u32,
+    outs: []const Out,
+};
+
+/// (row or column, projection column) of a channel or expression.
+pub const Pick = struct { at: u32, column: u32 };
+
+pub const ValueHead = struct {
+    table: u32,
+    v: []const Pick,
+    a: ?u32,
+    beta: ?u32,
+    z: []const Pick,
+    out_first: u32,
+    out_cols: []const u32,
+    out_w: []const Scalar,
+};
+
+pub const Head = struct {
+    q: []const Pick,
+    k: []const Pick,
+    value_heads: []const ValueHead,
+};
+
+/// Consecutive head nodes. Projection columns [0, channels) are conv channels with taps; the rest are plain exprs.
+pub const Heads = struct {
+    proj: Sparse,
+    channels: u32,
+    first_channel: u32,
+    taps: []const [lags]Scalar,
+    heads: []const Head,
+    outs: []const Out,
+};
+
+pub const Batch = union(enum) { ffn: Ffn, heads: Heads };
+
+/// One input feature: its dim's value is a function of the token's family id and payload.
+pub const Feature = struct {
+    dim: u32,
+    kind: Kind,
+    family: u32 = 0,
+    bit: u32 = 0,
+    digit: u32 = 0,
+    qd_family: u32 = 0,
+    amplitude: Scalar = 0,
+
+    pub const Kind = enum { family, payload_bit, next_digit, code_bit };
+
+    pub fn value(f: Feature, fam: u32, pay: u32, family_bits: u32) Scalar {
+        return switch (f.kind) {
+            .family => @floatFromInt(@intFromBool(fam == f.family)),
+            .payload_bit => if (fam == f.family) @floatFromInt(pay >> @intCast(f.bit) & 1) else 0,
+            .next_digit => @floatFromInt(@intFromBool((fam == f.family and pay == f.digit) or
+                (f.digit > 0 and fam == f.qd_family and pay >> 4 == f.digit - 1))),
+            .code_bit => blk: {
+                const code = @as(u64, fam) | @as(u64, pay) << @intCast(family_bits);
+                break :blk if (code >> @intCast(f.bit) & 1 == 1) f.amplitude else -f.amplitude;
+            },
+        };
+    }
+};
+
+pub const Family = struct { base: u32, size: u32 };
+
+/// A head's initial table: present rows (bit mask) of hd columns each, row-major hd x hd.
+pub const Table = struct {
+    present: u128,
+    rows: []const Scalar,
+    writable: bool,
+};
+
+/// Where the calc firmware takes its expression, and the RAM tables (ram<h>) the snapshot patch edits.
+pub const Program = struct {
+    kind: enum { calc, elf },
+    input_address: u32,
+    input_capacity: u32,
+    ram_tables: [32]u32,
+    a_ref: Scalar,
+    a_bit: Scalar,
+};
+
+pub const Circuit = struct {
+    dims: u32,
+    batches: []const Batch,
+    features: []const Feature,
+    families: []const Family,
+    family_bits: u32,
+    code_dims: []const u32,
+    go: u32,
+    halt: u32,
+    byte_family: u32,
+    fault_family: ?u32,
+    tables: []const Table,
+    table_names: []const []const u8,
+    channels: u32,
+    nodes: u32,
+    program: Program,
+    payload_sha256: [32]u8,
+    arena: std.heap.ArenaAllocator,
+
+    /// Reads and checks a circuit file (CIRCUIT-FORMAT.md v1).
+    pub fn load(gpa: std.mem.Allocator, path: []const u8) !Circuit {
+        return @import("runner_circuit_load.zig").fromPath(gpa, path);
+    }
+
+    /// The arena owns everything; `gpa` is the allocator `load` was given.
+    pub fn deinit(c: *Circuit, gpa: std.mem.Allocator) void {
+        _ = gpa;
+        c.arena.deinit();
+        c.* = undefined;
+    }
+
+    /// The family id and payload of token t, or null when t is outside the vocabulary.
+    pub fn split(c: *const Circuit, t: u32) ?struct { u32, u32 } {
+        var lo: usize = 0;
+        var hi: usize = c.families.len;
+        while (lo < hi) {
+            const mid = (lo + hi) / 2;
+            const f = c.families[mid];
+            if (t < f.base) hi = mid else if (t - f.base >= f.size) lo = mid + 1 else return .{ @intCast(mid), t - f.base };
+        }
+        return null;
+    }
+
+    /// Weights the evaluator reads per step, for sizing and reports.
+    pub fn nonzeros(c: *const Circuit) usize {
+        var n: usize = 0;
+        for (c.batches) |*b| n += switch (b.*) {
+            .ffn => |*f| f.up.nonzeros() + f.gate.nonzeros(),
+            .heads => |*h| h.proj.nonzeros(),
+        };
+        return n;
+    }
+};
+
+/// Builds a Sparse from (source, output, weight) triples in any order; a source's entries keep their input order.
+pub fn sparse(a: std.mem.Allocator, sources: u32, outputs: u32, src: []const u32, dst_in: []const u32, w_in: []const Scalar) !Sparse {
+    if (src.len != dst_in.len or src.len != w_in.len) return error.CircuitSparseShape;
+    const starts = try a.alloc(u32, sources + 1);
+    @memset(starts, 0);
+    for (src) |s| {
+        if (s >= sources) return error.CircuitIndex;
+        starts[s + 1] += 1;
+    }
+    for (1..starts.len) |i| starts[i] += starts[i - 1];
+    const fill = try a.dupe(u32, starts[0..sources]);
+    defer a.free(fill);
+    const dst = try a.alloc(u32, src.len);
+    const w = try a.alloc(Scalar, src.len);
+    for (src, dst_in, w_in) |s, d, v| {
+        if (d >= outputs) return error.CircuitIndex;
+        dst[fill[s]] = d;
+        w[fill[s]] = v;
+        fill[s] += 1;
+    }
+    return .{ .sources = sources, .outputs = outputs, .starts = starts, .dst = dst, .w = w };
+}
+
+test "sparse apply skips zero inputs and adds repeated entries" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const m = try sparse(arena.allocator(), 3, 2, &.{ 0, 2, 2, 1 }, &.{ 1, 0, 0, 1 }, &.{ 2, 3, 4, 5 });
+    var y = [_]Scalar{ 0, 0 };
+    m.apply(&.{ 1, 0, 2 }, &y);
+    try std.testing.expectEqualSlices(Scalar, &.{ 14, 2 }, &y);
+    try std.testing.expectError(error.CircuitIndex, sparse(arena.allocator(), 3, 2, &.{3}, &.{0}, &.{1}));
+}
+
+test "features follow the format's token-bus encodings" {
+    const nd: Feature = .{ .dim = 1, .kind = .next_digit, .family = 9, .qd_family = 10, .digit = 0 };
+    try std.testing.expectEqual(@as(Scalar, 1), nd.value(9, 0, 5));
+    try std.testing.expectEqual(@as(Scalar, 0), nd.value(10, 0xff, 5));
+    const nd3: Feature = .{ .dim = 1, .kind = .next_digit, .family = 9, .qd_family = 10, .digit = 3 };
+    try std.testing.expectEqual(@as(Scalar, 1), nd3.value(10, 2 << 4 | 7, 5));
+    const cb: Feature = .{ .dim = 1, .kind = .code_bit, .bit = 6, .amplitude = 128 };
+    try std.testing.expectEqual(@as(Scalar, 128), cb.value(3, 2, 5));
+    try std.testing.expectEqual(@as(Scalar, -128), cb.value(3, 1, 5));
+    const pb: Feature = .{ .dim = 1, .kind = .payload_bit, .family = 4, .bit = 2 };
+    try std.testing.expectEqual(@as(Scalar, 1), pb.value(4, 4, 5));
+    try std.testing.expectEqual(@as(Scalar, 0), pb.value(5, 4, 5));
+}
diff --git a/zig/src/core/runner_circuit_state.zig b/zig/src/core/runner_circuit_state.zig
new file mode 100644
index 0000000000000000000000000000000000000000..5ac4f92e08048642435815f95165af8cdcf6e96e
--- /dev/null
+++ b/zig/src/core/runner_circuit_state.zig
@@ -0,0 +1,121 @@
+//! Per-machine circuit state: the DeltaNet tables (the RAM op's rows), per-channel conv history and canonical bytes.
+const std = @import("std");
+const model = @import("runner_circuit_model.zig");
+
+const Scalar = model.Scalar;
+const hd = model.hd;
+const table_floats = hd * hd;
+const history = model.lags - 1;
+
+/// Read-only tables stay shared with the circuit; tables a key or decay can change are copied per machine.
+pub const State = struct {
+    gpa: std.mem.Allocator,
+    circuit: *const model.Circuit,
+    tables: [][]Scalar,
+    present: []u128,
+    history: []Scalar,
+    steps: u64 = 0,
+    x: []Scalar,
+    work: []Scalar,
+
+    pub fn init(gpa: std.mem.Allocator, c: *const model.Circuit) !State {
+        const tables = try gpa.alloc([]Scalar, c.tables.len);
+        errdefer gpa.free(tables);
+        var copied: usize = 0;
+        errdefer for (c.tables[0..copied], tables[0..copied]) |t, s| if (t.writable) gpa.free(s);
+        for (c.tables, tables) |t, *s| {
+            s.* = if (t.writable) try gpa.dupe(Scalar, t.rows) else @constCast(t.rows);
+            copied += 1;
+        }
+        const present = try gpa.alloc(u128, c.tables.len);
+        errdefer gpa.free(present);
+        for (c.tables, present) |t, *p| p.* = t.present;
+        const hist = try gpa.alloc(Scalar, @as(usize, c.channels) * history);
+        errdefer gpa.free(hist);
+        @memset(hist, 0);
+        const x = try gpa.alloc(Scalar, c.dims);
+        errdefer gpa.free(x);
+        const work = try gpa.alloc(Scalar, workSize(c));
+        return .{ .gpa = gpa, .circuit = c, .tables = tables, .present = present, .history = hist, .x = x, .work = work };
+    }
+
+    pub fn deinit(s: *State) void {
+        for (s.circuit.tables, s.tables) |t, rows| if (t.writable) s.gpa.free(rows);
+        s.gpa.free(s.tables);
+        s.gpa.free(s.present);
+        s.gpa.free(s.history);
+        s.gpa.free(s.x);
+        s.gpa.free(s.work);
+        s.* = undefined;
+    }
+
+    pub fn writable(s: *const State, table: u32) bool {
+        return s.circuit.tables[table].writable;
+    }
+
+    pub fn row(s: *State, table: u32, r: u32) []Scalar {
+        return s.tables[table][r * hd ..][0..hd];
+    }
+
+    pub fn rowPresent(s: *const State, table: u32, r: u32) bool {
+        return s.present[table] >> @intCast(r) & 1 == 1;
+    }
+
+    /// Replaces one row (the RAM op's write); only tables the circuit can change are writable.
+    pub fn writeRow(s: *State, table: u32, r: u32, values: []const Scalar) !void {
+        if (!s.writable(table)) return error.CircuitTableReadOnly;
+        if (r >= hd or values.len != hd) return error.CircuitIndex;
+        @memcpy(s.row(table, r), values);
+        s.present[table] |= @as(u128, 1) << @intCast(r);
+    }
+
+    pub fn clearRow(s: *State, table: u32, r: u32) !void {
+        if (!s.writable(table)) return error.CircuitTableReadOnly;
+        if (r >= hd) return error.CircuitIndex;
+        @memset(s.row(table, r), 0);
+        s.present[table] &= ~(@as(u128, 1) << @intCast(r));
+    }
+
+    /// The last three pre-convolution projections of global channel i, newest first.
+    pub fn channelHistory(s: *State, i: u32) *[history]Scalar {
+        return s.history[i * history ..][0..history];
+    }
+
+    /// Bytes this machine owns beyond the shared circuit (copied tables, history, scratch), for admission.
+    pub fn ownedBytes(s: *const State) usize {
+        var n: usize = (s.history.len + s.x.len + s.work.len) * @sizeOf(Scalar);
+        for (s.circuit.tables) |t| n += if (t.writable) table_floats * @sizeOf(Scalar) else 0;
+        return n;
+    }
+
+    /// Canonical bytes: steps, then every table and every channel history as binary64 LE, absent rows as zeros.
+    pub fn canonical(s: *const State, gpa: std.mem.Allocator) ![]u8 {
+        const n = 8 + (s.tables.len * table_floats + s.history.len) * 8;
+        const out = try gpa.alloc(u8, n);
+        std.mem.writeInt(u64, out[0..8], s.steps, .little);
+        var at: usize = 8;
+        for (s.tables, s.present) |t, p| for (0..hd) |r| {
+            const live = p >> @intCast(r) & 1 == 1;
+            for (t[r * hd ..][0..hd]) |v| {
+                const w: f64 = if (live) v else 0;
+                std.mem.writeInt(u64, out[at..][0..8], @bitCast(w + 0), .little);
+                at += 8;
+            }
+        };
+        for (s.history) |v| {
+            const w: f64 = v;
+            std.mem.writeInt(u64, out[at..][0..8], @bitCast(w + 0), .little);
+            at += 8;
+        }
+        return out;
+    }
+};
+
+fn workSize(c: *const model.Circuit) usize {
+    var n: usize = 0;
+    for (c.batches) |*b| n = @max(n, switch (b.*) {
+        .ffn => |*f| 2 * @as(usize, f.terms) + f.outs.len,
+        .heads => |*h| h.proj.outputs + h.outs.len + 5 * hd,
+    });
+    return n;
+}
diff --git a/zig/src/core/runner_circuit_test.zig b/zig/src/core/runner_circuit_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..5774a8db73192ffca9a5de61954dae50c0d5975f
--- /dev/null
+++ b/zig/src/core/runner_circuit_test.zig
@@ -0,0 +1,183 @@
+//! T2 host tests: the circuit container, the exact evaluator and RAM op, the machine and the CPU backend.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const model = @import("runner_circuit_model.zig");
+const load = @import("runner_circuit_load.zig");
+const eval = @import("runner_circuit_eval.zig");
+const rc = @import("runner_circuit.zig");
+const tiny = @import("runner_circuit_tiny_test.zig");
+
+const gpa = std.testing.allocator;
+const tok = tiny.token;
+const long_input: [256]u8 = @splat('9');
+
+test {
+    _ = model;
+    _ = @import("runner_circuit_golden_test.zig");
+    _ = @import("runner_circuit_backend.zig");
+}
+
+fn tinyCircuit(variant: tiny.Variant) !model.Circuit {
+    const bytes = try tiny.build(gpa, variant);
+    defer gpa.free(bytes);
+    return load.fromBytes(gpa, bytes);
+}
+
+test "the container refuses a bad magic, version, flag, length or checksum" {
+    const good = try tiny.build(gpa, .good);
+    defer gpa.free(good);
+    var c = try load.fromBytes(gpa, good);
+    c.deinit(gpa);
+    const Case = struct { at: usize, want: anyerror };
+    for ([_]Case{ .{ .at = 0, .want = error.CircuitMagic }, .{ .at = 8, .want = error.CircuitVersion }, .{ .at = 24, .want = error.CircuitFlags }, .{ .at = 16, .want = error.CircuitTruncated }, .{ .at = 40, .want = error.CircuitChecksum }, .{ .at = 100, .want = error.CircuitChecksum } }) |case| {
+        const bad = try gpa.dupe(u8, good);
+        defer gpa.free(bad);
+        bad[case.at] ^= 1;
+        try std.testing.expectError(case.want, load.fromBytes(gpa, bad));
+    }
+    try std.testing.expectError(error.CircuitTruncated, load.fromBytes(gpa, good[0 .. good.len - 1]));
+    try std.testing.expectError(error.CircuitTruncated, load.fromBytes(gpa, good[0..63]));
+}
+
+/// S + k (v - S^T k)^T for a 0/1 key, computed densely in binary64.
+fn deltaRule(before: []const model.Scalar, key: []const f64, v: []const f64, after: []f64) void {
+    const n = model.hd;
+    for (0..n) |c| {
+        var sk: f64 = 0;
+        for (0..n) |j| sk += before[j * n + c] * key[j];
+        for (0..n) |i| after[i * n + c] = before[i * n + c] + key[i] * (v[c] - sk);
+    }
+}
+
+test "a one-hot write is the gated delta rule at beta 1, and reads return the row through the ballast norm" {
+    var c = try tinyCircuit(.good);
+    defer c.deinit(gpa);
+    var s = try rc.State.init(gpa, &c);
+    defer s.deinit();
+    const ram = c.program.ram_tables[0];
+    const before = try gpa.dupe(model.Scalar, s.tables[ram]);
+    defer gpa.free(before);
+    _ = try eval.step(&s, tok(2, 1 | 4));
+    var key: [model.hd]f64 = @splat(0);
+    key[1] = 1;
+    var v: [model.hd]f64 = @splat(0);
+    v[0] = 1 << 24;
+    v[1] = 1 << 24;
+    v[2] = 128;
+    const want = try gpa.alloc(f64, model.hd * model.hd);
+    defer gpa.free(want);
+    deltaRule(before, &key, &v, want);
+    for (want, s.tables[ram]) |a, b| try std.testing.expectEqual(a, @as(f64, b));
+    try std.testing.expect(s.rowPresent(ram, 1));
+    const Read = struct { row: u32, bit: u32 };
+    for ([_]Read{ .{ .row = 1, .bit = 1 }, .{ .row = 2, .bit = 0 }, .{ .row = 3, .bit = 1 } }) |r| {
+        try std.testing.expectEqual(tok(4, '0' + r.bit), try eval.step(&s, tok(3, r.row)));
+        try std.testing.expectEqual(@as(model.Scalar, @floatFromInt(r.bit)), s.x[tiny.dims.rd]);
+    }
+    _ = try eval.step(&s, tok(2, 3));
+    try std.testing.expectEqual(tok(4, '0'), try eval.step(&s, tok(3, 3)));
+    try std.testing.expect(s.rowPresent(ram, 3));
+}
+
+test "a key with two positive rows is refused, and an unmapped output code fails instead of guessing" {
+    var two = try tinyCircuit(.two_hot_key);
+    defer two.deinit(gpa);
+    var s = try rc.State.init(gpa, &two);
+    defer s.deinit();
+    try std.testing.expectError(error.CircuitKeyNotOneHot, eval.step(&s, tok(2, 1)));
+    var unmapped = try tinyCircuit(.unmapped_go);
+    defer unmapped.deinit(gpa);
+    var u = try rc.State.init(gpa, &unmapped);
+    defer u.deinit();
+    try std.testing.expectError(error.CircuitOutputCode, eval.step(&u, unmapped.go));
+    try std.testing.expectEqual(tok(1, 0), try eval.step(&u, tok(1, 0)));
+}
+
+test "a lag-1 tap keys on the previous token, a clear decay empties the table, history is per channel" {
+    var c = try tinyCircuit(.good);
+    defer c.deinit(gpa);
+    var s = try rc.State.init(gpa, &c);
+    defer s.deinit();
+    const Step = struct { t: u32, lag: model.Scalar };
+    const seq = [_]Step{ .{ .t = tok(1, 0), .lag = 0 }, .{ .t = tok(2, 0), .lag = 0 }, .{ .t = tok(1, 0), .lag = 1 }, .{ .t = tok(1, 0), .lag = 1 }, .{ .t = tok(4, 'h'), .lag = 0 }, .{ .t = tok(1, 0), .lag = 0 } };
+    for (seq) |st| {
+        _ = try eval.step(&s, st.t);
+        try std.testing.expectEqual(st.lag, s.x[tiny.dims.lagout]);
+    }
+    try std.testing.expectEqual(@as(u128, 0), s.present[0]);
+}
+
+test "a node that reads a dim written earlier in stored order sees the write" {
+    var c = try tinyCircuit(.good);
+    defer c.deinit(gpa);
+    try std.testing.expectEqual(@as(usize, 3), c.batches.len);
+    var s = try rc.State.init(gpa, &c);
+    defer s.deinit();
+    _ = try eval.step(&s, tok(1, 0));
+    try std.testing.expectEqual(@as(model.Scalar, 1), s.x[tiny.dims.t1]);
+    try std.testing.expectEqual(@as(model.Scalar, 1), s.x[tiny.dims.t2]);
+}
+
+test "a machine boots the calc input as RAM data and runs to HALT under a step budget and a cancel flag" {
+    var c = try tinyCircuit(.good);
+    defer c.deinit(gpa);
+    var m = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "A" });
+    defer m.deinit(gpa);
+    try std.testing.expectEqual(@as(u32, 'A'), try rc.readWord(&m.state, 64));
+    var out: std.ArrayList(u8) = .empty;
+    defer out.deinit(gpa);
+    var trace: std.ArrayList(u32) = .empty;
+    defer trace.deinit(gpa);
+    var cancel: std.atomic.Value(bool) = .init(false);
+    const first = try m.run(2, &out, &trace, &cancel);
+    try std.testing.expectEqual(api.RunEnd{ .end = .budget, .steps = 2 }, first);
+    const rest = try m.run(100, &out, &trace, &cancel);
+    try std.testing.expectEqual(api.RunEnd{ .end = .halted, .steps = 1 }, rest);
+    try std.testing.expectEqualStrings("hi", out.items);
+    try std.testing.expectEqualSlices(u32, &.{ tok(4, 'h'), tok(4, 'i'), c.halt }, trace.items);
+    try std.testing.expectEqual(api.RunEnd{ .end = .halted, .steps = 0 }, try m.run(100, &out, null, &cancel));
+    var n = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "" });
+    defer n.deinit(gpa);
+    cancel.store(true, .release);
+    try std.testing.expectEqual(api.RunEnd{ .end = .cancelled, .steps = 0 }, try n.run(100, &out, null, &cancel));
+    try std.testing.expectError(error.CircuitInputTooLong, rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = &long_input }));
+    try std.testing.expectError(error.CircuitInputNul, rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "1\x002" }));
+}
+
+test "the RAM patch round-trips words and an R read sees the booted input" {
+    var c = try tinyCircuit(.good);
+    defer c.deinit(gpa);
+    var m = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "AB" });
+    defer m.deinit(gpa);
+    try std.testing.expectEqual(@as(u32, 'A' | 'B' << 8), try rc.readWord(&m.state, 64));
+    try std.testing.expectEqual(tok(4, '1'), try eval.step(&m.state, tok(3, 2)));
+    var e = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "" });
+    defer e.deinit(gpa);
+    try std.testing.expect(!e.state.rowPresent(c.program.ram_tables[0], 2));
+    try std.testing.expectEqual(tok(4, '0'), try eval.step(&e.state, tok(3, 2)));
+}
+
+test "snapshots are canonical: equal histories give equal bytes, a write or a lag changes them" {
+    var c = try tinyCircuit(.good);
+    defer c.deinit(gpa);
+    var a = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "" });
+    defer a.deinit(gpa);
+    var b = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = "" });
+    defer b.deinit(gpa);
+    for ([_]u32{ tok(1, 0), tok(2, 5) }) |t| {
+        _ = try eval.step(&a.state, t);
+        _ = try eval.step(&b.state, t);
+    }
+    const sa = try a.snapshot(gpa);
+    defer gpa.free(sa);
+    const sb = try b.snapshot(gpa);
+    defer gpa.free(sb);
+    try std.testing.expectEqualSlices(u8, sa, sb);
+    _ = try eval.step(&b.state, tok(1, 0));
+    _ = try eval.step(&a.state, tok(4, 'h'));
+    const sa2 = try a.snapshot(gpa);
+    defer gpa.free(sa2);
+    const sb2 = try b.snapshot(gpa);
+    defer gpa.free(sb2);
+    try std.testing.expect(!std.mem.eql(u8, sa2, sb2));
+}
diff --git a/zig/src/core/runner_circuit_tiny_test.zig b/zig/src/core/runner_circuit_tiny_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..92f8c6e45c675f7ff5face3464bb6d9579bf0e16
--- /dev/null
+++ b/zig/src/core/runner_circuit_tiny_test.zig
@@ -0,0 +1,159 @@
+//! A hand-built circuit file (store/load RAM, a lagged key, a clear decay, a hazard pair) for evaluator host tests.
+const std = @import("std");
+
+const kappa = "0.00000095367431640625";
+pub const a_ref = "16777216.0";
+/// Families: 0 GO, 1 A, 2 W (row bits 0-1, data bit 2), 3 R (row bits 0-1), 4 BYTE, 5 HALT.
+pub const sizes = [_]u32{ 1, 1, 8, 4, 512, 1 };
+pub const dims = struct {
+    pub const is_w = 3;
+    pub const is_r = 4;
+    pub const rd = 13;
+    pub const code = 14;
+    pub const t1 = 33;
+    pub const t2 = 34;
+    pub const lagout = 35;
+    pub const count = 36;
+};
+pub const family_bits = 3;
+
+pub fn token(family: u32, payload: u32) u32 {
+    var base: u32 = 0;
+    for (sizes[0..family]) |s| base += s;
+    return base + payload;
+}
+
+/// Variants that break one rule, for negative controls.
+pub const Variant = enum { good, two_hot_key, unmapped_go };
+
+/// The container bytes of the tiny circuit.
+pub fn build(a: std.mem.Allocator, variant: Variant) ![]u8 {
+    var j: std.ArrayList(u8) = .empty;
+    defer j.deinit(a);
+    const w = Writer{ .a = a, .j = &j };
+    try w.s("{\"constants\":{\"a_bit\":128.0,\"a_ref\":" ++ a_ref ++ ",\"head_dim\":128,\"one_dim\":0,\"ref_cols\":[0,1]},\"dims\":[");
+    for (0..dims.count) |i| try w.f("{s}{{\"name\":\"d{d}\"}}", .{ if (i == 0) "" else ",", i });
+    try w.s("],\"features\":[");
+    for (0..6) |f| try w.f("{s}{{\"dim\":{d},\"kind\":\"family\",\"family\":{d}}}", .{ if (f == 0) "" else ",", f + 1, f });
+    const bits = [_][3]u32{ .{ 7, 2, 0 }, .{ 8, 2, 1 }, .{ 9, 2, 2 }, .{ 10, 3, 0 }, .{ 11, 3, 1 }, .{ 12, 4, 0 } };
+    for (bits) |b| try w.f(",{{\"dim\":{d},\"kind\":\"payload_bit\",\"family\":{d},\"bit\":{d}}}", .{ b[0], b[1], b[2] });
+    try w.s("],\"format\":\"tensorfold.runner.p2\",\"nodes\":[");
+    try lagHead(w);
+    try w.s(",");
+    try ramHead(w, variant);
+    try w.s(",{\"kind\":\"ffn\",\"name\":\"h1\",\"out\":33,\"into\":false,\"terms\":[[1.0,[[0,1.0]],[[2,1.0]]]]}");
+    try w.s(",{\"kind\":\"ffn\",\"name\":\"h2\",\"out\":34,\"into\":false,\"terms\":[[1.0,[[33,1.0]],[[0,1.0]]]]}");
+    try codeNodes(w, variant);
+    try w.s("],\"output\":{\"code_dims\":[");
+    for (0..family_bits + 16) |i| try w.f("{s}{d}", .{ if (i == 0) "" else ",", dims.code + i });
+    try w.f("],\"family_bits\":{d},\"families\":", .{family_bits});
+    try families(w);
+    try w.s(",\"payload_bits\":16},\"program\":{\"input_address\":256,\"input_capacity\":256,\"kind\":\"calc\"},");
+    try w.f("\"stats\":{{\"dims\":{d}}},\"tokens\":{{\"byte_family\":4,\"families\":", .{dims.count});
+    try families(w);
+    try w.f(",\"go\":0,\"halt\":{d},\"vocab\":{d}}},\"version\":1}}", .{ token(5, 0), token(5, 0) + 1 });
+    return container(a, j.items);
+}
+
+pub fn container(a: std.mem.Allocator, body: []const u8) ![]u8 {
+    const out = try a.alloc(u8, 64 + body.len);
+    @memcpy(out[0..8], "TFIMR001");
+    std.mem.writeInt(u32, out[8..12], 1, .little);
+    std.mem.writeInt(u32, out[12..16], 64, .little);
+    std.mem.writeInt(u64, out[16..24], body.len, .little);
+    @memset(out[24..32], 0);
+    std.crypto.hash.sha2.Sha256.hash(body, out[32..64], .{});
+    @memcpy(out[64..], body);
+    return out;
+}
+
+const Writer = struct {
+    a: std.mem.Allocator,
+    j: *std.ArrayList(u8),
+    fn s(w: Writer, text: []const u8) !void {
+        try w.j.appendSlice(w.a, text);
+    }
+    fn f(w: Writer, comptime fmt: []const u8, args: anytype) !void {
+        const text = try std.fmt.allocPrint(w.a, fmt, args);
+        defer w.a.free(text);
+        try w.j.appendSlice(w.a, text);
+    }
+};
+
+fn families(w: Writer) !void {
+    const names = [_][]const u8{ "GO", "A", "W", "R", "BYTE", "HALT" };
+    try w.s("[");
+    for (names, sizes, 0..) |n, size, i| try w.f("{s}{{\"name\":\"{s}\",\"base\":{d},\"size\":{d}}}", .{ if (i == 0) "" else ",", n, token(@intCast(i), 0), size });
+    try w.s("]");
+}
+
+/// One-hot row select: relu(flag + sum of literals - bits) over the payload bits of a family.
+fn selectChannel(w: Writer, row: u32, flag: u32, bit_dims: [2]u32) !void {
+    var flag_coef: i32 = 1;
+    for (0..2) |b| flag_coef += @intFromBool(row >> @intCast(b) & 1 == 0);
+    try w.f("[{d},{{\"expr\":[[{d},{d}.0]", .{ row, flag, flag_coef });
+    for (bit_dims, 0..) |d, b| try w.f(",[{d},{s}1.0]", .{ d, if (row >> @intCast(b) & 1 == 1) "" else "-" });
+    try w.s(",[0,-2.0]],\"taps\":[1.0,0.0,0.0,0.0]}]");
+}
+
+/// A key from the previous token being W (a lag-1 tap), a read on A, a clear on BYTE; output to lagout.
+fn lagHead(w: Writer) !void {
+    try w.s("{\"kind\":\"head\",\"name\":\"lag\",\"n_cols\":128,\"levels\":\"bit\",\"tiny\":0.0,");
+    try w.s("\"q\":[[0,{\"expr\":[[2,1.0]],\"taps\":[1.0,0.0,0.0,0.0]}]],\"k\":[[0,{\"expr\":[[3,1.0]],\"taps\":[0.0,1.0,0.0,0.0]}]],");
+    try w.s("\"value_heads\":[{\"v\":[[0,{\"expr\":[[0," ++ a_ref ++ "]],\"taps\":[1.0,0.0,0.0,0.0]}],[1,{\"expr\":[[0," ++ a_ref ++ "]],\"taps\":[1.0,0.0,0.0,0.0]}],");
+    try w.s("[2,{\"expr\":[[0,128.0]],\"taps\":[1.0,0.0,0.0,0.0]}]],\"a\":[[5,238.0]],\"beta\":null,\"z\":[[2,[[0,1.0]]]],");
+    try w.s("\"out\":[[2,35,16384.0]],\"into\":false,\"init\":[]}]}");
+}
+
+/// ram0: W writes row (payload bits 0-1) with data bit 2 in column 2; R reads its row into rd. Row 3 starts at 1.
+fn ramHead(w: Writer, variant: Variant) !void {
+    try w.s("{\"kind\":\"head\",\"name\":\"ram0\",\"n_cols\":128,\"levels\":\"bit\",\"tiny\":0.0,\"q\":[");
+    for (0..4) |r| {
+        if (r > 0) try w.s(",");
+        try selectChannel(w, @intCast(r), dims.is_r, .{ 10, 11 });
+    }
+    try w.s("],\"k\":[");
+    for (0..4) |r| {
+        if (r > 0) try w.s(",");
+        try selectChannel(w, @intCast(r), dims.is_w, .{ 7, 8 });
+    }
+    if (variant == .two_hot_key) try w.s(",[9,{\"expr\":[[3,1.0]],\"taps\":[1.0,0.0,0.0,0.0]}]");
+    const v = "\"v\":[[0,{\"expr\":[[3," ++ a_ref ++ "]],\"taps\":[1.0,0.0,0.0,0.0]}],[1,{\"expr\":[[3," ++ a_ref ++
+        "]],\"taps\":[1.0,0.0,0.0,0.0]}],[2,{\"expr\":[[9,128.0]],\"taps\":[1.0,0.0,0.0,0.0]}]],\"a\":[],\"beta\":null,";
+    try w.s("],\"value_heads\":[{" ++ v ++ "\"z\":[[2,[[4,1.0]]]],\"out\":[[2,13,16384.0]],\"into\":false,");
+    try w.s("\"init\":[[3,[[0," ++ a_ref ++ "],[1," ++ a_ref ++ "],[2,128.0]]]]},{" ++ v ++ "\"z\":[],\"out\":[],\"into\":false,\"init\":[]}]}");
+}
+
+/// One FFN per code dim: GO->BYTE('h'), BYTE even->+1, BYTE odd->HALT, A->A, W->A, R->BYTE('0'+rd), HALT->HALT.
+fn codeNodes(w: Writer, variant: Variant) !void {
+    const Rule = struct { up: []const u8, target: u32 };
+    const rules = [_]Rule{
+        .{ .up = "[[1,1.0]]", .target = token(4, 'h') },
+        .{ .up = "[[2,1.0]]", .target = token(1, 0) },
+        .{ .up = "[[3,1.0]]", .target = token(1, 0) },
+        .{ .up = "[[4,1.0]]", .target = token(4, '0') },
+        .{ .up = "[[5,1.0],[12,-1.0]]", .target = token(4, 'i') },
+        .{ .up = "[[12,1.0]]", .target = token(5, 0) },
+        .{ .up = "[[6,1.0]]", .target = token(5, 0) },
+    };
+    for (0..family_bits + 16) |i| {
+        try w.f(",{{\"kind\":\"ffn\",\"name\":\"code{d}\",\"out\":{d},\"into\":false,\"terms\":[", .{ i, dims.code + i });
+        for (rules, 0..) |r, n| {
+            if (variant == .unmapped_go and n == 0) continue;
+            const code = codeOf(r.target);
+            const sign: []const u8 = if (code >> @intCast(i) & 1 == 1) "" else "-";
+            try w.f("{s}[{s}" ++ kappa ++ ",{s},[[0,1.0]]]", .{ if (n == @intFromBool(variant == .unmapped_go)) "" else ",", sign, r.up });
+        }
+        if (i == family_bits) try w.s(",[0.0000019073486328125,[[13,1.0]],[[4,1.0]]]");
+        try w.s("]}");
+    }
+}
+
+fn codeOf(t: u32) u64 {
+    var base: u32 = 0;
+    for (sizes, 0..) |s, f| {
+        if (t < base + s) return @as(u64, f) | @as(u64, t - base) << family_bits;
+        base += s;
+    }
+    unreachable;
+}
