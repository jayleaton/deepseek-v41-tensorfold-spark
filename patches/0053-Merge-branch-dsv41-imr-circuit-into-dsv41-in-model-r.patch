+//! T2's R1 circuit evaluator host tests and the CPU steps/s bench.
+const std = @import("std");
+
+pub fn tests(b: *std.Build, step: *std.Build.Step) void {
+    const host = b.graph.host;
+    const module = b.createModule(.{ .root_source_file = b.path("zig/src/core/runner_circuit_test.zig"), .target = host, .optimize = .ReleaseSafe, .link_libc = true });
+    const run = b.addRunArtifact(b.addTest(.{ .root_module = module }));
+    b.step("test-runner-circuit-host", "R1 circuit loader, exact CPU evaluator, RAM op, machine and backend").dependOn(&run.step);
+    step.dependOn(&run.step);
+    const bench = b.addExecutable(.{ .name = "runner-circuit-bench", .root_module = b.createModule(.{ .root_source_file = b.path("zig/src/core/runner_circuit_bench.zig"), .target = host, .optimize = .ReleaseFast, .link_libc = true }) });
+    const run_bench = b.addRunArtifact(bench);
+    if (b.args) |args| run_bench.addArgs(args);
+    b.step("bench-runner-circuit", "CPU circuit steps/s on a circuit file: -- <circuit> <expression> [repeats]").dependOn(&run_bench.step);
+}
diff --git a/zig/src/core/runner_circuit.zig b/zig/src/core/runner_circuit.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f0691820963b99a8db1549611dab4d607321dfca
--- /dev/null
+++ b/zig/src/core/runner_circuit.zig
@@ -0,0 +1,126 @@
+//! The R1 machine: a compiled circuit booted from its snapshot plus a program, stepped one trace token at a time.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const model = @import("runner_circuit_model.zig");
+const eval = @import("runner_circuit_eval.zig");
+const state_mod = @import("runner_circuit_state.zig");
+const elf = @import("runner_circuit_elf.zig");
+
+pub const Circuit = model.Circuit;
+pub const State = state_mod.State;
+const Allocator = std.mem.Allocator;
+
+/// Monotonic nanoseconds, for exec_ns and rates only (never for results).
+pub fn nowNs() u64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
+
+/// Steps between cancel checks.
+pub const cancel_every: u64 = 4096;
+
+pub const Machine = struct {
+    state: State,
+    next: u32,
+    halted: bool = false,
+    faulted: bool = false,
+
+    /// The circuit's boot snapshot with `program` loaded as data; the computing is the weights'.
+    pub fn boot(gpa: Allocator, c: *const Circuit, program: api.Program) !Machine {
+        var s = try State.init(gpa, c);
+        errdefer s.deinit();
+        switch (program.kind) {
+            .calc => {
+                if (c.program.kind != .calc) return error.CircuitNotCalc;
+                try patchInput(&s, program.bytes);
+            },
+            .elf => try elf.load(&s, program.bytes),
+        }
+        return .{ .state = s, .next = c.go };
+    }
+
+    pub fn deinit(m: *Machine, gpa: Allocator) void {
+        _ = gpa;
+        m.state.deinit();
+        m.* = undefined;
+    }
+
+    /// Up to `budget` more steps, until HALT or `cancel`; BYTE payloads below 256 go to `out`, each token to `trace`.
+    pub fn run(m: *Machine, budget: u64, out: *std.ArrayList(u8), trace: ?*std.ArrayList(u32), cancel: *const std.atomic.Value(bool)) !api.RunEnd {
+        const c = m.state.circuit;
+        const gpa = m.state.gpa;
+        var steps: u64 = 0;
+        while (!m.halted) : (steps += 1) {
+            if (steps == budget) return .{ .end = .budget, .steps = steps };
+            if (steps % cancel_every == 0 and cancel.load(.acquire)) return .{ .end = .cancelled, .steps = steps };
+            const t = try eval.step(&m.state, m.next);
+            if (trace) |tr| try tr.append(gpa, t);
+            const fam, const pay = c.split(t).?;
+            if (fam == c.byte_family and pay < 256) try out.append(gpa, @intCast(pay));
+            if (c.fault_family) |f| m.faulted = m.faulted or fam == f;
+            m.halted = t == c.halt;
+            m.next = t;
+        }
+        return .{ .end = if (m.faulted) .fault else .halted, .steps = steps };
+    }
+
+    /// Canonical bytes of the full state: the tables, channel histories and step count, then the next input token.
+    pub fn snapshot(m: *const Machine, gpa: Allocator) ![]u8 {
+        const body = try m.state.canonical(gpa);
+        defer gpa.free(body);
+        const out = try gpa.alloc(u8, body.len + 4);
+        @memcpy(out[0..body.len], body);
+        std.mem.writeInt(u32, out[body.len..][0..4], m.next, .little);
+        return out;
+    }
+};
+
+/// Writes the calc expression and its NUL at the firmware's input address, as calc.machine patches RAM.
+pub fn patchInput(s: *State, text: []const u8) !void {
+    const p = s.circuit.program;
+    if (std.mem.indexOfScalar(u8, text, 0) != null) return error.CircuitInputNul;
+    if (text.len + 1 > p.input_capacity) return error.CircuitInputTooLong;
+    for (0..text.len + 1) |i| {
+        const addr = p.input_address + @as(u32, @intCast(i));
+        const byte: u32 = if (i < text.len) text[i] else 0;
+        const shift: u5 = @intCast(8 * (addr & 3));
+        const word = try readWord(s, addr >> 2);
+        try writeWord(s, addr >> 2, word & ~(@as(u32, 0xff) << shift) | byte << shift);
+    }
+}
+
+const RamRow = struct { table: u32, row: u32 };
+
+/// RAM word wi lives in head ram<h>, h = (wi & 15) | (wi >> 12) << 4, value head (wi >> 4) & 1, row (wi >> 5) & 127.
+fn ramRow(s: *const State, wi: u32) !RamRow {
+    if (wi >= 1 << 13) return error.CircuitRamAddress;
+    const base = s.circuit.program.ram_tables[(wi & 15) | (wi >> 12) << 4];
+    if (base == std.math.maxInt(u32)) return error.CircuitRamTables;
+    return .{ .table = base + (wi >> 4 & 1), .row = wi >> 5 & 127 };
+}
+
+pub fn readWord(s: *State, wi: u32) !u32 {
+    const at = try ramRow(s, wi);
+    if (!s.rowPresent(at.table, at.row)) return 0;
+    const r = s.row(at.table, at.row);
+    var word: u32 = 0;
+    for (0..32) |i| {
+        const v = r[2 + i];
+        if (v == s.circuit.program.a_bit) word |= @as(u32, 1) << @intCast(i) else if (v != 0) return error.CircuitRamRow;
+    }
+    return word;
+}
+
+/// A nonzero word carries the ballast in columns 0 and 1 and A_BIT per set bit in columns 2..33; zero is absent.
+pub fn writeWord(s: *State, wi: u32, word: u32) !void {
+    const at = try ramRow(s, wi);
+    if (word == 0) return s.clearRow(at.table, at.row);
+    var r: [model.hd]model.Scalar = @splat(0);
+    r[0] = s.circuit.program.a_ref;
+    r[1] = s.circuit.program.a_ref;
+    for (0..32) |i| if (word >> @intCast(i) & 1 == 1) {
+        r[2 + i] = s.circuit.program.a_bit;
+    };
+    try s.writeRow(at.table, at.row, &r);
+}
diff --git a/zig/src/core/runner_circuit_backend.zig b/zig/src/core/runner_circuit_backend.zig
new file mode 100644
index 0000000000000000000000000000000000000000..06de1dbb1a2416a9d7a7e9953f598e7c2c97c37a
--- /dev/null
+++ b/zig/src/core/runner_circuit_backend.zig
@@ -0,0 +1,230 @@
+//! The CPU Backend: each job boots a fresh machine on its own worker thread; the engine thread never waits on a run.
+const std = @import("std");
+const api = @import("runner_api.zig");
+const rc = @import("runner_circuit.zig");
+
+const Allocator = std.mem.Allocator;
+const log = std.log.scoped(.runner_circuit);
+const too_long: [300]u8 = @splat('9');
+
+const Job = struct {
+    id: api.JobId,
+    stream: u64,
+    program: []u8,
+    kind: @FieldType(api.Program, "kind"),
+    budget: u64,
+    thread: ?std.Thread = null,
+    done: std.atomic.Value(bool) = .init(false),
+    cancel: std.atomic.Value(bool) = .init(false),
+    result: api.Result = .{ .status = .abstain, .abstain = .unsupported },
+    out: std.ArrayList(u8) = .empty,
+};
+
+const Cpu = struct {
+    gpa: Allocator,
+    circuit: *const rc.Circuit,
+    workers: u8,
+    next_id: api.JobId = 1,
+    jobs: std.ArrayList(*Job) = .empty,
+    dropped: std.ArrayList(*Job) = .empty,
+    delivered: std.ArrayList(*Job) = .empty,
+
+    fn live(c: *Cpu) usize {
+        return c.jobs.items.len + c.dropped.items.len;
+    }
+
+    fn free(c: *Cpu, j: *Job) void {
+        if (j.thread) |t| t.join();
+        j.out.deinit(c.gpa);
+        c.gpa.free(j.program);
+        c.gpa.destroy(j);
+    }
+
+    /// Joins and frees cancelled jobs whose worker has stopped.
+    fn reap(c: *Cpu) void {
+        var i: usize = 0;
+        while (i < c.dropped.items.len) {
+            const j = c.dropped.items[i];
+            if (!j.done.load(.acquire)) {
+                i += 1;
+                continue;
+            }
+            _ = c.dropped.swapRemove(i);
+            c.free(j);
+        }
+    }
+
+    /// `out` of a stream's previous result stays valid only until the next call for that stream.
+    fn forget(c: *Cpu, stream: u64) void {
+        var i: usize = 0;
+        while (i < c.delivered.items.len) {
+            if (c.delivered.items[i].stream != stream) {
+                i += 1;
+                continue;
+            }
+            c.free(c.delivered.swapRemove(i));
+        }
+    }
+
+    fn find(c: *Cpu, id: api.JobId) ?usize {
+        for (c.jobs.items, 0..) |j, i| if (j.id == id) return i;
+        return null;
+    }
+
+    fn drop(c: *Cpu, i: usize) void {
+        const j = c.jobs.swapRemove(i);
+        j.cancel.store(true, .release);
+        c.dropped.append(c.gpa, j) catch {
+            if (j.thread) |t| t.join();
+            c.free(j);
+        };
+    }
+};
+
+fn work(c: *Cpu, j: *Job) void {
+    defer j.done.store(true, .release);
+    const t0 = rc.nowNs();
+    var m = rc.Machine.boot(c.gpa, c.circuit, .{ .kind = j.kind, .bytes = j.program }) catch |e| {
+        j.result = .{ .status = .abstain, .abstain = switch (e) {
+            error.CircuitInputTooLong => .too_long,
+            error.CircuitInputNul => .syntax,
+            else => .unsupported,
+        } };
+        if (e != error.CircuitInputTooLong) log.warn("circuit boot refused: {s}", .{@errorName(e)});
+        return;
+    };
+    defer m.deinit(c.gpa);
+    const end = m.run(j.budget, &j.out, null, &j.cancel) catch |e| {
+        log.warn("circuit run failed after {d} steps: {s}", .{ m.state.steps, @errorName(e) });
+        j.result = .{ .status = .abstain, .abstain = .unsupported, .steps = m.state.steps };
+        return;
+    };
+    j.result = .{
+        .status = switch (end.end) {
+            .halted => .ok,
+            .budget => .budget,
+            .fault => .fault,
+            .cancelled => .abstain,
+        },
+        .steps = end.steps,
+        .exec_ns = rc.nowNs() - t0,
+        .abstain = if (end.end == .cancelled) .unsupported else null,
+    };
+}
+
+fn start(ctx: *anyopaque, stream: u64, program: api.Program, budget: u64) error{ OutOfMemory, Busy }!api.JobId {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    c.reap();
+    c.forget(stream);
+    if (c.live() >= c.workers) return error.Busy;
+    const j = try c.gpa.create(Job);
+    errdefer c.gpa.destroy(j);
+    const bytes = try c.gpa.dupe(u8, program.bytes);
+    errdefer c.gpa.free(bytes);
+    j.* = .{ .id = c.next_id, .stream = stream, .program = bytes, .kind = program.kind, .budget = budget };
+    try c.jobs.ensureUnusedCapacity(c.gpa, 1);
+    j.thread = std.Thread.spawn(.{}, work, .{ c, j }) catch return error.Busy;
+    c.jobs.appendAssumeCapacity(j);
+    c.next_id += 1;
+    return j.id;
+}
+
+fn poll(ctx: *anyopaque, id: api.JobId) api.Poll {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    c.reap();
+    const i = c.find(id) orelse return .{ .done = .{ .status = .abstain, .abstain = .unsupported } };
+    const j = c.jobs.items[i];
+    if (!j.done.load(.acquire)) return .running;
+    _ = c.jobs.swapRemove(i);
+    if (j.thread) |t| t.join();
+    j.thread = null;
+    c.forget(j.stream);
+    c.delivered.append(c.gpa, j) catch {
+        c.free(j);
+        return .{ .done = .{ .status = .abstain, .abstain = .unsupported } };
+    };
+    var r = j.result;
+    r.out = j.out.items;
+    return .{ .done = r };
+}
+
+fn cancel(ctx: *anyopaque, id: api.JobId) void {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    if (c.find(id)) |i| c.drop(i);
+    c.reap();
+}
+
+fn release(ctx: *anyopaque, stream: u64) void {
+    const c: *Cpu = @ptrCast(@alignCast(ctx));
+    var i: usize = 0;
+    while (i < c.jobs.items.len) {
+        if (c.jobs.items[i].stream == stream) c.drop(i) else i += 1;
+    }
+    c.forget(stream);
+    c.reap();
+}
+
+const vtable: api.Backend.VTable = .{ .start = start, .poll = poll, .cancel = cancel, .release = release };
+
+/// A CPU backend running at most `workers` machines at once over a circuit the caller keeps alive.
+pub fn backend(gpa: Allocator, circuit: *const rc.Circuit, workers: u8) !api.Backend {
+    if (workers == 0) return error.NoWorkers;
+    const c = try gpa.create(Cpu);
+    c.* = .{ .gpa = gpa, .circuit = circuit, .workers = workers };
+    return .{ .ctx = c, .vtable = &vtable };
+}
+
+/// Cancels every job, waits for the workers and frees the backend.
+pub fn destroy(b: api.Backend) void {
+    const c: *Cpu = @ptrCast(@alignCast(b.ctx));
+    for (c.jobs.items) |j| j.cancel.store(true, .release);
+    for ([_]*std.ArrayList(*Job){ &c.jobs, &c.dropped, &c.delivered }) |list| {
+        for (list.items) |j| c.free(j);
+        list.deinit(c.gpa);
+    }
+    c.gpa.destroy(c);
+}
+
+test "the backend runs jobs off the caller's thread, reports Busy at its worker limit and frees on release" {
+    const tiny = @import("runner_circuit_tiny_test.zig");
+    const gpa = std.testing.allocator;
+    const bytes = try tiny.build(gpa, .good);
+    defer gpa.free(bytes);
+    var circuit = try @import("runner_circuit_load.zig").fromBytes(gpa, bytes);
+    defer circuit.deinit(gpa);
+    const b = try backend(gpa, &circuit, 1);
+    defer destroy(b);
+    const id = try b.start(7, .{ .kind = .calc, .bytes = "1+1" }, 100);
+    try std.testing.expectError(error.Busy, b.start(8, .{ .kind = .calc, .bytes = "2" }, 100));
+    var result: api.Result = undefined;
+    while (true) switch (b.poll(id)) {
+        .running => std.Thread.yield() catch {},
+        .done => |r| {
+            result = r;
+            break;
+        },
+    };
+    try std.testing.expectEqual(api.Status.ok, result.status);
+    try std.testing.expectEqualStrings("hi", result.out);
+    try std.testing.expectEqual(@as(u64, 3), result.steps);
+    const capped = try b.start(8, .{ .kind = .calc, .bytes = "" }, 1);
+    while (true) switch (b.poll(capped)) {
+        .running => std.Thread.yield() catch {},
+        .done => |r| {
+            try std.testing.expectEqual(api.Status.budget, r.status);
+            try std.testing.expectEqualStrings("h", r.out);
+            break;
+        },
+    };
+    const long = try b.start(9, .{ .kind = .calc, .bytes = &too_long }, 100);
+    while (true) switch (b.poll(long)) {
+        .running => std.Thread.yield() catch {},
+        .done => |r| {
+            try std.testing.expectEqual(api.Abstain.too_long, r.abstain.?);
+            break;
+        },
+    };
+    b.release(7);
+    b.release(8);
+    b.release(9);
+}
diff --git a/zig/src/core/runner_circuit_bench.zig b/zig/src/core/runner_circuit_bench.zig
new file mode 100644
index 0000000000000000000000000000000000000000..b730a3eba28a40d4549dbdce793b4ec5e243f368
--- /dev/null
+++ b/zig/src/core/runner_circuit_bench.zig
@@ -0,0 +1,30 @@
+//! CPU steps/s of the circuit evaluator: boots a calc expression and runs it to HALT, repeated.
+const std = @import("std");
+const rc = @import("runner_circuit.zig");
+
+pub fn main(init: std.process.Init) !u8 {
+    const gpa = init.gpa;
+    const argv = try init.minimal.args.toSlice(init.arena.allocator());
+    if (argv.len < 3) {
+        std.debug.print("usage: runner-circuit-bench <circuit> <expression> [repeats]\n", .{});
+        return 2;
+    }
+    const repeats = if (argv.len > 3) try std.fmt.parseInt(u32, argv[3], 10) else 3;
+    const t_load = rc.nowNs();
+    var c = try rc.Circuit.load(gpa, argv[1]);
+    defer c.deinit(gpa);
+    std.debug.print("loaded {d} dims, {d} nodes, {d} batches, {d} tables, {d} nonzeros in {d} ms\n", .{ c.dims, c.nodes, c.batches.len, c.tables.len, c.nonzeros(), (rc.nowNs() - t_load) / std.time.ns_per_ms });
+    var cancel: std.atomic.Value(bool) = .init(false);
+    for (0..repeats) |_| {
+        const t0 = rc.nowNs();
+        var m = try rc.Machine.boot(gpa, &c, .{ .kind = .calc, .bytes = argv[2] });
+        defer m.deinit(gpa);
+        const t1 = rc.nowNs();
+        var out: std.ArrayList(u8) = .empty;
+        defer out.deinit(gpa);
+        const end = try m.run(10_000_000, &out, null, &cancel);
+        const ns = rc.nowNs() - t1;
+        std.debug.print("{s}: {d} steps, boot {d} us, run {d} ms, {d} steps/s, out {s}", .{ @tagName(end.end), end.steps, (t1 - t0) / 1000, ns / std.time.ns_per_ms, end.steps * std.time.ns_per_s / @max(ns, 1), out.items });
+    }
+    return 0;
+}
