From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Sun, 8 Nov 2026 12:27:23 +0700
Subject: [PATCH 201/207] dsv41 runner: no inline cell for the right operand of
 a TeX or worded operator

The inline scanner takes the longest run of digits and ASCII operators before
a line's `=`. After an operator it does not read, the run starts mid-way and
the cell's value is wrong but forced into the reply. dashboard on the compute
default: `\(4 \times 49 - 11 =` got 38 (49 - 11) and `\(15314 \bmod 8563 +
1000 =` got 9563 (8563 + 1000), both in the visible answer, both right in the
model's own thinking. A TeX command or the word `times` before the run now
makes the scanner abstain, as `mod` and `%` already did; the model keeps
writing.
---
 zig/src/core/runner_inline_arith_test.zig | 10 ++++++++++
 zig/src/core/runner_scan_inline.zig       | 11 +++++++++++
 2 files changed, 21 insertions(+)

diff --git a/zig/src/core/runner_inline_arith_test.zig b/zig/src/core/runner_inline_arith_test.zig
index 7196850666fa56c7fbd299f618c6d0cb6d6685ea..ef5d985cb59955c16665e283106989df0d494e4e 100644
--- a/zig/src/core/runner_inline_arith_test.zig
+++ b/zig/src/core/runner_inline_arith_test.zig
@@ -98,6 +98,16 @@ const refused = [_][]const u8{
     "147,000+73) =",
     "((1,000+2) =",
     "1,000+2)) =",
+    // the right operand of a TeX or worded operator (dashboard e89f8d1 reason-09 and arith-27 on the compute default)
+    "- Jamal: \\(4 \\times 49 - 11 =",
+    "1. \\(221 \\bmod 4331 + 1000 =",
+    "9. \\(15314 \\bmod 8563 + 1000 =",
+    "Target floor: \\(4 \\times 3 + 6 =",
+    "\\(68 \\div 2 + 10 =",
+    "\\(0.5^2 \\times 0.06^2 =",
+    "Surface area of cube with side 2: \\(6 \\cdot 2^2 =",
+    "x \\cdot 3 + 4 =",
+    "4 times 49 - 11 =",
     // a running total the model holds
     "Add 11,529,600 +1 =",
     "Minus 2,386,000 +25 =",
diff --git a/zig/src/core/runner_scan_inline.zig b/zig/src/core/runner_scan_inline.zig
index 429015f892c802dfbf4bde5b2b0f0055c852b729..d35d19189e16570731d979b9f748d6548bce9122 100644
--- a/zig/src/core/runner_scan_inline.zig
+++ b/zig/src/core/runner_scan_inline.zig
@@ -2,6 +2,15 @@
 const std = @import("std");
 const Allocator = std.mem.Allocator;
 
+/// Whether `word` ends in a TeX command (`\times`, `\bmod`, `\cdot`) or `times`: an operator before the expression.
+fn operatorWord(word: []const u8) bool {
+    var k = word.len;
+    while (k > 0 and std.ascii.isAlphabetic(word[k - 1])) k -= 1;
+    if (k == word.len) return false;
+    if (k > 0 and word[k - 1] == '\\') return true;
+    return std.ascii.eqlIgnoreCase(word[k..], "times");
+}
+
 /// A whole arithmetic expression ending the line at `=` or `= ` (no comparison, word, gap; chain only with `chain`).
 pub fn inlineExpr(line: []const u8, arith: bool, chain: bool) ?struct { expr: []const u8, space: bool, call: bool = false } {
     var t = line;
@@ -60,6 +69,8 @@ pub fn inlineExpr(line: []const u8, arith: bool, chain: bool) ?struct { expr: []
         // the modulus of `A mod M` or `A % M` is not the whole expression (live bn-011: `3^400 mod 10^18 =`)
         if (std.mem.endsWith(u8, word, "%") or (word.len >= 3 and std.ascii.eqlIgnoreCase(word[word.len - 3 ..], "mod") and
             (word.len == 3 or !std.ascii.isAlphanumeric(word[word.len - 4])))) return null;
+        // nor is the right operand of a TeX or worded operator (dashboard: `\(4 \times 49 - 11 =` got 38, `\bmod` 9563)
+        if (operatorWord(word)) return null;
         // `1, 234 + 5 =`: the expression is the next item of a number list
         if (word.len >= 2 and word[word.len - 1] == ',' and std.ascii.isDigit(word[word.len - 2])) return null;
         // `Add 11,529,600 +1 =` adds to a running total the model holds; a lone operand (`subtract 3^67 =`) is fine
