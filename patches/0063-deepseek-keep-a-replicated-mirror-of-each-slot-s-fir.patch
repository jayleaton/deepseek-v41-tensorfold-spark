diff --git a/zig/src/families/deepseek_v41/kv/mirror.zig b/zig/src/families/deepseek_v41/kv/mirror.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e7e5917787d2914a094a8dbd12ddf001cb49523a
--- /dev/null
+++ b/zig/src/families/deepseek_v41/kv/mirror.zig
@@ -0,0 +1,88 @@
+//! TF_DSV41_KV_MIRROR: each slot's first positions of every split comp family kept whole on each rank (layout).
+
+const std = @import("std");
+const sessions = @import("sessions");
+
+pub const env = "TF_DSV41_KV_MIRROR";
+
+pub const Error = error{BadMirror};
+
+/// The knob's positions, rounded up to whole pages of every residue (page x world); unset, blank or 0: off.
+pub fn parse(text: ?[]const u8, page: u32, world: u32) Error!u64 {
+    const v = std.mem.trim(u8, text orelse return 0, " \t");
+    if (v.len == 0) return 0;
+    const n = std.fmt.parseInt(u64, v, 10) catch return error.BadMirror;
+    if (n > 1 << 40 or world == 0) return error.BadMirror;
+    const unit = @as(u64, page) * world;
+    return (n + unit - 1) / unit * unit;
+}
+
+/// The knob from the environment (positions, 0: off).
+pub fn fromEnv(page: u32, world: u32) Error!u64 {
+    const raw: []const u8 = if (std.c.getenv(env)) |v| std.mem.span(v) else return 0;
+    return parse(raw, page, world) catch |e| {
+        if (!@import("builtin").is_test) std.log.err("[tensorfold] {s}={s}: positions each slot mirrors (0: off)", .{ env, raw });
+        return e;
+    };
+}
+
+/// A family's mirror: each slot's run of `pages` pages (owner-major: an all-gather's order), then one discard page.
+pub const Geometry = struct {
+    slots: u32,
+    /// logical pages a slot mirrors (a multiple of world)
+    pages: u32,
+    world: u32,
+
+    pub fn of(positions: u64, page: u32, slots: u32, world: u32) Geometry {
+        return .{ .slots = slots, .pages = @intCast(positions / page), .world = world };
+    }
+
+    /// Pages a family's mirror tensor holds: every slot's run, then the discard page (rows past the mirror).
+    pub fn tensorPages(g: Geometry) u32 {
+        return g.slots * g.pages + 1;
+    }
+
+    pub fn discard(g: Geometry) u32 {
+        return g.slots * g.pages;
+    }
+
+    /// Slot s's mirror page of logical page p: owner p mod W's part of the run at turn p / W; past it the discard page.
+    pub fn pageOf(g: Geometry, s: u32, p: u32) u32 {
+        if (p >= g.pages) return g.discard();
+        return s * g.pages + (p % g.world) * (g.pages / g.world) + p / g.world;
+    }
+
+    /// The device table int32 [slots, pts] ("s.kv.mt"): the PT `_kv_store` writes and the attention reads through.
+    pub fn table(g: Geometry, pts: u32, out: []i32) void {
+        for (0..g.slots) |s| for (0..pts) |p| {
+            out[s * pts + p] = @intCast(g.pageOf(@intCast(s), @intCast(p)));
+        };
+    }
+
+    /// Rows a rank sends in a fill: its pages of the run, whole; owner o's land at o x this in the slot's run.
+    pub fn fillRows(g: Geometry, psh: u32) u32 {
+        return (g.pages / g.world) << @intCast(psh);
+    }
+
+    /// A fill's row list: logical pages rank, rank + W, ... of the run through the slot's split table `local`.
+    pub fn fillPhys(g: Geometry, rank: u32, psh: u32, local: []const u32, out: []u32) void {
+        const q = @as(u32, 1) << @intCast(psh);
+        for (0..g.pages / g.world) |j| {
+            const lp = local[rank + g.world * @as(u32, @intCast(j))];
+            for (0..q) |i| out[j * q + i] = (lp << @intCast(psh)) | @as(u32, @intCast(i));
+        }
+    }
+
+    /// A rank's device bytes: each split comp family's mirror tensor and the table (pts pages a slot).
+    pub fn bytes(g: Geometry, families: []const sessions.Family, page: u32, pts: u32) u64 {
+        var b: u64 = 4 * @as(u64, g.slots) * pts;
+        for (families) |f| if (f.split) {
+            b += @as(u64, g.tensorPages()) * f.pageBytes(page);
+        };
+        return b;
+    }
+};
+
+test {
+    _ = @import("mirror_test.zig");
+}
diff --git a/zig/src/families/deepseek_v41/kv/mirror_test.zig b/zig/src/families/deepseek_v41/kv/mirror_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..cf0625dc5b19b028636daf6dbf2cdaf125815bc6
--- /dev/null
+++ b/zig/src/families/deepseek_v41/kv/mirror_test.zig
@@ -0,0 +1,188 @@
+//! TF_DSV41_KV_MIRROR on a host model of W ranks: mirror rows equal split KV's gathered rows; its fill, the stores.
+
+const std = @import("std");
+const testing = std.testing;
+const mirror = @import("mirror.zig");
+const split = @import("split.zig");
+const layout = @import("layout.zig");
+const Geometry = mirror.Geometry;
+
+test "kv mirror: the knob unset, blank or 0 is off; positions round up to whole pages of every residue" {
+    try testing.expectEqual(@as(u64, 0), try mirror.parse(null, 256, 2));
+    try testing.expectEqual(@as(u64, 0), try mirror.parse(" ", 256, 2));
+    try testing.expectEqual(@as(u64, 0), try mirror.parse("0", 256, 2));
+    try testing.expectEqual(@as(u64, 512), try mirror.parse("1", 256, 2));
+    try testing.expectEqual(@as(u64, 2048), try mirror.parse(" 2048 ", 256, 2));
+    try testing.expectEqual(@as(u64, 2560), try mirror.parse("2049", 256, 2));
+    try testing.expectEqual(@as(u64, 2304), try mirror.parse("2049", 256, 3));
+    for ([_][]const u8{ "-1", "on", "1e3", "2048 rows", "0x800", "99999999999999" }) |v|
+        try testing.expectError(error.BadMirror, mirror.parse(v, 256, 2));
+}
+
+test "kv mirror: each slot's run is owner-major, every page past it the discard page; the release's bytes" {
+    const g = Geometry.of(4096, 256, 3, 2);
+    try testing.expectEqual(@as(u32, 16), g.pages);
+    try testing.expectEqual(@as(u32, 49), g.tensorPages());
+    var seen: [48]bool = @splat(false);
+    for (0..3) |s| for (0..16) |p| {
+        const m = g.pageOf(@intCast(s), @intCast(p));
+        try testing.expect(m >= s * 16 and m < (s + 1) * 16 and !seen[m]);
+        seen[m] = true;
+    };
+    try testing.expectEqual(@as(u32, 16 + 8 + 1), g.pageOf(1, 3)); // owner 1, turn 1
+    try testing.expectEqual(g.discard(), g.pageOf(2, 16));
+    var tab: [3 * 20]i32 = undefined;
+    g.table(20, &tab);
+    try testing.expectEqual(@as(i32, 48), tab[2 * 20 + 19]);
+    try testing.expectEqual(@as(i32, 32), tab[2 * 20]);
+    // the release's comp families (three ratio 2, one ratio 1): 4096 x 1,460 B a slot, plus the discard pages
+    var l = try layout.Layout.fromConfig(layout.Release{}, .{ .split = true });
+    const one = Geometry.of(4096, 256, 1, 2);
+    const want: u64 = 4 * 20 + 17 * (3 * 128 + 256) * 584;
+    try testing.expectEqual(want, one.bytes(l.families(), 256, 20));
+}
+
+/// W ranks of split storage for `slots` slots of `pts` logical pages (page rows 1 << psh), rows of seeded bytes.
+const Model = struct {
+    world: u32,
+    rank_rows: [3][]u8,
+    /// [rank][slots x pts] split tables: a rank's local page, or its discard page for the others' pages
+    tables: [3][]i32,
+    /// every slot's logical rows, [slots, pts << psh, rb]
+    rows: []u8,
+    slots: u32,
+    pts: u32,
+    psh: u5,
+    rb: u32,
+
+    fn init(a: std.mem.Allocator, rnd: std.Random, world: u32, slots: u32, pts: u32, psh: u5, rb: u32) !Model {
+        var m: Model = .{ .world = world, .rank_rows = undefined, .tables = undefined, .rows = undefined, .slots = slots, .pts = pts, .psh = psh, .rb = rb };
+        const q = @as(usize, 1) << psh;
+        m.rows = try a.alloc(u8, @as(usize, slots) * pts * q * rb);
+        rnd.bytes(m.rows);
+        const owned = @as(usize, slots) * ((pts + world - 1) / world);
+        for (0..world) |o| {
+            // local pages in a shuffled order, then the discard page (junk: the others' rows land there)
+            m.rank_rows[o] = try a.alloc(u8, (owned + 1) * q * rb);
+            rnd.bytes(m.rank_rows[o]);
+            m.tables[o] = try a.alloc(i32, @as(usize, slots) * pts);
+            const order = try a.alloc(u32, owned);
+            for (order, 0..) |*x, i| x.* = @intCast(i);
+            rnd.shuffle(u32, order);
+            var next: usize = 0;
+            for (0..slots) |s| for (0..pts) |p| {
+                const at = s * pts + p;
+                if (p % world != o) {
+                    m.tables[o][at] = @intCast(owned);
+                    continue;
+                }
+                const lp = order[next];
+                next += 1;
+                m.tables[o][at] = @intCast(lp);
+                @memcpy(m.rank_rows[o][lp * q * rb ..][0 .. q * rb], m.rows[at * q * rb ..][0 .. q * rb]);
+            };
+        }
+        return m;
+    }
+
+    fn row(m: *const Model, s: usize, t: usize) []const u8 {
+        const q = @as(usize, 1) << m.psh;
+        return m.rows[(s * m.pts * q + t) * m.rb ..][0..m.rb];
+    }
+};
+
+/// The mirror `_kv_store` leaves: every slot's logical row through the mirror table (rows past it on the discard page).
+fn stored(a: std.mem.Allocator, m: *const Model, g: Geometry) ![]u8 {
+    const q = @as(usize, 1) << m.psh;
+    const out = try a.alloc(u8, g.tensorPages() * q * m.rb);
+    @memset(out, 0);
+    for (0..m.slots) |s| for (0..m.pts * q) |t| {
+        const pg = g.pageOf(@intCast(s), @intCast(t >> m.psh));
+        if (pg == g.discard()) continue;
+        @memcpy(out[(pg * q + t % q) * m.rb ..][0..m.rb], m.row(s, t));
+    };
+    return out;
+}
+
+test "kv mirror: a restore's fill (each rank's run gathered, all-gathered) is the stores' mirror, byte for byte" {
+    var arena = std.heap.ArenaAllocator.init(testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var prng = std.Random.DefaultPrng.init(0x5151);
+    for ([_][4]u32{ .{ 2, 3, 10, 7 }, .{ 2, 2, 8, 8 }, .{ 3, 2, 7, 7 } }) |c| {
+        const world = c[0];
+        const m = try Model.init(a, prng.random(), world, c[1], c[2], @intCast(c[3]), 40);
+        const g = Geometry.of(@as(u64, 2 * world) * 256, 256, m.slots, world);
+        const want = try stored(a, &m, g);
+        var hk: split.HostKernels = .{};
+        const kern = hk.kernels();
+        const rows = g.fillRows(m.psh);
+        const run_bytes = rows * world * m.rb;
+        for (0..m.slots) |s| {
+            const recv = try a.alloc(u8, run_bytes);
+            for (0..world) |o| {
+                const local = try a.alloc(u32, g.pages);
+                for (local, 0..) |*x, p| x.* = @intCast(m.tables[o][s * m.pts + p]);
+                const phys = try a.alloc(u32, rows);
+                g.fillPhys(@intCast(o), m.psh, local, phys);
+                // the gather into send, then the all-gather: owner o's rows at o x rows
+                const send = recv[o * rows * m.rb ..][0 .. rows * m.rb];
+                try kern.vtable.gather(kern.ptr, @intFromPtr(m.rank_rows[o].ptr), m.rb, @intFromPtr(phys.ptr), rows, @intFromPtr(send.ptr), null);
+            }
+            try testing.expectEqualSlices(u8, want[s * run_bytes ..][0..run_bytes], recv);
+        }
+    }
+}
+
+test "kv mirror: every selected row read through the mirror table equals split KV's gathered row (dense and packed)" {
+    var arena = std.heap.ArenaAllocator.init(testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var prng = std.Random.DefaultPrng.init(0x7171);
+    const rnd = prng.random();
+    for ([_]u32{ 2, 3 }) |world| for ([_]bool{ false, true }) |stacked| {
+        const m = try Model.init(a, rnd, world, 4, 12, 7, 584);
+        const g = Geometry.of(@as(u64, 4 * world) * 256, 256, m.slots, world);
+        const mir = try stored(a, &m, g);
+        var mt: [4 * 12]i32 = undefined;
+        g.table(m.pts, &mt);
+        const R: u32 = 6;
+        const K: u32 = 64;
+        const n = R * K;
+        // selections inside the mirror: visible rows only (the emitter's condition), -1 padding
+        const visible = g.pages << m.psh;
+        const sel = try a.alloc(i32, n);
+        for (sel) |*x| x.* = if (rnd.uintLessThan(u32, 6) == 0) -1 else @intCast(rnd.uintLessThan(u32, visible));
+        const rslot = try a.alloc(i32, R);
+        for (rslot) |*x| x.* = if (stacked) @intCast(rnd.uintLessThan(u32, m.slots)) else 0;
+        var hk: split.HostKernels = .{};
+        const kern = hk.kernels();
+        for ([_]bool{ false, true }) |packed_| {
+            const recv = try a.alloc(u8, world * n * m.rb);
+            const tok = try a.alloc(i32, n);
+            for (0..world) |o| {
+                const send = try a.alloc(u8, n * m.rb);
+                const lens = try a.alloc(i32, world);
+                const d: split.DenseArgs = .{ .sel = @intFromPtr(sel.ptr), .rows = R, .k = K, .table = @intFromPtr(m.tables[o].ptr), .pts = if (stacked) m.pts else 0, .rslot = if (stacked) @intFromPtr(rslot.ptr) else 0, .psh = m.psh, .base = @intFromPtr(m.rank_rows[o].ptr), .row_bytes = m.rb, .world = world, .send = @intFromPtr(send.ptr), .tok = @intFromPtr(tok.ptr) };
+                if (packed_) try kern.vtable.pack.?(kern.ptr, split.PackArgs.of(d, @intCast(o), @intFromPtr(lens.ptr)), null) else try kern.vtable.dense(kern.ptr, d, null);
+                // the all-gather: rank o's shard at o x R x K rows (a packed shard's own rows first)
+                @memcpy(recv[o * n * m.rb ..][0 .. n * m.rb], send);
+            }
+            var compared: usize = 0;
+            for (0..n) |i| {
+                try testing.expectEqual(sel[i] < 0, tok[i] < 0);
+                if (sel[i] < 0) continue;
+                const t: u32 = @intCast(sel[i]);
+                const s: usize = @intCast(rslot[i / K]);
+                const q = @as(u32, 1) << m.psh;
+                // the attention's address through a page table: (pt[slot x pts + t >> psh] << psh) + (t & mask)
+                const phys = (@as(usize, @intCast(mt[s * m.pts + (t >> m.psh)])) << m.psh) + (t & (q - 1));
+                const got = recv[@as(usize, @intCast(tok[i])) * m.rb ..][0..m.rb];
+                try testing.expectEqualSlices(u8, got, mir[phys * m.rb ..][0..m.rb]);
+                try testing.expectEqualSlices(u8, m.row(s, t), got);
+                compared += 1;
+            }
+            try testing.expect(compared > n / 2);
+        }
+    };
+}
diff --git a/zig/src/families/deepseek_v41/kv_mirror_test.zig b/zig/src/families/deepseek_v41/kv_mirror_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..484430786c808b8eb2dd65f070685cc632fac403
--- /dev/null
+++ b/zig/src/families/deepseek_v41/kv_mirror_test.zig
@@ -0,0 +1,332 @@
+//! TF_DSV41_KV_MIRROR on the emitters: off unchanged; inside the mirror replicated reads, no exchange; stores always.
+
+const std = @import("std");
+const testing = std.testing;
+const block = @import("block.zig");
+const block_prefill = @import("block_prefill.zig");
+const calls = @import("block_calls.zig");
+const check = @import("calls_check.zig");
+const rowmode = @import("rowmode.zig");
+const aot_needs = @import("aot_needs.zig");
+const Config = @import("config.zig").Config;
+const kvs = @import("cuda_kv.zig");
+const env = @import("sys").env;
+
+const attn = "tf_dsv41_attn_cuda_v1.attn";
+const limit: i64 = 8192;
+const pages: i64 = @divExact(limit, block.Pool.page);
+const mirror: i64 = 2048;
+const slots: i64 = 3;
+
+fn splitPool(m: i64) block.Pool {
+    const mp: i64 = if (m > 0) slots * @divExact(m, block.Pool.page) + 1 else 0;
+    return .{ .comp_pages = @divExact(pages, 2) + 2, .ik_pages = pages + 1, .pts = pages, .split = true, .mirror = m, .mirror_pages = mp };
+}
+
+/// KV_SPLIT=0's pool at the same tensor pages (the replicated path the mirror's reads take)
+fn pagedPool() block.Pool {
+    return .{ .comp_pages = @divExact(pages, 2) + 2, .ik_pages = pages + 1, .pts = pages };
+}
+
+fn widths(a: std.mem.Allocator, cfg: *const Config) !block.Widths {
+    var w: block.Widths = .{};
+    try check.parseDense(a, &w, @embedFile("fixtures/dense-k2.txt"));
+    try check.parseExperts(a, &w, @embedFile("fixtures/expert-k2.txt"));
+    for (0..cfg.layers) |L| try w.gm.put(a, @intCast(L), .{ (1 << 4) | (1 << 6) | (1 << 8), (1 << 4) | (1 << 10) });
+    try w.dense.put(a, "dspark.main_proj", try w.k2("L40.attn.wkv"));
+    return w;
+}
+
+fn roleOf(x: calls.Arg) []const u8 {
+    return switch (x) {
+        .t, .opaque_table => |t| switch (t.role) {
+            .buf, .weight => |r| r,
+            .empty => "",
+        },
+        else => "",
+    };
+}
+
+fn argKey(a: std.mem.Allocator, out: *std.ArrayList(u8), x: calls.Arg) !void {
+    switch (x) {
+        .t, .opaque_table => |t| {
+            try out.print(a, " {s}:{t}@{d}[", .{ roleOf(x), t.dt, t.offset });
+            for (t.shape, t.stride) |n, s| try out.print(a, "{d}/{d},", .{ n, s });
+            try out.append(a, ']');
+        },
+        .list => |l| {
+            try out.appendSlice(a, " (");
+            for (l) |y| try argKey(a, out, y);
+            try out.append(a, ')');
+        },
+        .i => |v| try out.print(a, " {d}", .{v}),
+        .f => |v| try out.print(a, " {e}", .{v}),
+        .b => |v| try out.print(a, " {any}", .{v}),
+        .none => try out.appendSlice(a, " none"),
+    }
+}
+
+/// A call as compared here: name, grid, scope, streams, marks and every argument but those at `skip`.
+fn key(a: std.mem.Allocator, c: calls.Call, skip: []const usize) ![]const u8 {
+    var out: std.ArrayList(u8) = .empty;
+    try out.print(a, "{s} {any} {t} side={any} fork={any} join={any} mark={d} wait={d} dside={any} djoin={any}", .{ c.name, c.grid, c.begin, c.side, c.fork, c.join, c.mark, c.wait, c.defer_side, c.defer_join });
+    for (c.args, 0..) |x, i| {
+        if (std.mem.indexOfScalar(usize, skip, i) != null) continue;
+        try out.print(a, " {s}=", .{x.name});
+        try argKey(a, &out, x.arg);
+    }
+    return out.items;
+}
+
+fn at(c: calls.Call, name: []const u8) !usize {
+    for (c.args, 0..) |x, i| if (std.mem.eql(u8, x.name, name)) return i;
+    return error.NoArgument;
+}
+
+fn compStore(c: calls.Call) !bool {
+    if (!std.mem.eql(u8, c.name, "_kv_store")) return false;
+    return c.args[try at(c, "RATIO")].arg.i > 0;
+}
+
+fn isKx(c: calls.Call) bool {
+    return c.glue and std.mem.startsWith(u8, c.name, "glue.kx_");
+}
+
+fn compAttn(c: calls.Call) bool {
+    return std.mem.eql(u8, c.name, attn) and roleOf(c.args[1].arg).len > 0;
+}
+
+/// The mirror's store right after the pool's: the same launch into "s.kv.mc.L<src>" through "s.kv.mt".
+fn checkStore(a: std.mem.Allocator, ps: calls.Call, ms: calls.Call, p: block.Pool) !void {
+    const v = try at(ms, "V");
+    const s = try at(ms, "S");
+    const pt = try at(ms, "PT");
+    try testing.expectEqualStrings(try key(a, ps, &.{ v, s, pt }), try key(a, ms, &.{ v, s, pt }));
+    const comp = roleOf(ps.args[v].arg);
+    try testing.expect(std.mem.startsWith(u8, comp, "s.kv.comp.L"));
+    const mc = roleOf(ms.args[v].arg);
+    try testing.expect(std.mem.startsWith(u8, mc, "s.kv.mc.L"));
+    try testing.expectEqualStrings(comp["s.kv.comp.L".len..], mc["s.kv.mc.L".len..]);
+    try testing.expectEqualStrings(mc, roleOf(ms.args[s].arg));
+    const ratio = ms.args[try at(ms, "RATIO")].arg.i;
+    try testing.expectEqual(p.mirror_pages * @divExact(block.Pool.page, ratio), ms.args[v].arg.t.shape[0]);
+    try testing.expectEqual(@as(i64, 0), ms.args[v].arg.t.offset);
+    try testing.expectEqual(@as(i64, 576), ms.args[s].arg.t.offset);
+    try testing.expectEqualStrings("s.kv.ct", roleOf(ps.args[pt].arg));
+    try testing.expectEqualStrings("s.kv.mt", roleOf(ms.args[pt].arg));
+    try testing.expectEqualSlices(i64, &.{p.pts}, ms.args[pt].arg.t.shape);
+}
+
+/// `cs` without the mirror's stores, each checked against the pool store before it; their count in `stores`.
+fn withoutStores(a: std.mem.Allocator, cs: []const calls.Call, p: block.Pool, stores: *usize) ![]const calls.Call {
+    var out: std.ArrayList(calls.Call) = .empty;
+    var i: usize = 0;
+    while (i < cs.len) : (i += 1) {
+        try out.append(a, cs[i]);
+        if (!try compStore(cs[i])) continue;
+        try testing.expect(i + 1 < cs.len);
+        try checkStore(a, cs[i], cs[i + 1], p);
+        stores.* += 1;
+        i += 1;
+    }
+    return out.items;
+}
+
+/// A compressed layer's attention inside the mirror: KV_SPLIT=0's read (the selection, paged) of the mirror's rows.
+fn checkRead(a: std.mem.Allocator, off: calls.Call, on: calls.Call, paged: calls.Call, p: block.Pool) !void {
+    try testing.expectEqualStrings("w.kx.recv", roleOf(off.args[1].arg));
+    try testing.expectEqualStrings(try key(a, off, &.{ 1, 2, 3, 11, 20 }), try key(a, on, &.{ 1, 2, 3, 11, 20 }));
+    try testing.expectEqualStrings(try key(a, paged, &.{ 1, 2, 11 }), try key(a, on, &.{ 1, 2, 11 }));
+    const comp = roleOf(paged.args[1].arg);
+    const mc = roleOf(on.args[1].arg);
+    try testing.expect(std.mem.startsWith(u8, comp, "s.kv.comp.L") and std.mem.startsWith(u8, mc, "s.kv.mc.L"));
+    try testing.expectEqualStrings(comp["s.kv.comp.L".len..], mc["s.kv.mc.L".len..]);
+    try testing.expectEqualStrings(mc, roleOf(on.args[2].arg));
+    try testing.expectEqual(@as(i64, 0), on.args[1].arg.t.offset);
+    try testing.expectEqual(@as(i64, 576), on.args[2].arg.t.offset);
+    const rows = on.args[1].arg.t.shape[0];
+    try testing.expect(rows == p.mirror_pages * 128 or rows == p.mirror_pages * 256);
+    try testing.expectEqualStrings("s.kv.pt", roleOf(paged.args[11].arg));
+    try testing.expectEqualStrings("s.kv.mt", roleOf(on.args[11].arg));
+    try testing.expect(on.args[20].arg.i > 0);
+}
+
+test "TF_DSV41_KV_MIRROR: inside the mirror no exchange and KV_SPLIT=0's reads; past it today's calls plus the stores" {
+    var arena = std.heap.ArenaAllocator.init(testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const cfg: Config = .{};
+    const w = try widths(a, &cfg);
+    var backbone: [40]u32 = undefined;
+    for (&backbone, 0..) |*l, i| l.* = @intCast(i);
+    const served: block.Options = .{ .limit = limit, .r1 = true, .index_bound = true, .expert_topp = 0.85, .branches = true, .mhc_defer = true, .kv_norm_store = true };
+    var rows = served;
+    rows.rows = true;
+    var reads: usize = 0;
+    for ([_]block.Options{ .{ .limit = limit }, served, rows }) |base| for ([_]i64{ 1, 6, 16, 24, 64 }) |n| for ([_]i64{ 300, 1025, 2048, 2049, 4096 }) |end| {
+        var o = base;
+        o.pool = splitPool(0);
+        var on = base;
+        on.pool = splitPool(mirror);
+        var pg = base;
+        pg.pool = pagedPool();
+        const off_cs = try block.emit(a, &cfg, &w, o, &backbone, n, end - n, true);
+        const on_cs = try block.emit(a, &cfg, &w, on, &backbone, n, end - n, true);
+        const paged = try block.emit(a, &cfg, &w, pg, &backbone, n, end - n, true);
+        // the knob without split KV changes nothing (replicated KV has no exchange to skip)
+        var pgm = pg;
+        pgm.pool.?.mirror = mirror;
+        pgm.pool.?.mirror_pages = splitPool(mirror).mirror_pages;
+        const paged_m = try block.emit(a, &cfg, &w, pgm, &backbone, n, end - n, true);
+        try testing.expectEqual(paged.len, paged_m.len);
+        for (paged, paged_m) |x, y| try testing.expectEqualStrings(try key(a, x, &.{}), try key(a, y, &.{}));
+        // off: no mirror role anywhere, an exchange a compressed index layer
+        var kx: usize = 0;
+        for (off_cs) |c| {
+            kx += @intFromBool(isKx(c));
+            for (c.args) |x| try testing.expect(!std.mem.startsWith(u8, roleOf(x.arg), "s.kv.m"));
+        }
+        try testing.expect(kx > 0);
+        var stores: usize = 0;
+        const inner = try withoutStores(a, on_cs, on.pool.?, &stores);
+        try testing.expect(stores > 0);
+        if (end > mirror) {
+            try testing.expectEqual(off_cs.len, inner.len);
+            for (off_cs, inner) |x, y| try testing.expectEqualStrings(try key(a, x, &.{}), try key(a, y, &.{}));
+            continue;
+        }
+        reads += 1;
+        // off less its exchanges (each one's join on the call after it) equals on up to the compressed reads
+        var cut: std.ArrayList(calls.Call) = .empty;
+        var carry: ?calls.Call = null;
+        for (off_cs) |c| {
+            if (isKx(c)) {
+                carry = c;
+                continue;
+            }
+            var x = c;
+            if (carry) |k| {
+                x.join = x.join or k.join;
+                x.fork = x.fork or k.fork;
+                carry = null;
+            }
+            try cut.append(a, x);
+        }
+        try testing.expectEqual(off_cs.len - kx, inner.len);
+        try testing.expectEqual(paged.len, inner.len);
+        var attns: usize = 0;
+        for (cut.items, inner, paged) |x, y, z| {
+            try testing.expect(!isKx(y));
+            if (compAttn(y)) {
+                try checkRead(a, x, y, z, on.pool.?);
+                attns += 1;
+                continue;
+            }
+            try testing.expectEqualStrings(try key(a, x, &.{}), try key(a, y, &.{}));
+            // KV_SPLIT=0's calls but for the pool store's split table
+            const pt = [1]usize{if (try compStore(y)) try at(y, "PT") else y.args.len};
+            try testing.expectEqualStrings(try key(a, z, &pt), try key(a, y, &pt));
+        }
+        try testing.expect(attns >= kx);
+    };
+    try testing.expectEqual(@as(usize, 3 * 5 * 3), reads);
+}
+
+test "TF_DSV41_KV_MIRROR: row mode stacks the mirror table as the page tables, in the stores and the reads" {
+    var arena = std.heap.ArenaAllocator.init(testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const cfg: Config = .{};
+    const w = try widths(a, &cfg);
+    var backbone: [40]u32 = undefined;
+    for (&backbone, 0..) |*l, i| l.* = @intCast(i);
+    var o: block.Options = .{ .limit = limit, .r1 = true, .branches = true, .mhc_defer = true, .rows = true };
+    o.pool = splitPool(mirror);
+    const cs = try rowmode.transform(a, try block.emit(a, &cfg, &w, o, &backbone, 6, 1994, true), 6, .{ .slots = slots, .rmax = 64, .pts = pages });
+    var stores: usize = 0;
+    var reads: usize = 0;
+    for (cs) |c| {
+        for (c.args) |x| if (std.mem.eql(u8, roleOf(x.arg), "s.kv.mt")) try testing.expectEqualSlices(i64, &.{ slots, pages }, x.arg.t.shape);
+        if (try compStore(c) and std.mem.startsWith(u8, roleOf(c.args[try at(c, "V")].arg), "s.kv.mc.L")) {
+            try testing.expectEqual(pages, c.args[try at(c, "PTS")].arg.i);
+            try testing.expect(c.args[try at(c, "ROWS")].arg.b);
+            stores += 1;
+        }
+        if (compAttn(c)) {
+            try testing.expectEqualStrings("s.kv.mt", roleOf(c.args[11].arg));
+            try testing.expectEqual(pages, c.args[21].arg.i);
+            reads += 1;
+        }
+    }
+    try testing.expect(stores > 0 and reads > 0);
+}
+
