diff --git a/zig/src/core/runner_frontend_integer.zig b/zig/src/core/runner_frontend_integer.zig
new file mode 100644
index 0000000000000000000000000000000000000000..b7803926bdadedc15a5b872281b8f368f345a944
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer.zig
@@ -0,0 +1,72 @@
+const std = @import("std");
+const ast = @import("runner_frontend_integer_ast.zig");
+const compiler = @import("runner_frontend_program_compile.zig");
+
+pub fn ambiguousPercent(a: std.mem.Allocator, source: []const u8) std.mem.Allocator.Error!bool {
+    if (std.mem.indexOfScalar(u8, source, '%') == null) return false;
+    var parser = ast.Parser{ .source = source };
+    _ = parser.parse() catch return false;
+    const percentage = try @import("runner_frontend_inline.zig").lower(a, source, true) orelse return false;
+    defer a.free(percentage);
+    return true;
+}
+
+// Proof values decide admission; emitted nodes retain the requested arithmetic and original literal values.
+pub fn lower(a: std.mem.Allocator, source: []const u8) std.mem.Allocator.Error!?[]u8 {
+    var code = std.mem.trim(u8, source, " \t\r\n");
+    if (std.mem.startsWith(u8, code, ">>> ")) code = std.mem.trim(u8, code[4..], " \t\r\n");
+    if (std.mem.startsWith(u8, code, "print")) {
+        const rest = std.mem.trimStart(u8, code[5..], " \t");
+        if (rest.len < 3 or rest[0] != '(' or rest[rest.len - 1] != ')') return null;
+        code = rest[1 .. rest.len - 1];
+    }
+    if (code.len == 0 or code.len > 4096) return null;
+    var parser = ast.Parser{ .source = code };
+    const root = parser.parse() catch return null;
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(a);
+    try out.appendSlice(a, @embedFile("runner_frontend_integer_runtime.c"));
+    try out.appendSlice(a, "\nstatic const struct tf_node tf_nodes[] = {\n");
+    var emitter = Emitter{ .a = a, .parser = &parser, .out = &out };
+    _ = try emitter.node(root);
+    try out.print(a, "}};\nint main(void) {{ return tf_run(tf_nodes, {d}); }}\n", .{emitter.count});
+    return try out.toOwnedSlice(a);
+}
+
+pub fn compile(a: std.mem.Allocator, io: std.Io, code: []const u8, config: compiler.Config) std.mem.Allocator.Error!?[]u8 {
+    const source = try lower(a, code) orelse return null;
+    defer a.free(source);
+    var runtime_config = config;
+    runtime_config.optimize = true;
+    return compiler.compile(a, io, source, runtime_config);
+}
+
+const Emitter = struct {
+    a: std.mem.Allocator,
+    parser: *const ast.Parser,
+    out: *std.ArrayList(u8),
+    count: usize = 0,
+    mapped: [64]?usize = @splat(null),
+
+    fn node(self: *Emitter, index: usize) std.mem.Allocator.Error!usize {
+        if (self.mapped[index]) |mapped| return mapped;
+        const n = self.parser.nodes[index];
+        var l: usize = 0;
+        var r: usize = 0;
+        var k: usize = 0;
+        if (n.op != .literal) l = try self.node(n.l);
+        if (n.op != .literal and n.op != .neg and n.op != .digits) r = try self.node(n.r);
+        if (n.op == .powmod) k = try self.node(n.k);
+        if (n.op == .literal) {
+            try self.out.print(self.a, "{{0,0,0,{d},\"{s}{s}\"}},\n", .{
+                n.base, if (n.value < 0) "-" else "", n.text,
+            });
+        } else {
+            try self.out.print(self.a, "{{{d},{d},{d},{d},0}},\n", .{ @backingInt(n.op), l, r, k });
+        }
+        const result = self.count;
+        self.count += 1;
+        self.mapped[index] = result;
+        return result;
+    }
+};
diff --git a/zig/src/core/runner_frontend_integer_ast.zig b/zig/src/core/runner_frontend_integer_ast.zig
new file mode 100644
index 0000000000000000000000000000000000000000..5086e645e29b5de37a460d88c257b1460ba4979c
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer_ast.zig
@@ -0,0 +1,255 @@
+const std = @import("std");
+
+pub const Invalid = error{Unsupported};
+pub const limit: i512 = std.math.pow(i512, 10, 62);
+pub const Op = enum(u8) { literal, neg, add, sub, mul, floor, mod, pow, powmod, digits, divmod };
+pub const Node = struct {
+    op: Op,
+    l: usize = 0,
+    r: usize = 0,
+    k: usize = 0,
+    value: i512 = 0,
+    text: []const u8 = "",
+    base: u8 = 10,
+};
+pub const Parser = struct {
+    source: []const u8,
+    pos: usize = 0,
+    nodes: [64]Node = undefined,
+    count: usize = 0,
+    proved: [64]bool = @splat(false),
+
+    pub fn parse(self: *Parser) Invalid!usize {
+        self.space();
+        if (self.pos == self.source.len or self.source[self.pos] == '+') return error.Unsupported;
+        const root = try self.expr(0);
+        self.space();
+        if (self.pos != self.source.len) return error.Unsupported;
+        _ = try self.prove(root, root);
+        return root;
+    }
+
+    fn space(self: *Parser) void {
+        while (self.pos < self.source.len and (self.source[self.pos] == ' ' or self.source[self.pos] == '\t'))
+            self.pos += 1;
+    }
+
+    fn take(self: *Parser, s: []const u8) bool {
+        self.space();
+        if (!std.mem.startsWith(u8, self.source[self.pos..], s)) return false;
+        self.pos += s.len;
+        return true;
+    }
+
+    fn need(self: *Parser, s: []const u8) Invalid!void {
+        if (!self.take(s)) return error.Unsupported;
+    }
+
+    fn add(self: *Parser, node: Node) Invalid!usize {
+        if (self.count == self.nodes.len) return error.Unsupported;
+        self.nodes[self.count] = node;
+        self.count += 1;
+        return self.count - 1;
+    }
+
+    fn expr(self: *Parser, depth: usize) Invalid!usize {
+        if (depth > 12) return error.Unsupported;
+        var left = try self.term(depth);
+        while (true) {
+            const op: Op = if (self.take("+")) .add else if (self.take("-")) .sub else break;
+            left = try self.add(.{ .op = op, .l = left, .r = try self.term(depth) });
+        }
+        return left;
+    }
+
+    fn term(self: *Parser, depth: usize) Invalid!usize {
+        var left = try self.factor(depth);
+        while (true) {
+            const op: Op = if (self.take("//")) .floor else if (self.take("%")) .mod else if (self.take("*")) .mul else break;
+            const right = try self.factor(depth);
+            const n = self.nodes[left];
+            if (op == .mod and n.op == .pow) {
+                left = try self.add(.{ .op = .powmod, .l = n.l, .r = n.r, .k = right });
+            } else if (op == .mod and n.op == .neg and self.nodes[n.l].op == .pow) {
+                const p = self.nodes[n.l];
+                const reduced = try self.add(.{ .op = .powmod, .l = p.l, .r = p.r, .k = right });
+                const negative = try self.add(.{ .op = .neg, .l = reduced });
+                left = try self.add(.{ .op = .mod, .l = negative, .r = right });
+            } else {
+                left = try self.add(.{ .op = op, .l = left, .r = right });
+            }
+        }
+        return left;
+    }
+
+    fn factor(self: *Parser, depth: usize) Invalid!usize {
+        if (depth > 12) return error.Unsupported;
+        if (self.take("+")) return self.factor(depth + 1);
+        if (self.take("-")) return self.add(.{ .op = .neg, .l = try self.factor(depth + 1) });
+        const left = try self.atom(depth);
+        if (self.take("**")) return self.add(.{ .op = .pow, .l = left, .r = try self.factor(depth + 1) });
+        return left;
+    }
+
+    fn atom(self: *Parser, depth: usize) Invalid!usize {
+        if (self.take("(")) {
+            const n = try self.expr(depth + 1);
+            try self.need(")");
+            return n;
+        }
+        if (self.take("divmod")) {
+            try self.need("(");
+            const a = try self.expr(depth + 1);
+            try self.need(",");
+            const b = try self.expr(depth + 1);
+            try self.need(")");
+            return self.add(.{ .op = .divmod, .l = a, .r = b });
+        }
+        if (self.take("pow")) {
+            try self.need("(");
+            const a = try self.expr(depth + 1);
+            try self.need(",");
+            const b = try self.expr(depth + 1);
+            if (!self.take(",")) return error.Unsupported;
+            const m = try self.expr(depth + 1);
+            try self.need(")");
+            return self.add(.{ .op = .powmod, .l = a, .r = b, .k = m });
+        }
+        if (self.take("len")) {
+            try self.need("(");
+            try self.need("str");
+            try self.need("(");
+            const n = try self.expr(depth + 1);
+            try self.need(")");
+            try self.need(")");
+            return self.add(.{ .op = .digits, .l = n });
+        }
+        if (self.take("int")) return self.convert();
+        return self.literal();
+    }
+
+    fn convert(self: *Parser) Invalid!usize {
+        try self.need("(");
+        self.space();
+        if (self.pos == self.source.len) return error.Unsupported;
+        const quote = self.source[self.pos];
+        if (quote != '\'' and quote != '"') return error.Unsupported;
+        self.pos += 1;
+        const begin = self.pos;
+        while (self.pos < self.source.len and self.source[self.pos] != quote) : (self.pos += 1) {}
+        if (self.pos == self.source.len) return error.Unsupported;
+        const text = std.mem.trim(u8, self.source[begin..self.pos], " \t");
+        self.pos += 1;
+        var base: u8 = 10;
+        if (self.take(",")) {
+            if (self.take("16")) base = 16 else if (self.take("2")) base = 2 else return error.Unsupported;
+        }
+        try self.need(")");
+        var digits = text;
+        var sign: i512 = 1;
+        if (digits.len != 0 and (digits[0] == '-' or digits[0] == '+')) {
+            if (digits[0] == '-') sign = -1;
+            digits = digits[1..];
+        }
+        if (digits.len >= 2 and digits[0] == '0' and
+            ((base == 16 and (digits[1] == 'x' or digits[1] == 'X')) or
+                (base == 2 and (digits[1] == 'b' or digits[1] == 'B')))) digits = digits[2..];
+        return self.add(.{ .op = .literal, .value = sign * try radix(digits, base), .text = digits, .base = base });
+    }
+
+    fn literal(self: *Parser) Invalid!usize {
+        self.space();
+        const begin = self.pos;
+        var base: u8 = 10;
+        if (self.pos + 2 <= self.source.len and self.source[self.pos] == '0') {
+            const c = self.source[self.pos + 1];
+            if (c == 'x' or c == 'X') base = 16 else if (c == 'b' or c == 'B') base = 2;
+            if (base != 10) self.pos += 2;
+        }
+        const start = self.pos;
+        while (self.pos < self.source.len and digit(self.source[self.pos]) < base) : (self.pos += 1) {}
+        if (base == 10 and self.pos - begin > 1 and self.source[begin] == '0') return error.Unsupported;
+        const text = self.source[start..self.pos];
+        return self.add(.{ .op = .literal, .value = try radix(text, base), .text = text, .base = base });
+    }
+
+    fn prove(self: *Parser, index: usize, root: usize) Invalid!i512 {
+        const n = self.nodes[index];
+        if (self.proved[index]) return n.value;
+        if (n.op == .literal) return n.value;
+        const a = try self.prove(n.l, root);
+        const b = switch (n.op) {
+            .neg, .digits => 0,
+            else => try self.prove(n.r, root),
+        };
+        const result = switch (n.op) {
+            .literal => unreachable,
+            .neg => -a,
+            .add => a + b,
+            .sub => a - b,
+            .mul => a * b,
+            .floor, .mod, .divmod => blk: {
+                if (b == 0 or (n.op == .divmod and index != root)) return error.Unsupported;
+                if (n.op == .mod) break :blk @mod(a, b);
+                const q = @divFloor(a, b);
+                if (n.op == .divmod) _ = try bound(@mod(a, b));
+                break :blk q;
+            },
+            .pow => try power(a, b),
+            .powmod => blk: {
+                const m = try self.prove(n.k, root);
+                if (m == 0 or b < 0) return error.Unsupported;
+                var exponent = b;
+                var base = @mod(a, m);
+                var result = @mod(@as(i512, 1), m);
+                while (exponent != 0) {
+                    if (@mod(exponent, 2) != 0) result = @mod(result * base, m);
+                    exponent = @divTrunc(exponent, 2);
+                    if (exponent != 0) base = @mod(base * base, m);
+                }
+                break :blk result;
+            },
+            .digits => blk: {
+                var magnitude = if (a < 0) -a else a;
+                var count: i512 = if (a < 0) 2 else 1;
+                while (magnitude >= 10) : (magnitude = @divTrunc(magnitude, 10)) count += 1;
+                break :blk count;
+            },
+        };
+        self.nodes[index].value = try bound(result);
+        self.proved[index] = true;
+        return result;
+    }
+};
+
+fn digit(c: u8) u8 {
+    return if (c >= '0' and c <= '9') c - '0' else if (c >= 'a' and c <= 'f') c - 'a' + 10 else if (c >= 'A' and c <= 'F') c - 'A' + 10 else 255;
+}
+
+fn radix(text: []const u8, base: u8) Invalid!i512 {
+    if (text.len == 0) return error.Unsupported;
+    var n: i512 = 0;
+    for (text) |c| {
+        if (digit(c) >= base) return error.Unsupported;
+        n = try bound(n * base + digit(c));
+    }
+    return n;
+}
+
+fn bound(n: i512) Invalid!i512 {
+    if (n <= -limit or n >= limit) return error.Unsupported;
+    return n;
+}
+
+fn power(a: i512, b: i512) Invalid!i512 {
+    if (b < 0) return error.Unsupported;
+    var exponent = b;
+    var base = a;
+    var result: i512 = 1;
+    while (exponent != 0) {
+        if (@mod(exponent, 2) != 0) result = try bound(result * base);
+        exponent = @divTrunc(exponent, 2);
+        if (exponent != 0) base = try bound(base * base);
+    }
+    return result;
+}
diff --git a/zig/src/core/runner_frontend_integer_runtime.c b/zig/src/core/runner_frontend_integer_runtime.c
new file mode 100644
index 0000000000000000000000000000000000000000..6ccba8ec213f87498bd7863ed44566330a1540e1
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer_runtime.c
@@ -0,0 +1,349 @@
+// Freestanding RV32 integer library; runner_frontend_program_compile supplies putchar and process startup.
+typedef unsigned int tf_wu;
+typedef unsigned long long tf_wd;
+struct tf_wint { tf_wu v[8]; int neg; };
+
+// ABI: nodes are topological, child indices precede parents, n <= 64, and node n-1 is the output root.
+struct tf_node { int op, l, r, k; const char *text; };
+
+// Ops: 0 literal, 1 neg, 2 add, 3 sub, 4 mul, 5 floor-div, 6 mod, 7 pow, 8 powmod, 9 str-len, 10 divmod.
+static struct tf_wint tf_wvalues[64];
+
+// The parent proves every admitted input and node result has magnitude below 10^62; scratch products use 512 bits.
+static int tf_wbad;
+
+void *memcpy(void *dst, const void *src, unsigned int n) {
+    unsigned char *d = (unsigned char *)dst;
+    const unsigned char *s = (const unsigned char *)src;
+    for (unsigned int i = 0; i < n; ++i) d[i] = s[i];
+    return dst;
+}
+
+void *memset(void *dst, int value, unsigned int n) {
+    unsigned char *d = (unsigned char *)dst;
+    for (unsigned int i = 0; i < n; ++i) d[i] = (unsigned char)value;
+    return dst;
+}
+
+static struct tf_wint tf_wsmall(tf_wu x) {
+    struct tf_wint a;
+    for (int i = 0; i < 8; ++i) a.v[i] = 0;
+    a.v[0] = x;
+    a.neg = 0;
+    return a;
+}
+
+static int tf_wused(const struct tf_wint *a) {
+    int n = 8;
+    while (n && !a->v[n - 1]) --n;
+    return n;
+}
+
+static void tf_wnormalize(struct tf_wint *a) {
+    if (!tf_wused(a)) a->neg = 0;
+}
+
+static int tf_wcmp(const struct tf_wint *a, const struct tf_wint *b) {
+    for (int i = 7; i >= 0; --i) {
+        if (a->v[i] != b->v[i]) return a->v[i] > b->v[i] ? 1 : -1;
+    }
+    return 0;
+}
+
+static struct tf_wint tf_waddmag(const struct tf_wint *a, const struct tf_wint *b) {
+    struct tf_wint c = tf_wsmall(0);
+    tf_wd carry = 0;
+    for (int i = 0; i < 8; ++i) {
+        tf_wd s = (tf_wd)a->v[i] + b->v[i] + carry;
+        c.v[i] = (tf_wu)s;
+        carry = s >> 32;
+    }
+    if (carry) tf_wbad = 1;
+    return c;
+}
+
+// Magnitude subtraction also supports the wrapped low words of a 257-bit division remainder.
+static struct tf_wint tf_wsubmag(const struct tf_wint *a, const struct tf_wint *b) {
+    struct tf_wint c = tf_wsmall(0);
+    tf_wd borrow = 0;
+    for (int i = 0; i < 8; ++i) {
+        tf_wd t = (tf_wd)b->v[i] + borrow;
+        c.v[i] = a->v[i] - (tf_wu)t;
+        borrow = (tf_wd)a->v[i] < t;
+    }
+    return c;
+}
+
+static struct tf_wint tf_wadd(struct tf_wint a, struct tf_wint b) {
+    struct tf_wint c;
+    if (a.neg == b.neg) {
+        c = tf_waddmag(&a, &b);
+        c.neg = a.neg;
+    } else if (tf_wcmp(&a, &b) >= 0) {
+        c = tf_wsubmag(&a, &b);
+        c.neg = a.neg;
+    } else {
+        c = tf_wsubmag(&b, &a);
+        c.neg = b.neg;
+    }
+    tf_wnormalize(&c);
+    return c;
+}
+
+static void tf_wproduct(tf_wu w[16], const struct tf_wint *a, const struct tf_wint *b) {
+    for (int i = 0; i < 16; ++i) w[i] = 0;
+    int na = tf_wused(a), nb = tf_wused(b);
+    for (int i = 0; i < na; ++i) {
+        tf_wd carry = 0;
+        for (int j = 0; j < nb; ++j) {
+            tf_wd t = (tf_wd)a->v[i] * b->v[j] + w[i + j] + carry;
+            w[i + j] = (tf_wu)t;
+            carry = t >> 32;
+        }
+        w[i + nb] = (tf_wu)carry;
+    }
+}
+
+static struct tf_wint tf_wmul(const struct tf_wint *a, const struct tf_wint *b) {
+    tf_wu w[16];
+    tf_wproduct(w, a, b);
+    struct tf_wint c = tf_wsmall(0);
+    for (int i = 0; i < 8; ++i) {
+        c.v[i] = w[i];
+        if (w[i + 8]) tf_wbad = 1;
+    }
+    c.neg = a->neg != b->neg;
+    tf_wnormalize(&c);
+    return c;
+}
+
+// All divisions use 32-bit instructions; the small-divisor path handles two halfwords per limb.
+static tf_wu tf_wdivsmall(tf_wu *w, int n, tf_wu d) {
+    tf_wu rem = 0;
+    for (int i = n - 1; i >= 0; --i) {
+        tf_wu x = w[i];
+        if (d <= 65535u) {
+            tf_wu t = (rem << 16) | (x >> 16);
+            tf_wu q = t / d;
+            t = ((t % d) << 16) | (x & 65535u);
+            w[i] = (q << 16) | (t / d);
+            rem = t % d;
+        } else if (!rem) {
+            w[i] = x / d;
+            rem = x % d;
+        } else {
+            tf_wu q = 0;
+            for (int bit = 31; bit >= 0; --bit) {
+                tf_wu high = rem >> 31;
+                rem = (rem << 1) | ((x >> bit) & 1u);
+                if (high || rem >= d) {
+                    rem -= d;
+                    q |= 1u << bit;
+                }
+            }
+            w[i] = q;
+        }
+    }
+    return rem;
+}
+
+static int tf_wbits(const tf_wu *w, int n) {
+    while (n && !w[n - 1]) --n;
+    if (!n) return 0;
+    tf_wu x = w[n - 1];
+    int bits = (n - 1) * 32;
+    while (x) { ++bits; x >>= 1; }
+    return bits;
+}
+
+static int tf_wstep(struct tf_wint *r, tf_wu bit, const struct tf_wint *d) {
+    tf_wu carry = bit;
+    for (int i = 0; i < 8; ++i) {
+        tf_wu high = r->v[i] >> 31;
+        r->v[i] = (r->v[i] << 1) | carry;
+        carry = high;
+    }
+    if (!carry && tf_wcmp(r, d) < 0) return 0;
+    *r = tf_wsubmag(r, d);
+    return 1;
+}
+
+static void tf_wdivmag(const struct tf_wint *a, const struct tf_wint *b,
+                       struct tf_wint *q, struct tf_wint *r) {
+    *q = tf_wsmall(0);
+    *r = tf_wsmall(0);
+    int nb = tf_wused(b);
+    if (!nb) { tf_wbad = 1; return; }
+    if (nb == 1) {
+        *q = *a;
+        q->neg = 0;
+        r->v[0] = tf_wdivsmall(q->v, 8, b->v[0]);
+        return;
+    }
+    for (int bit = tf_wbits(a->v, 8) - 1; bit >= 0; --bit) {
+        if (tf_wstep(r, (a->v[bit / 32] >> (bit % 32)) & 1u, b))
+            q->v[bit / 32] |= 1u << (bit % 32);
+    }
+}
+
+static void tf_wdivmod(const struct tf_wint *a, const struct tf_wint *b,
+                       struct tf_wint *q, struct tf_wint *r) {
+    tf_wdivmag(a, b, q, r);
+    if (tf_wbad) return;
+    if (a->neg != b->neg && tf_wused(r)) {
+        struct tf_wint one = tf_wsmall(1);
+        *q = tf_waddmag(q, &one);
+        *r = tf_wsubmag(b, r);
+    }
+    q->neg = a->neg != b->neg;
+    r->neg = b->neg;
+    tf_wnormalize(q);
+    tf_wnormalize(r);
+}
+
+static struct tf_wint tf_wmodmul(const struct tf_wint *a, const struct tf_wint *b,
+                                const struct tf_wint *m) {
+    tf_wu w[16];
+    tf_wproduct(w, a, b);
+    struct tf_wint r = tf_wsmall(0);
+    if (tf_wused(m) == 1) {
+        r.v[0] = tf_wdivsmall(w, 16, m->v[0]);
+        return r;
+    }
+    for (int bit = tf_wbits(w, 16) - 1; bit >= 0; --bit)
+        tf_wstep(&r, (w[bit / 32] >> (bit % 32)) & 1u, m);
+    return r;
+}
+
+static struct tf_wint tf_wpow(struct tf_wint a, const struct tf_wint *e,
+                             const struct tf_wint *mod) {
+    struct tf_wint result = tf_wsmall(1), m = tf_wsmall(0), unused;
+    if (e->neg) { tf_wbad = 1; return m; }
+    if (mod) {
+        m = *mod;
+        m.neg = 0;
+        if (!tf_wused(&m)) { tf_wbad = 1; return m; }
+        if (tf_wused(&m) == 1 && m.v[0] == 1) return tf_wsmall(0);
+        int negative = a.neg;
+        struct tf_wint reduced;
+        tf_wdivmag(&a, &m, &unused, &reduced);
+        a = reduced;
+        if (negative && tf_wused(&a)) a = tf_wsubmag(&m, &a);
+    }
+    int bits = tf_wbits(e->v, 8);
+    for (int bit = 0; bit < bits && !tf_wbad; ++bit) {
+        if ((e->v[bit / 32] >> (bit % 32)) & 1u)
+            result = mod ? tf_wmodmul(&result, &a, &m) : tf_wmul(&result, &a);
+        if (bit + 1 < bits) a = mod ? tf_wmodmul(&a, &a, &m) : tf_wmul(&a, &a);
+    }
+    if (mod && mod->neg && tf_wused(&result)) {
+        result = tf_wsubmag(&m, &result);
+        result.neg = 1;
+    }
+    return result;
+}
+
+// Literal text contains signed digits without a radix prefix; k is radix 2, 10, or 16, not a child index.
+static struct tf_wint tf_wparse(const char *s, int base) {
+    struct tf_wint a = tf_wsmall(0);
+    if (!s || (base != 2 && base != 10 && base != 16)) { tf_wbad = 1; return a; }
+    int negative = *s == '-';
+    if (*s == '-' || *s == '+') ++s;
+    if (!*s) tf_wbad = 1;
+    for (; *s; ++s) {
+        int digit;
+        if (*s >= '0' && *s <= '9') digit = *s - '0';
+        else if (*s >= 'a' && *s <= 'f') digit = *s - 'a' + 10;
+        else if (*s >= 'A' && *s <= 'F') digit = *s - 'A' + 10;
+        else { tf_wbad = 1; break; }
+        if (digit >= base) { tf_wbad = 1; break; }
+        tf_wd carry = (tf_wu)digit;
+        for (int i = 0; i < 8; ++i) {
+            tf_wd t = (tf_wd)a.v[i] * (tf_wu)base + carry;
+            a.v[i] = (tf_wu)t;
+            carry = t >> 32;
+        }
+        if (carry) { tf_wbad = 1; break; }
+    }
+    a.neg = negative;
+    tf_wnormalize(&a);
+    return a;
+}
+
+static int tf_wformat(struct tf_wint a, char text[79]) {
+    char digits[78];
+    int count = 0, len = 0;
+    do { digits[count++] = (char)('0' + tf_wdivsmall(a.v, 8, 10)); } while (tf_wused(&a));
+    if (a.neg) text[len++] = '-';
+    while (count) text[len++] = digits[--count];
+    return len;
+}
+
+static void tf_wprint(const struct tf_wint *a) {
+    char text[79];
+    int len = tf_wformat(*a, text);
+    for (int i = 0; i < len; ++i) putchar(text[i]);
+}
+
+// Append the static node array and main calling tf_run(nodes, N); errors return 1 before emitting any output.
+int tf_run(const volatile struct tf_node *nodes, int n) {
+    tf_wbad = 0;
+    if (!nodes || n < 1 || n > 64) return 1;
+    struct tf_wint remainder = tf_wsmall(0);
+    for (int i = 0; i < n; ++i) {
+        const volatile struct tf_node *node = &nodes[i];
+        struct tf_wint a = tf_wsmall(0), b = tf_wsmall(0), c;
+        int op = node->op;
+        if (op < 0 || op > 10) return 1;
+        if (op) {
+            if (node->l < 0 || node->l >= i) return 1;
+            a = tf_wvalues[node->l];
+        }
+        if ((op >= 2 && op <= 8) || op == 10) {
+            if (node->r < 0 || node->r >= i) return 1;
+            b = tf_wvalues[node->r];
+        }
+        switch (op) {
+        case 0: c = tf_wparse(node->text, node->k); break;
+        case 1:
+            c = a;
+            c.neg = !c.neg;
+            tf_wnormalize(&c);
+            break;
+        case 2: c = tf_wadd(a, b); break;
+        case 3:
+            b.neg = !b.neg;
+            c = tf_wadd(a, b);
+            break;
+        case 4: c = tf_wmul(&a, &b); break;
+        case 5: case 6: case 10:
+            if (op == 10 && i != n - 1) return 1;
+            tf_wdivmod(&a, &b, &c, &remainder);
+            if (op == 6) c = remainder;
+            break;
+        case 7: c = tf_wpow(a, &b, (const struct tf_wint *)0); break;
+        case 8:
+            if (node->k < 0 || node->k >= i) return 1;
+            c = tf_wpow(a, &b, &tf_wvalues[node->k]);
+            break;
+        case 9: {
+            char text[79];
+            c = tf_wsmall((tf_wu)tf_wformat(a, text));
+            break;
+        }
+        default: return 1;
+        }
+        if (tf_wbad) return 1;
+        tf_wvalues[i] = c;
+    }
+    if (nodes[n - 1].op == 10) putchar('(');
+    tf_wprint(&tf_wvalues[n - 1]);
+    if (nodes[n - 1].op == 10) {
+        putchar(',');
+        putchar(' ');
+        tf_wprint(&remainder);
+        putchar(')');
+    }
+    putchar('\n');
+    return 0;
+}
diff --git a/zig/src/core/runner_frontend_integer_test.zig b/zig/src/core/runner_frontend_integer_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..222d95d8bb1060ff2a65dd567011c7af7d72598b
--- /dev/null
+++ b/zig/src/core/runner_frontend_integer_test.zig
@@ -0,0 +1,327 @@
+const std = @import("std");
+const api = @import("runner_api.zig");
+const f = @import("runner_frontend.zig");
+const t = std.testing;
+
+const Case = struct {
+    code: []const u8,
+    expected: []const u8,
+    form: api.Form = .repl,
+};
+
+fn repeat(comptime c: u8, comptime n: usize) [n]u8 {
+    return @splat(c);
+}
+
+const ten31 = "1" ++ repeat('0', 31);
+const ten61 = "1" ++ repeat('0', 61);
+const ten62 = "1" ++ repeat('0', 62);
+
+const arithmetic = [_]Case{
+    .{ .code = "123456789012345*987654321098765", .expected = "121932631137021071359549253925\n" },
+    .{ .code = "print(-123456789012345*987654321098765)", .expected = "-121932631137021071359549253925\n", .form = .fence },
+    .{ .code = "10**30+7", .expected = "1000000000000000000000000000007\n" },
+    .{ .code = "7-10**30", .expected = "-999999999999999999999999999993\n" },
+    .{ .code = "-(10**30)", .expected = "-1000000000000000000000000000000\n" },
+    .{ .code = "+7", .expected = "7\n" },
+    .{ .code = "(-7)*(-3)", .expected = "21\n" },
+    .{ .code = "-2**2", .expected = "-4\n" },
+    .{ .code = "(-2)**3", .expected = "-8\n" },
+    .{ .code = "2+3*4", .expected = "14\n" },
+    .{ .code = "(2+3)*4", .expected = "20\n" },
+    .{ .code = "(10**61+1)//10**30", .expected = ten31 ++ "\n" },
+    .{ .code = "(10**61+1)%10**30", .expected = "1\n" },
+    .{ .code = repeat('9', 62) ++ "//10", .expected = repeat('9', 61) ++ "\n" },
+    .{ .code = repeat('9', 62) ++ "%10", .expected = "9\n" },
+    .{ .code = "7//3", .expected = "2\n" },
+    .{ .code = "-7//3", .expected = "-3\n" },
+    .{ .code = "7//-3", .expected = "-3\n" },
+    .{ .code = "-7//-3", .expected = "2\n" },
+    .{ .code = "-7%3", .expected = "2\n" },
+    .{ .code = "7%-3", .expected = "-2\n" },
+    .{ .code = "-7%-3", .expected = "-1\n" },
+    .{ .code = "7%3", .expected = "1\n" },
+    .{ .code = "divmod(7,3)", .expected = "(2, 1)\n" },
+    .{ .code = "divmod(-7,3)", .expected = "(-3, 2)\n" },
+    .{ .code = "print(divmod(7,-3))", .expected = "(-3, -2)\n", .form = .fence },
+    .{ .code = "divmod(-7,-3)", .expected = "(2, -1)\n" },
+    .{ .code = "divmod(10**61+1,10**30)", .expected = "(" ++ ten31 ++ ", 1)\n" },
+    .{ .code = "divmod(-10**61,10**30)", .expected = "(-" ++ ten31 ++ ", 0)\n" },
+};
+
+const modular = [_]Case{
+    .{ .code = "pow(2,1000,1000)", .expected = "376\n" },
+    .{ .code = "print(pow(2,1000000,3))", .expected = "1\n", .form = .fence },
+    .{ .code = "pow(2,1000000,-3)", .expected = "-2\n" },
+    .{ .code = "pow(-2,7,5)", .expected = "2\n" },
+    .{ .code = "pow(7,0,97)", .expected = "1\n" },
+    .{ .code = "pow(7,0,1)", .expected = "0\n" },
+    .{ .code = "pow(10**40,2,10**61)", .expected = "0\n" },
+    .{ .code = "2**1000%1000", .expected = "376\n" },
+    .{ .code = "(2**1000000)%3", .expected = "1\n" },
+    .{ .code = "2**1000000%-3", .expected = "-2\n" },
+    .{ .code = "(10**40)**2%10**61", .expected = "0\n" },
+    .{ .code = "pow(10**40+1,2,10**61)", .expected = "2" ++ repeat('0', 39) ++ "1\n" },
+};
+
+const conversions = [_]Case{
+    .{ .code = "0xff+0b101", .expected = "260\n" },
+    .{ .code = "0x10000000000000000", .expected = "18446744073709551616\n" },
+    .{ .code = "0b1" ++ repeat('0', 64), .expected = "18446744073709551616\n" },
+    .{ .code = "int('ff',16)", .expected = "255\n" },
+    .{ .code = "int('101',2)", .expected = "5\n" },
+    .{ .code = "print(int('10000000000000000',16))", .expected = "18446744073709551616\n", .form = .fence },
+    .{ .code = "int('1" ++ repeat('0', 64) ++ "',2)", .expected = "18446744073709551616\n" },
+    .{ .code = "len(str(0))", .expected = "1\n" },
+    .{ .code = "len(str(10**30))", .expected = "31\n" },
+    .{ .code = "len(str(-10**30))", .expected = "32\n" },
+};
+
+const boundaries = [_]Case{
+    .{ .code = ten61, .expected = ten61 ++ "\n" },
+    .{ .code = "10**61", .expected = ten61 ++ "\n" },
+    .{ .code = "10**30*10**31", .expected = ten61 ++ "\n" },
+    .{ .code = "10**61+1", .expected = "1" ++ repeat('0', 60) ++ "1\n" },
+    .{ .code = "-" ++ repeat('9', 62), .expected = "-" ++ repeat('9', 62) ++ "\n" },
+};
+
+const inline_cases = [_]Case{
+    .{ .code = "7%3", .expected = "1\n", .form = .inline_expr },
+    .{ .code = "7%(-3)", .expected = "-2\n", .form = .inline_expr },
+    .{ .code = "(-7)%(-3)", .expected = "-1\n", .form = .inline_expr },
+    .{ .code = "50%*3", .expected = "1.5\n", .form = .inline_expr },
+    .{ .code = "25%+5%", .expected = "0.3\n", .form = .inline_expr },
+    .{ .code = "0.125*2", .expected = "0.25\n", .form = .inline_expr },
+    .{ .code = "1/3+2/3", .expected = "1\n", .form = .inline_expr },
+    .{ .code = "11/18", .expected = "11/18\n", .form = .inline_expr },
+};
+
+fn configured(clang: []const u8, linker: ?[]const u8) f.Context {
+    return .{ .io = t.io, .compiler = .{ .clang = clang, .linker = linker } };
+}
+
+fn translate(context: *f.Context, case: Case) !api.Program {
+    const front = context.frontend();
+    const result = try front.translate(front.ctx, t.allocator, .{
+        .form = case.form,
+        .lang = "python",
+        .code = case.code,
+    });
+    if (result == .abstain) {
+        std.debug.print("integer frontend abstained: {s}\n", .{case.code});
+        return error.UnexpectedAbstention;
+    }
+    return result.program;
+}
+
+fn accepts(context: *f.Context, cases: []const Case) !void {
+    for (cases) |case| {
+        const program = try translate(context, case);
+        defer t.allocator.free(program.bytes);
+    }
+}
+
+fn abstains(context: *f.Context, cell: api.Cell) !void {
+    const front = context.frontend();
+    const result = try front.translate(front.ctx, t.allocator, cell);
+    if (result == .program) {
+        defer t.allocator.free(result.program.bytes);
+        std.debug.print("integer frontend unexpectedly accepted: {s}\n", .{cell.code});
+    }
+    try t.expect(result == .abstain);
+}
+
+fn requiredClang(env: *const std.process.Environ.Map) ![]const u8 {
+    return env.get("TF_RUNNER_CLANG") orelse {
+        std.debug.print("SKIP integer ELF admission: set TF_RUNNER_CLANG and optional TF_RUNNER_LLD\n", .{});
+        return error.SkipZigTest;
+    };
+}
+
+test "integer graphs retain supported arithmetic without requiring a host toolchain" {
+    for (arithmetic ++ modular ++ conversions ++ boundaries) |case| {
+        if (std.mem.eql(u8, case.code, "+7")) continue;
+        const source = try @import("runner_frontend_integer.zig").lower(t.allocator, case.code);
+        try t.expect(source != null);
+        defer t.allocator.free(source.?);
+        try t.expect(std.mem.indexOf(u8, source.?, "tf_run(tf_nodes,") != null);
+    }
+    for ([_][]const u8{ "10**62", "10**31*10**31", "divmod(1,0)", "pow(2,-1,3)", "pow(2,3,0)", "len(str(10**62))", "1.25*2", "divmod(7,3)+1" }) |code| {
+        const source = try @import("runner_frontend_integer.zig").lower(t.allocator, code);
+        defer if (source) |owned| t.allocator.free(owned);
+        try t.expect(source == null);
+    }
+}
+
+test "integer frontend accepts wide arithmetic and Python signed divmod" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    var context = configured(try requiredClang(&env), env.get("TF_RUNNER_LLD"));
+    try accepts(&context, &arithmetic);
+}
+
+test "integer frontend accepts modular powers whose unreduced result exceeds its bound" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    var context = configured(try requiredClang(&env), env.get("TF_RUNNER_LLD"));
+    try accepts(&context, &modular);
+}
+
+test "integer frontend accepts binary hex and decimal string lengths" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    var context = configured(try requiredClang(&env), env.get("TF_RUNNER_LLD"));
+    try accepts(&context, &conversions);
+}
+
+test "integer frontend enforces the 62 digit input and result boundary" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    var context = configured(try requiredClang(&env), env.get("TF_RUNNER_LLD"));
+    try accepts(&context, &boundaries);
