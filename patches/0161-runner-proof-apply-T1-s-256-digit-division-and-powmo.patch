+        .{ .id = "fence/refuse/overflow-before-reduction", .form = .fence, .code = "print(pow((9999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999+1),1,7))", .want = "", .refused = true },
+    }) |c| {
+        var arena = std.heap.ArenaAllocator.init(gpa);
+        defer arena.deinit();
+        const translated = try front.translate(front.ctx, arena.allocator(), .{ .form = c.form, .lang = "python", .code = c.code });
+        if (translated == .abstain) {
+            std.debug.print("powmod route {s}: frontend refusal\n", .{c.id});
+            try std.testing.expect(c.refused);
+            try std.testing.expectEqual(@as(u32, 0), calc.started);
+            refused += 1;
+            continue;
+        }
+        try std.testing.expectEqual(.graph, translated.program.kind);
+        const prior_graph = counted.started;
+        const r = finish(run, try run.start(1, translated.program, 4_000_000));
+        defer run.release(1);
+        std.debug.print("powmod route {s}: graph {t}, steps {d}, stdout '{s}'\n", .{ c.id, r.status, r.steps, r.out });
+        try std.testing.expectEqual(@as(u32, 0), calc.started);
+        try std.testing.expectEqual(if (c.refused) rapi.Status.abstain else rapi.Status.ok, r.status);
+        try std.testing.expectEqualStrings(c.want, r.out);
+        if (c.refused) {
+            try std.testing.expectEqual(rapi.Abstain.unsupported, r.abstain.?);
+            refused += 1;
+        } else {
+            try std.testing.expectEqual(prior_graph + 1, counted.started);
+            owned += 1;
+        }
+    }
+    try std.testing.expectEqual(@as(usize, 38), owned + refused);
+    std.debug.print("powmod routes: {d} owned exact CPython, {d} refused, calc starts {d}\n", .{ owned, refused, calc.started });
+}
+
+test "runner proof: powmod256 width refusals lazy bank and two distinct high-digit streams" {
+    const packets = @import("runner_graph_packet.zig");
+    const excessive: [257]u8 = @splat('9');
+    try std.testing.expectError(error.GraphLiteral, packets.Builder.integer(gpa, .powmod, &.{ &excessive, "1", "7" }));
+    try std.testing.expect(packets.algorithmWidthValid(.powmod, 256));
+    try std.testing.expect(!packets.algorithmWidthValid(.powmod, 257));
+    var both: Both = undefined;
+    try both.open();
+    defer both.close();
+    try std.testing.expectEqual(@as(usize, 0), both.bank.preparedCount());
+    try std.testing.expectEqual(@as(u64, 0), both.bank.loadAttempts());
+    try std.testing.expect(both.bank.plan("powmod-256") != null);
+    try std.testing.expect(both.bank.plan("powmod-128") != null);
+    try std.testing.expect(both.bank.find("half", 256) != null);
+    try std.testing.expect(both.bank.find("mulmodstep", 256) != null);
+    const Case = struct { id: []const u8, a: []const u8, b: []const u8, m: []const u8, want: []const u8 };
+    const cases = [_]Case{
+        .{ .id = "mutation/original/256", .a = "8888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888887", .b = "1", .m = "9999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999993", .want = "8888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888887\n" },
+        .{ .id = "mutation/high-digit-changed/256", .a = "7888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888887", .b = "1", .m = "9999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999993", .want = "7888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888887\n" },
+    };
+    try std.testing.expect(!std.mem.eql(u8, cases[0].want, cases[1].want));
+    try std.testing.expect(cases[0].a.len == 256 and cases[1].a.len == 256);
+    try std.testing.expect(cases[0].a[0] != cases[1].a[0]);
+    try std.testing.expectEqualStrings(cases[0].a[1..], cases[1].a[1..]);
+    const narrow = try packets.Builder.named(gpa, "powmod-128", &.{ cases[0].a, cases[0].b, cases[0].m });
+    defer gpa.free(narrow);
+    try std.testing.expectError(error.GraphNarrowBinding, graph.Machine.boot(gpa, &both.bank, narrow));
+    const oversize = try packets.Builder.named(gpa, "powmod-256", &.{ &excessive, "1", "7" });
+    defer gpa.free(oversize);
+    try std.testing.expectError(error.GraphLiteral, graph.Machine.boot(gpa, &both.bank, oversize));
+    try std.testing.expectEqual(@as(usize, 0), both.bank.preparedCount());
+    try std.testing.expectEqual(@as(u64, 0), both.bank.loadAttempts());
+    const first = try packets.Builder.integer(gpa, .powmod, &.{ cases[0].a, cases[0].b, cases[0].m });
+    defer gpa.free(first);
+    const second = try packets.Builder.integer(gpa, .powmod, &.{ cases[1].a, cases[1].b, cases[1].m });
+    defer gpa.free(second);
+    for ([_][]const u8{ first, second }) |bytes|
+        try std.testing.expect(std.mem.indexOf(u8, bytes, "powmod-256") != null);
+    try std.testing.expectEqual(@as(usize, 0), both.bank.preparedCount());
+    const one = try both.graph.start(1, .{ .kind = .graph, .bytes = first }, 4_000_000);
+    defer both.graph.release(1);
+    const two = try both.graph.start(2, .{ .kind = .graph, .bytes = second }, 4_000_000);
+    defer both.graph.release(2);
+    const r_two = finish(both.graph, two);
+    try std.testing.expectEqual(rapi.Status.ok, r_two.status);
+    try std.testing.expectEqualStrings(cases[1].want, r_two.out);
+    const r_one = finish(both.graph, one);
+    try std.testing.expectEqual(rapi.Status.ok, r_one.status);
+    try std.testing.expectEqualStrings(cases[0].want, r_one.out);
+    try std.testing.expect(both.bank.preparedCount() > 0);
+    try std.testing.expect(both.bank.loadAttempts() > 0);
+    std.debug.print("powmod streams: {s} and {s} exact CPython; lazy prepared {d}, attempts {d}\n", .{ cases[0].id, cases[1].id, both.bank.preparedCount(), both.bank.loadAttempts() });
+}
