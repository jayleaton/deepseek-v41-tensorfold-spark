From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Wed, 4 Nov 2026 01:54:25 +0700
Subject: [PATCH 191/207] dsv41: deletable cuts only between code points; a
 final that is not UTF-8 maps nowhere

T5's r4 review: Cut.gap marked every byte of a stripped blank run, inside
multibyte blanks too, so raw C2 A0 (NBSP) with final A0 mapped at lead 1. mapOf
also never checked the final as UTF-8.

gap now marks only code point starts (no continuation byte), still in one pass,
and mapOf returns null for a final that is not valid UTF-8. Tests: T5's case and
its other side with two- and three-byte blanks (no blank takes four bytes; a
four-byte code point stands in), Cut's boundary flags directly, and the map
against T5's slice-based reference over 1,000 strings with split-code-point finals.

(cherry picked from commit fd7d6cde02ed88d1de08c9b3faeef27217647128)
---
 zig/src/server/runner_projection.zig          | 22 ++++++-
 .../server/runner_projection_http_test.zig    | 59 +++++++++++++++++++
 2 files changed, 78 insertions(+), 3 deletions(-)

diff --git a/zig/src/server/runner_projection.zig b/zig/src/server/runner_projection.zig
index b4073f4b63901a12f8c35c824f806950ce336290..f50b621f82a0f417a8de180ae99e7453072fbf8f 100644
--- a/zig/src/server/runner_projection.zig
+++ b/zig/src/server/runner_projection.zig
@@ -28,7 +28,7 @@ pub fn rawFields(a: Allocator, text: model_text.Text, tokens: []const u32, think
 
 /// The final field as the one raw run with only blanks and whole tool envelopes outside; else null (bad UTF-8, cuts).
 pub fn mapOf(a: Allocator, raw: []const u8, final: []const u8, open: []const u8) Allocator.Error!?Map {
-    if (!std.unicode.utf8ValidateSlice(raw)) return null;
+    if (!std.unicode.utf8ValidateSlice(raw) or !std.unicode.utf8ValidateSlice(final)) return null;
     const body: usize = if (open.len > 0 and std.mem.startsWith(u8, raw, open)) open.len else 0;
     const cut = try Cut.of(a, raw, try tool_parse.envelopes(a, raw), body);
     if (final.len == 0) return if (cut.before[raw.len]) .{ .raw = raw.len, .lead = raw.len, .kept = 0 } else null;
@@ -72,13 +72,16 @@ const Cut = struct {
         return c;
     }
 
-    /// Marks the bytes of raw[from..to] reached from its envelope side through blanks alone; true when all are blank.
+    /// Marks the code point starts of raw[from..to] reached from its envelope side through blanks; true when all blank.
     fn gap(marks: []bool, raw: []const u8, from: usize, to: usize, ok: bool, head: bool) bool {
         const g = raw[from..to];
         const s = reply_text.pyStrip(g);
         const lead = if (s.len == 0) g.len else @intFromPtr(s.ptr) - @intFromPtr(g.ptr);
         const tail = if (s.len == 0) g.len else g.len - lead - s.len;
-        if (ok) @memset(if (head) marks[from .. from + lead + 1] else marks[to - tail .. to + 1], true);
+        const lo, const hi = if (head) .{ from, from + lead + 1 } else .{ to - tail, to + 1 };
+        if (ok) for (lo..hi) |i| {
+            marks[i] = i == raw.len or raw[i] & 0xc0 != 0x80; // inside a multibyte blank: half of it is no deletion
+        };
         return ok and s.len == 0;
     }
 };
@@ -174,3 +177,16 @@ pub fn apply(a: Allocator, runner: Value, given: [2]?Map) !void {
         try put(a, x.object, key, project(if (f) |i| maps[i] else null, raw.int64()));
     };
 }
+
+test "runner projection: deletable cuts fall only between code points, never inside a multibyte blank" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    for ([_][]const u8{ "\u{a0}", "\u{3000}" }) |blank| { // two- and three-byte blanks (none takes four bytes)
+        const c = try Cut.of(a, blank, &.{}, 0);
+        for (0..blank.len + 1) |i| {
+            try std.testing.expectEqual(i == 0 or i == blank.len, c.before[i]);
+            try std.testing.expectEqual(i == 0 or i == blank.len, c.after[i]);
+        }
+    }
+}
diff --git a/zig/src/server/runner_projection_http_test.zig b/zig/src/server/runner_projection_http_test.zig
index bd88c7f7da72c1e4d3a858cef595659788fd45fe..7ad4c30525a9de23c9a22878be32d731b8631359 100644
--- a/zig/src/server/runner_projection_http_test.zig
+++ b/zig/src/server/runner_projection_http_test.zig
@@ -376,3 +376,62 @@ test "runner projection: a final run among many envelopes is placed in one pass,
     // 8x the envelopes: within 24x the time (or 20 ms), not 64x
     try std.testing.expect(ns[1] <= 20 * std.time.ns_per_ms or ns[1] <= 24 * ns[0]);
 }
+
+test "runner projection: a final cut inside a multibyte blank or code point is never mapped, on either side" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const cases = [_][2][]const u8{ // raw, final; no blank takes four bytes: U+1F600 stands in at that width
+        .{ "\xc2\xa0", "\xa0" },               .{ "\xc2\xa0", "\xc2" }, // T5's NBSP case, and its other side
+        .{ "\u{3000}", "\x80\x80" },           .{ "\u{3000}", "\xe3\x80" },
+        .{ "\u{1f600}", "\x98\x80" },          .{ "\u{1f600}", "\xf0\x9f" },
+        .{ "\u{3000}x\u{3000}", "\x80x\xe3" }, .{ "x\u{a0}", "x\xc2" },
+        .{ "\u{a0}x", "\xa0x" },
+    };
+    for (cases) |c| try std.testing.expectEqual(@as(?projection.Map, null), try projection.mapOf(a, c[0], c[1], ""));
+    try std.testing.expectEqual(@as(?projection.Map, .{ .raw = 7, .lead = 3, .kept = 1 }), try projection.mapOf(a, "\u{3000}x\u{3000}", "x", ""));
+}
+
+/// T5's slice-based reference (T5-PROJECTION-R4-REVIEW.md): each candidate's prefix and suffix checked afresh.
+fn refDeleted(raw: []const u8, envs: []const @import("tool_parse.zig").Envelope, from: usize, to: usize) bool {
+    var p = from;
+    for (envs) |e| {
+        if (e.end <= p or e.start >= to) continue;
+        if (e.start < p or e.end > to or !e.complete) return false;
+        if (@import("reply_text.zig").pyStrip(raw[p..e.start]).len > 0) return false;
+        p = e.end;
+    }
+    return @import("reply_text.zig").pyStrip(raw[p..to]).len == 0;
+}
+
+fn refMap(a: Allocator, raw: []const u8, final: []const u8, open: []const u8) !?projection.Map {
+    if (!std.unicode.utf8ValidateSlice(raw)) return null;
+    const body = if (open.len > 0 and std.mem.startsWith(u8, raw, open)) open.len else 0;
+    const envs = try @import("tool_parse.zig").envelopes(a, raw);
+    if (final.len == 0) return if (refDeleted(raw, envs, body, raw.len)) .{ .raw = raw.len, .lead = raw.len, .kept = 0 } else null;
+    var found: ?projection.Map = null;
+    var from = body;
+    while (std.mem.indexOfPos(u8, raw, from, final)) |lead| : (from = lead + 1) {
+        if (!refDeleted(raw, envs, body, lead) or !refDeleted(raw, envs, lead + final.len, raw.len)) continue;
+        if (found != null) return null;
+        found = .{ .raw = raw.len, .lead = lead, .kept = final.len };
+    }
+    return found;
+}
+
+test "runner projection: the one-pass map equals the slice reference over blanks, envelopes and split code points" {
+    const pieces = [_][]const u8{ " ", "x", "y", "<think>", "<tool_call>f</tool_call>", "<\u{ff5c}DSML\u{ff5c}tool_calls>", "\u{2003}", "\u{a0}", "\u{3000}", "\u{1f600}" };
+    var checked: usize = 0;
+    for (pieces) |x| for (pieces) |y| for (pieces) |z| {
+        var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+        defer arena.deinit();
+        const a = arena.allocator();
+        const raw = try std.mem.concat(a, u8, &.{ x, y, z });
+        const finals = [_][]const u8{ "", raw, @import("reply_text.zig").pyStrip(raw), "x", "y", "f", x, y, z, raw[x.len..], raw[1..], raw[0 .. raw.len - 1] };
+        for (finals) |final| for ([_][]const u8{ "", "<think>" }) |open| {
+            try std.testing.expectEqualDeep(try refMap(a, raw, final, open), try projection.mapOf(a, raw, final, open));
+            checked += 1;
+        };
+    };
+    try std.testing.expectEqual(10 * 10 * 10 * 12 * 2, checked);
+}
