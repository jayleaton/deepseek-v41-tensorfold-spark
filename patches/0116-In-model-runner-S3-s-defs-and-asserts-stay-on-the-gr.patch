From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Mon, 2 Nov 2026 17:44:43 +0700
Subject: [PATCH 116/207] In-model runner: S3's defs and asserts stay on the
 graph route like its lists (calc and ELF keep T2's pinned ELF steps)

---
 zig/src/core/runner_frontend_integer_ast.zig    | 1 +
 zig/src/core/runner_frontend_integer_python.zig | 7 ++++---
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/zig/src/core/runner_frontend_integer_ast.zig b/zig/src/core/runner_frontend_integer_ast.zig
index 40f744cf179174d9aa5d85fc876082f9beb1edd8..a7f126cb802ed3d3c269ec3fda4508e9409a6709 100644
--- a/zig/src/core/runner_frontend_integer_ast.zig
+++ b/zig/src/core/runner_frontend_integer_ast.zig
@@ -42,6 +42,7 @@ pub const Parser = struct {
     module_count: usize = 0, // the module's names: bindings[0..module_count] outside any frame or comprehension
     allow_lists: bool = false, // the whole-script lowering's lists and min/max; every other parser keeps its grammar
     listed: bool = false, // a list or min/max parsed: the graph route's script only (calc and ELF keep their own)
+    asserted: bool = false, // an `assert` proved: like a def or a list, the graph route's script only
 
     /// `def name(params): return <expr>`, inlined at each call; `body` borrows the script.
     pub const Function = struct { name: []const u8, params: [4][]const u8 = undefined, arity: usize = 0, body: []const u8 };
diff --git a/zig/src/core/runner_frontend_integer_python.zig b/zig/src/core/runner_frontend_integer_python.zig
index 6b8fe410065eb9a5cb450cef4c131d1d6e287eb8..3a18b663209f10759ce1579d3f8697ca23b9f418 100644
--- a/zig/src/core/runner_frontend_integer_python.zig
+++ b/zig/src/core/runner_frontend_integer_python.zig
@@ -32,8 +32,8 @@ fn checked(a: Allocator, code: []const u8, budget: usize) Failure!integer.Lowere
     const endings = script.endings[0..script.count];
     var t = integer.table(parser, roots, endings, null, null);
     @memcpy(t.brackets[0..script.count], script.brackets[0..script.count]);
-    // lists, or more than the C runtime's eight outputs: only the graph route's table (calc and ELF keep their routes)
-    if (parser.listed or script.count > 8) {
+    // lists, defs, asserts or over eight outputs: only the graph route's table (calc and ELF keep their routes)
+    if (parser.listed or parser.function_count != 0 or parser.asserted or script.count > 8) {
         if (budget != 0) return error.Unsupported;
         return .{ .source = try a.alloc(u8, 0), .estimated_steps = null, .table = t, .graph_only = true };
     }
@@ -44,7 +44,7 @@ fn checked(a: Allocator, code: []const u8, budget: usize) Failure!integer.Lowere
 // Shares whole-script validation with the RV32 path, including unused assignments and import gates.
 pub fn lowerCalc(a: Allocator, code: []const u8) Allocator.Error!?[]u8 {
     var script = parseScript(code) catch return null;
-    if (script.parser.listed) return null;
+    if (script.parser.listed or script.parser.function_count != 0 or script.parser.asserted) return null;
     return @import("runner_frontend_integer_calc.zig").lower(a, &script.parser, script.root);
 }
 
@@ -229,6 +229,7 @@ fn check(parser: *ast.Parser, text: []const u8) ast.Invalid!void {
     const root = try expression(parser, text);
     if (!parser.boolean(root) or parser.nodes[root].value == 0) return error.Unsupported;
     parser.reset(m); // its nodes only proved it: they never print
+    parser.asserted = true;
 
 }
 
