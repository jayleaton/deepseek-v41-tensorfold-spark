diff --git a/zig/src/core/runner_frontend.zig b/zig/src/core/runner_frontend.zig
new file mode 100644
index 0000000000000000000000000000000000000000..fb146a06845564e446586da6d185eb995f539540
--- /dev/null
+++ b/zig/src/core/runner_frontend.zig
@@ -0,0 +1,78 @@
+const std = @import("std");
+const api = @import("runner_api.zig");
+const calc = @import("runner_frontend_calc.zig");
+const program = @import("runner_frontend_program.zig");
+
+pub const Frontend = api.Frontend;
+pub const Cell = api.Cell;
+pub const Translation = api.Translation;
+pub const Context = struct {
+    io: std.Io,
+    compiler: program.Config = .{ .clang = "/usr/bin/clang" },
+    exact_python: bool = false,
+
+    pub fn frontend(self: *Context) Frontend {
+        return .{ .ctx = self, .translate = translate };
+    }
+};
+
+pub fn frontend() Frontend {
+    return .{ .translate = translate };
+}
+
+// Exact decimal and rational expressions use an explicit language until Python output can be preserved exactly.
+fn language(lang: []const u8) enum { python, exact, c, unsupported } {
+    if (std.mem.eql(u8, lang, "python") or std.mem.eql(u8, lang, "python3") or std.mem.eql(u8, lang, "py"))
+        return .python;
+    if (std.mem.eql(u8, lang, "calc") or std.mem.eql(u8, lang, "exact")) return .exact;
+    if (std.mem.eql(u8, lang, "c")) return .c;
+    return .unsupported;
+}
+
+fn translate(raw: ?*anyopaque, a: std.mem.Allocator, cell: Cell) std.mem.Allocator.Error!Translation {
+    const context: ?*Context = if (raw) |ptr| @ptrCast(@alignCast(ptr)) else null;
+    const lang = language(cell.lang);
+    if (lang == .unsupported) return .{ .abstain = .language };
+    if (cell.prior.len != 0) return .{ .abstain = .unsupported };
+    if (cell.code.len > 4096) return .{ .abstain = .too_long };
+    if (lang == .python or lang == .exact) {
+        // Python true division and floats differ from firmware exact arithmetic in both value and print format.
+        const exact_only = std.mem.indexOfScalar(u8, cell.code, '.') != null or
+            containsDivision(cell.code) or std.mem.indexOf(u8, cell.code, "gcd") != null;
+        if (lang == .python and exact_only and (context == null or !context.?.exact_python)) return .{ .abstain = .unsupported };
+        if (try calc.lower(a, cell.code)) |bytes| return .{ .program = .{ .kind = .calc, .bytes = bytes } };
+    }
+    if (lang == .exact or cell.form == .inline_expr) return .{ .abstain = .unsupported };
+    var source: []const u8 = cell.code;
+    var owned: ?[]u8 = null;
+    defer if (owned) |bytes| a.free(bytes);
+    if (lang == .python) {
+        const body = try program.lowerPython(a, cell.code) orelse return .{ .abstain = .unsupported };
+        defer a.free(body);
+        owned = try program.wrapBody(a, body);
+        source = owned.?;
+    } else if (!program.compiler.hasMain(source)) {
+        owned = try program.wrapBody(a, source);
+        source = owned.?;
+    }
+    const bytes = if (context) |ctx|
+        try program.compile(a, ctx.io, source, ctx.compiler)
+    else blk: {
+        var threaded = std.Io.Threaded.init(a, .{});
+        defer threaded.deinit();
+        break :blk try program.compile(a, threaded.io(), source, .{ .clang = "/usr/bin/clang" });
+    };
+    if (bytes) |elf| return .{ .program = .{ .kind = .elf, .bytes = elf } };
+    return .{ .abstain = .unsupported };
+}
+
+fn containsDivision(code: []const u8) bool {
+    var i: usize = 0;
+    while (i < code.len) : (i += 1) {
+        if (code[i] == '/') {
+            if (i + 1 == code.len or code[i + 1] != '/') return true;
+            i += 1;
+        }
+    }
+    return false;
+}
diff --git a/zig/src/core/runner_frontend_calc.zig b/zig/src/core/runner_frontend_calc.zig
new file mode 100644
index 0000000000000000000000000000000000000000..48375330da4dadc57f6a01a0085258ec8651c9dc
--- /dev/null
+++ b/zig/src/core/runner_frontend_calc.zig
@@ -0,0 +1,166 @@
+const std = @import("std");
+
+pub const max_input = 255;
+pub const max_digits = 62;
+
+// Returns firmware input, never a host-computed result; null leaves the model's continuation untouched.
+pub fn lower(allocator: std.mem.Allocator, source: []const u8) !?[]u8 {
+    var code = std.mem.trim(u8, source, " \t\r\n");
+    if (std.mem.startsWith(u8, code, ">>> ")) code = std.mem.trim(u8, code[4..], " \t\r\n");
+    if (std.mem.startsWith(u8, code, "print")) {
+        const call = std.mem.trimStart(u8, code[5..], " \t");
+        if (call.len < 3 or call[0] != '(' or call[call.len - 1] != ')') return null;
+        code = call[1 .. call.len - 1];
+    }
+    if (code.len == 0 or code.len > 4096) return null;
+    var parser: Parser = .{ .source = code };
+    parser.expression(0) catch return null;
+    parser.space();
+    if (parser.pos != code.len or parser.len == 0) return null;
+    if (parser.numbers > (if (parser.rational) @as(usize, 4) else 6)) return null;
+    if (!@import("runner_frontend_value.zig").valid(parser.output[0..parser.len])) return null;
+    return try allocator.dupe(u8, parser.output[0..parser.len]);
+}
+
+const Invalid = error{Unsupported};
+const Parser = struct {
+    source: []const u8,
+    pos: usize = 0,
+    output: [max_input]u8 = undefined,
+    len: usize = 0,
+    atoms: usize = 0,
+    numbers: usize = 0,
+    rational: bool = false,
+    decimal: bool = false,
+    integer_only: bool = false,
+
+    fn space(self: *Parser) void {
+        while (self.pos < self.source.len and (self.source[self.pos] == ' ' or self.source[self.pos] == '\t'))
+            self.pos += 1;
+    }
+
+    fn emit(self: *Parser, bytes: []const u8) Invalid!void {
+        if (self.len + bytes.len > max_input) return error.Unsupported;
+        @memcpy(self.output[self.len..][0..bytes.len], bytes);
+        self.len += bytes.len;
+    }
+
+    fn take(self: *Parser, token: []const u8) Invalid!bool {
+        self.space();
+        if (!std.mem.startsWith(u8, self.source[self.pos..], token)) return false;
+        self.pos += token.len;
+        try self.emit(token);
+        return true;
+    }
+
+    fn expression(self: *Parser, depth: usize) Invalid!void {
+        if (depth > 6) return error.Unsupported;
+        try self.term(depth);
+        while (true) {
+            if (try self.take("+") or try self.take("-")) try self.term(depth) else break;
+        }
+        if (self.decimal and self.integer_only) return error.Unsupported;
+    }
+
+    fn term(self: *Parser, depth: usize) Invalid!void {
+        try self.factor(depth);
+        while (true) {
+            self.space();
+            const rest = self.source[self.pos..];
+            if (std.mem.startsWith(u8, rest, "**")) return error.Unsupported;
+            if (try self.take("//") or try self.take("%")) {
+                self.integer_only = true;
+            } else if (try self.take("/")) {
+                self.integer_only = true;
+                self.rational = true;
+            } else if (!try self.take("*")) break;
+            try self.factor(depth);
+        }
+    }
+
+    fn factor(self: *Parser, depth: usize) Invalid!void {
+        if (depth > 6) return error.Unsupported;
+        if (try self.take("+") or try self.take("-")) return self.factor(depth + 1);
+        try self.atom(depth);
+        if (try self.take("**")) {
+            self.integer_only = true;
+            try self.factor(depth + 1);
+        }
+    }
+
+    fn atom(self: *Parser, depth: usize) Invalid!void {
+        self.space();
+        self.atoms += 1;
+        if (self.atoms > 12) return error.Unsupported;
+        if (try self.take("gcd")) {
+            if (!try self.take("(")) return error.Unsupported;
+            self.integer_only = true;
+            try self.expression(depth + 1);
+            if (!try self.take(",")) return error.Unsupported;
+            try self.expression(depth + 1);
+            if (!try self.take(")")) return error.Unsupported;
+        } else if (try self.take("(")) {
+            try self.expression(depth + 1);
+            if (!try self.take(")")) return error.Unsupported;
+        } else {
+            const start = self.pos;
+            var digits: usize = 0;
+            while (self.pos < self.source.len and std.ascii.isDigit(self.source[self.pos])) : (self.pos += 1)
+                digits += 1;
+            if (digits == 0) return error.Unsupported;
+            if (self.pos - start > 1 and self.source[start] == '0') return error.Unsupported;
+            if (self.pos < self.source.len and self.source[self.pos] == '.') {
+                self.decimal = true;
+                self.pos += 1;
+                const fractional = self.pos;
+                while (self.pos < self.source.len and std.ascii.isDigit(self.source[self.pos])) : (self.pos += 1)
+                    digits += 1;
+                if (fractional == self.pos) return error.Unsupported;
+            }
+            if (digits > max_digits) return error.Unsupported;
+            self.numbers += 1;
+            try self.emit(self.source[start..self.pos]);
+        }
+    }
+};
+
+test "model arithmetic becomes calc firmware input" {
+    const cases = [_][2][]const u8{
+        .{ "print(123456789012345678901234567890 * 987654321098765432109876543210)", "123456789012345678901234567890*987654321098765432109876543210" },
+        .{ ">>> 2**100\n", "2**100" },
+        .{ "print((1/3 + 2/3))", "(1/3+2/3)" },
+        .{ "gcd (48, 18)", "gcd(48,18)" },
+        .{ "print(1.25 * 2.4)", "1.25*2.4" },
+        .{ "-2**2", "-2**2" },
+        .{ "7 // -3 % 2", "7//-3%2" },
+    };
+    for (cases) |case| {
+        const result = (try lower(std.testing.allocator, case[0])).?;
+        defer std.testing.allocator.free(result);
+        try std.testing.expectEqualStrings(case[1], result);
+    }
+}
+
+test "unsupported cells abstain instead of extracting a plausible subexpression" {
+    const cases = [_][]const u8{
+        "",            "print(x*y)",       "import os",          "print(2); print(3)",                                              "2^100",                                       "sum(i*i for i in range(10))",
+        "print(2, 3)", "print(2, end='')", "print(2) # comment", "2\n3",                                                            ">>> 2**100\n1267650600228229401496703205376", "1e10",
+        "0x10",        "1_000",            "012",                "2***3",                                                           "gcd(1)",                                      "gcd(1,2,3)",
+        "1.2//2",      "1.2/2",            "print(2)garbage",    "123456789012345678901234567890123456789012345678901234567890123", "((((((((((((1))))))))))))",
+    };
+    for (cases) |code| try std.testing.expectEqual(@as(?[]u8, null), try lower(std.testing.allocator, code));
+}
+
+test "firmware resource limits abstain before an error could replace model text" {
+    const bad = [_][]const u8{
+        "99999999999999999999999999999999999999999999999999999999999999+0",
+        "99999999999999999999999999999999999999999999999999999999999999*0",
+        "1+(2+(3+(4+(5+(6+7)))))",
+        "(1/2)+(1/3)+(1/4)",
+    };
+    for (bad) |source| {
+        const result = try lower(std.testing.allocator, source);
+        defer if (result) |bytes| std.testing.allocator.free(bytes);
+        try std.testing.expect(result == null);
+    }
+}
diff --git a/zig/src/core/runner_frontend_program.zig b/zig/src/core/runner_frontend_program.zig
new file mode 100644
index 0000000000000000000000000000000000000000..5efb035de09db0f9a8d99875b329f9938c795230
--- /dev/null
+++ b/zig/src/core/runner_frontend_program.zig
@@ -0,0 +1,184 @@
+//! Bounded Python loop lowering; accepted integer operations are exact in RV32 signed C arithmetic.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const Expr = @import("runner_frontend_program_expr.zig");
+pub const compiler = @import("runner_frontend_program_compile.zig");
+pub const Config = compiler.Config;
+pub const compile = compiler.compile;
+pub const wrapBody = compiler.wrapBody;
+
+const Range = struct { start: i64, stop: i64, step: i64, count: i64, bounds: Expr.Bounds };
+const Invalid = error{Unsupported};
+
+/// Returns an owned C main body, or abstains; this function neither compiles nor executes the source.
+pub fn lowerPython(a: Allocator, code: []const u8) Allocator.Error!?[]u8 {
+    return lower(a, code) catch |err| switch (err) {
+        error.Unsupported => null,
+        error.OutOfMemory => error.OutOfMemory,
+    };
+}
+
+fn lower(a: Allocator, code: []const u8) (Allocator.Error || Invalid)![]u8 {
+    if (code.len > 4096 or std.mem.indexOfScalar(u8, code, '\r') != null) return error.Unsupported;
+    const src = std.mem.trim(u8, code, "\n");
+    if (src.len == 0 or src[0] == ' ' or src[0] == '\t') return error.Unsupported;
+    var p: Expr.Parser = .{ .src = src };
+    var initial: i64 = 0;
+    var range: Range = undefined;
+    var root: usize = undefined;
+    if (std.mem.indexOfScalar(u8, src, '\n') == null) {
+        const printed = p.eat("print");
+        if (printed) try p.need("(");
+        try p.need("sum");
+        try p.need("(");
+        root = try p.expression();
+        try p.need("for");
+        const variable = try p.identifier();
+        if (!validName(variable)) return error.Unsupported;
+        try p.need("in");
+        range = try parseRange(&p);
+        try p.need(")");
+        if (printed) try p.need(")");
+        try p.end();
+        try p.bind(variable, range.bounds);
+    } else {
+        var lines = std.mem.splitScalar(u8, src, '\n');
+        const init_line = lines.next() orelse return error.Unsupported;
+        const for_line = lines.next() orelse return error.Unsupported;
+        const body_line = lines.next() orelse return error.Unsupported;
+        const print_line = lines.next() orelse return error.Unsupported;
+        if (lines.next() != null) return error.Unsupported;
+        var init: Expr.Parser = .{ .src = init_line };
+        const accumulator = try init.identifier();
+        if (!validName(accumulator)) return error.Unsupported;
+        try init.need("=");
+        initial = try init.integer();
+        if (!Expr.fits(initial)) return error.Unsupported;
+        try init.end();
+        var header: Expr.Parser = .{ .src = for_line };
+        try header.need("for");
+        const variable = try header.identifier();
+        if (!validName(variable) or std.mem.eql(u8, variable, accumulator)) return error.Unsupported;
+        try header.need("in");
+        range = try parseRange(&header);
+        try header.need(":");
+        try header.end();
+        if (!std.mem.startsWith(u8, body_line, "    ") or
+            (for_line.len > 0 and for_line[0] == ' ') or
+            (print_line.len > 0 and print_line[0] == ' ')) return error.Unsupported;
+        p = .{ .src = body_line[4..] };
+        const target = try p.identifier();
+        if (!std.mem.eql(u8, accumulator, target)) return error.Unsupported;
+        if (!p.eat("+=")) {
+            try p.need("=");
+            const previous = try p.identifier();
+            if (!std.mem.eql(u8, previous, accumulator)) return error.Unsupported;
+            try p.need("+");
+        }
+        root = try p.expression();
+        try p.end();
+        try p.bind(variable, range.bounds);
+        var output: Expr.Parser = .{ .src = print_line };
+        try output.need("print");
+        try output.need("(");
+        const value = try output.identifier();
+        if (!std.mem.eql(u8, value, accumulator)) return error.Unsupported;
+        try output.need(")");
+        try output.end();
+    }
+    const bounds = try p.bounds(root);
+    if (!Expr.fits(initial + range.count * @min(bounds.lo, 0)) or
+        !Expr.fits(initial + range.count * @max(bounds.hi, 0))) return error.Unsupported;
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(a);
+    try out.print(a, "int tf_acc = {d};\nfor (int tf_i = {d}; tf_i {s} {d}; tf_i += {d}) {{\n", .{
+        initial, range.start, if (range.step > 0) "<" else ">", range.stop, range.step,
+    });
+    try p.emit(a, &out);
+    try out.print(a, "tf_acc += tf_e{d};\n}}\ntf_print_int(tf_acc);\nreturn 0;\n", .{root});
+    return out.toOwnedSlice(a);
+}
+
+fn validName(s: []const u8) bool {
+    const reserved = [_][]const u8{
+        "print", "sum",    "range",  "for",      "in",     "True",      "False",   "None",  "and",   "or",       "not",
+        "if",    "else",   "def",    "class",    "import", "from",      "return",  "while", "break", "continue", "pass",
+        "yield", "lambda", "global", "nonlocal", "try",    "except",    "finally", "with",  "as",    "assert",   "del",
+        "raise", "is",     "async",  "await",    "elif",   "__debug__",
+    };
+    for (reserved) |name| if (std.mem.eql(u8, name, s)) return false;
+    return true;
+}
+
+fn parseRange(p: *Expr.Parser) Invalid!Range {
+    try p.need("range");
+    try p.need("(");
+    const first = try p.integer();
+    var start: i64 = 0;
+    var stop = first;
+    var step: i64 = 1;
+    if (p.eat(",")) {
+        start = first;
+        stop = try p.integer();
+        if (p.eat(",")) step = try p.integer();
+    }
+    try p.need(")");
+    if (@abs(start) > 1000000 or @abs(stop) > 1000000 or @abs(step) > 1000000 or step == 0)
+        return error.Unsupported;
+    const distance = if (step > 0) stop - start else start - stop;
+    const stride: i64 = @intCast(@abs(step));
+    const count = if (distance <= 0) 0 else @divTrunc(distance + stride - 1, stride);
+    if (count > 10000) return error.Unsupported;
+    const last = if (count == 0) start else start + (count - 1) * step;
+    return .{
+        .start = start,
+        .stop = stop,
+        .step = step,
+        .count = count,
+        .bounds = .{ .lo = @min(start, last), .hi = @max(start, last) },
+    };
+}
+
+test "sum squares 285 is lowered as circuit loop operations" {
+    const a = std.testing.allocator;
+    const body = (try lowerPython(a, "print(sum(i*i for i in range(10)))")).?;
+    defer a.free(body);
+    try std.testing.expect(std.mem.indexOf(u8, body, "tf_i < 10") != null);
+    try std.testing.expect(std.mem.indexOf(u8, body, "tf_e0 * tf_e1") != null);
+    try std.testing.expect(std.mem.indexOf(u8, body, "tf_acc += tf_e2") != null);
+    try std.testing.expect(std.mem.indexOf(u8, body, "285") == null);
+}
+
+test "accumulator and descending stepped ranges" {
+    const a = std.testing.allocator;
+    const body = (try lowerPython(a, "total = 0\nfor i in range(10):\n    total += i**2\nprint(total)")).?;
+    defer a.free(body);
+    try std.testing.expect(std.mem.indexOf(u8, body, "tf_i < 10") != null);
+    const assigned = (try lowerPython(a, "total = 0\nfor i in range(10):\n    total = total + i*i\nprint(total)")).?;
+    defer a.free(assigned);
+    try std.testing.expect(std.mem.indexOf(u8, assigned, "tf_acc += tf_e2") != null);
+    const descending = (try lowerPython(a, "sum(x*x for x in range(9, -1, -1))")).?;
+    defer a.free(descending);
+    try std.testing.expect(std.mem.indexOf(u8, descending, "tf_i > -1; tf_i += -1") != null);
+}
+
+test "unsupported code and unsafe Python integer operations abstain" {
+    const bad = [_][]const u8{
+        "print(sum(j*j for i in range(10)))",
+        "print(sum(i/i for i in range(10)))",
+        "print(sum(i//2 for i in range(10)))",
+        "print(sum(i**32 for i in range(10)))",
+        "print(sum(i*i for i in range(100000)))",
+        "print(sum(i*i for i in range(10000)))",
+        "print(sum(i for i in range(10, 0, 0)))",
+        "print(sum(i for i in range(n)))",
+        "print(sum(i for i in range(10) if i))",
+        "print(sum(i for i in range(10))); print(2)",
+        "import os\nprint(os.getpid())",
+        "t = 0\nfor i in range(10):\n    t += unknown\nprint(t)",
+        "t = 2147483647\nfor i in range(1):\n    t += 1\nprint(t)",
+        "t = 0\nfor i in range(10):\n    t += t + i\nprint(t)",
+        "t = 0\nfor i in range(10):\n    t += i\n    print(t)",
+    };
+    for (bad) |src| try std.testing.expectEqual(@as(?[]u8, null), try lowerPython(std.testing.allocator, src));
+}
diff --git a/zig/src/core/runner_frontend_program_compile.zig b/zig/src/core/runner_frontend_program_compile.zig
new file mode 100644
index 0000000000000000000000000000000000000000..0a2754b4f7a3afe3f6319307670a0e34a8e4d41c
--- /dev/null
+++ b/zig/src/core/runner_frontend_program_compile.zig
@@ -0,0 +1,331 @@
+//! Freestanding RV32 compilation; the host compiles source but never executes the resulting program.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+pub const Config = struct {
+    clang: []const u8 = "/usr/bin/clang",
+    linker: ?[]const u8 = null,
+    scratch_root: []const u8 = "/tmp",
+};
+
+pub const linker_script =
+    \\ENTRY(_start)
+    \\MEMORY {
+    \\ RAM (rw) : ORIGIN = 0x100, LENGTH = 0x7f00
+    \\ DROM (r) : ORIGIN = 0x20000, LENGTH = 128K
+    \\ ROM (rx) : ORIGIN = 0x40000, LENGTH = 256K
+    \\}
+    \\PHDRS { text PT_LOAD FLAGS(5); rodata PT_LOAD FLAGS(4); data PT_LOAD FLAGS(6); }
+    \\SECTIONS {
+    \\ .text : { *(.text.init) *(.text .text.*) } > ROM :text
+    \\ .rodata : { *(.rodata .rodata.* .srodata .srodata.*) } > DROM :rodata
+    \\ .data : { *(.data .data.* .sdata .sdata.*) } > RAM :data
+    \\ .bss : { *(.bss .bss.* .sbss .sbss.*) *(COMMON) } > RAM :data
+    \\ ASSERT(ADDR(.bss) + SIZEOF(.bss) <= 0x7000, "RAM leaves 4K stack")
+    \\ /DISCARD/ : { *(.comment) *(.eh_frame*) *(.riscv.attributes) }
+    \\}
+;
+
+const runtime =
+    \\typedef unsigned int size_t;
+    \\typedef signed char int8_t;
+    \\typedef unsigned char uint8_t;
+    \\typedef short int16_t;
+    \\typedef unsigned short uint16_t;
+    \\typedef int int32_t;
+    \\typedef unsigned int uint32_t;
+    \\typedef long long int64_t;
+    \\typedef unsigned long long uint64_t;
+    \\typedef _Bool bool;
+    \\#define true 1
+    \\#define false 0
+    \\#define NULL ((void*)0)
+    \\static unsigned int tf_output_count;
+    \\static int putchar(int c) {
+    \\ ++tf_output_count;
+    \\ register int a0 __asm__("a0") = (unsigned char)c;
+    \\ register int a7 __asm__("a7") = 1;
+    \\ __asm__ volatile("ecall" : "+r"(a0) : "r"(a7) : "memory");
+    \\ return (unsigned char)c;
+    \\}
+    \\static void tf_unsigned(unsigned int n) {
+    \\ char digits[10]; int len = 0;
+    \\ do { digits[len++] = (char)('0' + n % 10); n /= 10; } while(n);
+    \\ while(len) putchar(digits[--len]);
+    \\}
+    \\static void tf_signed(int n) {
+    \\ if(n < 0) { putchar('-'); tf_unsigned(0u - (unsigned int)n); }
+    \\ else tf_unsigned((unsigned int)n);
+    \\}
+    \\static void tf_print_int(int n) { tf_signed(n); putchar('\n'); }
+    \\static int puts(const char *s) { while(*s) putchar(*s++); putchar('\n'); return 0; }
+    \\static int printf(const char *fmt, ...) {
+    \\ unsigned int before = tf_output_count;
+    \\ __builtin_va_list args; __builtin_va_start(args, fmt);
+    \\ while(*fmt) {
+    \\  if(*fmt != '%') { putchar(*fmt++); continue; }
+    \\  ++fmt;
+    \\  if(*fmt == 'd' || *fmt == 'i') tf_signed(__builtin_va_arg(args, int));
+    \\  else if(*fmt == 'u') tf_unsigned(__builtin_va_arg(args, unsigned int));
+    \\  else if(*fmt == 'c') putchar(__builtin_va_arg(args, int));
+    \\  else if(*fmt == 's') { const char *s = __builtin_va_arg(args, const char*); while(*s) putchar(*s++); }
+    \\  else if(*fmt == '%') putchar('%');
+    \\  else { __builtin_va_end(args); return -1; }
+    \\  ++fmt;
+    \\ }
+    \\ __builtin_va_end(args); return (int)(tf_output_count - before);
+    \\}
+    \\int main(void);
+    \\__asm__(".section .text.init,\"ax\"\n.globl _start\n_start:\nli sp, 32768\ncall main\nli a7, 93\necall\n1: j 1b\n");
+;
+
+/// Wrap the checked Python body for compile(); callers own the returned source.
+pub fn wrapBody(a: Allocator, body: []const u8) Allocator.Error![]u8 {
+    return std.fmt.allocPrint(a, "int main(void) {{\n{s}}}\n", .{body});
+}
+
+/// Returns owned ELF32 bytes, or abstains on invalid source, unavailable toolchain or compilation failure.
+pub fn compile(a: Allocator, io: std.Io, source: []const u8, config: Config) Allocator.Error!?[]u8 {
+    const normalized = try normalize(a, source) orelse return null;
+    defer a.free(normalized);
+    if (!std.fs.path.isAbsolute(config.scratch_root)) return null;
+    const parent = std.Io.Dir.cwd().openDir(io, config.scratch_root, .{}) catch return null;
+    defer parent.close(io);
+    var nonce: [16]u8 = undefined;
+    var name_buf: [64]u8 = undefined;
+    var name: []const u8 = undefined;
+    var created = false;
+    for (0..8) |_| {
+        io.random(&nonce);
+        name = std.fmt.bufPrint(&name_buf, "tf-rv32-{x}", .{std.mem.readInt(u128, &nonce, .little)}) catch unreachable;
+        parent.createDir(io, name, .fromMode(0o700)) catch |err| switch (err) {
+            error.PathAlreadyExists => continue,
+            else => return null,
+        };
+        created = true;
+        break;
+    }
+    if (!created) return null;
+    defer parent.deleteTree(io, name) catch {};
+    const dir = parent.openDir(io, name, .{ .follow_symlinks = false }) catch return null;
+    defer dir.close(io);
+    const complete = try std.fmt.allocPrint(a, "{s}\n{s}\n", .{ runtime, normalized });
+    defer a.free(complete);
+    if (!write(io, dir, "program.c", complete) or !write(io, dir, "rom.ld", linker_script)) return null;
+    const path = try std.fs.path.join(a, &.{ config.scratch_root, name });
+    defer a.free(path);
+    const src = try std.fs.path.join(a, &.{ path, "program.c" });
+    defer a.free(src);
+    const elf = try std.fs.path.join(a, &.{ path, "program.elf" });
+    defer a.free(elf);
+    const link_path = try std.fs.path.join(a, &.{ path, "rom.ld" });
+    defer a.free(link_path);
+    const linker_arg = if (config.linker) |value|
+        try std.fmt.allocPrint(a, "--ld-path={s}", .{value})
+    else
+        try a.dupe(u8, "-fuse-ld=lld");
+    defer a.free(linker_arg);
+    const result = std.process.run(a, io, .{
+        .argv = &.{
+            config.clang,          "--target=riscv32-unknown-elf",    "-march=rv32im_zba", "-mabi=ilp32",
+            "-O0",                 "-ffreestanding",                  "-fno-builtin",      "-nostdinc",
+            "-nostdlib",           "-fno-stack-protector",            "-fno-pic",          "-mno-relax",
+            "-fno-unwind-tables",  "-fno-asynchronous-unwind-tables", linker_arg,          "-Wl,--no-relax",
+            "-Wl,--build-id=none", "-Wl,-T",                          link_path,           "-x",
+            "c",                   src,                               "-o",                elf,
+        },
+        .stdout_limit = .limited(4096),
+        .stderr_limit = .limited(16384),
+        .timeout = .{ .duration = .{ .raw = .fromSeconds(1), .clock = .awake } },
+    }) catch |err| switch (err) {
+        error.OutOfMemory => return error.OutOfMemory,
+        else => return null,
+    };
+    defer a.free(result.stdout);
+    defer a.free(result.stderr);
+    if (!result.term.success()) return null;
+    const bytes = dir.readFileAlloc(io, "program.elf", a, .limited(1 << 20)) catch |err| switch (err) {
+        error.OutOfMemory => return error.OutOfMemory,
+        else => return null,
+    };
+    if (!validElf(bytes)) {
+        a.free(bytes);
+        return null;
+    }
+    return bytes;
+}
+
+fn write(io: std.Io, dir: std.Io.Dir, name: []const u8, bytes: []const u8) bool {
+    const f = dir.createFile(io, name, .{ .exclusive = true, .permissions = .fromMode(0o600) }) catch return false;
+    defer f.close(io);
+    f.writeStreamingAll(io, bytes) catch return false;
+    return true;
+}
+
+fn normalize(a: Allocator, source: []const u8) Allocator.Error!?[]u8 {
+    if (source.len == 0 or source.len > 16384 or std.mem.indexOfScalar(u8, source, 0) != null) return null;
+    if (std.mem.indexOf(u8, source, "\\\n") != null or std.mem.indexOf(u8, source, "\\\r\n") != null) return null;
+    var out: std.ArrayList(u8) = .empty;
+    defer out.deinit(a);
+    var lines = std.mem.splitScalar(u8, source, '\n');
+    while (lines.next()) |line| {
+        const trimmed = std.mem.trim(u8, line, " \t\r");
+        if (std.mem.startsWith(u8, trimmed, "#include")) {
+            const header = std.mem.trim(u8, trimmed[8..], " \t");
+            const allowed = [_][]const u8{ "<stdio.h>", "<stdint.h>", "<stddef.h>", "<stdbool.h>" };
+            var ok = false;
+            for (allowed) |include| {
+                if (std.mem.eql(u8, header, include)) ok = true;
+            }
+            if (!ok) return null;
+            continue;
+        }
+        if (std.mem.indexOfScalar(u8, line, '#') != null) return null;
+        try out.appendSlice(a, line);
+        try out.append(a, '\n');
+    }
+    const forbidden = [_][]const u8{ "__", "asm", "_Pragma", "??", "%:", "\\\n", "\\\r" };
+    for (forbidden) |token| if (std.mem.indexOf(u8, out.items, token) != null) return null;
+    if (!safeFormats(out.items)) return null;
+    return try out.toOwnedSlice(a);
+}
+
+pub fn validElf(b: []const u8) bool {
+    if (b.len < 52 or !std.mem.eql(u8, b[0..4], "\x7fELF") or b[4] != 1 or b[5] != 1 or b[6] != 1)
+        return false;
+    if (read(u16, b, 16) != 2 or read(u16, b, 18) != 243 or read(u32, b, 20) != 1 or
+        read(u16, b, 40) != 52 or read(u16, b, 42) != 32 or read(u32, b, 36) != 0) return false;
+    const entry = read(u32, b, 24);
+    if (entry < 0x40000 or entry >= 0x80000 or entry % 4 != 0) return false;
+    const off: usize = read(u32, b, 28);
+    const count: usize = read(u16, b, 44);
+    if (count == 0 or count > 16 or off > b.len or count * 32 > b.len - off) return false;
+    var entry_loaded = false;
+    for (0..count) |i| {
+        const ph = off + 32 * i;
+        const kind = read(u32, b, ph);
+        if (kind == 2 or kind == 3 or kind == 7) return false;
+        if (kind != 1) continue;
+        const start: u64 = read(u32, b, ph + 8);
+        const file_off: usize = read(u32, b, ph + 4);
+        const file_size: usize = read(u32, b, ph + 16);
+        const size: u64 = read(u32, b, ph + 20);
+        const flags = read(u32, b, ph + 24);
+        if (size == 0) continue;
+        if (file_size > size or file_off > b.len or file_size > b.len - file_off) return false;
+        const end = start + size;
+        const ram = start >= 0x100 and end <= 0x7000 and flags & 1 == 0;
+        const drom = start >= 0x20000 and end <= 0x40000 and flags & 3 == 0;
+        const rom = start >= 0x40000 and end <= 0x80000 and flags & 2 == 0;
+        if (!ram and !drom and !rom) return false;
+        if (rom and flags & 1 != 0 and entry >= start and entry < start + file_size) entry_loaded = true;
+    }
+    return entry_loaded;
+}
+
+fn read(comptime T: type, b: []const u8, off: usize) T {
+    return std.mem.readInt(T, b[off..][0..@sizeOf(T)], .little);
+}
+
+test "missing toolchain abstains" {
+    try std.testing.expectEqual(@as(?[]u8, null), try compile(std.testing.allocator, std.testing.io, "int main(void) { return 0; }", .{ .clang = "/nonexistent-tensorfold-clang" }));
+}
+
+test "source cannot access host includes or inject assembly" {
+    const bad = [_][]const u8{ "#include </etc/passwd>", "#define X 1", "asm(\".incbin x\");", "_Pragma(\"x\")", "int x = __FILE__;", "%:include </etc/passwd>", "pri\\\nntf(\"%f\", 1.0);" };
+    for (bad) |s| try std.testing.expectEqual(@as(?[]u8, null), try normalize(std.testing.allocator, s));
+    try std.testing.expect(!validElf("not an ELF"));
+}
+
+fn safeFormats(s: []const u8) bool {
+    var i: usize = 0;
+    while (i < s.len) {
+        if (std.mem.startsWith(u8, s[i..], "//")) {
+            while (i < s.len and s[i] != '\n') i += 1;
+            continue;
+        }
+        if (s[i] == '/' and i + 1 < s.len and s[i + 1] == '*') {
+            const end = std.mem.indexOf(u8, s[i + 2 ..], "*/") orelse return false;
+            i += end + 4;
+            continue;
+        }
+        if (s[i] == '"' or s[i] == '\'') {
+            const quote = s[i];
+            i += 1;
+            while (i < s.len and s[i] != quote) : (i += 1) {
+                if (s[i] == '\\') i += 1;
+            }
+            if (i >= s.len) return false;
+            i += 1;
+            continue;
+        }
+        if (std.ascii.isAlphabetic(s[i]) or s[i] == '_') {
+            const start = i;
+            while (i < s.len and (std.ascii.isAlphanumeric(s[i]) or s[i] == '_')) i += 1;
+            if (!std.mem.eql(u8, s[start..i], "printf")) continue;
+            skipSpace(s, &i);
+            if (i == s.len or s[i] != '(') return false;
+            i += 1;
+            skipSpace(s, &i);
+            if (i == s.len or s[i] != '"') return false;
+            i += 1;
+            while (i < s.len and s[i] != '"') : (i += 1) {
+                if (s[i] == '\\') {
+                    i += 1;
+                    if (i == s.len or std.mem.indexOfScalar(u8, "nrtvabf\\\"?", s[i]) == null) return false;
+                } else if (s[i] == '%') {
+                    i += 1;
+                    if (i == s.len or std.mem.indexOfScalar(u8, "diucs%", s[i]) == null) return false;
+                }
+            }
+            if (i == s.len) return false;
+            i += 1;
+            skipSpace(s, &i);
+            if (i == s.len or (s[i] != ',' and s[i] != ')')) return false;
+            continue;
+        }
+        i += 1;
+    }
+    return true;
+}
+
+fn skipSpace(s: []const u8, i: *usize) void {
+    while (i.* < s.len and std.ascii.isWhitespace(s[i.*])) i.* += 1;
+}
+
+test "printf admits literal integer formats and refuses formats the runtime cannot reproduce" {
+    try std.testing.expect(safeFormats("printf(\"%d %u %c %s %%\\n\", 1, 2u, 'c', \"text\");"));
+    const bad = [_][]const u8{
+        "printf(\"%f\", 1.0);", "printf(\"%ld\", 1L);",     "printf(\"%04d\", 1);",
+        "printf(fmt, 1);",      "printf(\"\\x25f\", 1.0);", "printf(\"%\" \"f\", 1.0);",
+        "void *p = printf;",
+    };
+    for (bad) |s| try std.testing.expect(!safeFormats(s));
+}
+
+pub fn hasMain(s: []const u8) bool {
+    var i: usize = 0;
+    while (i < s.len) {
+        if (std.mem.startsWith(u8, s[i..], "//")) {
+            while (i < s.len and s[i] != '\n') i += 1;
+        } else if (s[i] == '/' and i + 1 < s.len and s[i + 1] == '*') {
+            const end = std.mem.indexOf(u8, s[i + 2 ..], "*/") orelse return false;
+            i += end + 4;
+        } else if (s[i] == '"' or s[i] == '\'') {
+            const quote = s[i];
+            i += 1;
+            while (i < s.len and s[i] != quote) : (i += 1) {
+                if (s[i] == '\\') i += 1;
+            }
+            if (i < s.len) i += 1;
+        } else if (std.ascii.isAlphabetic(s[i]) or s[i] == '_') {
+            const start = i;
+            while (i < s.len and (std.ascii.isAlphanumeric(s[i]) or s[i] == '_')) i += 1;
+            if (std.mem.eql(u8, s[start..i], "main")) {
+                skipSpace(s, &i);
+                if (i < s.len and s[i] == '(') return true;
+            }
+        } else i += 1;
+    }
+    return false;
+}
diff --git a/zig/src/core/runner_frontend_program_expr.zig b/zig/src/core/runner_frontend_program_expr.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8165b9504cc4011bf34a8a6fcc12b1bfb27e9d10
--- /dev/null
+++ b/zig/src/core/runner_frontend_program_expr.zig
@@ -0,0 +1,235 @@
+//! Small integer expression grammar with interval proofs for every emitted C intermediate.
+const std = @import("std");
+const Invalid = error{Unsupported};
+pub const Bounds = struct { lo: i64, hi: i64 };
+const Op = enum { literal, variable, add, sub, mul, neg, power };
+const Node = struct { op: Op, lhs: usize = 0, rhs: usize = 0, value: i64 = 0, name: []const u8 = "" };
+
+pub fn fits(n: i64) bool {
+    return n >= std.math.minInt(i32) and n <= std.math.maxInt(i32);
+}
+
+pub const Parser = struct {
+    src: []const u8,
+    pos: usize = 0,
+    nodes: [128]Node = undefined,
+    len: usize = 0,
+    depth: usize = 0,
+    variable_bounds: Bounds = .{ .lo = 0, .hi = 0 },
+
+    fn space(p: *Parser) void {
+        while (p.pos < p.src.len and p.src[p.pos] == ' ') p.pos += 1;
+    }
+
+    pub fn eat(p: *Parser, token: []const u8) bool {
+        p.space();
+        if (!std.mem.startsWith(u8, p.src[p.pos..], token)) return false;
+        const end_pos = p.pos + token.len;
+        if (nameChar(token[token.len - 1]) and end_pos < p.src.len and nameChar(p.src[end_pos])) return false;
+        p.pos = end_pos;
+        return true;
+    }
+
+    pub fn need(p: *Parser, token: []const u8) Invalid!void {
+        if (!p.eat(token)) return error.Unsupported;
+    }
+
+    pub fn end(p: *Parser) Invalid!void {
+        p.space();
+        if (p.pos != p.src.len) return error.Unsupported;
+    }
+
+    pub fn identifier(p: *Parser) Invalid![]const u8 {
+        p.space();
+        const start = p.pos;
+        if (start == p.src.len or !(std.ascii.isAlphabetic(p.src[start]) or p.src[start] == '_'))
+            return error.Unsupported;
+        while (p.pos < p.src.len and nameChar(p.src[p.pos])) p.pos += 1;
+        return p.src[start..p.pos];
+    }
+
+    pub fn integer(p: *Parser) Invalid!i64 {
+        const negative = p.eat("-");
+        if (!negative) _ = p.eat("+");
+        p.space();
+        const start = p.pos;
+        while (p.pos < p.src.len and std.ascii.isDigit(p.src[p.pos])) p.pos += 1;
+        if (p.pos == start or (p.pos - start > 1 and p.src[start] == '0') or
+            (p.pos < p.src.len and nameChar(p.src[p.pos]))) return error.Unsupported;
+        const value = std.fmt.parseInt(i64, p.src[start..p.pos], 10) catch return error.Unsupported;
+        return if (negative) -value else value;
+    }
+
+    fn node(p: *Parser, n: Node) Invalid!usize {
+        if (p.len == p.nodes.len) return error.Unsupported;
+        const id = p.len;
+        p.nodes[id] = n;
+        p.len += 1;
+        return id;
+    }
+
+    pub fn expression(p: *Parser) Invalid!usize {
+        if (p.depth >= 32) return error.Unsupported;
+        p.depth += 1;
+        defer p.depth -= 1;
+        var lhs = try p.product();
+        while (true) {
+            const op: Op = if (p.eat("+")) .add else if (p.eat("-")) .sub else break;
+            lhs = try p.node(.{ .op = op, .lhs = lhs, .rhs = try p.product() });
+        }
+        return lhs;
+    }
+
+    fn product(p: *Parser) Invalid!usize {
+        var lhs = try p.unary();
+        while (true) {
+            p.space();
+            if (std.mem.startsWith(u8, p.src[p.pos..], "**") or !p.eat("*")) break;
+            lhs = try p.node(.{ .op = .mul, .lhs = lhs, .rhs = try p.unary() });
+        }
+        return lhs;
+    }
+
+    fn unary(p: *Parser) Invalid!usize {
+        if (p.depth >= 32) return error.Unsupported;
+        p.depth += 1;
+        defer p.depth -= 1;
+        if (p.eat("-")) return p.node(.{ .op = .neg, .lhs = try p.unary() });
+        if (p.eat("+")) return p.unary();
+        var base = try p.atom();
+        if (p.eat("**")) {
+            const exponent = try p.integer();
+            if (exponent < 0 or exponent > 8) return error.Unsupported;
+            base = try p.node(.{ .op = .power, .lhs = base, .value = exponent });
+        }
+        return base;
+    }
+
+    fn atom(p: *Parser) Invalid!usize {
+        if (p.eat("(")) {
+            const id = try p.expression();
+            try p.need(")");
+            return id;
+        }
+        p.space();
+        if (p.pos < p.src.len and std.ascii.isDigit(p.src[p.pos])) {
+            const value = try p.integer();
+            if (!fits(value)) return error.Unsupported;
+            return p.node(.{ .op = .literal, .value = value });
+        }
+        return p.node(.{ .op = .variable, .name = try p.identifier() });
+    }
+
+    pub fn bind(p: *Parser, variable: []const u8, interval: Bounds) Invalid!void {
+        for (p.nodes[0..p.len]) |n| {
+            if (n.op == .variable and !std.mem.eql(u8, variable, n.name)) return error.Unsupported;
+        }
+        p.variable_bounds = interval;
+    }
+
+    pub fn bounds(p: *const Parser, id: usize) Invalid!Bounds {
+        const n = p.nodes[id];
+        const result: Bounds = switch (n.op) {
+            .literal => .{ .lo = n.value, .hi = n.value },
+            .variable => p.variable_bounds,
+            .neg => blk: {
+                const b = try p.bounds(n.lhs);
+                break :blk .{ .lo = -b.hi, .hi = -b.lo };
+            },
+            .add, .sub, .mul => blk: {
+                const a = try p.bounds(n.lhs);
+                const b = try p.bounds(n.rhs);
+                break :blk switch (n.op) {
+                    .add => .{ .lo = a.lo + b.lo, .hi = a.hi + b.hi },
+                    .sub => .{ .lo = a.lo - b.hi, .hi = a.hi - b.lo },
+                    .mul => multiply(a, b),
+                    else => unreachable,
+                };
+            },
+            .power => blk: {
+                const b = try p.bounds(n.lhs);
+                var r: Bounds = .{ .lo = 1, .hi = 1 };
+                var i: i64 = 0;
+                while (i < n.value) : (i += 1) {
+                    r = multiply(r, b);
+                    if (!fits(r.lo) or !fits(r.hi)) return error.Unsupported;
+                }
+                break :blk r;
+            },
+        };
+        if (!fits(result.lo) or !fits(result.hi)) return error.Unsupported;
+        return result;
+    }
+
+    pub fn emit(p: *const Parser, a: std.mem.Allocator, out: *std.ArrayList(u8)) std.mem.Allocator.Error!void {
+        for (p.nodes[0..p.len], 0..) |n, id| {
+            try out.print(a, "int tf_e{d} = ", .{id});
+            switch (n.op) {
+                .literal => try out.print(a, "{d}", .{n.value}),
+                .variable => try out.appendSlice(a, "tf_i"),
+                .neg => try out.print(a, "-tf_e{d}", .{n.lhs}),
+                .add, .sub, .mul => try out.print(a, "tf_e{d} {s} tf_e{d}", .{
+                    n.lhs,
+                    switch (n.op) {
+                        .add => "+",
+                        .sub => "-",
+                        else => "*",
+                    },
+                    n.rhs,
+                }),
+                .power => {
+                    try out.appendSlice(a, "1");
+                    var i: i64 = 0;
+                    while (i < n.value) : (i += 1) try out.print(a, " * tf_e{d}", .{n.lhs});
+                },
+            }
+            try out.appendSlice(a, ";\n");
+        }
+    }
+};
+
+fn nameChar(c: u8) bool {
+    return std.ascii.isAlphanumeric(c) or c == '_';
+}
+
+fn multiply(a: Bounds, b: Bounds) Bounds {
+    const products = [_]i64{ a.lo * b.lo, a.lo * b.hi, a.hi * b.lo, a.hi * b.hi };
+    return .{ .lo = std.mem.min(i64, &products), .hi = std.mem.max(i64, &products) };
+}
+
+test "integer proof catches intermediate overflow even when final value is small" {
+    var p: Parser = .{ .src = "(i*1000000)*1000000 - (i*1000000)*1000000" };
+    const root = try p.expression();
+    try p.bind("i", .{ .lo = 0, .hi = 9 });
+    try std.testing.expectError(error.Unsupported, p.bounds(root));
+}
+
+test "Python unary minus binds below exponentiation" {
+    var p: Parser = .{ .src = "-i**2" };
+    const root = try p.expression();
+    try p.bind("i", .{ .lo = 3, .hi = 3 });
+    const b = try p.bounds(root);
+    try std.testing.expectEqual(@as(i64, -9), b.lo);
+    try std.testing.expectEqual(@as(i64, -9), b.hi);
+}
+
+test "sum squares semantics are 285 with wrong-operator negative control" {
+    var squares: Parser = .{ .src = "i*i" };
+    const root = try squares.expression();
+    var wrong: Parser = .{ .src = "i+i" };
+    const wrong_root = try wrong.expression();
+    var sum: i64 = 0;
+    var wrong_sum: i64 = 0;
+    for (0..10) |i| {
+        const value: i64 = @intCast(i);
+        const interval: Bounds = .{ .lo = value, .hi = value };
+        try squares.bind("i", interval);
+        try wrong.bind("i", interval);
+        const result = try squares.bounds(root);
+        try std.testing.expectEqual(result.lo, result.hi);
+        sum += result.lo;
+        wrong_sum += (try wrong.bounds(wrong_root)).lo;
+    }
+    try std.testing.expectEqual(@as(i64, 285), sum);
+    try std.testing.expect(wrong_sum != sum);
+}
diff --git a/zig/src/core/runner_frontend_reference_test.zig b/zig/src/core/runner_frontend_reference_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..577f99835213ed379de7db450086474143e941d9
--- /dev/null
+++ b/zig/src/core/runner_frontend_reference_test.zig
@@ -0,0 +1,72 @@
+const std = @import("std");
+const api = @import("runner_api.zig");
+const t = std.testing;
+
+const reference =
+    \\import sys
+    \\from pathlib import Path
+    \\root = Path(sys.argv[1])
+    \\sys.path.insert(0, str(root / 'experimental/riscv'))
+    \\from chipformer.rv import calc, elf, ref
+    \\if sys.argv[2] == 'calc':
+    \\    m = calc.machine(sys.argv[3], root / 'experimental/riscv/tests/data/rv/calc.elf')
+    \\else:
+    \\    m = ref.Machine.from_program(elf.program(sys.argv[3]))
+    \\m.run(100000)
+    \\sys.stdout.buffer.write(bytes(m.out))
+;
+
+pub fn check(root: []const u8, python: []const u8, program: api.Program, expected: []const u8) !void {
+    var tmp = t.tmpDir(.{});
+    defer tmp.cleanup();
+    var path: ?[:0]u8 = null;
+    defer if (path) |p| t.allocator.free(p);
+    var input = program.bytes;
+    if (program.kind == .elf) {
+        const file = try tmp.dir.createFile(t.io, "program.elf", .{});
+        defer file.close(t.io);
+        try file.writeStreamingAll(t.io, program.bytes);
+        path = try tmp.dir.realPathFileAlloc(t.io, "program.elf", t.allocator);
+        input = path.?;
+    }
+    const result = try std.process.run(t.allocator, t.io, .{
+        .argv = &.{ python, "-c", reference, root, @tagName(program.kind), input },
+        .stdout_limit = .limited(4096),
+        .stderr_limit = .limited(16384),
+        .timeout = .{ .duration = .{ .raw = .fromSeconds(10), .clock = .awake } },
+    });
+    defer t.allocator.free(result.stdout);
+    defer t.allocator.free(result.stderr);
+    if (!result.term.success()) {
+        std.debug.print("RV32 reference failed: {s}\n", .{result.stderr});
+        return error.ReferenceFailed;
+    }
+    try t.expectEqualStrings(expected, result.stdout);
+}
+
+test "accepted arithmetic executes in the firmware reference with exact output" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const root = env.get("TF_RUNNER_QWENPUTER") orelse {
+        std.debug.print("SKIP firmware reference: set TF_RUNNER_QWENPUTER to its source checkout\n", .{});
+        return error.SkipZigTest;
+    };
+    const frontend = @import("runner_frontend.zig").frontend();
+    const cases = [_][3][]const u8{
+        .{ "python", "print(123456789012345*987654321098765)", "121932631137021071359549253925\n" },
+        .{ "python", "print(123456789012345678901234567890*987654321098765432109876543210)", "121932631137021795226185032733622923332237463801111263526900\n" },
+        .{ "python", "2**100", "1267650600228229401496703205376\n" },
+        .{ "python", "-7//3", "-3\n" },
+        .{ "python", "-7%3", "2\n" },
+        .{ "exact", "1/3+2/3", "1\n" },
+        .{ "exact", "1.25*2.4", "3\n" },
+        .{ "exact", "123456789012345678901234567890.12345678901234567890123456789012", "123456789012345678901234567890.12345678901234567890123456789012\n" },
+        .{ "exact", "gcd(48,18)", "6\n" },
+    };
+    for (cases) |case| {
+        const result = try frontend.translate(null, t.allocator, .{ .form = .repl, .lang = case[0], .code = case[1] });
+        try t.expect(result == .program);
+        defer t.allocator.free(result.program.bytes);
+        try check(root, env.get("TF_RUNNER_REFERENCE_PYTHON") orelse "/usr/bin/python3", result.program, case[2]);
+    }
+}
diff --git a/zig/src/core/runner_frontend_test.zig b/zig/src/core/runner_frontend_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9f58de2fa12fdcc392da7b7d07c7e0375efd2859
--- /dev/null
+++ b/zig/src/core/runner_frontend_test.zig
@@ -0,0 +1,111 @@
+const std = @import("std");
+const f = @import("runner_frontend.zig");
+const t = std.testing;
+
+test "frontend accepts model multiply and REPL power without computing the answer" {
+    const front = f.frontend();
+    const cases = [_][3][]const u8{
+        .{ "python", "print(123456789012345678901234567890 * 987654321098765432109876543210)", "123456789012345678901234567890*987654321098765432109876543210" },
+        .{ "py", "2**100", "2**100" },
+        .{ "python3", "7 // -3", "7//-3" },
+        .{ "exact", "1/3 + 2/3", "1/3+2/3" },
+        .{ "calc", "1.25*2.4", "1.25*2.4" },
+    };
+    for (cases) |case| {
+        const result = try front.translate(front.ctx, t.allocator, .{ .form = .repl, .lang = case[0], .code = case[1] });
+        try t.expect(result == .program);
+        defer t.allocator.free(result.program.bytes);
+        try t.expectEqual(.calc, result.program.kind);
+        try t.expectEqualStrings(case[2], result.program.bytes);
+    }
+}
+
+test "frontend declines unsupported code and Python output mismatches" {
+    const front = f.frontend();
+    const cases = [_][2][]const u8{
+        .{ "javascript", "2*3" },            .{ "python", "print(missing)" },  .{ "python", "import os" },
+        .{ "python", "print(1/3)" },         .{ "python", "print(1.25*2.4)" }, .{ "python", "gcd(2,4)" },
+        .{ "python", "print(2); print(3)" }, .{ "python", "10**100" },         .{ "python", "1//0" },
+    };
+    for (cases) |case| {
+        const result = try front.translate(front.ctx, t.allocator, .{ .form = .fence, .lang = case[0], .code = case[1] });
+        try t.expect(result == .abstain);
+    }
+}
+
+test "frontend allocator failure is visible to its caller" {
+    const front = f.frontend();
+    try t.expectError(error.OutOfMemory, front.translate(null, std.testing.failing_allocator, .{
+        .form = .repl,
+        .lang = "python",
+        .code = "2**100",
+    }));
+}
+
+test {
+    _ = @import("runner_frontend_calc.zig");
+    _ = @import("runner_frontend_program.zig");
+    _ = @import("runner_frontend_reference_test.zig");
+}
+
+test "real compiler emits circuit ELF for loops and C with negative controls" {
+    var env = try t.environ.createMap(t.allocator);
+    defer env.deinit();
+    const clang = env.get("TF_RUNNER_CLANG") orelse {
+        std.debug.print("SKIP RV32 toolchain: set TF_RUNNER_CLANG and optionally TF_RUNNER_LLD\n", .{});
+        return error.SkipZigTest;
+    };
+    var context: f.Context = .{
+        .io = t.io,
+        .compiler = .{ .clang = clang, .linker = env.get("TF_RUNNER_LLD") },
+    };
+    const front = context.frontend();
+    const cases = [_][4][]const u8{
+        .{ "python", "print(sum(i*i for i in range(10)))", "squares.elf", "285\n" },
+        .{ "python", "print(sum(i+i for i in range(10)))", "addition.elf", "90\n" },
+        .{ "python", "s = 0\nfor i in range(10):\n    s += i*i\nprint(s)", "loop.elf", "285\n" },
+        .{ "c", "#include <stdio.h>\nint main(void) { int s=0; for(int i=0;i<10;i++) s+=i*i; printf(\"%d\\n\",s); return 0; }", "c.elf", "285\n" },
+        .{ "c", "int main(void) { puts(\"circuit\"); return 0; }", "puts.elf", "circuit\n" },
+        .{ "c", "int s=0; for(int i=0;i<10;i++) s+=i*i; printf(\"%d\\n\",s);", "snippet.elf", "285\n" },
+    };
+    for (cases) |case| {
+        const result = try front.translate(front.ctx, t.allocator, .{ .form = .fence, .lang = case[0], .code = case[1] });
+        try t.expect(result == .program);
+        defer t.allocator.free(result.program.bytes);
+        try t.expectEqual(.elf, result.program.kind);
+        const repeated = try front.translate(front.ctx, t.allocator, .{ .form = .fence, .lang = case[0], .code = case[1] });
+        try t.expect(repeated == .program);
+        defer t.allocator.free(repeated.program.bytes);
+        try t.expectEqualSlices(u8, result.program.bytes, repeated.program.bytes);
+        try t.expect(@import("runner_frontend_program.zig").compiler.validElf(result.program.bytes));
+        if (env.get("TF_RUNNER_QWENPUTER")) |root|
+            try @import("runner_frontend_reference_test.zig").check(root, env.get("TF_RUNNER_REFERENCE_PYTHON") orelse "/usr/bin/python3", result.program, case[3]);
+        if (env.get("TF_RUNNER_FRONTEND_ARTIFACTS")) |path| {
+            const dir = try std.Io.Dir.cwd().openDir(t.io, path, .{});
+            defer dir.close(t.io);
+            const file = try dir.createFile(t.io, case[2], .{});
+            defer file.close(t.io);
+            try file.writeStreamingAll(t.io, result.program.bytes);
+        }
+    }
+    const missing = try front.translate(front.ctx, t.allocator, .{ .form = .fence, .lang = "c", .code = "int main(void) { unknown(); }" });
+    try t.expect(missing == .abstain);
+    context.compiler.clang = "/nonexistent-tensorfold-clang";
+    const unavailable = try front.translate(front.ctx, t.allocator, .{
+        .form = .repl,
+        .lang = "python",
+        .code = "print(sum(i*i for i in range(10)))",
+    });
+    try t.expect(unavailable == .abstain);
+}
+
+test "prior cells cannot silently shadow Python builtins" {
+    const front = f.frontend();
+    const result = try front.translate(null, t.allocator, .{
+        .form = .repl,
+        .lang = "python",
+        .code = "print(2*3)",
+        .prior = &.{"print = lambda x: None"},
+    });
+    try t.expect(result == .abstain);
+}
diff --git a/zig/src/core/runner_frontend_value.zig b/zig/src/core/runner_frontend_value.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f498863c190a87b434ff1555397cf05cb8aea9b5
--- /dev/null
+++ b/zig/src/core/runner_frontend_value.zig
@@ -0,0 +1,205 @@
+const std = @import("std");
+const Invalid = error{Unsupported};
+const limit: i512 = std.math.pow(i512, 10, 62);
+const Value = struct { n: i512, d: i512 = 1, scale: usize = 0, width: usize = 0 };
+
+// Checks firmware value limits; the returned program remains the source expression, not this validation value.
+pub fn valid(source: []const u8) bool {
+    if (source.len == 0 or source.len > 255) return false;
+    var p: Parser = .{ .src = source };
+    _ = p.expr() catch return false;
+    return p.pos == source.len;
+}
+
+fn magnitude(n: i512) i512 {
+    return if (n < 0) -n else n;
+}
+
+fn gcd(a: i512, b: i512) i512 {
+    var x = magnitude(a);
+    var y = magnitude(b);
+    while (y != 0) {
+        const r = @mod(x, y);
+        x = y;
+        y = r;
+    }
+    return x;
+}
+
+fn checked(n: i512, d: i512) Invalid!Value {
+    if (d == 0) return error.Unsupported;
+    const g = gcd(n, d);
+    const sign: i512 = if (d < 0) -1 else 1;
+    const v: Value = .{ .n = @divTrunc(n, g) * sign, .d = @divTrunc(d, g) * sign };
+    if (magnitude(v.n) >= limit or v.d >= limit) return error.Unsupported;
+    return v;
+}
+
+fn integer(v: Value) Invalid!i512 {
+    if (v.d != 1 or v.scale != 0) return error.Unsupported;
+    return v.n;
+}
+
+fn digits(n: i512) usize {
+    var v = magnitude(n);
+    var count: usize = 1;
+    while (v >= 10) : (count += 1) v = @divTrunc(v, 10);
+    return count;
+}
+
+fn rational(op: u8, a: Value, b: Value) Invalid!Value {
+    if (op == '*') {
+        if (digits(a.n) + digits(b.n) > 62 or
+            (a.d != 1 and b.d != 1 and digits(a.d) + digits(b.d) > 62)) return error.Unsupported;
+        return checked(a.n * b.n, a.d * b.d);
+    }
+    if (op == '/') {
+        if (b.n == 0 or (b.d != 1 and digits(a.n) + digits(b.d) > 62) or
+            (a.d != 1 and digits(a.d) + digits(b.n) > 62)) return error.Unsupported;
+        return checked(a.n * b.d, a.d * b.n);
+    }
+    if ((b.d != 1 and digits(a.n) + digits(b.d) > 62) or
+        (a.d != 1 and digits(b.n) + digits(a.d) > 62) or
+        (a.d != 1 and b.d != 1 and digits(a.d) + digits(b.d) > 62)) return error.Unsupported;
+    const x = a.n * b.d;
+    const y = if (op == '+') b.n * a.d else -b.n * a.d;
+    if ((x < 0) == (y < 0) and @max(digits(x), digits(y)) + 1 > 62) return error.Unsupported;
+    return checked(x + y, a.d * b.d);
+}
+
+fn width(v: Value) usize {
+    return if (v.width == 0) digits(v.n) else v.width;
+}
+
+fn decimal(op: u8, a: Value, b: Value) Invalid!Value {
+    if (op == '*') {
+        const w = width(a) + width(b);
+        if (w > 62) return error.Unsupported;
+        var v = try checked(a.n * b.n, 1);
+        v.scale = a.scale + b.scale;
+        v.width = w;
+        return v;
+    }
+    const scale = @max(a.scale, b.scale);
+    const wa = width(a) + scale - a.scale;
+    const wb = width(b) + scale - b.scale;
+    if (wa > 62 or wb > 62) return error.Unsupported;
+    const x = a.n * std.math.pow(i512, 10, scale - a.scale);
+    const y = b.n * std.math.pow(i512, 10, scale - b.scale) * @as(i512, if (op == '+') 1 else -1);
+    const w = @max(wa, wb) + @intFromBool((x < 0) == (y < 0));
+    if (w > 62) return error.Unsupported;
+    var v = try checked(x + y, 1);
+    v.scale = scale;
+    v.width = w;
+    return v;
+}
+
+const Parser = struct {
+    src: []const u8,
+    pos: usize = 0,
+
+    fn take(self: *Parser, s: []const u8) bool {
+        if (!std.mem.startsWith(u8, self.src[self.pos..], s)) return false;
+        self.pos += s.len;
+        return true;
+    }
+
+    fn expr(self: *Parser) Invalid!Value {
+        var a = try self.term();
+        while (self.pos < self.src.len) {
+            const op = self.src[self.pos];
+            if (op != '+' and op != '-') break;
+            self.pos += 1;
+            const b = try self.term();
+            a = if (a.scale != 0 or b.scale != 0) try decimal(op, a, b) else try rational(op, a, b);
+        }
+        return a;
+    }
+
+    fn term(self: *Parser) Invalid!Value {
+        var a = try self.factor();
+        while (self.pos < self.src.len) {
+            const op = self.src[self.pos];
+            if (op != '*' and op != '/' and op != '%') break;
+            self.pos += 1;
+            const floor = op == '/' and self.take("/");
+            const b = try self.factor();
+            if (floor or op == '%') {
+                const x = try integer(a);
+                const y = try integer(b);
+                if (y == 0) return error.Unsupported;
+                if ((x < 0) != (y < 0) and @rem(x, y) != 0 and digits(@divTrunc(x, y)) == 62)
+                    return error.Unsupported;
+                a = try checked(if (floor) @divFloor(x, y) else x - @divFloor(x, y) * y, 1);
+            } else if (a.scale != 0 or b.scale != 0) {
+                a = try decimal(op, a, b);
+            } else if (op == '/' or a.d != 1 or b.d != 1) {
+                a = try rational(op, a, b);
+            } else a = try rational('*', a, b);
+        }
+        return a;
+    }
+
+    fn factor(self: *Parser) Invalid!Value {
+        if (self.take("+")) return self.factor();
+        if (self.take("-")) {
+            var v = try self.factor();
+            v.n = -v.n;
+            return v;
+        }
+        var a = try self.atom();
+        if (self.take("**")) {
+            var exp = try integer(try self.factor());
+            if (exp < 0 or exp > 999) return error.Unsupported;
+            var base = Value{ .n = try integer(a) };
+            a = .{ .n = 1 };
+            while (exp > 0) {
+                if (@mod(exp, 2) == 1) a = try rational('*', a, base);
+                exp = @divTrunc(exp, 2);
+                if (exp > 0) base = try rational('*', base, base);
+            }
+        }
+        return a;
+    }
+
+    fn atom(self: *Parser) Invalid!Value {
+        if (self.take("gcd(")) {
+            const a = try integer(try self.expr());
+            if (!self.take(",")) return error.Unsupported;
+            const b = try integer(try self.expr());
+            if (!self.take(")")) return error.Unsupported;
+            return .{ .n = gcd(a, b) };
+        }
+        if (self.take("(")) {
+            const v = try self.expr();
+            if (!self.take(")")) return error.Unsupported;
+            return v;
+        }
+        var n: i512 = 0;
+        var scale: usize = 0;
+        var dot = false;
+        var count: usize = 0;
+        const start = self.pos;
+        while (self.pos < self.src.len) {
+            const c = self.src[self.pos];
+            if (c == '.' and !dot) {
+                dot = true;
+            } else if (std.ascii.isDigit(c)) {
+                count += 1;
+                if (count > 62) return error.Unsupported;
+                n = n * 10 + c - '0';
+                if (dot) scale += 1;
+            } else break;
+            self.pos += 1;
+        }
+        if (start == self.pos) return error.Unsupported;
+        return .{ .n = n, .scale = scale };
+    }
+};
+
+test "value preflight refuses overflow and arithmetic errors" {
+    for ([_][]const u8{ "2**100", "-2**2", "(-2)**2", "7//-3", "1/3+2/3", "1.25*2.4" }) |s|
+        try std.testing.expect(valid(s));
+    for ([_][]const u8{ "10**100", "2**1000", "2**-1", "1/0", "1//0", "1%0", "gcd(1/2,3)", "(1/2)**3" }) |s|
+        try std.testing.expect(!valid(s));
+}
