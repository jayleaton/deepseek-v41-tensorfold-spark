From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Mon, 2 Nov 2026 22:00:34 +0700
Subject: [PATCH 136/207] spawn test: a worker exiting between the /proc stat
 open and its read is gone, not an error (ESRCH race in T5's descendantsStop)

---
 zig/src/core/runner_frontend_spawn.zig | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/zig/src/core/runner_frontend_spawn.zig b/zig/src/core/runner_frontend_spawn.zig
index 25fc1dfb4bf4def4537249f8b2dc24380eccde25..21cb4878ef71217e92b24a358467cf17e75f0f21 100644
--- a/zig/src/core/runner_frontend_spawn.zig
+++ b/zig/src/core/runner_frontend_spawn.zig
@@ -236,7 +236,11 @@ fn descendantsStop() !void {
         defer file.close(t.io);
         var buffer: [4096]u8 = undefined;
         var reader = file.readerStreaming(t.io, &buffer);
-        const stat = try reader.interface.allocRemaining(t.allocator, .limited(4096));
+        // the worker exiting between open and read fails the read (ESRCH): poll again, the open then finds it gone
+        const stat = reader.interface.allocRemaining(t.allocator, .limited(4096)) catch |err| switch (err) {
+            error.ReadFailed => if (now() < settled_by) continue else return err,
+            else => return err,
+        };
         defer t.allocator.free(stat);
         if (stat.len == 0) return;
         const end = std.mem.lastIndexOfScalar(u8, stat, ')') orelse return error.InvalidProcStat;
