diff --git a/zig/src/families/deepseek_v41/model_retain.zig b/zig/src/families/deepseek_v41/model_retain.zig
new file mode 100644
index 0000000000000000000000000000000000000000..f402a24fa8c77bc3911c3bf46351745e2c9a7d11
--- /dev/null
+++ b/zig/src/families/deepseek_v41/model_retain.zig
@@ -0,0 +1,51 @@
+//! Models whose GPU drain failed: kept, with their context and allocation owner, instead of freed under live work.
+const std = @import("std");
+const Model = @import("cuda_model.zig").Model;
+
+pub var retained_models: ?*Model = null;
+var retained_lock: std.atomic.Mutex = .unlocked;
+pub fn retain(m: *Model) void {
+    while (!retained_lock.tryLock()) std.Thread.yield() catch {};
+    defer retained_lock.unlock();
+    if (m.retained) return;
+    if (m.dev_arena) |x| x.detachHook();
+    m.retained = true;
+    m.retained_next = retained_models;
+    retained_models = m;
+}
+
+pub fn detachRetained(m: *Model) void {
+    while (!retained_lock.tryLock()) std.Thread.yield() catch {};
+    defer retained_lock.unlock();
+    var at = &retained_models;
+    while (at.*) |x| {
+        if (x == m) {
+            at.* = x.retained_next;
+            m.retained = false;
+            return;
+        }
+        at = &x.retained_next;
+    }
+}
+test "Draft state: failed model drain retains its context and allocation owner" {
+    const mock = @import("load_mock.zig");
+    const a = std.testing.allocator;
+    const m = try a.create(Model);
+    defer {
+        detachRetained(m);
+        a.destroy(m);
+    }
+    m.driver = mock.init();
+    m.gpa = a;
+    m.retained = false;
+    m.retained_next = null;
+    m.boot_complete = true;
+    m.dev_arena = null;
+    m.ctx = .{ .d = &m.driver, .handle = null, .device = 0 };
+    mock.fail_sync = true;
+    defer mock.fail_sync = false;
+    m.close();
+    try std.testing.expect(m.retained);
+    try std.testing.expect(retained_models == m);
+    try std.testing.expectEqual(@as(usize, 0), mock.freed);
+}
