index 0000000000000000000000000000000000000000..1b6364a7a8bf0d0bb424312fb8d6f4db834e7096
--- /dev/null
+++ b/zig/src/core/runner_trace.zig
@@ -0,0 +1,210 @@
+//! The runner's `trace` form: whole integer computations the reasoning states, and the lines where hand work starts.
+const std = @import("std");
+const text = @import("runner_trace_text.zig");
+const expr = @import("runner_trace_expr.zig");
+const Allocator = std.mem.Allocator;
+const Expr = expr.Expr;
+
+/// The integer frontend's width: a statement whose syntax bound is wider is never a candidate.
+pub const max_digits = 62;
+
+/// A stated computation: Python source for the frontend, the expression shown to the model, divmod's re-shaping.
+pub const Found = struct { source: []const u8, display: []const u8, divmod: bool = false, same_line: bool = false };
+
+/// Per reply: the names the reasoning defined and the sources already owned (`keep`); one line's work (`scratch`).
+pub const Tracer = struct {
+    keep: std.heap.ArenaAllocator,
+    scratch: std.heap.ArenaAllocator,
+    names: std.ArrayList(expr.Name) = .empty,
+    fired: std.ArrayList([]const u8) = .empty,
+
+    pub fn init(gpa: Allocator) Tracer {
+        return .{ .keep = .init(gpa), .scratch = .init(gpa) };
+    }
+
+    pub fn deinit(t: *Tracer) void {
+        t.keep.deinit();
+        t.scratch.deinit();
+    }
+
+    /// The source owned once: the same statement never fires twice in a reply.
+    pub fn fire(t: *Tracer, source: []const u8) Allocator.Error!void {
+        const a = t.keep.allocator();
+        try t.fired.append(a, try a.dupe(u8, source));
+    }
+
+    fn firedHas(t: *const Tracer, source: []const u8) bool {
+        for (t.fired.items) |f| if (std.mem.eql(u8, f, source)) return true;
+        return false;
+    }
+
+    fn poison(t: *Tracer, n: []const u8) void {
+        for (t.names.items) |*m| if (std.mem.eql(u8, m.name, n)) {
+            m.expr = null;
+        };
+    }
+
+    fn lookup(t: *const Tracer, n: []const u8) ?*const expr.Name {
+        for (t.names.items) |*e| if (std.mem.eql(u8, e.name, n)) return e;
+        return null;
+    }
+
+    /// One completed reasoning line: its definitions, then its first viable statement; text valid until the next call.
+    pub fn line(t: *Tracer, raw: []const u8) Allocator.Error!?Found {
+        _ = t.scratch.reset(.retain_capacity);
+        const a = t.scratch.allocator();
+        const clean = try text.stripNotes(a, raw);
+        var define: ?Found = null;
+        try t.definitions(clean, &define);
+        var heads: std.ArrayList(text.Head) = .empty;
+        try text.goalHeads(a, clean, &heads);
+        try text.bareHeads(a, clean, &heads);
+        std.mem.sort(text.Head, heads.items, {}, text.Head.less);
+        var first: ?Found = null;
+        var last_head: usize = 0;
+        for (heads.items) |h| {
+            last_head = @max(last_head, h.end);
+            if (first != null) continue;
+            if (try t.statement(clean, h)) |f| first = f;
+        }
+        if (first) |*f| {
+            f.same_line = text.cueIn(clean[last_head..]);
+            return f.*;
+        }
+        return define;
+    }
+
+    fn definitions(t: *Tracer, clean: []const u8, define: *?Found) Allocator.Error!void {
+        const a = t.keep.allocator();
+        var i: usize = 0;
+        while (i < clean.len) {
+            const d = text.defAt(clean, i) orelse {
+                i += 1;
+                continue;
+            };
+            i = d.rhs;
+            if (!text.defLeftOk(clean[0..d.start])) continue;
+            const txt_end = text.defEnd(clean, d.rhs) orelse continue;
+            const txt = clean[d.rhs..txt_end];
+            if (text.approx(clean[d.rhs..charsOn(clean, txt_end, 3)])) continue;
+            if (std.mem.indexOfAny(u8, txt, "[]") != null) continue;
+            if (text.hypothetical(text.sentenceAt(clean, d.start))) continue;
+            const e = try t.parse(txt) orelse continue;
+            const n = clean[d.start..d.name_end];
+            if (t.lookup(n)) |old| {
+                // a second definition by other text poisons the name
+                if (old.expr != null and !std.mem.eql(u8, old.expr.?.source, e.source)) t.poison(n);
+                continue;
+            }
+            const kept: Expr = .{ .source = try a.dupe(u8, e.source), .display = try a.dupe(u8, e.display), .bound = e.bound, .ops = e.ops, .constant = e.constant };
+            try t.names.append(a, .{ .name = try a.dupe(u8, n), .expr = kept });
+            // a first wide definition with nothing after it states that computation ("N = A*2^64 + B.")
+            if (hasArith(e.source) and e.bound >= 12 and e.bound <= max_digits and text.sentenceEndsAt(clean, txt_end) and
+                !t.firedHas(e.source)) define.* = .{ .source = e.source, .display = e.display };
+        }
+    }
+
+    fn statement(t: *Tracer, clean: []const u8, h: text.Head) Allocator.Error!?Found {
+        const a = t.scratch.allocator();
+        const rest = clean[h.end..];
+        const ph = text.phrase(rest) orelse return null;
+        if (text.approx(rest[0..ph.end])) return null;
+        if (text.listed(rest, ph)) return null;
+        if (std.mem.indexOfScalar(u8, text.sentenceAt(clean, h.end), '?') != null) return null;
+        var parts: [2]Expr = undefined;
+        for (ph.parts[0..ph.n], 0..) |p, k| parts[k] = try t.parse(rest[p[0]..p[1]]) orelse return null;
+        var f: Found = undefined;
+        var bound: u32 = 0;
+        switch (ph.kind) {
+            .expr => {
+                if (parts[0].ops == 0) return null;
+                f = .{ .source = parts[0].source, .display = parts[0].display };
+                bound = parts[0].bound;
+            },
+            .divmod => {
+                f = .{ .source = try std.fmt.allocPrint(a, "divmod({s}, {s})", .{ parts[0].source, parts[1].source }), .display = try std.fmt.allocPrint(a, "{s} ÷ {s}", .{ try wrapped(a, parts[0]), try wrapped(a, parts[1]) }), .divmod = true };
+                bound = parts[0].bound;
+            },
+            .mul => {
+                f = .{ .source = try std.fmt.allocPrint(a, "({s}) * ({s})", .{ parts[0].source, parts[1].source }), .display = try std.fmt.allocPrint(a, "{s} * {s}", .{ try wrapped(a, parts[0]), try wrapped(a, parts[1]) }) };
+                bound = expr.sat(parts[0].bound + parts[1].bound);
+            },
+            .subfrom => {
+                f = .{ .source = try std.fmt.allocPrint(a, "({s}) - ({s})", .{ parts[1].source, parts[0].source }), .display = try std.fmt.allocPrint(a, "{s} - {s}", .{ try wrapped(a, parts[1]), try wrapped(a, parts[0]) }) };
+                bound = expr.sat(@max(parts[0].bound, parts[1].bound) + 1);
+            },
+        }
+        if (t.firedHas(f.source) or bound > max_digits) return null;
+        // a bare sentence counts only when it is plainly a computation: a power or a six-digit literal
+        if (h.bare and std.mem.indexOf(u8, f.source, "**") == null and !hasDigitRun(f.source, 6)) return null;
+        return f;
+    }
+
+    fn parse(t: *Tracer, s: []const u8) Allocator.Error!?Expr {
+        return expr.parse(t.scratch.allocator(), t.names.items, s);
+    }
+};
+
+/// "[exact: <display> = <value>]\n" from a circuit's printed value, or null (abstain: not one integer, or not (q, r)).
+pub fn owned(a: Allocator, display: []const u8, divmod: bool, out: []const u8) Allocator.Error!?[]u8 {
+    const v = if (std.mem.endsWith(u8, out, "\n")) out[0 .. out.len - 1] else out;
+    if (v.len == 0 or std.mem.indexOfScalar(u8, v, '\n') != null) return null;
+    if (!divmod) {
+        if (!isInt(v)) return null;
+        return try std.fmt.allocPrint(a, "[exact: {s} = {s}]\n", .{ display, v });
+    }
+    if (v.len < 6 or v[0] != '(' or v[v.len - 1] != ')') return null;
+    const inner = v[1 .. v.len - 1];
+    const comma = std.mem.indexOf(u8, inner, ", ") orelse return null;
+    const q = inner[0..comma];
+    const r = inner[comma + 2 ..];
+    if (!isInt(q) or !isInt(r)) return null;
+    return try std.fmt.allocPrint(a, "[exact: {s} = {s} remainder {s}]\n", .{ display, q, r });
+}
+
+fn isInt(s: []const u8) bool {
+    const d = if (s.len > 0 and s[0] == '-') s[1..] else s;
+    if (d.len == 0) return false;
+    for (d) |c| if (!std.ascii.isDigit(c)) return false;
+    return true;
+}
+
+fn wrapped(a: Allocator, e: Expr) Allocator.Error![]const u8 {
+    return if (e.ops > 0) std.fmt.allocPrint(a, "({s})", .{e.display}) else e.display;
+}
+
+fn hasArith(source: []const u8) bool {
+    var i: usize = 0;
+    while (i < source.len) : (i += 1) {
+        if (source[i] == '*' and i + 1 < source.len and source[i + 1] == '*') {
+            i += 1;
+            continue;
+        }
+        if (std.mem.indexOfScalar(u8, "-+*%", source[i]) != null) return true;
+    }
+    return false;
+}
+
+/// The byte index `n` UTF-8 characters past `i` (the study counts characters: "≈" is one).
+fn charsOn(s: []const u8, i: usize, n: usize) usize {
+    var j = i;
+    var left = n;
+    while (j < s.len and left > 0) {
+        j += 1;
+        while (j < s.len and s[j] & 0xC0 == 0x80) j += 1;
+        left -= 1;
+    }
+    return j;
+}
+
+fn hasDigitRun(s: []const u8, n: usize) bool {
+    var run: usize = 0;
+    for (s) |c| {
+        run = if (std.ascii.isDigit(c)) run + 1 else 0;
+        if (run >= n) return true;
+    }
+    return false;
+}
+
+/// A hand trace starts in this text (a step, table or digit line, long division, carry, borrow, by hand, ...).
+pub const cue = text.cueIn;
diff --git a/zig/src/core/runner_trace_expr.zig b/zig/src/core/runner_trace_expr.zig
new file mode 100644
index 0000000000000000000000000000000000000000..2671312960c00f76b2bbb318b5e9e178d295515a
--- /dev/null
+++ b/zig/src/core/runner_trace_expr.zig
@@ -0,0 +1,271 @@
+//! The runner's `trace` form: integer expression text to checked Python source, display text and a width bound.
+const std = @import("std");
+const text = @import("runner_trace_text.zig");
+const Allocator = std.mem.Allocator;
+
+pub const inf: u32 = 1 << 20;
+
+pub const Kind = enum { num, name, op };
+pub const Tok = struct { kind: Kind, text: []const u8 };
+
+/// A parsed operand: Python source, display text, syntax bound in decimal digits, binary operators, literal-only.
+pub const Expr = struct { source: []u8, display: []u8, bound: u32, ops: u32, constant: bool };
+
+pub const Name = struct { name: []u8, expr: ?Expr };
+
+pub fn sat(x: u32) u32 {
+    return @min(x, inf);
+}
+
+/// Expression text to a checked expression, or null (not a plain integer expression, or an unknown/poisoned name).
+pub fn parse(a: Allocator, names: []const Name, s: []const u8) Allocator.Error!?Expr {
+    var toks = try tokenize(a, s) orelse return null;
+    toks = try expandRun(a, toks) orelse return null;
+    var p: Parser = .{ .names = names, .a = a, .toks = toks };
+    const e = p.sum() catch |err| switch (err) {
+        error.OutOfMemory => return error.OutOfMemory,
+        error.Refused => return null,
+    };
+    if (p.i != toks.len) return null;
+    return e;
+}
+
+/// Numbers (plain, strict comma groups, 0x hex), names, + - * ^ ( ) mod and `...`; null on anything else.
+fn tokenize(a: Allocator, s: []const u8) Allocator.Error!?[]Tok {
+    var out: std.ArrayList(Tok) = .empty;
+    var i: usize = 0;
+    while (i < s.len) {
+        const c = s[i];
+        if (text.isSpace(c)) {
+            i += 1;
+            continue;
+        }
+        if (i > 0 and (std.ascii.isAlphanumeric(s[i - 1]) or s[i - 1] == ',' or s[i - 1] == '.') and std.ascii.isAlphanumeric(c)) return null;
+        if (std.ascii.isDigit(c)) {
+            const n = number(s, i) orelse return null;
+            var digits: std.ArrayList(u8) = .empty;
+            for (s[i..n]) |d| if (d != ',') try digits.append(a, d);
+            if (digits.items.len > 1 and digits.items[0] == '0' and digits.items[1] != 'x') return null;
+            try out.append(a, .{ .kind = .num, .text = digits.items });
+            i = n;
+            continue;
+        }
+        const nl = text.nameLen(s, i);
+        if (nl > 0 and (i + nl == s.len or !text.isWord(s[i + nl]))) {
+            try out.append(a, .{ .kind = .name, .text = s[i .. i + nl] });
+            i += nl;
+            continue;
+        }
+        if (std.mem.startsWith(u8, s[i..], "...") or std.mem.startsWith(u8, s[i..], "…")) {
+            try out.append(a, .{ .kind = .op, .text = "..." });
+            i += 3;
+            continue;
+        }
+        if (std.mem.startsWith(u8, s[i..], "**")) {
+            try out.append(a, .{ .kind = .op, .text = "^" });
+            i += 2;
+            continue;
+        }
+        const op: ?[]const u8, const w: usize = if (std.mem.indexOfScalar(u8, "+-*^()", c) != null)
+            .{ s[i .. i + 1], 1 }
+        else if (std.mem.startsWith(u8, s[i..], "×") or std.mem.startsWith(u8, s[i..], "·"))
+            .{ "*", 2 }
+        else if (std.mem.startsWith(u8, s[i..], "−"))
+            .{ "-", 3 }
+        else if (i + 3 <= s.len and std.ascii.eqlIgnoreCase(s[i .. i + 3], "mod") and (i + 3 == s.len or !std.ascii.isAlphabetic(s[i + 3])))
+            .{ "%", 3 }
+        else
+            .{ null, 0 };
+        try out.append(a, .{ .kind = .op, .text = op orelse return null });
+        i += w;
+    }
+    return out.items;
+}
+
+/// The end of a number token at `i`: 0x hex, strict comma groups or plain digits, not running into a word.
+fn number(s: []const u8, i: usize) ?usize {
+    const stop = struct {
+        fn ok(t: []const u8, j: usize, comma: bool) bool {
+            if (j >= t.len) return true;
+            if (text.isWord(t[j]) or (comma and t[j] == ',')) return false;
+            return !(t[j] == '.' and j + 1 < t.len and std.ascii.isDigit(t[j + 1]));
+        }
+    };
+    if (s[i] == '0' and i + 2 < s.len and s[i + 1] == 'x' and std.ascii.isHex(s[i + 2])) {
+        var j = i + 2;
+        while (j < s.len and std.ascii.isHex(s[j])) j += 1;
+        if (j < s.len and (text.isWord(s[j]) or s[j] == ',' or s[j] == '.')) return null;
+        return j;
+    }
+    if (s[i] != '0') {
+        var j = i;
+        while (j < s.len and j - i < 3 and std.ascii.isDigit(s[j])) j += 1;
+        var groups: usize = 0;
+        while (j + 3 < s.len + 0 and s[j] == ',' and allDigits(s[j + 1 .. j + 4])) : (groups += 1) j += 4;
+        if (groups > 0 and stop.ok(s, j, true)) return j;
+    }
+    var j = i;
+    while (j < s.len and std.ascii.isDigit(s[j])) j += 1;
+    return if (stop.ok(s, j, true)) j else null;
+}
+
+fn allDigits(s: []const u8) bool {
+    for (s) |c| if (!std.ascii.isDigit(c)) return false;
+    return true;
+}
+
+/// `a*b*...*c` with b = a+1 and c - a <= 64 becomes the explicit product; any other `...` refuses.
+fn expandRun(a: Allocator, toks: []Tok) Allocator.Error!?[]Tok {
+    var dots = false;
+    for (toks) |t| dots = dots or std.mem.eql(u8, t.text, "...");
+    if (!dots) return toks;
+    if (toks.len != 7) return null;
+    const shape = [_][]const u8{ "", "*", "", "*", "...", "*", "" };
+    for (toks, shape) |t, want| {
+        if (want.len == 0) {
+            if (t.kind != .num or t.text.len > 6 or std.mem.startsWith(u8, t.text, "0x")) return null;
+        } else if (!std.mem.eql(u8, t.text, want)) return null;
+    }
+    const x = std.fmt.parseInt(u32, toks[0].text, 10) catch return null;
+    const y = std.fmt.parseInt(u32, toks[2].text, 10) catch return null;
+    const z = std.fmt.parseInt(u32, toks[6].text, 10) catch return null;
+    if (y != x + 1 or z <= y or z - x > 64) return null;
+    var out: std.ArrayList(Tok) = .empty;
+    var n = x;
+    while (n <= z) : (n += 1) {
+        if (n != x) try out.append(a, .{ .kind = .op, .text = "*" });
+        try out.append(a, .{ .kind = .num, .text = try std.fmt.allocPrint(a, "{d}", .{n}) });
+    }
+    return out.items;
+}
+
+/// sum := term (+|- term)*; term := factor (*|mod factor)*; factor := -factor | atom [^ factor]; one reading only.
+const Parser = struct {
+    names: []const Name,
+    a: Allocator,
+    toks: []const Tok,
+    i: usize = 0,
+    depth: u32 = 0, // brackets open at the cursor
+    last_mod: bool = false, // the term just parsed ends in `mod`
+
+    const Error = error{ OutOfMemory, Refused };
+
+    fn peek(p: *const Parser, op: []const u8) bool {
+        return p.i < p.toks.len and p.toks[p.i].kind == .op and std.mem.eql(u8, p.toks[p.i].text, op);
+    }
+
+    fn sum(p: *Parser) Error!Expr {
+        var e = try p.term();
+        var terms: u32 = 1;
+        var has_mod = p.last_mod;
+        while (p.peek("+") or p.peek("-")) {
+            const op = p.toks[p.i].text;
+            p.i += 1;
+            const r = try p.term();
+            has_mod = has_mod or p.last_mod;
+            terms += 1;
+            e = .{ .source = try cat(p.a, &.{ e.source, op, r.source }), .display = try cat(p.a, &.{ e.display, " ", op, " ", r.display }), .bound = sat(@max(e.bound, r.bound) + 1), .ops = e.ops + r.ops + 1, .constant = false };
+        }
+        // `A + B mod M` reads two ways: mod only in an expression that is one term
+        if (has_mod and terms > 1) return error.Refused;
+        return e;
+    }
+
+    fn term(p: *Parser) Error!Expr {
+        var e = try p.factor();
+        var moded = false;
+        while (p.peek("*") or p.peek("%")) {
+            const op = p.toks[p.i].text;
+            if (moded or (op[0] == '%' and p.depth > 0)) return error.Refused; // mod last, never in brackets
+            p.i += 1;
+            const start = p.i;
+            const r = try p.factor();
+            if (op[0] == '%') {
+                // the modulus is a plain number, name or power chain (10^18), never a sum or a bracket
+                for (p.toks[start..p.i]) |t| if (t.kind == .op and !std.mem.eql(u8, t.text, "^")) return error.Refused;
+                moded = true;
+                e = .{ .source = try cat(p.a, &.{ e.source, "%", r.source }), .display = try cat(p.a, &.{ e.display, " mod ", r.display }), .bound = r.bound, .ops = e.ops + r.ops + 1, .constant = false };
+            } else {
+                e = .{ .source = try cat(p.a, &.{ e.source, "*", r.source }), .display = try cat(p.a, &.{ e.display, "*", r.display }), .bound = sat(e.bound + r.bound), .ops = e.ops + r.ops + 1, .constant = false };
+            }
+        }
+        p.last_mod = moded;
+        return e;
+    }
+
+    fn factor(p: *Parser) Error!Expr {
+        if (p.peek("-")) {
+            p.i += 1;
+            const e = try p.factor();
+            return .{ .source = try cat(p.a, &.{ "-", e.source }), .display = try cat(p.a, &.{ "-", e.display }), .bound = e.bound, .ops = e.ops, .constant = false };
+        }
+        const base = try p.atom();
+        if (!p.peek("^")) return base;
+        p.i += 1;
+        if (p.i >= p.toks.len or p.toks[p.i].kind != .num) return error.Refused; // a literal exponent only
+        const k_text = p.toks[p.i].text;
+        p.i += 1;
+        if (p.peek("^")) return error.Refused; // a^b^c
+        const k = std.fmt.parseInt(u32, k_text, 10) catch return error.Refused;
+        const bound: u32 = if (base.constant and k <= 4096) constPowDigits(base.source, k) else sat(@as(u32, @intCast(@min(@as(u64, base.bound) * k, inf))));
+        return .{ .source = try cat(p.a, &.{ base.source, "**", k_text }), .display = try cat(p.a, &.{ base.display, "^", k_text }), .bound = bound, .ops = base.ops + 1, .constant = false };
+    }
+
+    fn atom(p: *Parser) Error!Expr {
+        if (p.i >= p.toks.len) return error.Refused;
+        const t = p.toks[p.i];
+        p.i += 1;
+        switch (t.kind) {
+            .num => return .{ .source = try p.a.dupe(u8, t.text), .display = try p.a.dupe(u8, t.text), .bound = litDigits(t.text), .ops = 0, .constant = true },
+            .name => {
+                const e = lookup(p.names, t.text) orelse return error.Refused;
+                return .{ .source = try cat(p.a, &.{ "(", e.source, ")" }), .display = if (e.ops > 0) try cat(p.a, &.{ "(", e.display, ")" }) else e.display, .bound = e.bound, .ops = e.ops, .constant = e.constant };
+            },
+            .op => {
+                if (!std.mem.eql(u8, t.text, "(")) return error.Refused;
+                p.depth += 1;
+                const e = try p.sum();
+                if (!p.peek(")")) return error.Refused;
+                p.depth -= 1;
+                p.i += 1;
+                return .{ .source = try cat(p.a, &.{ "(", e.source, ")" }), .display = try cat(p.a, &.{ "(", e.display, ")" }), .bound = e.bound, .ops = e.ops, .constant = e.constant };
+            },
+        }
+    }
+};
+
+fn cat(a: Allocator, parts: []const []const u8) Allocator.Error![]u8 {
+    return std.mem.concat(a, u8, parts);
+}
+
+/// Decimal digits of a literal (hex: of its value).
+fn litDigits(lit: []const u8) u32 {
+    if (!std.mem.startsWith(u8, lit, "0x")) return @intCast(@min(lit.len, inf));
+    const h = lit.len - 2;
+    if (h <= 32) {
+        const v = std.fmt.parseInt(u128, lit[2..], 16) catch return inf;
+        var d: u32 = 1;
+        var x = v;
+        while (x >= 10) : (x /= 10) d += 1;
+        return d;
+    }
+    return @intCast(@min(h * 121 / 100 + 1, inf));
+}
+
+/// Digits of a constant base raised to `k`, from logarithms of the literal (its own width, not an answer).
+fn constPowDigits(source: []const u8, k: u32) u32 {
+    var s = source;
+    while (s.len >= 2 and s[0] == '(' and s[s.len - 1] == ')') s = s[1 .. s.len - 1];
+    const v: f64 = if (std.mem.startsWith(u8, s, "0x"))
+        @floatFromInt(std.fmt.parseInt(u128, s[2..], 16) catch return inf)
+    else
+        std.fmt.parseFloat(f64, s) catch return inf;
+    if (v < 2 or k == 0) return 1;
+    const d = @as(f64, @floatFromInt(k)) * std.math.log10(v);
+    return @intFromFloat(@min(@floor(d + 1e-9) + 1, @as(f64, inf)));
+}
+
+fn lookup(names: []const Name, n: []const u8) ?Expr {
+    for (names) |m| if (std.mem.eql(u8, m.name, n)) return m.expr;
+    return null;
+}
diff --git a/zig/src/core/runner_trace_test.zig b/zig/src/core/runner_trace_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..db21ad37f49eded9c02511502c18ef31d3a87c3b
--- /dev/null
+++ b/zig/src/core/runner_trace_test.zig
@@ -0,0 +1,318 @@
+//! Form trace: real census reasoning lines own `[exact: …]`, ambiguous ones abstain; scanner and lane-host replies.
+const std = @import("std");
+const trace = @import("runner_trace.zig");
+const scan = @import("runner_scan.zig");
+const rapi = @import("runner_api.zig");
+const rt = @import("runner_test.zig");
+
+const gpa = std.testing.allocator;
+
+/// The Python source a line states (after `lines` defined its names), or null.
+fn stated(lines: []const []const u8) !?[]u8 {
+    var t = trace.Tracer.init(gpa);
+    defer t.deinit();
+    var last: ?[]u8 = null;
+    for (lines) |l| {
+        if (last) |x| gpa.free(x);
+        last = null;
+        if (try t.line(l)) |f| last = try gpa.dupe(u8, f.source);
+    }
+    return last;
+}
+
+fn expectStated(lines: []const []const u8, want: []const u8) !void {
+    const got = try stated(lines) orelse {
+        std.debug.print("abstained: {s}\n", .{lines[lines.len - 1]});
+        return error.TestExpectedStatement;
+    };
+    defer gpa.free(got);
+    try std.testing.expectEqualStrings(want, got);
+}
+
+fn expectNone(lines: []const []const u8) !void {
+    if (try stated(lines)) |got| {
