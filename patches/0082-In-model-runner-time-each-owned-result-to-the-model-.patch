From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Mon, 2 Nov 2026 03:59:38 +0700
Subject: [PATCH 082/207] In-model runner: time each owned result to the
 model's next token

After an owned result's forced tokens commit, the runner logs how long the model's next token took from
the result settling, and the reply's runner summary sums it as resume_ms.
---
 zig/src/core/runner.zig      | 15 ++++++++++++++-
 zig/src/core/runner_test.zig |  5 ++++-
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/zig/src/core/runner.zig b/zig/src/core/runner.zig
index b3157fa96c7e8fa010629a61d364af5a3e648f11..c90b1055c6e902397e8d2643ed7c41402d51f9cf 100644
--- a/zig/src/core/runner.zig
+++ b/zig/src/core/runner.zig
@@ -131,6 +131,8 @@ pub const Session = struct {
     owned_n: u32 = 0,
     abstained_n: u32 = 0,
     held_ms: u64 = 0, // summed over the reply's holds
+    forcing: ?struct { at: u64, left: usize, cell: u32 } = null, // an owned result's forced tokens still to commit
+    resume_ms: u64 = 0, // summed: an owned result's settling to the model's first token after it
     broken: bool = false, // out of memory once: no more cells, no more holds
 
     pub fn hook(s: *Session) lanes.stream.RunnerHook {
@@ -148,6 +150,15 @@ pub const Session = struct {
 
     fn feed(s: *Session, token: u32, think_open: bool, can_hold: bool) Allocator.Error!bool {
         const tx = s.r.text.?;
+        if (s.forcing) |*r| {
+            // the forced tokens commit first; the next token is the model's own, one round after the result settled
+            if (r.left > 0) r.left -= 1 else {
+                const ms = (nowNs() -| r.at) / std.time.ns_per_ms;
+                s.resume_ms += ms;
+                log.info("reply {d} cell {d}: model's next token {d} ms after its result", .{ s.id, r.cell, ms });
+                s.forcing = null;
+            }
+        }
         const ev = try s.scan.feed(s.r.gpa, tx.bytes(tx.ctx, token), think_open);
         if (ev.closed) |c| try s.open(c);
         const t = ev.trigger orelse return false;
@@ -226,6 +237,7 @@ pub const Session = struct {
         s.owned_n += 1;
         c.told = .owned;
         c.owned_tokens = @intCast(ids.len);
+        s.forcing = .{ .at = nowNs(), .left = ids.len, .cell = w.index };
         log.info("reply {d} cell {d} ({s} {t}): owned {d} tokens, {t} after {d} steps, run {d} ms, held {d} ms", .{ s.id, w.index, c.lang, c.form, ids.len, res.status, res.steps, res.exec_ns / std.time.ns_per_ms, held_ms });
         return ids;
     }
@@ -242,6 +254,7 @@ pub const Session = struct {
                 s.owned_n += 1;
                 c.told = .owned;
                 c.owned_tokens = @intCast(ids.len);
+                s.forcing = .{ .at = nowNs(), .left = ids.len, .cell = index };
                 const res = c.result.?;
                 log.info("reply {d} cell {d} (trace): owned {d} tokens, {d} steps, run {d} ms, held {d} ms", .{ s.id, index, ids.len, res.steps, res.exec_ns / std.time.ns_per_ms, held_ms });
                 return ids;
@@ -360,7 +373,7 @@ pub const Session = struct {
         w.writeByte('{') catch return "";
         for (forms, [_][]const u8{ "fence", "repl", "inline", "trace" }) |f, name|
             w.print("\"{s}\":{{\"closed\":{d},\"owned\":{d},\"abstained\":{d},\"owned_tokens\":{d}}},", .{ name, f[0], f[1], f[2], f[3] }) catch return "";
-        w.print("\"owned_by\":{{\"calc\":{d},\"elf\":{d},\"graph\":{d}}},\"held_ms\":{d}}}", .{ kinds[0], kinds[1], kinds[2], s.held_ms }) catch return "";
+        w.print("\"owned_by\":{{\"calc\":{d},\"elf\":{d},\"graph\":{d}}},\"held_ms\":{d},\"resume_ms\":{d}}}", .{ kinds[0], kinds[1], kinds[2], s.held_ms, s.resume_ms }) catch return "";
         return w.buffered();
     }
 
diff --git a/zig/src/core/runner_test.zig b/zig/src/core/runner_test.zig
index 9ea8143c42362c43c0a5aef83258dcae858a021a..d767d5c59e3d81edacfe69e9b5518eb6c7a3ae62 100644
--- a/zig/src/core/runner_test.zig
+++ b/zig/src/core/runner_test.zig
@@ -382,6 +382,9 @@ test "runner: a reply's runtime block counts its cells by form, owned tokens and
     // the product and its newline: one token a character
     try std.testing.expectEqualStrings("{\"fence\":{\"closed\":1,\"owned\":1,\"abstained\":0,\"owned_tokens\":61},\"repl\":{\"closed\":0,\"owned\":0,\"abstained\":0,\"owned_tokens\":0},\"inline\":{\"closed\":0,\"owned\":0,\"abstained\":0,\"owned_tokens\":0},\"trace\":{\"closed\":0,\"owned\":0,\"abstained\":0,\"owned_tokens\":0},\"owned_by\":{\"calc\":1,\"elf\":0,\"graph\":0},\"held_ms\":", sums[0][0 .. std.mem.lastIndexOf(u8, sums[0], "\"held_ms\":").? + 10]);
     try std.testing.expect(std.mem.startsWith(u8, sums[1], "{\"fence\":{\"closed\":1,\"owned\":0,\"abstained\":1,\"owned_tokens\":0}"));
+    // the owned product's tokens committed, then the model's own: its resume was timed; an abstain forces nothing
+    try std.testing.expect(std.mem.indexOf(u8, sums[0], ",\"resume_ms\":") != null);
+    try std.testing.expect(std.mem.endsWith(u8, sums[1], ",\"resume_ms\":0}"));
     var off: [1][]u8 = undefined;
     var lone = [_]Model{.{ .lead = mul_cell }};
     freeAll(try replies(&lone, .{ .runner = false, .summaries = &off }, &back));
@@ -398,7 +401,7 @@ test "runner: a held stream resumes as soon as its run settles, not after the id
     freeAll(try replies(&m, .{ .summaries = &sums, .delay = 40 }, &back));
     defer gpa.free(sums[0]);
     const at = std.mem.lastIndexOf(u8, sums[0], "\"held_ms\":").? + 10;
-    const held = try std.fmt.parseInt(u64, sums[0][at .. sums[0].len - 1], 10);
+    const held = try std.fmt.parseInt(u64, sums[0][at..std.mem.indexOfScalarPos(u8, sums[0], at, ',').?], 10);
     try std.testing.expect(held < 1000);
 }
 
