diff --git a/zig/src/families/deepseek_v41/model_supervisor.zig b/zig/src/families/deepseek_v41/model_supervisor.zig
new file mode 100644
index 0000000000000000000000000000000000000000..06df15391c0d12edbb3532f395caed86198f2ee9
--- /dev/null
+++ b/zig/src/families/deepseek_v41/model_supervisor.zig
@@ -0,0 +1,38 @@
+//! An owned host thread turns a published context fault into fail-fast without waiting for an HTTP health poll.
+const std = @import("std");
+
+pub const Supervisor = struct {
+    io: std.Io,
+    ctx: *anyopaque,
+    healthy: *const fn (*anyopaque) bool,
+    fail: *const fn (*anyopaque, anyerror) void,
+    stopping: std.atomic.Value(bool) = .init(false),
+    failed: std.atomic.Value(bool) = .init(false),
+    thread: ?std.Thread = null,
+
+    pub fn start(s: *Supervisor) !void {
+        std.debug.assert(s.thread == null);
+        s.thread = try std.Thread.spawn(.{}, run, .{s});
+    }
+
+    /// The model joins this before its TP session, context or callback owner can be destroyed.
+    pub fn stop(s: *Supervisor) void {
+        s.stopping.store(true, .release);
+        if (s.thread) |thread| thread.join();
+        s.thread = null;
+    }
+
+    /// Readiness was withdrawn by the context's sticky-fault publisher before this notification.
+    pub fn check(s: *Supervisor) bool {
+        if (s.healthy(s.ctx)) return false;
+        if (!s.failed.swap(true, .acq_rel)) s.fail(s.ctx, error.CudaContextLost);
+        return true;
+    }
+
+    fn run(s: *Supervisor) void {
+        while (!s.stopping.load(.acquire)) {
+            if (s.check()) return;
+            std.Io.sleep(s.io, .fromMilliseconds(100), .awake) catch {};
+        }
+    }
+};
diff --git a/zig/src/families/deepseek_v41/model_supervisor_test.zig b/zig/src/families/deepseek_v41/model_supervisor_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..47588dc518db165e120e76904602ea9d2074ff9d
--- /dev/null
+++ b/zig/src/families/deepseek_v41/model_supervisor_test.zig
@@ -0,0 +1,74 @@
+//! Fault notification is independent of request/health polls, and its thread belongs to the model.
+const std = @import("std");
+const Supervisor = @import("model_supervisor.zig").Supervisor;
+const tp = @import("tp");
+const t = std.testing;
+const Case = struct {
+    healthy: std.atomic.Value(bool) = .init(true),
+    calls: std.atomic.Value(u32) = .init(0),
+    before_health: std.atomic.Value(bool) = .init(false),
+    fate: ?*tp.Fate = null,
+    fn read(ctx: *anyopaque) bool {
+        return self(ctx).healthy.load(.acquire);
+    }
+    fn fail(ctx: *anyopaque, err: anyerror) void {
+        const c = self(ctx);
+        c.before_health.store(c.healthy.load(.acquire), .release);
+        if (c.fate) |f| f.fatal("CUDA health", err);
+        _ = c.calls.fetchAdd(1, .acq_rel);
+    }
+    fn self(ctx: *anyopaque) *Case {
+        return @ptrCast(@alignCast(ctx));
+    }
+    fn supervisor(c: *Case) Supervisor {
+        return .{ .io = t.io, .ctx = c, .healthy = read, .fail = fail };
+    }
+};
+var exits: std.atomic.Value(u32) = .init(0);
+fn exited(code: u8) void {
+    std.debug.assert(code == 70);
+    _ = exits.fetchAdd(1, .acq_rel);
+}
+fn wait(c: *Case) !void {
+    const until = std.Io.Clock.awake.now(t.io).toNanoseconds() + 5 * std.time.ns_per_s;
+    while (c.calls.load(.acquire) == 0) {
+        if (std.Io.Clock.awake.now(t.io).toNanoseconds() >= until) return error.MissingFailureNotification;
+        try std.Io.sleep(t.io, .fromMilliseconds(1), .awake);
+    }
+}
+test "model supervisor: a sticky context fault reaches each rank's fate after health is withdrawn" {
+    exits.store(0, .release);
+    for (0..2) |rank| {
+        var f = tp.Fate.init(.{ .rank = @intCast(rank), .world = 2, .grace_ns = 0 }, @splat(-1));
+        f.exit_fn = exited;
+        defer f.close();
+        var c: Case = .{ .fate = &f };
+        var s = c.supervisor();
+        try t.expect(!s.check());
+        c.healthy.store(false, .release);
+        try t.expect(s.check());
+        try t.expect(s.check());
+        try t.expectEqual(@as(u32, 1), c.calls.load(.acquire));
+        try t.expect(!c.before_health.load(.acquire));
+        try t.expect(std.mem.indexOf(u8, f.reason(), "CudaContextLost") != null);
+    }
+    try t.expectEqual(@as(u32, 2), exits.load(.acquire));
+}
+test "model supervisor: a live independent thread notices a fault without a health poll" {
+    var c: Case = .{};
+    var s = c.supervisor();
+    try s.start();
+    defer s.stop();
+    c.healthy.store(false, .release);
+    try wait(&c);
+    try t.expectEqual(@as(u32, 1), c.calls.load(.acquire));
+}
+test "model supervisor: a healthy idle owner stops and joins without firing" {
+    var c: Case = .{};
+    var s = c.supervisor();
+    try s.start();
+    s.stop();
+    try t.expect(s.thread == null);
+    c.healthy.store(false, .release);
+    try t.expectEqual(@as(u32, 0), c.calls.load(.acquire));
+}
