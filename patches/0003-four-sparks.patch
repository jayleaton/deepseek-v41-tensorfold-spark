+def test_dspark_delta_shards_follow_the_block_split():
+    from tensorfold.families.deepseek_v41.cuda import dsparkdelta as DD
+
+    A, B = torch.randn(8, 2304), torch.randn(2304, 8)
+    parts = [DD.shard("col", A, B, r, 4)[1] for r in range(4)]
+    assert [p.shape[0] for p in parts] == [640, 640, 512, 512]
+    assert torch.equal(torch.cat(parts), B)
+    rows = [DD.shard("row", A, B, r, 4)[0] for r in range(4)]
+    assert torch.equal(torch.cat(rows, 1), A)
+    assert [DD.shard("col", A, torch.randn(1024, 8), r, 2)[1].shape[0] for r in range(2)] == [512, 512]
