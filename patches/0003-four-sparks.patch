+# -- the TCP plan link -------------------------------------------------------------------------------------------
+def free_port() -> int:
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        return s.getsockname()[1]
+
+
+def link_world(world: int, port: int, order, before=None, timeout: float = 20.0):
+    """Rank 0 and the followers ``order`` (ranks; connected in that order) on threads; ``before``: run first."""
+
+    out, err = {}, {}
+
+    def lead():
+        try:
+            out[0] = PL.TcpLink(0, "127.0.0.1", port, timeout_s=timeout, world=world)
+        except BaseException as e:      # noqa: BLE001
+            err[0] = e
+
+    def follow(r, w=world):
+        try:
+            out[r] = PL.TcpLink(r, "127.0.0.1", port, timeout_s=timeout, world=w)
+        except BaseException as e:      # noqa: BLE001
+            err[r] = e
+
+    t0 = threading.Thread(target=lead)
+    t0.start()
+    if before is not None:
+        before()
+    ts = []
+    for r in order:
+        t = threading.Thread(target=follow, args=r if isinstance(r, tuple) else (r,))
+        t.start()
+        t.join(timeout=timeout)
+        ts.append(t)
+    t0.join(timeout=timeout + 5)
+    return out, err
+
+
+def test_plan_link_four_ranks_in_rank_order():
+    port = free_port()
+    out, err = link_world(4, port, [3, 1, 2])
+    assert not err
+    lead = out[0]
+    lead.send([7, 8, 9])
+    for r in (1, 2, 3):
+        assert out[r].recv() == [7, 8, 9]
+    peers = [c.getpeername()[1] for c in lead.conns]
+    mine = [out[r].conn.getsockname()[1] for r in (1, 2, 3)]
+    assert peers == mine                                    # conns[i] is rank i + 1
+    for v in out.values():
+        v.close()
+
+
+def test_plan_link_refuses_strays_duplicates_and_other_worlds():
+    port = free_port()
+
+    def stray():
+        import time
+
+        for _ in range(200):
+            try:
+                s = socket.create_connection(("127.0.0.1", port), timeout=1)
+                break
+            except OSError:
+                time.sleep(0.02)
+        s.sendall(b"GET / HTTP/1.0\r\n\r\n")                # a port scanner / a web client
+        assert s.recv(1) in (PL.REFUSED, b"")
+        s.close()
+
+    out, err = link_world(4, port, [1, (2, 2), 1, 2, 3], before=stray)
+    # refused: rank 2 of a world of 2, then a second rank 1; then ranks 2 and 3 join
+    assert set(err) == {1, 2} and all(isinstance(e, ConnectionError) for e in err.values())
+    assert set(out) == {0, 1, 2, 3}
+    out[0].send([1])
+    assert [out[r].recv() for r in (1, 2, 3)] == [[1], [1], [1]]
+    for v in out.values():
+        v.close()
+
+
+def test_plan_link_names_the_missing_rank():
+    port = free_port()
+    out, err = link_world(4, port, [1, 3], timeout=2.0)
+    assert isinstance(err.get(0), TimeoutError) and "[2]" in str(err[0])
