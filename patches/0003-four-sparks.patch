+# -- G19's fail-fast and memory floor at four ranks ------------------------------------------------------------------
+def fates_of_four(usable=None):
+    """Rank 0 with a fate channel to each of three followers (socket pairs), every exit recorded."""
+
+    import io
+    import socket as S
+
+    from tensorfold.families.deepseek_v41.cuda import failfast as FF
+
+    exits = {r: [] for r in range(4)}
+    pairs = [S.socketpair() for _ in range(3)]
+    f0 = FF.Fate(0, [FF.Channel(0, a, r + 1) for r, (a, _) in enumerate(pairs)], exit_fn=exits[0].append,
+                 grace_s=0.05, report_s=0.05, out=io.StringIO())
+    fs = [FF.Fate(r + 1, FF.Channel(r + 1, b, 0), exit_fn=exits[r + 1].append, grace_s=0.05, report_s=0.05,
+                  usable=(lambda r=r: (usable or [8, 6, 9])[r] << 30), out=io.StringIO()) for r, (_, b) in enumerate(pairs)]
+    return f0, fs, exits
+
+
+def test_failfast_four_ranks_one_follower_fails_all_exit():
+    import time
+
+    f0, fs, exits = fates_of_four()
+    for f in [f0, *fs]:
+        f.start()
+    time.sleep(0.3)
+    fs[1].fatal(RuntimeError("boom"), "prefill")                    # rank 2
+    deadline = time.monotonic() + 5
+    while time.monotonic() < deadline and not all(exits[r] for r in range(4)):
+        time.sleep(0.05)
+    assert all(exits[r] == [70] for r in range(4)), exits
+    assert "rank 2 failed in prefill" in f0.dead
+
+
+def test_floor_reads_the_tightest_of_three_followers():
+    import time
+
+    from tensorfold.families.deepseek_v41.cuda import memory as M
+
+    f0, fs, _ = fates_of_four([8, 6, 9])
+    for f in [f0, *fs]:
+        f.start()
+    deadline = time.monotonic() + 5
+    while time.monotonic() < deadline and f0.peer_mem() is None:
+        time.sleep(0.05)
+    got = f0.peer_mem()
+    assert got is not None and got[0] == 6 << 30 and got[2] == 2   # rank 2 is the tightest
+    floor = M.Floor(5.0, 4.0, meminfo=lambda: {"MemFree": 20 << 30, "MemAvailable": 20 << 30}, peer=f0.peer_mem)
+    assert floor.tight() == (2, 6 << 30)
+    assert floor.check(1 << 30) and not floor.check(3 << 30)         # 6 - 3 < 4 GiB hard floor on rank 2
+    for f in [f0, *fs]:
+        f.close()
