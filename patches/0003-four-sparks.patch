+class Fanout:
+    """Rank 0's plan to every follower (the batcher's ``Link``)."""
+
+    def __init__(self, world: int) -> None:
+        self.q = [queue.Queue() for _ in range(world)]
+
+    def sender(self):
+        outer = self
+
+        class S:
+            def send(self, plan):
+                for q in outer.q[1:]:
+                    q.put(list(plan))
+
+        return S()
+
+    def receiver(self, r: int):
+        q = self.q[r]
+
+        class R:
+            def recv(self):
+                return q.get(timeout=300)
+
+        return R()
+
