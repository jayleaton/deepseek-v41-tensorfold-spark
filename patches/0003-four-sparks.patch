+def test_bmq_32_clamps_to_16_heads(monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda.csa2 import attn_pf
+
+    monkeypatch.setenv("TF_DSV41_PREFILL_ATTN_BMQ", "32")
+    assert attn_pf.config(64)[0] == 32 and attn_pf.config(32)[0] == 32     # TP=1 / TP=2
+    assert attn_pf.config(16)[0] == 16                                      # TP=4
+    assert attn_pf.config(8)[0] == 32                                       # synthetic: chunk kernels (backend)
