+    assert _tier_extra(256, 2) == {"page": 256}
+    h = lambda extra: sessdisk.compat_hash(sessdisk.compat_ident(image="x", knobs={}, layout={}, extra=extra))  # noqa: E731
+    assert h(_tier_extra(256, 2)) == h({"page": 256})
+    assert h(_tier_extra(256, 4)) != h(_tier_extra(256, 2))
