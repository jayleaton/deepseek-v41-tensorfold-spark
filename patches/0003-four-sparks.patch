+def test_candidates_pinned_buffer_grows_before_the_forward(ck4):
+    """``cand_reserve`` runs before a window's forward is queued, sized for the merged rows (``rows x 2 c``,
+    c = min(count, world x min(count, widest slice))): growing pinned memory after it waited on a forward whose
+    Engram gate was still waiting for row reads (top_k ~32,000-40,000 timed out every follower on four Sparks)."""
+
+    from tensorfold.families.deepseek_v41.cuda.protocol import Rows
+
+    fw = DF.forward(ck4, slots=1, dspark=False)
+    order = []
+    real_reserve, real_run = fw.cand_reserve, fw.run
+    fw.cand_reserve = lambda rows, count: order.append(("reserve", rows, count)) or real_reserve(rows, count)
+    fw.run = lambda segs, **k: order.append(("forward",)) or real_run(segs, **k)
+    fw.prefill([__import__("tensorfold.families.deepseek_v41.cuda.protocol", fromlist=["Piece"]).Piece(
+        0, 0, tuple(PROMPTS[0][:-1]))], mode="full")
+    order.clear()
+    fw.window([Rows(0, len(PROMPTS[0]) - 1, (PROMPTS[0][-1],))], count=300)
+    assert order[:2] == [("reserve", 1, 300), ("forward",)]
+
+
+def test_candidate_warmup_on_four_ranks(ck4):
+    """``cand_warm`` (boot, every rank): every width class through the gather, the merge and the device sampler,
+    at counts past the narrow slices, with equal exchange sizes on four ranks."""
+
+    pair = FK.ThreadPair(4)
+    comms = pair.comms()
+
+    def go(r):
+        f = DF.forward(ck4, rank=r, world=4, comm=comms[r], dspark=False)
+        f.cand_warm()
+        return True
+
+    assert all(pair.run([lambda r=r: go(r) for r in range(4)]))
+
