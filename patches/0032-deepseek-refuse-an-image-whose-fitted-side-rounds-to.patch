From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Wed, 28 Oct 2026 22:57:31 +0700
Subject: [PATCH 32/72] deepseek: refuse an image whose fitted side rounds to
 zero

ImageOps.pad's contain can round a very narrow side to 0; Pillow's resize
raises, while Coeffs.init divided by that zero output size. Refuse a zero
fitted or requested dimension as ImageTooSmall, guard the resampler's public
entry, compare planned spans in u64, and test tall and wide valid images at
a low token budget.
---
 zig/src/families/deepseek_v41/vision/prep.zig | 23 ++++++++++++++---
 .../families/deepseek_v41/vision/resample.zig | 25 +++++++++++++++++--
 2 files changed, 43 insertions(+), 5 deletions(-)

diff --git a/zig/src/families/deepseek_v41/vision/prep.zig b/zig/src/families/deepseek_v41/vision/prep.zig
index 32b5c7a4d4d7e7d154d97b26225d5435c96bd14a..c9eedc5eadb7366789c60349ef7f66da558f829f 100644
--- a/zig/src/families/deepseek_v41/vision/prep.zig
+++ b/zig/src/families/deepseek_v41/vision/prep.zig
@@ -10,7 +10,7 @@ pub const IMAGE_TOKEN: u32 = 129264;
 
 pub const Type = enum(i8) { text = -1, start = 0, image = 1, newline = 2, end = 3 };
 
-pub const Error = error{ NoGrid, BadSettings } || Allocator.Error;
+pub const Error = error{ NoGrid, BadSettings, ImageTooSmall } || Allocator.Error;
 
 extern "c" fn pow(x: f64, y: f64) f64; // Python's float ** (libm), not a Zig reimplementation
 
@@ -132,6 +132,10 @@ pub fn spanLen(h: u32, w: u32) u32 {
     return h * (w + 1) + 2;
 }
 
+fn spanLen64(h: u32, w: u32) u64 {
+    return @as(u64, h) * (@as(u64, w) + 1) + 2;
+}
+
 /// ``llm_grid``: the aligner's grid of a pixel size.
 fn llmGrid(height: f64, width: f64, patch: u32, ratio: u32) [2]u32 {
     const p: f64 = @floatFromInt(patch);
@@ -174,12 +178,12 @@ pub fn plan(width0: u32, height0: u32, s: *const Settings) Error![4]u32 {
     var bw = @ceil(width / p) * p;
     var bh = @ceil(height / p) * p;
     var g = llmGrid(bh, bw, s.patch, s.downsample);
-    if (spanLen(g[0], g[1]) > most) {
+    if (spanLen64(g[0], g[1]) > @as(u64, most)) {
         const hw = solve(height, width, s.patch, s.downsample, most);
         bh = hw[0];
         bw = hw[1];
         g = llmGrid(bh, bw, s.patch, s.downsample);
-        if (spanLen(g[0], g[1]) > most) return error.NoGrid;
+        if (spanLen64(g[0], g[1]) > @as(u64, most)) return error.NoGrid;
     }
     return .{ g[0], g[1], @intFromFloat(bh), @intFromFloat(bw) };
 }
@@ -279,3 +283,16 @@ test "span types and the planned grid of a small image" {
     try std.testing.expectEqual(@as(u16, 0xbf80), norm_table[0]); // -1.0
     try std.testing.expectEqual(@as(u16, 0x3f80), norm_table[255]); // 1.0
 }
+
+test "a valid tall or wide image whose fitted side rounds to zero is refused" {
+    const a = std.testing.allocator;
+    for ([_][2]u32{ [2]u32{ 1, 100_000 }, [2]u32{ 100_000, 1 } }) |wh| {
+        var rgb: pixels.Rgb = .{ .w = wh[0], .h = wh[1], .data = try a.alloc(u8, @as(usize, wh[0]) * wh[1] * 3) };
+        defer rgb.deinit(a);
+        @memset(rgb.data, 0);
+        for ([_]u32{ 5, 128, 1024 }) |most| { // the minimum, the reproducer's and the default budget
+            var s: Settings = .{ .cap_tokens = most };
+            try std.testing.expectError(error.ImageTooSmall, preprocess(a, rgb, &s));
+        }
+    }
+}
diff --git a/zig/src/families/deepseek_v41/vision/resample.zig b/zig/src/families/deepseek_v41/vision/resample.zig
index a26cc0592d67cc2cfd7a6034216220075b380585..6bc091df641ce66b09d585ee633f5fa42614d2b2 100644
--- a/zig/src/families/deepseek_v41/vision/resample.zig
+++ b/zig/src/families/deepseek_v41/vision/resample.zig
@@ -6,6 +6,8 @@ const Rgb = pixels.Rgb;
 
 const PRECISION_BITS = 32 - 8 - 2;
 
+pub const Error = error{ImageTooSmall} || Allocator.Error;
+
 fn bicubic(x0: f64) f64 {
     const a = -0.5;
     const x = @abs(x0);
@@ -75,7 +77,10 @@ fn clip8(ss: i32) u8 {
 }
 
 /// ``ImagingResample(im, w, h, BICUBIC, (0, 0, W, H))`` of an RGB image.
-pub fn resize(gpa: Allocator, src: Rgb, w: u32, h: u32) Allocator.Error!Rgb {
+pub fn resize(gpa: Allocator, src: Rgb, w: u32, h: u32) Error!Rgb {
+    // Pillow's ImagingResize: a dimension below one pixel is refused, not fitted
+    if (w == 0 or h == 0 or src.w == 0 or src.h == 0) return error.ImageTooSmall;
+    if (src.w > std.math.maxInt(i32) or src.h > std.math.maxInt(i32)) return error.ImageTooSmall;
     const need_h = w != src.w;
     const need_v = h != src.h;
     var vert = try Coeffs.init(gpa, src.h, h);
@@ -140,7 +145,8 @@ pub fn roundHalfEven(x: f64) i64 {
 }
 
 /// ``ImageOps.pad(image, (bw, bh), color=(127, 127, 127))``: ``contain`` (aspect kept, BICUBIC), centred.
-pub fn pad(gpa: Allocator, src: Rgb, bw: u32, bh: u32, fill: u8) Allocator.Error!Rgb {
+pub fn pad(gpa: Allocator, src: Rgb, bw: u32, bh: u32, fill: u8) Error!Rgb {
+    if (src.w == 0 or src.h == 0 or bw == 0 or bh == 0) return error.ImageTooSmall;
     const im_ratio = @as(f64, @floatFromInt(src.w)) / @as(f64, @floatFromInt(src.h));
     const dest_ratio = @as(f64, @floatFromInt(bw)) / @as(f64, @floatFromInt(bh));
     var sw = bw;
@@ -154,6 +160,8 @@ pub fn pad(gpa: Allocator, src: Rgb, bw: u32, bh: u32, fill: u8) Allocator.Error
             if (nw != bw) sw = @intCast(nw);
         }
     }
+    // Pillow 12.3's contain can round a fitted side to 0; its resize then raises, so refuse it here
+    if (sw == 0 or sh == 0) return error.ImageTooSmall;
     var resized: Rgb = if (sw == src.w and sh == src.h) .{ .w = sw, .h = sh, .data = try gpa.dupe(u8, src.data) } else try resize(gpa, src, sw, sh);
     if (sw == bw and sh == bh) return resized;
     defer resized.deinit(gpa);
@@ -171,3 +179,16 @@ test "round half to even, as Python's round" {
     try std.testing.expectEqual(@as(i64, 4), roundHalfEven(3.5));
     try std.testing.expectEqual(@as(i64, 3), roundHalfEven(2.51));
 }
+
+test "a fitted or requested zero dimension is refused, not divided by" {
+    const a = std.testing.allocator;
+    var src = pixels.Rgb{ .w = 1, .h = 1, .data = try a.alloc(u8, 3) };
+    defer src.deinit(a);
+    @memset(src.data, 0);
+    try std.testing.expectError(error.ImageTooSmall, resize(a, src, 0, 1));
+    try std.testing.expectError(error.ImageTooSmall, resize(a, src, 1, 0));
+    var tall = pixels.Rgb{ .w = 1, .h = 100_000, .data = try a.alloc(u8, 100_000 * 3) };
+    defer tall.deinit(a);
+    @memset(tall.data, 0);
+    try std.testing.expectError(error.ImageTooSmall, pad(a, tall, 42, 2646, 127));
+}
