From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Wed, 4 Nov 2026 20:33:39 +0700
Subject: [PATCH 196/207] dsv41 server: owned trim limits never split a code
 point

T5-OWNED-WS-REVIEW: exact spelling of the whole raw text does not put an
owned interval's ends on code point boundaries. Raw "x\n" U+00A0 (78 0a c2
a0) with a record owning only the C2 kept hi=3 and stripped the A0, so the
content ended 78 0a c2: invalid UTF-8 from valid input.

The trims now widen the owned interval to whole code points of the text they
cut (reply_text.aligned, in keptEnd and stripOwned). The added bytes are kept
so the text stays valid; Owned itself still names only the engine's bytes.

Tests (runner_owned.zig): T5's case through runner_owned.of, parseOwned and
finishedProse, and right/left ends inside 2-, 3- and 4-byte code points,
each through stripOwned and parseOwned; every trimmed output in these tests
is checked with utf8ValidateSlice. Negative controls for both ends of the
alignment.
---
 zig/src/server/reply_text.zig   | 13 ++++++--
 zig/src/server/runner_owned.zig | 57 +++++++++++++++++++++++++++++----
 2 files changed, 61 insertions(+), 9 deletions(-)

diff --git a/zig/src/server/reply_text.zig b/zig/src/server/reply_text.zig
index e014e860714b0531b409d4ddda3e64b369a61d69..0783133560a3afaadcb04149eda9ca9d5253a668 100644
--- a/zig/src/server/reply_text.zig
+++ b/zig/src/server/reply_text.zig
@@ -261,7 +261,16 @@ pub const Owned = struct {
 /// ``pyRstrip(s).len``, never below an owned byte (the engine's, so its span stays in the text the client gets).
 fn keptEnd(s: []const u8, owned: ?Owned) usize {
     const o = owned orelse return pyRstrip(s).len;
-    return if (o.hi <= s.len) @max(pyRstrip(s).len, o.hi) else pyRstrip(s).len; // a span past `s`: not its offsets
+    return if (o.hi <= s.len) @max(pyRstrip(s).len, aligned(s, o).hi) else pyRstrip(s).len; // a span past `s`: not its offsets
+}
+
+/// `o` widened to whole code points of `s`, so a trim never splits one (the bytes it adds are kept, not owned).
+fn aligned(s: []const u8, o: Owned) Owned {
+    var lo = o.lo;
+    var hi = o.hi;
+    while (lo > 0 and lo < s.len and s[lo] & 0xc0 == 0x80) lo -= 1;
+    while (hi < s.len and s[hi] & 0xc0 == 0x80) hi += 1;
+    return .{ .lo = lo, .hi = hi };
 }
 
 /// ``pyStrip(s)`` with the engine's owned bytes kept: `owned` is in `s`'s offsets (Owned.shift moves it).
@@ -269,7 +278,7 @@ pub fn stripOwned(s: []const u8, owned: ?Owned) []const u8 {
     const lead = s.len - pyLstrip(s).len;
     const o = owned orelse return pyStrip(s);
     if (o.hi > s.len) return pyStrip(s);
-    return s[@min(lead, o.lo)..keptEnd(s, o)];
+    return s[@min(lead, aligned(s, o).lo)..keptEnd(s, o)];
 }
 
 const harmony_final = "<|channel|>final<|message|>";
diff --git a/zig/src/server/runner_owned.zig b/zig/src/server/runner_owned.zig
index 081022c62e0450b64b1d0a6b7ed0ebf333723b06..3deddf230cf63d189e7e9ab72dcad06560e5a208 100644
--- a/zig/src/server/runner_owned.zig
+++ b/zig/src/server/runner_owned.zig
@@ -73,15 +73,58 @@ test "runner projection: owned bytes stay through the finish strip, the cut stri
     const call = "<tool_call>{\"name\":\"f\",\"arguments\":{}}</tool_call>";
     const text = trace ++ "\n" ++ call;
     const own: Owned = .{ .lo = 0, .hi = trace.len };
-    try std.testing.expectEqualStrings(trace, try reply_text.finishedProse(a, text, own));
-    try std.testing.expectEqualStrings(trace[0 .. trace.len - 1], try reply_text.finishedProse(a, text, null));
-    try std.testing.expectEqualStrings(trace[0 .. trace.len - 1], try reply_text.finishedProse(a, text, .{ .lo = 0, .hi = text.len }));
-    try std.testing.expectEqualStrings(trace, try reply_text.cutProse(a, trace ++ "\n<tool_call>{\"name\":\"f\",\"argu", own));
+    try std.testing.expectEqualStrings(trace, try expectValid(try reply_text.finishedProse(a, text, own)));
+    try std.testing.expectEqualStrings(trace[0 .. trace.len - 1], try expectValid(try reply_text.finishedProse(a, text, null)));
+    try std.testing.expectEqualStrings(trace[0 .. trace.len - 1], try expectValid(try reply_text.finishedProse(a, text, .{ .lo = 0, .hi = text.len })));
+    try std.testing.expectEqualStrings(trace, try expectValid(try reply_text.cutProse(a, trace ++ "\n<tool_call>{\"name\":\"f\",\"argu", own)));
     const tools = [_]json.Value{(try json.parse(a, "{\"type\":\"function\",\"function\":{\"name\":\"f\",\"parameters\":{\"type\":\"object\",\"properties\":{}}}}")).ok};
     const parsed = try tool_parse.parseOwned(a, " \n" ++ text, &tools, null, .{ .lo = 2, .hi = 2 + trace.len });
-    try std.testing.expectEqualStrings(trace, parsed.content);
+    try std.testing.expectEqualStrings(trace, try expectValid(parsed.content));
     try std.testing.expectEqual(Owned{ .lo = 0, .hi = trace.len }, parsed.owned.?);
     // an owned lead blank stays too, and a span past the text is no offsets of it
-    try std.testing.expectEqualStrings(" 7\n", reply_text.stripOwned("\n 7\n\n", .{ .lo = 1, .hi = 4 }));
-    try std.testing.expectEqualStrings("7", reply_text.stripOwned("\n 7\n\n", .{ .lo = 1, .hi = 9 }));
+    try std.testing.expectEqualStrings(" 7\n", try expectValid(reply_text.stripOwned("\n 7\n\n", .{ .lo = 1, .hi = 4 })));
+    try std.testing.expectEqualStrings("7", try expectValid(reply_text.stripOwned("\n 7\n\n", .{ .lo = 1, .hi = 9 })));
+}
+
+/// One byte a token, as T5's counterexample tokenizes it.
+fn bytePieces(a: Allocator, raw: []const u8) ![]const []const u8 {
+    const pieces = try a.alloc([]const u8, raw.len);
+    for (pieces, 0..) |*p, i| p.* = raw[i..][0..1];
+    return pieces;
+}
+
+fn expectValid(s: []const u8) ![]const u8 {
+    try std.testing.expect(std.unicode.utf8ValidateSlice(s));
+    return s;
+}
+
+test "runner projection: owned trim limits widen to whole code points, so no trim leaves invalid UTF-8" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const reply_text = @import("reply_text.zig");
+    const call = "<tool_call>{\"name\":\"f\",\"arguments\":{}}</tool_call>";
+    const tools = [_]json.Value{(try json.parse(a, "{\"type\":\"function\",\"function\":{\"name\":\"f\",\"parameters\":{\"type\":\"object\",\"properties\":{}}}}")).ok};
+    // T5-OWNED-WS-REVIEW: raw 78 0a c2 a0, a record owning only the C2 of U+00A0, then a whole call
+    const raw = "x\n\u{a0}" ++ call;
+    const own = (try of(a, &.{try record(a, "content", 2, 1)}, 0, try bytePieces(a, raw), raw, raw)).?;
+    try std.testing.expectEqual(Owned{ .lo = 2, .hi = 3 }, own);
+    try std.testing.expectEqualStrings("x\n\u{a0}", try expectValid((try tool_parse.parseOwned(a, raw, &tools, null, own)).content));
+    try std.testing.expectEqualStrings("x\n\u{a0}", try expectValid(try reply_text.finishedProse(a, raw, own)));
+    // right and left ends inside 2-, 3- and 4-byte code points (U+00A0, U+3000, U+1F600); none takes four as a blank
+    const Case = struct { text: []const u8, own: Owned, want: []const u8 };
+    const cases = [_]Case{
+        .{ .text = "x\n\u{3000}\n", .own = .{ .lo = 2, .hi = 3 }, .want = "x\n\u{3000}" },
+        .{ .text = "x\n\u{3000}\n", .own = .{ .lo = 3, .hi = 4 }, .want = "x\n\u{3000}" },
+        .{ .text = "x \u{1f600}\u{a0}", .own = .{ .lo = 3, .hi = 4 }, .want = "x \u{1f600}" },
+        .{ .text = "\n\u{a0}x", .own = .{ .lo = 2, .hi = 3 }, .want = "\u{a0}x" },
+        .{ .text = "\u{3000}x\n", .own = .{ .lo = 1, .hi = 2 }, .want = "\u{3000}x" },
+        .{ .text = "\u{3000}x\n", .own = .{ .lo = 2, .hi = 4 }, .want = "\u{3000}x" },
+        .{ .text = "\n\u{1f600}x ", .own = .{ .lo = 2, .hi = 3 }, .want = "\u{1f600}x" },
+    };
+    for (cases) |c| {
+        try std.testing.expectEqualStrings(c.want, try expectValid(reply_text.stripOwned(c.text, c.own)));
+        const parsed = try tool_parse.parseOwned(a, try std.mem.concat(a, u8, &.{ c.text, call }), &tools, null, c.own);
+        try std.testing.expectEqualStrings(c.want, try expectValid(parsed.content));
+    }
 }
