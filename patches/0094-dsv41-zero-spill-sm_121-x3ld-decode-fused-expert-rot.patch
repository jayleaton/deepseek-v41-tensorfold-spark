+template <int K2>
+__host__ __device__ constexpr int stage_lane_words() {
+    int most = 0;
+    for (int l = 0; l < 32; ++l) {
+        const int first = (4 * l * K2 + (K2 >> 1) - 16 + 128 * K2) & 31;
+        const int span = Fmt<K2>::end(7) - Fmt<K2>::end(0) + 16;
+        const int need = first + span;
+        if (need > most) most = need;
+    }
+    return (most + 31) >> 5;
+}
+
+template <int D>
+__device__ __forceinline__ uint32_t win16(uint32_t hi, uint32_t mid, uint32_t lo) {
+    if constexpr (D == 0) return hi >> 16;
+    else if constexpr (D == 8) return __byte_perm(hi, 0u, 0x4421);
+    else if constexpr (D < 16) return (hi >> (16 - D)) & 0xffffu;
+    else if constexpr (D == 16) return hi & 0xffffu;
+    else if constexpr (D < 32) return __funnelshift_l(mid, hi, D) >> 16;
+    else if constexpr (D == 32) return mid >> 16;
+    else if constexpr (D == 40) return __byte_perm(mid, 0u, 0x4421);
+    else if constexpr (D < 48) return (mid >> (48 - D)) & 0xffffu;
+    else if constexpr (D == 48) return mid & 0xffffu;
+    else return __funnelshift_l(lo, mid, D - 32) >> 16;
+}
+
+template <int CB, int K2>
+__device__ __forceinline__ void decode_stage_tile(
+    const uint32_t* tile, int w0, int bit_off,
+    uint32_t (&b0)[2], uint32_t (&b1)[2]) {
+    constexpr int TW = Fmt<K2>::TW;
+    constexpr int LW2 = stage_lane_words<K2>();
+    static_assert(LW2 <= 4, "decode_stage_tile supports LW2 <= 4");
+    constexpr int E0 = Fmt<K2>::end(0);
+    constexpr int D7 = Fmt<K2>::end(7) - E0;
+    const int off = (K2 == 8) ? 20 : bit_off;
+    const uint32_t u0 = tile[w0];
+    const uint32_t u1 = tile[(w0 + 1 < TW) ? (w0 + 1) : 0];
+    const uint32_t hi = __funnelshift_l(u1, u0, off);
+    uint32_t mid = 0u, lo = 0u;
+    if constexpr (D7 > 16) {
+        if constexpr (LW2 > 2) {
+            const int w2 = (w0 + 2 < TW) ? (w0 + 2) : (w0 + 2 - TW);
+            const uint32_t u2 = tile[w2];
+            mid = __funnelshift_l(u2, u1, off);
+            if constexpr (D7 > 48) {
+                if constexpr (LW2 > 3) {
+                    const int w3 = (w0 + 3 < TW) ? (w0 + 3) : (w0 + 3 - TW);
+                    const uint32_t u3 = tile[w3];
+                    lo = __funnelshift_l(u3, u2, off);
+                } else {
+                    lo = u2 << off;
+                }
+            }
+        } else {
+            mid = u1 << off;
+        }
+    }
+    const uint32_t s0 = win16<Fmt<K2>::end(0) - E0>(hi, mid, lo);
+    const uint32_t s1 = win16<Fmt<K2>::end(1) - E0>(hi, mid, lo);
+    const uint32_t s2 = win16<Fmt<K2>::end(2) - E0>(hi, mid, lo);
+    const uint32_t s3 = win16<Fmt<K2>::end(3) - E0>(hi, mid, lo);
+    const uint32_t s4 = win16<Fmt<K2>::end(4) - E0>(hi, mid, lo);
+    const uint32_t s5 = win16<Fmt<K2>::end(5) - E0>(hi, mid, lo);
+    const uint32_t s6 = win16<Fmt<K2>::end(6) - E0>(hi, mid, lo);
+    const uint32_t s7 = win16<Fmt<K2>::end(7) - E0>(hi, mid, lo);
+    b0[0] = cb_pair<CB>(s0, s1);
+    b0[1] = cb_pair<CB>(s2, s3);
+    b1[0] = cb_pair<CB>(s4, s5);
+    b1[1] = cb_pair<CB>(s6, s7);
+}
