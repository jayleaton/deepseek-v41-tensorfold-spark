From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Tue, 3 Nov 2026 02:52:09 +0700
Subject: [PATCH 146/207] Add opt-in frontend admission step budget

(cherry picked from commit 6ee7f6753d2e1272b78fcaf7a3c8f4abf3a06719)

Integration: T2's compiler warm-up (94930077e) now runs whenever cfg.compile is on, after T5's configured-frontend branch.
---
 zig/src/core/runner.zig                       |  2 ++
 .../core/runner_frontend_collections_test.zig | 29 +++++++++++++++++++
 zig/src/core/runner_open.zig                  | 19 +++++++-----
 zig/src/core/runner_test.zig                  | 10 +++++++
 4 files changed, 52 insertions(+), 8 deletions(-)

diff --git a/zig/src/core/runner.zig b/zig/src/core/runner.zig
index 08cd46acb50bb1ae94f4b2d7fcbc88175afcc269..7181b628e675103b9ce12d2a2ce15c6573caee94 100644
--- a/zig/src/core/runner.zig
+++ b/zig/src/core/runner.zig
@@ -12,6 +12,7 @@ const log = std.log.scoped(.runner);
 pub const Config = struct {
     scan: scan.Config = .{},
     max_steps: u64 = 4_000_000, // per run (a step count: wall time never changes a result)
+    compile_steps: usize = 10522, // PREFIX_COMPILE_STEPS: frontend cost limit; opt-in maximum 32768, not an instruction cap
     max_tokens: u32 = 512, // owned result tokens before the cut note
     workers: u8 = 2,
     device: enum { cpu, cuda } = .cpu,
@@ -44,6 +45,7 @@ pub const Config = struct {
         };
         c.workers = try knob(u8, get, prefix ++ "_WORKERS", c.workers, 1, 64);
         c.max_steps = try knob(u64, get, prefix ++ "_MAX_STEPS", c.max_steps, 1, 1 << 40);
+        c.compile_steps = try knob(usize, get, prefix ++ "_COMPILE_STEPS", c.compile_steps, 1, 32768);
         c.max_tokens = try knob(u32, get, prefix ++ "_MAX_TOKENS", c.max_tokens, 1, 1 << 20);
         c.exact = try knob(u1, get, prefix ++ "_EXACT", 0, 0, 1) == 1;
         c.settle_us = try knob(u32, get, prefix ++ "_SETTLE_US", c.settle_us, 0, 100_000);
diff --git a/zig/src/core/runner_frontend_collections_test.zig b/zig/src/core/runner_frontend_collections_test.zig
index 83407a484553e7402c0362bebe2ac2b3601db5fe..8c1cb3063c879e41a9876dab75fa20495c9fc063 100644
--- a/zig/src/core/runner_frontend_collections_test.zig
+++ b/zig/src/core/runner_frontend_collections_test.zig
@@ -23,6 +23,10 @@ pub const cases = [_][2][]const u8{
     .{ "g={0:[1,2],1:[2],2:[]}; stack=[0]; seen=set(); order=[]\nwhile stack:\n    node=stack.pop()\n    if node not in seen:\n        seen.add(node); order.append(node)\n        for nxt in g[node]:\n            stack.append(nxt)\nprint(order)", "[0, 2, 1]\n" },
     .{ "a='ab'; b='ac'; d=[[0]*3 for i in range(3)]\nfor i in range(3):\n    d[i][0]=i; d[0][i]=i\nfor i in range(1,3):\n    for j in range(1,3):\n        d[i][j]=min(d[i-1][j]+1,d[i][j-1]+1,d[i-1][j-1]+(a[i-1]!=b[j-1]))\nprint(d)", "[[0, 1, 2], [1, 0, 1], [2, 1, 1]]\n" },
 };
+pub const budget_case = "def edit_distance(a, b):\n    if len(a) > len(b):\n        a, b = b, a          # a is the shorter string\n    m = len(a)\n    dp = list(range(m + 1))  # dp[j] = distance to a[:j]\n\n    for i, ch in enumerate(b, 1):\n        prev = dp[0]\n        dp[0] = i\n        for j in range(1, m + 1):\n            old = dp[j]\n            cost = 0 if a[j - 1] == ch else 1\n            dp[j] = min(\n                old + 1,          # delete/insert\n                dp[j - 1] + 1,    # insert/delete\n                prev + cost       # match/substitute\n            )\n            prev = old\n\n    return dp[m]\n\nprint(edit_distance(\"kitten\",\"sitting\"))";
+
+pub const over_budget_case = "a=[0]\ni=0\nwhile i<1000:\n    a[0]+=1\n    i+=1\nprint(a)";
+
 pub const negatives = [_][]const u8{
     "__debug__=1;print([__debug__])",
     "__builtins__={}\ndef f():\n    print([1])\nf()",
@@ -98,6 +102,25 @@ test "configured collections O1 ELF matches CPython and reference" {
         try t.expect(translated == .program);
         try reference.check(root, "/usr/bin/python3", translated.program, oracle.stdout);
     }
+    // Larger admission is opt-in; a cached high-budget ELF must not bypass either lower bound.
+    const cell: @import("runner_api.zig").Cell = .{ .form = .fence, .lang = "python", .code = budget_case };
+    context.compiler.step_budget = 10522;
+    try expectBudgetRefusal(front, cell);
+    context.compiler.step_budget = 32768;
+    const admitted = try front.translate(front.ctx, t.allocator, cell);
+    defer if (admitted == .program) t.allocator.free(admitted.program.bytes);
+    try t.expect(admitted == .program);
+    try reference.check(root, "/usr/bin/python3", admitted.program, "3\n");
+    context.compiler.step_budget = 28359;
+    try expectBudgetRefusal(front, cell);
+    context.compiler.step_budget = 10522;
+    try expectBudgetRefusal(front, cell);
+    const over: @import("runner_api.zig").Cell = .{ .form = .fence, .lang = "python", .code = over_budget_case };
+    const over_cost = (try collections.lowerWithCost(t.allocator, over_budget_case)) orelse return error.UnexpectedAbstention;
+    defer t.allocator.free(over_cost.source);
+    try t.expect(over_cost.estimated_steps > 32768);
+    context.compiler.step_budget = 32768;
+    try expectBudgetRefusal(front, over);
 }
 
 test "collections nested dictionary comparisons retain quadratic cost" {
@@ -118,3 +141,9 @@ test "collections O1 retains runtime work against O0 folding guards" {
         try @import("runner_frontend_optimization_test.zig").checkCollectionsOptimization(&env, lowered.source, fixture[1]);
     }
 }
+
+fn expectBudgetRefusal(front: @import("runner_api.zig").Frontend, cell: @import("runner_api.zig").Cell) !void {
+    const result = try front.translate(front.ctx, t.allocator, cell);
+    defer if (result == .program) t.allocator.free(result.program.bytes);
+    try t.expect(result == .abstain);
+}
diff --git a/zig/src/core/runner_open.zig b/zig/src/core/runner_open.zig
index 33e64273e4d2554503410029e433198d1d4098dc..53eec3567375150094247d065086c66cd1a1f262 100644
--- a/zig/src/core/runner_open.zig
+++ b/zig/src/core/runner_open.zig
@@ -27,8 +27,8 @@ const Opened = struct {
     routed: route.Routed = undefined,
     quick: route.Quick = undefined, // cfg.sync_graph: routed's engine-thread part
     dispatch: route.Dispatch = undefined,
-    threaded: std.Io.Threaded = undefined, // the no-compile frontend's io (cfg.compile false)
-    no_compile: frontend_mod.Context = undefined,
+    threaded: std.Io.Threaded = undefined, // a configured frontend's engine-lifetime io
+    configured_frontend: frontend_mod.Context = undefined,
     compiles: bool = true, // the frontend may build an ELF (clang); false under cfg.compile false
 };
 
@@ -75,13 +75,16 @@ pub fn openSharing(gpa: Allocator, cfg: Config, with: ?*Runner) !*Runner {
     errdefer if (o.circuit == &o.own_circuit) o.own_circuit.deinit(gpa);
     const back = try @import("runner_circuit_backend.zig").placed(gpa, o.circuit, cfg.workers, &o.placer);
     var frontend = frontend_mod.frontend();
-    if (!cfg.compile) {
-        // no scratch root: compile returns before clang, so a program the frontend would build as an ELF abstains
+    if (!cfg.compile or cfg.compile_steps != 10522) {
+        // Empty scratch root prevents new compiler runs; S3 also refuses cached ELF when disabled.
         o.threaded = .init(gpa, .{});
-        o.no_compile = .{ .io = o.threaded.io(), .compiler = .{ .scratch_root = "" } };
-        frontend = o.no_compile.frontend();
-        o.compiles = false;
-    } else {
+        o.configured_frontend = .{ .io = o.threaded.io() };
+        o.configured_frontend.compiler.step_budget = cfg.compile_steps;
+        if (!cfg.compile) o.configured_frontend.compiler.scratch_root = "";
+        frontend = o.configured_frontend.frontend();
+        o.compiles = cfg.compile;
+    }
+    if (cfg.compile) {
         // the compiler kept started and the fixed runtime compiled now, so no call pays clang's start or the runtime
         var warm_io: std.Io.Threaded = .init(gpa, .{});
         defer warm_io.deinit();
