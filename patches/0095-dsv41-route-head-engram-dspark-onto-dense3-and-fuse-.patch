@@ -388,9 +388,20 @@ pub const Emitter = struct {
         }
     }
 
+    /// Whether a projection shape and trellis width satisfy dense3 (lanes) divisibility rules.
+    pub fn dense3Eligible(k: i64, n: i64, k2: i64) bool {
+        if (k <= 0 or n <= 128 or @mod(k, 128) != 0 or @mod(n, 128) != 0) return false;
+        if (std.mem.indexOfScalar(u32, &dense.dense3_k2s, @intCast(k2)) == null) return false;
+        const pl0 = dense.plan(@intCast(k), @intCast(n));
+        const denom: i64 = @intCast(pl0[0] * pl0[1] * dense.groupSteps(@intCast(k2)));
+        return @mod(@divExact(k, 16), denom) == 0;
+    }
+
     /// Upstream's rot_in + linear: one projection, its trellis as strips unless one 128-column block.
     pub fn upstream(e: *Emitter, w: []const u8, x: Arg, k: i64, n: i64, y: Arg) !void {
         const k2: i64 = try e.w.k2(w);
+        if (e.o.r1 and e.n <= dense.rows_max and dense3Eligible(k, n, k2))
+            return e.fused(w, &.{.{ .w = w, .x = x, .y = y, .k = @intCast(k), .n = @intCast(n) }});
         const xh = try e.buf("L.{s}.xh", .{w}, .f16, &.{ e.n, k });
         try e.ext("tensorfold_exl3_linear_v4.rot_in", &.{ x, try e.weight("{s}.suh", .{w}, .f16, &.{k}), xh });
         const pl = dense.plan(@intCast(k), @intCast(n));
