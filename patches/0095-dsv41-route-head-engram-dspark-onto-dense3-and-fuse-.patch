+test "r1 routes head and DSpark main_proj onto dense3, keeps boundary x != xout, and chunks n=200 ingest" {
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var w = try widths(a);
+    try w.dense.put(a, "dspark.main_proj", 8);
+    const cfg: Config = .{};
+    const dec = try block.emit(a, &cfg, &w, .{ .r1 = true }, &.{0}, 5, 0, true);
+    for (dec) |c| try t.expect(!std.mem.eql(u8, c.name, "tensorfold_exl3_linear_v4.linear"));
+    const ds = @import("dspark_emit.zig");
+    const moe_mod = @import("block_moe.zig");
+    const pass = try ds.emitPass(a, &cfg, &w, .{ .r1 = true, .rot_fold = 1 }, cfg.dspark_block);
+    var bf16_ex: usize = 0;
+    var boundary_mhc: usize = 0;
+    for (pass) |c| {
+        try t.expect(!std.mem.eql(u8, c.name, "tensorfold_exl3_linear_v4.linear"));
+        try t.expect(!std.mem.eql(u8, c.name, "_rope"));
+        try t.expect(!std.mem.eql(u8, c.name, "glue.exchange_f32"));
+        if (std.mem.eql(u8, c.name, "glue.exchange")) bf16_ex += 1;
+        if (std.mem.eql(u8, c.name, "tf_dsv41_mhc_cuda_v1.run") and
+            c.args[19].arg.i == @backingInt(moe_mod.Mode.boundary))
+        {
+            boundary_mhc += 1;
+            try t.expect(!std.mem.eql(u8, c.args[0].arg.t.role.buf, c.args[1].arg.t.role.buf));
+        }
+    }
+    try t.expectEqual(@as(usize, 2 * cfg.mtp_layers), bf16_ex);
+    try t.expectEqual(@as(usize, 2 * cfg.mtp_layers - 1), boundary_mhc);
+    const ing128 = try ds.emitIngest(a, &cfg, &w, .{ .r1 = true }, 128, 0);
+    for (ing128) |c| try t.expect(!std.mem.eql(u8, c.name, "tensorfold_exl3_linear_v4.linear"));
+    const ing200 = try ds.emitIngest(a, &cfg, &w, .{ .r1 = true }, 200, 0);
+    var dense3_chunks: usize = 0;
+    for (ing200) |c| {
+        try t.expect(!std.mem.eql(u8, c.name, "tensorfold_exl3_linear_v4.linear"));
+        if (std.mem.eql(u8, c.name, "tf_dsv41_dense3_v1.linear")) dense3_chunks += 1;
+    }
+    try t.expect(dense3_chunks >= 2);
+}
