         const q0 = o.qRow(c);
         for (0..rows) |r| {
             const ri: i64 = @intCast(r);
@@ -173,9 +173,9 @@ const Model = struct {
             for (0..nk) |j| {
                 const ji: i64 = @intCast(j);
                 const kp: i64 = if (!gather) ji else if (cbs > 0) blk: {
-                    const b = keys[r * ks + j / @as(usize, @intCast(cbs))];
+                    const b = gk[r * ks + j / @as(usize, @intCast(cbs))];
                     break :blk if (b < 0) -1 else b * cbs + @mod(ji, cbs);
-                } else keys[r * ks + j];
+                } else gk[r * ks + j];
                 const ok = kp >= 0 and kp < vis;
                 out[r * os + j] = if (ok) score(salt, q0 + ri, kp) else none;
                 if (ok) {
diff --git a/zig/src/families/deepseek_v41/idx_split_test.zig b/zig/src/families/deepseek_v41/idx_split_test.zig
index a3dc015f54302f21e1ac03af58e5b8cf775f1b89..92d7e650eceba903e3192597f024444955b3950b 100644
--- a/zig/src/families/deepseek_v41/idx_split_test.zig
+++ b/zig/src/families/deepseek_v41/idx_split_test.zig
@@ -373,7 +373,14 @@ test "idx split: ranks with unequal index budgets still cut alike, issue the sam
             for (cs, 0..) |r, rank| try markRows(r, L, k, seen, cut.mine(@intCast(rank)));
             for (seen) |v| try testing.expectEqual(@as(u8, 1), v);
         };
-        try testing.expectEqual(@as(usize, 8), gathers);
+        // 1: every eligible layer (2 / 8 / 14, the source, its 4 reindex layers); auto: the equal-budget pair's layers
+        var o = longOpts(n);
+        o.idx_split = md;
+        var want: usize = 0;
+        for (try bp.emitPrefill(aa, &fx.cfg, &fx.w, o, &layers, n, 131072, false)) |c| want += @intFromBool(std.mem.eql(u8, c.name, "glue.ix_gather"));
+        if (md == .all) try testing.expectEqual(@as(usize, 8), want);
+        try testing.expect(want > 0);
+        try testing.expectEqual(want, gathers);
     };
 }
 
