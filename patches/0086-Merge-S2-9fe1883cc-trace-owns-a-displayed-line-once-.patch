From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Mon, 2 Nov 2026 05:06:54 +0700
Subject: [PATCH 086/207] Merge S2 9fe1883cc (trace owns a displayed line once
 per reply)

Squashed merge of 1 commits:
- runner trace: own a displayed line once per reply, also when restated through names (Jay Leaton)
---
 zig/src/core/runner_scan.zig       |  6 +++---
 zig/src/core/runner_trace.zig      | 14 +++++++-------
 zig/src/core/runner_trace_test.zig |  9 +++++++++
 3 files changed, 19 insertions(+), 10 deletions(-)

diff --git a/zig/src/core/runner_scan.zig b/zig/src/core/runner_scan.zig
index 6a6d7cce2e87a89a94d81f4d2a66f55ba278b870..7d026e9c8f06342856f5d47089222ffa795aa191 100644
--- a/zig/src/core/runner_scan.zig
+++ b/zig/src/core/runner_scan.zig
@@ -54,7 +54,7 @@ pub const Scanner = struct {
     tracer: ?trace.Tracer = null, // names and owned statements (form trace; made at the first reasoning line)
     trace_src: std.ArrayList(u8) = .empty, // the pending statement's Python source
     trace_disp: std.ArrayList(u8) = .empty,
-    trace_armed: std.ArrayList(u8) = .empty, // the source of the trace cell armed in this token
+    trace_armed: std.ArrayList(u8) = .empty, // the display of the trace cell armed in this token
     trace_cell: ?u32 = null, // the stated computation waiting for its cue
     trace_at: u32 = 0, // the token its line ended at
     trace_cells: u32 = 0,
@@ -168,7 +168,7 @@ pub const Scanner = struct {
         var fired = false;
         if (s.trace_cell != null and trace.cue(raw)) fired = try s.traceArm(a);
         const found = try t.line(raw) orelse return;
-        if (s.trace_cell != null and std.mem.eql(u8, found.source, s.trace_src.items)) return;
+        if (s.trace_cell != null and std.mem.eql(u8, found.display, s.trace_disp.items)) return;
         if (ev.closed != null or s.trace_cells >= trace_cells_max or s.trace_owned >= trace_owned_max) return;
         s.trace_src.clearRetainingCapacity();
         try s.trace_src.appendSlice(a, found.source);
@@ -187,7 +187,7 @@ pub const Scanner = struct {
         if (s.armed != null) return false;
         s.armed = .{ .index = s.trace_cell.?, .trace = true };
         s.trace_armed.clearRetainingCapacity();
-        try s.trace_armed.appendSlice(a, s.trace_src.items);
+        try s.trace_armed.appendSlice(a, s.trace_disp.items);
         return true;
     }
 
diff --git a/zig/src/core/runner_trace.zig b/zig/src/core/runner_trace.zig
index 1b6364a7a8bf0d0bb424312fb8d6f4db834e7096..8842b046b0934f766da5d7a8b569245600700028 100644
--- a/zig/src/core/runner_trace.zig
+++ b/zig/src/core/runner_trace.zig
@@ -27,14 +27,14 @@ pub const Tracer = struct {
         t.scratch.deinit();
     }
 
-    /// The source owned once: the same statement never fires twice in a reply.
-    pub fn fire(t: *Tracer, source: []const u8) Allocator.Error!void {
+    /// The displayed line owned once: a restatement through names (other source, same display) never fires again.
+    pub fn fire(t: *Tracer, display: []const u8) Allocator.Error!void {
         const a = t.keep.allocator();
-        try t.fired.append(a, try a.dupe(u8, source));
+        try t.fired.append(a, try a.dupe(u8, display));
     }
 
-    fn firedHas(t: *const Tracer, source: []const u8) bool {
-        for (t.fired.items) |f| if (std.mem.eql(u8, f, source)) return true;
+    fn firedHas(t: *const Tracer, display: []const u8) bool {
+        for (t.fired.items) |f| if (std.mem.eql(u8, f, display)) return true;
         return false;
     }
 
@@ -100,7 +100,7 @@ pub const Tracer = struct {
             try t.names.append(a, .{ .name = try a.dupe(u8, n), .expr = kept });
             // a first wide definition with nothing after it states that computation ("N = A*2^64 + B.")
             if (hasArith(e.source) and e.bound >= 12 and e.bound <= max_digits and text.sentenceEndsAt(clean, txt_end) and
-                !t.firedHas(e.source)) define.* = .{ .source = e.source, .display = e.display };
+                !t.firedHas(e.display)) define.* = .{ .source = e.source, .display = e.display };
         }
     }
 
@@ -134,7 +134,7 @@ pub const Tracer = struct {
                 bound = expr.sat(@max(parts[0].bound, parts[1].bound) + 1);
             },
         }
-        if (t.firedHas(f.source) or bound > max_digits) return null;
+        if (t.firedHas(f.display) or bound > max_digits) return null;
         // a bare sentence counts only when it is plainly a computation: a power or a six-digit literal
         if (h.bare and std.mem.indexOf(u8, f.source, "**") == null and !hasDigitRun(f.source, 6)) return null;
         return f;
diff --git a/zig/src/core/runner_trace_test.zig b/zig/src/core/runner_trace_test.zig
index db21ad37f49eded9c02511502c18ef31d3a87c3b..6167aac3a14f662eccdd5f4dce161a989f14dee5 100644
--- a/zig/src/core/runner_trace_test.zig
+++ b/zig/src/core/runner_trace_test.zig
@@ -115,6 +115,15 @@ test "runner trace: a name after an operator is no definition; a redefinition po
     try expectStated(&.{ "Let A = 12,345.", "A = 12345.", "Need compute A*1000003." }, "(12345)*1000003");
 }
 
+test "runner trace: an owned line restated through its names never fires again (live big-number-019)" {
+    var t = trace.Tracer.init(gpa);
+    defer t.deinit();
+    const f = (try t.line(bn019)).?;
+    try t.fire(f.display);
+    const again = "Need divide A by B. A has 6 base1e9 limbs, B 3 limbs. Quotient ~ A/B ~ (3.141e50)/(2.718e20)=1.155e30.";
+    try std.testing.expectEqual(null, try t.line(again));
+}
+
 test "runner trace: negative controls: prose, code and small inline sums state nothing" {
     try expectNone(&.{"We need answer. Need be careful. Let's think about the algorithm."});
     try expectNone(&.{"for i in range(10): total = total * 3"});
