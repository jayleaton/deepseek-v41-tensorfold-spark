# fill-prod.env with the row-blocked stream top-k (TF_DSV41_STREAM_RB=2): its _stream_rb2 variants join prod's (for 4, set 4 and fill again with TRITON_FILL_HAVE the first set)
# prod's shape - 4 slots at the model's 1,048,576 context with per-slot drafts, TP=2, R1, prod.env's index budget.
TF_TP_WORLD=2
TF_DSV41_CONTEXT=1048576
TF_DSV41_SLOTS=4
TF_DSV41_ROWS_CAP=64
TF_DSV41_DRAFTS=1
TF_DSV41_SLOT_DRAFTS=1
TF_DSV41_PREFILL_ROWS=2048
TF_DSV41_INDEX_BUDGET_MIB=64
TF_DSV41_EXPERT_TOPP=0.85
# R1 (prod_knobs.r1: every knob on)
TF_DSV41_ATTN_SPLIT=4
TF_DSV41_ATTN_ROPE=1
TF_DSV41_MHC_TAIL=1
TF_DSV41_MHC_DEFER=1
TF_DSV41_MOE_BF16=1
TF_DSV41_PRUNE_KIT=1
TF_DSV41_RG_PRUNE=1
TF_DSV41_RMS_FOLD=1
# CED replay (prod.env TF_DSV41_PREFILL=replay; ced.zig): the decoder pass's variants (127 rows from any R0, shorter
# tails from 0) join the fill; the encoder segments are the prefill segments'
TF_DSV41_PREFILL=replay
TF_DSV41_STREAM_RB=2
