# The prod config's kernel knobs (dsv41-tensorfold-spark/config/prod.env, G19 + E1/E2), for the M1 capture on one
# GPU (job.sh: M1_KNOBS=prod). Left out: knobs that need prod-only files or services (pfdense table, Engram native
# dir and gate, sessions, images, calibration, paths), the transport (RoCE, plan link) and the batcher's (replay
# prefill mode, full cone, adaptive rows), which do not change which kernels a block launches.
TF_DSV41_PREFILL_KERNELS=fast
TF_DSV41_FAST_EXPERTS=gm
TF_DSV41_PF_COPIES=1
TF_DSV41_MHC_PF=1
TF_DSV41_PREFILL_GATHER=bf16
TF_DSV41_PREFILL_ATTN=fused
TF_DSV41_PREFILL_ATTN_BMQ=32
TF_DSV41_PREFILL_ATTN_WARPS=8
TF_DSV41_PREFILL_ROUTER=gemv
TF_DSV41_INDEX_STREAM_MIN=4096
TF_DSV41_PLAIN_TRITON=1
TF_DSV41_ROUTER=gemv
TF_DSV41_ROPE_INPLACE=1
TF_DSV41_MHC_BM=64
TF_DSV41_MHC_WARPS=8
TF_DSV41_DENSE=0
TF_DSV41_MHC_DEC=1
TF_DSV41_MHC_FIN2=1
TF_DSV41_RMS_PAIR=1
TF_DSV41_PARTIAL_BF16=1
TF_DSV41_RG_NARROW=2
TF_DSV41_RG_TAIL=1
TF_DSV41_INDEX_DTOPK=1
TF_DSV41_ENGRAM_FUSE_DEC=1
TF_DSV41_MHC_FN=bf16
TF_DSV41_EXPERT_TOPP=0.85
TF_DSV41_EXPERT_MIN_K=3
TF_DSV41_EXPERT_RENORM=kept
TF_DSV41_L2PF=1
TF_DSV41_L2PF_MB=12
TF_DSV41_L2PF_PACE_GBPS=150
TF_DSV41_PDL=0
TF_DSV41_MHC_CUDA=1
TF_DSV41_ATTN_CUDA=1
TF_DSV41_DENSE_V3=1
TF_DSV41_BRANCHES=1
TF_DSV41_BRANCHES_PRIO=side
TF_DSV41_INDEX_KV=fp8
TF_DSV41_EXPERT_LOADS=1
TF_DSV41_EXPERT_PREFILL=0
