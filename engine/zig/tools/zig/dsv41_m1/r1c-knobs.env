# R1 / R1c decode knobs (decode1 78b703d, docs/DSV41-DECODE-R1.md), on top of prod-knobs.env, for the r1c capture:
# every one is "same bits" in Python's own gates; the capture is replayed bit for bit by our kernels.
TF_DSV41_ATTN_SPLIT=4
TF_DSV41_MHC_TAIL=1
TF_DSV41_MHC_DEFER=1
TF_DSV41_MOE_BF16=1
TF_DSV41_PRUNE_KIT=1
TF_DSV41_RG_PRUNE=1
TF_DSV41_ATTN_ROPE=1
TF_DSV41_RMS_FOLD=1
