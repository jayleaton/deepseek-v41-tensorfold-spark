# AB3 "tool-full" arm (boots ab3-b1-3-full, ab3-b2-2-full, ab3-b3-1-full): these 18 lines over arm L's effective
# environment (arm-L-effective.env), from the frozen kit's configs (ab3/kit2/ab3-t0*-configs.json) and the boot's
# arm metadata. Engine 3bf584af1 (release branch 00b66d9f6), image tensorfold-dsv41-imr:r-3bf584af1c54 (rank-0
# host sha256:26c0b4107869671656476006743be5288dc48c8ee1f5c5b3879bd606fba59535). The base also had
# TF_DSV41_PREPARED_WRITE=1. The image carries the runner frontend layer (packaging/runner), the circuit (calc.tfpc)
# and the graph-v7-powmod bank (bank.json sha256 26862f0a758af4e01a1d8c69d501ad49ee1657162b36d057b8a3c312fcf12512).
# Requests: requests-ab3-tool-full.json (runner_guide = the trust guide, sha256 53ed328f...).
TF_DSV41_COMPUTE_LANE=1
TF_DSV41_RUNNER=1
TF_DSV41_RUNNER_CIRCUIT=/opt/tensorfold/share/runner/calc.tfpc
TF_DSV41_RUNNER_FORMS=fence,repl,inline,trace
TF_DSV41_RUNNER_BACKEND=graph
TF_DSV41_RUNNER_GRAPH_BANK=/opt/tensorfold/share/runner/graph-v7-powmod/bank/bank.json
TF_DSV41_RUNNER_STATED=0
TF_DSV41_RUNNER_INLINE_CHAIN=0
TF_DSV41_RUNNER_INLINE_MARK=0
TF_DSV41_RUNNER_SYNC_GRAPH=0
TF_DSV41_RUNNER_COMPILE_STEPS=10522
TF_DSV41_RUNNER_CELLS=1
TF_DSV41_COMPUTE_LANE_RUNNER=1
TF_DSV41_COMPUTE_LANE_RUNNER_CIRCUIT=/opt/tensorfold/share/runner/calc.tfpc
TF_DSV41_COMPUTE_LANE_RUNNER_BACKEND=graph
TF_DSV41_COMPUTE_LANE_RUNNER_GRAPH_BANK=/opt/tensorfold/share/runner/graph-v7-powmod/bank/bank.json
TF_DSV41_COMPUTE_LANE_RUNNER_SETTLE_US=3000
TF_DSV41_RUNNER_COMMIT=0
