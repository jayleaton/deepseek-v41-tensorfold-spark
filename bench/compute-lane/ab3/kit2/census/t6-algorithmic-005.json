          "content": "```rust\n/// Returns `true` if all parentheses, brackets, and braces in `s`\n/// are correctly matched and properly nested.\npub fn is_balanced(s: &str) -> bool {\n    let mut stack = Vec::new();\n\n    for &b in s.as_bytes() {\n        match b {\n            b'(' | b'[' | b'{' => stack.push(b),\n            b')' => {\n                if stack.pop() != Some(b'(') {\n                    return false;\n                }\n            }\n            b']' => {\n                if stack.pop() != Some(b'[') {\n                    return false;\n                }\n            }\n            b'}' => {\n                if stack.pop() != Some(b'{') {\n                    return false;\n                }\n            }\n            _ => return false, // input contains a non-bracket character\n        }\n    }\n\n    stack.is_empty()\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn balanced_strings() {\n        assert!(is_balanced(\"\"));\n        assert!(is_balanced(\"()\"));\n        assert!(is_balanced(\"()[]{}\"));\n        assert!(is_balanced(\"{[()]}\"));\n        assert!(is_balanced(\"(([]){})\"));\n    }\n\n    #[test]\n    fn unbalanced_strings() {\n        assert!(!is_balanced(\"(\"));\n        assert!(!is_balanced(\")\"));\n        assert!(!is_balanced(\"([)]\"));\n        assert!(!is_balanced(\"{[}]\"));\n        assert!(!is_balanced(\"((())\"));\n    }\n}\n```\n\nThis runs in `O(n)` time and uses `O(n)` space in the worst case. If you want to ignore non-bracket characters instead of rejecting them, replace `_ => return false` with `_ => {}`.",
