          "content": "```js\n#!/usr/bin/env node\n'use strict';\n\nfunction readStdin() {\n  return new Promise((resolve, reject) => {\n    let data = '';\n    process.stdin.setEncoding('utf8');\n    process.stdin.on('data', chunk => { data += chunk; });\n    process.stdin.on('end', () => resolve(data));\n    process.stdin.on('error', reject);\n  });\n}\n\nfunction median(sorted) {\n  const n = sorted.length;\n  if (n === 0) return null;\n  const mid = Math.floor(n / 2);\n  return n % 2 === 0\n    ? (sorted[mid - 1] + sorted[mid]) / 2\n    : sorted[mid];\n}\n\nfunction mode(values) {\n  const freq = new Map();\n  for (const value of values) {\n    freq.set(value, (freq.get(value) || 0) + 1);\n  }\n\n  let maxFreq = 0;\n  for (const count of freq.values()) {\n    if (count > maxFreq) maxFreq = count;\n  }\n\n  // No mode if every value appears only once.\n  if (maxFreq <= 1) return null;\n\n  const modes = [...freq.entries()]\n    .filter(([, count]) => count === maxFreq)\n    .map(([value]) => value)\n    .sort((a, b) => a - b);\n\n  return modes.length === 1 ? modes[0] : modes;\n}\n\n(async () => {\n  try {\n    const input = (await readStdin()).trim();\n\n    if (input === '') {\n      throw new Error('No input received on stdin');\n    }\n\n    const values = JSON.parse(input);\n\n    if (!Array.isArray(values)) {\n      throw new Error('Input must be a JSON array');\n    }\n\n    if (!values.every(v => typeof v === 'number' && Number.isFinite(v))) {\n      throw new Error('Array must contain only finite numbers');\n    }\n\n    const count = values.length;\n\n    if (count === 0) {\n      console.log(JSON.stringify({\n        count: 0,\n        sum: 0,\n        mean: null,\n        min: null,\n        max: null,\n        range: null,\n        median: null,\n        variance: null,\n        stddev: null,\n        mode: null\n      }, null, 2));\n      return;\n    }\n\n    const sum = values.reduce((acc, value) => acc + value, 0);\n    const mean = sum / count;\n\n    const sorted = [...values].sort((a, b) => a - b);\n    const min = sorted[0];\n    const max = sorted[count - 1];\n    const range = max - min;\n\n    const med = median(sorted);\n\n    // Population variance and standard deviation.\n    const variance = values.reduce(\n      (acc, value) => acc + (value - mean) ** 2,\n      0\n    ) / count;\n\n    const stddev = Math.sqrt(variance);\n\n    const stats = {\n      count,\n      sum,\n      mean,\n      min,\n      max,\n      range,\n      median: med,\n      variance,\n      stddev,\n      mode: mode(values)\n    };\n\n    console.log(JSON.stringify(stats, null, 2));\n  } catch (error) {\n    console.error(`Error: ${error.message}`);\n    process.exitCode = 1;\n  }\n})();\n```\n\nExample usage:\n\n```bash\necho '[1, 2, 2, 3, 4, 10]' | node stats.js\n```\n\nExample output:\n\n```json\n{\n  \"count\": 6,\n  \"sum\": 22,\n  \"mean\": 3.6666666666666665,\n  \"min\": 1,\n  \"max\": 10,\n  \"range\": 9,\n  \"median\": 2.5,\n  \"variance\": 8.88888888888889,\n  \"stddev\": 2.9814239699997196,\n  \"mode\": 2\n}\n```\n\nThis uses population variance, dividing by `n`. For sample variance, divide by `n - 1` instead.",
