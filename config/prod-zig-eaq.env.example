# Optional second pack, EXPERIMENTAL: DeepSeek-V4.1-Flash-1017 EXL3 EAQ v1 2.9 bpw by Mia's AI Lab (MIT), served by the
# Zig engine (docs/PACKS.md). flash17 (config/prod-zig-flash17.env.example) stays the recommended default. Its quality
# was not measured by its authors; our speed and quality measurements on this profile are in docs/PACKS.md.
# It is the flash17 profile with these changes: the EAQ pack (widened copy) and its own prepared / state folders; the
# 1017 Engram shards, assets (rope.bin, engram-host.bin, aot/) and pfdense table reused unchanged; and the memory
# values below (pool 170000, prefill workspace floor 4.75 GiB, graph floor 64 GiB). These are TESTED BENCHMARK
# VALUES, NOT A QUALIFIED LONG-SESSION PROFILE: they ran our speed and quality suites on 2x Spark; confirm them
# against your own first boot's check.
# We suggest a 2100-2200 MHz GPU clock cap to help with temperature control.
# Copy to config/prod-zig-eaq.env on EACH node and start it with PACK=eaq scripts/run-zig.sh <rank>.
# This profile requires the CUDA Zig port and generated assets described in docs/ZIG-SERVE.md,
# including an AOT fill that covers 4K prefill pieces, replay runs and the INDEX_BOUND twins.
# The pack this profile serves (scripts/run-zig.sh: PACK selects a profile; the state folder is claimed for it).
PACK=eaq
ZIG_COMMIT="<engine-source-commit>"   # the engine/zig revision your image was built from (image label)
IMAGE="<your-built-zig-image>"
TF_TP_MASTER="<rank-0-link-address>"
TF_TP_PORT=29571
TF_COMM_BACKEND=roce
NCCL_SOCKET_IFNAME="<link-interface>"
NCCL_IB_HCA="<cabled-RDMA-devices>"
# The EAQ pack: Mia-AiLab/DeepSeek-V4.1-Flash-1017-EXL3-EAQ-v1-2.9-bpw @ 6d54be4fca338d79b17c3b03cc9a423bb3ac6718,
# byte-identical on both nodes. Serve the WIDENED folder that scripts/widen_pack.py writes from the download (engine
# 9131e10a refuses its three F16 DSpark router biases and F16 confidence head), not the download itself. An engine
# re-exported from TensorFold perf-1100/eaq-1 accepts them as stored; the widened folder stays valid there.
MODEL_DIR="<absolute-eaq-widened-model-directory>"
# The same 1017 Engram shards as flash17 (same release, same tables): reuse that rank's folder.
ENGRAM_DIR="<absolute-rank-specific-1017-engram-directory>"
# The same rank assets as flash17 (rope.bin, engram-host.bin, aot/: same dims, tokenizer and serving settings);
# confirm with PACK=eaq scripts/run-zig.sh <rank> --check-aot.
ASSETS_DIR="<absolute-rank-specific-assets-directory>"
# This pack's OWN folders, never flash17's: prepared images are per pack, and the draft calibration under STATE_DIR
# (TF_DSV41_CALIB_DIR) is keyed without the pack at engine 9131e10a, so flash17's table would be reused silently.
PREPARED_DIR="<absolute-eaq-zig-prepared-directory>"
STATE_DIR="<absolute-eaq-state-directory>"
# Holds only the pfdense table for this pack (no calibration): flash17's folder can be shared.
CACHE_DIR="<absolute-cache-directory>"
HOST=localhost
PORT=8000
# rope.bin needs CONTEXT + 2048 rows (dsv41_rope_tables.py's default with this env sourced)
TF_DSV41_CONTEXT=1048576
TF_DSV41_ASSETS=/assets

# Engine values exported from the serving profile, with the measured all-on additions.
TF_DSV41_R1=1
TF_DSV41_DRAFTS=1
TF_DSV41_OWN_PREFILL=1
TF_DSV41_GRAPHS=1
TF_DSV41_SAMPLING=1
TF_DSV41_SLOTS=4
TF_DSV41_SLOT_DRAFTS=1
# Paged KV pool shared by the slots. This pack's weights take 3.18 GiB a rank more than flash17's, so flash17's
# 2.1M pool does not fit. Tested benchmark value, not a qualified long-session profile: our boot check's largest pool
# was 191,683 tokens on the tighter rank; 170000 is 0.9 x that, rounded down. Check yours: the boot log names the
# largest pool that fits ("kv: ... the largest that does: TF_DSV41_POOL_TOKENS=<max>" or "the largest pool that
# fits: <max> tokens"); use 0.9 x that maximum (round down), on both nodes.
TF_DSV41_POOL_TOKENS=170000
# Split KV: compressed KV rows sharded over the ranks instead of replicated (TP >= 2; see docs/ZIG-SERVE.md).
TF_DSV41_KV_SPLIT=1
# Split KV's owner-packed exchange where every rank's transport takes device lengths (otherwise the dense exchange).
TF_DSV41_KV_SPLIT_COMPACT=1
# Dense weight forms written over their trellis instead of beside it (frees their copy for the pool).
TF_DSV41_FORMS_INPLACE=1
TF_DSV41_INDEX_KV=fp8
# Decode routed-expert top-p pruning (min 3 kept), as in flash17's profile: about x1.05 decode but LOSSY (top-1
# agreement 0.9944 with unpruned routing, docs/DECODE.md); remove the line for exact routing.
TF_DSV41_EXPERT_TOPP=0.85
TF_DSV41_ENGRAM_DIR=/engram
TF_DSV41_PREPARED=/prepared
TF_DSV41_PREPARED_WRITE=1
TF_DSV41_PLAN_TIMEOUT=1800
TF_DSV41_SESSIONS=1
TF_DSV41_SESSION_RAM_MIB=256
TF_DSV41_SESSION_DISK=/sessions
TF_DSV41_SESSION_DISK_GIB=128
TF_DSV41_SESSION_DISK_MIN=1024
TF_DSV41_FLOOR_GIB=5
TF_DSV41_FLOOR_HARD_GIB=4
TF_DSV41_REQUEST_LOG=/state/requests.jsonl
TF_DSV41_DISCONNECT=1
# Seconds requests in progress may finish after SIGTERM / SIGINT before both ranks stop at a round boundary.
TF_DSV41_DRAIN_S=20
# Seconds between keepalives on a stream that has not sent its first token (0: none).
TF_DSV41_SSE_KEEPALIVE_S=15
TF_DSV41_THINKING=1
TF_DSV41_DEFAULT_EFFORT=high
TF_DSV41_SCHEMA_PROMPT=1
# Image input: DeepSeek's vision tower on rank 0 (placeholder: each image becomes a notice; reject: HTTP 400).
TF_DSV41_IMAGES=native
# The pack's own 43 learned 1017 image routing biases (gate.bias_vl, F32), read from the model folder on both ranks.
TF_DSV41_BIAS_VL=/model
GLM53_TF_ROCE_MAX_KB=1024
TF_DSV41_INDEX_BUDGET_MIB=64
TF_DSV41_PREFETCH_AHEAD=1
TF_DSV41_SPEC_DRAFT=1
TF_DSV41_DRAFT_GRAPHS=1
TF_DSV41_ROWS_CAP=64
TF_DSV41_GRAMMAR=1
TF_DSV41_TOOL_GRAMMAR=0
TF_DSV41_PF_DENSE=fused
# config/pfdense-table.json in CACHE_DIR (scripts/run-zig.sh copies it there when missing)
TF_DSV41_PF_DENSE_TABLE=/cache/pfdense-table.json
TF_DSV41_PLAN_LINK=rdma
TF_DSV41_PLAN_PIN=auto
TF_DSV41_L2PF=1
TF_DSV41_L2PF_MB=12
TF_DSV41_L2PF_PACE_GBPS=150
TF_DSV41_DEPTH_JOINT=0
TF_DSV41_ENGRAM_GATE=1
TF_DSV41_BRANCHES=1
TF_DSV41_BRANCHES_PRIO=side
TF_DSV41_MHC_DEFER=1
GLM53_TF_ROCE_FAST=1
TF_DSV41_GREEDY_GPU=1
TF_DSV41_PREFILL=replay
TF_DSV41_GM_V2=1
# Final serving set: the 40 settings the measured serving boot applied over the profile above (later values win;
# shown here once, with their effective values). Each is default-off in the engine and opted into here.
TF_DSV41_PREFILL_PIECES=1
TF_DSV41_SESSION_SLOTS=1
TF_DSV41_TAIL_JOIN=1
TF_DSV41_DRAFT_TIMED=1
TF_DSV41_CODE_ACCEPT=0
TF_DSV41_ROUTER_GROUP_ROT=1
TF_DSV41_MHC_PFDEC=17
TF_DSV41_DRAFT_BATCH_PROJ=1
TF_DSV41_DRAFT_CHAIN=1
TF_DSV41_DRAFT_OVERLAP=1
TF_DSV41_ROUND_GRAPH=1
TF_DSV41_KV_NORM_STORE=1
TF_DSV41_LOOKUP_PLAN=1
TF_DSV41_JOIN_DRAFTS=1
TF_DSV41_PIECE_RUNS=1
TF_DSV41_REPLAY_RUNS=1
TF_DSV41_PF_4K=1
TF_DSV41_PF_4K_MEMORY_OK=1
TF_DSV41_PREFILL_CHUNK=4096
TF_DSV41_PREFILL_ROWS=4096
# Memory the 4K prefill workspace must leave on every rank, else that piece runs 2K segments (same bits, slower).
# Tested benchmark value, not a qualified long-session profile: 4.75 (a test arm using 3.5 went under its 4.25 GiB
# memory floor during a prefill with this pack). Check it against your first boot's "kv: ... the prefill workspace
# ... leaves <x> GiB" and "prefill workspace: ... runs 2,048-row segments" lines: lower keeps 4K pieces with less
# margin, higher falls back sooner. Without GRAPH_FLOOR_GIB it also sets the decode graph floor,
# max(4.0, this + 1/16) GiB.
TF_DSV41_PF_WS_FLOOR_GIB=4.75
TF_DSV41_ENGRAM_AIO=1
TF_DSV41_DRAFT_CAPTURE=1
TF_DSV41_MHC_DEFER_AT=exchange
TF_DSV41_LIN2=1
TF_DSV41_GRAPH_FLOOR=hold
# Decode CUDA graphs are captured only while MemAvailable - 64 MiB stays at max(4.0, PF_WS_FLOOR_GIB + 1/16) GiB on
# every rank; under it (GRAPH_FLOOR=hold) held graphs replay but each new key runs eagerly, slower, while the node
# stays under (with a pool near its limit, that can be the rest of the process's life).
# Watch /health graphs.*.eager / floor_hits / under_floor and the log "graph cache ...: under the memory floor".
# If they show eager windows, either free memory (a smaller pool) or set a fixed floor: graphs then capture while
# MemAvailable >= this many GiB. Lower keeps decode fast but lets each capture (~64 MiB of host memory) take the node
# nearer the 4 GiB hard floor; unset keeps the engine's rule.
# Tested benchmark value, not a qualified long-session profile: 64, which no node reaches, so every decode window
# runs eagerly. With the engine's rule (hold) a test node went under its 4.25 GiB memory floor during the quality run;
# 64 was stable through the rest of it at about 18% less decode speed (docs/PACKS.md). Remove it only after measuring
# your own nodes' headroom over long sessions.
TF_DSV41_GRAPH_FLOOR_GIB=64
TF_DSV41_PF_WS_SHARE=1
TF_DSV41_INDEX_BOUND=1
# Draft pricing from this engine's own boot measurement: the first boot times its windows on every rank and stores
# calib-zig-<shape>.json in CALIB_DIR (this pack's own STATE_DIR); later boots read it. No CALIB_FILE until this pack's
# table is measured on an idle pair; never flash17's file (the name has no pack in it at engine 9131e10a; TensorFold
# perf-1100/eaq-1 adds the pack to it, which makes the separate folder a second safeguard).
TF_DSV41_CALIB=zig
TF_DSV41_CALIB_DIR=/state/calib-zig

# 4K prefill falls back to 2K segments (same bits) when either rank cannot keep PF_WS_FLOOR_GIB free.
# For a conservative 2K profile set PF_4K=0, drop PF_4K_MEMORY_OK and PF_WS_FLOOR_GIB, and use CHUNK / ROWS 2048.
# Changing these (or slots, rows cap, context) changes the AOT set: run scripts/run-zig.sh N --check-aot and compile
# what it reports (docs/ZIG-SERVE.md, "Changing serving settings").

# Explicit opt-ins in the public source export.
export TF_DSV41_LOOKUP=1
export TF_DSV41_ENGRAM_PREFETCH=1
