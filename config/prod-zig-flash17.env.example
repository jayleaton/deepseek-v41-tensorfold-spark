# Candidate profile for the upstream-native migration; historical measurements do not qualify this pin.
# The current pin includes flash17 dsq-1 admission; pack/device/API qualification remains pending. See docs/ENGINE.md.
# Recommended TP=2 Zig serving profile: the flash17 pack (DeepSeek-V4.1-Flash-1017 EXL3 2.80 bpw), docs/FLASH-1017.md.
# It is the q28-v2 profile (config/prod-zig.env.example, the rollback) with these changes: the flash17 pack and its
# own prepared / state folders, the 1017 Engram shards, TF_DSV41_BIAS_VL=/model and TF_DSV41_POOL_TOKENS=2100000.
# We suggest a 2100-2200 MHz GPU clock cap (nvidia-smi -lgc 300,2100) to help with temperature control.
# Copy to config/prod-zig.env on EACH node; set these node-local paths and link settings.
# This profile requires the CUDA Zig port and generated assets described in docs/ZIG-SERVE.md,
# including an AOT fill that covers 4K prefill pieces, replay runs and the INDEX_BOUND twins.
IMAGE="<your-built-zig-image>"
TF_TP_MASTER="<rank-0-link-address>"
TF_TP_PORT=29571
TF_COMM_BACKEND=roce
NCCL_SOCKET_IFNAME="<link-interface>"
NCCL_IB_HCA="<cabled-RDMA-devices>"
# The flash17 pack: jayleaton/DeepSeek-V4.1-Flash-1017-EXL3-2.8bpw, byte-identical on both nodes. G was measured on its
# K6 MTP variant (docs/FLASH-1017.md#the-k6-mtp-variant), which is not published yet; it needs its own PREPARED_DIR.
MODEL_DIR="<absolute-flash17-model-directory>"
# Engram shards packed from deepseek-ai/DeepSeek-V4.1-Flash-1017 (the September shards do not match this pack).
ENGRAM_DIR="<absolute-rank-specific-1017-engram-directory>"
ASSETS_DIR="<absolute-rank-specific-assets-directory>"
# This pack's own folders: do not reuse another pack's prepared files, calibration or sessions.
PREPARED_DIR="<absolute-flash17-zig-prepared-directory>"
STATE_DIR="<absolute-flash17-state-directory>"
CACHE_DIR="<absolute-calibration-directory>"
HOST=localhost
PORT=8000
# rope.bin needs CONTEXT + 2048 rows; pass --rows explicitly to the asset generator
TF_DSV41_CONTEXT=1048576
TF_DSV41_ASSETS=/assets

# Engine values exported from the serving profile, with the measured all-on additions.
TF_DSV41_R1=1
TF_DSV41_DRAFTS=1
TF_DSV41_OWN_PREFILL=1
TF_DSV41_GRAPHS=1
TF_DSV41_SAMPLING=1
TF_DSV41_SLOTS=4
TF_DSV41_SLOT_DRAFTS=1
# Paged KV pool shared by the slots: 2.1M tokens with split KV (one slot up to CONTEXT, about 525K each at 4 live).
# 3.0M and 2.4M took the head under the 4 GiB floor during 4K prefills with this pack (docs/FLASH-1017.md).
TF_DSV41_POOL_TOKENS=2100000
# Split KV: compressed KV rows sharded over the ranks instead of replicated (TP >= 2; see docs/ZIG-SERVE.md).
TF_DSV41_KV_SPLIT=1
# Split KV's owner-packed exchange where every rank's transport takes device lengths (otherwise the dense exchange).
TF_DSV41_KV_SPLIT_COMPACT=1
# Dense weight forms written over their trellis instead of beside it (frees their copy for the pool).
TF_DSV41_FORMS_INPLACE=1
TF_DSV41_EXPERT_TOPP=0.85
TF_DSV41_ENGRAM_DIR=/engram
TF_DSV41_PREPARED=/prepared
TF_DSV41_PREPARED_WRITE=1
TF_TP_PLAN_TIMEOUT=1800
TF_DSV41_SESSIONS=1
TF_DSV41_SESSION_RAM_MIB=256
TF_DSV41_SESSION_DISK=/sessions
TF_DSV41_SESSION_DISK_GIB=128
TF_DSV41_SESSION_DISK_MIN=1024
TF_DSV41_FLOOR_GIB=5
TF_DSV41_FLOOR_HARD_GIB=4
TENSORFOLD_REQUEST_LOG=/state/requests.jsonl
# Seconds requests in progress may finish after SIGTERM / SIGINT before both ranks stop at a round boundary.
TF_DRAIN_S=20
# Seconds between keepalives on a stream that has not sent its first token (0: none).
TF_SSE_KEEPALIVE_S=15
TF_DSV41_THINKING=1
TF_DSV41_DEFAULT_EFFORT=high
TF_DSV41_SCHEMA_PROMPT=1
# Image input: DeepSeek's vision tower on rank 0 (placeholder: each image becomes a notice; reject: HTTP 400).
TF_DSV41_IMAGES=native
# The pack's own 43 learned 1017 image routing biases, read from the model folder on both ranks (not a September copy).
TF_DSV41_BIAS_VL=/model
TF_TP_MAILBOX_MAX_KB=1024
TF_DSV41_INDEX_BUDGET_MIB=64
TF_DSV41_PREFETCH_AHEAD=1
TF_DSV41_SPEC_DRAFT=1
TF_DSV41_DRAFT_GRAPHS=1
TF_DSV41_ROWS_CAP=64
# Structured output (response_format, required or named tool_choice) through grammar masks on every rank
# (1, the engine default); 0 refuses it. Both ranks must agree.
TF_DSV41_GRAMMAR=1
TENSORFOLD_TOOL_GRAMMAR=0
TF_DSV41_PF_DENSE=fused
# Copy config/pfdense-table.json into CACHE_DIR before startup
TF_DSV41_PF_DENSE_TABLE=/cache/pfdense-table.json
TF_TP_PLAN_LINK=rdma
TF_TP_PLAN_PIN=auto
TF_DSV41_L2PF=1
TF_DSV41_L2PF_MB=12
TF_DSV41_L2PF_PACE_GBPS=150
TF_DSV41_DEPTH_JOINT=0
TF_DSV41_ENGRAM_GATE=1
TF_DSV41_BRANCHES=1
TF_DSV41_BRANCHES_PRIO=side
TF_DSV41_MHC_DEFER=1
TF_TP_ROCE_FAST=1
TF_DSV41_GREEDY_GPU=1
TF_DSV41_PREFILL=replay
TF_DSV41_GM_V2=1
# Final serving set: the 40 settings the measured serving boot applied over the profile above (later values win;
# shown here once, with their effective values). Each is default-off in the engine and opted into here.
TF_DSV41_PREFILL_PIECES=1
TF_DSV41_SESSION_SLOTS=1
TF_DSV41_TAIL_JOIN=1
TF_DSV41_DRAFT_TIMED=1
TF_DSV41_CODE_ACCEPT=0
TF_DSV41_ROUTER_GROUP_ROT=1
TF_DSV41_MHC_PFDEC=17
TF_DSV41_DRAFT_BATCH_PROJ=1
TF_DSV41_DRAFT_CHAIN=1
TF_DSV41_DRAFT_OVERLAP=1
TF_DSV41_ROUND_GRAPH=1
TF_DSV41_KV_NORM_STORE=1
TF_DSV41_LOOKUP_PLAN=1
TF_DSV41_JOIN_DRAFTS=1
TF_DSV41_PIECE_RUNS=1
TF_DSV41_REPLAY_RUNS=1
TF_DSV41_PF_4K=1
TF_DSV41_PF_4K_MEMORY_OK=1
TF_DSV41_PREFILL_CHUNK=4096
TF_DSV41_PREFILL_ROWS=4096
# 4K prefill keeps this much free on both ranks or falls back to 2K; at 3.5 a planned workspace could pass under the
# 4 GiB hard floor. The guard refuses a profile with a floor under 4.
TF_DSV41_PF_WS_FLOOR_GIB=4.75
TF_DSV41_ENGRAM_AIO=1
TF_DSV41_DRAFT_CAPTURE=1
TF_DSV41_MHC_DEFER_AT=exchange
TF_DSV41_LIN2=1
TF_DSV41_GRAPH_FLOOR=hold
TF_DSV41_PF_WS_SHARE=1
TF_DSV41_INDEX_BOUND=1
# Draft pricing from this engine's own boot measurement: the first boot times its windows on every rank and stores
# calib-zig-<shape>.json in CALIB_DIR; later boots read it. Pin one measured table with CALIB_FILE once you have it.
TF_DSV41_CALIB=zig
TF_DSV41_CALIB_DIR=/state/calib-zig
# TF_DSV41_CALIB_FILE=/state/calib-zig/<calib-zig-file>.json

# 4K prefill falls back to 2K segments (same bits) when either rank cannot keep PF_WS_FLOOR_GIB free.
# For a conservative 2K profile set PF_4K=0, drop PF_4K_MEMORY_OK and PF_WS_FLOOR_GIB, and use CHUNK / ROWS 2048.
# Changing these (or slots, rows cap, context) changes the AOT set: run scripts/run-zig.sh N --check-aot and compile
# what it reports (docs/ZIG-SERVE.md, "Changing serving settings").

# How the host waits for the GPU: blocking sleeps instead of spinning, which leaves the shared CPU / GPU power budget
# to the GPU (same launches and bits).
TF_CUDA_SCHED=blocking

# Release candidate G (58bece1d3): nine settings over the profile above. Each defaults off in the engine; the G and F
# bench boots ran with all nine (docs/BENCHMARKS.md).
# A TP2 prefill segment's index selection is split by rows between the ranks (Mia's indexer row split).
TF_DSV41_IDX_SPLIT=1
# No suffix-copy proposals while a DSpark head is loaded.
TF_DSV41_NO_COPIES=1
# The tokenizer memoizes encoded messages at normalized added-token boundaries.
TF_DSV41_TOKENIZER_MESSAGE_MEMO=1
# Prefill K4 scratch members share placements; views and launches are unchanged.
TF_DSV41_PF_SCRATCH_ALIAS=1
# Before CUDA starts, check that each packed Engram shard covers the hasher's rank-owned rows (Mia's check, D4).
TF_DSV41_ENGRAM_VALIDATE=1
# An index layer whose top-k takes every entry it reads skips its query and scores (bertholomus).
TF_DSV41_IDX_IOTA=1
# Both rotation folds: wo_a's epilogue writes wo_b's rotated rows (bit 0) and the attention merge writes wo_a's (bit 1),
# so neither needs a rotation launch; the rows equal the rotation launch's bytes (bertholomus).
TF_DSV41_ROT_FOLD=3
# No fixed round overhead priced into the draft depth's rate (bertholomus's lane allocator setting, at 0 ms).
TF_DSV41_DEPTH_OVERHEAD_MS=0
# The first 4096 compressed KV positions of each slot stay whole on every rank, so windows ending there read them
# without a row exchange; split KV stays on and the rows are the same bytes (bertholomus).
TF_DSV41_KV_MIRROR=4096

# Compute lane: OFF. With 1, a request that lists {"type": "code_interpreter"} in tools gets a python(code) tool the
# engine runs itself, in a Landlock + seccomp sandbox as nobody (no network or child processes; it reads only the
# interpreter's own files), inserting
# the result into the same reply. Requests without that entry are unchanged. Needs /usr/bin/python3 in the image
# (docker/zig/Dockerfile installs it). Limits: TF_DSV41_COMPUTE_LANE_{WORKERS,MAX_MS,MAX_CALLS,MAX_RESULT_TOKENS,
# MEM_MB,CPUS,PYTHON}. See docs/OPERATIONS.md before enabling it.
# TF_DSV41_COMPUTE_LANE=1

# Explicit opt-ins in the public source export.
export TF_DSV41_LOOKUP=1
export TF_DSV41_ENGRAM_PREFETCH=1

# Rank-local HCA selector, forwarded unchanged (rootsbymenda, #63):
# TF_TP_ROCE_HCA="<cabled-RDMA-device>:<port>"
CONTAINER_PREFIX=tensorfold-zig

# Head-side pair supervision (serve.sh). Paths must be absolute; configure both nodes first.
# WORKER_SSH="<worker-ssh-target>"
# WORKER_REPO="<absolute-worker-recipe-checkout>"
# WORKER_CONFIG="<absolute-worker-prod-zig.env>"
WATCH_HEAL=0
# WATCH_FAILS=3
# WATCH_MIN_HEAL=300
# READY_TIMEOUT=900
# MAINTENANCE_LEASE="<absolute-maintenance-lease-file>"
# Optional host CPU affinity (docker --cpuset-cpus): choose the CPUs from YOUR topology, the same set on both nodes,
# and keep a numeric TF_TP_PLAN_PIN inside it. Include the exact value in a guard profile. Unset: all CPUs.
# CPUSET_CPUS="<cpu-list>"

# Optional head-only native auth: nonempty mode-0600 file owned by you or root, outside
# the checkout and data directories, mounted read-only (docs/SECURITY.md).
# NATIVE_AUTH_FILE="<absolute-head-auth-file>"
